<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="ticketsPage" appConnect="local" -->
<meta name="ac:route" content="/tickets">
<div class="portal-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context"></dmx-serverconnect>
  <dmx-serverconnect id="scopeContext" url="/api/auth/scope_context"></dmx-serverconnect>
  <dmx-serverconnect id="ticketList" url="/api/tickets/list" dmx-param:status_code="statusFilter.value" dmx-param:district_id="districtFilter.value" dmx-param:school_id="schoolFilter.value" dmx-param:requester_type="requesterFilter.value" dmx-param:assignment_filter="assignmentFilter.value" dmx-param:search="ticketSearch.value" dmx-param:submitted_from="dateFrom.value" dmx-param:submitted_to="dateTo.value" dmx-param:page="ticketPage.value" dmx-param:page_size="25"></dmx-serverconnect>
  <dmx-serverconnect id="ticketSummary" url="/api/tickets/summary"></dmx-serverconnect>
  <dmx-serverconnect id="ticketStatuses" url="/api/tickets/status-options"></dmx-serverconnect>
  <dmx-serverconnect id="districtOptions" url="/api/tickets/district-options"></dmx-serverconnect>
  <dmx-serverconnect id="schoolOptions" url="/api/tickets/school-options" dmx-param:district_id="districtFilter.value"></dmx-serverconnect>
  <dmx-value id="ticketPage" value="1"></dmx-value>
  <%- await include("partials/portal-sidebar", { currentPage: "tickets" }) %>
  <div class="portal-workspace">
    <%- await include("partials/portal-topbar") %>
    <main class="portal-main tickets-page" aria-label="Tickets">
      <header class="portal-page-hero tickets-hero"><div class="portal-page-hero-content"><p class="portal-eyebrow">Service desk · Device support</p><h1>Tickets</h1><p>Track, manage and resolve device requests and issues across all schools.</p></div><a class="btn btn-bmobile-primary hero-action ticket-create-action" href="/tickets/new" dmx-show="authContext.data.can_tickets_create"><i class="fas fa-plus me-1" aria-hidden="true"></i>Create Ticket</a></header>
      <section class="row g-3 mb-3 ticket-summary-grid" aria-label="Ticket summary">
        <div class="col-6 col-xl"><div class="ticket-stat-card h-100"><span class="ticket-stat-icon stat-green"><i class="far fa-file-alt"></i></span><strong class="d-block h4 mb-0" dmx-text="ticketSummary.data.summary.open_total || 0">0</strong><span>Open Total</span></div></div>
        <div class="col-6 col-xl"><div class="ticket-stat-card h-100"><span class="ticket-stat-icon stat-blue"><i class="fas fa-paper-plane"></i></span><strong class="d-block h4 mb-0" dmx-text="ticketSummary.data.summary.submitted || 0">0</strong><span>Submitted</span></div></div>
        <div class="col-6 col-xl"><div class="ticket-stat-card h-100"><span class="ticket-stat-icon stat-amber"><i class="fas fa-comment"></i></span><strong class="d-block h4 mb-0" dmx-text="ticketSummary.data.summary.needs_clarification || 0">0</strong><span>Needs Clarification</span></div></div>
        <div class="col-6 col-xl"><div class="ticket-stat-card h-100"><span class="ticket-stat-icon stat-purple"><i class="fas fa-check-circle"></i></span><strong class="d-block h4 mb-0" dmx-text="ticketSummary.data.summary.approved_for_pickup || 0">0</strong><span>Approved for Pickup</span></div></div>
        <div class="col-6 col-xl"><div class="ticket-stat-card h-100"><span class="ticket-stat-icon stat-red"><i class="fas fa-users"></i></span><strong class="d-block h4 mb-0" dmx-text="ticketSummary.data.summary.unassigned_open || 0">0</strong><span>Unassigned</span></div></div>
        <div class="col-6 col-xl"><div class="ticket-stat-card h-100"><span class="ticket-stat-icon stat-blue"><i class="fas fa-user-friends"></i></span><strong class="d-block h4 mb-0" dmx-text="ticketSummary.data.summary.assigned_open || 0">0</strong><span>Assigned Open</span></div></div>
        <div class="col-6 col-xl"><div class="ticket-stat-card h-100"><span class="ticket-stat-icon stat-green"><i class="fas fa-user"></i></span><strong class="d-block h4 mb-0" dmx-text="ticketSummary.data.summary.my_open || 0">0</strong><span>Assigned to Me</span></div></div>
      </section>
      <section class="page-filter-card tickets-filter-card"><div class="filter-card-heading"><h2><i class="fas fa-filter me-2" aria-hidden="true"></i>Filters</h2><button class="btn btn-link btn-sm" type="button" dmx-on:click="ticketSearch.setValue('');statusFilter.setValue('');assignmentFilter.setValue('ALL');districtFilter.setValue('');schoolFilter.setValue('');requesterFilter.setValue('');dateFrom.setValue('');dateTo.setValue('');ticketPage.setValue(1);schoolOptions.load({district_id:districtFilter.value}, true);ticketList.load()"><i class="fas fa-undo me-1"></i>Clear all</button></div><div class="row g-2">
        <div class="col-12 col-xl-3"><label class="visually-hidden" for="ticketSearch">Search tickets</label><input id="ticketSearch" class="form-control" type="search" placeholder="Ticket, serial, asset, subject or requester" dmx-on:input="ticketPage.setValue(1);ticketList.load()"></div>
        <div class="col-6 col-xl-2"><label class="visually-hidden" for="statusFilter">Status</label><select id="statusFilter" class="form-select" dmx-on:change="ticketPage.setValue(1);ticketList.load()"><option value="">All statuses</option><option dmx-repeat="ticketStatuses.data.statuses" dmx-bind:value="code" dmx-text="name"></option></select></div>
        <div class="col-6 col-xl-2"><label class="visually-hidden" for="assignmentFilter">Work queue</label><select id="assignmentFilter" class="form-select" dmx-on:change="ticketPage.setValue(1);ticketList.load()"><option value="ALL">All work</option><option value="UNASSIGNED">Unassigned</option><option value="ASSIGNED">Assigned</option><option value="MINE">Assigned to Me</option></select></div>
        <div class="col-6 col-xl-2"><label class="visually-hidden" for="districtFilter">District</label><select id="districtFilter" class="form-select" dmx-on:change="schoolFilter.setValue('');ticketPage.setValue(1);schoolOptions.load({district_id:districtFilter.value}, true);ticketList.load()"><option value="">All districts</option><option dmx-repeat="districtOptions.data.districts" dmx-bind:value="id" dmx-text="name"></option></select></div>
        <div class="col-6 col-xl-2"><label class="visually-hidden" for="schoolFilter">School</label><select id="schoolFilter" class="form-select" dmx-on:change="ticketPage.setValue(1);ticketList.load()"><option value="">All schools</option><option dmx-repeat="schoolOptions.data.schools" dmx-bind:value="id" dmx-text="name"></option></select></div>
        <div class="col-6 col-xl-1"><label class="visually-hidden" for="requesterFilter">Requester</label><select id="requesterFilter" class="form-select" dmx-on:change="ticketPage.setValue(1);ticketList.load()"><option value="">Type</option><option value="STUDENT">Student</option><option value="PARENT">Parent</option><option value="TEACHER">Teacher</option><option value="STAFF">Staff</option></select></div>
        <div class="col-6 col-xl-1"><label class="visually-hidden" for="dateFrom">Submitted from</label><input id="dateFrom" class="form-control" type="date" aria-label="Submitted from" dmx-on:change="ticketPage.setValue(1);ticketList.load()"></div>
        <div class="col-6 col-xl-1"><label class="visually-hidden" for="dateTo">Submitted to</label><input id="dateTo" class="form-control" type="date" aria-label="Submitted to" dmx-on:change="ticketPage.setValue(1);ticketList.load()"></div>
      </div></section>
      <div class="alert alert-danger" role="alert" dmx-show="ticketList.lastError.status">Tickets could not be loaded.</div>
      <div class="text-muted py-3" role="status" dmx-show="ticketList.state.executing">Loading tickets...</div>
      <div class="portal-card tickets-table-card"><div class="table-responsive portal-table-wrapper"><table class="table portal-table align-middle"><thead><tr><th>Ticket</th><th>Submitted</th><th>Device</th><th>Origin</th><th>Requester</th><th>Subject</th><th>Status</th><th>Assigned To</th><th>Action</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="ticketList.data.tickets"><tr><td class="fw-semibold" dmx-text="ticket_number"></td><td dmx-text="submitted_at.formatDate('MMM d, yyyy, hh:mm A')"></td><td><span dmx-text="serial_number"></span><br><small class="text-muted" dmx-text="asset_tag || 'No asset tag'"></small></td><td><span dmx-text="origin_school_name"></span><br><small class="text-muted" dmx-text="origin_district_name"></small></td><td><span dmx-text="requester_name"></span><br><small class="text-muted" dmx-text="requester_type"></small></td><td class="text-break" dmx-text="subject"></td><td><span class="ticket-status-pill" dmx-class:ticket-status-submitted="current_status_code == 'SUBMITTED'" dmx-class:ticket-status-clarification="current_status_code == 'NEEDS_CLARIFICATION'" dmx-class:ticket-status-approved="current_status_code == 'APPROVED_FOR_PICKUP'" dmx-class:ticket-status-transit="current_status_code == 'IN_TRANSIT'" dmx-class:ticket-status-repair="current_status_code == 'UNDER_REPAIR'" dmx-class:ticket-status-completed="current_status_code == 'COMPLETED'" dmx-class:ticket-status-returned="current_status_code == 'RETURNED'" dmx-class:ticket-status-cancelled="current_status_code == 'CANCELLED'" dmx-text="current_status_name"></span></td><td dmx-text="assigned_to_display_name || 'Unassigned'"></td><td><a class="btn btn-bmobile-secondary btn-sm" dmx-bind:href="'/tickets/detail?id=' + ticket_id">View</a></td></tr></tbody></table><div class="catalogue-empty-state" dmx-show="!ticketList.state.executing && ticketList.data.tickets.count() == 0"><span class="catalogue-empty-icon"><i class="fas fa-ticket-alt" aria-hidden="true"></i></span><h3>No tickets match your current filters</h3><p>Try adjusting your search or filter criteria, or create a new ticket to get started.</p><a class="btn btn-bmobile-primary ticket-create-action" href="/tickets/new" dmx-show="authContext.data.can_tickets_create"><i class="fas fa-plus me-1"></i>Create Ticket</a></div></div>
      <div class="d-flex justify-content-between align-items-center mt-3"><span class="text-muted" dmx-text="'Page ' + ticketPage.value"></span><div class="btn-group"><button class="btn btn-bmobile-secondary btn-sm" type="button" aria-label="Previous page" dmx-bind:disabled="ticketPage.value <= 1" dmx-on:click="ticketPage.setValue(ticketPage.value - 1);ticketList.load()"><i class="fas fa-chevron-left" aria-hidden="true"></i></button><button class="btn btn-bmobile-secondary btn-sm" type="button" aria-label="Next page" dmx-bind:disabled="ticketList.data.tickets.count() < 25" dmx-on:click="ticketPage.setValue(ticketPage.value + 1);ticketList.load()"><i class="fas fa-chevron-right" aria-hidden="true"></i></button></div></div>
    </main>
  </div>
</div>
