<!-- Wappler include head-page="../layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="deviceCatalogue" appConnect="local" -->
<meta name="ac:route" content="/admin/device-catalogue">

<div class="portal-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context"></dmx-serverconnect>
  <dmx-serverconnect id="scopeContext" url="/api/auth/scope_context"></dmx-serverconnect>
  <dmx-serverconnect id="manufacturerOptions" url="/api/catalogue/manufacturers/list"></dmx-serverconnect>
  <dmx-serverconnect id="manufacturerList" url="/api/catalogue/manufacturers/list" dmx-param:search="manufacturerSearch.value" dmx-param:status="manufacturerStatusFilter.value"></dmx-serverconnect>
  <dmx-serverconnect id="modelList" url="/api/catalogue/models/list" dmx-param:manufacturer_id="modelManufacturerFilter.value" dmx-param:search="modelSearch.value" dmx-param:status="modelStatusFilter.value"></dmx-serverconnect>
  <dmx-value id="manufacturerNotice"></dmx-value>
  <dmx-value id="modelNotice"></dmx-value>
  <dmx-value id="selectedManufacturerId"></dmx-value>
  <dmx-value id="selectedManufacturerName"></dmx-value>
  <dmx-value id="selectedManufacturerStatusId"></dmx-value>
  <dmx-value id="selectedManufacturerStatus"></dmx-value>
  <dmx-value id="selectedModelId"></dmx-value>
  <dmx-value id="selectedModelManufacturerId"></dmx-value>
  <dmx-value id="selectedModelName"></dmx-value>
  <dmx-value id="selectedModelStatusId"></dmx-value>
  <dmx-value id="selectedModelImageAvailable" value="0"></dmx-value>
  <dmx-value id="selectedModelStatus"></dmx-value> 

  <%- await include("../partials/portal-sidebar", { currentPage: "device-catalogue" }) %>

  <div class="portal-workspace">
    <%- await include("../partials/portal-topbar") %>
    <main class="portal-main catalogue-page" aria-label="Device catalogue">
      <header class="portal-page-hero catalogue-hero">
        <div class="portal-page-hero-content"><p class="portal-eyebrow">Administration · Inventory</p><h1>Device Catalogue</h1><p>Manage approved manufacturers and device models for the laptop warranty programme.</p></div>
        <div class="hero-actions catalogue-hero-actions">
          <button class="btn btn-bmobile-primary hero-action catalogue-create-action" type="button" dmx-show="authContext.data.can_devices_manage" dmx-on:click="createManufacturerForm.reset(true);createManufacturerName.setValue('');createManufacturerModal.show()"><i class="fas fa-plus me-1" aria-hidden="true"></i>Add Manufacturer</button>
          <button class="btn btn-bmobile-primary hero-action catalogue-create-action" type="button" dmx-show="authContext.data.can_devices_manage" dmx-on:click="createModelForm.reset(true);createModelManufacturer.setValue('');createModelName.setValue('');createModelModal.show()"><i class="fas fa-plus me-1" aria-hidden="true"></i>Add Model</button>
        </div>
      </header>
      <div class="catalogue-tabs"><ul class="nav nav-tabs" role="tablist"><li class="nav-item" role="presentation"><button class="nav-link active" id="manufacturersTab" type="button" data-bs-toggle="tab" data-bs-target="#manufacturersPanel" role="tab">Manufacturers</button></li><li class="nav-item" role="presentation"><button class="nav-link" id="modelsTab" type="button" data-bs-toggle="tab" data-bs-target="#modelsPanel" role="tab">Models</button></li></ul></div>
      <div class="tab-content">
        <section class="tab-pane fade show active catalogue-panel" id="manufacturersPanel" role="tabpanel" aria-labelledby="manufacturersTab"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><h2 class="h5 mb-0">Manufacturers</h2><button class="btn btn-bmobile-primary btn-sm catalogue-local-add" type="button" dmx-show="authContext.data.can_devices_manage" dmx-on:click="createManufacturerForm.reset(true);createManufacturerName.setValue('');createManufacturerModal.show()"><i class="fas fa-plus me-1" aria-hidden="true"></i>Add Manufacturer</button></div><div class="alert alert-success mt-3" role="status" dmx-show="manufacturerNotice.value" dmx-text="manufacturerNotice.value"></div><div class="catalogue-filter-card"><h2 class="h6 mb-3"><i class="fas fa-filter me-2" aria-hidden="true"></i>Filters</h2><div class="row g-3"><div class="col-12 col-md-8"><label class="visually-hidden" for="manufacturerSearch">Search manufacturers</label><input id="manufacturerSearch" class="form-control" type="search" placeholder="Search code or manufacturer" dmx-on:input="manufacturerList.load()"></div><div class="col-12 col-md-4"><label class="visually-hidden" for="manufacturerStatusFilter">Status</label><select id="manufacturerStatusFilter" class="form-select" dmx-on:change="manufacturerList.load()"><option value="">All statuses</option><option value="active">Active</option><option value="inactive">Inactive</option></select></div></div></div><div class="text-muted mb-2" role="status" dmx-show="manufacturerList.state.executing">Loading manufacturers...</div><div class="alert alert-danger" role="alert" dmx-show="manufacturerList.lastError.status" dmx-text="manufacturerList.lastError.response && manufacturerList.lastError.response.error ? manufacturerList.lastError.response.error : 'Manufacturers could not be loaded.'"></div><div class="catalogue-table-card"><div class="table-responsive portal-table-wrapper"><table class="table portal-table align-middle"><thead><tr><th>Code</th><th>Manufacturer</th><th>Status</th><th>Actions</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="manufacturerList.data.manufacturers"><tr><td dmx-text="manufacturer_code"></td><td dmx-text="name"></td><td><span class="badge" dmx-class:text-bg-success="status == 'active'" dmx-class:text-bg-secondary="status == 'inactive'" dmx-text="status"></span></td><td><div class="d-flex flex-wrap gap-1" dmx-show="authContext.data.can_devices_manage"><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-on:click="editManufacturerForm.reset(true);selectedManufacturerId.setValue(id);selectedManufacturerName.setValue(name);editManufacturerModal.show()">Edit</button><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-on:click="selectedManufacturerStatusId.setValue(id);selectedManufacturerStatus.setValue(status == 'active' ? 'inactive' : 'active');manufacturerStatusModal.show()" dmx-text="status == 'active' ? 'Deactivate' : 'Reactivate'"></button></div></td></tr></tbody></table></div><div class="catalogue-empty-state" dmx-show="!manufacturerList.state.executing && manufacturerList.data.manufacturers.count() == 0"><span class="catalogue-empty-icon"><i class="fas fa-cube" aria-hidden="true"></i></span><h3>No manufacturers match your current filters</h3><p>Try adjusting your search or filter criteria, or add a new manufacturer to get started.</p><button class="btn btn-bmobile-primary" type="button" dmx-show="authContext.data.can_devices_manage" dmx-on:click="createManufacturerModal.show()"><i class="fas fa-plus me-1"></i>Add Manufacturer</button></div></div></section>
        <section class="tab-pane fade catalogue-panel" id="modelsPanel" role="tabpanel" aria-labelledby="modelsTab">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 class="h5 mb-0">Models</h2>
            <button class="btn btn-bmobile-primary btn-sm catalogue-local-add catalogue-create-action" type="button" dmx-show="authContext.data.can_devices_manage" dmx-on:click="createModelForm.reset(true);createModelManufacturer.setValue('');createModelName.setValue('');createModelModal.show()"><i class="fas fa-plus me-1" aria-hidden="true"></i>Add Model</button>
          </div>
          <div class="alert alert-success mt-3" role="status" dmx-show="modelNotice.value" dmx-text="modelNotice.value"></div>
          <div class="catalogue-filter-card">
          <div class="filter-card-heading"><h2><i class="fas fa-filter me-2" aria-hidden="true"></i>Filters</h2></div>
          <div class="row g-2">
            <div class="col-12 col-lg-5"><label class="visually-hidden" for="modelSearch">Search models</label><input id="modelSearch" class="form-control" type="search" placeholder="Search model or manufacturer" dmx-on:input="modelList.load()"></div>
            <div class="col-12 col-sm-6 col-lg-4"><label class="visually-hidden" for="modelManufacturerFilter">Manufacturer</label><select id="modelManufacturerFilter" class="form-select" dmx-on:change="modelList.load()"><option value="">All manufacturers</option><option dmx-repeat="manufacturerOptions.data.manufacturers" dmx-bind:value="id" dmx-text="name"></option></select></div>
            <div class="col-12 col-sm-6 col-lg-3"><label class="visually-hidden" for="modelStatusFilter">Status</label><select id="modelStatusFilter" class="form-select" dmx-on:change="modelList.load()"><option value="">All statuses</option><option value="active">Active</option><option value="inactive">Inactive</option></select></div>
          </div>
          </div>
          <div class="text-muted mb-2" role="status" dmx-show="modelList.state.executing">Loading models...</div>
          <div class="alert alert-danger" role="alert" dmx-show="modelList.lastError.status" dmx-text="modelList.lastError.response && modelList.lastError.response.error ? modelList.lastError.response.error : 'Models could not be loaded.'"></div>
          <div class="alert alert-danger" role="alert" dmx-show="manufacturerOptions.lastError.status">Manufacturer options could not be loaded.</div>
          <div class="catalogue-table-card">
          <div class="table-responsive portal-table-wrapper" dmx-show="modelList.data.models.count() > 0">
            <table class="table portal-table align-middle">
              <thead><tr><th>Image</th><th>Manufacturer</th><th>Model Code</th><th>Model Name</th><th>Status</th><th>Actions</th></tr></thead>
              <tbody is="dmx-repeat" dmx-bind:repeat="modelList.data.models">
                <tr><td><img class="catalogue-model-image" dmx-show="image_available" dmx-bind:src="'/api/catalogue/models/image?id=' + id" dmx-bind:alt="model_name + ' model image"><span class="catalogue-model-no-image" dmx-show="!image_available">No image</span></td><td dmx-text="manufacturer_name"></td><td dmx-text="model_code"></td><td dmx-text="model_name"></td><td><span class="badge" dmx-class:text-bg-success="status == 'active'" dmx-class:text-bg-secondary="status == 'inactive'" dmx-text="status"></span></td><td><div class="d-flex flex-wrap gap-1" dmx-show="authContext.data.can_devices_manage"><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-on:click="editModelForm.reset(true);selectedModelId.setValue(id);selectedModelManufacturerId.setValue(manufacturer_id);selectedModelName.setValue(model_name);selectedModelImageAvailable.setValue(image_available);editModelModal.show()">Edit</button><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-on:click="selectedModelStatusId.setValue(id);selectedModelStatus.setValue(status == 'active' ? 'inactive' : 'active');modelStatusModal.show()" dmx-text="status == 'active' ? 'Deactivate' : 'Reactivate'"></button></div></td></tr>
              </tbody>
            </table>
          </div>
          <div class="catalogue-empty-state" dmx-show="!modelList.state.executing && modelList.data.models.count() == 0"><span class="catalogue-empty-icon"><i class="fas fa-cube" aria-hidden="true"></i></span><h3>No models match your current filters</h3><p>Try adjusting your search or filter criteria, or add a model to get started.</p><button class="btn btn-bmobile-primary catalogue-create-action" type="button" dmx-show="authContext.data.can_devices_manage" dmx-on:click="createModelForm.reset(true);createModelManufacturer.setValue('');createModelName.setValue('');createModelModal.show()"><i class="fas fa-plus me-1" aria-hidden="true"></i>Add Model</button></div>
          </div>
        </section>
      </div>
    </main>
  </div>
</div>



<div id="createManufacturerModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="createManufacturerTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title" id="createManufacturerTitle">Add Manufacturer</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="createManufacturerForm" is="dmx-serverconnect-form" method="post" action="/api/catalogue/manufacturers/save" dmx-on:success="createManufacturerModal.hide();manufacturerList.load();manufacturerOptions.load();modelList.load();manufacturerNotice.setValue('Manufacturer created.');createManufacturerForm.reset(true)"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="createManufacturerForm.lastError.status" dmx-text="createManufacturerForm.lastError.response && createManufacturerForm.lastError.response.error ? createManufacturerForm.lastError.response.error : 'Manufacturer could not be saved.'"></div><label class="form-label" for="createManufacturerName">Manufacturer</label><input id="createManufacturerName" class="form-control" name="name" maxlength="180" required></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="createManufacturerForm.state.executing">Save</button></div></form></div></div></div>

<div id="editManufacturerModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="editManufacturerTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title" id="editManufacturerTitle">Edit Manufacturer</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="editManufacturerForm" is="dmx-serverconnect-form" method="post" action="/api/catalogue/manufacturers/save" dmx-on:success="editManufacturerModal.hide();manufacturerList.load();manufacturerOptions.load();modelList.load();manufacturerNotice.setValue('Manufacturer updated.');editManufacturerForm.reset(true)"><div class="modal-body"><input id="editManufacturerId" type="hidden" name="id" dmx-bind:value="selectedManufacturerId.value"><div class="alert alert-danger" role="alert" dmx-show="editManufacturerForm.lastError.status" dmx-text="editManufacturerForm.lastError.response && editManufacturerForm.lastError.response.error ? editManufacturerForm.lastError.response.error : 'Manufacturer could not be saved.'"></div><label class="form-label" for="editManufacturerName">Manufacturer</label><input id="editManufacturerName" class="form-control" name="name" maxlength="180" required dmx-bind:value="selectedManufacturerName.value"></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="editManufacturerForm.state.executing">Save</button></div></form></div></div></div>

<div id="manufacturerStatusModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="manufacturerStatusTitle" aria-hidden="true" dmx-on:hidden="manufacturerStatusForm.reset(true);selectedManufacturerStatusId.setValue('');selectedManufacturerStatus.setValue('')"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title" id="manufacturerStatusTitle">Change Manufacturer Status</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="manufacturerStatusForm" is="dmx-serverconnect-form" method="post" action="/api/catalogue/manufacturers/set-status" dmx-on:success="manufacturerStatusModal.hide();manufacturerList.load();manufacturerOptions.load();modelList.load();manufacturerNotice.setValue('Manufacturer status changed.');manufacturerStatusForm.reset(true)"><div class="modal-body"><input id="manufacturerStatusId" type="hidden" name="id" dmx-bind:value="selectedManufacturerStatusId.value"><input id="manufacturerStatusValue" type="hidden" name="status" dmx-bind:value="selectedManufacturerStatus.value"><p dmx-text="selectedManufacturerStatus.value == 'inactive' ? 'Deactivate this manufacturer?' : 'Reactivate this manufacturer?'">Change this manufacturer's status?</p><div class="alert alert-danger" role="alert" dmx-show="manufacturerStatusForm.lastError.status" dmx-text="manufacturerStatusForm.lastError.response && manufacturerStatusForm.lastError.response.error ? manufacturerStatusForm.lastError.response.error : 'Status could not be changed.'"></div></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="manufacturerStatusForm.state.executing">Confirm</button></div></form></div></div></div>

<div id="createModelModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="createModelTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title" id="createModelTitle">Add Model</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="createModelForm" is="dmx-serverconnect-form" method="post" enctype="multipart/form-data" action="/api/catalogue/models/save" dmx-on:success="createModelModal.hide();modelList.load();modelNotice.setValue('Model created.');createModelForm.reset(true)"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="createModelForm.lastError.status" dmx-text="createModelForm.lastError.response && createModelForm.lastError.response.error ? createModelForm.lastError.response.error : 'Model could not be saved.'"></div><label class="form-label" for="createModelManufacturer">Manufacturer</label><select id="createModelManufacturer" class="form-select mb-3" name="manufacturer_id" required><option value="">Select manufacturer</option><option dmx-repeat="manufacturerOptions.data.manufacturers" dmx-bind:value="id" dmx-bind:disabled="status != 'active'" dmx-text="name"></option></select><label class="form-label" for="createModelName">Model Name</label><input id="createModelName" class="form-control mb-3" name="model_name" maxlength="180" required><label class="form-label" for="createModelImage">Model Image</label><input id="createModelImage" class="form-control" type="file" name="model_image" accept="image/jpeg,image/png,image/webp,image/avif,.avif"><div class="form-text">Optional. Shared by every device of this model. JPG, PNG, WebP, or AVIF, up to 5 MB.</div></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="createModelForm.state.executing">Save</button></div></form></div></div></div>

<div id="editModelModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="editModelTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title" id="editModelTitle">Edit Model</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="editModelForm" is="dmx-serverconnect-form" method="post" enctype="multipart/form-data" action="/api/catalogue/models/save" dmx-on:success="editModelModal.hide();modelList.load();modelNotice.setValue('Model updated.');editModelForm.reset(true)"><div class="modal-body"><input id="editModelId" type="hidden" name="id" dmx-bind:value="selectedModelId.value"><div class="alert alert-danger" role="alert" dmx-show="editModelForm.lastError.status" dmx-text="editModelForm.lastError.response && editModelForm.lastError.response.error ? editModelForm.lastError.response.error : 'Model could not be saved.'"></div><label class="form-label" for="editModelManufacturer">Manufacturer</label><select id="editModelManufacturer" class="form-select mb-3" name="manufacturer_id" required dmx-bind:value="selectedModelManufacturerId.value"><option value="">Select manufacturer</option><option dmx-repeat="manufacturerOptions.data.manufacturers" dmx-bind:value="id" dmx-bind:disabled="status != 'active' && !(selectedModelId.value && id == selectedModelManufacturerId.value)" dmx-text="name"></option></select><label class="form-label" for="editModelName">Model Name</label><input id="editModelName" class="form-control mb-3" name="model_name" maxlength="180" required dmx-bind:value="selectedModelName.value"><label class="form-label" for="editModelImage">Model Image</label><div class="catalogue-model-image-editor mb-2"><img dmx-show="selectedModelImageAvailable.value" dmx-bind:src="'/api/catalogue/models/image?id=' + selectedModelId.value" dmx-bind:alt="selectedModelName.value + ' model image"><div class="device-image-empty" dmx-show="!selectedModelImageAvailable.value"><i class="fas fa-image" aria-hidden="true"></i><span>No image provided</span></div></div><input id="editModelImage" class="form-control" type="file" name="model_image" accept="image/jpeg,image/png,image/webp,image/avif,.avif"><div class="form-text">Choose a replacement image. It will be used for all devices of this model. JPG, PNG, WebP, or AVIF, up to 5 MB.</div></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="editModelForm.state.executing">Save</button></div></form></div></div></div>

<div id="modelStatusModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="modelStatusTitle" aria-hidden="true" dmx-on:hidden="modelStatusForm.reset(true);selectedModelStatusId.setValue('');selectedModelStatus.setValue('')"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title" id="modelStatusTitle">Change Model Status</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="modelStatusForm" is="dmx-serverconnect-form" method="post" action="/api/catalogue/models/set-status" dmx-on:success="modelStatusModal.hide();modelList.load();modelNotice.setValue('Model status changed.');modelStatusForm.reset(true)"><div class="modal-body"><input id="modelStatusId" type="hidden" name="id" dmx-bind:value="selectedModelStatusId.value"><input id="modelStatusValue" type="hidden" name="status" dmx-bind:value="selectedModelStatus.value"><p dmx-text="selectedModelStatus.value == 'inactive' ? 'Deactivate this model?' : 'Reactivate this model?'">Change this model's status?</p><div class="alert alert-danger" role="alert" dmx-show="modelStatusForm.lastError.status" dmx-text="modelStatusForm.lastError.response && modelStatusForm.lastError.response.error ? modelStatusForm.lastError.response.error : 'Status could not be changed.'"></div></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="modelStatusForm.state.executing">Confirm</button></div></form></div></div></div>
