<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="escalationRulesPage" appConnect="local" components="{dmxBootstrap5Modal:{}}" -->
<meta name="ac:route" content="/admin/escalations">
<div class="portal-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context"></dmx-serverconnect>
  <dmx-serverconnect id="ruleList" url="/api/escalations/rules/list"></dmx-serverconnect>
  <dmx-value id="ruleId" value=""></dmx-value><dmx-value id="ruleStatusId" value=""></dmx-value><dmx-value id="ruleStatusValue" value=""></dmx-value>
  <dmx-value id="ruleNotice" value=""></dmx-value>
  <%- await include("../partials/portal-sidebar", { currentPage: "escalation-rules" }) %>
  <div class="portal-workspace"><%- await include("../partials/portal-topbar", { pageTitle: "Escalation Rules" }) %>
    <main class="portal-main logistics-page escalation-page" aria-label="Escalation rule administration">
      <section aria-label="Escalation rule administration">
        <div class="logistics-breadcrumb" aria-label="Breadcrumb"><a href="/" aria-label="Home"><i class="fas fa-home" aria-hidden="true"></i></a><i class="fas fa-chevron-right" aria-hidden="true"></i><a href="/admin/sla">SLA Management</a><i class="fas fa-chevron-right" aria-hidden="true"></i><strong>Escalation Rules</strong></div>
        <header class="logistics-heading"><div class="logistics-heading-icon"><i class="fas fa-sliders-h" aria-hidden="true"></i></div><div><h1>Escalation Rules</h1><p>Configure who is notified when service targets are at risk or breached.</p></div></header>

        <section class="logistics-stats" aria-label="Escalation rule summary">
          <article class="logistics-stat-card"><div class="logistics-stat-icon"><i class="fas fa-clipboard-list" aria-hidden="true"></i></div><div class="logistics-stat-copy"><span>Total Rules</span><strong dmx-text="ruleList.data.rules.count() || 0"></strong><small>Configured escalation actions</small></div><span class="logistics-stat-arrow"><i class="fas fa-layer-group" aria-hidden="true"></i></span></article>
          <article class="logistics-stat-card"><div class="logistics-stat-icon logistics-stat-icon-box"><i class="fas fa-check-circle" aria-hidden="true"></i></div><div class="logistics-stat-copy"><span>Active Rules</span><strong dmx-text="ruleList.data.rules.where('status', '==', 'active').count() || 0"></strong><small>Currently in effect</small></div><span class="logistics-stat-arrow"><i class="fas fa-chevron-right" aria-hidden="true"></i></span></article>
          <article class="logistics-stat-card"><div class="logistics-stat-icon logistics-stat-icon-repair"><i class="fas fa-exclamation-triangle" aria-hidden="true"></i></div><div class="logistics-stat-copy"><span>At Risk Triggers</span><strong dmx-text="ruleList.data.rules.where('trigger_code', '==', 'AT_RISK').count() || 0"></strong><small>Before an SLA breach</small></div><span class="logistics-stat-arrow logistics-stat-arrow-blue"><i class="fas fa-bell" aria-hidden="true"></i></span></article>
        </section>

        <div class="alert logistics-success" role="status" dmx-show="ruleNotice.value"><span class="logistics-success-icon"><i class="fas fa-check" aria-hidden="true"></i></span><span dmx-text="ruleNotice.value"></span></div>
        <div class="alert alert-danger logistics-error" role="alert" dmx-show="ruleSave.lastError.status || ruleStatusForm.lastError.status" dmx-text="ruleStatusForm.lastError.response && ruleStatusForm.lastError.response.error ? ruleStatusForm.lastError.response.error : ruleSave.lastError.response && ruleSave.lastError.response.error ? ruleSave.lastError.response.error : 'Escalation rules could not be saved.'"></div>

        <section class="logistics-card logistics-table-card escalation-rules-card" aria-labelledby="escalationRulesTitle">
          <header class="logistics-table-heading"><div class="logistics-card-heading"><span class="logistics-list-icon"><i class="fas fa-bell" aria-hidden="true"></i></span><div><h2 id="escalationRulesTitle">Configured Rules</h2><p>Escalation targets grouped by SLA policy and trigger.</p></div></div><button type="button" class="btn btn-bmobile-primary" dmx-on:click="ruleSave.reset(true);ruleId.setValue('');selectedRulePolicy.setValue('');selectedRuleTrigger.setValue('AT_RISK');selectedRuleLevel.setValue(1);selectedRuleTarget.setValue('');selectedRuleReason.setValue('');selectedRuleSort.setValue(100);ruleModal.show()"><i class="fas fa-plus" aria-hidden="true"></i>Add Rule</button></header>
          <div class="table-responsive"><table class="table align-middle logistics-table escalation-table"><thead><tr><th>Policy</th><th>Trigger</th><th>Level</th><th>Target role</th><th>Reason</th><th>Order</th><th>Status</th><th>Actions</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="ruleList.data.rules"><tr><td><span class="escalation-policy-code" dmx-text="policy_code"></span></td><td><span class="escalation-trigger-pill" dmx-class:escalation-trigger-breach="trigger_code == 'BREACHED'"><i class="fas" dmx-class:fa-exclamation-triangle="trigger_code == 'AT_RISK'" dmx-class:fa-exclamation-circle="trigger_code == 'BREACHED'" aria-hidden="true"></i><span dmx-text="trigger_code == 'AT_RISK' ? 'At risk' : 'Breached'"></span></span></td><td><span class="escalation-level-pill" dmx-text="'Level ' + escalation_level"></span></td><td class="escalation-role-cell" dmx-text="target_role_label"></td><td class="escalation-reason-cell" dmx-text="reason_label"></td><td dmx-text="sort_order"></td><td><span class="logistics-status-pill" dmx-class:logistics-status-inactive="status != 'active'"><i class="fas fa-circle" aria-hidden="true"></i><span dmx-text="status == 'active' ? 'Active' : 'Inactive'"></span></span></td><td class="text-nowrap"><div class="logistics-row-actions"><button type="button" class="btn btn-bmobile-secondary logistics-edit-button" dmx-on:click="ruleSave.reset(true);ruleId.setValue(id);selectedRulePolicy.setValue(policy_id);selectedRuleTrigger.setValue(trigger_code);selectedRuleLevel.setValue(escalation_level);selectedRuleTarget.setValue(target_role_id);selectedRuleReason.setValue(reason_label);selectedRuleSort.setValue(sort_order);ruleModal.show()"><i class="fas fa-pen" aria-hidden="true"></i>Edit</button><button type="button" class="btn btn-bmobile-secondary logistics-edit-button" dmx-show="status == 'active'" dmx-on:click="ruleStatusId.setValue(id);ruleStatusValue.setValue('inactive');ruleStatusForm.submit()"><i class="fas fa-power-off" aria-hidden="true"></i>Deactivate</button><button type="button" class="btn btn-bmobile-secondary logistics-edit-button" dmx-show="status != 'active'" dmx-on:click="ruleStatusId.setValue(id);ruleStatusValue.setValue('active');ruleStatusForm.submit()"><i class="fas fa-power-off" aria-hidden="true"></i>Activate</button></div></td></tr></tbody></table></div>
          <p class="logistics-empty" dmx-show="ruleList.data.rules.count() == 0">No escalation rules are configured.</p>
        </section>
        <form id="ruleStatusForm" is="dmx-serverconnect-form" method="post" action="/api/escalations/rules/status" dmx-on:success="ruleNotice.setValue('Rule status updated.');ruleList.load()"><input type="hidden" name="id" dmx-bind:value="ruleStatusId.value"><input type="hidden" name="status" dmx-bind:value="ruleStatusValue.value"></form>
      </section>
      <div id="ruleModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="ruleModalTitle" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content portal-modal"><div class="escalation-modal-heading"><div class="escalation-modal-icon"><i class="fas fa-bell" aria-hidden="true"></i></div><div><span>ADMINISTRATION</span><h2 class="modal-title" id="ruleModalTitle" dmx-text="ruleId.value ? 'Edit Escalation Rule' : 'Add Escalation Rule'"></h2><p>Set the SLA trigger, escalation level and role to notify.</p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="ruleSave" is="dmx-serverconnect-form" method="post" action="/api/escalations/rules/save" dmx-on:success="ruleModal.hide();ruleNotice.setValue('Escalation rule saved.');ruleList.load()"><div class="modal-body"><input type="hidden" name="id" dmx-bind:value="ruleId.value"><input type="hidden" name="sort_order" dmx-bind:value="selectedRuleSort.value"><div class="alert alert-danger" role="alert" dmx-show="ruleSave.lastError.status" dmx-text="ruleSave.lastError.response && ruleSave.lastError.response.error ? ruleSave.lastError.response.error : 'Escalation rule could not be saved.'"></div><div class="row g-3"><div class="col-md-6"><label class="form-label" for="rulePolicy">SLA policy <span class="text-danger">*</span></label><select id="rulePolicy" name="policy_id" class="form-select" required dmx-bind:value="selectedRulePolicy.value"><option value="">Select policy</option><option dmx-repeat="ruleList.data.policies" dmx-bind:value="id" dmx-text="policy_code"></option></select></div><div class="col-md-6"><label class="form-label" for="ruleTrigger">Trigger <span class="text-danger">*</span></label><select id="ruleTrigger" name="trigger_code" class="form-select" required dmx-bind:value="selectedRuleTrigger.value"><option value="AT_RISK">At risk</option><option value="BREACHED">Breached</option></select></div><div class="col-md-6"><label class="form-label" for="ruleLevel">Escalation level <span class="text-danger">*</span></label><select id="ruleLevel" name="escalation_level" class="form-select" required dmx-bind:value="selectedRuleLevel.value"><option value="1">Level 1</option><option value="2">Level 2</option></select></div><div class="col-md-6"><label class="form-label" for="ruleTarget">Target role <span class="text-danger">*</span></label><select id="ruleTarget" name="target_role_id" class="form-select" required dmx-bind:value="selectedRuleTarget.value"><option value="">Select role</option><option dmx-repeat="ruleList.data.roles" dmx-bind:value="id" dmx-text="label"></option></select></div><div class="col-12"><label class="form-label" for="ruleReason">Reason / label <span class="text-danger">*</span></label><input id="ruleReason" name="reason_label" class="form-control" maxlength="240" required dmx-bind:value="selectedRuleReason.value"></div></div><p class="small text-muted mt-3 mb-0">New rules are saved inactive. Activation checks for duplicate active policy, trigger, level and target combinations.</p></div><div class="escalation-modal-footer"><button type="button" class="btn btn-bmobile-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-bmobile-primary"><i class="fas fa-save" aria-hidden="true"></i>Save Rule</button></div></form></div></div></div>
      <dmx-value id="selectedRulePolicy" value=""></dmx-value><dmx-value id="selectedRuleTrigger" value="AT_RISK"></dmx-value><dmx-value id="selectedRuleLevel" value="1"></dmx-value><dmx-value id="selectedRuleTarget" value=""></dmx-value><dmx-value id="selectedRuleReason" value=""></dmx-value><dmx-value id="selectedRuleSort" value="100"></dmx-value>
    </main>
  </div>
</div>
