<!-- Wappler include head-page="../layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="deviceImportDetailPage" appConnect="local" -->
<meta name="ac:route" content="/admin/device-imports/detail">
<div class="portal-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context"></dmx-serverconnect>
  <dmx-serverconnect id="scopeContext" url="/api/auth/scope_context"></dmx-serverconnect>
  <dmx-serverconnect id="batchDetail" url="/api/device-imports/detail" dmx-param:id="query.id"></dmx-serverconnect>
  <dmx-serverconnect id="batchRows" url="/api/device-imports/rows" dmx-param:batch_id="query.id" dmx-param:validation_status="rowStatus.value" dmx-param:search="rowSearch.value" dmx-param:page="rowPage.value" dmx-param:page_size="25"></dmx-serverconnect>
  <dmx-value id="rowPage" value="1"></dmx-value><dmx-value id="rowStatus"></dmx-value><dmx-value id="rowSearch"></dmx-value><dmx-value id="reviewNotice"></dmx-value> 
  <%- await include("../partials/portal-sidebar", { currentPage: "device-imports" }) %>
  <div class="portal-workspace">
    <%- await include("../partials/portal-topbar", { backHref: "/admin/device-imports", pageTitle: "Import Review" }) %>
    <main class="portal-main" aria-label="Import batch review">
      <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3"><div><p class="text-muted mb-1">Device Imports</p><h1 class="h3 mb-1" dmx-text="batchDetail.data.batch.batch_number">Batch</h1><div class="text-muted"><span dmx-text="batchDetail.data.batch.original_filename"></span><span class="mx-2">·</span><span dmx-text="batchDetail.data.batch.status"></span></div></div><div class="d-flex flex-wrap gap-2" dmx-show="authContext.data.can_device_imports_manage && (authContext.data.is_super_admin || scopeContext.data.has_national_scope)"><button class="btn btn-bmobile-secondary" type="button" dmx-show="batchDetail.data.batch.status == 'uploaded' || batchDetail.data.batch.status == 'validation_failed'" dmx-on:click="validateForm.reset(true);validateModal.show()"><i class="fas fa-check me-1"></i>Validate / Revalidate</button><button class="btn btn-bmobile-primary" type="button" dmx-show="batchDetail.data.batch.status == 'ready' && batchDetail.data.batch.invalid_rows == 0 && batchDetail.data.batch.valid_rows > 0" dmx-on:click="commitForm.reset(true);commitModal.show()">Commit Import</button><button class="btn btn-bmobile-secondary" type="button" dmx-show="batchDetail.data.batch.status == 'uploaded' || batchDetail.data.batch.status == 'validation_failed' || batchDetail.data.batch.status == 'ready'" dmx-on:click="cancelForm.reset(true);cancelModal.show()">Cancel Batch</button></div></div>
      <div class="alert alert-success" role="status" dmx-show="reviewNotice.value" dmx-text="reviewNotice.value"></div>
      <div class="text-muted py-3" role="status" dmx-show="batchDetail.state.executing">Loading batch...</div><div class="alert alert-danger" role="alert" dmx-show="batchDetail.lastError.status" dmx-text="batchDetail.lastError.response && batchDetail.lastError.response.error ? batchDetail.lastError.response.error : 'Batch details could not be loaded.'"></div>
      <section dmx-show="batchDetail.data.batch" aria-label="Batch summary"><div class="row g-3 mb-4"><div class="col-6 col-xl-3"><div class="border rounded p-3 h-100"><strong class="d-block h4 mb-0" dmx-text="batchDetail.data.batch.total_rows"></strong><span>Total Rows</span></div></div><div class="col-6 col-xl-3"><div class="border rounded p-3 h-100"><strong class="d-block h4 mb-0" dmx-text="batchDetail.data.batch.valid_rows"></strong><span>Valid</span></div></div><div class="col-6 col-xl-3"><div class="border rounded p-3 h-100"><strong class="d-block h4 mb-0" dmx-text="batchDetail.data.batch.invalid_rows"></strong><span>Invalid</span></div></div><div class="col-6 col-xl-3"><div class="border rounded p-3 h-100"><strong class="d-block h4 mb-0" dmx-text="batchDetail.data.batch.imported_rows"></strong><span>Imported</span></div></div></div><dl class="row border-bottom pb-3"><dt class="col-sm-2">Uploaded</dt><dd class="col-sm-4" dmx-text="batchDetail.data.batch.created_at.formatDate('MMM d, yyyy, hh:mm A')"></dd><dt class="col-sm-2">Validated</dt><dd class="col-sm-4" dmx-text="batchDetail.data.batch.validated_at ? batchDetail.data.batch.validated_at.formatDate('MMM d, yyyy, hh:mm A') : 'Not yet validated'"></dd><dt class="col-sm-2">Committed</dt><dd class="col-sm-4" dmx-text="batchDetail.data.batch.committed_at ? batchDetail.data.batch.committed_at.formatDate('MMM d, yyyy, hh:mm A') : 'Not committed'"></dd></dl></section>
      <div class="d-flex flex-wrap gap-2 mb-3"><input id="rowSearch" class="form-control" type="search" placeholder="Search serial or asset tag" dmx-on:input="rowPage.setValue(1);batchRows.load()" style="max-width: 360px"><select id="rowStatus" class="form-select" dmx-on:change="rowPage.setValue(1);batchRows.load()" style="max-width: 220px"><option value="">All row statuses</option><option value="pending">Pending</option><option value="valid">Valid</option><option value="invalid">Invalid</option><option value="imported">Imported</option></select></div>
      <div class="text-muted py-3" role="status" dmx-show="batchRows.state.executing">Loading rows...</div><div class="alert alert-danger" role="alert" dmx-show="batchRows.lastError.status" dmx-text="batchRows.lastError.response && batchRows.lastError.response.error ? batchRows.lastError.response.error : 'Batch rows could not be loaded.'"></div>
      <div class="table-responsive portal-table-wrapper"><table class="table portal-table align-middle"><thead><tr><th>Row</th><th>Serial</th><th>Asset Tag</th><th>Manufacturer</th><th>Model</th><th>Condition</th><th>Warranty</th><th>Status</th><th>Errors</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="batchRows.data.rows"><tr dmx-class:table-danger="validation_status == 'invalid'" dmx-class:table-success="validation_status == 'valid'"><td dmx-text="row_number"></td><td dmx-text="serial_number_normalized || serial_number_raw || '-'" class="text-break"></td><td dmx-text="asset_tag_normalized || asset_tag_raw || '-'" class="text-break"></td><td dmx-text="manufacturer_code_raw || '-'" class="text-break"></td><td dmx-text="model_code_raw || '-'" class="text-break"></td><td dmx-text="condition_code_raw || '-'" class="text-break"></td><td><span dmx-text="warranty_start_raw || '—'"></span><span> to </span><span dmx-text="warranty_end_raw || '—'"></span></td><td class="text-capitalize" dmx-text="validation_status"></td><td class="text-danger small" dmx-text="validation_errors || ''"></td></tr></tbody></table></div><p class="text-muted" dmx-show="!batchRows.state.executing && batchRows.data.rows.count() == 0">No rows match these filters.</p>
      <div class="d-flex justify-content-between align-items-center mt-3"><span class="text-muted" dmx-text="'Page ' + (batchRows.data.page || 1) + ' of ' + (batchRows.data.total_pages || 0) + ' · ' + (batchRows.data.total || 0) + ' rows'"></span><div class="btn-group"><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-bind:disabled="rowPage.value <= 1" dmx-on:click="rowPage.setValue(rowPage.value - 1);batchRows.load()" aria-label="Previous page"><i class="fas fa-chevron-left"></i></button><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-bind:disabled="rowPage.value >= batchRows.data.total_pages" dmx-on:click="rowPage.setValue(rowPage.value + 1);batchRows.load()" aria-label="Next page"><i class="fas fa-chevron-right"></i></button></div></div>
    </main>
  </div>
</div>
<div id="validateModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="validateTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="validateTitle">Validate Batch</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="validateForm" is="dmx-serverconnect-form" method="post" action="/api/device-imports/validate" dmx-on:success="validateModal.hide();batchDetail.load();batchRows.load();reviewNotice.setValue(validateForm.data.status == 'ready' ? 'All rows are valid. The batch is ready to commit.' : 'Validation completed. Review the row errors before uploading a corrected workbook.')"><div class="modal-body"><input type="hidden" name="batch_id" dmx-bind:value="batchDetail.data.batch.id"><div class="alert alert-danger" role="alert" dmx-show="validateForm.lastError.status" dmx-text="validateForm.lastError.response && validateForm.lastError.response.error ? validateForm.lastError.response.error : 'Batch validation failed.'"></div><p>Validate all staged rows. No devices are created during validation.</p></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="validateForm.state.executing">Validate</button></div></form></div></div></div>
<div id="commitModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="commitTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="commitTitle">Commit Import</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="commitForm" is="dmx-serverconnect-form" method="post" action="/api/device-imports/commit" dmx-on:success="commitModal.hide();batchDetail.load();batchRows.load();reviewNotice.setValue('Import committed successfully.')"><div class="modal-body"><input type="hidden" name="batch_id" dmx-bind:value="batchDetail.data.batch.id"><div class="alert alert-danger" role="alert" dmx-show="commitForm.lastError.status" dmx-text="commitForm.lastError.response && commitForm.lastError.response.error ? commitForm.lastError.response.error : 'The import could not be committed.'"></div><p>This all-or-nothing action will create <strong dmx-text="batchDetail.data.batch.valid_rows"></strong> devices with lifecycle Received. No devices are created if any row fails.</p></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="commitForm.state.executing">Commit Import</button></div></form></div></div></div>
<div id="cancelModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="cancelTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="cancelTitle">Cancel Batch</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="cancelForm" is="dmx-serverconnect-form" method="post" action="/api/device-imports/cancel" dmx-on:success="cancelModal.hide();batchDetail.load();batchRows.load();reviewNotice.setValue('Batch cancelled. Staging history has been retained.')"><div class="modal-body"><input type="hidden" name="batch_id" dmx-bind:value="batchDetail.data.batch.id"><div class="alert alert-danger" role="alert" dmx-show="cancelForm.lastError.status" dmx-text="cancelForm.lastError.response && cancelForm.lastError.response.error ? cancelForm.lastError.response.error : 'The batch could not be cancelled.'"></div><p>Cancel this batch? Staged rows will be retained for history and no devices will be created.</p></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Keep Batch</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="cancelForm.state.executing">Cancel Batch</button></div></form></div></div></div>
