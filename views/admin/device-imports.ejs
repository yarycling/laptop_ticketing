<!-- Wappler include head-page="../layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="deviceImportsPage" appConnect="local" -->
<meta name="ac:route" content="/admin/device-imports">
<div class="portal-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context"></dmx-serverconnect>
  <dmx-serverconnect id="scopeContext" url="/api/auth/scope_context"></dmx-serverconnect>
  <dmx-serverconnect id="batchList" url="/api/device-imports/list" dmx-param:search="batchSearch.value" dmx-param:status="batchStatus.value" dmx-param:page="batchPage.value" dmx-param:page_size="25"></dmx-serverconnect>
  <dmx-value id="batchPage" value="1"></dmx-value>
  <dmx-value id="importNotice"></dmx-value> 
  <%- await include("../partials/portal-sidebar", { currentPage: "device-imports" }) %>
  <div class="portal-workspace">
    <%- await include("../partials/portal-topbar") %>
    <main class="portal-main imports-page" aria-label="Device imports">
      <header class="portal-page-hero imports-hero"><div class="portal-page-hero-content"><p class="portal-eyebrow">Devices &amp; Students · Inventory</p><h1>Device Imports</h1><p>Import and manage device data from Excel files. Track batch status and validate imported information.</p></div><div class="hero-actions"><a class="btn btn-bmobile-secondary" href="/api/device-imports/template"><i class="fas fa-download me-1" aria-hidden="true"></i>Download Excel Template</a><button class="btn btn-bmobile-primary" type="button" dmx-show="authContext.data.can_device_imports_manage && (authContext.data.is_super_admin || scopeContext.data.has_national_scope)" dmx-on:click="deviceImportForm.reset(true);uploadModal.show()"><i class="fas fa-file-import me-1" aria-hidden="true"></i>Import Devices</button></div></header>
      <div class="imports-summary-card"><span class="imports-summary-icon"><i class="far fa-file-alt"></i></span><div><strong dmx-text="batchList.data.total || 0">0</strong><span>Total batches</span></div></div>
      
      <div class="alert alert-success" role="status" dmx-show="importNotice.value" dmx-text="importNotice.value"></div>
      <section class="page-filter-card"><div class="filter-card-heading"><h2><i class="fas fa-filter me-2" aria-hidden="true"></i>Filters</h2><button class="btn btn-link btn-sm" type="button" dmx-on:click="batchSearch.setValue('');batchStatus.setValue('');batchPage.setValue(1);batchList.load()"><i class="fas fa-undo me-1"></i>Clear all</button></div><div class="row g-3"><div class="col-12 col-md-8"><label class="visually-hidden" for="batchSearch">Search batches</label><input id="batchSearch" class="form-control" type="search" placeholder="Search batch number or filename" dmx-on:input="batchPage.setValue(1);batchList.load()"></div><div class="col-12 col-md-4"><label class="visually-hidden" for="batchStatus">Batch status</label><select id="batchStatus" class="form-select" dmx-on:change="batchPage.setValue(1);batchList.load()"><option value="">All statuses</option><option value="uploaded">Uploaded</option><option value="validating">Validating</option><option value="validation_failed">Validation failed</option><option value="ready">Ready</option><option value="committed">Committed</option><option value="cancelled">Cancelled</option></select></div></div></section>
      <div class="text-muted py-3" role="status" dmx-show="batchList.state.executing">Loading import batches...</div><div class="alert alert-danger" role="alert" dmx-show="batchList.lastError.status" dmx-text="batchList.lastError.response && batchList.lastError.response.error ? batchList.lastError.response.error : 'Import batches could not be loaded.'"></div>
      <div class="portal-card imports-table-card"><div class="table-responsive portal-table-wrapper"><table class="table portal-table align-middle"><thead><tr><th>Batch Number</th><th>Filename</th><th>Status</th><th>Rows</th><th>Valid</th><th>Invalid</th><th>Imported</th><th>Created</th><th>Actions</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="batchList.data.batches"><tr><td class="fw-semibold" dmx-text="batch_number"></td><td dmx-text="original_filename"></td><td><span class="badge text-bg-light text-capitalize" dmx-text="status"></span></td><td dmx-text="total_rows"></td><td dmx-text="valid_rows"></td><td dmx-text="invalid_rows"></td><td dmx-text="imported_rows"></td><td dmx-text="created_at.formatDate('MMM d, yyyy, hh:mm A')"></td><td><a class="btn btn-bmobile-secondary btn-sm" dmx-bind:href="'/admin/device-imports/detail?id=' + id">Review</a></td></tr></tbody></table><div class="catalogue-empty-state" dmx-show="!batchList.state.executing && batchList.data.batches.count() == 0"><span class="catalogue-empty-icon"><i class="fas fa-file-excel" aria-hidden="true"></i></span><h3>No import batches found</h3><p>Import device data using an Excel file to get started.</p><div class="hero-actions"><a class="btn btn-bmobile-secondary" href="/api/device-imports/template"><i class="fas fa-download me-1"></i>Download Excel Template</a><button class="btn btn-bmobile-primary" type="button" dmx-show="authContext.data.can_device_imports_manage && (authContext.data.is_super_admin || scopeContext.data.has_national_scope)" dmx-on:click="deviceImportForm.reset(true);uploadModal.show()"><i class="fas fa-file-import me-1"></i>Import Devices</button></div></div></div>
      <div class="d-flex justify-content-between align-items-center mt-3"><span class="text-muted" dmx-text="'Page ' + (batchList.data.page || 1) + ' of ' + (batchList.data.total_pages || 0) + ' · ' + (batchList.data.total || 0) + ' batches'"></span><div class="btn-group"><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-bind:disabled="batchPage.value <= 1" dmx-on:click="batchPage.setValue(batchPage.value - 1);batchList.load()" aria-label="Previous page"><i class="fas fa-chevron-left"></i></button><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-bind:disabled="batchPage.value >= batchList.data.total_pages" dmx-on:click="batchPage.setValue(batchPage.value + 1);batchList.load()" aria-label="Next page"><i class="fas fa-chevron-right"></i></button></div></div>
    </main>
  </div>
</div>

<div id="uploadModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="uploadTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="uploadTitle">Upload Device Excel Workbook</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="deviceImportForm" is="dmx-serverconnect-form" method="post" action="/api/device-imports/upload" enctype="multipart/form-data" dmx-on:success="uploadModal.hide();batchList.load();importNotice.setValue('Excel workbook uploaded to staging. Review the batch and validate it before committing.');deviceImportForm.reset(true)"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="deviceImportForm.lastError.status" dmx-text="deviceImportForm.lastError.response && deviceImportForm.lastError.response.error ? deviceImportForm.lastError.response.error : 'Excel workbook could not be uploaded.'"></div><p>Use the downloaded Excel template. It includes manufacturer, manufacturer-dependent model, and condition dropdowns plus date-formatted cells. Maximum 5,000 device rows and 10 MB. Required values: serial number, manufacturer, model, and condition. Optional values may be blank.</p><label class="form-label" for="xlsxFile">Microsoft Excel (.xlsx)</label><input id="xlsxFile" class="form-control" type="file" name="xlsx_file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required><input type="hidden" name="original_filename" dmx-bind:value="xlsxFile.files[0].name"><div class="modal-footer px-0 pb-0"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="deviceImportForm.state.executing">Upload</button></div></div></form></div></div></div>
