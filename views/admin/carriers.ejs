<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="carriersPage" appConnect="local" components="{dmxBootstrap5Modal:{}}" -->
<meta name="ac:route" content="/admin/carriers">
<div class="portal-shell logistics-shell carriers-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context"></dmx-serverconnect>
  <dmx-serverconnect id="carrierList" url="/api/admin/carriers/list" dmx-param:search="carrierSearch.value" dmx-param:page="carrierPage.value" dmx-param:page_size="carrierPageSizeSelect.value"></dmx-serverconnect>
  <dmx-serverconnect id="carrierCodePreview" url="/api/admin/carriers/code-preview" noload="true"></dmx-serverconnect>
  <dmx-value id="carrierNotice" value=""></dmx-value>
  <dmx-value id="carrierPage" value="1"></dmx-value>
  <dmx-value id="editCarrierId" value=""></dmx-value>
  <dmx-value id="editCarrierCode" value=""></dmx-value>
  <dmx-value id="editCarrierName" value=""></dmx-value>
  <dmx-value id="editCarrierSort" value="100"></dmx-value>
  <dmx-value id="carrierStatusId" value=""></dmx-value>
  <dmx-value id="carrierStatusValue" value=""></dmx-value>
  <%- await include("../partials/portal-sidebar", { currentPage: "carriers" }) %>
  <div class="portal-workspace">
    <%- await include("../partials/portal-topbar", { pageTitle: "Carriers" }) %>
    <main class="portal-main logistics-page carriers-page" aria-label="Carrier administration">
      <div class="logistics-breadcrumb" aria-label="Breadcrumb"><a href="/" aria-label="Home"><i class="fas fa-home" aria-hidden="true"></i></a><i class="fas fa-chevron-right" aria-hidden="true"></i><a href="/admin/organisation">Administration</a><i class="fas fa-chevron-right" aria-hidden="true"></i><strong>Carriers</strong></div>
      <header class="logistics-heading"><div class="logistics-heading-icon"><i class="fas fa-truck" aria-hidden="true"></i></div><div><h1>Carrier Administration</h1><p>Manage external carriers used for manufacturer return shipments. TTPost remains the system default.</p></div></header>

      <section class="logistics-stats" aria-label="Carrier summary">
        <article class="logistics-stat-card"><div class="logistics-stat-icon"><i class="fas fa-truck" aria-hidden="true"></i></div><div class="logistics-stat-copy"><span>Total Carriers</span><strong dmx-text="carrierList.data.all_total || 0"></strong><small>All configured carriers</small></div><span class="logistics-stat-arrow"><i class="fas fa-layer-group" aria-hidden="true"></i></span></article>
        <article class="logistics-stat-card"><div class="logistics-stat-icon logistics-stat-icon-box"><i class="fas fa-shipping-fast" aria-hidden="true"></i></div><div class="logistics-stat-copy"><span>Active Carriers</span><strong dmx-text="carrierList.data.active_total || 0"></strong><small>Available for shipments</small></div><span class="logistics-stat-arrow"><i class="fas fa-chevron-right" aria-hidden="true"></i></span></article>
        <article class="logistics-stat-card"><div class="logistics-stat-icon logistics-stat-icon-repair"><i class="fas fa-star" aria-hidden="true"></i></div><div class="logistics-stat-copy"><span>Default Carrier</span><strong dmx-text="carrierList.data.default_total || 0"></strong><small>System default carrier</small></div><span class="logistics-stat-arrow logistics-stat-arrow-blue"><i class="fas fa-chevron-right" aria-hidden="true"></i></span></article>
      </section>

      <div class="alert logistics-success" role="status" dmx-show="carrierNotice.value"><span class="logistics-success-icon"><i class="fas fa-check" aria-hidden="true"></i></span><span dmx-text="carrierNotice.value"></span><button type="button" class="btn-close ms-auto" aria-label="Dismiss success message" dmx-on:click="carrierNotice.setValue('')"></button></div>
      <div class="alert alert-danger logistics-error" role="alert" dmx-show="carrierList.lastError.status || carrierSave.lastError.status" dmx-text="carrierSave.lastError.response && carrierSave.lastError.response.error ? carrierSave.lastError.response.error : carrierList.lastError.response && carrierList.lastError.response.error ? carrierList.lastError.response.error : 'Carrier operation failed.'"></div>
      <div class="alert alert-danger logistics-error" role="alert" dmx-show="carrierStatusForm.lastError.status" dmx-text="carrierStatusForm.lastError.response && carrierStatusForm.lastError.response.error ? carrierStatusForm.lastError.response.error : 'Carrier status could not be updated.'"></div>

      <section class="logistics-card logistics-add-card" aria-labelledby="addCarrierTitle" dmx-show="authContext.data.can_carriers_manage">
        <div class="logistics-card-heading"><span class="logistics-add-icon"><i class="fas fa-plus" aria-hidden="true"></i></span><div><h2 id="addCarrierTitle">Add Carrier</h2><p>Create a carrier for manufacturer return shipments.</p></div></div>
        <form id="carrierSave" is="dmx-serverconnect-form" method="post" action="/api/admin/carriers/save" dmx-on:success="carrierList.load();carrierSave.reset(true);carrierPage.setValue(1);carrierNotice.setValue('Carrier created.')">
          <input id="carrierSort" name="sort_order" type="hidden" value="100">
          <div class="logistics-add-grid carriers-add-grid">
            <div><label class="form-label" for="carrierName">Carrier name <span>*</span></label><input id="carrierName" name="name" class="form-control" maxlength="180" required dmx-on:input="carrierCodePreview.load({name:carrierName.value}, true)" dmx-on:change="carrierCodePreview.load({name:carrierName.value}, true)"></div>
            <div><label class="form-label" for="carrierCode">Carrier code (generated) <span>*</span></label><input id="carrierCode" name="carrier_code" class="form-control logistics-code-field" maxlength="50" autocomplete="off" readonly required dmx-bind:value="carrierCodePreview.data.name == carrierName.value ? carrierCodePreview.data.code : ''"><small class="form-text">Generated from the carrier name.</small></div>
            <div class="carriers-form-submit"><button class="btn btn-bmobile-primary logistics-save-button" type="submit" dmx-bind:disabled="carrierSave.state.executing || carrierCodePreview.state.executing || carrierCodePreview.data.name != carrierName.value || !carrierCodePreview.data.code"><i class="fas fa-save" aria-hidden="true"></i>Save Carrier</button></div>
          </div>
        </form>
      </section>

      <section class="logistics-card logistics-table-card" aria-labelledby="carriersTitle">
        <header class="logistics-table-heading"><div class="logistics-card-heading"><span class="logistics-list-icon"><i class="fas fa-list" aria-hidden="true"></i></span><div><h2 id="carriersTitle">Carriers</h2><p>All carriers configured for the system.</p></div></div><label class="logistics-search"><i class="fas fa-search" aria-hidden="true"></i><span class="visually-hidden">Search carriers</span><input id="carrierSearch" type="search" placeholder="Search carriers..." dmx-on:input="carrierPage.setValue(1);carrierList.load()"></label></header>
        <div class="alert alert-danger logistics-error" role="alert" dmx-show="carrierList.lastError.status" dmx-text="carrierList.lastError.response && carrierList.lastError.response.error ? carrierList.lastError.response.error : 'Carriers could not be loaded.'"></div>
        <div class="table-responsive"><table class="table align-middle logistics-table carriers-table"><thead><tr><th>Code</th><th>Name</th><th>Type</th><th>Default</th><th>Status</th><th dmx-show="authContext.data.can_carriers_manage">Actions</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="carrierList.data.carriers"><tr><td class="logistics-code-cell" dmx-text="carrier_code"></td><td class="logistics-name-cell" dmx-text="name"></td><td dmx-text="carrier_type == 'EXTERNAL' ? 'External' : carrier_type"></td><td><span class="carrier-default-pill" dmx-class:carrier-default-yes="is_default == 1" dmx-text="is_default == 1 ? 'Default' : '—'"></span></td><td><span class="logistics-status-pill" dmx-class:logistics-status-inactive="status != 'active'"><i class="fas fa-circle" aria-hidden="true"></i><span dmx-text="status == 'active' ? 'Active' : 'Inactive'"></span></span></td><td dmx-show="authContext.data.can_carriers_manage"><div class="logistics-row-actions"><button class="btn btn-bmobile-secondary logistics-edit-button" type="button" dmx-on:click="editCarrierId.setValue(id);editCarrierCode.setValue(carrier_code);editCarrierName.setValue(name);editCarrierSort.setValue(sort_order);carrierEditModal.show()"><i class="fas fa-pen" aria-hidden="true"></i>Edit</button><button class="btn btn-bmobile-secondary carrier-status-button" type="button" dmx-show="carrier_code != 'TTPOST'" dmx-on:click="carrierStatusId.setValue(id);carrierStatusValue.setValue(status == 'active' ? 'inactive' : 'active');carrierStatusModal.show()"><i class="fas fa-power-off" aria-hidden="true"></i><span dmx-text="status == 'active' ? 'Deactivate' : 'Activate'"></span></button></div></td></tr></tbody></table></div>
        <p class="logistics-empty" dmx-show="!carrierList.state.executing && carrierList.data.total == 0" dmx-text="carrierSearch.value ? 'No carriers match your search.' : 'No carriers are configured.'"></p>
        <footer class="logistics-pagination"><span class="logistics-showing" dmx-text="'Showing ' + (carrierList.data.total == 0 ? 0 : ((carrierList.data.page - 1) * carrierList.data.page_size + 1)) + '–' + ((carrierList.data.page - 1) * carrierList.data.page_size + carrierList.data.carriers.length) + ' of ' + (carrierList.data.total || 0) + ' carriers'"></span><div class="logistics-page-controls"><label for="carrierPageSizeSelect">Items per page</label><select id="carrierPageSizeSelect" class="form-select" dmx-on:change="carrierPage.setValue(1);carrierList.load()"><option value="10">10</option><option value="25">25</option><option value="50">50</option></select><button class="btn logistics-page-button" type="button" aria-label="Previous page" dmx-bind:disabled="carrierList.data.page <= 1" dmx-on:click="carrierPage.setValue(carrierPage.value - 1);carrierList.load()"><i class="fas fa-chevron-left" aria-hidden="true"></i></button><span class="logistics-current-page" dmx-text="carrierList.data.page || 1"></span><button class="btn logistics-page-button" type="button" aria-label="Next page" dmx-bind:disabled="carrierList.data.page >= carrierList.data.total_pages" dmx-on:click="carrierPage.setValue(carrierPage.value + 1);carrierList.load()"><i class="fas fa-chevron-right" aria-hidden="true"></i></button></div></footer>
      </section>

      <div id="carrierEditModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="carrierEditTitle" aria-hidden="true" dmx-on:hidden="carrierEditForm.reset(true);editCarrierId.setValue('');editCarrierCode.setValue('');editCarrierName.setValue('');editCarrierSort.setValue(100)">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="carrierEditTitle">Edit Carrier</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
          <form id="carrierEditForm" is="dmx-serverconnect-form" method="post" action="/api/admin/carriers/save" dmx-on:success="carrierEditModal.hide();carrierEditForm.reset(true);carrierList.load();carrierNotice.setValue('Carrier updated.')"><div class="modal-body"><input type="hidden" name="carrier_id" dmx-bind:value="editCarrierId.value"><input id="editCarrierSortInput" name="sort_order" type="hidden" dmx-bind:value="editCarrierSort.value"><div class="mb-3"><label class="form-label" for="editCarrierCodeInput">Carrier code</label><input id="editCarrierCodeInput" name="carrier_code" class="form-control logistics-code-field" maxlength="50" autocomplete="off" readonly required dmx-bind:value="editCarrierCode.value"></div><div class="mb-3"><label class="form-label" for="editCarrierNameInput">Name</label><input id="editCarrierNameInput" name="name" class="form-control" maxlength="180" dmx-bind:value="editCarrierName.value" required></div><p class="small text-muted mt-3 mb-0">Carrier code and type are fixed after creation to preserve shipment history.</p></div><div class="modal-footer"><button type="button" class="btn btn-bmobile-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="carrierEditForm.state.executing">Save Changes</button></div></form>
        </div></div>
      </div>
      <div id="carrierStatusModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="carrierStatusTitle" aria-hidden="true" dmx-on:hidden="carrierStatusForm.reset(true);carrierStatusId.setValue('');carrierStatusValue.setValue('')">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="carrierStatusTitle" dmx-text="carrierStatusValue.value == 'inactive' ? 'Deactivate Carrier' : 'Activate Carrier'"></h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
          <form id="carrierStatusForm" is="dmx-serverconnect-form" method="post" action="/api/admin/carriers/status" dmx-on:success="carrierStatusModal.hide();carrierList.load();carrierNotice.setValue('Carrier status updated.');carrierStatusForm.reset(true)"><div class="modal-body"><input type="hidden" name="carrier_id" dmx-bind:value="carrierStatusId.value"><input type="hidden" name="status" dmx-bind:value="carrierStatusValue.value"><div class="alert alert-danger" role="alert" dmx-show="carrierStatusForm.lastError.status" dmx-text="carrierStatusForm.lastError.response && carrierStatusForm.lastError.response.error ? carrierStatusForm.lastError.response.error : 'Carrier status could not be updated.'"></div><p class="mb-0" dmx-text="carrierStatusValue.value == 'inactive' ? 'Deactivate this carrier? It will no longer be available for new shipments.' : 'Activate this carrier so it can be selected for shipments.'"></p></div><div class="modal-footer"><button type="button" class="btn btn-bmobile-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-bmobile-primary" dmx-bind:disabled="carrierStatusForm.state.executing" dmx-text="carrierStatusValue.value == 'inactive' ? 'Confirm Deactivation' : 'Confirm Activation'"></button></div></form>
        </div></div>
      </div>
    </main>
  </div>
</div>
