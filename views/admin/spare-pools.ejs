<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="sparePoolsPage" appConnect="local" components="{dmxBootstrap5Modal:{}}" -->
<meta name="ac:route" content="/admin/spare-pools">
<div class="portal-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context"></dmx-serverconnect>
  <dmx-serverconnect id="poolList" url="/api/admin/spare-pools/list" dmx-param:search="poolSearch.value" dmx-param:location_id="poolLocationFilter.value" dmx-param:status="poolStatusFilter.value" dmx-param:default_status="poolDefaultFilter.value"></dmx-serverconnect>
  <dmx-serverconnect id="poolCodePreview" url="/api/admin/spare-pools/code-preview" noload="true"></dmx-serverconnect>
  <dmx-value id="poolNotice" value=""></dmx-value>
  <dmx-value id="poolTab" value="list"></dmx-value>
  <dmx-value id="poolActionId" value=""></dmx-value>
  <dmx-value id="poolActionCode" value=""></dmx-value>
  <dmx-value id="poolActionStatus" value=""></dmx-value>
  <dmx-value id="poolEditId" value=""></dmx-value>
  <dmx-value id="poolEditName" value=""></dmx-value>
  <%- await include("../partials/portal-sidebar", { currentPage: "spare-pools" }) %>
  <div class="portal-workspace">
    <%- await include("../partials/portal-topbar", { pageTitle: "Repair Centre Spare Pools" }) %>
    <main class="portal-main service-page spare-pools-page">
      <nav class="small text-muted mb-3" aria-label="Breadcrumb"><a href="/">Home</a> <span class="mx-1">/</span> <a href="/admin/organisation">Administration</a> <span class="mx-1">/</span> <span>Spare Pools</span></nav>
      <header class="spare-pools-heading">
        <div class="d-flex align-items-center gap-3"><span class="spare-pools-title-icon"><i class="fas fa-boxes fa-lg" aria-hidden="true"></i></span><div><h1 class="h3 mb-1">Repair Centre Spare Pools</h1><p class="text-muted mb-0">Configure active spare pools used for temporary-loan requests at each repair centre.</p></div></div>
        <a class="btn btn-outline-secondary" href="/device-stock"><i class="fas fa-warehouse me-2" aria-hidden="true"></i>Repair Centre Stock</a>
      </header>
      <div class="alert alert-success d-flex align-items-center" role="status" dmx-show="poolNotice.value"><i class="fas fa-check-circle me-2" aria-hidden="true"></i><span dmx-text="poolNotice.value"></span><button type="button" class="btn-close ms-auto" aria-label="Dismiss" dmx-on:click="poolNotice.setValue('')"></button></div>
      <div class="alert alert-danger" role="alert" dmx-show="poolList.lastError.status" dmx-text="poolList.lastError.response && poolList.lastError.response.error ? poolList.lastError.response.error : 'Spare pools could not be loaded.'"></div>

      <section class="row g-3 mb-3 spare-pool-metrics" aria-label="Spare pool summary">
        <div class="col-6 col-xl-3"><article class="card spare-pool-metric metric-neutral h-100"><div class="card-body"><span class="metric-icon"><i class="fas fa-cubes" aria-hidden="true"></i></span><div><div class="small">Total Pools</div><div class="metric-value" dmx-text="(poolList.data.pools || []).length">0</div><div class="metric-caption">All configured pools</div></div></div></article></div>
        <div class="col-6 col-xl-3"><article class="card spare-pool-metric metric-green h-100"><div class="card-body"><span class="metric-icon"><i class="fas fa-check" aria-hidden="true"></i></span><div><div class="small">Active Pools</div><div class="metric-value" dmx-text="poolList.data.active_pool_count || 0">0</div><div class="metric-caption">Currently available</div></div></div></article></div>
        <div class="col-6 col-xl-3"><article class="card spare-pool-metric metric-blue h-100"><div class="card-body"><span class="metric-icon"><i class="fas fa-star" aria-hidden="true"></i></span><div><div class="small">Repair Centres with Default</div><div class="metric-value" dmx-text="(poolList.data.default_pools || []).length">0</div><div class="metric-caption">Have an active default</div></div></div></article></div>
        <div class="col-6 col-xl-3"><article class="card spare-pool-metric metric-red h-100"><div class="card-body"><span class="metric-icon"><i class="fas fa-exclamation" aria-hidden="true"></i></span><div><div class="small">Missing Default</div><div class="metric-value" dmx-text="(poolList.data.locations || []).length - (poolList.data.default_pools || []).length">0</div><div class="metric-caption">Repair centres without a default</div></div></div></article></div>
      </section>
      <div class="alert alert-warning" role="status" dmx-show="(poolList.data.locations || []).length - (poolList.data.default_pools || []).length > 0"><i class="fas fa-exclamation-triangle me-2" aria-hidden="true"></i><span dmx-text="(poolList.data.locations || []).length - (poolList.data.default_pools || []).length + ' active repair centre(s) have no active default spare pool. Temporary-loan requests are unavailable at those centres until a default is configured.'"></span></div>

      <section class="card spare-pools-main-card" aria-labelledby="poolListTitle">
        <div class="spare-pools-tabs" role="tablist" aria-label="Spare pool actions">
          <button class="spare-pools-tab" id="poolListTab" type="button" role="tab" dmx-bind:aria-selected="poolTab.value == 'list'" dmx-class:active="poolTab.value == 'list'" dmx-on:click="poolTab.setValue('list')"><i class="fas fa-box-open me-2" aria-hidden="true"></i>Spare Pools</button>
          <button class="spare-pools-tab" id="poolCreateTab" type="button" role="tab" dmx-bind:aria-selected="poolTab.value == 'create'" dmx-class:active="poolTab.value == 'create'" dmx-show="authContext.data.can_spare_pools_manage" dmx-on:click="poolTab.setValue('create')"><i class="fas fa-plus me-2" aria-hidden="true"></i>Create Pool</button>
        </div>
        <div class="spare-pools-panel" role="tabpanel" aria-labelledby="poolListTab" dmx-show="poolTab.value == 'list'">
          <div class="row g-3 align-items-end spare-pool-filters">
            <div class="col-md-4"><label class="form-label" for="poolSearch">Search</label><div class="input-icon-wrap"><i class="fas fa-search" aria-hidden="true"></i><input id="poolSearch" class="form-control" type="search" placeholder="Search pool name or code..." dmx-on:input="poolList.load()"></div></div>
            <div class="col-md-3"><label class="form-label" for="poolLocationFilter">Repair Centre</label><select id="poolLocationFilter" class="form-select" dmx-on:change="poolList.load()"><option value="">All repair centres</option><option dmx-repeat="poolList.data.filter_locations" dmx-bind:value="id" dmx-text="name">Repair centre</option></select></div>
            <div class="col-md-2"><label class="form-label" for="poolStatusFilter">Status</label><select id="poolStatusFilter" class="form-select" dmx-on:change="poolList.load()"><option value="">All status</option><option value="active">Active</option><option value="inactive">Inactive</option></select></div>
            <div class="col-md-2"><label class="form-label" for="poolDefaultFilter">Default</label><select id="poolDefaultFilter" class="form-select" dmx-on:change="poolList.load()"><option value="">All pools</option><option value="1">Default</option><option value="0">Non-default</option></select></div>
            <div class="col-md-1"><button class="btn btn-outline-secondary w-100 clear-pool-filters" type="button" aria-label="Clear Filters" title="Clear Filters" dmx-on:click="poolSearch.setValue('');poolLocationFilter.setValue('');poolStatusFilter.setValue('');poolDefaultFilter.setValue('');poolList.load()"><i class="fas fa-times me-1" aria-hidden="true"></i><span class="d-md-none">Clear Filters</span></button></div>
          </div>
          <div class="table-responsive spare-pools-table-wrap"><table class="table align-middle mb-0"><thead><tr><th>Repair Centre <i class="fas fa-sort ms-1" aria-hidden="true"></i></th><th>Pool Name <i class="fas fa-sort ms-1" aria-hidden="true"></i></th><th>Pool Code <i class="fas fa-sort ms-1" aria-hidden="true"></i></th><th>Status <i class="fas fa-sort ms-1" aria-hidden="true"></i></th><th>Default <i class="fas fa-sort ms-1" aria-hidden="true"></i></th><th>Created <i class="fas fa-sort ms-1" aria-hidden="true"></i></th><th class="text-end">Actions</th></tr></thead>
            <tbody is="dmx-repeat" dmx-bind:repeat="poolList.data.pools"><tr>
              <td><div class="fw-semibold" dmx-text="location_name"></div><small class="text-muted" dmx-text="location_code"></small></td>
              <td><span class="fw-semibold" dmx-text="name"></span></td><td><code class="pool-code" dmx-text="pool_code"></code></td>
              <td><span class="status-pill" dmx-class:status-active="status == 'active'" dmx-class:status-inactive="status != 'active'"><i class="fas fa-check-circle me-1" aria-hidden="true" dmx-show="status == 'active'"></i><span dmx-text="status == 'active' ? 'Active' : 'Inactive'"></span></span></td>
              <td><span class="default-pill" dmx-class:is-default="is_default == 1 && status == 'active'" dmx-class:is-not-default="is_default != 1 || status != 'active'"><i class="fas fa-star me-1" aria-hidden="true" dmx-show="is_default == 1 && status == 'active'"></i><span dmx-text="is_default == 1 && status == 'active' ? 'Default' : '—'"></span></span></td>
              <td><span dmx-text="created_at ? created_at.formatDate('MMM d, yyyy, h:mm A') : '—'"></span></td>
              <td class="text-end text-nowrap"><button class="btn btn-sm btn-outline-secondary me-1" type="button" dmx-show="authContext.data.can_spare_pools_manage" dmx-on:click="poolEditId.setValue(id);poolEditName.setValue(name);editPoolModal.show()"><i class="fas fa-pen me-1" aria-hidden="true"></i>Edit</button>
                <button class="btn btn-sm btn-outline-success me-1" type="button" dmx-show="authContext.data.can_spare_pools_manage && status == 'active' && is_default != 1" dmx-on:click="poolActionId.setValue(id);poolActionCode.setValue(pool_code);setDefaultModal.show()">Set default</button>
                <button class="btn btn-sm btn-outline-warning" type="button" dmx-show="authContext.data.can_spare_pools_manage" dmx-on:click="poolActionId.setValue(id);poolActionCode.setValue(pool_code);poolActionStatus.setValue(status == 'active' ? 'inactive' : 'active');poolStatusModal.show()" dmx-text="status == 'active' ? 'Deactivate' : 'Reactivate'">Deactivate</button>
              </td>
            </tr></tbody>
          </table></div>
          <div class="spare-pools-table-footer"><span dmx-text="'Showing ' + (poolList.data.pools || []).length + ' of ' + (poolList.data.pools || []).length + ' pools'">Showing 0 pools</span><nav aria-label="Spare pool pages"><button class="btn btn-light" type="button" disabled aria-label="Previous page"><i class="fas fa-chevron-left" aria-hidden="true"></i></button><button class="btn btn-success" type="button" aria-current="page">1</button><button class="btn btn-light" type="button" disabled aria-label="Next page"><i class="fas fa-chevron-right" aria-hidden="true"></i></button></nav></div>
          <p class="text-center text-muted py-4 mb-0" dmx-show="!poolList.state.executing && (poolList.data.pools || []).length == 0">No spare pools are configured yet. Add one above to enable temporary-loan requests at a repair centre.</p>
        </div>
        <div class="spare-pools-panel spare-pools-create-panel" role="tabpanel" aria-labelledby="poolCreateTab" dmx-show="poolTab.value == 'create' && authContext.data.can_spare_pools_manage">
          <div class="spare-pool-create-heading"><span class="spare-pool-create-icon"><i class="fas fa-plus" aria-hidden="true"></i></span><div><h2 id="newPoolTitle" class="h4 mb-1">Create a Spare Pool</h2><p class="text-muted mb-0">Choose a repair centre and create an active pool. You can make it the default now or set the default later.</p></div></div>
          <div class="alert alert-danger" role="alert" dmx-show="createPoolForm.lastError.status" dmx-text="createPoolForm.lastError.response && createPoolForm.lastError.response.error ? createPoolForm.lastError.response.error : 'Spare pool could not be created.'"></div>
          <form id="createPoolForm" class="spare-pool-create-form" is="dmx-serverconnect-form" method="post" action="/api/admin/spare-pools/save" dmx-on:success="poolList.load();createPoolForm.reset(true);poolNotice.setValue('Spare pool created.');poolTab.setValue('list')">
            <div class="row g-3 align-items-start">
              <div class="col-md-6 col-xl-3"><label class="form-label" for="newPoolCode">Pool code <span class="text-danger">*</span></label><input id="newPoolCode" name="pool_code" class="form-control text-uppercase" maxlength="80" required readonly placeholder="GENERATED FROM CENTRE AND NAME" dmx-bind:value="poolCodePreview.data.name == newPoolName.value && poolCodePreview.data.service_location_id == newPoolLocation.value ? poolCodePreview.data.code : ''"><small class="form-text">Generated from repair-centre code and pool name.</small></div>
              <div class="col-md-6 col-xl-3"><label class="form-label" for="newPoolName">Pool name <span class="text-danger">*</span></label><input id="newPoolName" name="name" class="form-control" maxlength="180" required placeholder="Head Office Spare Pool" dmx-on:input="poolCodePreview.load({name:newPoolName.value,service_location_id:newPoolLocation.value}, true)" dmx-on:change="poolCodePreview.load({name:newPoolName.value,service_location_id:newPoolLocation.value}, true)"></div>
              <div class="col-md-6 col-xl-3"><label class="form-label" for="newPoolLocation">Repair centre <span class="text-danger">*</span></label><select id="newPoolLocation" name="service_location_id" class="form-select" required dmx-on:change="poolCodePreview.load({name:newPoolName.value,service_location_id:this.value}, true)"><option value="">Select a repair centre</option><option dmx-repeat="poolList.data.locations" dmx-bind:value="id" dmx-text="name + ' (' + code + ')'">Repair Centre</option></select></div>
              <div class="col-md-6 col-xl-2"><label class="form-label" for="newPoolDefault">Default pool</label><select id="newPoolDefault" name="is_default" class="form-select"><option value="0">Create as non-default</option><option value="1">Make default</option></select></div>
              <div class="col-12 col-xl-1 spare-pool-save-col"><button class="btn btn-success spare-pool-save-button" type="submit" dmx-bind:disabled="createPoolForm.state.executing || !poolCodePreview.data.code || poolCodePreview.data.name != newPoolName.value || poolCodePreview.data.service_location_id != newPoolLocation.value"><i class="fas fa-save me-2" aria-hidden="true"></i>Save</button></div>
            </div>
          </form>
        </div>
      </section>

      <section class="row g-3 mt-0 spare-pools-bottom">
        <div class="col-lg-6"><article class="card h-100 spare-pools-info-card"><div class="card-body p-4"><div class="d-flex align-items-center gap-3 mb-3"><span class="info-icon info-star"><i class="fas fa-star" aria-hidden="true"></i></span><div><h2 class="h5 mb-1">Default Pool by Repair Centre</h2><p class="small text-muted mb-0">Shows the currently configured default spare pool for each repair centre.</p></div></div>
          <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Repair Centre</th><th>Default Pool</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="poolList.data.default_pools"><tr><td><div class="fw-semibold" dmx-text="location_name"></div><small class="text-muted" dmx-text="location_code"></small></td><td><span class="default-pool-name"><i class="fas fa-star me-2" aria-hidden="true"></i><span dmx-text="pool_name"></span></span></td></tr></tbody></table></div>
          <p class="small text-muted mt-3 mb-0" dmx-text="'Showing ' + (poolList.data.default_pools || []).length + ' of ' + (poolList.data.locations || []).length + ' repair centres'">Showing 0 repair centres</p>
        </div></article></div>
        <div class="col-lg-6"><article class="card h-100 spare-pools-about"><div class="card-body p-4"><div class="d-flex align-items-start gap-3"><span class="info-icon info-blue"><i class="fas fa-info" aria-hidden="true"></i></span><div><h2 class="h5 mb-1">About Spare Pools</h2><p class="small text-muted mb-2">Spare pools define which devices can be selected for temporary-loan requests at each repair centre.</p><ul class="small text-muted spare-pools-rules"><li>Each repair centre can have multiple pools.</li><li>At most one pool can be set as the default for a repair centre.</li><li>Only active pools are available for selection.</li><li>The default pool is automatically used when no explicit pool is chosen.</li><li>Use Repair Centre Stock to manage the physical devices available at each centre.</li></ul><a class="btn btn-outline-secondary mt-1" href="/device-stock"><i class="fas fa-warehouse me-2" aria-hidden="true"></i>Open Repair Centre Stock</a></div></div></div></article></div>
      </section>
    </main>
  </div>
</div>

<div id="editPoolModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="editPoolTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title h5" id="editPoolTitle">Edit Spare Pool</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="editPoolForm" is="dmx-serverconnect-form" method="post" action="/api/admin/spare-pools/save" dmx-on:success="editPoolModal.hide();poolList.load();poolNotice.setValue('Spare pool updated.')"><div class="modal-body"><input type="hidden" name="id" dmx-bind:value="poolEditId.value"><div class="alert alert-danger" role="alert" dmx-show="editPoolForm.lastError.status" dmx-text="editPoolForm.lastError.response && editPoolForm.lastError.response.error ? editPoolForm.lastError.response.error : 'Spare pool could not be updated.'"></div><label class="form-label" for="editPoolName">Pool name</label><input id="editPoolName" name="name" class="form-control" maxlength="180" required dmx-bind:value="poolEditName.value"><p class="small text-muted mt-2 mb-0">The pool code and repair-centre assignment are retained for history integrity.</p></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-success" type="submit" dmx-bind:disabled="editPoolForm.state.executing">Save Changes</button></div></form></div></div></div>

<div id="setDefaultModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="setDefaultTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title h5" id="setDefaultTitle">Change Default Spare Pool</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="setDefaultForm" is="dmx-serverconnect-form" method="post" action="/api/admin/spare-pools/set-default" dmx-on:success="setDefaultModal.hide();poolList.load();poolNotice.setValue('Default spare pool updated.')"><div class="modal-body"><input type="hidden" name="id" dmx-bind:value="poolActionId.value"><div class="alert alert-danger" role="alert" dmx-show="setDefaultForm.lastError.status" dmx-text="setDefaultForm.lastError.response && setDefaultForm.lastError.response.error ? setDefaultForm.lastError.response.error : 'Default pool could not be changed.'"></div><p>Make <strong dmx-text="poolActionCode.value"></strong> the active default for its repair centre? Any previous default for that centre will be cleared.</p></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-success" type="submit" dmx-bind:disabled="setDefaultForm.state.executing">Set Default</button></div></form></div></div></div>

<div id="poolStatusModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="poolStatusTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title h5" id="poolStatusTitle" dmx-text="poolActionStatus.value == 'active' ? 'Reactivate Spare Pool' : 'Deactivate Spare Pool'">Change Spare Pool Status</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="poolStatusForm" is="dmx-serverconnect-form" method="post" action="/api/admin/spare-pools/status" dmx-on:success="poolStatusModal.hide();poolList.load();poolNotice.setValue(poolStatusForm.data.warning || poolStatusForm.data.message)"><div class="modal-body"><input type="hidden" name="id" dmx-bind:value="poolActionId.value"><input type="hidden" name="status" dmx-bind:value="poolActionStatus.value"><div class="alert alert-danger" role="alert" dmx-show="poolStatusForm.lastError.status" dmx-text="poolStatusForm.lastError.response && poolStatusForm.lastError.response.error ? poolStatusForm.lastError.response.error : 'Pool status could not be changed.'"></div><p dmx-show="poolActionStatus.value == 'inactive'">Deactivate <strong dmx-text="poolActionCode.value"></strong>? It will no longer be used for new temporary-loan requests. Existing loan history will remain intact.</p><p dmx-show="poolActionStatus.value == 'active'">Reactivate <strong dmx-text="poolActionCode.value"></strong>? It will return as a non-default pool. Set it as default separately if required.</p><p class="small text-warning mb-0" dmx-show="poolActionStatus.value == 'inactive'">If this is the current default, the repair centre will have no default pool until you choose another active pool.</p></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn" type="submit" dmx-class:btn-success="poolActionStatus.value == 'active'" dmx-class:btn-warning="poolActionStatus.value == 'inactive'" dmx-bind:disabled="poolStatusForm.state.executing" dmx-text="poolActionStatus.value == 'active' ? 'Reactivate Pool' : 'Deactivate Pool'">Confirm</button></div></form></div></div></div>
