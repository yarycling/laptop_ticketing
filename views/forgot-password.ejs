<!-- Wappler include head-page="layouts/auth" bootstrap5="local" is="dmx-app" id="forgotPassword" appConnect="local" -->
<meta name="ac:route" content="/forgot-password">

<div class="forgot-password-page">
  <section class="forgot-intro-panel" aria-labelledby="forgotIntroTitle">
    <img class="brand-logo forgot-intro-logo" src="/assets/img/brand/bmobile-logo.png" alt="bmobile">
    <div class="forgot-intro-content">
      <h1 id="forgotIntroTitle">Your account<br><span>is in good hands</span></h1>
      <p class="forgot-intro-lead">We’ll help you get back to what matters, quickly and securely.</p>
      <div class="forgot-benefits" aria-label="Password recovery benefits">
        <article class="forgot-benefit">
          <span class="forgot-benefit-icon"><i class="fas fa-lock" aria-hidden="true"></i></span>
          <div><h2>Secure &amp; private</h2><p>Your information is always kept safe and confidential.</p></div>
        </article>
        <article class="forgot-benefit">
          <span class="forgot-benefit-icon"><i class="fas fa-envelope" aria-hidden="true"></i></span>
          <div><h2>Fast recovery</h2><p>Reset instructions are sent promptly if we find a match.</p></div>
        </article>
        <article class="forgot-benefit">
          <span class="forgot-benefit-icon"><i class="fas fa-shield-alt" aria-hidden="true"></i></span>
          <div><h2>Get back on track</h2><p>Regain access to your account in just a few steps.</p></div>
        </article>
      </div>
    </div>
  </section>

  <section class="forgot-form-panel" aria-label="Password recovery">
    <div class="forgot-form-card">
      <div class="forgot-card-brand"><img class="brand-logo forgot-card-logo" src="/assets/img/brand/bmobile-logo.png" alt="bmobile"></div>
      <h2>Forgot password?</h2>
      <p class="forgot-card-copy">Enter your username or email address. If an account matches, reset instructions will be sent to its registered email address.</p>
      <dmx-value id="forgotRequestSent" value="0"></dmx-value>
      <form id="forgotPasswordForm" is="dmx-serverconnect-form" class="portal-form forgot-form" method="post" action="/api/auth/forgot-password" dmx-on:success="forgotRequestSent.setValue(true)" novalidate>
        <div class="mb-3">
          <label for="forgotIdentifier" class="form-label">Username or email</label>
          <div class="forgot-input-wrap">
            <i class="far fa-envelope" aria-hidden="true"></i>
            <input id="forgotIdentifier" name="identifier" type="text" class="form-control" placeholder="Enter your username or email" autocomplete="username" maxlength="254" required>
          </div>
        </div>
        <div class="portal-alert portal-alert-success" role="status" dmx-show="forgotRequestSent.value == 1">If an account matches the information provided, password reset instructions will be sent to its registered email address.</div>
        <div class="portal-alert portal-alert-danger" role="alert" dmx-show="forgotPasswordForm.lastError.status">We could not process the request right now. Please try again later.</div>
        <button class="btn btn-bmobile-primary forgot-submit w-100" type="submit" dmx-bind:disabled="forgotPasswordForm.state.executing || forgotRequestSent.value == 1">
          <span dmx-show="!forgotPasswordForm.state.executing">Send reset link <i class="fas fa-arrow-right ms-2" aria-hidden="true"></i></span>
          <span dmx-show="forgotPasswordForm.state.executing">Processing...</span>
        </button>
      </form>
      <div class="forgot-divider"><span>OR</span></div>
      <a class="forgot-back-link" href="/login"><i class="fas fa-arrow-left" aria-hidden="true"></i>Back to sign in</a>
    </div>
  </section>
</div>
