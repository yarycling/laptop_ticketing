<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="ticketIntakePage" appConnect="local" components="{dmxBootstrap5Modal:{},dmxPhoneMask:{}}" -->
<meta name="ac:route" content="/tickets/new">
<div class="portal-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context"></dmx-serverconnect>
  <dmx-serverconnect id="districtOptions" url="/api/tickets/district-options"></dmx-serverconnect>
  <dmx-serverconnect id="schoolOptions" url="/api/tickets/school-options" dmx-param:district_id="districtSelect.value"></dmx-serverconnect>
  <dmx-serverconnect id="eligibleDevices" url="/api/tickets/eligible-devices" noload="true" dmx-param:school_id="schoolSelect.value" dmx-param:search="deviceSearch.value" dmx-param:page="devicePage.value" dmx-param:page_size="25"></dmx-serverconnect>
  <dmx-value id="devicePage" value="1"></dmx-value>
  <dmx-value id="selectedDevice" value=""></dmx-value>
  <dmx-value id="selectedSerial" value=""></dmx-value>
  <%- await include("partials/portal-sidebar", { currentPage: "tickets" }) %>
  <div class="portal-workspace"><%- await include("partials/portal-topbar", { backHref: "/tickets", pageTitle: "Create Ticket" }) %>
    <main class="portal-main ticket-create-page" aria-label="Create ticket">
      <header class="ticket-create-hero"><div class="ticket-create-hero-copy"><span class="ticket-create-eyebrow">TICKET INTAKE</span><h1>New Ticket</h1><p>Record a device issue on behalf of a student, parent, teacher, or staff member.</p></div></header>
      <form id="ticketCreateForm" is="dmx-serverconnect-form" method="post" action="/api/tickets/create" dmx-on:success="ticketConfirmModal.hide();ticketCreatedModal.show()">
        <div class="alert alert-danger" role="alert" dmx-show="ticketCreateForm.lastError.status" dmx-text="ticketCreateForm.lastError.response && ticketCreateForm.lastError.response.error ? ticketCreateForm.lastError.response.error : 'Ticket could not be created.'"></div>
        <input type="hidden" name="device_id" dmx-bind:value="selectedDevice.value">
        <section class="ticket-create-card ticket-create-device-card" aria-labelledby="deviceSelectionTitle"><div class="ticket-create-section-heading"><span class="ticket-create-step">1</span><div><h2 id="deviceSelectionTitle">Select Device</h2><p>Choose the district, school and select the device from the list of eligible devices.</p></div></div>
          <div class="row g-3 mb-3"><div class="col-12 col-md-6"><label class="form-label" for="districtSelect"><i class="fas fa-map-marker-alt" aria-hidden="true"></i> District</label><select id="districtSelect" class="form-select" required dmx-on:change="schoolSelect.setValue('');selectedDevice.setValue('');selectedSerial.setValue('');devicePage.setValue(1);schoolOptions.load({district_id:this.value}, true)"><option value="">Select district</option><option dmx-repeat="districtOptions.data.districts" dmx-bind:value="id" dmx-text="name"></option></select></div><div class="col-12 col-md-6"><label class="form-label" for="schoolSelect"><i class="fas fa-school" aria-hidden="true"></i> School</label><select id="schoolSelect" class="form-select" required dmx-on:change="selectedDevice.setValue('');selectedSerial.setValue('');devicePage.setValue(1);eligibleDevices.load({school_id:this.value,search:deviceSearch.value,page:1,page_size:25}, true)"><option value="">Select school</option><option dmx-repeat="schoolOptions.data.schools" dmx-bind:value="id" dmx-text="name"></option></select></div></div>
          <div class="ticket-eligible-devices-heading"><h3><i class="fas fa-laptop" aria-hidden="true"></i> Eligible Devices</h3><label class="ticket-device-search"><i class="fas fa-search" aria-hidden="true"></i><span class="visually-hidden">Search eligible devices</span><input id="deviceSearch" class="form-control" type="search" placeholder="Search serial number or asset tag..." dmx-bind:disabled="!schoolSelect.value" dmx-on:input="devicePage.setValue(1);eligibleDevices.load({school_id:schoolSelect.value,search:deviceSearch.value,page:1,page_size:25}, true)"></label></div><div class="text-muted small ticket-device-loading" role="status" dmx-show="eligibleDevices.state.executing">Loading eligible devices...</div>
          <div class="alert alert-danger" role="alert" dmx-show="eligibleDevices.lastError.status" dmx-text="eligibleDevices.lastError.response && eligibleDevices.lastError.response.error ? eligibleDevices.lastError.response.error : 'Eligible devices could not be loaded.'"></div>
          <div class="table-responsive portal-table-wrapper ticket-eligible-devices-table" dmx-show="eligibleDevices.data.devices.count() > 0"><table class="table portal-table align-middle"><thead><tr><th><span class="visually-hidden">Select</span></th><th>Serial</th><th>Asset Tag</th><th>Manufacturer / Model</th><th>Condition</th><th>Custody</th><th>Student</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="eligibleDevices.data.devices"><tr dmx-class:table-success="device_id == selectedDevice.value"><td><input class="form-check-input" type="radio" aria-label="Select this device" dmx-bind:checked="device_id == selectedDevice.value" dmx-on:change="selectedDevice.setValue(device_id);selectedSerial.setValue(serial_number)"></td><td><a class="ticket-device-serial" dmx-bind:href="'/devices/detail?id=' + device_id" dmx-text="serial_number"></a></td><td dmx-text="asset_tag || '-'">-</td><td><span dmx-text="manufacturer"></span><br><small class="text-muted" dmx-text="model"></small></td><td dmx-text="condition"></td><td dmx-text="current_custody_level"></td><td dmx-text="student_reference ? student_reference + ' — ' + student_first_name + ' ' + student_last_name : '-'">-</td></tr></tbody></table></div>
          <div class="ticket-device-empty" dmx-show="!eligibleDevices.state.executing && eligibleDevices.data.devices.count() == 0"><span><i class="fas fa-laptop" aria-hidden="true"></i></span><strong dmx-text="schoolSelect.value ? 'No eligible devices found' : 'Search for a device'"></strong><p dmx-text="schoolSelect.value ? 'No eligible devices are available for the selected school.' : 'Enter a serial number or asset tag to find an eligible device.'"></p></div>
          <div class="d-flex justify-content-end mt-2 mb-3"><div class="btn-group"><button class="btn btn-bmobile-secondary btn-sm" type="button" aria-label="Previous devices" dmx-bind:disabled="devicePage.value <= 1" dmx-on:click="devicePage.setValue(devicePage.value - 1);eligibleDevices.load({school_id:schoolSelect.value,search:deviceSearch.value,page:devicePage.value - 1,page_size:25}, true)"><i class="fas fa-chevron-left" aria-hidden="true"></i></button><button class="btn btn-bmobile-secondary btn-sm" type="button" aria-label="Next devices" dmx-bind:disabled="eligibleDevices.data.devices.count() < 25" dmx-on:click="devicePage.setValue(devicePage.value + 1);eligibleDevices.load({school_id:schoolSelect.value,search:deviceSearch.value,page:devicePage.value + 1,page_size:25}, true)"><i class="fas fa-chevron-right" aria-hidden="true"></i></button></div></div>
          <div is="dmx-repeat" dmx-bind:repeat="eligibleDevices.data.devices"><section class="border rounded p-3" dmx-show="device_id == selectedDevice.value"><span class="text-muted small">Selected Device</span><dl class="row mb-0 mt-2"><dt class="col-sm-4">Serial Number</dt><dd class="col-sm-8 fw-semibold" dmx-text="serial_number"></dd><dt class="col-sm-4">Asset Tag</dt><dd class="col-sm-8" dmx-text="asset_tag || 'Not recorded'"></dd><dt class="col-sm-4">Manufacturer / Model</dt><dd class="col-sm-8" dmx-text="manufacturer + ' / ' + model"></dd><dt class="col-sm-4">Condition</dt><dd class="col-sm-8" dmx-text="condition"></dd><dt class="col-sm-4">Lifecycle</dt><dd class="col-sm-8" dmx-text="lifecycle_code"></dd><dt class="col-sm-4">Current Custody</dt><dd class="col-sm-8" dmx-text="current_custody_level"></dd><dt class="col-sm-4">District / School</dt><dd class="col-sm-8" dmx-text="district_name + ' / ' + school_name"></dd><dt class="col-sm-4" dmx-show="student_reference">Student</dt><dd class="col-sm-8" dmx-show="student_reference" dmx-text="student_reference + ' — ' + student_first_name + ' ' + student_last_name"></dd></dl><p class="small text-muted mt-3 mb-0">Ticket origin will be captured from this device's current school/student context.</p></section></div>
        </section>
        <section class="ticket-create-card" aria-labelledby="requesterTitle"><div class="ticket-create-section-heading"><span class="ticket-create-step">2</span><div><h2 id="requesterTitle">Requester</h2><p>Provide details about the person making this request.</p></div></div><div class="row g-3"><div class="col-12 col-md-6"><label class="form-label" for="requesterType"><i class="fas fa-users" aria-hidden="true"></i> Requester Type</label><select id="requesterType" name="requester_type" class="form-select" required><option value="">Select requester type</option><option value="STUDENT">Student</option><option value="PARENT">Parent</option><option value="TEACHER">Teacher</option><option value="STAFF">Staff</option></select></div><div class="col-12 col-md-6"><label class="form-label" for="requesterName"><i class="fas fa-user" aria-hidden="true"></i> Requester Name</label><input id="requesterName" name="requester_name" class="form-control" maxlength="220" placeholder="Enter full name" required></div><div class="col-12 col-md-6"><label class="form-label" for="requesterEmail"><i class="fas fa-envelope" aria-hidden="true"></i> Email (optional)</label><input id="requesterEmail" name="requester_email" type="email" class="form-control" maxlength="254" placeholder="name@example.com"></div><div class="col-12 col-md-6"><label class="form-label" for="requesterPhone"><i class="fas fa-phone" aria-hidden="true"></i> Phone (optional)</label><input id="requesterPhone" name="requester_phone" type="tel" inputmode="tel" class="form-control" maxlength="13" pattern="\([0-9]{3}\)[0-9]{3}-[0-9]{4}" title="Enter the phone number as (000)000-0000" placeholder="(000)000-0000" aria-describedby="requesterPhoneHelp" is="dmx-phone-mask" mask="(999)999-9999"><small id="requesterPhoneHelp" class="form-text">Use the format (000)000-0000.</small></div></div></section>
        <section class="ticket-create-card ticket-problem-card" aria-labelledby="problemTitle"><div class="ticket-create-section-heading"><span class="ticket-create-step">3</span><div><h2 id="problemTitle">Problem</h2><p>Tell us what’s happening with the device.</p></div></div><div class="ticket-problem-fields"><label class="form-label" for="ticketSubject"><i class="fas fa-file-alt" aria-hidden="true"></i> Subject</label><input id="ticketSubject" name="subject" class="form-control" maxlength="220" placeholder="Brief summary of the issue" required><label class="form-label" for="ticketDescription"><i class="fas fa-align-left" aria-hidden="true"></i> Description</label><textarea id="ticketDescription" name="description" class="form-control" rows="3" maxlength="20000" placeholder="Provide detailed information about the issue, any error messages, and steps to reproduce (if applicable)..." required></textarea></div></section>
        <div class="ticket-create-actions"><a class="btn btn-bmobile-secondary" href="/tickets">Cancel</a><button class="btn btn-bmobile-primary" type="button" dmx-bind:disabled="!selectedDevice.value || ticketCreateForm.state.executing" dmx-on:click="ticketConfirmModal.show()">Review Ticket <i class="fas fa-arrow-right ms-1" aria-hidden="true"></i></button></div>
        <div id="ticketConfirmModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="ticketConfirmTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="ticketConfirmTitle">Confirm Ticket</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><dl class="row"><dt class="col-sm-4">Device</dt><dd class="col-sm-8" dmx-text="selectedSerial.value"></dd><dt class="col-sm-4">School</dt><dd class="col-sm-8" dmx-text="schoolOptions.data.schools.where('id', '==', schoolSelect.value).first().name"></dd><dt class="col-sm-4">Requester</dt><dd class="col-sm-8" dmx-text="requesterType.value + ' — ' + requesterName.value"></dd><dt class="col-sm-4">Subject</dt><dd class="col-sm-8" dmx-text="ticketSubject.value"></dd></dl><p class="small text-muted mb-0">The ticket will be created with status Submitted. This does not change device custody or lifecycle.</p></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Review Details</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="ticketCreateForm.state.executing">Submit Ticket</button></div></div></div></div>
      </form>
      <div id="ticketCreatedModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="ticketCreatedTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="ticketCreatedTitle">Ticket Created</h2></div><div class="modal-body"><p class="mb-1">Ticket reference</p><strong class="h4" dmx-text="ticketCreateForm.data.ticket_number"></strong><p class="text-muted mt-3 mb-0">The ticket was submitted successfully.</p></div><div class="modal-footer"><a class="btn btn-bmobile-primary" dmx-bind:href="'/tickets/detail?id=' + ticketCreateForm.data.ticket_id">View Ticket</a></div></div></div></div>
    </main>
  </div>
</div>
