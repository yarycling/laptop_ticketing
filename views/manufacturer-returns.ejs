<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="manufacturerReturnsPage" appConnect="local" -->
<meta name="ac:route" content="/manufacturer-returns">
<div class="portal-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context"></dmx-serverconnect>
  <dmx-serverconnect id="returnList" url="/api/manufacturer-returns/list" dmx-param:status="statusFilter.value" dmx-param:manufacturer_id="manufacturerFilter.value" dmx-param:carrier_id="carrierFilter.value" dmx-param:outcome_code="outcomeFilter.value" dmx-param:district_id="districtFilter.value" dmx-param:repair_centre_id="repairCentreFilter.value" dmx-param:search="ticketSearch.value"></dmx-serverconnect>
  <dmx-serverconnect id="returnSummary" url="/api/manufacturer-returns/summary"></dmx-serverconnect>
  <dmx-serverconnect id="filterOptions" url="/api/manufacturer-returns/filter-options"></dmx-serverconnect>
  <dmx-serverconnect id="carrierOptions" url="/api/manufacturer-returns/carrier-options"></dmx-serverconnect>
  <dmx-serverconnect id="outcomeOptions" url="/api/manufacturer-returns/outcome-options"></dmx-serverconnect>
  <dmx-value id="returnChartsVisible" value="true"></dmx-value>
  <%- await include("partials/portal-sidebar", { currentPage: "manufacturer-returns" }) %>
  <div class="portal-workspace"><%- await include("partials/portal-topbar", { pageTitle: "Manufacturer Returns" }) %>
    <main class="portal-main service-page manufacturer-returns-dashboard-page">
      <section class="manufacturer-returns-hero" aria-labelledby="manufacturerReturnsTitle"><div class="manufacturer-returns-heading"><span class="manufacturer-returns-hero-icon"><i class="fas fa-industry" aria-hidden="true"></i></span><div><div class="manufacturer-returns-eyebrow">REPAIRS &amp; LOGISTICS</div><h1 id="manufacturerReturnsTitle">Manufacturer Returns</h1><p>Manufacturer RMA, outbound and return custody tracking.</p></div></div></section>
      <div class="alert alert-danger manufacturer-return-alert" role="alert" dmx-show="returnList.lastError.status || returnSummary.lastError.status" dmx-text="returnList.lastError.response && returnList.lastError.response.error ? returnList.lastError.response.error : 'Manufacturer returns could not be loaded.'"></div>

      <section class="manufacturer-return-metrics" aria-label="Manufacturer return summary">
        <article class="manufacturer-return-metric"><span class="manufacturer-return-metric-icon"><i class="fas fa-file-alt" aria-hidden="true"></i></span><div class="manufacturer-return-metric-copy"><strong dmx-text="returnList.data.cases.count()">0</strong><span>Total Returns</span><small>All manufacturer returns</small></div><div class="manufacturer-return-metric-bar" dmx-show="returnChartsVisible.value"><span class="return-bar-total" dmx-bind:style="returnList.data.cases.count() ? 'width:100%' : 'width:0%'"></span></div></article>
        <article class="manufacturer-return-metric"><span class="manufacturer-return-metric-icon"><i class="fas fa-truck" aria-hidden="true"></i></span><div class="manufacturer-return-metric-copy"><strong dmx-text="returnList.data.cases.where('manufacturer_return_status_code', '==', 'OUTBOUND_IN_TRANSIT').count()">0</strong><span>Outbound</span><small>Sent to manufacturer</small></div><div class="manufacturer-return-metric-bar" dmx-show="returnChartsVisible.value"><span class="return-bar-outbound" dmx-bind:style="'width:' + (returnList.data.cases.count() ? (returnList.data.cases.where('manufacturer_return_status_code', '==', 'OUTBOUND_IN_TRANSIT').count()) / returnList.data.cases.count() * 100 : 0) + '%' "></span></div></article>
        <article class="manufacturer-return-metric"><span class="manufacturer-return-metric-icon"><i class="fas fa-file-alt" aria-hidden="true"></i></span><div class="manufacturer-return-metric-copy"><strong dmx-text="returnList.data.cases.where('manufacturer_return_status_code', '==', 'AWAITING_RETURN_CARRIER_PICKUP').count() + returnList.data.cases.where('manufacturer_return_status_code', '==', 'RETURN_IN_TRANSIT').count()">0</strong><span>Returned</span><small>Received from manufacturer</small></div><div class="manufacturer-return-metric-bar" dmx-show="returnChartsVisible.value"><span class="return-bar-returned" dmx-bind:style="'width:' + (returnList.data.cases.count() ? (returnList.data.cases.where('manufacturer_return_status_code', '==', 'AWAITING_RETURN_CARRIER_PICKUP').count() + returnList.data.cases.where('manufacturer_return_status_code', '==', 'RETURN_IN_TRANSIT').count()) / returnList.data.cases.count() * 100 : 0) + '%' "></span></div></article>
        <article class="manufacturer-return-metric"><span class="manufacturer-return-metric-icon"><i class="fas fa-check-circle" aria-hidden="true"></i></span><div class="manufacturer-return-metric-copy"><strong dmx-text="returnList.data.cases.where('manufacturer_return_status_code', '==', 'COMPLETED').count()">0</strong><span>Closed</span><small>Completed returns</small></div><div class="manufacturer-return-metric-bar" dmx-show="returnChartsVisible.value"><span class="return-bar-closed" dmx-bind:style="'width:' + (returnList.data.cases.count() ? returnList.data.cases.where('manufacturer_return_status_code', '==', 'COMPLETED').count() / returnList.data.cases.count() * 100 : 0) + '%' "></span></div></article>
      </section>

      <section class="manufacturer-return-filter-card" aria-labelledby="manufacturerReturnFiltersTitle">
        <div class="manufacturer-return-filter-head"><div class="manufacturer-return-filter-title"><span><i class="fas fa-filter" aria-hidden="true"></i></span><h2 id="manufacturerReturnFiltersTitle">Search &amp; Filter Returns</h2></div><div class="manufacturer-return-filter-actions"><label class="manufacturer-return-toggle"><input type="checkbox" role="switch" id="returnChartsVisibleSwitch" dmx-bind:checked="returnChartsVisible.value" dmx-on:change="returnChartsVisible.setValue(returnChartsVisibleSwitch.checked)"><span>Show charts</span></label><label class="manufacturer-return-toggle"><input type="checkbox" role="switch" id="outboundOnlySwitch" dmx-bind:checked="statusFilter.value == 'OUTBOUND_IN_TRANSIT'" dmx-on:change="statusFilter.setValue(outboundOnlySwitch.checked ? 'OUTBOUND_IN_TRANSIT' : 'ALL');returnList.load({status:outboundOnlySwitch.checked ? 'OUTBOUND_IN_TRANSIT' : 'ALL',manufacturer_id:manufacturerFilter.value,carrier_id:carrierFilter.value,outcome_code:outcomeFilter.value,district_id:districtFilter.value,repair_centre_id:repairCentreFilter.value,search:ticketSearch.value}, true)"><span>Outbound only</span></label><button type="button" class="manufacturer-return-clear" dmx-on:click="ticketSearch.setValue('');statusFilter.setValue('ALL');manufacturerFilter.setValue('');carrierFilter.setValue('');outcomeFilter.setValue('');districtFilter.setValue('');repairCentreFilter.setValue('');returnList.load({status:'ALL',manufacturer_id:'',carrier_id:'',outcome_code:'',district_id:'',repair_centre_id:'',search:''}, true)"><i class="fas fa-sync-alt" aria-hidden="true"></i> Clear filters</button></div></div>
        <div class="manufacturer-return-filter-grid">
          <div><label for="ticketSearch">Return or Ticket Number</label><div class="manufacturer-return-input"><i class="fas fa-search" aria-hidden="true"></i><input id="ticketSearch" class="form-control" type="search" placeholder="Search return or ticket number" dmx-on:input="returnList.load({status:statusFilter.value,manufacturer_id:manufacturerFilter.value,carrier_id:carrierFilter.value,outcome_code:outcomeFilter.value,district_id:districtFilter.value,repair_centre_id:repairCentreFilter.value,search:ticketSearch.value}, true)"></div></div>
          <div><label for="statusFilter">Status</label><select id="statusFilter" class="form-select" dmx-on:change="returnList.load({status:statusFilter.value,manufacturer_id:manufacturerFilter.value,carrier_id:carrierFilter.value,outcome_code:outcomeFilter.value,district_id:districtFilter.value,repair_centre_id:repairCentreFilter.value,search:ticketSearch.value}, true)"><option value="ALL">All statuses</option><option value="PREPARATION_REQUIRED">Preparation Required</option><option value="AWAITING_OUTBOUND_CARRIER_PICKUP">Awaiting Outbound Pickup</option><option value="OUTBOUND_IN_TRANSIT">Outbound In Transit</option><option value="AT_MANUFACTURER">At Manufacturer</option><option value="AWAITING_RETURN_CARRIER_PICKUP">Awaiting Return Pickup</option><option value="RETURN_IN_TRANSIT">Return In Transit</option><option value="COMPLETED">Completed</option></select></div>
          <div><label for="manufacturerFilter">Manufacturer</label><select id="manufacturerFilter" class="form-select" dmx-on:change="returnList.load({status:statusFilter.value,manufacturer_id:manufacturerFilter.value,carrier_id:carrierFilter.value,outcome_code:outcomeFilter.value,district_id:districtFilter.value,repair_centre_id:repairCentreFilter.value,search:ticketSearch.value}, true)"><option value="">All manufacturers</option><option dmx-repeat="filterOptions.data.manufacturers" dmx-bind:value="id" dmx-text="name"></option></select></div>
          <div><label for="carrierFilter">Carrier</label><select id="carrierFilter" class="form-select" dmx-on:change="returnList.load({status:statusFilter.value,manufacturer_id:manufacturerFilter.value,carrier_id:carrierFilter.value,outcome_code:outcomeFilter.value,district_id:districtFilter.value,repair_centre_id:repairCentreFilter.value,search:ticketSearch.value}, true)"><option value="">All carriers</option><option dmx-repeat="carrierOptions.data.carriers" dmx-bind:value="id" dmx-text="name"></option></select></div>
          <div><label for="outcomeFilter">Outcome</label><select id="outcomeFilter" class="form-select" dmx-on:change="returnList.load({status:statusFilter.value,manufacturer_id:manufacturerFilter.value,carrier_id:carrierFilter.value,outcome_code:outcomeFilter.value,district_id:districtFilter.value,repair_centre_id:repairCentreFilter.value,search:ticketSearch.value}, true)"><option value="">All outcomes</option><option dmx-repeat="outcomeOptions.data.outcomes" dmx-bind:value="code" dmx-text="name"></option></select></div>
          <div><label for="districtFilter">District</label><select id="districtFilter" class="form-select" dmx-on:change="returnList.load({status:statusFilter.value,manufacturer_id:manufacturerFilter.value,carrier_id:carrierFilter.value,outcome_code:outcomeFilter.value,district_id:districtFilter.value,repair_centre_id:repairCentreFilter.value,search:ticketSearch.value}, true)"><option value="">All districts</option><option dmx-repeat="filterOptions.data.districts" dmx-bind:value="id" dmx-text="name"></option></select></div>
          <div><label for="repairCentreFilter">Repair Centre</label><select id="repairCentreFilter" class="form-select" dmx-on:change="returnList.load({status:statusFilter.value,manufacturer_id:manufacturerFilter.value,carrier_id:carrierFilter.value,outcome_code:outcomeFilter.value,district_id:districtFilter.value,repair_centre_id:repairCentreFilter.value,search:ticketSearch.value}, true)"><option value="">All repair centres</option><option dmx-repeat="filterOptions.data.repair_centres" dmx-bind:value="id" dmx-text="name"></option></select></div>
        </div>
      </section>

      <section class="manufacturer-return-table-card" aria-label="Manufacturer return cases"><div class="table-responsive manufacturer-return-table-scroll"><table class="table manufacturer-return-table align-middle"><thead><tr><th>Return # <i class="fas fa-sort" aria-hidden="true"></i></th><th>Ticket <i class="fas fa-sort" aria-hidden="true"></i></th><th>Device <i class="fas fa-sort" aria-hidden="true"></i></th><th>Manufacturer <i class="fas fa-sort" aria-hidden="true"></i></th><th>Repair Centre <i class="fas fa-sort" aria-hidden="true"></i></th><th>District <i class="fas fa-sort" aria-hidden="true"></i></th><th>Status <i class="fas fa-sort" aria-hidden="true"></i></th><th>Outbound <i class="fas fa-sort" aria-hidden="true"></i></th><th>Return <i class="fas fa-sort" aria-hidden="true"></i></th><th>Outcome <i class="fas fa-sort" aria-hidden="true"></i></th><th>Updated <i class="fas fa-sort" aria-hidden="true"></i></th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="returnList.data.cases"><tr><td><a class="manufacturer-return-number" dmx-bind:href="'/manufacturer-returns/detail?id=' + manufacturer_return_case_id" dmx-text="manufacturer_return_number"></a></td><td dmx-text="ticket_number"></td><td><span dmx-text="serial_number"></span><small class="d-block text-muted" dmx-text="asset_tag || '-' "></small></td><td dmx-text="manufacturer_name"></td><td dmx-text="repair_centre_name"></td><td dmx-text="origin_district_name"></td><td><span class="manufacturer-return-status" dmx-text="manufacturer_return_status_name"></span></td><td dmx-text="outbound_carrier_name || '-' "></td><td dmx-text="return_carrier_name || '-' "></td><td dmx-text="current_outcome_name || '-' "></td><td class="text-nowrap" dmx-text="updated_at.formatDate('MMM d, yyyy, h:mm A')"></td></tr></tbody></table></div>
        <div class="manufacturer-return-empty" dmx-show="!returnList.state.executing && returnList.data.cases.count() == 0"><span><i class="fas fa-box-open" aria-hidden="true"></i></span><strong>No manufacturer returns match these filters</strong><p>Try adjusting your search or filter criteria.</p><button type="button" class="manufacturer-return-empty-clear" dmx-on:click="ticketSearch.setValue('');statusFilter.setValue('ALL');manufacturerFilter.setValue('');carrierFilter.setValue('');outcomeFilter.setValue('');districtFilter.setValue('');repairCentreFilter.setValue('');returnList.load({status:'ALL',manufacturer_id:'',carrier_id:'',outcome_code:'',district_id:'',repair_centre_id:'',search:''}, true)"><i class="fas fa-search" aria-hidden="true"></i> Clear filters</button></div>
      </section>
    </main>
  </div>
</div>
