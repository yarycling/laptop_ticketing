<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="slaTracking" appConnect="local" components="{dmxBootstrap5Modal:{}}" -->
<meta name="ac:route" content="/sla">
<div class="portal-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context"></dmx-serverconnect>
  <dmx-serverconnect id="slaList" url="/api/sla/list" dmx-param:state="stateFilter.value" dmx-param:policy="policyFilter.value" dmx-param:district_id="districtFilter.value" dmx-param:school_id="schoolFilter.value" dmx-param:ticket_number="ticketFilter.value" dmx-param:page="slaPage.value" dmx-param:page_size="25"></dmx-serverconnect>
  <dmx-serverconnect id="slaFilterOptions" url="/api/sla/filter-options"></dmx-serverconnect>
  <dmx-serverconnect id="slaDetail" url="/api/sla/detail" noload="true"></dmx-serverconnect>
  <dmx-value id="slaPage" value="1"></dmx-value>
  <dmx-value id="districtFilterId" value=""></dmx-value>
  <dmx-value id="schoolFilterId" value=""></dmx-value>
  <dmx-value id="slaPageNotice" value=""></dmx-value>
  <dmx-value id="slaChartsVisible" value="true"></dmx-value>
  <%- await include("partials/portal-sidebar", { currentPage: "sla-tracking" }) %>
  <div class="portal-workspace"><%- await include("partials/portal-topbar", { pageTitle: "SLA Tracking" }) %>
    <main class="portal-main" aria-label="SLA tracking">
      <section class="portal-section monitoring-page">
        <div class="mb-3 monitoring-heading"><span class="monitoring-heading-icon"><i class="fas fa-stopwatch" aria-hidden="true"></i></span><div><div class="monitoring-eyebrow">MONITORING &amp; REPORTS</div><h1 class="h3 mb-1">SLA Tracking</h1><p class="text-muted mb-0">Operational service clocks for pickup, diagnosis, repair, and return logistics.</p></div></div>
        <div class="logistics-stats mb-3"><article class="logistics-stat-card"><div class="logistics-stat-icon"><i class="fas fa-clipboard-list" aria-hidden="true"></i></div><div class="logistics-stat-copy"><span>Matching SLA records</span><strong dmx-text="slaList.data.total_count.record_count || 0"></strong><small>All matching records</small></div></article><article class="logistics-stat-card"><div class="logistics-stat-icon logistics-stat-icon-repair"><i class="fas fa-exclamation-triangle" aria-hidden="true"></i></div><div class="logistics-stat-copy"><span>Breached</span><strong dmx-text="slaList.data.breached_count.record_count || 0"></strong><small>All matching records</small></div></article><article class="logistics-stat-card"><div class="logistics-stat-icon logistics-stat-icon-box"><i class="fas fa-clock" aria-hidden="true"></i></div><div class="logistics-stat-copy"><span>At risk</span><strong dmx-text="slaList.data.at_risk_count.record_count || 0"></strong><small>All matching records</small></div></article></div>
        <section class="monitoring-filter-card mb-3" aria-label="SLA filters"><div class="row g-3 align-items-end">
          <div class="col-sm-6 col-lg-2"><label class="form-label" for="stateFilter">State</label><select id="stateFilter" class="form-select" dmx-on:change="slaPage.setValue(1);slaList.load({state:stateFilter.value,policy:policyFilter.value,district_id:districtFilter.value,school_id:schoolFilter.value,ticket_number:ticketFilter.value,page:1,page_size:25}, true)"><option value="ALL">All states</option><option value="PENDING">Pending</option><option value="ACTIVE">Active</option><option value="AT_RISK">At Risk</option><option value="BREACHED">Breached</option><option value="COMPLETED_WITHIN_SLA">Completed Within SLA</option><option value="COMPLETED_OUTSIDE_SLA">Completed Outside SLA</option><option value="CANCELLED">Cancelled</option></select></div>
          <div class="col-sm-6 col-lg-2"><label class="form-label" for="policyFilter">Policy</label><select id="policyFilter" class="form-select" dmx-on:change="slaPage.setValue(1);slaList.load({state:stateFilter.value,policy:policyFilter.value,district_id:districtFilter.value,school_id:schoolFilter.value,ticket_number:ticketFilter.value,page:1,page_size:25}, true)"><option value="ALL">All policies</option><option value="PICKUP">Pickup</option><option value="DIAGNOSIS">Diagnosis</option><option value="REPAIR">Repair</option><option value="RETURN_LOGISTICS">Return Logistics</option></select></div>
          <div class="col-sm-6 col-lg-2"><label class="form-label" for="districtFilter">District</label><select id="districtFilter" class="form-select" dmx-bind:value="districtFilterId.value" dmx-on:change="districtFilterId.setValue(districtFilter.value);schoolFilterId.setValue('');slaPage.setValue(1);slaList.load({state:stateFilter.value,policy:policyFilter.value,district_id:districtFilter.value,school_id:'',ticket_number:ticketFilter.value,page:1,page_size:25}, true)"><option value="">All districts</option><option dmx-repeat="slaFilterOptions.data.districts" dmx-bind:value="id" dmx-text="name"></option></select></div>
          <div class="col-sm-6 col-lg-2"><label class="form-label" for="schoolFilter">School</label><select id="schoolFilter" class="form-select" dmx-bind:value="schoolFilterId.value" dmx-on:change="schoolFilterId.setValue(schoolFilter.value);slaPage.setValue(1);slaList.load({state:stateFilter.value,policy:policyFilter.value,district_id:districtFilter.value,school_id:schoolFilter.value,ticket_number:ticketFilter.value,page:1,page_size:25}, true)"><option value="">All schools</option><option dmx-repeat="slaFilterOptions.data.schools.where('district_id', '==', districtFilterId.value)" dmx-bind:value="id" dmx-text="name"></option></select></div>
          <div class="col-sm-8 col-lg-3"><label class="form-label" for="ticketFilter">Ticket number</label><input id="ticketFilter" class="form-control" type="search" placeholder="Search ticket number" dmx-on:input="slaPage.setValue(1);slaList.load({state:stateFilter.value,policy:policyFilter.value,district_id:districtFilter.value,school_id:schoolFilter.value,ticket_number:ticketFilter.value,page:1,page_size:25}, true)"></div>
          <div class="col-sm-4 col-lg-1"><button type="button" class="btn btn-bmobile-secondary w-100" aria-label="Refresh SLA queue" dmx-on:click="slaList.load({state:stateFilter.value,policy:policyFilter.value,district_id:districtFilter.value,school_id:schoolFilter.value,ticket_number:ticketFilter.value,page:slaPage.value,page_size:25}, true)">Refresh</button></div>
          <div class="col-sm-6 col-lg-2"><div class="form-check form-switch monitoring-switch"><input class="form-check-input" type="checkbox" role="switch" id="slaChartsSwitch" dmx-bind:checked="slaChartsVisible.value" dmx-on:change="slaChartsVisible.setValue(slaChartsSwitch.checked)"><label class="form-check-label" for="slaChartsSwitch">Show status chart</label></div></div>
          <div class="col-12 d-flex justify-content-end"><button type="button" class="btn btn-bmobile-secondary btn-sm" dmx-on:click="stateFilter.setValue('ALL');policyFilter.setValue('ALL');districtFilter.setValue('');schoolFilter.setValue('');districtFilterId.setValue('');schoolFilterId.setValue('');ticketFilter.setValue('');slaPage.setValue(1);slaList.load({state:'ALL',policy:'ALL',district_id:'',school_id:'',ticket_number:'',page:1,page_size:25}, true)">Clear filters</button></div>
        </div></section>
        <div class="monitoring-card mb-3" dmx-show="slaChartsVisible.value"><div class="monitoring-card-heading"><div><h2 class="h6 mb-1">SLA status distribution</h2><p class="small text-muted mb-0">All authorized records matching policy, location, and ticket filters. Status filter does not limit this chart.</p></div></div><div class="monitoring-chart-grid">
          <div class="monitoring-chart-row"><span>Breached</span><progress class="monitoring-progress-danger" dmx-bind:max="slaList.data.total_count.record_count || 1" dmx-bind:value="slaList.data.breached_count.record_count || 0"></progress><strong dmx-text="slaList.data.breached_count.record_count || 0"></strong></div>
          <div class="monitoring-chart-row"><span>At risk</span><progress class="monitoring-progress-warning" dmx-bind:max="slaList.data.total_count.record_count || 1" dmx-bind:value="slaList.data.at_risk_count.record_count || 0"></progress><strong dmx-text="slaList.data.at_risk_count.record_count || 0"></strong></div>
          <div class="monitoring-chart-row"><span>Active / pending</span><progress dmx-bind:max="slaList.data.total_count.record_count || 1" dmx-bind:value="(slaList.data.active_count.record_count || 0) + (slaList.data.pending_count.record_count || 0)"></progress><strong dmx-text="(slaList.data.active_count.record_count || 0) + (slaList.data.pending_count.record_count || 0)"></strong></div>
        </div></div>
        <div class="text-muted py-3" role="status" dmx-show="slaList.state.executing">Loading SLA records...</div>
        <div class="alert alert-danger" role="alert" dmx-show="slaList.lastError.status" dmx-text="slaList.lastError.response && slaList.lastError.response.error ? slaList.lastError.response.error : 'SLA records could not be loaded.'"></div>
        <div class="table-responsive portal-table-wrapper"><table class="table portal-table align-middle"><thead><tr><th>Reference</th><th>Policy</th><th>State</th><th>Ticket</th><th>Workflow</th><th>District / School</th><th>Started</th><th>Due</th><th>Completed</th><th>Target</th><th>Indicator</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="slaList.data.instances"><tr><td><button type="button" class="btn btn-link p-0" dmx-on:click="slaDetail.load({id:sla_instance_id}, true);slaDetailModal.show()" dmx-text="'SLA-' + sla_instance_id"></button></td><td dmx-text="policy_name"></td><td><span class="badge" dmx-class:text-bg-danger="current_state_code == 'BREACHED' || current_state_code == 'COMPLETED_OUTSIDE_SLA'" dmx-class:text-bg-warning="current_state_code == 'AT_RISK'" dmx-class:text-bg-success="current_state_code == 'ACTIVE' || current_state_code == 'COMPLETED_WITHIN_SLA'" dmx-class:text-bg-secondary="current_state_code == 'PENDING' || current_state_code == 'CANCELLED'" dmx-text="current_state_name"></span></td><td><a dmx-bind:href="'/tickets/detail?id=' + ticket_id" dmx-text="ticket_number"></a></td><td dmx-text="source_workflow"></td><td><span dmx-text="origin_district_name || '-' "></span> / <span dmx-text="origin_school_name || '-' "></span></td><td class="text-nowrap" dmx-text="started_at_display"></td><td class="text-nowrap" dmx-text="due_at_display"></td><td class="text-nowrap" dmx-text="completed_at ? completed_at_display : '-' "></td><td><span dmx-text="target_business_days_snapshot"></span> business day(s)</td><td dmx-text="current_state_code == 'BREACHED' || current_state_code == 'COMPLETED_OUTSIDE_SLA' ? 'Overdue' : current_state_code == 'AT_RISK' ? 'Due today' : current_state_code.indexOf('COMPLETED') == 0 ? 'Closed' : current_state_code == 'CANCELLED' ? 'Not applicable' : 'Within target'"></td></tr></tbody></table></div>
        <div class="d-flex justify-content-between align-items-center mt-3"><p class="text-muted mb-0" dmx-show="slaList.data.instances.length == 0">No SLA records match these filters.</p><div class="d-flex align-items-center gap-2 ms-auto"><button type="button" class="btn btn-bmobile-secondary btn-sm" aria-label="Previous page" dmx-bind:disabled="slaPage.value <= 1" dmx-on:click="slaList.load({state:stateFilter.value,policy:policyFilter.value,district_id:districtFilter.value,school_id:schoolFilter.value,ticket_number:ticketFilter.value,page:slaPage.value - 1,page_size:25}, true);slaPage.setValue(slaPage.value - 1)">Previous</button><span class="small text-muted" dmx-text="'Page ' + slaPage.value"></span><button type="button" class="btn btn-bmobile-secondary btn-sm" aria-label="Next page" dmx-bind:disabled="slaList.data.instances.length < 25" dmx-on:click="slaList.load({state:stateFilter.value,policy:policyFilter.value,district_id:districtFilter.value,school_id:schoolFilter.value,ticket_number:ticketFilter.value,page:slaPage.value + 1,page_size:25}, true);slaPage.setValue(slaPage.value + 1)">Next</button></div></div>
      </section>
      <div id="slaDetailModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="slaDetailTitle" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="slaDetailTitle">SLA Record</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="text-muted" dmx-show="slaDetail.state.executing">Loading...</div><div class="alert alert-danger" role="alert" dmx-show="slaDetail.lastError.status" dmx-text="slaDetail.lastError.response && slaDetail.lastError.response.error ? slaDetail.lastError.response.error : 'SLA detail could not be loaded.'"></div><dl class="row mb-0" dmx-show="slaDetail.data.sla.sla_instance_id"><dt class="col-sm-4">Reference</dt><dd class="col-sm-8" dmx-text="'SLA-' + slaDetail.data.sla.sla_instance_id"></dd><dt class="col-sm-4">Policy / State</dt><dd class="col-sm-8"><span dmx-text="slaDetail.data.sla.policy_name"></span> / <span dmx-text="slaDetail.data.sla.current_state_name"></span></dd><dt class="col-sm-4">Ticket</dt><dd class="col-sm-8" dmx-text="slaDetail.data.sla.ticket_number"></dd><dt class="col-sm-4">Source</dt><dd class="col-sm-8" dmx-text="slaDetail.data.sla.source_workflow + ' / ' + slaDetail.data.sla.source_entity_type + ' ' + slaDetail.data.sla.source_entity_id"></dd><dt class="col-sm-4">Started</dt><dd class="col-sm-8" dmx-text="slaDetail.data.sla.started_at_display"></dd><dt class="col-sm-4">Due</dt><dd class="col-sm-8" dmx-text="slaDetail.data.sla.due_at_display"></dd><dt class="col-sm-4">At risk / Breached</dt><dd class="col-sm-8"><span dmx-text="slaDetail.data.sla.at_risk_at ? slaDetail.data.sla.at_risk_at_display : '-' "></span> / <span dmx-text="slaDetail.data.sla.breached_at ? slaDetail.data.sla.breached_at_display : '-' "></span></dd><dt class="col-sm-4">Completed / Cancelled</dt><dd class="col-sm-8"><span dmx-text="slaDetail.data.sla.completed_at ? slaDetail.data.sla.completed_at_display : '-' "></span> / <span dmx-text="slaDetail.data.sla.cancelled_at ? slaDetail.data.sla.cancelled_at_display : '-' "></span></dd><dt class="col-sm-4">Target</dt><dd class="col-sm-8"><span dmx-text="slaDetail.data.sla.target_business_days_snapshot"></span> business day(s)</dd><dt class="col-sm-4">Completion event</dt><dd class="col-sm-8" dmx-text="slaDetail.data.sla.completion_event || '-' "></dd></dl></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Close</button></div></div></div></div>
    </main>
  </div>
</div>
