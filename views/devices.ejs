<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="devicesPage" appConnect="local" -->
<meta name="ac:route" content="/devices">
<div class="portal-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context"></dmx-serverconnect>
  <dmx-serverconnect id="scopeContext" url="/api/auth/scope_context"></dmx-serverconnect>
  <dmx-serverconnect id="deviceOptions" url="/api/devices/form-options"></dmx-serverconnect>
  <dmx-value id="devicePage" value="1"></dmx-value><dmx-value id="devicePageSize" value="25"></dmx-value><dmx-value id="newDeviceManufacturer"></dmx-value><dmx-value id="selectedDeviceId"></dmx-value><dmx-value id="selectedLifecycleCode"></dmx-value><dmx-value id="deviceNotice"></dmx-value>
  <dmx-serverconnect id="deviceList" url="/api/devices/list" dmx-param:search="deviceSearch.value" dmx-param:manufacturer_id="manufacturerFilter.value" dmx-param:device_model_id="modelFilter.value" dmx-param:lifecycle_status_id="lifecycleFilter.value" dmx-param:condition_id="conditionFilter.value" dmx-param:warranty_status="warrantyFilter.value" dmx-param:page="devicePage.value" dmx-param:page_size="devicePageSize.value" dmx-on:success="deviceSummary.load()"></dmx-serverconnect>
  <dmx-serverconnect id="deviceSummary" url="/api/devices/summary"></dmx-serverconnect>
  <dmx-serverconnect id="deviceDetail" url="/api/devices/detail" dmx-on:success="editDeviceModal.show()"></dmx-serverconnect>
  <%- await include("partials/portal-sidebar", { currentPage: "devices" }) %>
  
  <div class="portal-workspace"><%- await include("partials/portal-topbar") %>
    <main class="portal-main devices-page" aria-label="Device inventory">
      <section class="devices-hero" aria-labelledby="devicesPageTitle"><div class="devices-hero-copy"><div class="devices-eyebrow">DEVICES &amp; STUDENTS</div><h1 id="devicesPageTitle">Devices</h1><p class="devices-hero-lead">Central device asset register for your organisation.</p><p>Track, manage and monitor all laptop devices, their warranty status<br class="d-none d-lg-block"> and lifecycle across schools and students.</p></div></section>
      <div class="alert alert-success devices-notice" role="status" dmx-show="deviceNotice.value" dmx-text="deviceNotice.value"></div>
      <div class="alert alert-danger devices-error" role="alert" dmx-show="deviceList.lastError.status" dmx-text="deviceList.lastError.response && deviceList.lastError.response.error ? deviceList.lastError.response.error : 'Devices could not be loaded.'"></div>
      <div class="alert alert-danger devices-error" role="alert" dmx-show="deviceOptions.lastError.status">Device form options could not be loaded.</div>
      <section class="devices-summary" aria-label="Device summary">
        <article class="devices-metric"><span class="devices-metric-icon green"><i class="fas fa-laptop" aria-hidden="true"></i></span><div><span>Total visible devices</span><strong dmx-text="deviceSummary.data.summary.total || 0">0</strong></div></article>
        <article class="devices-metric"><span class="devices-metric-icon blue"><i class="fas fa-download" aria-hidden="true"></i></span><div><span>Received</span><strong dmx-text="deviceSummary.data.summary.received || 0">0</strong></div></article>
        <article class="devices-metric"><span class="devices-metric-icon green"><i class="fas fa-cube" aria-hidden="true"></i></span><div><span>Available</span><strong dmx-text="deviceSummary.data.summary.available || 0">0</strong></div></article>
        <article class="devices-metric"><span class="devices-metric-icon amber"><i class="fas fa-exclamation-triangle" aria-hidden="true"></i></span><div><span>Warranty expired</span><strong dmx-text="deviceSummary.data.summary.warranty_expired || 0">0</strong></div></article>
      </section>
      <section class="devices-filter-card" aria-label="Search and filter devices">
        <div class="devices-filter-actions"><button class="btn btn-bmobile-secondary" type="button" dmx-on:click="deviceSearch.setValue('');manufacturerFilter.setValue('');modelFilter.setValue('');lifecycleFilter.setValue('');conditionFilter.setValue('');warrantyFilter.setValue('all');devicePage.setValue(1);deviceList.load()"><i class="fas fa-undo me-1" aria-hidden="true"></i>Clear filters</button><a class="btn btn-bmobile-secondary devices-import-action" href="/admin/device-imports" dmx-show="authContext.data.can_device_imports_view && (authContext.data.is_super_admin || scopeContext.data.has_national_scope)"><i class="fas fa-file-import me-1" aria-hidden="true"></i>Device Imports</a><button class="btn btn-bmobile-primary" type="button" dmx-show="authContext.data.can_devices_manage && (authContext.data.is_super_admin || scopeContext.data.has_national_scope)" dmx-on:click="createDeviceForm.reset(true);newDeviceManufacturer.setValue('');createDeviceModal.show()"><i class="fas fa-plus me-1" aria-hidden="true"></i>Add Device</button></div>
        <div class="devices-search-wrap"><i class="fas fa-search" aria-hidden="true"></i><label class="visually-hidden" for="deviceSearch">Search devices</label><input id="deviceSearch" class="form-control" type="search" placeholder="Search serial number, asset tag or reference" dmx-on:input="devicePage.setValue(1);deviceList.load()"></div>
        <div class="devices-filter-grid"><div><label class="visually-hidden" for="manufacturerFilter">Manufacturer</label><select id="manufacturerFilter" class="form-select" dmx-on:change="devicePage.setValue(1);deviceList.load()"><option value="">All manufacturers</option><option dmx-repeat="deviceOptions.data.manufacturers" dmx-bind:value="id" dmx-text="name"></option></select></div><div><label class="visually-hidden" for="modelFilter">Model</label><select id="modelFilter" class="form-select" dmx-on:change="devicePage.setValue(1);deviceList.load()"><option value="">All models</option><option dmx-repeat="deviceOptions.data.models" dmx-bind:value="id" dmx-text="model_name"></option></select></div><div><label class="visually-hidden" for="lifecycleFilter">Lifecycle</label><select id="lifecycleFilter" class="form-select" dmx-on:change="devicePage.setValue(1);deviceList.load()"><option value="">All lifecycle states</option><option dmx-repeat="deviceOptions.data.lifecycle" dmx-bind:value="id" dmx-text="name"></option></select></div><div><label class="visually-hidden" for="conditionFilter">Condition</label><select id="conditionFilter" class="form-select" dmx-on:change="devicePage.setValue(1);deviceList.load()"><option value="">All conditions</option><option dmx-repeat="deviceOptions.data.conditions" dmx-bind:value="id" dmx-text="name"></option></select></div><div><label class="visually-hidden" for="warrantyFilter">Warranty</label><select id="warrantyFilter" class="form-select" dmx-on:change="devicePage.setValue(1);deviceList.load()"><option value="all">All warranty states</option><option value="active">Warranty active</option><option value="expired">Warranty expired</option><option value="not_recorded">Not recorded</option></select></div></div>
      </section>
      <section class="devices-list-card" aria-labelledby="devicesListTitle">
        <div class="devices-list-heading"><div><h2 id="devicesListTitle">Devices (<span dmx-text="deviceList.data.total || 0">0</span>)</h2><p dmx-text="deviceList.data.total == 0 ? 'No devices are currently available within your assigned scope.' : 'Browse the devices available within your assigned scope.'">Browse the devices available within your assigned scope.</p></div><div class="text-muted devices-loading" role="status" dmx-show="deviceList.state.executing"><i class="fas fa-spinner fa-spin" aria-hidden="true"></i> Loading devices...</div></div>
        <div class="table-responsive portal-table-wrapper"><table class="table portal-table align-middle devices-table"><thead><tr><th>Serial Number</th><th>Asset Tag</th><th>Manufacturer / Model</th><th>Lifecycle</th><th>Condition</th><th>Warranty End</th><th>Received</th><th>Actions</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="deviceList.data.devices"><tr><td class="fw-semibold" dmx-text="serial_number"></td><td dmx-text="asset_tag || '-'">-</td><td><span dmx-text="manufacturer_name"></span><br><small class="text-muted" dmx-text="model_name"></small></td><td><span class="badge text-bg-light" dmx-text="lifecycle_name"></span></td><td dmx-text="condition_name"></td><td dmx-text="warranty_end_date_display"></td><td dmx-text="received_date_display"></td><td><div class="d-flex flex-wrap gap-1"><a class="btn btn-bmobile-secondary btn-sm" dmx-bind:href="'/devices/detail?id=' + id">View</a><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-show="authContext.data.can_devices_manage && (authContext.data.is_super_admin || scopeContext.data.has_national_scope)" dmx-on:click="selectedDeviceId.setValue(id);editDeviceForm.reset(true);deviceDetail.load({id:id}, true)">Edit</button><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-show="authContext.data.can_devices_manage && (authContext.data.is_super_admin || scopeContext.data.has_national_scope) && current_custody_level == 'CENTRAL' && (lifecycle_code == 'RECEIVED' || lifecycle_code == 'AVAILABLE')" dmx-on:click="selectedDeviceId.setValue(id);selectedLifecycleCode.setValue(lifecycle_code == 'RECEIVED' ? 'AVAILABLE' : 'RECEIVED');lifecycleModal.show()" dmx-text="lifecycle_code == 'RECEIVED' ? 'Mark Available' : 'Return to Received'"></button></div></td></tr></tbody></table></div>
        <div class="devices-empty-state" dmx-show="!deviceList.state.executing && deviceList.data.devices.count() == 0"><span><i class="fas fa-laptop" aria-hidden="true"></i></span><strong>No devices found</strong><p>No devices are currently available within your assigned scope.</p><small>Try adjusting your search or filter criteria.</small></div>
        <div class="devices-pagination"><span class="text-muted" dmx-text="'Page ' + (deviceList.data.page || 1) + ' of ' + (deviceList.data.total_pages || 0) + ' · ' + (deviceList.data.total || 0) + ' devices'"></span><div class="btn-group" role="group" aria-label="Device pages"><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-bind:disabled="devicePage.value <= 1" dmx-on:click="devicePage.setValue(devicePage.value - 1);deviceList.load()" aria-label="Previous page"><i class="fas fa-chevron-left" aria-hidden="true"></i></button><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-bind:disabled="devicePage.value >= deviceList.data.total_pages" dmx-on:click="devicePage.setValue(devicePage.value + 1);deviceList.load()" aria-label="Next page"><i class="fas fa-chevron-right" aria-hidden="true"></i></button></div></div>
      </section>
    </main>
  </div>
</div>
<div id="createDeviceModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="createDeviceTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="createDeviceTitle">Add Device</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="createDeviceForm" is="dmx-serverconnect-form" method="post" action="/api/devices/create" dmx-on:success="createDeviceModal.hide();deviceList.load();deviceNotice.setValue('Device created successfully.');createDeviceForm.reset(true);newDeviceManufacturer.setValue('')"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="createDeviceForm.lastError.status" dmx-text="createDeviceForm.lastError.response && createDeviceForm.lastError.response.error ? createDeviceForm.lastError.response.error : 'Device could not be created.'"></div><div class="row g-3"><div class="col-md-6"><label class="form-label" for="createSerial">Serial Number</label><input id="createSerial" class="form-control" name="serial_number" maxlength="150" required></div><div class="col-md-6"><label class="form-label" for="createAssetTag">Asset Tag</label><input id="createAssetTag" class="form-control" name="asset_tag" maxlength="120"></div><div class="col-md-6"><label class="form-label" for="createDeviceModel">Model</label><select id="createDeviceModel" class="form-select" name="device_model_id" required><option value="">Select model</option><option dmx-repeat="deviceOptions.data.models" dmx-bind:value="id" dmx-text="manufacturer_name + ' · ' + model_name"></option></select><small class="form-text">The model’s image is automatically used for this device.</small></div><div class="col-md-6"><label class="form-label" for="createCondition">Condition</label><select id="createCondition" class="form-select" name="condition_id" required><option value="">Select condition</option><option dmx-repeat="deviceOptions.data.conditions" dmx-bind:value="id" dmx-text="name"></option></select></div><div class="col-md-6"><label class="form-label" for="createReceivedDate">Received Date</label><input id="createReceivedDate" class="form-control" type="date" name="received_date"></div><div class="col-md-6"><label class="form-label" for="createWarrantyStart">Warranty Start</label><input id="createWarrantyStart" class="form-control" type="date" name="warranty_start_date"></div><div class="col-md-6"><label class="form-label" for="createWarrantyEnd">Warranty End</label><input id="createWarrantyEnd" class="form-control" type="date" name="warranty_end_date"></div><div class="col-md-6"><label class="form-label" for="createProcurement">Procurement Reference</label><input id="createProcurement" class="form-control" name="procurement_reference" maxlength="180"></div><div class="col-md-6"><label class="form-label" for="createSupplier">Supplier</label><input id="createSupplier" class="form-control" name="supplier_name" maxlength="180"></div><div class="col-12"><label class="form-label" for="createWarrantyRef">Warranty Reference</label><input id="createWarrantyRef" class="form-control" name="warranty_reference" maxlength="180"></div><div class="col-12"><label class="form-label" for="createDeviceNotes">Notes</label><textarea id="createDeviceNotes" class="form-control" name="notes" rows="3"></textarea></div></div><p class="small text-muted mt-3 mb-0">Initial lifecycle: Received</p></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="createDeviceForm.state.executing">Save Device</button></div></form></div></div></div>
<div id="editDeviceModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="editDeviceTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="editDeviceTitle">Edit Device</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="editDeviceForm" class="device-edit-form" is="dmx-serverconnect-form" method="post" action="/api/devices/update" dmx-on:success="editDeviceModal.hide();deviceList.load();deviceNotice.setValue('Device updated successfully.');editDeviceForm.reset(true)"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="editDeviceForm.lastError.status" dmx-text="editDeviceForm.lastError.response && editDeviceForm.lastError.response.error ? editDeviceForm.lastError.response.error : 'Device could not be updated.'"></div><div class="text-muted mb-2" dmx-show="deviceDetail.state.executing">Loading device...</div><input type="hidden" name="id" dmx-bind:value="selectedDeviceId.value"><div class="row g-3"><div class="col-md-6"><label class="form-label" for="editSerial">Serial Number</label><input id="editSerial" class="form-control" name="serial_number" maxlength="150" required dmx-bind:value="deviceDetail.data.device.serial_number"></div><div class="col-md-6"><label class="form-label" for="editAssetTag">Asset Tag</label><input id="editAssetTag" class="form-control" name="asset_tag" maxlength="120" dmx-bind:value="deviceDetail.data.device.asset_tag"></div><div class="col-md-6"><label class="form-label" for="editDeviceModel">Model</label><select id="editDeviceModel" class="form-select" name="device_model_id" required dmx-bind:value="deviceDetail.data.device.device_model_id"><option dmx-show="deviceDetail.data.device.device_model_id" dmx-bind:value="deviceDetail.data.device.device_model_id" dmx-text="deviceDetail.data.device.manufacturer_name + ' · ' + deviceDetail.data.device.model_name"></option><option dmx-repeat="deviceOptions.data.models" dmx-bind:value="id" dmx-text="manufacturer_id == deviceDetail.data.device.manufacturer_id ? model_name : manufacturer_name + ' · ' + model_name"></option></select><small class="form-text">The current historical model can remain selected. Its image is shared by all devices of the model.</small></div><div class="col-md-6"><label class="form-label" for="editCondition">Condition</label><select id="editCondition" class="form-select" name="condition_id" required dmx-bind:value="deviceDetail.data.device.condition_id"><option dmx-bind:value="deviceDetail.data.device.condition_id" dmx-text="deviceDetail.data.device.condition_name"></option><option dmx-repeat="deviceOptions.data.conditions" dmx-bind:value="id" dmx-text="name"></option></select></div><div class="col-md-6"><label class="form-label" for="editReceivedDate">Received Date</label><input id="editReceivedDate" class="form-control" type="date" name="received_date" dmx-bind:value="deviceDetail.data.date_inputs.received_date"></div><div class="col-md-6"><label class="form-label" for="editWarrantyStart">Warranty Start</label><input id="editWarrantyStart" class="form-control" type="date" name="warranty_start_date" dmx-bind:value="deviceDetail.data.date_inputs.warranty_start_date"></div><div class="col-md-6"><label class="form-label" for="editWarrantyEnd">Warranty End</label><input id="editWarrantyEnd" class="form-control" type="date" name="warranty_end_date" dmx-bind:value="deviceDetail.data.date_inputs.warranty_end_date"></div><div class="col-md-6"><label class="form-label" for="editProcurement">Procurement Reference</label><input id="editProcurement" class="form-control" name="procurement_reference" maxlength="180" dmx-bind:value="deviceDetail.data.device.procurement_reference"></div><div class="col-md-6"><label class="form-label" for="editSupplier">Supplier</label><input id="editSupplier" class="form-control" name="supplier_name" maxlength="180" dmx-bind:value="deviceDetail.data.device.supplier_name"></div><div class="col-12"><label class="form-label" for="editWarrantyRef">Warranty Reference</label><input id="editWarrantyRef" class="form-control" name="warranty_reference" maxlength="180" dmx-bind:value="deviceDetail.data.device.warranty_reference"></div><div class="col-12"><label class="form-label" for="editDeviceNotes">Notes</label><textarea id="editDeviceNotes" class="form-control" name="notes" rows="3" dmx-bind:value="deviceDetail.data.device.notes"></textarea></div></div><p class="small text-muted mt-3 mb-0">Lifecycle changes are managed separately.</p></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal" aria-label="Cancel">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="editDeviceForm.state.executing">Save Changes</button></div></form></div></div></div>
<div id="lifecycleModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="lifecycleTitle" aria-hidden="true" dmx-on:hidden="lifecycleForm.reset(true);selectedDeviceId.setValue('');selectedLifecycleCode.setValue('')"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="lifecycleTitle">Change Device Lifecycle</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="lifecycleForm" is="dmx-serverconnect-form" method="post" action="/api/devices/set-lifecycle" dmx-on:success="lifecycleModal.hide();deviceList.load();deviceNotice.setValue('Device lifecycle updated.');lifecycleForm.reset(true)"><div class="modal-body"><input type="hidden" name="id" dmx-bind:value="selectedDeviceId.value"><input type="hidden" name="lifecycle_code" dmx-bind:value="selectedLifecycleCode.value"><p dmx-text="selectedLifecycleCode.value == 'AVAILABLE' ? 'Mark this device as Available?' : 'Return this device to Received status?'">Confirm lifecycle change?</p><div class="alert alert-danger" role="alert" dmx-show="lifecycleForm.lastError.status" dmx-text="lifecycleForm.lastError.response && lifecycleForm.lastError.response.error ? lifecycleForm.lastError.response.error : 'Lifecycle could not be changed.'"></div></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="lifecycleForm.state.executing">Confirm</button></div></form></div></div></div>
