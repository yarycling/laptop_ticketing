<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="schoolAllocationPage" appConnect="local" -->
<meta name="ac:route" content="/device-allocations/schools">
<div class="portal-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context"></dmx-serverconnect>
  <dmx-serverconnect id="scopeContext" url="/api/auth/scope_context"></dmx-serverconnect>
  <dmx-serverconnect id="districtOptions" url="/api/device-school-allocations/district-options"></dmx-serverconnect>
  <dmx-serverconnect id="schoolOptions" url="/api/device-school-allocations/school-options" dmx-param:district_id="sourceDistrict.value"></dmx-serverconnect>
  <dmx-serverconnect id="inventorySchools" url="/api/device-school-allocations/school-options" dmx-param:district_id="inventoryDistrict.value"></dmx-serverconnect>
  <dmx-serverconnect id="districtDevices" url="/api/device-school-allocations/district-devices" noload="true" dmx-param:district_id="sourceDistrict.value" dmx-param:search="districtSearch.value" dmx-param:manufacturer_id="manufacturerFilter.value" dmx-param:device_model_id="modelFilter.value" dmx-param:condition_id="conditionFilter.value" dmx-param:page="districtPage.value" dmx-param:page_size="25"></dmx-serverconnect>
  <dmx-serverconnect id="schoolAllocations" url="/api/device-school-allocations/list" dmx-param:status="allocationStatus.value" dmx-param:district_id="inventoryDistrict.value" dmx-param:school_id="inventorySchool.value" dmx-param:search="schoolSearch.value" dmx-param:page="schoolPage.value" dmx-param:page_size="25"></dmx-serverconnect>
  <dmx-serverconnect id="allocationSummary" url="/api/device-school-allocations/summary"></dmx-serverconnect>
  <dmx-serverconnect id="schoolAllocationDetail" url="/api/device-school-allocations/detail"></dmx-serverconnect>
  <dmx-serverconnect id="deviceOptions" url="/api/devices/form-options"></dmx-serverconnect>
  <dmx-value id="selectedDistrictId" value=""></dmx-value><dmx-value id="districtPage" value="1"></dmx-value><dmx-value id="schoolPage" value="1"></dmx-value><dmx-value id="selectedDeviceCount" value="0"></dmx-value><dmx-value id="selectCurrentPage" value="0"></dmx-value><dmx-value id="schoolAllocationNotice"></dmx-value><dmx-value id="returnSchoolAllocationId" value=""></dmx-value><dmx-value id="returnSchoolDevice" value=""></dmx-value><dmx-value id="returnSchoolName" value=""></dmx-value><dmx-value id="returnSchoolDistrict" value=""></dmx-value>
  <%- await include("../partials/portal-sidebar", { currentPage: "school-allocation" }) %>
  <div class="portal-workspace">
    <%- await include("../partials/portal-topbar", { pageTitle: "School Allocation" }) %>
    <main class="portal-main district-allocation-page school-allocation-page">
      <section class="district-allocation-hero school-allocation-hero" aria-labelledby="schoolAllocationPageTitle"><div class="district-allocation-hero-copy"><div class="district-allocation-eyebrow">ALLOCATIONS</div><h1 id="schoolAllocationPageTitle">School Allocation</h1><p>Allocate available district-held devices to schools in the same district.</p></div></section>
      <div class="alert alert-success school-allocation-notice" role="status" dmx-show="schoolAllocationNotice.value" dmx-text="schoolAllocationNotice.value"></div>
      <div class="alert alert-danger school-allocation-error" role="alert" dmx-show="districtDevices.lastError.status || schoolAllocations.lastError.status" dmx-text="districtDevices.lastError.response && districtDevices.lastError.response.error ? districtDevices.lastError.response.error : (schoolAllocations.lastError.response && schoolAllocations.lastError.response.error ? schoolAllocations.lastError.response.error : 'School allocations could not be loaded.')"></div>
      <section class="district-allocation-summary" aria-label="School allocation overview">
        <article class="district-allocation-stat" dmx-show="allocationSummary.data.district_available_visible"><span class="district-allocation-stat-icon green"><i class="fas fa-landmark" aria-hidden="true"></i></span><div><strong dmx-text="allocationSummary.data.district_available || 0">0</strong><h2>District Available</h2><p>Devices available in selected district</p></div></article>
        <article class="district-allocation-stat"><span class="district-allocation-stat-icon blue"><i class="fas fa-laptop" aria-hidden="true"></i></span><div><strong dmx-text="allocationSummary.data.school_allocated || 0">0</strong><h2>Allocated to Schools</h2><p>Devices allocated to schools</p></div></article>
        <article class="district-allocation-stat"><span class="district-allocation-stat-icon purple"><i class="fas fa-school" aria-hidden="true"></i></span><div><strong dmx-text="allocationSummary.data.schools_with_inventory || 0">0</strong><h2>Schools with Inventory</h2><p>Schools that have devices</p></div></article>
      </section>
      <ul class="nav nav-tabs district-allocation-tabs" role="tablist">
        <li class="nav-item" dmx-show="authContext.data.can_device_school_allocations_manage"><button class="nav-link active" type="button" data-bs-toggle="tab" data-bs-target="#districtInventoryPanel" role="tab"><i class="fas fa-landmark" aria-hidden="true"></i> District Inventory</button></li>
        <li class="nav-item"><button class="nav-link" type="button" data-bs-toggle="tab" data-bs-target="#schoolInventoryPanel" role="tab" dmx-bind:class="!authContext.data.can_device_school_allocations_manage ? 'nav-link active' : 'nav-link'"><i class="fas fa-school" aria-hidden="true"></i> School Inventory</button></li>
      </ul>
      <div class="tab-content">
        <section class="tab-pane fade show active district-allocation-panel" id="districtInventoryPanel" role="tabpanel" dmx-show="authContext.data.can_device_school_allocations_manage">
          <div class="school-allocation-filter-heading"><span><i class="fas fa-filter" aria-hidden="true"></i></span><div><h2>Filter Devices</h2><p>Use the filters below to find and allocate devices to schools.</p></div></div>
          <div class="row g-2 mb-3">
            <div class="col-12 col-md-4"><label class="form-label" for="sourceDistrict">Source District</label><select id="sourceDistrict" class="form-select" dmx-bind:value="selectedDistrictId.value" dmx-on:change="selectedDistrictId.setValue(sourceDistrict.value);selectedDeviceCount.setValue(0);selectCurrentPage.setValue(false);schoolAllocationForm.reset();districtPage.setValue(1);districtDevices.load();schoolOptions.load()"><option value="">Select district</option><option dmx-repeat="districtOptions.data.districts" dmx-bind:value="id" dmx-text="name"></option></select></div>
            <div class="col-12 col-md-4"><label class="form-label" for="districtSearch">Search</label><input id="districtSearch" class="form-control" placeholder="Serial, asset tag or reference" dmx-on:input="selectedDeviceCount.setValue(0);selectCurrentPage.setValue(false);schoolAllocationForm.reset();districtPage.setValue(1);districtDevices.load()"></div>
            <div class="col-12 col-md-4"><label class="form-label" for="manufacturerFilter">Manufacturer</label><select id="manufacturerFilter" class="form-select" dmx-on:change="selectedDeviceCount.setValue(0);selectCurrentPage.setValue(false);schoolAllocationForm.reset();districtPage.setValue(1);districtDevices.load()"><option value="">All manufacturers</option><option dmx-repeat="deviceOptions.data.manufacturers" dmx-bind:value="id" dmx-text="name"></option></select></div>
            <div class="col-12 col-md-4"><label class="form-label" for="modelFilter">Model</label><select id="modelFilter" class="form-select" dmx-on:change="selectedDeviceCount.setValue(0);selectCurrentPage.setValue(false);schoolAllocationForm.reset();districtPage.setValue(1);districtDevices.load()"><option value="">All models</option><option dmx-repeat="deviceOptions.data.models" dmx-bind:value="id" dmx-text="manufacturer_name + ' · ' + model_name"></option></select></div>
            <div class="col-12 col-md-4"><label class="form-label" for="conditionFilter">Condition</label><select id="conditionFilter" class="form-select" dmx-on:change="selectedDeviceCount.setValue(0);selectCurrentPage.setValue(false);schoolAllocationForm.reset();districtPage.setValue(1);districtDevices.load()"><option value="">All conditions</option><option dmx-repeat="deviceOptions.data.conditions" dmx-bind:value="id" dmx-text="name"></option></select></div>
          </div>
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
            <span class="fw-semibold" role="status" aria-live="polite" dmx-text="'Selected: ' + (1 * selectedDeviceCount.value) + ((1 * selectedDeviceCount.value) == 1 ? ' device' : ' devices')">Selected: 0 devices</span>
            <div class="d-flex flex-wrap gap-2"><button class="btn btn-bmobile-secondary" type="button" dmx-on:click="selectCurrentPage.setValue(true);selectedDeviceCount.setValue(districtDevices.data.total - ((districtPage.value - 1) * 25) > 25 ? 25 : districtDevices.data.total - ((districtPage.value - 1) * 25))" dmx-bind:disabled="!districtDevices.data.devices || districtDevices.data.total == 0">Select Current Page</button><button class="btn btn-bmobile-secondary" type="button" dmx-on:click="schoolAllocationForm.reset();selectedDeviceCount.setValue(0);selectCurrentPage.setValue(false)" dmx-bind:disabled="(1 * selectedDeviceCount.value) == 0">Clear Selection</button><button class="btn btn-bmobile-primary" type="button" dmx-on:click="schoolAllocationModal.show()" dmx-bind:disabled="(1 * selectedDeviceCount.value) == 0 || (1 * selectedDeviceCount.value) > 500">Allocate Selected (<span dmx-text="1 * selectedDeviceCount.value">0</span>)</button></div>
          </div>
          <div class="table-responsive portal-table-wrapper"><table class="table portal-table align-middle district-allocation-table"><thead><tr><th></th><th>Serial</th><th>Asset Tag</th><th>Manufacturer / Model</th><th>Condition</th><th>District</th><th>Allocated to District</th><th>Warranty</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="districtDevices.data.devices"><tr><td><input class="form-check-input" type="checkbox" name="device_ids[]" form="schoolAllocationForm" dmx-bind:value="device_id" dmx-bind:checked="selectCurrentPage.value == true" dmx-on:change="selectedDeviceCount.setValue((1 * selectedDeviceCount.value) + ($originalEvent.target.checked ? 1 : -1))" aria-label="Select device"></td><td class="fw-semibold" dmx-text="serial_number"></td><td dmx-text="asset_tag || '-'">-</td><td><span dmx-text="manufacturer"></span><br><small class="text-muted" dmx-text="model"></small></td><td dmx-text="condition"></td><td dmx-text="districtDevices.data.district.name"></td><td dmx-text="district_allocated_at.formatDate('MMM d, yyyy, hh:mm A')"></td><td dmx-text="warranty_end_date ? warranty_end_date.formatDate('MMM d, yyyy') : 'Not recorded'"></td></tr></tbody></table></div>
          <div class="district-allocation-empty" dmx-show="!sourceDistrict.value || (!districtDevices.state.executing && districtDevices.data.success && districtDevices.data.total == 0)"><span><i class="fas fa-box-open" aria-hidden="true"></i></span><strong dmx-text="sourceDistrict.value ? 'No devices found' : 'Select a district'">Select a district</strong><p dmx-text="sourceDistrict.value ? 'No available district-held devices match the current filters. Devices allocated to schools appear under School Inventory.' : 'Choose a source district to view available devices.'">Choose a source district to view available devices.</p></div>
          <div class="d-flex justify-content-between align-items-center mt-2"><span class="text-muted" dmx-text="(districtDevices.data.total || 0) + ' district devices'">0 district devices</span><div class="btn-group"><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-bind:disabled="districtPage.value <= 1" dmx-on:click="schoolAllocationForm.reset();selectedDeviceCount.setValue(0);selectCurrentPage.setValue(false);districtPage.setValue(districtPage.value - 1);districtDevices.load()" aria-label="Previous page">‹</button><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-bind:disabled="districtPage.value >= districtDevices.data.total_pages" dmx-on:click="schoolAllocationForm.reset();selectedDeviceCount.setValue(0);selectCurrentPage.setValue(false);districtPage.setValue(districtPage.value + 1);districtDevices.load()" aria-label="Next page">›</button></div></div>
        </section>
        <section class="tab-pane fade district-allocation-panel" id="schoolInventoryPanel" role="tabpanel" dmx-bind:class="!authContext.data.can_device_school_allocations_manage ? 'tab-pane fade show active district-allocation-panel' : 'tab-pane fade district-allocation-panel'">
          <div class="school-allocation-filter-heading"><span><i class="fas fa-filter" aria-hidden="true"></i></span><div><h2>Filter School Inventory</h2><p>Search and filter devices allocated to schools in your authorized scope.</p></div></div>
          <div class="row g-2 mb-3"><div class="col-12 col-md-5"><label class="form-label" for="schoolSearch">Search school inventory</label><input id="schoolSearch" class="form-control" placeholder="Serial, asset tag, district or school" dmx-on:input="schoolPage.setValue(1);schoolAllocations.load()"></div><div class="col-12 col-md-3"><label class="form-label" for="inventoryDistrict">District</label><select id="inventoryDistrict" class="form-select" dmx-on:change="inventorySchool.setValue('');schoolPage.setValue(1);inventorySchools.load();schoolAllocations.load()"><option value="">All authorized districts</option><option dmx-repeat="districtOptions.data.districts" dmx-bind:value="id" dmx-text="name"></option></select></div><div class="col-12 col-md-3"><label class="form-label" for="inventorySchool">School</label><select id="inventorySchool" class="form-select" dmx-on:change="schoolPage.setValue(1);schoolAllocations.load()"><option value="">All authorized schools</option><option dmx-repeat="inventorySchools.data.schools" dmx-bind:value="id" dmx-text="name"></option></select></div><div class="col-12 col-md-1"><label class="form-label" for="allocationStatus">Status</label><select id="allocationStatus" class="form-select" dmx-on:change="schoolPage.setValue(1);schoolAllocations.load()"><option value="active">Active</option><option value="historical">Historical</option><option value="all">All</option></select></div></div>
          <div class="table-responsive portal-table-wrapper"><table class="table portal-table align-middle"><thead><tr><th>Serial</th><th>Asset Tag</th><th>Manufacturer / Model</th><th>Condition</th><th>District</th><th>School</th><th>Lifecycle</th><th>Allocated Date</th><th>Allocated By</th><th>Returned At</th><th>Returned By</th><th>Return Reason</th><th>Status</th><th>Custody</th><th>Action</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="schoolAllocations.data.allocations"><tr><td><a dmx-bind:href="'/devices/detail?id=' + device_id" dmx-text="serial_number"></a></td><td dmx-text="asset_tag || '-'">-</td><td><span dmx-text="manufacturer"></span><br><small class="text-muted" dmx-text="model"></small></td><td dmx-text="condition"></td><td dmx-text="district_name"></td><td dmx-text="school_name"></td><td dmx-text="lifecycle"></td><td dmx-text="allocated_at.formatDate('MMM d, yyyy, hh:mm A')"></td><td dmx-text="allocated_by || '-'">-</td><td dmx-text="returned_at ? returned_at.formatDate('MMM d, yyyy, hh:mm A') : '-'">-</td><td dmx-text="returned_by || '-'">-</td><td class="text-break" dmx-text="return_reason || '-'">-</td><td><span class="badge" dmx-class:text-bg-success="is_active == 1" dmx-class:text-bg-secondary="is_active != 1" dmx-text="is_active == 1 ? 'Active' : 'Returned'">Active</span></td><td dmx-text="current_custody_level"></td><td class="text-nowrap"><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-on:click="schoolAllocationDetail.load({id:school_allocation_id});schoolAllocationDetailModal.show()">View</button> <button class="btn btn-bmobile-primary btn-sm" type="button" dmx-show="is_active == 1 && lifecycle == 'AVAILABLE' && current_custody_level == 'SCHOOL' && authContext.data.can_device_school_returns_manage && (authContext.data.is_super_admin || scopeContext.data.has_national_scope || scopeContext.data.districts.flatten('id').contains(district_id))" dmx-on:click="returnSchoolAllocationId.setValue(school_allocation_id);returnSchoolDevice.setValue(serial_number);returnSchoolName.setValue(school_name);returnSchoolDistrict.setValue(district_name);returnSchoolModal.show()">Return to District</button><span class="small text-muted" dmx-show="is_active == 1 && current_custody_level == 'STUDENT'">Return student assignment first</span></td></tr></tbody></table></div>
          <div class="district-allocation-empty" dmx-show="schoolAllocations.data.allocations.count() == 0"><span><i class="fas fa-box-open" aria-hidden="true"></i></span><strong>No school allocations found</strong><p>No inventory records match your current search and filters.</p></div>
          <div class="d-flex justify-content-between align-items-center mt-2"><span class="text-muted" dmx-text="(schoolAllocations.data.total || 0) + ' allocations'">0 allocations</span><div class="btn-group"><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-bind:disabled="schoolPage.value <= 1" dmx-on:click="schoolPage.setValue(schoolPage.value - 1);schoolAllocations.load()" aria-label="Previous page">‹</button><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-bind:disabled="schoolPage.value >= schoolAllocations.data.total_pages" dmx-on:click="schoolPage.setValue(schoolPage.value + 1);schoolAllocations.load()" aria-label="Next page">›</button></div></div>
        </section>
      </div>
    </main>
  </div>
</div>
<div id="schoolAllocationModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="schoolAllocationTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="schoolAllocationTitle">Allocate to School</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="schoolAllocationForm" is="dmx-serverconnect-form" method="post" action="/api/device-school-allocations/allocate" dmx-on:success="schoolAllocationModal.hide();districtDevices.load();schoolAllocations.load();allocationSummary.load();schoolAllocationNotice.setValue('Devices allocated successfully.');schoolAllocationForm.reset(true);selectedDeviceCount.setValue(0);selectCurrentPage.setValue(false)"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="schoolAllocationForm.lastError.status" dmx-text="schoolAllocationForm.lastError.response && schoolAllocationForm.lastError.response.error ? schoolAllocationForm.lastError.response.error : 'Allocation could not be completed.'"></div><input type="hidden" name="school_id" dmx-bind:value="targetSchool.value"><p class="fw-semibold" dmx-text="(1 * selectedDeviceCount.value) + ((1 * selectedDeviceCount.value) == 1 ? ' device selected' : ' devices selected')">0 devices selected</p><p class="mb-3" dmx-text="'Source district: ' + (districtDevices.data.district.name || 'Select a district')">Source district</p><label class="form-label" for="targetSchool">Target School</label><select id="targetSchool" class="form-select" required><option value="">Select active school</option><option dmx-repeat="schoolOptions.data.schools" dmx-bind:value="id" dmx-text="name"></option></select><label class="form-label mt-3" for="schoolAllocationNotes">Notes (optional)</label><textarea id="schoolAllocationNotes" name="notes" class="form-control" rows="3" maxlength="2000"></textarea><p class="small text-muted mt-3 mb-0" dmx-text="'You are allocating ' + (1 * selectedDeviceCount.value) + ((1 * selectedDeviceCount.value) == 1 ? ' device from ' : ' devices from ') + (districtDevices.data.district.name || 'the selected district') + ' to ' + (targetSchool.selectedText || 'the selected school') + '. Device lifecycle will remain Available.'">Device lifecycle will remain Available.</p></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="schoolAllocationForm.state.executing || !targetSchool.value || (1 * selectedDeviceCount.value) == 0">Confirm Allocation</button></div></form></div></div></div>
<div id="schoolAllocationDetailModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="schoolAllocationDetailTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="schoolAllocationDetailTitle">School Allocation Detail</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="text-muted" dmx-show="schoolAllocationDetail.state.executing">Loading allocation...</div><dl class="row mb-0"><dt class="col-5">Device</dt><dd class="col-7" dmx-text="schoolAllocationDetail.data.allocation.serial_number"></dd><dt class="col-5">District</dt><dd class="col-7" dmx-text="schoolAllocationDetail.data.allocation.district_name"></dd><dt class="col-5">School</dt><dd class="col-7" dmx-text="schoolAllocationDetail.data.allocation.school_name"></dd><dt class="col-5">Allocated</dt><dd class="col-7" dmx-text="schoolAllocationDetail.data.allocation.allocated_at.formatDate('MMM d, yyyy, hh:mm A')"></dd><dt class="col-5">Allocated By</dt><dd class="col-7" dmx-text="schoolAllocationDetail.data.allocation.allocated_by"></dd><dt class="col-5">Current Custody</dt><dd class="col-7" dmx-text="schoolAllocationDetail.data.allocation.current_custody_level"></dd></dl></div></div></div></div>
<div id="returnSchoolModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="returnSchoolTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="returnSchoolTitle">Return Device to District</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="returnSchoolForm" is="dmx-serverconnect-form" method="post" action="/api/device-school-allocations/return" dmx-on:success="returnSchoolModal.hide();districtDevices.load();schoolAllocations.load();allocationSummary.load();schoolAllocationNotice.setValue('Device returned to District inventory. Lifecycle remains Available.');returnSchoolForm.reset(true);returnSchoolAllocationId.setValue('')"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="returnSchoolForm.lastError.status" dmx-text="returnSchoolForm.lastError.response && returnSchoolForm.lastError.response.error ? returnSchoolForm.lastError.response.error : 'The device could not be returned.'"></div><input type="hidden" name="school_allocation_id" dmx-bind:value="returnSchoolAllocationId.value"><dl class="row"><dt class="col-4">Device</dt><dd class="col-8" dmx-text="returnSchoolDevice.value"></dd><dt class="col-4">School</dt><dd class="col-8" dmx-text="returnSchoolName.value"></dd><dt class="col-4">District</dt><dd class="col-8" dmx-text="returnSchoolDistrict.value"></dd></dl><p dmx-text="'Return device ' + returnSchoolDevice.value + ' from ' + returnSchoolName.value + ' to ' + returnSchoolDistrict.value + '? Lifecycle remains Available.'"></p><label class="form-label" for="schoolReturnReason">Return reason</label><textarea id="schoolReturnReason" name="return_reason" class="form-control" maxlength="500" required></textarea></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="returnSchoolForm.state.executing">Return to District</button></div></form></div></div></div>
