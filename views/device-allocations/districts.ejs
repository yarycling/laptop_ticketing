<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="districtAllocationsPage" appConnect="local" -->
<meta name="ac:route" content="/device-allocations/districts">
<div class="portal-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context"></dmx-serverconnect>
  <dmx-serverconnect id="scopeContext" url="/api/auth/scope_context"></dmx-serverconnect>
  <dmx-serverconnect id="deviceOptions" url="/api/devices/form-options"></dmx-serverconnect>
  <dmx-serverconnect id="districtOptions" url="/api/device-district-allocations/district-options"></dmx-serverconnect>
  <dmx-serverconnect id="allocationSummary" url="/api/device-district-allocations/summary"></dmx-serverconnect>
  <dmx-serverconnect id="centralDevices" url="/api/device-district-allocations/central-devices" dmx-param:search="centralSearch.value" dmx-param:manufacturer_id="manufacturerFilter.value" dmx-param:device_model_id="modelFilter.value" dmx-param:condition_id="conditionFilter.value" dmx-param:page="centralPage.value" dmx-param:page_size="25"></dmx-serverconnect>
  <dmx-serverconnect id="districtAllocations" url="/api/device-district-allocations/list" dmx-param:search="districtSearch.value" dmx-param:district_id="districtFilter.value" dmx-param:status="allocationStatus.value" dmx-param:page="districtPage.value" dmx-param:page_size="25"></dmx-serverconnect>
  <dmx-serverconnect id="allocationDetail" url="/api/device-district-allocations/detail"></dmx-serverconnect>
  <dmx-value id="centralPage" value="1"></dmx-value><dmx-value id="districtPage" value="1"></dmx-value><dmx-value id="allocationNotice"></dmx-value><dmx-value id="selectedDeviceCount" value="0"></dmx-value><dmx-value id="selectCurrentPage" value="0"></dmx-value><dmx-value id="returnDistrictAllocationId" value=""></dmx-value><dmx-value id="returnDistrictDevice" value=""></dmx-value><dmx-value id="returnDistrictName" value=""></dmx-value>
  <%- await include("../partials/portal-sidebar", { currentPage: "district-allocation" }) %>
  <div class="portal-workspace">
    <%- await include("../partials/portal-topbar") %>
    
    <main class="portal-main district-allocation-page">
      <section class="district-allocation-hero" aria-labelledby="districtAllocationTitle"><div class="district-allocation-hero-copy"><div class="district-allocation-eyebrow">ALLOCATIONS</div><h1 id="districtAllocationTitle">District Allocation</h1><h2>Central stock and district custody</h2><p>Manage the movement of laptops from central inventory to districts<br class="d-none d-lg-block"> and track district custody across all locations.</p></div></section>
      <div class="alert alert-success district-allocation-notice" role="status" dmx-show="allocationNotice.value" dmx-text="allocationNotice.value"></div>
      <section class="district-allocation-summary" aria-label="Allocation overview" dmx-show="authContext.data.can_device_district_allocations_manage && (authContext.data.is_super_admin || scopeContext.data.has_national_scope)">
        <article class="district-allocation-stat"><span class="district-allocation-stat-icon green"><i class="fas fa-cube" aria-hidden="true"></i></span><div><strong dmx-text="allocationSummary.data.central_available || 0">0</strong><h2>Central Available</h2><p>Devices in central inventory</p></div></article>
        <article class="district-allocation-stat"><span class="district-allocation-stat-icon blue"><i class="fas fa-truck" aria-hidden="true"></i></span><div><strong dmx-text="allocationSummary.data.district_allocated || 0">0</strong><h2>Allocated to Districts</h2><p>Devices allocated to districts</p></div></article>
        <article class="district-allocation-stat"><span class="district-allocation-stat-icon purple"><i class="fas fa-map-marker-alt" aria-hidden="true"></i></span><div><strong dmx-text="allocationSummary.data.districts_with_inventory || 0">0</strong><h2>Districts with Inventory</h2><p>Districts currently holding devices</p></div></article>
      </section>
      <ul class="nav nav-tabs district-allocation-tabs" role="tablist"><li class="nav-item" dmx-show="authContext.data.can_device_district_allocations_manage && (authContext.data.is_super_admin || scopeContext.data.has_national_scope)"><button class="nav-link active" type="button" data-bs-toggle="tab" data-bs-target="#centralPanel" role="tab"><i class="fas fa-cube" aria-hidden="true"></i> Central Inventory</button></li><li class="nav-item"><button class="nav-link" type="button" data-bs-toggle="tab" data-bs-target="#districtPanel" role="tab"><i class="fas fa-school" aria-hidden="true"></i> District Inventory</button></li></ul>
      <div class="tab-content">
        <section class="tab-pane fade show active district-allocation-panel" id="centralPanel" role="tabpanel" dmx-show="authContext.data.can_device_district_allocations_manage && (authContext.data.is_super_admin || scopeContext.data.has_national_scope)">
          <div class="d-flex flex-wrap align-items-center gap-2 mb-3"><input id="centralSearch" class="form-control flex-grow-1" style="max-width:320px" placeholder="Search serial, asset tag, reference" dmx-on:input="allocationForm.reset();selectedDeviceCount.setValue(0);selectCurrentPage.setValue(false);centralPage.setValue(1);centralDevices.load()"><select id="manufacturerFilter" class="form-select" style="max-width:220px" dmx-on:change="allocationForm.reset();selectedDeviceCount.setValue(0);selectCurrentPage.setValue(false);centralPage.setValue(1);centralDevices.load()"><option value="">All manufacturers</option><option dmx-repeat="deviceOptions.data.manufacturers" dmx-bind:value="id" dmx-text="name"></option></select><select id="modelFilter" class="form-select" style="max-width:240px" dmx-on:change="allocationForm.reset();selectedDeviceCount.setValue(0);selectCurrentPage.setValue(false);centralPage.setValue(1);centralDevices.load()"><option value="">All models</option><option dmx-repeat="deviceOptions.data.models" dmx-bind:value="id" dmx-text="manufacturer_name + ' · ' + model_name"></option></select><select id="conditionFilter" class="form-select" style="max-width:180px" dmx-on:change="allocationForm.reset();selectedDeviceCount.setValue(0);selectCurrentPage.setValue(false);centralPage.setValue(1);centralDevices.load()"><option value="">All conditions</option><option dmx-repeat="deviceOptions.data.conditions" dmx-bind:value="id" dmx-text="name"></option></select></div>
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2"><span class="fw-semibold" role="status" aria-live="polite" dmx-text="'Selected: ' + (1 * selectedDeviceCount.value) + ((1 * selectedDeviceCount.value) == 1 ? ' device' : ' devices')">Selected: 0 devices</span><div class="d-flex flex-wrap gap-2"><button class="btn btn-bmobile-secondary" type="button" dmx-on:click="selectCurrentPage.setValue(true);selectedDeviceCount.setValue(centralDevices.data.total - ((centralPage.value - 1) * 25) > 25 ? 25 : centralDevices.data.total - ((centralPage.value - 1) * 25))" dmx-show="authContext.data.can_device_district_allocations_manage" dmx-bind:disabled="!centralDevices.data.devices || centralDevices.data.total == 0">Select Current Page</button><button class="btn btn-bmobile-secondary" type="button" dmx-on:click="allocationForm.reset();selectedDeviceCount.setValue(0);selectCurrentPage.setValue(false)" dmx-bind:disabled="(1 * selectedDeviceCount.value) == 0">Clear Selection</button><button class="btn btn-bmobile-primary" type="button" dmx-on:click="allocateModal.show()" dmx-show="authContext.data.can_device_district_allocations_manage" dmx-bind:disabled="(1 * selectedDeviceCount.value) == 0 || (1 * selectedDeviceCount.value) > 500" dmx-text="'Allocate Selected (' + (1 * selectedDeviceCount.value) + ')'">Allocate Selected (0)</button></div></div>
          <div class="alert alert-warning py-2" role="status" dmx-show="(1 * selectedDeviceCount.value) > 500">Select no more than 500 devices per allocation.</div>
          
            <div class="table-responsive portal-table-wrapper"><table class="table portal-table align-middle"><thead><tr><th><span class="visually-hidden">Select device</span></th><th>Serial Number</th><th>Asset Tag</th><th>Manufacturer / Model</th><th>Condition</th><th>Warranty</th><th>Received Date</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="centralDevices.data.devices"><tr><td><input class="form-check-input" type="checkbox" name="device_ids[]" form="allocationForm" dmx-bind:value="device_id" dmx-bind:checked="selectCurrentPage.value == true" dmx-on:change="selectedDeviceCount.setValue((1 * selectedDeviceCount.value) + ($originalEvent.target.checked ? 1 : -1))" dmx-show="authContext.data.can_device_district_allocations_manage" aria-label="Select device"></td><td class="fw-semibold" dmx-text="serial_number"></td><td dmx-text="asset_tag || '-'">-</td><td><span dmx-text="manufacturer"></span><br><small class="text-muted" dmx-text="model"></small></td><td dmx-text="condition"></td><td dmx-text="warranty_end_date ? warranty_end_date.formatDate('MMM d, yyyy') : 'Not recorded'"></td><td dmx-text="received_date ? received_date.formatDate('MMM d, yyyy') : 'Not recorded'"></td></tr></tbody></table></div>
            <div class="district-allocation-empty" dmx-show="centralDevices.data.total == 0"><span><i class="fas fa-box-open" aria-hidden="true"></i></span><strong>No devices found</strong><p>No central devices match these filters. Try changing your search or filters.</p></div>
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2"><span class="text-muted" dmx-text="(centralDevices.data.total || 0) + ' central devices'">0 central devices</span><div class="btn-group"><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-bind:disabled="centralPage.value <= 1" dmx-on:click="allocationForm.reset();selectedDeviceCount.setValue(0);selectCurrentPage.setValue(false);centralPage.setValue(centralPage.value - 1);centralDevices.load()" aria-label="Previous page"><i class="fas fa-chevron-left"></i></button><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-bind:disabled="centralPage.value >= centralDevices.data.total_pages" dmx-on:click="allocationForm.reset();selectedDeviceCount.setValue(0);selectCurrentPage.setValue(false);centralPage.setValue(centralPage.value + 1);centralDevices.load()" aria-label="Next page"><i class="fas fa-chevron-right"></i></button></div></div>
                    </section>
        <section class="tab-pane fade district-allocation-panel" id="districtPanel" role="tabpanel"><div class="district-allocation-filters"><div class="district-allocation-search"><i class="fas fa-search" aria-hidden="true"></i><input id="districtSearch" class="form-control" placeholder="Search serial, asset tag or district" dmx-on:input="districtPage.setValue(1);districtAllocations.load()"></div><select id="allocationStatus" class="form-select" dmx-on:change="districtPage.setValue(1);districtAllocations.load()"><option value="active">Active allocations</option><option value="historical">Historical</option><option value="all">All records</option></select><select id="districtFilter" class="form-select" dmx-show="authContext.data.can_device_district_allocations_manage && (authContext.data.is_super_admin || scopeContext.data.has_national_scope)" dmx-on:change="districtPage.setValue(1);districtAllocations.load()"><option value="">All districts</option><option dmx-repeat="districtOptions.data.districts" dmx-bind:value="id" dmx-text="name"></option></select></div><div class="table-responsive portal-table-wrapper"><table class="table portal-table align-middle district-allocation-table"><thead><tr><th>Serial</th><th>Asset Tag</th><th>Manufacturer / Model</th><th>Condition</th><th>District</th><th>Lifecycle</th><th>Allocated Date</th><th>Allocated By</th><th>Returned At</th><th>Returned By</th><th>Return Reason</th><th>Status</th><th>Current Custody</th><th>Action</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="districtAllocations.data.allocations"><tr><td><a dmx-bind:href="'/devices/detail?id=' + device_id" dmx-text="serial_number"></a></td><td dmx-text="asset_tag || '-'">-</td><td><span dmx-text="manufacturer"></span><br><small class="text-muted" dmx-text="model"></small></td><td dmx-text="condition"></td><td dmx-text="district_name"></td><td dmx-text="lifecycle"></td><td dmx-text="allocated_at.formatDate('MMM d, yyyy, hh:mm A')"></td><td dmx-text="allocated_by || '-'">-</td><td dmx-text="returned_at ? returned_at.formatDate('MMM d, yyyy, hh:mm A') : '-'">-</td><td dmx-text="returned_by || '-'">-</td><td class="text-break" dmx-text="return_reason || '-'">-</td><td><span class="badge" dmx-class:text-bg-success="active_record_key == 1" dmx-class:text-bg-secondary="active_record_key != 1" dmx-text="active_record_key == 1 ? 'Active' : 'Returned'">Active</span></td><td><button class="btn btn-link btn-sm p-0" type="button" dmx-on:click="allocationDetail.load({id:allocation_id});allocationDetailModal.show()" dmx-text="current_custody_level"></button></td><td class="text-nowrap"><button class="btn btn-bmobile-primary btn-sm" type="button" dmx-show="active_record_key == 1 && lifecycle == 'AVAILABLE' && current_custody_level == 'DISTRICT' && authContext.data.can_device_district_returns_manage && (authContext.data.is_super_admin || scopeContext.data.has_national_scope)" dmx-on:click="returnDistrictAllocationId.setValue(allocation_id);returnDistrictDevice.setValue(serial_number);returnDistrictName.setValue(district_name);returnDistrictModal.show()">Return to Central</button><span class="small text-muted" dmx-show="active_record_key == 1 && (current_custody_level == 'SCHOOL' || current_custody_level == 'STUDENT')">Return child allocation first</span></td></tr></tbody></table></div><div class="district-allocation-empty" dmx-show="districtAllocations.data.allocations.count() == 0"><span><i class="fas fa-box-open" aria-hidden="true"></i></span><strong>No district allocations found</strong><p>No allocation records match these filters.</p></div></section>
      </div>
    </main>
  </div>
  <div id="allocateModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="allocateTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="allocateTitle">Allocate to District</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="allocationForm" is="dmx-serverconnect-form" method="post" action="/api/device-district-allocations/allocate" dmx-on:success="allocateModal.hide();centralDevices.load();districtAllocations.load();allocationSummary.load();allocationNotice.setValue('Devices allocated successfully.');allocationForm.reset(true);selectedDeviceCount.setValue(0);selectCurrentPage.setValue(false)"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="allocationForm.lastError.status" dmx-text="allocationForm.lastError.response && allocationForm.lastError.response.error ? allocationForm.lastError.response.error : 'Allocation could not be completed.'"></div><p class="fw-semibold" role="status" dmx-text="(1 * selectedDeviceCount.value) + ((1 * selectedDeviceCount.value) == 1 ? ' device selected' : ' devices selected')">0 devices selected</p><label class="form-label" for="allocationDistrict">District</label><select id="allocationDistrict" name="district_id" class="form-select" required><option value="">Select district</option><option dmx-repeat="districtOptions.data.districts" dmx-bind:value="id" dmx-text="name"></option></select><label class="form-label mt-3" for="allocationNotes">Notes (optional)</label><textarea id="allocationNotes" name="notes" class="form-control" rows="3" maxlength="2000"></textarea><p class="small text-muted mt-3 mb-0" dmx-text="'You are allocating ' + (1 * selectedDeviceCount.value) + ((1 * selectedDeviceCount.value) == 1 ? ' device to the selected district.' : ' devices to the selected district.') + ' Lifecycle remains Available.'">Devices will move from Central to the selected district. Lifecycle remains Available.</p></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="allocationForm.state.executing || (1 * selectedDeviceCount.value) == 0 || (1 * selectedDeviceCount.value) > 500">Confirm Allocation</button></div></form></div></div></div>
  <div id="allocationDetailModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="allocationDetailTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="allocationDetailTitle">Allocation Detail</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div dmx-show="allocationDetail.state.executing">Loading allocation...</div><dl class="row mb-0"><dt class="col-5">Device</dt><dd class="col-7" dmx-text="allocationDetail.data.allocation.serial_number"></dd><dt class="col-5">District</dt><dd class="col-7" dmx-text="allocationDetail.data.allocation.district_name"></dd><dt class="col-5">Allocated</dt><dd class="col-7" dmx-text="allocationDetail.data.allocation.allocated_at.formatDate('MMM d, yyyy, hh:mm A')"></dd><dt class="col-5">Current Custody</dt><dd class="col-7" dmx-text="allocationDetail.data.allocation.current_custody_level"></dd></dl></div></div></div></div>
  <div id="allocationDetailModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="allocationDetailTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="allocationDetailTitle">Allocation Detail</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div dmx-show="allocationDetail.state.executing">Loading allocation...</div><dl class="row mb-0"><dt class="col-5">Device</dt><dd class="col-7" dmx-text="allocationDetail.data.allocation.serial_number"></dd><dt class="col-5">District</dt><dd class="col-7" dmx-text="allocationDetail.data.allocation.district_name"></dd><dt class="col-5">Allocated</dt><dd class="col-7" dmx-text="allocationDetail.data.allocation.allocated_at.formatDate('MMM d, yyyy, hh:mm A')"></dd><dt class="col-5">Current Custody</dt><dd class="col-7" dmx-text="allocationDetail.data.allocation.current_custody_level"></dd></dl></div></div></div></div>
  <div id="returnDistrictModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="returnDistrictTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="returnDistrictTitle">Return Device to Central</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="returnDistrictForm" is="dmx-serverconnect-form" method="post" action="/api/device-district-allocations/return" dmx-on:success="returnDistrictModal.hide();centralDevices.load();districtAllocations.load();allocationSummary.load();allocationNotice.setValue('Device returned to Central inventory. Lifecycle remains Available.');returnDistrictForm.reset(true);returnDistrictAllocationId.setValue('')"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="returnDistrictForm.lastError.status" dmx-text="returnDistrictForm.lastError.response && returnDistrictForm.lastError.response.error ? returnDistrictForm.lastError.response.error : 'The device could not be returned.'"></div><input type="hidden" name="district_allocation_id" dmx-bind:value="returnDistrictAllocationId.value"><dl class="row"><dt class="col-4">Device</dt><dd class="col-8" dmx-text="returnDistrictDevice.value"></dd><dt class="col-4">District</dt><dd class="col-8" dmx-text="returnDistrictName.value"></dd></dl><p dmx-text="'Return device ' + returnDistrictDevice.value + ' from ' + returnDistrictName.value + ' to Central inventory? Lifecycle remains Available.'"></p><label class="form-label" for="districtReturnReason">Return reason</label><textarea id="districtReturnReason" name="return_reason" class="form-control" maxlength="500" required></textarea></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="returnDistrictForm.state.executing">Return to Central</button></div></form></div></div></div>
</div>
