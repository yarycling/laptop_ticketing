<!-- Wappler include head-page="layouts/auth" bootstrap5="local" is="dmx-app" id="resetPassword" appConnect="local" -->
<meta name="ac:route" content="/reset-password">

<div class="reset-password-page">
  <dmx-serverconnect id="resetTokenValidation" url="/api/auth/reset-password/validate" dmx-param:r="query.r" dmx-param:token="query.token"></dmx-serverconnect>

  <section class="reset-hero-panel" aria-labelledby="resetHeroTitle">
    <img class="reset-hero-art" src="/assets/img/auth/reset-shield-composition.png" alt="" aria-hidden="true">
    <img class="brand-logo reset-hero-logo" src="/assets/img/brand/bmobile-logo.png" alt="bmobile">
    <div class="reset-hero-copy">
      <p class="reset-eyebrow">YOUR ACCOUNT. OUR PRIORITY.</p>
      <h1 id="resetHeroTitle">Secure your account and stay connected</h1>
      <p class="reset-hero-lead">Create a new, strong password to restore access to your bmobile account. Keep your information safe and your experience uninterrupted.</p>
      <div class="reset-benefits" aria-label="Account security benefits">
        <article class="reset-benefit">
          <img src="/assets/img/auth/reset-icon-shield-check.png" alt="" aria-hidden="true">
          <div>
            <h2>Stronger security</h2>
            <p>Help keep your account and personal information safe.</p>
          </div>
        </article>
        <article class="reset-benefit">
          <img src="/assets/img/auth/reset-icon-lock.png" alt="" aria-hidden="true">
          <div>
            <h2>Stay in control</h2>
            <p>Create a unique password that works for you.</p>
          </div>
        </article>
        <article class="reset-benefit">
          <img src="/assets/img/auth/reset-icon-clock.png" alt="" aria-hidden="true">
          <div>
            <h2>Get back to what matters</h2>
            <p>Restore access and continue enjoying bmobile's services.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="reset-form-panel" aria-label="Choose a new password">
    <div class="reset-form-card">
      <div class="reset-card-brand"><img class="brand-logo" src="/assets/img/brand/bmobile-logo.png" alt="bmobile"></div>
      <div dmx-show="resetTokenValidation.data.valid">
        <h2>Choose a new password</h2>
        <p class="reset-card-copy">Use at least 15 characters. Passphrases and spaces are allowed; avoid common or predictable passwords.</p>
        <dmx-value id="newPasswordVisible" dmx-bind:value="false"></dmx-value>
        <dmx-value id="confirmPasswordVisible" dmx-bind:value="false"></dmx-value>
        <form id="resetPasswordForm" is="dmx-serverconnect-form" class="portal-form reset-form" method="post" action="/api/auth/reset-password" dmx-on:success="portalRedirect(resetPasswordForm.data.redirect)">
          <input type="hidden" name="r" dmx-bind:value="query.r">
          <input type="hidden" name="token" dmx-bind:value="query.token">
          <div class="reset-field">
            <label for="newPassword" class="form-label">New password</label>
            <div class="reset-password-input">
              <input id="newPassword" name="new_password" dmx-bind:type="newPasswordVisible.value ? 'text' : 'password'" type="password" class="form-control" autocomplete="new-password" aria-describedby="resetStrengthHelp" minlength="15" maxlength="128" required>
              <button type="button" dmx-on:click="newPasswordVisible.setValue(!newPasswordVisible.value)" dmx-bind:aria-label="newPasswordVisible.value ? 'Hide password' : 'Show password'" dmx-bind:title="newPasswordVisible.value ? 'Hide password' : 'Show password'"><i class="far fa-eye" dmx-show="!newPasswordVisible.value" aria-hidden="true"></i><i class="far fa-eye-slash" dmx-show="newPasswordVisible.value" aria-hidden="true"></i></button>
            </div>
          </div>
          <div class="reset-strength" aria-live="polite">
            <div class="reset-strength-label"><span>Password strength</span><strong dmx-text="!newPassword.value ? 'Enter a password' : newPassword.value.length() < 8 ? 'Very weak' : (newPassword.value.length() < 12 ? 'Weak' : (newPassword.value.length() < 15 ? 'Fair' : (newPassword.value.length() < 20 ? 'Strong' : 'Very strong'))) "></strong></div>
            <div class="reset-strength-meter" role="meter" aria-label="Password strength" aria-valuemin="0" aria-valuemax="4" dmx-bind:aria-valuenow="newPassword.value.length() >= 20 ? 4 : (newPassword.value.length() >= 15 ? 3 : (newPassword.value.length() >= 8 ? 2 : (newPassword.value.length() > 0 ? 1 : 0)))">
              <span dmx-bind:class="newPassword.value.length() >= 1 ? (newPassword.value.length() < 8 ? 'is-on is-weak' : (newPassword.value.length() < 15 ? 'is-on is-fair' : 'is-on is-strong')) : ''"></span>
              <span dmx-bind:class="newPassword.value.length() >= 8 ? (newPassword.value.length() < 15 ? 'is-on is-fair' : 'is-on is-strong') : ''"></span>
              <span dmx-bind:class="newPassword.value.length() >= 15 ? 'is-on is-strong' : ''"></span>
              <span dmx-bind:class="newPassword.value.length() >= 20 ? 'is-on is-strong' : ''"></span>
            </div>
            <small id="resetStrengthHelp">A Strong or Very strong password (15–128 characters) is required. Server-side password checks also apply.</small>
          </div>
          <div class="reset-field reset-confirm-field">
            <label for="confirmPassword" class="form-label">Confirm new password</label>
            <div class="reset-password-input">
              <input id="confirmPassword" name="confirm_password" dmx-bind:type="confirmPasswordVisible.value ? 'text' : 'password'" type="password" class="form-control" autocomplete="new-password" maxlength="128" required>
              <button type="button" dmx-on:click="confirmPasswordVisible.setValue(!confirmPasswordVisible.value)" dmx-bind:aria-label="confirmPasswordVisible.value ? 'Hide password' : 'Show password'" dmx-bind:title="confirmPasswordVisible.value ? 'Hide password' : 'Show password'"><i class="far fa-eye" dmx-show="!confirmPasswordVisible.value" aria-hidden="true"></i><i class="far fa-eye-slash" dmx-show="confirmPasswordVisible.value" aria-hidden="true"></i></button>
            </div>
            <small class="reset-mismatch" dmx-show="confirmPassword.value && confirmPassword.value != newPassword.value">Passwords do not match.</small>
          </div>
          <div class="portal-alert portal-alert-danger" role="alert" dmx-show="resetPasswordForm.lastError.status">This link may have expired or the password could not be accepted. Check the requirements and try again.</div>
          <button class="btn btn-bmobile-primary reset-submit w-100" type="submit" dmx-bind:disabled="resetPasswordForm.state.executing || !resetTokenValidation.data.valid || !newPassword.value || newPassword.value.length() < 15 || newPassword.value.length() > 128 || !confirmPassword.value || confirmPassword.value != newPassword.value">
            <span dmx-show="!resetPasswordForm.state.executing"><span dmx-text="resetTokenValidation.data.purpose == 'ACCOUNT_SETUP' ? 'Set password' : 'Reset password'"></span> <i class="fas fa-arrow-right ms-2" aria-hidden="true"></i></span>
            <span dmx-show="resetPasswordForm.state.executing">Updating password...</span>
          </button>
        </form>
      </div>
      <div dmx-show="!resetTokenValidation.data.valid">
        <h2>Reset link unavailable</h2>
        <p class="reset-card-copy">This password reset link is invalid or has expired.</p>
        <a class="reset-request-link" href="/forgot-password">Request a new reset link</a>
      </div>
      <a class="reset-back-link" href="/login">Back to sign in</a>
    </div>
  </section>
</div>