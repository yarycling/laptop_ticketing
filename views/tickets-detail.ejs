<section class="col-12 col-xl-6 ticket-detail-info-card ticket-detail-origin"><h2 class="h5 border-bottom pb-2">Ticket Origin</h2><dl class="row"><dt class="col-sm-4">District</dt><dd class="col-sm-8" dmx-text="ticketDetail.data.origin.district_name"></dd><dt class="col-sm-4">School</dt><dd class="col-sm-8" dmx-text="ticketDetail.data.origin.school_name"></dd><dt class="col-sm-4" dmx-show="ticketDetail.data.ticket.origin_student_id">Student</dt><dd class="col-sm-8" dmx-show="ticketDetail.data.ticket.origin_student_id" dmx-text="ticketDetail.data.origin_student.student_reference + ' — ' + ticketDetail.data.origin_student.first_name + ' ' + ticketDetail.data.origin_student.last_name"></dd></dl><h2 class="h5 border-bottom pb-2 mt-4">Requester</h2><dl class="row"><dt class="col-sm-4">Type</dt><dd class="col-sm-8" dmx-text="ticketDetail.data.ticket.requester_type"></dd><dt class="col-sm-4">Name</dt><dd class="col-sm-8" dmx-text="ticketDetail.data.ticket.requester_name"></dd><dt class="col-sm-4">Email</dt><dd class="col-sm-8" dmx-text="ticketDetail.data.ticket.requester_email || 'Not provided'"></dd><dt class="col-sm-4">Phone</dt><dd class="col-sm-8" dmx-text="ticketDetail.data.ticket.requester_phone || 'Not provided'"></dd></dl></section><section class="mt-3 ticket-detail-problem"><h2 class="h5 border-bottom pb-2">Problem</h2><h3 class="h6" dmx-show="ticketDetail.data.ticket.subject" dmx-text="ticketDetail.data.ticket.subject"></h3><p class="text-break" dmx-show="ticketDetail.data.ticket.description" dmx-text="ticketDetail.data.ticket.description"></p><p class="text-muted mb-2" dmx-show="!ticketDetail.data.ticket.subject && !ticketDetail.data.ticket.description">No problem details recorded yet.</p><p class="small text-muted mb-0"><span dmx-text="ticketDetail.data.ticket.submitted_at.formatDate('MMM d, yyyy, hh:mm A')"></span><span dmx-show="ticketDetail.data.created_by.display_name"> · Recorded by <span dmx-text="ticketDetail.data.created_by.display_name"></span></span></p></section><section class="mt-4 ticket-detail-status-history"><h2 class="h5 border-bottom pb-2">Status History</h2><div class="table-responsive portal-table-wrapper"><table class="table portal-table align-middle"><thead><tr><th>From</th><th>To</th><th>Date</th><th>Changed By</th><th>Reason</th><th>Comment</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="ticketDetail.data.status_history"><tr><td dmx-text="from_status_name || 'New'">New</td><td dmx-text="to_status_name"></td><td class="text-nowrap" dmx-text="changed_at.formatDate('MMM d, yyyy, hh:mm A')"></td><td dmx-text="changed_by_display_name || 'System'"></td><td dmx-text="reason || '-'">-</td><td class="text-break" dmx-text="comment || '-'">-</td></tr></tbody></table></div></section>
