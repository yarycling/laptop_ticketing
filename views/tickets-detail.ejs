      <div id="assignModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="assignModalTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="assignModalTitle">Assign Technician</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="assignForm" is="dmx-serverconnect-form" method="post" action="/api/tickets/assignment/assign" dmx-on:success="assignModal.hide();ticketDetail.load();workflowNotice.setValue('Technician assigned. Ticket status and device custody are unchanged.');assignForm.reset(true)"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="assignForm.lastError.status" dmx-text="assignForm.lastError.response && assignForm.lastError.response.error ? assignForm.lastError.response.error : 'Assignment could not be completed.'"></div><input type="hidden" name="ticket_id" dmx-bind:value="ticketDetail.data.ticket.id"><label class="form-label" for="assignTechnician">Technical Officer</label><select id="assignTechnician" name="assigned_to_user_id" class="form-select" required><option value="">Select technical officer</option><option dmx-repeat="assignmentOptions.data.technicians" dmx-bind:value="user_id" dmx-text="display_name + ' (' + username + ')' "></option></select><p class="small text-muted mt-2 mb-0">Only active technical officers with a scope covering this ticket's origin are listed.</p></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="assignForm.state.executing">Assign</button></div></form></div></div></div>
      <div id="reassignModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="reassignModalTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="reassignModalTitle">Reassign Technician</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="reassignForm" is="dmx-serverconnect-form" method="post" action="/api/tickets/assignment/reassign" dmx-on:success="reassignModal.hide();ticketDetail.load();workflowNotice.setValue('Ticket reassigned. Assignment history was retained.');reassignForm.reset(true)"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="reassignForm.lastError.status" dmx-text="reassignForm.lastError.response && reassignForm.lastError.response.error ? reassignForm.lastError.response.error : 'Reassignment could not be completed.'"></div><input type="hidden" name="ticket_id" dmx-bind:value="ticketDetail.data.ticket.id"><label class="form-label" for="reassignTechnician">New Technical Officer</label><select id="reassignTechnician" name="assigned_to_user_id" class="form-select" required><option value="">Select technical officer</option><option dmx-repeat="assignmentOptions.data.technicians" dmx-bind:value="user_id" dmx-text="display_name + ' (' + username + ')' "></option></select><label class="form-label mt-3" for="reassignReason">Reason</label><textarea id="reassignReason" name="reason" class="form-control" rows="3" maxlength="500" required></textarea></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="reassignForm.state.executing">Reassign</button></div></form></div></div></div>
      <div id="releaseModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="releaseModalTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="releaseModalTitle">Release to Queue</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="releaseForm" is="dmx-serverconnect-form" method="post" action="/api/tickets/assignment/release" dmx-on:success="releaseModal.hide();ticketDetail.load();workflowNotice.setValue('Ticket released to the unassigned queue. Ticket status and device custody are unchanged.');releaseForm.reset(true)"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="releaseForm.lastError.status" dmx-text="releaseForm.lastError.response && releaseForm.lastError.response.error ? releaseForm.lastError.response.error : 'Assignment could not be released.'"></div><input type="hidden" name="ticket_id" dmx-bind:value="ticketDetail.data.ticket.id"><label class="form-label" for="releaseReason">Reason</label><textarea id="releaseReason" name="reason" class="form-control" rows="3" maxlength="500" required></textarea><p class="small text-muted mt-2 mb-0">The current assignment will be retained in history and this ticket will return to the unassigned queue.</p></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="releaseForm.state.executing">Release</button></div></form></div></div></div>
      <div id="claimModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="claimModalTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="claimModalTitle">Claim Ticket</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="claimForm" is="dmx-serverconnect-form" method="post" action="/api/tickets/assignment/claim" dmx-on:success="claimModal.hide();ticketDetail.load();workflowNotice.setValue('Ticket assigned to you. Ticket status and device custody are unchanged.');claimForm.reset(true)"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="claimForm.lastError.status" dmx-text="claimForm.lastError.response && claimForm.lastError.response.error ? claimForm.lastError.response.error : 'Ticket could not be claimed.'"></div><input type="hidden" name="ticket_id" dmx-bind:value="ticketDetail.data.ticket.id"><p>Assign <strong dmx-text="ticketDetail.data.ticket.ticket_number"></strong> to yourself?</p></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="claimForm.state.executing">Confirm Claim</button></div></form></div></div></div>
      <div id="diagnosisModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="diagnosisModalTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="diagnosisModalTitle">Record School IT Diagnosis</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="diagnosisForm" is="dmx-serverconnect-form" method="post" action="/api/tickets/diagnosis/create" dmx-on:success="diagnosisModal.hide();ticketDetail.load();workflowNotice.setValue('Diagnosis recorded. Ticket remains Submitted and awaits District approval.');diagnosisForm.reset(true)"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="diagnosisForm.lastError.status" dmx-text="diagnosisForm.lastError.response && diagnosisForm.lastError.response.error ? diagnosisForm.lastError.response.error : 'Diagnosis could not be recorded.'"></div><input type="hidden" name="ticket_id" dmx-bind:value="ticketDetail.data.ticket.id"><label class="form-label" for="diagnosisSummary">Diagnosis Summary</label><textarea id="diagnosisSummary" name="diagnosis_summary" class="form-control" rows="5" maxlength="20000" required></textarea><label class="form-label mt-3" for="recommendedAction">Recommended Action (optional)</label><textarea id="recommendedAction" name="recommended_action" class="form-control" rows="3" maxlength="500"></textarea></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="diagnosisForm.state.executing">Save Diagnosis</button></div></form></div></div></div>
      <div id="clarificationRequestModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="clarificationRequestTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="clarificationRequestTitle">Request Clarification</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="clarificationRequestForm" is="dmx-serverconnect-form" method="post" action="/api/tickets/clarification/request" dmx-on:success="clarificationRequestModal.hide();ticketDetail.load();workflowNotice.setValue('Clarification requested. Ticket moved to Needs Clarification.');clarificationRequestForm.reset(true)"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="clarificationRequestForm.lastError.status" dmx-text="clarificationRequestForm.lastError.response && clarificationRequestForm.lastError.response.error ? clarificationRequestForm.lastError.response.error : 'Clarification could not be requested.'"></div><input type="hidden" name="ticket_id" dmx-bind:value="ticketDetail.data.ticket.id"><label class="form-label" for="clarificationRequestText">What additional information is required?</label><textarea id="clarificationRequestText" name="comment_text" class="form-control" rows="5" maxlength="20000" required></textarea></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="clarificationRequestForm.state.executing">Request Clarification</button></div></form></div></div></div>
      <div id="clarificationResponseModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="clarificationResponseTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="clarificationResponseTitle">Record Clarification Response</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="clarificationResponseForm" is="dmx-serverconnect-form" method="post" action="/api/tickets/clarification/respond" dmx-on:success="clarificationResponseModal.hide();ticketDetail.load();workflowNotice.setValue('Clarification response recorded. A new/current diagnosis is required before District approval.');clarificationResponseForm.reset(true)"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="clarificationResponseForm.lastError.status" dmx-text="clarificationResponseForm.lastError.response && clarificationResponseForm.lastError.response.error ? clarificationResponseForm.lastError.response.error : 'Clarification response could not be recorded.'"></div><input type="hidden" name="ticket_id" dmx-bind:value="ticketDetail.data.ticket.id"><section class="clarification-original-request" dmx-show="ticketDetail.data.latest_clarification_request.comment_text" aria-labelledby="clarificationOriginalRequestTitle"><div class="clarification-original-request-heading"><i class="fas fa-comment-dots" aria-hidden="true"></i><h3 id="clarificationOriginalRequestTitle">Original Clarification Request</h3></div><p class="clarification-original-request-message" dmx-text="ticketDetail.data.latest_clarification_request.comment_text"></p><small class="text-muted" dmx-show="ticketDetail.data.latest_clarification_request.created_at" dmx-text="'Requested ' + ticketDetail.data.latest_clarification_request.created_at.formatDate('MMM d, yyyy, h:mm A')"></small></section><div class="alert alert-light border small mb-3" role="status" dmx-show="!ticketDetail.data.latest_clarification_request.comment_text">No clarification request message was found for this ticket.</div><label class="form-label" for="clarificationResponseText">Clarification Response</label><textarea id="clarificationResponseText" name="comment_text" class="form-control" rows="5" maxlength="20000" required></textarea><p class="small text-muted mt-2 mb-0">Ticket will return to Submitted. School IT must record a new diagnosis before District approval.</p></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="clarificationResponseForm.state.executing">Record Response</button></div></form></div></div></div>
      <div id="approvalModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="approvalTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="approvalTitle">Approve for Pickup</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="approvalForm" is="dmx-serverconnect-form" method="post" action="/api/tickets/approval/approve-pickup" dmx-on:success="approvalModal.hide();ticketDetail.load();workflowNotice.setValue('Ticket approved for pickup. Device lifecycle and custody were not changed.');approvalForm.reset(true)"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="approvalForm.lastError.status" dmx-text="approvalForm.lastError.response && approvalForm.lastError.response.error ? approvalForm.lastError.response.error : 'Ticket approval could not be recorded.'"></div><input type="hidden" name="ticket_id" dmx-bind:value="ticketDetail.data.ticket.id"><dl class="row"><dt class="col-sm-4">Ticket Number</dt><dd class="col-sm-8" dmx-text="ticketDetail.data.ticket.ticket_number"></dd><dt class="col-sm-4">Device</dt><dd class="col-sm-8" dmx-text="ticketDetail.data.device.serial_number"></dd><dt class="col-sm-4">Origin</dt><dd class="col-sm-8" dmx-text="ticketDetail.data.origin.district_name + ' / ' + ticketDetail.data.origin.school_name"></dd><dt class="col-sm-4">Latest Diagnosis</dt><dd class="col-sm-8 text-break" dmx-text="ticketDetail.data.diagnoses.first().diagnosis_summary"></dd><dt class="col-sm-4">Recommended Action</dt><dd class="col-sm-8 text-break" dmx-text="ticketDetail.data.diagnoses.first().recommended_action || 'Not specified'"></dd></dl><label class="form-label" for="approvalNote">Decision Note (optional)</label><textarea id="approvalNote" name="decision_note" class="form-control" rows="3" maxlength="20000"></textarea><p class="small text-muted mt-3 mb-0">Approve this ticket for device pickup? This approval does not move the device or change its lifecycle.</p></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="approvalForm.state.executing">Confirm Approval</button></div></form></div></div></div>
    </main>
  </div>
</div>
