<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="ticketDetailPage" appConnect="local" components="{dmxBootstrap5Modal:{}}" -->
<meta name="ac:route" content="/tickets/detail">
<div class="portal-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context" dmx-on:success="authContext.data.can_temporary_loans_view ? temporaryLoanSummary.load({ticket_id:query.id}, true) : null;authContext.data.can_sla_view ? slaTicketSummary.load({ticket_id:query.id}, true) : null;authContext.data.can_escalations_view ? escalationTicketSummary.load({ticket_id:query.id}, true) : null"></dmx-serverconnect>
  <dmx-serverconnect id="ticketDetail" url="/api/tickets/detail" dmx-param:id="query.id" dmx-on:success="ticketActivity.load({id:ticketDetail.data.ticket.id}, true)"></dmx-serverconnect>
  <dmx-serverconnect id="slaTicketSummary" url="/api/sla/ticket-summary" dmx-param:ticket_id="query.id" noload="true"></dmx-serverconnect>
  <dmx-serverconnect id="escalationTicketSummary" url="/api/escalations/ticket-summary" dmx-param:ticket_id="query.id" noload="true"></dmx-serverconnect>
  <dmx-serverconnect id="ticketActivity" url="/api/tickets/activity" dmx-param:id="query.id"></dmx-serverconnect>
  <dmx-serverconnect id="manufacturerReturnSummary" url="/api/manufacturer-returns/ticket-summary" dmx-param:ticket_id="query.id"></dmx-serverconnect>
  <dmx-serverconnect id="replacementSummary" url="/api/permanent-replacements/ticket-summary" dmx-param:ticket_id="query.id"></dmx-serverconnect>
  <dmx-serverconnect id="temporaryLoanSummary" url="/api/temporary-loans/ticket-summary" noload="true"></dmx-serverconnect>
  <dmx-serverconnect id="assignmentOptions" url="/api/tickets/assignment-options"></dmx-serverconnect>
  <dmx-value id="workflowNotice" value=""></dmx-value>
  <%- await include("partials/portal-sidebar", { currentPage: "tickets" }) %>
  <div class="portal-workspace"><%- await include("partials/portal-topbar", {}) %>
    <main class="portal-main phase8cd-mobile-tables ticket-detail-page" aria-label="Ticket detail">
      <div id="pickupRequestModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="pickupRequestTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="pickupRequestTitle">Request TTPost Pickup</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="pickupRequestForm" is="dmx-serverconnect-form" method="post" action="/api/logistics/request-pickup" dmx-on:success="pickupRequestModal.hide();ticketDetail.load();workflowNotice.setValue('Pickup requested. The ticket status and device custody have not changed.');pickupRequestForm.reset(true)"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="pickupRequestForm.lastError.status" dmx-text="pickupRequestForm.lastError.response && pickupRequestForm.lastError.response.error ? pickupRequestForm.lastError.response.error : 'Pickup request could not be created.'"></div><input type="hidden" name="ticket_id" dmx-bind:value="ticketDetail.data.ticket.id"><dl class="row mb-2"><dt class="col-4">Ticket</dt><dd class="col-8" dmx-text="ticketDetail.data.ticket.ticket_number"></dd><dt class="col-4">Device</dt><dd class="col-8" dmx-text="ticketDetail.data.device.serial_number"></dd><dt class="col-4">Pickup School</dt><dd class="col-8" dmx-text="ticketDetail.data.origin.school_name"></dd></dl><p class="small text-muted mb-0">This will create a TTPost pickup request. It does not transfer physical custody of the device.</p></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="pickupRequestForm.state.executing">Confirm Request</button></div></form></div></div></div>
      <div id="temporaryLoanRequestModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="temporaryLoanRequestTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="temporaryLoanRequestTitle">Request Temporary Spare</h2><button class="btn-close" type="button" dmx-on:click="temporaryLoanRequestModal.hide()" aria-label="Close"></button></div><form id="temporaryLoanRequestForm" is="dmx-serverconnect-form" method="post" action="/api/temporary-loans/request" dmx-on:success="temporaryLoanRequestModal.hide();temporaryLoanRequestForm.reset(true);temporaryLoanSummary.load({ticket_id:query.id}, true);ticketActivity.load({id:query.id}, true);workflowNotice.setValue('Temporary spare request submitted for District authorization.')"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="temporaryLoanRequestForm.lastError.status" dmx-text="temporaryLoanRequestForm.lastError.response && temporaryLoanRequestForm.lastError.response.error ? temporaryLoanRequestForm.lastError.response.error : 'Temporary spare request could not be submitted.'"></div><input type="hidden" name="ticket_id" dmx-bind:value="ticketDetail.data.ticket.id"><p><strong dmx-text="ticketDetail.data.ticket.ticket_number"></strong> · <span dmx-text="ticketDetail.data.device.asset_tag || ticketDetail.data.device.serial_number"></span></p><label class="form-label" for="temporaryLoanNotes">Request note (optional)</label><textarea id="temporaryLoanNotes" name="request_notes" class="form-control" rows="3" maxlength="1000"></textarea><p class="small text-muted mt-2 mb-0">The request does not select or issue a spare device.</p></div><div class="modal-footer"><button type="button" class="btn btn-bmobile-secondary" dmx-on:click="temporaryLoanRequestModal.hide()">Cancel</button><button type="submit" class="btn btn-bmobile-primary" dmx-bind:disabled="temporaryLoanRequestForm.state.executing">Submit Request</button></div></form></div></div></div>
      <div class="text-muted py-3" role="status" dmx-show="ticketDetail.state.executing">Loading ticket...</div>
      <div class="alert alert-danger" role="alert" dmx-show="ticketDetail.lastError.status" dmx-text="ticketDetail.lastError.response && ticketDetail.lastError.response.error ? ticketDetail.lastError.response.error : 'Ticket could not be loaded.'"></div>
      <div class="alert alert-success" role="status" dmx-show="workflowNotice.value" dmx-text="workflowNotice.value"></div>
      <div class="ticket-detail-record" dmx-show="ticketDetail.data.ticket">
        <section class="ticket-detail-hero" aria-labelledby="ticketDetailPageTitle">
          <div class="ticket-detail-hero-copy">
            <nav class="ticket-detail-breadcrumb" aria-label="Breadcrumb"><ol><li><a href="/tickets">Tickets</a></li><li aria-current="page">Ticket Detail</li></ol></nav>
            <h1 id="ticketDetailPageTitle">Ticket Detail</h1>
            <p>View ticket information, SLA tracking, diagnostics, clarification, approvals and activity in one place.</p>
          </div>
        </section>
        <div class="ticket-detail-toolbar">
          <div><div><p class="text-muted mb-1">Ticket Number</p><h1 class="h3 mb-0" dmx-text="ticketDetail.data.ticket.ticket_number"></h1></div></div>

          <div class="d-flex flex-wrap align-items-center gap-2"><span class="badge text-bg-light" dmx-text="ticketDetail.data.current_status.name"></span>
            <button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-show="authContext.data.can_tickets_assign && !ticketDetail.data.current_assignment.assignment_id && (ticketDetail.data.current_status.code == 'SUBMITTED' || ticketDetail.data.current_status.code == 'NEEDS_CLARIFICATION' || ticketDetail.data.current_status.code == 'APPROVED_FOR_PICKUP')" dmx-on:click="assignmentOptions.load({ticket_id:ticketDetail.data.ticket.id}, true);assignModal.show()">Assign Technician</button>
            <button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-show="authContext.data.can_tickets_assign && ticketDetail.data.current_assignment.assignment_id && (ticketDetail.data.current_status.code == 'SUBMITTED' || ticketDetail.data.current_status.code == 'NEEDS_CLARIFICATION' || ticketDetail.data.current_status.code == 'APPROVED_FOR_PICKUP')" dmx-on:click="assignmentOptions.load({ticket_id:ticketDetail.data.ticket.id}, true);reassignModal.show()">Reassign</button>
            <button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-show="authContext.data.can_tickets_assign && ticketDetail.data.current_assignment.assignment_id && (ticketDetail.data.current_status.code == 'SUBMITTED' || ticketDetail.data.current_status.code == 'NEEDS_CLARIFICATION' || ticketDetail.data.current_status.code == 'APPROVED_FOR_PICKUP')" dmx-on:click="releaseModal.show()">Release to Queue</button>
            <button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-show="authContext.data.can_tickets_claim && !ticketDetail.data.current_assignment.assignment_id && (ticketDetail.data.current_status.code == 'SUBMITTED' || ticketDetail.data.current_status.code == 'NEEDS_CLARIFICATION' || ticketDetail.data.current_status.code == 'APPROVED_FOR_PICKUP')" dmx-on:click="claimModal.show()">Claim Ticket</button>
            <button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-show="authContext.data.can_tickets_clarification_request && ticketDetail.data.current_status.code == 'SUBMITTED'" dmx-on:click="clarificationRequestModal.show()">Request Clarification</button>
            <button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-show="authContext.data.can_tickets_clarification_respond && ticketDetail.data.current_status.code == 'NEEDS_CLARIFICATION'" dmx-on:click="clarificationResponseModal.show()">Record Clarification Response</button>
            <button class="btn btn-bmobile-primary btn-sm" type="button" dmx-show="authContext.data.can_tickets_approve_pickup && ticketDetail.data.current_status.code == 'SUBMITTED' && ticketDetail.data.has_current_diagnosis" dmx-on:click="approvalModal.show()">Approve for Pickup</button>
            <span class="small text-muted" dmx-show="authContext.data.can_tickets_approve_pickup && ticketDetail.data.current_status.code == 'SUBMITTED' && !ticketDetail.data.has_current_diagnosis">Diagnosis Required</span>
            <a class="btn ticket-detail-sla-link" dmx-show="authContext.data.can_sla_view" href="/sla"><i class="fas fa-chart-bar me-1" aria-hidden="true"></i>SLA Tracking</a>
          </div>
        </div>

        <div class="ticket-detail-case-grid" dmx-class:has-permanent-conversion="ticketDetail.data.active_logistics_case.device_source == 'TEMPORARY_LOAN_CONVERSION'">
        <div class="ticket-detail-overview" dmx-class:has-permanent-conversion="ticketDetail.data.active_logistics_case.device_source == 'TEMPORARY_LOAN_CONVERSION'">
        <section class="portal-section mb-3 ticket-detail-summary-card ticket-detail-summary-replacement" dmx-show="authContext.data.can_replacements_view && replacementSummary.data.summary.replacement_case_id"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2"><div><h2 class="h5 mb-1">Permanent Replacement</h2><p class="mb-0"><span dmx-text="replacementSummary.data.summary.replacement_number"></span> · <span dmx-text="replacementSummary.data.summary.replacement_status_name"></span></p><small class="text-muted" dmx-text="replacementSummary.data.summary.replacement_source_type || 'Source selection pending'"></small></div><a class="btn btn-bmobile-secondary btn-sm" dmx-bind:href="'/permanent-replacements/detail?id=' + replacementSummary.data.summary.replacement_case_id">Open Permanent Replacement</a></div></section>
        <section class="portal-section mb-3 ticket-detail-summary-card ticket-detail-summary-loan" dmx-show="authContext.data.can_temporary_loans_view && (temporaryLoanSummary.data.summary.temporary_loan_case_id || (authContext.data.can_temporary_loans_request && temporaryLoanSummary.data.eligibility.can_request))"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2"><div><h2 class="h5 mb-1">Temporary Loan</h2><p class="mb-0" dmx-show="temporaryLoanSummary.data.summary.temporary_loan_case_id"><span dmx-text="temporaryLoanSummary.data.summary.loan_number"></span> · <span dmx-text="temporaryLoanSummary.data.summary.current_status_code == 'CONVERTED_PERMANENT' ? 'Completed' : temporaryLoanSummary.data.summary.loan_status_name"></span></p><p class="mb-0 text-muted" dmx-show="!temporaryLoanSummary.data.summary.temporary_loan_case_id">No temporary loan requested.</p></div><div class="ticket-detail-loan-actions"><a class="btn btn-bmobile-secondary btn-sm" dmx-show="temporaryLoanSummary.data.summary.temporary_loan_case_id" dmx-bind:href="'/temporary-loans/detail?id=' + temporaryLoanSummary.data.summary.temporary_loan_case_id">Open Temporary Loan</a><button type="button" class="btn btn-bmobile-primary btn-sm" dmx-show="authContext.data.can_temporary_loans_request && temporaryLoanSummary.data.eligibility.can_request && temporaryLoanSummary.data.summary.current_status_code != 'PENDING_DISTRICT_APPROVAL' && temporaryLoanSummary.data.summary.current_status_code != 'AUTHORIZED'" dmx-on:click="temporaryLoanRequestModal.show()">Request Temporary Spare</button></div></div><p class="small mt-2 mb-0" dmx-show="temporaryLoanSummary.data.summary.current_status_code == 'RETURN_REQUIRED'">Temporary spare <span dmx-text="temporaryLoanSummary.data.summary.selected_spare_asset_tag || temporaryLoanSummary.data.summary.selected_spare_serial_number"></span> is outstanding and has not been received by the Repair Centre.</p><p class="small mt-2 mb-0" dmx-show="temporaryLoanSummary.data.summary.current_status_code == 'RETURNED'">Temporary loan closed. Spare <span dmx-text="temporaryLoanSummary.data.summary.selected_spare_asset_tag || temporaryLoanSummary.data.summary.selected_spare_serial_number"></span> returned to Repair Centre stock on <span dmx-text="temporaryLoanSummary.data.summary.returned_at.formatDate('MMM d, yyyy, h:mm A')"></span>. This is not a permanent educational-device replacement.</p><p class="small mt-2 mb-0" dmx-show="temporaryLoanSummary.data.summary.current_status_code == 'CONVERTED_PERMANENT'">Temporary loan completed as permanent replacement <span dmx-text="temporaryLoanSummary.data.summary.permanent_replacement_number"></span>; no return is required. This loan remains available as read-only history.</p><section class="portal-section mb-3 ticket-detail-lifecycle ticket-detail-handoff" dmx-show="ticketDetail.data.active_logistics_case.physical_state_code == 'PENDING_REPAIR_CENTRE_RECEIPT' || ticketDetail.data.active_logistics_case.physical_state_code == 'REPAIR_CENTRE_CUSTODY'" dmx-class:handoff-confirmed="ticketDetail.data.active_logistics_case.physical_state_code == 'REPAIR_CENTRE_CUSTODY'"><h2 class="h5">Repair Centre Handoff</h2><p class="alert alert-warning py-2" dmx-show="ticketDetail.data.active_logistics_case.physical_state_code == 'PENDING_REPAIR_CENTRE_RECEIPT'">TTPost dispatched the device. The Repair Centre must independently confirm receipt; ticket status remains In Transit.</p><p class="alert alert-success py-2" dmx-show="ticketDetail.data.active_logistics_case.physical_state_code == 'REPAIR_CENTRE_CUSTODY'">Repair Centre receipt is confirmed. Ticket is Under Repair; allocation and work ownership remain unchanged.</p></section></section>
        <section class="portal-section mb-3 ticket-detail-summary-card ticket-detail-summary-device" dmx-show="ticketDetail.data.active_logistics_case.device_source == 'TEMPORARY_LOAN_CONVERSION'"><h2 class="h5">Permanent Device With Recipient</h2><dl class="row mb-0"><dt class="col-sm-3">Original Device</dt><dd class="col-sm-9" dmx-text="ticketDetail.data.active_logistics_case.original_serial_number"></dd><dt class="col-sm-3">Current Permanent Device</dt><dd class="col-sm-9" dmx-text="ticketDetail.data.active_logistics_case.serial_number"></dd><dt class="col-sm-3">Source</dt><dd class="col-sm-9">Temporary Loan Conversion</dd><dt class="col-sm-3">Temporary Loan</dt><dd class="col-sm-9" dmx-text="'TL #' + ticketDetail.data.active_logistics_case.temporary_loan_case_id"></dd><dt class="col-sm-3">Permanent Replacement</dt><dd class="col-sm-9" dmx-text="ticketDetail.data.active_logistics_case.replacement_number"></dd><dt class="col-sm-3">Ticket / Service Logistics</dt><dd class="col-sm-9" dmx-text="ticketDetail.data.current_status.code + ' / ' + ticketDetail.data.active_logistics_case.current_logistics_status_code"></dd><dt class="col-sm-3">Physical Custody</dt><dd class="col-sm-9">With Recipient</dd></dl></section>
        <section class="portal-section mb-3 ticket-detail-summary-card ticket-detail-summary-exception" dmx-show="ticketDetail.data.exception_summary.exception_case_id"><h2 class="h5">Exception Disposition</h2><p class="mb-2" dmx-text="ticketDetail.data.exception_summary.current_status_code == 'ASSESSMENT_REQUIRED' ? 'Exception Review Required' : ticketDetail.data.exception_summary.current_status_code == 'PENDING_DISTRICT_APPROVAL' ? 'Pending District Approval' : ticketDetail.data.exception_summary.current_status_code == 'PENDING_DISTRICT_DECISION' ? 'Pending District Decision' : ticketDetail.data.exception_summary.current_status_code == 'PENDING_HEAD_OFFICE_APPROVAL' ? 'Pending Head Office Approval' : ticketDetail.data.exception_summary.current_status_code == 'MANUFACTURER_RETURN_APPROVED' ? 'Manufacturer Return Approved' : ticketDetail.data.exception_summary.current_status_code == 'REPLACEMENT_APPROVED' ? 'Permanent Replacement Approved' : ticketDetail.data.exception_summary.current_status_code == 'PERMANENT_REPLACEMENT_COMPLETED' ? 'Permanent Replacement Completed' : 'Repair Centre Review Required'"></p><a class="btn btn-bmobile-secondary btn-sm" dmx-show="authContext.data.can_exceptions_view" dmx-bind:href="'/exceptions/detail?id=' + ticketDetail.data.exception_summary.exception_case_id">Open Exception</a></section>
<section class="portal-section mb-3 ticket-detail-lifecycle ticket-detail-repair" dmx-show="ticketDetail.data.repair_summary.repair_state"><h2 class="h5">Repair</h2><dl class="row mb-2"><dt class="col-sm-3">Repair Centre</dt><dd class="col-sm-9" dmx-text="ticketDetail.data.repair_summary.repair_centre_location_name"></dd><dt class="col-sm-3">Repair State</dt><dd class="col-sm-9" dmx-text="ticketDetail.data.repair_summary.repair_state == 'AWAITING_REPAIR_START' ? 'Awaiting Repair Start' : ticketDetail.data.repair_summary.repair_state == 'IN_PROGRESS' ? 'In Progress' : ticketDetail.data.repair_summary.repair_state == 'READY_FOR_RETURN' ? 'Ready for Return' : 'Disposition Recorded'"></dd><dt class="col-sm-3">Started</dt><dd class="col-sm-9" dmx-text="ticketDetail.data.repair_summary.started_at ? ticketDetail.data.repair_summary.started_at.formatDate('MMMM d, yyyy, h:mm A') : 'Not started'"></dd><dt class="col-sm-3" dmx-show="ticketDetail.data.repair_summary.completed_at">Completed</dt><dd class="col-sm-9" dmx-show="ticketDetail.data.repair_summary.completed_at" dmx-text="ticketDetail.data.repair_summary.completed_at.formatDate('MMMM d, yyyy, h:mm A')"></dd><dt class="col-sm-3" dmx-show="ticketDetail.data.repair_summary.outcome_name">Outcome</dt><dd class="col-sm-9" dmx-show="ticketDetail.data.repair_summary.outcome_name" dmx-text="ticketDetail.data.repair_summary.outcome_name"></dd></dl><p class="alert alert-success py-2 mb-0" dmx-show="ticketDetail.data.repair_summary.repair_state == 'READY_FOR_RETURN'">Repair processing complete — awaiting return logistics.</p><p class="alert alert-warning py-2 mb-0" dmx-show="ticketDetail.data.repair_summary.repair_state == 'DISPOSITION_RECORDED'">Downstream disposition workflow required.</p></section>
        </div>
        <div class="ticket-detail-support-grid">
          <div class="ticket-detail-support-stack">
        <section class="portal-section mb-3 ticket-detail-manufacturer" dmx-show="manufacturerReturnSummary.data.summary.manufacturer_return_case_id"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2"><div><h2 class="h5 mb-1">Manufacturer Return</h2><p class="mb-0"><span dmx-text="manufacturerReturnSummary.data.summary.manufacturer_return_number"></span> · <span dmx-text="manufacturerReturnSummary.data.summary.manufacturer_name"></span> · <span dmx-text="manufacturerReturnSummary.data.summary.manufacturer_return_status_name"></span></p><small class="text-muted" dmx-text="manufacturerReturnSummary.data.summary.physical_custody_code"></small></div><a class="btn btn-bmobile-secondary btn-sm" dmx-show="authContext.data.can_manufacturer_returns_view" dmx-bind:href="'/manufacturer-returns/detail?id=' + manufacturerReturnSummary.data.summary.manufacturer_return_case_id">Open Manufacturer Return</a></div></section>
        <section class="portal-section mb-3 ticket-detail-escalations" dmx-show="authContext.data.can_escalations_view && escalationTicketSummary.data.escalations.length"><div class="d-flex justify-content-between align-items-center mb-2"><h2 class="h5 mb-0">Escalation Summary</h2><a class="btn btn-bmobile-secondary btn-sm" href="/escalations">Escalation Queue</a></div><div class="table-responsive"><table class="table portal-table align-middle"><thead><tr><th>Reference</th><th>State</th><th>Level</th><th>Trigger</th><th>Owner</th><th>Opened</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="escalationTicketSummary.data.escalations"><tr><td dmx-text="escalation_number"></td><td dmx-text="current_state_name"></td><td dmx-text="current_level"></td><td dmx-text="current_trigger"></td><td dmx-text="responsible_roles"></td><td class="text-nowrap" dmx-text="opened_at.formatDate('MMM d, yyyy HH:mm')"></td></tr></tbody></table></div></section>
        <section class="portal-section mb-3 ticket-detail-lifecycle ticket-detail-identity" dmx-show="ticketDetail.data.active_logistics_case.device_source == 'PERMANENT_REPLACEMENT'"><h2 class="h5">Device Identity</h2><dl class="row mb-0"><dt class="col-sm-3">Original Device</dt><dd class="col-sm-9"><span dmx-text="ticketDetail.data.device.asset_tag || ticketDetail.data.device.serial_number"></span> · Replaced</dd><dt class="col-sm-3">Current Replacement Device</dt><dd class="col-sm-9" dmx-text="ticketDetail.data.active_logistics_case.asset_tag || ticketDetail.data.active_logistics_case.serial_number"></dd><dt class="col-sm-3">Permanent Replacement</dt><dd class="col-sm-9" dmx-text="ticketDetail.data.active_logistics_case.replacement_number"></dd><dt class="col-sm-3">Physical Custody</dt><dd class="col-sm-9" dmx-text="ticketDetail.data.active_logistics_case.physical_state_code == 'TTPOST_RETURN_CUSTODY' ? 'TTPost Return Custody' : ticketDetail.data.active_logistics_case.physical_state_code == 'PENDING_TTPOST_RETURN_RECEIPT' ? 'Awaiting TTPost Receipt' : ticketDetail.data.active_logistics_case.physical_state_code == 'PENDING_SCHOOL_RETURN_RECEIPT' ? 'Awaiting School Receipt' : ticketDetail.data.active_logistics_case.return_state_code == 'RETURNED_TO_SCHOOL' ? 'Returned to School' : 'Ready at Repair Centre'"></dd><dt class="col-sm-3">Replacement Lifecycle</dt><dd class="col-sm-9" dmx-text="ticketDetail.data.active_logistics_case.device_lifecycle_name"></dd></dl></section>
        
        
          </div>
          <div class="ticket-detail-support-alerts">
        <div class="alert alert-warning" role="status" dmx-show="ticketDetail.data.current_status.code == 'SUBMITTED' && !ticketDetail.data.has_current_diagnosis"><strong>Diagnosis Required</strong><br>A new diagnosis is required following the latest clarification response before this ticket can be approved for pickup.</div>
        <div class="alert alert-info" role="status" dmx-show="ticketDetail.data.current_status.code == 'SUBMITTED' && ticketDetail.data.has_current_diagnosis"><strong>Awaiting District Approval</strong><br>A current diagnosis has been recorded. This ticket is ready for District review.</div>
        <div class="alert alert-secondary" role="status" dmx-show="ticketDetail.data.current_status.code == 'NEEDS_CLARIFICATION'"><strong>Awaiting Clarification</strong><br>School IT clarification is required before the ticket can proceed.</div>
        <div class="alert alert-success" role="status" dmx-show="ticketDetail.data.current_status.code == 'APPROVED_FOR_PICKUP'"><strong>Approved for Pickup</strong></div>
          </div>
        </div>
        </div>
        <div class="ticket-detail-columns">
          <div class="ticket-detail-column ticket-detail-column-device">
