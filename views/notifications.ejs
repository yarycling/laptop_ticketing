<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="notificationCenter" appConnect="local" components="{dmxBootstrap5Modal:{}}" -->
<meta name="ac:route" content="/notifications">
<div class="portal-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context"></dmx-serverconnect>
  <dmx-serverconnect id="notificationList" url="/api/notifications/list" dmx-param:status="notificationStatusFilter.value" dmx-param:severity="notificationSeverityFilter.value" dmx-param:event_type="notificationTypeFilter.value" dmx-param:search="notificationSearch.value"></dmx-serverconnect>
  <dmx-serverconnect id="notificationDetail" url="/api/notifications/detail" noload="true"></dmx-serverconnect>
  <dmx-value id="notificationChartsVisible" value="true"></dmx-value>
  <%- await include("partials/portal-sidebar", { currentPage: "notifications" }) %>
  <div class="portal-workspace"><%- await include("partials/portal-topbar", { pageTitle: "Notifications" }) %>
    <main class="portal-main" aria-label="Notifications">
      <section class="portal-section monitoring-page">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
          <div class="monitoring-heading"><span class="monitoring-heading-icon"><i class="fas fa-bell" aria-hidden="true"></i></span><div><div class="monitoring-eyebrow">MONITORING &amp; REPORTS</div><h1 class="h3 mb-1">Notification Center</h1><p class="text-muted mb-0">Notifications addressed to your account.</p></div></div>
          <div class="d-flex flex-wrap gap-2">
            <form is="dmx-serverconnect-form" method="post" action="/api/notifications/mark-all-read" dmx-show="authContext.data.can_notifications_respond" dmx-on:success="notificationList.load({status:notificationStatusFilter.value,severity:notificationSeverityFilter.value,event_type:notificationTypeFilter.value,search:notificationSearch.value}, true)">
              <button class="btn btn-bmobile-secondary" type="submit" dmx-bind:disabled="notificationList.data.notifications.length == 0">Mark all read</button>
            </form>
            <form is="dmx-serverconnect-form" method="post" action="/api/admin/notifications/test" dmx-show="authContext.data.can_notifications_manage" dmx-on:success="notificationList.load({status:notificationStatusFilter.value,severity:notificationSeverityFilter.value,event_type:notificationTypeFilter.value,search:notificationSearch.value}, true)">
              <input type="hidden" name="recipient_username" value="portal.admin"><input type="hidden" name="fixture_slot" value="GUI">
              <button class="btn btn-bmobile-secondary" type="submit">Create test notification</button>
            </form>
          </div>
        </div>
        <div class="alert alert-danger" role="alert" dmx-show="notificationList.lastError.status || notificationDetail.lastError.status" dmx-text="notificationList.lastError.response && notificationList.lastError.response.error ? notificationList.lastError.response.error : 'Notifications could not be loaded.'"></div>
        <div class="logistics-stats mb-3"><article class="logistics-stat-card"><div class="logistics-stat-icon"><i class="fas fa-inbox" aria-hidden="true"></i></div><div class="logistics-stat-copy"><span>Loaded notifications</span><strong dmx-text="notificationList.data.notifications.count() || 0"></strong><small>Latest 100 matching items</small></div></article><article class="logistics-stat-card"><div class="logistics-stat-icon logistics-stat-icon-box"><i class="fas fa-envelope-open" aria-hidden="true"></i></div><div class="logistics-stat-copy"><span>Unread</span><strong dmx-text="notificationList.data.notifications.where('read_state', '==', 0).count()"></strong><small>In the loaded results</small></div></article><article class="logistics-stat-card"><div class="logistics-stat-icon logistics-stat-icon-repair"><i class="fas fa-exclamation-circle" aria-hidden="true"></i></div><div class="logistics-stat-copy"><span>Critical</span><strong dmx-text="notificationList.data.notifications.where('severity_code', '==', 'CRITICAL').count()"></strong><small>In the loaded results</small></div></article></div>
        <section class="monitoring-filter-card mb-3" aria-label="Notification filters"><div class="row g-3 align-items-end">
          <div class="col-sm-4 col-lg-2"><label class="form-label" for="notificationStatusFilter">Read status</label><select id="notificationStatusFilter" class="form-select" dmx-on:change="notificationList.load({status:notificationStatusFilter.value,severity:notificationSeverityFilter.value,event_type:notificationTypeFilter.value,search:notificationSearch.value}, true)"><option value="ALL">All</option><option value="UNREAD">Unread</option><option value="READ">Read</option></select></div>
          <div class="col-sm-4 col-lg-2"><label class="form-label" for="notificationSeverityFilter">Severity</label><select id="notificationSeverityFilter" class="form-select" dmx-on:change="notificationList.load({status:notificationStatusFilter.value,severity:notificationSeverityFilter.value,event_type:notificationTypeFilter.value,search:notificationSearch.value}, true)"><option value="ALL">All severities</option><option value="INFO">Information</option><option value="SUCCESS">Success</option><option value="WARNING">Warning</option><option value="CRITICAL">Critical</option></select></div>
          <div class="col-sm-4 col-lg-2"><label class="form-label" for="notificationTypeFilter">Event type</label><select id="notificationTypeFilter" class="form-select" dmx-on:change="notificationList.load({status:notificationStatusFilter.value,severity:notificationSeverityFilter.value,event_type:notificationTypeFilter.value,search:notificationSearch.value}, true)"><option value="ALL">All event types</option><option value="SLA_AT_RISK">SLA at risk</option><option value="SLA_BREACHED">SLA breached</option><option value="ESCALATION_RESOLVED">Escalation resolved</option><option value="ESCALATION_CANCELLED">Escalation cancelled</option><option value="TICKET_SUBMITTED">Ticket submitted</option><option value="TICKET_CLARIFICATION_REQUESTED">Clarification requested</option><option value="TICKET_APPROVED_FOR_PICKUP">Pickup approved</option><option value="DISTRICT_APPROVAL_REQUIRED">District approval required</option><option value="DISTRICT_REPAIR_DECISION_REQUIRED">District decision required</option><option value="HEAD_OFFICE_REPLACEMENT_APPROVAL_REQUIRED">Head Office approval required</option><option value="LOGISTICS_PICKUP_REQUESTED">Pickup requested</option><option value="LOGISTICS_SCHOOL_RELEASED">School released device</option><option value="LOGISTICS_SENT_TO_REPAIR_CENTRE">Sent to Repair Centre</option><option value="LOGISTICS_RECEIVED_BY_REPAIR_CENTRE">Received by Repair Centre</option><option value="LOGISTICS_RECEIVED_BY_TTPOST">Received by TTPost</option><option value="LOGISTICS_READY_FOR_RETURN_PICKUP">Ready for return pickup</option><option value="LOGISTICS_RETURN_RECEIVED_BY_TTPOST">Return received by TTPost</option><option value="LOGISTICS_RETURN_IN_TRANSIT_TO_SCHOOL">Return in transit to school</option><option value="LOGISTICS_RETURNED_TO_SCHOOL">Returned to school</option><option value="REPAIR_STARTED">Repair started</option><option value="REPAIR_COMPLETED">Repair completed</option></select></div>
          <div class="col-sm-8 col-lg-4"><label class="form-label" for="notificationSearch">Search</label><input id="notificationSearch" class="form-control" type="search" placeholder="Search notifications" dmx-on:input="notificationList.load({status:notificationStatusFilter.value,severity:notificationSeverityFilter.value,event_type:notificationTypeFilter.value,search:notificationSearch.value}, true)"></div>
          <div class="col-sm-4 col-lg-2"><div class="form-check form-switch monitoring-switch"><input class="form-check-input" type="checkbox" role="switch" id="unreadOnlySwitch" dmx-bind:checked="notificationStatusFilter.value == 'UNREAD'" dmx-on:change="notificationStatusFilter.setValue(unreadOnlySwitch.checked ? 'UNREAD' : 'ALL');notificationList.load({status:unreadOnlySwitch.checked ? 'UNREAD' : 'ALL',severity:notificationSeverityFilter.value,event_type:notificationTypeFilter.value,search:notificationSearch.value}, true)"><label class="form-check-label" for="unreadOnlySwitch">Unread only</label></div></div>
          <div class="col-sm-4 col-lg-2"><div class="form-check form-switch monitoring-switch"><input class="form-check-input" type="checkbox" role="switch" id="notificationChartsSwitch" dmx-bind:checked="notificationChartsVisible.value" dmx-on:change="notificationChartsVisible.setValue(notificationChartsSwitch.checked)"><label class="form-check-label" for="notificationChartsSwitch">Show chart</label></div></div>
          <div class="col-12 d-flex justify-content-end"><button type="button" class="btn btn-bmobile-secondary btn-sm" dmx-on:click="notificationStatusFilter.setValue('ALL');notificationSeverityFilter.setValue('ALL');notificationTypeFilter.setValue('ALL');notificationSearch.setValue('');notificationList.load({status:'ALL',severity:'ALL',event_type:'ALL',search:''}, true)">Clear filters</button></div>
        </div></section>
        <div class="monitoring-card mb-3" dmx-show="notificationChartsVisible.value"><div class="monitoring-card-heading"><div><h2 class="h6 mb-1">Visible notification mix</h2><p class="small text-muted mb-0">Counts reflect the latest 100 matching notifications.</p></div></div><div class="monitoring-chart-grid">
          <div class="monitoring-chart-row"><span>Unread</span><progress max="100" dmx-bind:value="notificationList.data.notifications.where('read_state', '==', 0).count()"></progress><strong dmx-text="notificationList.data.notifications.where('read_state', '==', 0).count()"></strong></div>
          <div class="monitoring-chart-row"><span>Critical</span><progress class="monitoring-progress-danger" max="100" dmx-bind:value="notificationList.data.notifications.where('severity_code', '==', 'CRITICAL').count()"></progress><strong dmx-text="notificationList.data.notifications.where('severity_code', '==', 'CRITICAL').count()"></strong></div>
          <div class="monitoring-chart-row"><span>Warning</span><progress class="monitoring-progress-warning" max="100" dmx-bind:value="notificationList.data.notifications.where('severity_code', '==', 'WARNING').count()"></progress><strong dmx-text="notificationList.data.notifications.where('severity_code', '==', 'WARNING').count()"></strong></div>
        </div></div>
        <div class="text-muted py-3" role="status" dmx-show="notificationList.state.executing">Loading notifications...</div>
        <div class="table-responsive portal-table-wrapper"><table class="table portal-table align-middle">
          <thead><tr><th>Status</th><th>Severity</th><th>Notification</th><th>Related</th><th>Received</th><th>Action</th></tr></thead>
          <tbody is="dmx-repeat" dmx-bind:repeat="notificationList.data.notifications">
            <tr><td><span class="badge" dmx-class:text-bg-primary="read_state == 0" dmx-class:text-bg-secondary="read_state == 1" dmx-text="read_state == 1 ? 'Read' : 'Unread'"></span></td><td dmx-text="severity_name"></td><td><button type="button" class="btn btn-link p-0 text-start fw-semibold" dmx-on:click="notificationDetail.load({id:$value.recipient_id}, true);notificationDetailModal.show()" dmx-text="title"></button><div class="small text-muted" dmx-text="message"></div></td><td><a dmx-show="escalation_case_id" href="/escalations" dmx-text="escalation_number + ' · Level ' + escalation_level">View escalation</a><a class="ms-2" dmx-show="action_type == 'LOGISTICS_DETAIL' && authContext.data.can_logistics_view" dmx-bind:href="'/logistics/detail?id=' + action_reference" dmx-text="logistics_number || ('Logistics ' + logistics_case_id)"></a><a class="ms-2" dmx-show="action_type == 'REPAIR_DETAIL' && authContext.data.can_repairs_view" dmx-bind:href="'/repairs/detail?id=' + (repair_job_id || action_reference)" dmx-text="'Repair ' + repair_job_id"></a><a class="ms-2" dmx-show="action_type == 'EXCEPTION_DETAIL' && authContext.data.can_exceptions_view" dmx-bind:href="'/exceptions/detail?id=' + action_reference">Open exception</a><a class="ms-2" dmx-show="ticket_id && authContext.data.can_tickets_view" dmx-bind:href="'/tickets/detail?id=' + ticket_id" dmx-text="ticket_number || ('Ticket ' + ticket_id)"></a><span class="ms-2" dmx-show="ticket_id && !authContext.data.can_tickets_view" dmx-text="ticket_number || ('Ticket ' + ticket_id)"></span><span dmx-show="!ticket_id && !escalation_case_id" dmx-text="source_type || '-' "></span><div class="small text-muted" dmx-text="school_name ? school_name + (district_name ? ' · ' + district_name : '') : (logistics_number || serial_number || asset_tag || '')"></div></td><td class="text-nowrap" dmx-text="created_at_display"></td><td class="text-nowrap"><button type="button" class="btn btn-sm btn-bmobile-secondary" dmx-show="read_state == 0 && authContext.data.can_notifications_respond" dmx-on:click="notificationDetail.load({id:$value.recipient_id}, true);notificationDetailModal.show()">Mark read</button><button type="button" class="btn btn-sm btn-bmobile-secondary" dmx-show="read_state == 1 && authContext.data.can_notifications_respond" dmx-on:click="notificationDetail.load({id:$value.recipient_id}, true);notificationDetailModal.show()">Mark unread</button></td></tr>
          </tbody>
        </table></div>
        <p class="text-muted mb-0" dmx-show="notificationList.data.notifications.length == 0 && !notificationList.state.executing">No notifications match these filters.</p>
      </section>
        <div id="notificationDetailModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="notificationDetailTitle" aria-hidden="true">
          <div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content portal-modal">
            <div class="modal-header"><h2 class="modal-title h5" id="notificationDetailTitle" dmx-text="notificationDetail.data.notification.title"></h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body">
              <dl class="row mb-0">
                <dt class="col-sm-3">Severity</dt><dd class="col-sm-9" dmx-text="notificationDetail.data.notification.severity_name"></dd>
                <dt class="col-sm-3">Type</dt><dd class="col-sm-9" dmx-text="notificationDetail.data.notification.event_type_name"></dd>
                <dt class="col-sm-3">Received</dt><dd class="col-sm-9" dmx-text="notificationDetail.data.notification.created_at_display"></dd>
                <dt class="col-sm-3">Read status</dt><dd class="col-sm-9" dmx-text="notificationDetail.data.notification.read_at ? 'Read' : 'Unread'"></dd>
                <dt class="col-sm-3">Message</dt><dd class="col-sm-9 text-break" dmx-text="notificationDetail.data.notification.message"></dd>
                <dt class="col-sm-3" dmx-show="notificationDetail.data.notification.ticket_id">Ticket</dt>
                <dd class="col-sm-9" dmx-show="notificationDetail.data.notification.ticket_id && authContext.data.can_tickets_view"><a dmx-bind:href="'/tickets/detail?id=' + notificationDetail.data.notification.ticket_id" dmx-text="notificationDetail.data.notification.ticket_number"></a></dd>
                <dd class="col-sm-9" dmx-show="notificationDetail.data.notification.ticket_id && !authContext.data.can_tickets_view" dmx-text="notificationDetail.data.notification.ticket_number"></dd>
                <dt class="col-sm-3" dmx-show="notificationDetail.data.notification.school_name">School</dt><dd class="col-sm-9" dmx-show="notificationDetail.data.notification.school_name" dmx-text="notificationDetail.data.notification.school_name"></dd>
                <dt class="col-sm-3" dmx-show="notificationDetail.data.notification.district_name">District</dt><dd class="col-sm-9" dmx-show="notificationDetail.data.notification.district_name" dmx-text="notificationDetail.data.notification.district_name"></dd>
                <dt class="col-sm-3" dmx-show="notificationDetail.data.notification.serial_number || notificationDetail.data.notification.asset_tag">Device</dt><dd class="col-sm-9" dmx-show="notificationDetail.data.notification.serial_number || notificationDetail.data.notification.asset_tag" dmx-text="(notificationDetail.data.notification.serial_number || '') + (notificationDetail.data.notification.asset_tag ? ' · ' + notificationDetail.data.notification.asset_tag : '')"></dd>
                <dt class="col-sm-3" dmx-show="notificationDetail.data.notification.logistics_case_id">Logistics</dt><dd class="col-sm-9" dmx-show="notificationDetail.data.notification.logistics_case_id && authContext.data.can_logistics_view"><a dmx-bind:href="'/logistics/detail?id=' + notificationDetail.data.notification.logistics_case_id" dmx-text="notificationDetail.data.notification.logistics_number || ('Logistics ' + notificationDetail.data.notification.logistics_case_id)"></a></dd>
                <dd class="col-sm-9" dmx-show="notificationDetail.data.notification.logistics_case_id && !authContext.data.can_logistics_view" dmx-text="notificationDetail.data.notification.logistics_number"></dd>
                <dt class="col-sm-3" dmx-show="notificationDetail.data.notification.handoff_type">Handoff</dt><dd class="col-sm-9" dmx-show="notificationDetail.data.notification.handoff_type" dmx-text="notificationDetail.data.notification.handoff_type"></dd>
                <dt class="col-sm-3" dmx-show="notificationDetail.data.notification.repair_job_id">Repair job</dt><dd class="col-sm-9" dmx-show="notificationDetail.data.notification.repair_job_id && authContext.data.can_repairs_view"><a dmx-bind:href="'/repairs/detail?id=' + notificationDetail.data.notification.repair_job_id" dmx-text="'Repair ' + notificationDetail.data.notification.repair_job_id"></a></dd>
                <dd class="col-sm-9" dmx-show="notificationDetail.data.notification.repair_job_id && !authContext.data.can_repairs_view" dmx-text="'Repair ' + notificationDetail.data.notification.repair_job_id"></dd>
                <dt class="col-sm-3" dmx-show="notificationDetail.data.notification.repair_centre_name">Repair Centre</dt><dd class="col-sm-9" dmx-show="notificationDetail.data.notification.repair_centre_name" dmx-text="notificationDetail.data.notification.repair_centre_name"></dd>
                <dt class="col-sm-3" dmx-show="notificationDetail.data.notification.sla_policy_code">SLA policy</dt><dd class="col-sm-9" dmx-show="notificationDetail.data.notification.sla_policy_code" dmx-text="notificationDetail.data.notification.sla_policy_code"></dd>
                <dt class="col-sm-3" dmx-show="notificationDetail.data.notification.escalation_number">Escalation</dt><dd class="col-sm-9" dmx-show="notificationDetail.data.notification.escalation_number"><a href="/escalations" dmx-text="notificationDetail.data.notification.escalation_number + ' · Level ' + notificationDetail.data.notification.escalation_level"></a></dd>
                <dt class="col-sm-3">Source</dt><dd class="col-sm-9" dmx-text="notificationDetail.data.notification.source_type ? notificationDetail.data.notification.source_type + ' ' + notificationDetail.data.notification.source_id : '-' "></dd>
              </dl>
              <div class="alert alert-danger mt-3 mb-0" role="alert" dmx-show="notificationDetailMarkReadForm.lastError.status || notificationDetailMarkUnreadForm.lastError.status" dmx-text="notificationDetailMarkUnreadForm.lastError.response && notificationDetailMarkUnreadForm.lastError.response.error ? notificationDetailMarkUnreadForm.lastError.response.error : notificationDetailMarkReadForm.lastError.response && notificationDetailMarkReadForm.lastError.response.error ? notificationDetailMarkReadForm.lastError.response.error : 'Notification status could not be updated.'"></div>
            </div>
            <div class="modal-footer">
              <form id="notificationDetailMarkReadForm" is="dmx-serverconnect-form" method="post" action="/api/notifications/mark-read" dmx-show="!notificationDetail.data.notification.read_at && authContext.data.can_notifications_respond" dmx-on:success="notificationDetailModal.hide();notificationList.load({status:notificationStatusFilter.value,severity:notificationSeverityFilter.value,event_type:notificationTypeFilter.value,search:notificationSearch.value}, true)"><input type="text" name="recipient_id" class="visually-hidden" dmx-bind:value="notificationDetail.data.notification.recipient_id"><button type="submit" class="btn btn-bmobile-primary">Mark read</button></form>
              <form id="notificationDetailMarkUnreadForm" is="dmx-serverconnect-form" method="post" action="/api/notifications/mark-unread" dmx-show="notificationDetail.data.notification.read_at && authContext.data.can_notifications_respond" dmx-on:success="notificationDetailModal.hide();notificationList.load({status:notificationStatusFilter.value,severity:notificationSeverityFilter.value,event_type:notificationTypeFilter.value,search:notificationSearch.value}, true)"><input type="text" name="recipient_id" class="visually-hidden" dmx-bind:value="notificationDetail.data.notification.recipient_id"><button type="submit" class="btn btn-bmobile-secondary">Mark unread</button></form>
              <button type="button" class="btn btn-bmobile-secondary" data-bs-dismiss="modal">Close</button>
            </div>
          </div></div>
        </div>
    </main>
  </div>
</div>
