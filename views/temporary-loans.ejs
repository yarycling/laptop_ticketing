<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="temporaryLoansPage" appConnect="local" -->
<meta name="ac:route" content="/temporary-loans">
<div class="portal-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context"></dmx-serverconnect>
  <dmx-serverconnect id="loanList" url="/api/temporary-loans/list" dmx-param:status="statusFilter.value" dmx-param:search="searchInput.value"></dmx-serverconnect>
  <dmx-value id="loanChartsVisible" value="true"></dmx-value>
  <%- await include("partials/portal-sidebar", { currentPage: "temporary-loans" }) %>
  <div class="portal-workspace"><%- await include("partials/portal-topbar", { backHref: "/", pageTitle: "Temporary Loans" }) %>
    <main class="portal-main service-page temporary-loans-page">
      <section class="temporary-loans-hero" aria-labelledby="temporaryLoansTitle">
        <div class="temporary-loans-hero-copy">
          <span class="temporary-loans-hero-icon"><i class="fas fa-laptop-medical" aria-hidden="true"></i></span>
          <div><div class="temporary-loans-eyebrow">REPAIRS &amp; LOGISTICS</div><h1 id="temporaryLoansTitle">Temporary Loans</h1><p>Issue, track and recover spare devices for uninterrupted learning.</p></div>
        </div>
      </section>

      <div class="alert alert-danger temporary-loans-alert" role="alert" dmx-show="loanList.lastError.status" dmx-text="loanList.lastError.response && loanList.lastError.response.error ? loanList.lastError.response.error : 'Temporary loans could not be loaded.'"></div>

      <section class="temporary-loans-summary" aria-label="Temporary loan overview">
        <article class="temporary-loan-metric"><span class="temporary-loan-metric-icon green"><i class="fas fa-users" aria-hidden="true"></i></span><div class="temporary-loan-metric-copy"><h2>Active loans</h2><p>Currently issued to students or schools.</p><strong dmx-text="loanList.data.cases.where('current_status_code', '==', 'ACTIVE_LOAN').count()">0</strong></div><span class="temporary-loan-metric-mark green"><i class="fas fa-laptop" aria-hidden="true"></i></span></article>
        <article class="temporary-loan-metric"><span class="temporary-loan-metric-icon amber"><i class="fas fa-undo-alt" aria-hidden="true"></i></span><div class="temporary-loan-metric-copy"><h2>Return required</h2><p>Loans that are due for return.</p><strong dmx-text="loanList.data.cases.where('current_status_code', '==', 'RETURN_REQUIRED').count()">0</strong></div><span class="temporary-loan-metric-mark amber"><i class="far fa-calendar-alt" aria-hidden="true"></i></span></article>
        <article class="temporary-loan-metric"><span class="temporary-loan-metric-icon blue"><i class="far fa-clock" aria-hidden="true"></i></span><div class="temporary-loan-metric-copy"><h2>Pending approval</h2><p>Loan requests awaiting approval.</p><strong dmx-text="loanList.data.cases.where('current_status_code', '==', 'PENDING_DISTRICT_APPROVAL').count()">0</strong></div><span class="temporary-loan-metric-mark blue"><i class="far fa-file-alt" aria-hidden="true"></i></span></article>
      </section>

      <section class="temporary-loans-filter-card" aria-labelledby="temporaryLoanFilterTitle">
        <div class="temporary-loans-filter-heading"><div class="temporary-loans-section-title"><span class="temporary-loans-section-icon green"><i class="fas fa-search" aria-hidden="true"></i></span><div><h2 id="temporaryLoanFilterTitle">Search &amp; filter temporary loans</h2><p>Find loans by device, ticket, student or school, and filter by status.</p></div></div>
          <div class="temporary-loans-filter-actions"><label class="temporary-loans-toggle"><input type="checkbox" role="switch" id="loanChartsVisibleSwitch" dmx-bind:checked="loanChartsVisible.value" dmx-on:change="loanChartsVisible.setValue(loanChartsVisibleSwitch.checked)"><span>Show charts</span></label><label class="temporary-loans-toggle"><input type="checkbox" role="switch" id="activeLoansSwitch" dmx-bind:checked="statusFilter.value == 'ACTIVE_LOAN'" dmx-on:change="statusFilter.setValue(activeLoansSwitch.checked ? 'ACTIVE_LOAN' : 'ALL');loanList.load({search:searchInput.value,status:activeLoansSwitch.checked ? 'ACTIVE_LOAN' : 'ALL'}, true)"><span>Active only</span></label><button type="button" class="temporary-loans-clear" dmx-on:click="searchInput.setValue('');statusFilter.setValue('ALL');loanList.load({search:'',status:'ALL'}, true)"><i class="fas fa-filter" aria-hidden="true"></i> Clear filters</button></div>
        </div>
        <div class="temporary-loans-chart-strip" dmx-show="loanChartsVisible.value">
          <div class="temporary-loans-chart-item"><span>Active</span><div><i class="active" dmx-bind:style="'width:' + (loanList.data.cases.count() ? loanList.data.cases.where('current_status_code', '==', 'ACTIVE_LOAN').count() / loanList.data.cases.count() * 100 : 0) + '%' "></i></div></div>
          <div class="temporary-loans-chart-item"><span>Return required</span><div><i class="return" dmx-bind:style="'width:' + (loanList.data.cases.count() ? loanList.data.cases.where('current_status_code', '==', 'RETURN_REQUIRED').count() / loanList.data.cases.count() * 100 : 0) + '%' "></i></div></div>
          <div class="temporary-loans-chart-item"><span>Pending approval</span><div><i class="pending" dmx-bind:style="'width:' + (loanList.data.cases.count() ? loanList.data.cases.where('current_status_code', '==', 'PENDING_DISTRICT_APPROVAL').count() / loanList.data.cases.count() * 100 : 0) + '%' "></i></div></div>
        </div>
        <div class="temporary-loans-filter-grid"><div><label for="searchInput">Search</label><div class="temporary-loans-search-input"><i class="fas fa-search" aria-hidden="true"></i><input id="searchInput" class="form-control" placeholder="Loan, ticket, or original device" dmx-on:input="loanList.load({search:searchInput.value,status:statusFilter.value}, true)"></div></div><div><label for="statusFilter">Status</label><select id="statusFilter" class="form-select" dmx-on:change="loanList.load({search:searchInput.value,status:statusFilter.value}, true)"><option value="ALL">All statuses</option><option value="PENDING_DISTRICT_APPROVAL">Pending District Approval</option><option value="AUTHORIZED">Authorized</option><option value="SPARE_SELECTED">Spare Selected</option><option value="ACTIVE_LOAN">Active Loan</option><option value="RETURN_REQUIRED">Return Required</option><option value="RETURNED">Returned</option><option value="CONVERSION_PENDING_HEAD_OFFICE">Conversion Pending Head Office</option><option value="CONVERTED_PERMANENT">Converted to Permanent</option><option value="REJECTED">Rejected</option><option value="CANCELLED">Cancelled</option></select></div></div>
      </section>

      <section class="temporary-loans-list-card" aria-labelledby="temporaryLoansListTitle">
        <div class="temporary-loans-list-heading"><div class="temporary-loans-section-title"><span class="temporary-loans-section-icon slate"><i class="fas fa-list" aria-hidden="true"></i></span><div><h2 id="temporaryLoansListTitle">Temporary loans (<span dmx-text="loanList.data.cases.count()">0</span>)</h2><p>A list of temporary device loans matching your current filters.</p></div></div></div>
        <div class="table-responsive temporary-loans-table-scroll"><table class="table temporary-loans-table align-middle"><thead><tr><th>Loan #</th><th>Ticket</th><th>Original Device</th><th>District / School</th><th>Repair Centre / Pool</th><th>Status</th><th>Spare Device</th><th>Lifecycle / Stock</th><th>Reservation</th><th>Issued</th><th>Spare Return</th><th>Conversion</th><th><span class="visually-hidden">Actions</span></th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="loanList.data.cases"><tr><td><span class="temporary-loan-number" dmx-text="loan_number"></span><small class="d-block text-muted" dmx-text="requested_at_display"></small></td><td dmx-text="ticket_number"></td><td dmx-text="original_asset_tag || original_serial_number"></td><td><span dmx-text="origin_district_name"></span><small class="d-block text-muted" dmx-text="origin_school_name || '-' "></small></td><td><span dmx-text="repair_centre_name"></span><small class="d-block text-muted" dmx-text="spare_pool_name"></small></td><td><span class="temporary-loan-status" dmx-text="loan_status_name"></span></td><td dmx-text="selected_spare_asset_tag || selected_spare_serial_number || 'Not Selected'"></td><td><span dmx-text="selected_spare_lifecycle_code || '-' "></span><small class="d-block text-muted" dmx-text="selected_spare_stock_status || '-' "></small></td><td dmx-text="spare_reservation_status == 'RESERVED' && spare_reservation_active == 1 ? 'Reserved' : (spare_reservation_status == 'CONSUMED' ? 'Consumed' : 'None')"></td><td class="text-nowrap" dmx-text="issued_at_display"></td><td class="text-nowrap"><span dmx-text="returned_at_display != 'Not returned' ? returned_at_display : return_requested_at_display"></span><small class="d-block text-muted" dmx-text="return_reason_name || return_condition_code || (return_requested_at ? 'Return requested' : '-')"></small></td><td class="text-nowrap"><span dmx-text="conversion_request_status == 'PENDING' ? 'Pending Head Office' : (conversion_request_status == 'APPROVED' ? 'Approved' : (conversion_request_status == 'REJECTED' ? 'Rejected' : '-'))"></span><small class="d-block text-muted" dmx-text="conversion_request_number || ''"></small></td><td><a class="temporary-loan-open" dmx-bind:href="'/temporary-loans/detail?id=' + temporary_loan_case_id">Open <i class="fas fa-arrow-right" aria-hidden="true"></i></a></td></tr></tbody></table></div>
        <div class="temporary-loans-empty-state" dmx-show="!loanList.state.executing && loanList.data.cases.count() == 0"><span class="temporary-loans-empty-icon"><i class="fas fa-laptop" aria-hidden="true"></i></span><strong>No temporary loan cases found</strong><p>No temporary loan cases match the current filters.</p><span class="temporary-loans-empty-hint"><i class="fas fa-search" aria-hidden="true"></i> Try adjusting your search or filters</span></div>
      </section>
    </main>
  </div>
</div>
