<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="repairsPage" appConnect="local" -->
<meta name="ac:route" content="/repairs">
<div class="portal-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context"></dmx-serverconnect>
  <dmx-serverconnect id="repairList" url="/api/repairs/list" dmx-param:repair_state="stateFilter.value" dmx-param:outcome_code="outcomeFilter.value" dmx-param:search="searchInput.value" dmx-param:page="currentPage.value" dmx-param:page_size="rowsPerPage.value"></dmx-serverconnect>
  <dmx-serverconnect id="repairSummary" url="/api/repairs/summary"></dmx-serverconnect>
  <dmx-serverconnect id="repairOutcomes" url="/api/repairs/outcomes"></dmx-serverconnect>
  <dmx-value id="currentPage" value="1"></dmx-value>
  <dmx-value id="rowsPerPage" value="10"></dmx-value>
  <dmx-value id="repairChartsVisible" value="true"></dmx-value>
  <%- await include("partials/portal-sidebar", { currentPage: "repairs" }) %>
  <div class="portal-workspace"><%- await include("partials/portal-topbar", { pageTitle: "Repairs" }) %>
    <main class="portal-main service-page repairs-dashboard-page">
      <section class="repairs-hero-banner" aria-labelledby="repairsPageTitle">
        <div class="repairs-hero-icon"><i class="fas fa-tools" aria-hidden="true"></i></div>
        <div class="repairs-hero-copy"><div class="repairs-hero-eyebrow">REPAIRS &amp; LOGISTICS</div><h1 id="repairsPageTitle">Repairs</h1><p>Repair Centre processing and disposition.</p></div>
      </section>
      <div class="alert alert-danger repairs-notice" role="alert" dmx-show="repairList.lastError.status || repairSummary.lastError.status" dmx-text="repairList.lastError.response && repairList.lastError.response.error ? repairList.lastError.response.error : 'The repair queue could not be loaded.'"></div>

      <section class="repairs-kpi-grid" aria-label="Repair queue summary">
        <article class="repairs-kpi-card"><span class="repairs-kpi-icon"><i class="fas fa-cog" aria-hidden="true"></i></span><div class="repairs-kpi-main"><strong dmx-text="repairSummary.data.awaiting_repair_start || 0">0</strong><span>Awaiting Repair Start</span><small>Devices waiting to be processed</small></div><span class="repairs-kpi-action"><i class="fas fa-history" aria-hidden="true"></i></span></article>
        <article class="repairs-kpi-card"><span class="repairs-kpi-icon"><i class="fas fa-clipboard-list" aria-hidden="true"></i></span><div class="repairs-kpi-main"><strong dmx-text="repairSummary.data.in_progress || 0">0</strong><span>In Progress</span><small>Currently being repaired</small></div><span class="repairs-kpi-action"><i class="fas fa-tools" aria-hidden="true"></i></span></article>
        <article class="repairs-kpi-card"><span class="repairs-kpi-icon"><i class="fas fa-box" aria-hidden="true"></i></span><div class="repairs-kpi-main"><strong dmx-text="repairSummary.data.ready_for_return || 0">0</strong><span>Ready for Return</span><small>Repairs completed</small></div><span class="repairs-kpi-action"><i class="fas fa-check-circle" aria-hidden="true"></i></span></article>
        <article class="repairs-kpi-card"><span class="repairs-kpi-icon"><i class="fas fa-undo-alt" aria-hidden="true"></i></span><div class="repairs-kpi-main"><strong dmx-text="repairSummary.data.disposition_recorded || 0">0</strong><span>Disposition Recorded</span><small>Completed and recorded</small></div><span class="repairs-kpi-action"><i class="fas fa-file-alt" aria-hidden="true"></i></span></article>
      </section>

      <section class="repairs-chart-card" aria-labelledby="repairDistributionTitle">
        <div class="repairs-chart-heading"><div class="repairs-section-title"><span class="repairs-section-icon"><i class="fas fa-chart-bar" aria-hidden="true"></i></span><div><h2 id="repairDistributionTitle">Repair queue distribution</h2><p>Counts in your authorized operational scope.</p></div></div>
          <div class="repairs-chart-controls"><label class="repairs-toggle"><input type="checkbox" role="switch" id="repairChartsVisibleSwitch" dmx-bind:checked="repairChartsVisible.value" dmx-on:change="repairChartsVisible.setValue(repairChartsVisibleSwitch.checked)"><span>Show charts</span></label><label class="repairs-toggle"><input type="checkbox" role="switch" id="inProgressSwitch" dmx-bind:checked="stateFilter.value == 'IN_PROGRESS'" dmx-on:change="stateFilter.setValue(inProgressSwitch.checked ? 'IN_PROGRESS' : 'ALL');currentPage.setValue(1);repairList.load({search:searchInput.value,repair_state:inProgressSwitch.checked ? 'IN_PROGRESS' : 'ALL',outcome_code:outcomeFilter.value,page:1,page_size:rowsPerPage.value}, true)"><span>In progress only</span></label><button type="button" class="repairs-clear-button" dmx-on:click="searchInput.setValue('');stateFilter.setValue('ALL');outcomeFilter.setValue('');currentPage.setValue(1);repairList.load({search:'',repair_state:'ALL',outcome_code:'',page:1,page_size:rowsPerPage.value}, true)"><i class="fas fa-filter" aria-hidden="true"></i> Clear filters</button></div>
        </div>
        <div class="repairs-chart-grid" dmx-show="repairChartsVisible.value">
          <div class="repairs-chart-cell"><div class="repairs-chart-row"><span>Awaiting repair start</span><div class="repairs-chart-track"><span class="repairs-bar-green" dmx-bind:style="'width:' + (repairSummary.data.active_total ? repairSummary.data.awaiting_repair_start / repairSummary.data.active_total * 100 : 0) + '%' "></span></div><strong dmx-text="repairSummary.data.awaiting_repair_start || 0">0</strong></div><div class="repairs-chart-row"><span>Ready for return</span><div class="repairs-chart-track"><span class="repairs-bar-blue" dmx-bind:style="'width:' + (repairSummary.data.active_total ? repairSummary.data.ready_for_return / repairSummary.data.active_total * 100 : 0) + '%' "></span></div><strong dmx-text="repairSummary.data.ready_for_return || 0">0</strong></div></div>
          <div class="repairs-chart-cell"><div class="repairs-chart-row"><span>In progress</span><div class="repairs-chart-track"><span class="repairs-bar-slate" dmx-bind:style="'width:' + (repairSummary.data.active_total ? repairSummary.data.in_progress / repairSummary.data.active_total * 100 : 0) + '%' "></span></div><strong dmx-text="repairSummary.data.in_progress || 0">0</strong></div><div class="repairs-chart-row"><span>Disposition recorded</span><div class="repairs-chart-track"><span class="repairs-bar-violet" dmx-bind:style="'width:' + (repairSummary.data.active_total ? repairSummary.data.disposition_recorded / repairSummary.data.active_total * 100 : 0) + '%' "></span></div><strong dmx-text="repairSummary.data.disposition_recorded || 0">0</strong></div></div>
        </div>
      </section>

      <section class="repairs-filter-card" aria-labelledby="repairFiltersTitle"><div class="repairs-filter-heading"><i class="fas fa-search" aria-hidden="true"></i><h2 id="repairFiltersTitle">Search and filter repairs</h2></div><div class="repairs-filter-grid">
        <div><label for="searchInput">Search</label><div class="repairs-input-icon"><i class="fas fa-search" aria-hidden="true"></i><input id="searchInput" class="form-control" placeholder="Ticket, logistics, serial or asset tag" dmx-on:input="currentPage.setValue(1);repairList.load({search:searchInput.value,repair_state:stateFilter.value,outcome_code:outcomeFilter.value,page:1,page_size:rowsPerPage.value}, true)"></div></div>
        <div><label for="stateFilter">Repair State</label><select id="stateFilter" class="form-select" dmx-on:change="currentPage.setValue(1);repairList.load({search:searchInput.value,repair_state:stateFilter.value,outcome_code:outcomeFilter.value,page:1,page_size:rowsPerPage.value}, true)"><option value="ALL">All repair states</option><option value="AWAITING_REPAIR_START">Awaiting Repair Start</option><option value="IN_PROGRESS">In Progress</option><option value="READY_FOR_RETURN">Ready for Return</option><option value="DISPOSITION_RECORDED">Disposition Recorded</option></select></div>
        <div><label for="outcomeFilter">Outcome</label><select id="outcomeFilter" class="form-select" dmx-on:change="currentPage.setValue(1);repairList.load({search:searchInput.value,repair_state:stateFilter.value,outcome_code:outcomeFilter.value,page:1,page_size:rowsPerPage.value}, true)"><option value="">All outcomes</option><option dmx-repeat="repairOutcomes.data.outcomes" dmx-bind:value="code" dmx-text="name"></option></select></div>
      </div></section>

      <section class="repairs-list-card" aria-labelledby="repairCasesTitle"><div class="repairs-list-heading"><div class="repairs-section-title"><span class="repairs-section-icon"><i class="fas fa-list-alt" aria-hidden="true"></i></span><div><h2 id="repairCasesTitle">Repair cases</h2><p>Browse and manage repair cases within your operational scope.</p></div></div><div class="repairs-list-tools"><label for="rowsPerPageSelect">Rows per page</label><select id="rowsPerPageSelect" class="form-select" dmx-bind:value="rowsPerPage.value" dmx-on:change="rowsPerPage.setValue(rowsPerPageSelect.value);currentPage.setValue(1);repairList.load({search:searchInput.value,repair_state:stateFilter.value,outcome_code:outcomeFilter.value,page:1,page_size:rowsPerPageSelect.value}, true)"><option value="10">10</option><option value="25">25</option><option value="50">50</option></select><button type="button" class="repairs-page-button" aria-label="Previous page" dmx-bind:disabled="currentPage.value <= 1" dmx-on:click="currentPage.setValue(currentPage.value - 1);repairList.load({search:searchInput.value,repair_state:stateFilter.value,outcome_code:outcomeFilter.value,page:currentPage.value - 1,page_size:rowsPerPage.value}, true)"><i class="fas fa-chevron-left"></i></button><span class="repairs-current-page" dmx-text="currentPage.value">1</span><button type="button" class="repairs-page-button" aria-label="Next page" dmx-bind:disabled="repairList.data.repairs.count() < repairList.data.page_size" dmx-on:click="currentPage.setValue(currentPage.value + 1);repairList.load({search:searchInput.value,repair_state:stateFilter.value,outcome_code:outcomeFilter.value,page:currentPage.value + 1,page_size:rowsPerPage.value}, true)"><i class="fas fa-chevron-right"></i></button></div></div>
        <div class="table-responsive repairs-table-scroll"><table class="table repairs-table align-middle"><thead><tr><th>Ticket # <i class="fas fa-sort ms-1" aria-hidden="true"></i></th><th>Logistics #</th><th>Device</th><th>Repair Centre</th><th>Repair State</th><th>Ticket Status</th><th>Device Lifecycle</th><th>Started</th><th>Outcome</th><th>Action</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="repairList.data.repairs"><tr><td dmx-text="ticket_number"></td><td dmx-text="logistics_number"></td><td><span dmx-text="serial_number"></span><small class="d-block text-muted" dmx-text="asset_tag || '-' "></small></td><td dmx-text="repair_centre_location_name"></td><td><span class="repairs-state-badge" dmx-text="repair_state_code == 'AWAITING_REPAIR_START' ? 'Awaiting Repair Start' : repair_state_code == 'IN_PROGRESS' ? 'In Progress' : repair_state_code == 'READY_FOR_RETURN' ? 'Ready for Return' : 'Disposition Recorded'"></span></td><td dmx-text="ticket_status_code"></td><td dmx-text="device_lifecycle_code"></td><td class="text-nowrap" dmx-text="started_at ? started_at.formatDate('MMM d, yyyy, h:mm A') : 'Not started'"></td><td dmx-text="outcome_name || '-' "></td><td><a class="repairs-open-button btn-sm" dmx-bind:href="'/repairs/detail?id=' + logistics_case_id">Open</a></td></tr></tbody></table></div>
        <div class="repairs-empty-state" dmx-show="!repairList.state.executing && repairList.data.repairs.count() == 0"><span><i class="far fa-file-alt" aria-hidden="true"></i></span><strong>No repair cases match these filters.</strong><p>Try adjusting your search or filter criteria.</p></div>
        <div class="repairs-list-footer"><span>Showing <strong dmx-text="repairList.data.repairs.count()">0</strong> repair cases</span><div class="repairs-footer-pagination"><button type="button" class="repairs-page-button" aria-label="Previous page" dmx-bind:disabled="currentPage.value <= 1" dmx-on:click="currentPage.setValue(currentPage.value - 1);repairList.load({search:searchInput.value,repair_state:stateFilter.value,outcome_code:outcomeFilter.value,page:currentPage.value - 1,page_size:rowsPerPage.value}, true)"><i class="fas fa-chevron-left"></i></button><span class="repairs-current-page" dmx-text="currentPage.value">1</span><button type="button" class="repairs-page-button" aria-label="Next page" dmx-bind:disabled="repairList.data.repairs.count() < repairList.data.page_size" dmx-on:click="currentPage.setValue(currentPage.value + 1);repairList.load({search:searchInput.value,repair_state:stateFilter.value,outcome_code:outcomeFilter.value,page:currentPage.value + 1,page_size:rowsPerPage.value}, true)"><i class="fas fa-chevron-right"></i></button></div></div>
      </section>
    </main>
  </div>
</div>
