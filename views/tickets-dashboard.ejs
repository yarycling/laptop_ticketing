<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="ticketsDashboard" appConnect="local" -->
<meta name="ac:route" content="/tickets/dashboard">
<div class="portal-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context"></dmx-serverconnect>
  <dmx-serverconnect id="ticketDashboard" url="/api/tickets/dashboard" dmx-param:submitted_from="dashboardFrom.value" dmx-param:submitted_to="dashboardTo.value" dmx-param:district_id="dashboardDistrict.value" dmx-param:school_id="dashboardSchool.value" dmx-param:status_code="dashboardStatus.value" dmx-param:requester_type="dashboardRequester.value"></dmx-serverconnect>
  <dmx-serverconnect id="ticketStatuses" url="/api/tickets/status-options"></dmx-serverconnect>
  <dmx-serverconnect id="ticketDistricts" url="/api/tickets/district-options"></dmx-serverconnect>
  <dmx-serverconnect id="ticketSchools" url="/api/tickets/school-options" dmx-param:district_id="dashboardDistrict.value"></dmx-serverconnect>
  <dmx-serverconnect id="operationalReport" url="/api/tickets/reports/operational" dmx-param:submitted_from="dashboardFrom.value" dmx-param:submitted_to="dashboardTo.value" dmx-param:district_id="dashboardDistrict.value" dmx-param:school_id="dashboardSchool.value" dmx-param:status_code="dashboardStatus.value" dmx-param:requester_type="dashboardRequester.value" dmx-param:assignment_filter="reportAssignment.value" dmx-param:assigned_to_user_id="reportAssignee.value" dmx-param:search="reportSearch.value" dmx-param:page="reportPage.value" dmx-param:page_size="25"></dmx-serverconnect>
  <dmx-value id="reportPage" value="1"></dmx-value>
  <dmx-value id="ticketChartsVisible" value="true"></dmx-value>
  <%- await include("partials/portal-sidebar", { currentPage: "ticket-dashboard" }) %>
  <div class="portal-workspace"><%- await include("partials/portal-topbar", { pageTitle: "Ticket Dashboard" }) %>
    <main class="portal-main" aria-label="Ticket dashboard">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3"><div class="monitoring-heading"><span class="monitoring-heading-icon"><i class="fas fa-chart-line" aria-hidden="true"></i></span><div><div class="monitoring-eyebrow">MONITORING &amp; REPORTS</div><h1 class="h3 mb-1">Ticket Dashboard</h1><p class="text-muted mb-0">Operational workload and ticket aging.</p></div></div><div class="d-flex align-items-center gap-3"><div class="form-check form-switch monitoring-switch"><input class="form-check-input" type="checkbox" role="switch" id="ticketChartsSwitch" dmx-bind:checked="ticketChartsVisible.value" dmx-on:change="ticketChartsVisible.setValue(ticketChartsSwitch.checked)"><label class="form-check-label" for="ticketChartsSwitch">Show charts</label></div><a class="btn btn-bmobile-secondary" href="/tickets">View Tickets</a></div></div>
      <div class="alert alert-danger" role="alert" dmx-show="ticketDashboard.lastError.status" dmx-text="ticketDashboard.lastError.response && ticketDashboard.lastError.response.error ? ticketDashboard.lastError.response.error : 'Dashboard data could not be loaded.'"></div>
      <section class="portal-card monitoring-filter-card mb-4" aria-label="Dashboard filters"><div class="monitoring-card-heading"><div><h2 class="h6 mb-1">Dashboard filters</h2><p class="small text-muted mb-0">Filtering updates the dashboard and operational report together.</p></div><button type="button" class="btn btn-bmobile-secondary btn-sm" dmx-on:click="dashboardFrom.setValue('');dashboardTo.setValue('');dashboardDistrict.setValue('');dashboardSchool.setValue('');dashboardStatus.setValue('');dashboardRequester.setValue('');ticketSchools.load({district_id:''}, true);ticketDashboard.load({submitted_from:'',submitted_to:'',district_id:'',school_id:'',status_code:'',requester_type:''}, true);reportPage.setValue(1);operationalReport.load({submitted_from:'',submitted_to:'',district_id:'',school_id:'',status_code:'',requester_type:'',assignment_filter:reportAssignment.value,assigned_to_user_id:reportAssignee.value,search:reportSearch.value,page:1,page_size:25}, true)">Clear filters</button></div><div class="row g-3 align-items-end">
        <div class="col-6 col-lg-2"><label class="form-label" for="dashboardFrom">Date From</label><input id="dashboardFrom" type="date" class="form-control" dmx-on:change="ticketDashboard.load();reportPage.setValue(1);operationalReport.load()"></div>
        <div class="col-6 col-lg-2"><label class="form-label" for="dashboardTo">Date To</label><input id="dashboardTo" type="date" class="form-control" dmx-on:change="ticketDashboard.load();reportPage.setValue(1);operationalReport.load()"></div>
        <div class="col-12 col-md-6 col-lg-2"><label class="form-label" for="dashboardDistrict">District</label><select id="dashboardDistrict" class="form-select" dmx-on:change="dashboardSchool.setValue('');ticketSchools.load();ticketDashboard.load();reportPage.setValue(1);operationalReport.load()"><option value="">All authorized districts</option><option dmx-repeat="ticketDistricts.data.districts" dmx-bind:value="id" dmx-text="name"></option></select></div>
        <div class="col-12 col-md-6 col-lg-2"><label class="form-label" for="dashboardSchool">School</label><select id="dashboardSchool" class="form-select" dmx-on:change="ticketDashboard.load();reportPage.setValue(1);operationalReport.load()"><option value="">All authorized schools</option><option dmx-repeat="ticketSchools.data.schools" dmx-bind:value="id" dmx-text="name"></option></select></div>
        <div class="col-12 col-md-6 col-lg-2"><label class="form-label" for="dashboardStatus">Status</label><select id="dashboardStatus" class="form-select" dmx-on:change="ticketDashboard.load();reportPage.setValue(1);operationalReport.load()"><option value="">All statuses</option><option dmx-repeat="ticketStatuses.data.statuses" dmx-bind:value="code" dmx-text="name"></option></select></div>
        <div class="col-12 col-md-6 col-lg-2"><label class="form-label" for="dashboardRequester">Requester</label><select id="dashboardRequester" class="form-select" dmx-on:change="ticketDashboard.load();reportPage.setValue(1);operationalReport.load()"><option value="">All types</option><option value="STUDENT">Student</option><option value="PARENT">Parent</option><option value="TEACHER">Teacher</option><option value="STAFF">Staff</option></select></div>
      </div></section>
      <div class="row g-3 mb-4" dmx-show="ticketDashboard.data.summary">
        <div class="col-6 col-xl-2"><article class="portal-card h-100"><strong class="fs-3" dmx-text="ticketDashboard.data.summary.open_total"></strong><div>Open Tickets</div></article></div>
        <div class="col-6 col-xl-2"><article class="portal-card h-100"><strong class="fs-3" dmx-text="ticketDashboard.data.summary.unassigned_open"></strong><div>Unassigned</div></article></div>
        <div class="col-6 col-xl-2"><article class="portal-card h-100"><strong class="fs-3" dmx-text="ticketDashboard.data.summary.assigned_open"></strong><div>Assigned</div></article></div>
        <div class="col-6 col-xl-2"><article class="portal-card h-100"><strong class="fs-3" dmx-text="ticketDashboard.data.summary.submitted"></strong><div>Submitted</div></article></div>
        <div class="col-6 col-xl-2"><article class="portal-card h-100"><strong class="fs-3" dmx-text="ticketDashboard.data.summary.needs_clarification"></strong><div>Needs Clarification</div></article></div>
        <div class="col-6 col-xl-2"><article class="portal-card h-100"><strong class="fs-3" dmx-text="ticketDashboard.data.summary.approved_for_pickup"></strong><div>Approved for Pickup</div></article></div>
      </div>
      <section class="portal-card mb-4" dmx-show="ticketChartsVisible.value"><div class="monitoring-card-heading"><div><h2 class="h5 mb-1">Ticket Aging</h2><p class="small text-muted mb-0">Age of non-terminal tickets; these are not SLA measures.</p></div></div><div class="row g-3">
        <div class="col-6 col-lg-3"><div class="border rounded p-3"><strong dmx-text="ticketDashboard.data.metrics.where('ticket_age_bucket','==','LESS_THAN_24_HOURS').count()"></strong><div>&lt; 24 Hours</div></div></div>
        <div class="col-6 col-lg-3"><div class="border rounded p-3"><strong dmx-text="ticketDashboard.data.metrics.where('ticket_age_bucket','==','ONE_TO_THREE_DAYS').count()"></strong><div>1–3 Days</div></div></div>
        <div class="col-6 col-lg-3"><div class="border rounded p-3"><strong dmx-text="ticketDashboard.data.metrics.where('ticket_age_bucket','==','FOUR_TO_SEVEN_DAYS').count()"></strong><div>4–7 Days</div></div></div>
        <div class="col-6 col-lg-3"><div class="border rounded p-3"><strong dmx-text="ticketDashboard.data.metrics.where('ticket_age_bucket','==','MORE_THAN_SEVEN_DAYS').count()"></strong><div>&gt; 7 Days</div></div></div>
      </div></section>
      <div class="row g-4 mb-4">
        <section class="col-12 col-xl-6"><div class="portal-card h-100"><h2 class="h5">Tickets by Status</h2><div class="monitoring-chart-grid mb-3" dmx-show="ticketChartsVisible.value"><div class="monitoring-chart-row" is="dmx-repeat" dmx-bind:repeat="ticketDashboard.data.status_breakdown"><span dmx-text="current_status_name"></span><progress dmx-bind:max="ticketDashboard.data.summary.total_tickets || 1" dmx-bind:value="ticket_count"></progress><strong dmx-text="ticket_count"></strong></div></div><div class="table-responsive"><table class="table portal-table align-middle"><thead><tr><th>Status</th><th>Tickets</th><th>Average current status age (min)</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="ticketDashboard.data.status_breakdown"><tr><td dmx-text="current_status_name"></td><td dmx-text="ticket_count"></td><td dmx-text="average_status_age_minutes == null ? '-' : floor(average_status_age_minutes)"></td></tr></tbody><tbody dmx-show="!ticketDashboard.data.status_breakdown.length"><tr><td colspan="3" class="text-center text-muted">No matching tickets.</td></tr></tbody></table></div></div></section>
        <section class="col-12 col-xl-6"><div class="portal-card h-100"><h2 class="h5">Tickets by District</h2><div class="table-responsive"><table class="table portal-table align-middle"><thead><tr><th>District</th><th>Open</th><th>Total</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="ticketDashboard.data.district_breakdown"><tr><td dmx-text="district_name"></td><td dmx-text="total_ticket_count - terminal_ticket_count"></td><td dmx-text="total_ticket_count"></td></tr></tbody><tbody dmx-show="!ticketDashboard.data.district_breakdown.length"><tr><td colspan="3" class="text-center text-muted">No matching tickets.</td></tr></tbody></table></div></div></section>
        <section class="col-12 col-xl-6"><div class="portal-card h-100"><h2 class="h5">Tickets by School</h2><div class="table-responsive"><table class="table portal-table align-middle"><thead><tr><th>School</th><th>Open</th><th>Total</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="ticketDashboard.data.school_breakdown"><tr><td dmx-text="school_name"></td><td dmx-text="total_ticket_count - terminal_ticket_count"></td><td dmx-text="total_ticket_count"></td></tr></tbody><tbody dmx-show="!ticketDashboard.data.school_breakdown.length"><tr><td colspan="3" class="text-center text-muted">No matching tickets.</td></tr></tbody></table></div></div></section>
        <section class="col-12 col-xl-6"><div class="portal-card h-100"><h2 class="h5">Requester Type</h2><div class="table-responsive"><table class="table portal-table align-middle"><thead><tr><th>Type</th><th>Tickets</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="ticketDashboard.data.requester_breakdown"><tr><td dmx-text="requester_type == 'STUDENT' ? 'Student' : requester_type == 'PARENT' ? 'Parent' : requester_type == 'TEACHER' ? 'Teacher' : requester_type == 'STAFF' ? 'Staff' : requester_type"></td><td dmx-text="ticket_count"></td></tr></tbody><tbody dmx-show="!ticketDashboard.data.requester_breakdown.length"><tr><td colspan="2" class="text-center text-muted">No matching tickets.</td></tr></tbody></table></div></div></section>
        <section class="col-12"><div class="portal-card"><h2 class="h5">Current Technician Workload</h2><p class="mb-0">Unassigned open tickets: <strong dmx-text="ticketDashboard.data.summary.unassigned_open"></strong></p><div class="table-responsive mt-3"><table class="table portal-table align-middle"><thead><tr><th>Assigned Technician</th><th>Open Assigned Tickets</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="ticketDashboard.data.workload"><tr><td dmx-text="assigned_to_display_name || 'Unknown user'"></td><td dmx-text="open_assigned_count"></td></tr></tbody></table></div></div></section>
      </div>
      <section class="portal-card mb-4"><h2 class="h5">Performance Metrics</h2><p class="small text-muted">Elapsed durations from ticket submission. No SLA target is implied.</p><div class="row g-3"><div class="col-12 col-md-4"><strong>Average open ticket age</strong><div class="d-flex align-items-baseline gap-1" dmx-show="ticketDashboard.data.summary.average_open_age_minutes != null"><span dmx-text="ticketDashboard.data.summary.average_open_age_minutes"></span><span>minutes</span></div><div class="text-muted" dmx-show="ticketDashboard.data.summary.average_open_age_minutes == null">Not available</div></div><div class="col-12 col-md-4"><strong>Average time to first diagnosis</strong><div class="d-flex align-items-baseline gap-1" dmx-show="ticketDashboard.data.summary.average_time_to_first_diagnosis_minutes != null"><span dmx-text="ticketDashboard.data.summary.average_time_to_first_diagnosis_minutes"></span><span>minutes</span></div><div class="text-muted" dmx-show="ticketDashboard.data.summary.average_time_to_first_diagnosis_minutes == null">Not available</div></div><div class="col-12 col-md-4"><strong>Average time to pickup approval</strong><div class="d-flex align-items-baseline gap-1" dmx-show="ticketDashboard.data.summary.average_time_to_approval_minutes != null"><span dmx-text="ticketDashboard.data.summary.average_time_to_approval_minutes"></span><span>minutes</span></div><div class="text-muted" dmx-show="ticketDashboard.data.summary.average_time_to_approval_minutes == null">Not available</div></div></div></section>
      <section class="portal-card mb-4" dmx-show="authContext.data.can_tickets_report"><div class="d-flex justify-content-between align-items-center gap-3 mb-3"><div><h2 class="h5 mb-1">Operational Report</h2><p class="text-muted small mb-0">Ticket details are limited to your authorized origin scope.</p></div><button type="button" class="btn btn-bmobile-secondary btn-sm" dmx-on:click="reportSearch.setValue('');reportAssignment.setValue('ALL');reportAssignee.setValue('');reportPage.setValue(1);operationalReport.load({submitted_from:dashboardFrom.value,submitted_to:dashboardTo.value,district_id:dashboardDistrict.value,school_id:dashboardSchool.value,status_code:dashboardStatus.value,requester_type:dashboardRequester.value,assignment_filter:'ALL',assigned_to_user_id:'',search:'',page:1,page_size:25}, true)">Clear report filters</button></div>
        <div class="row g-2 mb-3"><div class="col-12 col-md-5"><label class="visually-hidden" for="reportSearch">Search</label><input id="reportSearch" class="form-control" placeholder="Search ticket, serial or asset tag" dmx-on:input="reportPage.setValue(1);operationalReport.load()"></div><div class="col-12 col-md-4"><label class="visually-hidden" for="reportAssignment">Assignment</label><select id="reportAssignment" class="form-select" dmx-on:change="reportPage.setValue(1);operationalReport.load()"><option value="ALL">All assignments</option><option value="ASSIGNED">Assigned</option><option value="UNASSIGNED">Unassigned</option></select></div><div class="col-12 col-md-3"><label class="visually-hidden" for="reportAssignee">Assigned user ID</label><input id="reportAssignee" type="number" min="1" class="form-control" placeholder="Assignee user ID" dmx-on:change="reportPage.setValue(1);operationalReport.load()"></div></div>
        <div class="table-responsive"><table class="table portal-table align-middle"><thead><tr><th>Ticket</th><th>Device</th><th>District / School</th><th>Status</th><th>Requester</th><th>Submitted</th><th>Ticket age (min)</th><th>Status age (min)</th><th>Assigned To</th><th>Assignment age (min)</th><th>Diagnosis (min)</th><th>Approval (min)</th><th></th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="operationalReport.data.tickets"><tr><td><a dmx-bind:href="'/tickets/detail?id=' + ticket_id" dmx-text="ticket_number"></a></td><td><span dmx-text="serial_number"></span><small class="d-block text-muted" dmx-text="asset_tag || '-'">-</small></td><td><span dmx-text="origin_district_name || '-'">-</span><small class="d-block text-muted" dmx-text="origin_school_name || '-'">-</small></td><td dmx-text="current_status_name"></td><td dmx-text="requester_type"></td><td class="text-nowrap" dmx-text="submitted_at.formatDate('MMM d, yyyy, h:mm A')"></td><td dmx-text="ticket_age_minutes"></td><td dmx-text="current_status_age_minutes"></td><td dmx-text="assigned_to_display_name || 'Unassigned'"></td><td dmx-text="assignment_age_minutes"></td><td dmx-text="time_to_first_diagnosis_minutes"></td><td dmx-text="time_to_approval_minutes"></td><td><a class="btn btn-sm btn-bmobile-secondary" dmx-bind:href="'/tickets/detail?id=' + ticket_id" aria-label="View ticket">View</a></td></tr></tbody><tbody dmx-show="operationalReport.data.tickets.count() == 0"><tr><td colspan="13" class="text-center text-muted py-4">No matching tickets.</td></tr></tbody></table></div>
        <div class="d-flex justify-content-between align-items-center mt-3"><span class="text-muted" dmx-text="'Page ' + operationalReport.data.page + ' of ' + (operationalReport.data.total_pages || 1) + ' · ' + operationalReport.data.total + ' tickets'"></span><div class="btn-group"><button class="btn btn-bmobile-secondary" type="button" aria-label="Previous page" dmx-bind:disabled="reportPage.value <= 1" dmx-on:click="reportPage.setValue(reportPage.value - 1);operationalReport.load()">Previous</button><button class="btn btn-bmobile-secondary" type="button" aria-label="Next page" dmx-bind:disabled="reportPage.value >= operationalReport.data.total_pages" dmx-on:click="reportPage.setValue(reportPage.value + 1);operationalReport.load()">Next</button></div></div>
      </section>
    </main>
  </div>
</div>
