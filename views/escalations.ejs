<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="escalationsPage" appConnect="local" components="{dmxBootstrap5Modal:{}}" -->
<meta name="ac:route" content="/escalations">
<div class="portal-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context"></dmx-serverconnect>
  <dmx-serverconnect id="escalationOptions" url="/api/escalations/filter-options"></dmx-serverconnect>
  <dmx-serverconnect id="escalationList" url="/api/escalations/list" dmx-param:state="stateFilter.value" dmx-param:level="levelFilter.value" dmx-param:trigger="triggerFilter.value" dmx-param:policy="policyFilter.value" dmx-param:responsible_role="roleFilter.value" dmx-param:district_id="districtFilter.value" dmx-param:school_id="schoolFilter.value" dmx-param:ticket_number="ticketFilter.value" dmx-param:page="1" dmx-param:page_size="50"></dmx-serverconnect>
  <dmx-serverconnect id="escalationDetail" url="/api/escalations/detail" noload="true"></dmx-serverconnect>
  <dmx-value id="escalationNotice" value=""></dmx-value>
  <dmx-value id="escalationChartsVisible" value="true"></dmx-value>
  <%- await include("partials/portal-sidebar", { currentPage: "escalations" }) %>
  <div class="portal-workspace"><%- await include("partials/portal-topbar", { pageTitle: "Escalations" }) %>
    <main class="portal-main" aria-label="Escalations">
      <section class="portal-section monitoring-page">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3"><div class="monitoring-heading"><span class="monitoring-heading-icon"><i class="fas fa-sliders-h" aria-hidden="true"></i></span><div><div class="monitoring-eyebrow">MONITORING &amp; REPORTS</div><h1 class="h3 mb-1">Escalations</h1><p class="text-muted mb-0">SLA risks and breaches routed to operational owners.</p></div></div><button type="button" class="btn btn-bmobile-secondary" dmx-on:click="escalationList.load({state:stateFilter.value,level:levelFilter.value,trigger:triggerFilter.value,policy:policyFilter.value,responsible_role:roleFilter.value,district_id:districtFilter.value,school_id:schoolFilter.value,ticket_number:ticketFilter.value,page:1,page_size:50}, true)">Refresh</button></div>
        <div class="logistics-stats mb-3"><article class="logistics-stat-card"><div class="logistics-stat-icon"><i class="fas fa-clipboard-list" aria-hidden="true"></i></div><div class="logistics-stat-copy"><span>Loaded escalations</span><strong dmx-text="escalationList.data.escalations.count() || 0"></strong><small>Latest 50 matching items</small></div></article><article class="logistics-stat-card"><div class="logistics-stat-icon logistics-stat-icon-box"><i class="fas fa-bell" aria-hidden="true"></i></div><div class="logistics-stat-copy"><span>Open</span><strong dmx-text="escalationList.data.escalations.where('current_state_code', '==', 'OPEN').count()"></strong><small>Needs acknowledgement</small></div></article><article class="logistics-stat-card"><div class="logistics-stat-icon logistics-stat-icon-repair"><i class="fas fa-exclamation-triangle" aria-hidden="true"></i></div><div class="logistics-stat-copy"><span>Breached triggers</span><strong dmx-text="escalationList.data.escalations.where('current_trigger', '==', 'BREACHED').count()"></strong><small>In the loaded results</small></div></article></div>
        <div class="alert alert-success py-2" role="status" dmx-show="escalationNotice.value" dmx-text="escalationNotice.value"></div>
        <div class="alert alert-danger py-2" role="alert" dmx-show="escalationList.lastError.status || escalationDetail.lastError.status || acknowledgementForm.lastError.status" dmx-text="acknowledgementForm.lastError.response && acknowledgementForm.lastError.response.error ? acknowledgementForm.lastError.response.error : escalationDetail.lastError.response && escalationDetail.lastError.response.error ? escalationDetail.lastError.response.error : 'Escalations could not be loaded.'"></div>
        <section class="monitoring-filter-card mb-3" aria-label="Escalation filters"><div class="row g-3 align-items-end">
          <div class="col-sm-6 col-lg-2"><label class="form-label" for="stateFilter">State</label><select id="stateFilter" class="form-select" dmx-on:change="escalationList.load({state:stateFilter.value,level:levelFilter.value,trigger:triggerFilter.value,policy:policyFilter.value,responsible_role:roleFilter.value,district_id:districtFilter.value,school_id:schoolFilter.value,ticket_number:ticketFilter.value,page:1,page_size:50}, true)"><option value="ALL">All states</option><option value="OPEN">Open</option><option value="ACKNOWLEDGED">Acknowledged</option><option value="RESOLVED">Resolved</option><option value="CANCELLED">Cancelled</option></select></div>
          <div class="col-sm-6 col-lg-1"><label class="form-label" for="levelFilter">Level</label><select id="levelFilter" class="form-select" dmx-on:change="escalationList.load({state:stateFilter.value,level:levelFilter.value,trigger:triggerFilter.value,policy:policyFilter.value,responsible_role:roleFilter.value,district_id:districtFilter.value,school_id:schoolFilter.value,ticket_number:ticketFilter.value,page:1,page_size:50}, true)"><option value="">All</option><option value="1">1</option><option value="2">2</option></select></div>
          <div class="col-sm-6 col-lg-2"><label class="form-label" for="triggerFilter">Trigger</label><select id="triggerFilter" class="form-select" dmx-on:change="escalationList.load({state:stateFilter.value,level:levelFilter.value,trigger:triggerFilter.value,policy:policyFilter.value,responsible_role:roleFilter.value,district_id:districtFilter.value,school_id:schoolFilter.value,ticket_number:ticketFilter.value,page:1,page_size:50}, true)"><option value="ALL">All triggers</option><option value="AT_RISK">At Risk</option><option value="BREACHED">Breached</option></select></div>
          <div class="col-sm-6 col-lg-2"><label class="form-label" for="policyFilter">Policy</label><select id="policyFilter" class="form-select" dmx-on:change="escalationList.load({state:stateFilter.value,level:levelFilter.value,trigger:triggerFilter.value,policy:policyFilter.value,responsible_role:roleFilter.value,district_id:districtFilter.value,school_id:schoolFilter.value,ticket_number:ticketFilter.value,page:1,page_size:50}, true)"><option value="ALL">All policies</option><option value="PICKUP">Pickup</option><option value="DIAGNOSIS">Diagnosis</option><option value="REPAIR">Repair</option><option value="RETURN_LOGISTICS">Return Logistics</option></select></div>
          <div class="col-sm-6 col-lg-2"><label class="form-label" for="roleFilter">Responsible role</label><select id="roleFilter" class="form-select" dmx-on:change="escalationList.load({state:stateFilter.value,level:levelFilter.value,trigger:triggerFilter.value,policy:policyFilter.value,responsible_role:roleFilter.value,district_id:districtFilter.value,school_id:schoolFilter.value,ticket_number:ticketFilter.value,page:1,page_size:50}, true)"><option value="ALL">All roles</option><option value="TTPOST_LOGISTICS">TTPost Logistics</option><option value="REPAIR_CENTRE">Repair Centre</option><option value="MOE_HEAD_OFFICE">MOE Head Office</option></select></div>
          <div class="col-sm-6 col-lg-1"><label class="form-label" for="districtFilter">District</label><select id="districtFilter" class="form-select" dmx-on:change="escalationList.load({state:stateFilter.value,level:levelFilter.value,trigger:triggerFilter.value,policy:policyFilter.value,responsible_role:roleFilter.value,district_id:districtFilter.value,school_id:schoolFilter.value,ticket_number:ticketFilter.value,page:1,page_size:50}, true)"><option value="">All</option><option dmx-repeat="escalationOptions.data.districts" dmx-bind:value="id" dmx-text="name"></option></select></div>
          <div class="col-sm-6 col-lg-1"><label class="form-label" for="schoolFilter">School</label><select id="schoolFilter" class="form-select" dmx-on:change="escalationList.load({state:stateFilter.value,level:levelFilter.value,trigger:triggerFilter.value,policy:policyFilter.value,responsible_role:roleFilter.value,district_id:districtFilter.value,school_id:schoolFilter.value,ticket_number:ticketFilter.value,page:1,page_size:50}, true)"><option value="">All</option><option dmx-repeat="escalationOptions.data.schools" dmx-bind:value="id" dmx-text="name"></option></select></div>
          <div class="col-sm-8 col-lg-3"><label class="form-label" for="ticketFilter">Ticket number</label><input id="ticketFilter" type="search" class="form-control" placeholder="Search ticket" dmx-on:input="escalationList.load({state:stateFilter.value,level:levelFilter.value,trigger:triggerFilter.value,policy:policyFilter.value,responsible_role:roleFilter.value,district_id:districtFilter.value,school_id:schoolFilter.value,ticket_number:ticketFilter.value,page:1,page_size:50}, true)"></div>
          <div class="col-sm-6 col-lg-2"><div class="form-check form-switch monitoring-switch"><input class="form-check-input" type="checkbox" role="switch" id="openEscalationsSwitch" dmx-bind:checked="stateFilter.value == 'OPEN'" dmx-on:change="stateFilter.setValue(openEscalationsSwitch.checked ? 'OPEN' : 'ALL');escalationList.load({state:openEscalationsSwitch.checked ? 'OPEN' : 'ALL',level:levelFilter.value,trigger:triggerFilter.value,policy:policyFilter.value,responsible_role:roleFilter.value,district_id:districtFilter.value,school_id:schoolFilter.value,ticket_number:ticketFilter.value,page:1,page_size:50}, true)"><label class="form-check-label" for="openEscalationsSwitch">Open only</label></div></div>
          <div class="col-sm-6 col-lg-2"><div class="form-check form-switch monitoring-switch"><input class="form-check-input" type="checkbox" role="switch" id="escalationChartsSwitch" dmx-bind:checked="escalationChartsVisible.value" dmx-on:change="escalationChartsVisible.setValue(escalationChartsSwitch.checked)"><label class="form-check-label" for="escalationChartsSwitch">Show chart</label></div></div>
          <div class="col-12 d-flex justify-content-end"><button type="button" class="btn btn-bmobile-secondary btn-sm" dmx-on:click="stateFilter.setValue('ALL');levelFilter.setValue('');triggerFilter.setValue('ALL');policyFilter.setValue('ALL');roleFilter.setValue('ALL');districtFilter.setValue('');schoolFilter.setValue('');ticketFilter.setValue('');escalationList.load({state:'ALL',level:'',trigger:'ALL',policy:'ALL',responsible_role:'ALL',district_id:'',school_id:'',ticket_number:'',page:1,page_size:50}, true)">Clear filters</button></div>
        </div></section>
        <div class="monitoring-card mb-3" dmx-show="escalationChartsVisible.value"><div class="monitoring-card-heading"><div><h2 class="h6 mb-1">Loaded escalation mix</h2><p class="small text-muted mb-0">Counts reflect up to 50 matching results.</p></div></div><div class="monitoring-chart-grid">
          <div class="monitoring-chart-row"><span>Open</span><progress max="50" dmx-bind:value="escalationList.data.escalations.where('current_state_code', '==', 'OPEN').count()"></progress><strong dmx-text="escalationList.data.escalations.where('current_state_code', '==', 'OPEN').count()"></strong></div>
          <div class="monitoring-chart-row"><span>Acknowledged</span><progress max="50" dmx-bind:value="escalationList.data.escalations.where('current_state_code', '==', 'ACKNOWLEDGED').count()"></progress><strong dmx-text="escalationList.data.escalations.where('current_state_code', '==', 'ACKNOWLEDGED').count()"></strong></div>
          <div class="monitoring-chart-row"><span>Breached trigger</span><progress class="monitoring-progress-danger" max="50" dmx-bind:value="escalationList.data.escalations.where('current_trigger', '==', 'BREACHED').count()"></progress><strong dmx-text="escalationList.data.escalations.where('current_trigger', '==', 'BREACHED').count()"></strong></div>
        </div></div>
        <div class="text-muted py-3" role="status" dmx-show="escalationList.state.executing">Loading escalations...</div>
        <div class="table-responsive portal-table-wrapper"><table class="table portal-table align-middle"><thead><tr><th>Escalation</th><th>Level</th><th>State</th><th>Trigger</th><th>SLA Policy</th><th>Ticket</th><th>District / School</th><th>Responsible role</th><th>Opened</th><th>SLA Due</th><th>SLA State</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="escalationList.data.escalations"><tr><td><button type="button" class="btn btn-link p-0" dmx-on:click="escalationDetail.load({id:escalation_case_id}, true);escalationDetailModal.show()" dmx-text="escalation_number"></button></td><td dmx-text="current_level"></td><td dmx-text="current_state_name"></td><td dmx-text="current_trigger"></td><td dmx-text="policy_code_snapshot"></td><td><a dmx-bind:href="'/tickets/detail?id=' + ticket_id" dmx-text="ticket_number"></a></td><td><span dmx-text="district_name || '-' "></span> / <span dmx-text="school_name || '-' "></span></td><td dmx-text="responsible_roles"></td><td class="text-nowrap" dmx-text="opened_at_display"></td><td class="text-nowrap" dmx-text="sla_due_at_display"></td><td dmx-text="sla_state_name"></td></tr></tbody></table></div>
        <p class="text-muted mb-0" dmx-show="escalationList.data.escalations.length == 0">No escalations match these filters.</p>
      </section>
      <div id="escalationDetailModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="escalationDetailTitle" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="escalationDetailTitle" dmx-text="escalationDetail.data.escalation.escalation_number"></h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><dl class="row"><dt class="col-sm-3">State / Level</dt><dd class="col-sm-9"><span dmx-text="escalationDetail.data.escalation.current_state_name"></span> / Level <span dmx-text="escalationDetail.data.escalation.current_level"></span></dd><dt class="col-sm-3">Trigger / Responsible</dt><dd class="col-sm-9"><span dmx-text="escalationDetail.data.escalation.current_trigger"></span> / <span dmx-text="escalationDetail.data.escalation.responsible_roles"></span></dd><dt class="col-sm-3">Ticket / SLA</dt><dd class="col-sm-9"><span dmx-text="escalationDetail.data.escalation.ticket_number"></span> / <span dmx-text="escalationDetail.data.escalation.policy_code_snapshot"></span> (<span dmx-text="escalationDetail.data.escalation.sla_state_name"></span>)</dd><dt class="col-sm-3">SLA Start / Due</dt><dd class="col-sm-9"><span dmx-text="escalationDetail.data.escalation.sla_started_at_display"></span> / <span dmx-text="escalationDetail.data.escalation.sla_due_at_display"></span></dd><dt class="col-sm-3">District / School</dt><dd class="col-sm-9"><span dmx-text="escalationDetail.data.escalation.district_name || '-' "></span> / <span dmx-text="escalationDetail.data.escalation.school_name || '-' "></span></dd><dt class="col-sm-3">Repair Centre</dt><dd class="col-sm-9" dmx-text="escalationDetail.data.escalation.repair_centre_name || '-' "></dd><dt class="col-sm-3">Opened</dt><dd class="col-sm-9" dmx-text="escalationDetail.data.escalation.opened_at_display"></dd><dt class="col-sm-3">Acknowledged</dt><dd class="col-sm-9"><span dmx-text="escalationDetail.data.escalation.acknowledged_at ? escalationDetail.data.escalation.acknowledged_at.formatDate('MMM d, yyyy h:mm A') : 'Not acknowledged'"></span><span dmx-show="escalationDetail.data.escalation.acknowledged_by_name"> by <span dmx-text="escalationDetail.data.escalation.acknowledged_by_name"></span></span></dd><dt class="col-sm-3">Reason / Note</dt><dd class="col-sm-9"><span dmx-text="escalationDetail.data.escalation.reason_snapshot"></span><span dmx-show="escalationDetail.data.escalation.acknowledgement_note"> / <span dmx-text="escalationDetail.data.escalation.acknowledgement_note"></span></span></dd></dl>
        <h3 class="h6 mt-4">Assignments</h3><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Level</th><th>Trigger</th><th>Role</th><th>Reason</th><th>Assigned</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="escalationDetail.data.assignments"><tr><td dmx-text="level_snapshot"></td><td dmx-text="trigger_snapshot"></td><td dmx-text="target_role_name_snapshot"></td><td dmx-text="reason_snapshot"></td><td dmx-text="assigned_at.formatDate('MMM d, yyyy h:mm A')"></td></tr></tbody></table></div>
        <h3 class="h6 mt-4">History</h3><ol class="list-group list-group-flush" is="dmx-repeat" dmx-bind:repeat="escalationDetail.data.history"><li class="list-group-item px-0"><strong dmx-text="event_code"></strong> · <span dmx-text="event_at.formatDate('MMM d, yyyy h:mm A')"></span><span dmx-show="actor_name"> · <span dmx-text="actor_name"></span></span><div class="small text-muted" dmx-text="notes"></div></li></ol></div><div class="modal-footer"><button type="button" class="btn btn-bmobile-secondary" dmx-show="authContext.data.can_escalations_respond && escalationDetail.data.escalation.current_state_code == 'OPEN'" dmx-on:click="acknowledgementForm.reset(true);acknowledgementCaseId.setValue(escalationDetail.data.escalation.escalation_case_id);acknowledgeModal.show()">Acknowledge</button><button type="button" class="btn btn-bmobile-secondary" data-bs-dismiss="modal">Close</button></div></div></div></div>
      <dmx-value id="acknowledgementCaseId" value=""></dmx-value>
      <div id="acknowledgeModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="acknowledgeTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="acknowledgeTitle">Acknowledge escalation</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><form id="acknowledgementForm" is="dmx-serverconnect-form" method="post" action="/api/escalations/acknowledge" dmx-on:success="acknowledgeModal.hide();escalationNotice.setValue('Escalation acknowledged.');escalationList.load();escalationDetail.load({id:acknowledgementCaseId.value}, true)"><input type="hidden" name="escalation_case_id" dmx-bind:value="acknowledgementCaseId.value"><label class="form-label" for="acknowledgementNote">Note (optional)</label><textarea id="acknowledgementNote" name="acknowledgement_note" class="form-control" rows="3" maxlength="500"></textarea><div class="modal-footer px-0 pb-0"><button type="button" class="btn btn-bmobile-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-bmobile-primary">Confirm Acknowledgement</button></div></form></div></div></div></div>
    </main>
  </div>
</div>
