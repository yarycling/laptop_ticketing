<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="permanentReplacementDetailPage" appConnect="local" -->
<meta name="ac:route" content="/permanent-replacements/detail">
<div class="portal-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context"></dmx-serverconnect>
  <dmx-serverconnect id="replacementDetail" url="/api/permanent-replacements/detail" dmx-param:id="query.id"></dmx-serverconnect>
  <dmx-serverconnect id="sourceOptions" url="/api/permanent-replacements/source-options" dmx-param:replacement_case_id="query.id"></dmx-serverconnect>
  <dmx-value id="sourceMode" dmx-bind:value="'MANUFACTURER_SUPPLIED'"></dmx-value>
  <%- await include("partials/portal-sidebar", { currentPage: "permanent-replacements" }) %>
  <div class="portal-workspace"><%- await include("partials/portal-topbar", { backHref: "", pageTitle: "" }) %>
    <main class="portal-main phase8cd-mobile-tables service-page permanent-replacement-detail-page">
      <div id="sourceModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="sourceTitle" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content portal-modal">
        <div class="modal-header"><h2 class="modal-title h5" id="sourceTitle">Select Replacement Source</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <form id="sourceForm" is="dmx-serverconnect-form" method="post" action="/api/permanent-replacements/select" dmx-on:success="sourceModal.hide();sourceForm.reset(true);sourceMode.setValue('MANUFACTURER_SUPPLIED');replacementDetail.load();sourceOptions.load({replacement_case_id:query.id}, true);sourceNotice.setValue('Replacement source selected.')">
          <div class="modal-body">
            <div class="alert alert-danger" role="alert" dmx-show="sourceForm.lastError.status" dmx-text="sourceForm.lastError.response && sourceForm.lastError.response.error ? sourceForm.lastError.response.error : 'Replacement source could not be selected.'"></div>
            <input type="hidden" name="replacement_case_id" dmx-bind:value="query.id"><input type="hidden" name="source_type" dmx-bind:value="sourceMode.value">
            <div class="btn-group mb-3" role="group" aria-label="Replacement source"><button type="button" class="btn btn-outline-success" dmx-class:active="sourceMode.value == 'MANUFACTURER_SUPPLIED'" dmx-bind:aria-pressed="sourceMode.value == 'MANUFACTURER_SUPPLIED'" dmx-on:click="sourceMode.setValue('MANUFACTURER_SUPPLIED')">Manufacturer Supplied</button><button type="button" class="btn btn-outline-success" dmx-class:active="sourceMode.value == 'EXISTING_INVENTORY'" dmx-bind:aria-pressed="sourceMode.value == 'EXISTING_INVENTORY'" dmx-on:click="sourceMode.setValue('EXISTING_INVENTORY')">Existing Inventory</button></div>
            <section dmx-show="sourceMode.value == 'MANUFACTURER_SUPPLIED'"><div class="list-group" dmx-show="sourceOptions.data.manufacturer_candidates.length > 0"><label class="list-group-item" dmx-repeat="sourceOptions.data.manufacturer_candidates"><input class="form-check-input me-2" type="radio" name="staged_manufacturer_unit_id" dmx-bind:value="staged_unit_id" dmx-bind:disabled="sourceMode.value != 'MANUFACTURER_SUPPLIED'" dmx-bind:required="sourceMode.value == 'MANUFACTURER_SUPPLIED'"><strong dmx-text="manufacturer_name + ' / ' + (model_name || model_description || manufacturer_model_reference || 'Model not recorded')"></strong><span class="d-block small text-muted" dmx-text="'Staged unit #' + staged_unit_id + ' · received ' + received_at_display"></span></label></div><p class="text-muted mb-0" dmx-show="sourceOptions.data.manufacturer_candidates.length == 0">No eligible manufacturer-supplied units are available.</p></section>
            <section dmx-show="sourceMode.value == 'EXISTING_INVENTORY'"><div class="alert alert-warning" role="alert" dmx-show="sourceOptions.data.existing_inventory_blocked">Repair Centre stock is unavailable for this account.</div><div class="list-group" dmx-show="!sourceOptions.data.existing_inventory_blocked && sourceOptions.data.inventory_candidates.length > 0"><label class="list-group-item" dmx-repeat="sourceOptions.data.inventory_candidates"><input class="form-check-input me-2" type="radio" name="replacement_device_id" dmx-bind:value="device_id" dmx-bind:disabled="sourceMode.value != 'EXISTING_INVENTORY'" dmx-bind:required="sourceMode.value == 'EXISTING_INVENTORY'"><strong dmx-text="asset_tag || serial_number"></strong><span class="d-block small text-muted" dmx-text="manufacturer_name + ' / ' + model_name"></span><span class="d-block small text-muted" dmx-text="allocation_level + (school_name ? ' / ' + school_name : (district_name ? ' / ' + district_name : '')) + ' · ' + service_location_name"></span></label></div><p class="text-muted mb-0" dmx-show="!sourceOptions.data.existing_inventory_blocked && sourceOptions.data.inventory_candidates.length == 0">No eligible Repair Centre stock is available.</p></section>
          </div>
          <div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="sourceForm.state.executing || (sourceMode.value == 'MANUFACTURER_SUPPLIED' && sourceOptions.data.manufacturer_candidates.length == 0) || (sourceMode.value == 'EXISTING_INVENTORY' && (sourceOptions.data.existing_inventory_blocked || sourceOptions.data.inventory_candidates.length == 0))">Select Source</button></div>
        </form>
      </div></div></div>
      <div id="acceptModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="acceptTitle" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content portal-modal">
        <div class="modal-header"><h2 class="modal-title h5" id="acceptTitle">Accept Permanent Replacement</h2><button class="btn-close" type="button" dmx-on:click="acceptModal.hide()" aria-label="Close"></button></div>
        <form id="acceptForm" is="dmx-serverconnect-form" method="post" action="/api/permanent-replacements/accept" dmx-on:success="acceptModal.hide();acceptForm.reset(true);replacementDetail.load();sourceNotice.setValue('Permanent replacement accepted.')">
          <div class="modal-body">
            <div class="alert alert-danger" role="alert" dmx-show="acceptForm.lastError.status" dmx-text="acceptForm.lastError.response && acceptForm.lastError.response.error ? acceptForm.lastError.response.error : 'Permanent replacement could not be accepted.'"></div>
            <input type="hidden" name="replacement_case_id" dmx-bind:value="query.id">
            <dl class="row mb-3"><dt class="col-sm-5">Original Device</dt><dd class="col-sm-7" dmx-text="replacementDetail.data.case.original_asset_tag || replacementDetail.data.case.original_serial_number"></dd><dt class="col-sm-5">Replacement Source</dt><dd class="col-sm-7" dmx-text="replacementDetail.data.case.replacement_source_type == 'TEMPORARY_LOAN_CONVERSION' ? 'Temporary Loan Conversion' : (replacementDetail.data.active_temporary_loan.temporary_loan_case_id ? 'Issued Temporary Spare (conversion available)' : (replacementDetail.data.case.replacement_source_type == 'MANUFACTURER_SUPPLIED' ? 'Manufacturer Supplied' : (replacementDetail.data.case.replacement_source_type == 'EXISTING_INVENTORY' ? 'Existing Inventory' : 'Selection required')))"></dd><dt class="col-sm-5">Selected Unit</dt><dd class="col-sm-7" dmx-text="replacementDetail.data.case.replacement_source_type == 'MANUFACTURER_SUPPLIED' ? 'Staged unit #' + replacementDetail.data.case.staged_manufacturer_unit_id : (replacementDetail.data.case.replacement_asset_tag || replacementDetail.data.case.replacement_serial_number || replacementDetail.data.active_temporary_loan.selected_spare_asset_tag || replacementDetail.data.active_temporary_loan.selected_spare_serial_number || 'Not selected')"></dd><dt class="col-sm-5">Current Allocation</dt><dd class="col-sm-7" dmx-text="replacementDetail.data.case.phase5_custody_level + (replacementDetail.data.case.origin_school_name ? ' / ' + replacementDetail.data.case.origin_school_name : (replacementDetail.data.case.origin_district_name ? ' / ' + replacementDetail.data.case.origin_district_name : ''))"></dd></dl>
            <div class="mb-3" dmx-show="replacementDetail.data.case.replacement_source_type == 'MANUFACTURER_SUPPLIED' && !replacementDetail.data.staged_unit.resolved_model_id"><label class="form-label" for="resolvedModel">Device Model</label><select id="resolvedModel" name="resolved_model_id" class="form-select" dmx-bind:required="replacementDetail.data.case.replacement_source_type == 'MANUFACTURER_SUPPLIED' && !replacementDetail.data.staged_unit.resolved_model_id"><option value="">Select model</option><option dmx-repeat="replacementDetail.data.staged_model_options" dmx-bind:value="id" dmx-text="model_name"></option></select><div class="form-text" dmx-show="replacementDetail.data.staged_model_options.length == 0">No active model is available for this manufacturer.</div></div>
            <div class="alert alert-warning mb-0" role="alert">Acceptance marks the original device Replaced, transfers its educational allocation to the replacement, completes the ticket, and makes the replacement ready for return from the Repair Centre.</div>
          </div>
          <div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" dmx-on:click="acceptModal.hide()">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="acceptForm.state.executing || (replacementDetail.data.case.replacement_source_type == 'MANUFACTURER_SUPPLIED' && !replacementDetail.data.staged_unit.resolved_model_id && replacementDetail.data.staged_model_options.length == 0)">Accept Permanent Replacement</button></div>
        </form>
      </div></div></div>
      <dmx-value id="sourceNotice"></dmx-value>
      <div class="alert alert-danger" role="alert" dmx-show="replacementDetail.lastError.status" dmx-text="replacementDetail.lastError.response && replacementDetail.lastError.response.error ? replacementDetail.lastError.response.error : 'Permanent replacement detail could not be loaded.'"></div>
      <div class="alert alert-success" role="status" dmx-show="sourceNotice.value" dmx-text="sourceNotice.value"></div>
      <div class="permanent-replacement-page-heading"><a class="btn btn-bmobile-secondary btn-sm" href="/permanent-replacements" aria-label="Back"><i class="fas fa-arrow-left" aria-hidden="true"></i></a><h1>Permanent Replacement Detail</h1></div>
      <section class="permanent-replacement-summary" dmx-show="replacementDetail.data.case.replacement_case_id"><div class="permanent-replacement-summary-main"><span class="permanent-replacement-summary-icon"><i class="fas fa-laptop" aria-hidden="true"></i></span><div><p>Permanent Replacement</p><h2 dmx-text="replacementDetail.data.case.replacement_number"></h2><div><span dmx-text="replacementDetail.data.case.ticket_number"></span><span class="mx-2">·</span><span dmx-text="replacementDetail.data.case.original_serial_number"></span></div></div></div><span class="permanent-replacement-status" dmx-class:selection-required="replacementDetail.data.case.replacement_status_code == 'SELECTION_REQUIRED'" dmx-text="replacementDetail.data.case.replacement_status_name"></span></section>
      <section class="portal-section mb-3" dmx-show="replacementDetail.data.case.replacement_source_type == 'TEMPORARY_LOAN_CONVERSION'"><h2 class="h5">Temporary Loan Conversion</h2><dl class="row mb-0"><dt class="col-sm-4">Temporary Loan</dt><dd class="col-sm-8"><a dmx-bind:href="'/temporary-loans/detail?id=' + replacementDetail.data.case.temporary_loan_case_id" dmx-text="replacementDetail.data.case.loan_number"></a></dd><dt class="col-sm-4">Conversion Request</dt><dd class="col-sm-8" dmx-text="replacementDetail.data.case.conversion_request_number"></dd><dt class="col-sm-4">Converted Device</dt><dd class="col-sm-8" dmx-text="replacementDetail.data.conversion_loan.selected_spare_asset_tag || replacementDetail.data.conversion_loan.selected_spare_serial_number"></dd><dt class="col-sm-4">Current Loan Status</dt><dd class="col-sm-8" dmx-text="replacementDetail.data.conversion_loan.current_status_code"></dd><dt class="col-sm-4">Physical Custody</dt><dd class="col-sm-8" dmx-text="(replacementDetail.data.conversion_loan.physical_custody_code || 'Not recorded') + ' · with current temporary-loan recipient; recorded ' + (replacementDetail.data.conversion_loan.custody_recorded_at ? replacementDetail.data.conversion_loan.custody_recorded_at.formatDate('MMM d, yyyy, h:mm A') : 'date not recorded')"></dd><dt class="col-sm-4">Return Logistics</dt><dd class="col-sm-8">No Repair Centre stock return or Phase 7 return shipment was recorded for this conversion.</dd></dl></section>
      <section class="portal-section mb-3" dmx-show="replacementDetail.data.case.replacement_source_type == 'TEMPORARY_LOAN_CONVERSION'"><h2 class="h5">Service Fulfillment</h2><dl class="row mb-0"><dt class="col-sm-4">Source</dt><dd class="col-sm-8">Temporary Loan Conversion</dd><dt class="col-sm-4">Ticket</dt><dd class="col-sm-8" dmx-text="replacementDetail.data.conversion_loan.ticket_status_code"></dd><dt class="col-sm-4">Logistics</dt><dd class="col-sm-8" dmx-text="replacementDetail.data.conversion_loan.logistics_status_code"></dd><dt class="col-sm-4">Physical Fulfillment</dt><dd class="col-sm-8">Already with recipient</dd></dl></section>
      <div class="row g-3">
        <div class="col-lg-6"><section class="portal-section permanent-replacement-detail-card h-100"><h2 class="h5"><i class="fas fa-laptop" aria-hidden="true"></i> Original Device</h2><dl class="row mb-0"><dt class="col-sm-5">Serial</dt><dd class="col-sm-7" dmx-text="replacementDetail.data.case.original_serial_number"></dd><dt class="col-sm-5">Asset Tag</dt><dd class="col-sm-7" dmx-text="replacementDetail.data.case.original_asset_tag || 'Not recorded'"></dd><dt class="col-sm-5">Manufacturer / Model</dt><dd class="col-sm-7" dmx-text="replacementDetail.data.case.original_manufacturer_name + ' / ' + replacementDetail.data.case.original_model_name"></dd><dt class="col-sm-5">Lifecycle</dt><dd class="col-sm-7" dmx-text="replacementDetail.data.case.original_device_lifecycle_name"></dd></dl></section></div>
        <div class="col-lg-6"><section class="portal-section permanent-replacement-detail-card h-100"><h2 class="h5"><i class="fas fa-exchange-alt" aria-hidden="true"></i> Replacement Source</h2><dl class="row mb-0"><dt class="col-sm-5">Source Type</dt><dd class="col-sm-7" dmx-text="replacementDetail.data.case.replacement_source_type == 'TEMPORARY_LOAN_CONVERSION' ? 'Temporary Loan Conversion' : (replacementDetail.data.case.replacement_source_type == 'MANUFACTURER_SUPPLIED' ? 'Manufacturer Supplied' : (replacementDetail.data.case.replacement_source_type == 'EXISTING_INVENTORY' ? 'Existing Inventory' : 'Selection required'))"></dd><dt class="col-sm-5">Staged Unit</dt><dd class="col-sm-7" dmx-text="replacementDetail.data.case.staged_manufacturer_unit_id ? ('Staged unit #' + replacementDetail.data.case.staged_manufacturer_unit_id + ' · ' + (replacementDetail.data.case.staged_model_description || 'model not recorded')) : 'None selected'"></dd><dt class="col-sm-5">Replacement Device</dt><dd class="col-sm-7" dmx-text="replacementDetail.data.case.replacement_asset_tag || replacementDetail.data.case.replacement_serial_number || 'Not selected'"></dd><dt class="col-sm-5">Selected At</dt><dd class="col-sm-7" dmx-text="replacementDetail.data.selected_at_display || 'Not selected'"></dd><dt class="col-sm-5">Selected By</dt><dd class="col-sm-7" dmx-text="replacementDetail.data.selection.selected_by_display_name || 'Not selected'"></dd><dt class="col-sm-5">Status</dt><dd class="col-sm-7" dmx-text="replacementDetail.data.case.replacement_status_name"></dd></dl></section></div>
        <div class="col-12" dmx-show="replacementDetail.data.case.replacement_source_type == 'EXISTING_INVENTORY' && replacementDetail.data.case.replacement_status_code == 'REPLACEMENT_SELECTED'"><section class="portal-section permanent-replacement-detail-card"><h2 class="h5"><i class="fas fa-box" aria-hidden="true"></i> Selected Inventory Device</h2><dl class="row mb-0"><dt class="col-sm-3">Device</dt><dd class="col-sm-9" dmx-text="replacementDetail.data.case.replacement_asset_tag || replacementDetail.data.case.replacement_serial_number"></dd><dt class="col-sm-3">Manufacturer / Model</dt><dd class="col-sm-9" dmx-text="replacementDetail.data.selected_stock.manufacturer_name + ' / ' + replacementDetail.data.selected_stock.model_name"></dd><dt class="col-sm-3">Lifecycle</dt><dd class="col-sm-9" dmx-text="replacementDetail.data.selected_stock.lifecycle_code"></dd><dt class="col-sm-3">Phase 5 Allocation</dt><dd class="col-sm-9" dmx-text="replacementDetail.data.selected_stock.allocation_level + (replacementDetail.data.selected_stock.school_name ? ' / ' + replacementDetail.data.selected_stock.school_name : (replacementDetail.data.selected_stock.district_name ? ' / ' + replacementDetail.data.selected_stock.district_name : ''))"></dd><dt class="col-sm-3">Physical Stock Location</dt><dd class="col-sm-9" dmx-text="replacementDetail.data.selected_stock.service_location_name"></dd><dt class="col-sm-3">Stock Status</dt><dd class="col-sm-9" dmx-text="replacementDetail.data.selected_stock.stock_status"></dd><dt class="col-sm-3">Reservation</dt><dd class="col-sm-9" dmx-text="replacementDetail.data.selected_stock.is_reserved_for_replacement == 1 ? 'Reserved for Permanent Replacement' : 'Not reserved'"></dd></dl></section></div>
        <div class="col-lg-6" dmx-show="replacementDetail.data.case.exception_case_id"><section class="portal-section permanent-replacement-detail-card h-100"><h2 class="h5"><i class="far fa-file-alt" aria-hidden="true"></i> Exception Approval</h2><dl class="row mb-0"><dt class="col-sm-5">Exception</dt><dd class="col-sm-7"><a dmx-bind:href="'/exceptions/detail?id=' + replacementDetail.data.case.exception_case_id" dmx-text="'#' + replacementDetail.data.case.exception_case_id"></a></dd><dt class="col-sm-5">Exception Status</dt><dd class="col-sm-7" dmx-text="replacementDetail.data.case.exception_status_code"></dd><dt class="col-sm-5">Ticket</dt><dd class="col-sm-7"><a dmx-bind:href="'/tickets/detail?id=' + replacementDetail.data.case.ticket_id" dmx-text="replacementDetail.data.case.ticket_number"></a></dd><dt class="col-sm-5">Ticket Status</dt><dd class="col-sm-7" dmx-text="replacementDetail.data.case.ticket_status_name"></dd></dl></section></div>
        <div class="col-lg-6"><section class="portal-section permanent-replacement-detail-card h-100"><h2 class="h5"><i class="fas fa-users" aria-hidden="true"></i> Original Allocation (Before Replacement)</h2><dl class="row mb-0"><dt class="col-sm-5">Custody Level</dt><dd class="col-sm-7" dmx-text="replacementDetail.data.case.phase5_custody_level || 'Not allocated'"></dd><dt class="col-sm-5">District</dt><dd class="col-sm-7" dmx-text="replacementDetail.data.case.origin_district_name || '-' "></dd><dt class="col-sm-5">School</dt><dd class="col-sm-7" dmx-text="replacementDetail.data.case.origin_school_name || '-' "></dd><dt class="col-sm-5">Repair Centre</dt><dd class="col-sm-7" dmx-text="replacementDetail.data.case.repair_centre_name"></dd></dl></section></div>
        <div class="col-12" dmx-show="replacementDetail.data.case.replacement_status_code == 'COMPLETED' && replacementDetail.data.case.replacement_source_type != 'TEMPORARY_LOAN_CONVERSION'"><section class="portal-section permanent-replacement-detail-card"><h2 class="h5"><i class="fas fa-check-circle" aria-hidden="true"></i> Accepted Replacement</h2><dl class="row mb-0"><dt class="col-sm-3">Replacement Device</dt><dd class="col-sm-9" dmx-text="'#' + replacementDetail.data.replacement_device.id + ' / ' + (replacementDetail.data.replacement_device.asset_tag || replacementDetail.data.replacement_device.serial_number)"></dd><dt class="col-sm-3">Model / Lifecycle</dt><dd class="col-sm-9" dmx-text="replacementDetail.data.replacement_device.model_name + ' / ' + replacementDetail.data.replacement_device.lifecycle_code"></dd><dt class="col-sm-3">Transferred Allocation</dt><dd class="col-sm-9" dmx-text="replacementDetail.data.allocation_transfer.allocation_level + (replacementDetail.data.allocation_transfer.student_id ? ' / student #' + replacementDetail.data.allocation_transfer.student_id : (replacementDetail.data.case.origin_school_name ? ' / ' + replacementDetail.data.case.origin_school_name : (replacementDetail.data.case.origin_district_name ? ' / ' + replacementDetail.data.case.origin_district_name : '')))"></dd><dt class="col-sm-3">Original / Ticket / Logistics</dt><dd class="col-sm-9" dmx-text="replacementDetail.data.case.original_device_lifecycle_code + ' / ' + replacementDetail.data.case.ticket_status_code + ' / ' + replacementDetail.data.case.logistics_status_code"></dd><dt class="col-sm-3">Physical Return Device</dt><dd class="col-sm-9" dmx-text="'#' + replacementDetail.data.return_identity.return_device_id + ' / ' + (replacementDetail.data.replacement_device.asset_tag || replacementDetail.data.replacement_device.serial_number)"></dd><dt class="col-sm-3">Original Physical Status</dt><dd class="col-sm-9" dmx-text="replacementDetail.data.return_identity.original_replacement_physical_custody_code == 'MANUFACTURER_RETAINED_REPLACED' ? 'Manufacturer Retained / Replaced' : 'Repair Centre / Replaced Pending Disposition'"></dd><dt class="col-sm-3">Source</dt><dd class="col-sm-9" dmx-text="replacementDetail.data.case.replacement_source_type == 'TEMPORARY_LOAN_CONVERSION' ? 'Temporary loan spare permanently converted' : (replacementDetail.data.case.replacement_source_type == 'MANUFACTURER_SUPPLIED' ? 'Manufacturer supplied unit accepted' : 'Existing inventory reservation consumed')"></dd></dl></section></div>
        <div class="col-12" dmx-show="replacementDetail.data.case.replacement_status_code == 'COMPLETED' && replacementDetail.data.case.replacement_source_type != 'TEMPORARY_LOAN_CONVERSION'"><section class="portal-section permanent-replacement-detail-card"><div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2"><h2 class="h5 mb-0"><i class="fas fa-truck" aria-hidden="true"></i> Current Return Logistics</h2><a class="btn btn-bmobile-secondary btn-sm" dmx-bind:href="'/logistics/detail?id=' + replacementDetail.data.return_logistics.logistics_case_id">Open Logistics</a></div><dl class="row mb-0"><dt class="col-sm-3">Logistics Case</dt><dd class="col-sm-9" dmx-text="replacementDetail.data.return_logistics.logistics_number"></dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9" dmx-text="replacementDetail.data.return_logistics.current_logistics_status_name"></dd><dt class="col-sm-3">Replacement Custody</dt><dd class="col-sm-9" dmx-text="replacementDetail.data.return_custody.physical_state_code == 'TTPOST_RETURN_CUSTODY' ? 'TTPost Return Custody' : replacementDetail.data.return_custody.physical_state_code == 'PENDING_TTPOST_RETURN_RECEIPT' ? 'Awaiting TTPost Receipt' : replacementDetail.data.return_custody.physical_state_code == 'PENDING_SCHOOL_RETURN_RECEIPT' ? 'Awaiting School Receipt' : replacementDetail.data.return_logistics.returned_physical_state_code == 'RETURNED_TO_SCHOOL' ? 'Returned to School' : 'Ready at Repair Centre'"></dd><dt class="col-sm-3">Destination School</dt><dd class="col-sm-9" dmx-text="replacementDetail.data.return_logistics.allocation_school_name || 'No School destination in current allocation'"></dd></dl></section></div>
        <div class="col-12"><section class="portal-section permanent-replacement-detail-card permanent-replacement-history"><h2 class="h5"><i class="fas fa-history" aria-hidden="true"></i> Replacement History</h2><div class="table-responsive portal-table-wrapper"><table class="table portal-table align-middle"><thead><tr><th>Recorded</th><th>From</th><th>To</th><th>Reason</th><th>By</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="replacementDetail.data.history"><tr><td class="text-nowrap" dmx-text="recorded_at_display || 'Not recorded'"></td><td dmx-text="from_status_code || 'Created'"></td><td dmx-text="to_status_code"></td><td class="text-break" dmx-text="reason || '-' "></td><td dmx-text="actor_display_name || 'System'"></td></tr></tbody></table></div><p class="text-muted mb-0" dmx-show="replacementDetail.data.history.length == 0">No replacement history recorded.</p></section></div>
      </div>
      <section class="portal-section permanent-replacement-detail-card mb-3" dmx-show="replacementDetail.data.case.replacement_status_code == 'SELECTION_REQUIRED' && replacementDetail.data.active_temporary_loan.temporary_loan_case_id"><h2 class="h5"><i class="fas fa-laptop" aria-hidden="true"></i> Issued Temporary Spare</h2><p class="mb-2" dmx-text="replacementDetail.data.active_temporary_loan.current_status_code == 'CONVERSION_PENDING_HEAD_OFFICE' ? 'A permanent conversion request is awaiting Head Office approval. Once approved, this existing replacement case will be completed using the spare already issued.' : 'A spare is already issued for this ticket. Use the conversion request on its temporary loan to make that device the permanent replacement; you do not need to select another source.'"></p><a class="btn btn-bmobile-secondary btn-sm" dmx-bind:href="'/temporary-loans/detail?id=' + replacementDetail.data.active_temporary_loan.temporary_loan_case_id" dmx-text="'Open ' + replacementDetail.data.active_temporary_loan.loan_number"></a></section><section class="portal-section permanent-replacement-detail-card permanent-replacement-actions mt-3"><h2 class="h5"><i class="fas fa-bolt" aria-hidden="true"></i> Workflow Actions</h2><button class="btn btn-bmobile-primary permanent-replacement-action-button" type="button" dmx-show="authContext.data.can_replacements_select && replacementDetail.data.case.replacement_status_code == 'SELECTION_REQUIRED' && (!replacementDetail.data.active_temporary_loan.temporary_loan_case_id || replacementDetail.data.active_temporary_loan.conversion_request_status == 'REJECTED')" dmx-on:click="sourceMode.setValue('MANUFACTURER_SUPPLIED');sourceOptions.load({replacement_case_id:query.id}, true);sourceModal.show()"><i class="fas fa-exchange-alt" aria-hidden="true"></i> Select Replacement Source</button><button class="btn btn-bmobile-primary" type="button" dmx-show="authContext.data.can_replacements_accept && replacementDetail.data.case.replacement_status_code == 'REPLACEMENT_SELECTED'" dmx-on:click="acceptModal.show()">Accept Permanent Replacement</button><p class="small text-muted mb-0" dmx-show="replacementDetail.data.case.replacement_status_code == 'REPLACEMENT_SELECTED' && !authContext.data.can_replacements_accept">Acceptance is awaiting an authorized Repair Centre user.</p><p class="small text-muted mb-0" dmx-show="replacementDetail.data.case.replacement_status_code != 'SELECTION_REQUIRED' && replacementDetail.data.case.replacement_status_code != 'REPLACEMENT_SELECTED'">No workflow action is available for this status.</p></section>
    </main>
  </div>
</div>
