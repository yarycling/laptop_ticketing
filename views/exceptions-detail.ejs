<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="exceptionDetailPage" appConnect="local" components="{dmxBootstrap5Modal:{}}" -->
<meta name="ac:route" content="/exceptions/detail">
<div class="portal-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context" dmx-on:success="authContext.data.can_temporary_loans_view && exceptionDetail.data.case.ticket_id ? temporaryLoanSummary.load({ticket_id:exceptionDetail.data.case.ticket_id}, true) : null"></dmx-serverconnect>
  <dmx-serverconnect id="exceptionDetail" url="/api/exceptions/detail" dmx-param:id="query.id" dmx-on:success="manufacturerReturnSummary.load({ticket_id:exceptionDetail.data.case.ticket_id}, true);replacementSummary.load({exception_case_id:exceptionDetail.data.case.exception_case_id}, true);authContext.data.can_temporary_loans_view ? temporaryLoanSummary.load({ticket_id:exceptionDetail.data.case.ticket_id}, true) : null"></dmx-serverconnect>
  <dmx-serverconnect id="manufacturerReturnSummary" url="/api/manufacturer-returns/ticket-summary" noload="true"></dmx-serverconnect>
  <dmx-serverconnect id="replacementSummary" url="/api/permanent-replacements/ticket-summary" noload="true"></dmx-serverconnect>
  <dmx-serverconnect id="temporaryLoanSummary" url="/api/temporary-loans/ticket-summary" noload="true"></dmx-serverconnect>
  <dmx-value id="exceptionNotice" value=""></dmx-value><dmx-value id="decisionAction" value=""></dmx-value>
  <div id="assessmentModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="assessmentTitle" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="assessmentTitle">Record Warranty / Financial Assessment</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="assessmentForm" is="dmx-serverconnect-form" method="post" action="/api/exceptions/assessment/create" dmx-on:success="assessmentModal.hide();assessmentForm.reset(true);exceptionDetail.load();exceptionNotice.setValue('Assessment revision recorded.')"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="assessmentForm.lastError.status" dmx-text="assessmentForm.lastError.response && assessmentForm.lastError.response.error ? assessmentForm.lastError.response.error : 'Assessment could not be recorded.'"></div><input type="hidden" name="exception_case_id" dmx-bind:value="exceptionDetail.data.case.exception_case_id"><div class="row g-3"><div class="col-md-6"><label class="form-label" for="warrantyDecision">Warranty decision</label><select id="warrantyDecision" name="warranty_decision_code" class="form-select" required><option value="PENDING">Pending</option><option value="COVERED">Covered</option><option value="NOT_COVERED">Not Covered</option></select></div><div class="col-md-6" dmx-show="warrantyDecision.value == 'NOT_COVERED'"><label class="form-label" for="warrantyReason">Warranty rejection reason</label><textarea id="warrantyReason" name="warranty_rejection_reason" class="form-control" maxlength="1000" rows="2" dmx-bind:required="warrantyDecision.value == 'NOT_COVERED'"></textarea></div><div class="col-md-6"><label class="form-label" for="responsibilityParty">Responsibility party</label><select id="responsibilityParty" name="responsibility_party_code" class="form-select" required><option value="UNDETERMINED">Undetermined</option><option value="WARRANTY_MANUFACTURER">Warranty Manufacturer</option><option value="TSTT">TSTT</option><option value="MOE">Ministry of Education</option><option value="PARENT_GUARDIAN">Parent / Guardian</option></select></div><div class="col-md-6"><label class="form-label" for="negligence">Negligence / misuse determination</label><select id="negligence" name="negligence_determination_code" class="form-select" required><option value="NOT_ASSESSED">Not Assessed</option><option value="NO_EVIDENCE">No Evidence</option><option value="SUSPECTED">Suspected</option><option value="CONFIRMED">Confirmed</option></select></div><div class="col-md-4"><label class="form-label" for="estimatedCost">Estimated cost</label><input id="estimatedCost" name="estimated_cost" type="number" min="0" step="0.01" class="form-control"></div><div class="col-md-4"><label class="form-label" for="approvedCharge">Approved charge amount</label><input id="approvedCharge" name="approved_charge_amount" type="number" min="0" step="0.01" class="form-control"></div><div class="col-md-4"><label class="form-label" for="actualCost">Actual cost (if known)</label><input id="actualCost" name="actual_cost" type="number" min="0" step="0.01" class="form-control"></div><div class="col-md-6"><label class="form-label" for="financialStatus">Financial status</label><select id="financialStatus" name="financial_status_code" class="form-select" required><option value="PENDING">Pending</option><option value="ESTIMATED">Estimated</option><option value="APPROVED">Approved</option><option value="INCURRED">Incurred</option><option value="NOT_APPLICABLE">Not Applicable</option></select></div><div class="col-md-6"><label class="form-label" for="assessmentReference">Reference</label><input id="assessmentReference" name="reference" class="form-control" maxlength="120"></div><div class="col-12"><label class="form-label" for="assessmentNotes">Assessment notes</label><textarea id="assessmentNotes" name="notes" class="form-control" maxlength="4000" rows="3"></textarea></div></div><p class="small text-muted mt-3 mb-0">This records responsibility and cost information only; no payment is collected.</p></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="assessmentForm.state.executing">Save Assessment</button></div></form></div></div></div>
  <div id="districtDecisionModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="districtDecisionTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="districtDecisionTitle">Confirm District Decision</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="districtDecisionForm" is="dmx-serverconnect-form" method="post" action="/api/exceptions/district/decide" dmx-on:success="districtDecisionModal.hide();districtDecisionForm.reset(true);exceptionDetail.load();exceptionNotice.setValue('District decision recorded.')"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="districtDecisionForm.lastError.status" dmx-text="districtDecisionForm.lastError.response && districtDecisionForm.lastError.response.error ? districtDecisionForm.lastError.response.error : 'District decision could not be recorded.'"></div><input type="hidden" name="exception_case_id" dmx-bind:value="exceptionDetail.data.case.exception_case_id"><input type="hidden" name="action_code" dmx-bind:value="decisionAction.value"><p dmx-text="decisionAction.value == 'RETURN_FOR_REVIEW' ? 'Return this case to the Repair Centre for a new assessment revision?' : decisionAction.value == 'SELECT_PERMANENT_REPLACEMENT' ? 'Request Head Office approval for permanent replacement?' : 'Approve manufacturer return disposition?'"></p><div class="mb-2" dmx-show="decisionAction.value == 'RETURN_FOR_REVIEW'"><label class="form-label" for="districtReason">Reason for return</label><textarea id="districtReason" name="reason" class="form-control" maxlength="1000" rows="3" dmx-bind:required="decisionAction.value == 'RETURN_FOR_REVIEW'"></textarea></div></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="districtDecisionForm.state.executing">Confirm</button></div></form></div></div></div>
  <div id="headOfficeDecisionModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="headOfficeDecisionTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="headOfficeDecisionTitle">Confirm Head Office Decision</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="headOfficeDecisionForm" is="dmx-serverconnect-form" method="post" action="/api/exceptions/head-office/decide" dmx-on:success="headOfficeDecisionModal.hide();headOfficeDecisionForm.reset(true);exceptionDetail.load();exceptionNotice.setValue('Head Office decision recorded.')"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="headOfficeDecisionForm.lastError.status" dmx-text="headOfficeDecisionForm.lastError.response && headOfficeDecisionForm.lastError.response.error ? headOfficeDecisionForm.lastError.response.error : 'Head Office decision could not be recorded.'"></div><input type="hidden" name="exception_case_id" dmx-bind:value="exceptionDetail.data.case.exception_case_id"><input type="hidden" name="action_code" dmx-bind:value="decisionAction.value"><p dmx-text="decisionAction.value == 'RETURN_FOR_REVIEW' ? 'Return this case to the Repair Centre for a new assessment revision?' : 'Approve permanent replacement? This does not assign a replacement device; that occurs in Phase 8C.'"></p><div class="mb-2" dmx-show="decisionAction.value == 'RETURN_FOR_REVIEW'"><label class="form-label" for="headOfficeReason">Reason for return</label><textarea id="headOfficeReason" name="reason" class="form-control" maxlength="1000" rows="3" dmx-bind:required="decisionAction.value == 'RETURN_FOR_REVIEW'"></textarea></div></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="headOfficeDecisionForm.state.executing">Confirm</button></div></form></div></div></div>
  <%- await include("partials/portal-sidebar", { currentPage: "exceptions" }) %>
  <div class="portal-workspace"><%- await include("partials/portal-topbar", { backHref: "/exceptions", pageTitle: "Exception Detail" }) %>
    <main class="portal-main phase8cd-mobile-tables exception-detail-page">
      <div class="exception-page-heading"><div class="exception-breadcrumb"><a href="/exceptions" aria-label="Back to Exceptions"><i class="fas fa-arrow-left"></i></a><span>Exceptions</span><i class="fas fa-chevron-right"></i><span>Exception Detail</span></div><h1>Exception Detail</h1><p>View detailed information about this exception case, including operational state, repair disposition, assessments and history.</p></div>
      <div class="alert alert-success" role="status" dmx-show="exceptionNotice.value" dmx-text="exceptionNotice.value"></div><section class="portal-section mb-3" dmx-show="authContext.data.can_manufacturer_returns_view && manufacturerReturnSummary.data.summary.manufacturer_return_case_id"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2"><div><h2 class="h5 mb-1">Manufacturer Return</h2><p class="mb-0"><span dmx-text="manufacturerReturnSummary.data.summary.manufacturer_return_number"></span> · <span dmx-text="manufacturerReturnSummary.data.summary.manufacturer_return_status_name"></span></p></div><a class="btn btn-bmobile-secondary btn-sm" dmx-bind:href="'/manufacturer-returns/detail?id=' + manufacturerReturnSummary.data.summary.manufacturer_return_case_id">Open Manufacturer Return</a></div></section><section class="portal-section mb-3" dmx-show="authContext.data.can_replacements_view && replacementSummary.data.summary.replacement_case_id"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2"><div><h2 class="h5 mb-1">Permanent Replacement</h2><p class="mb-0"><span dmx-text="replacementSummary.data.summary.replacement_number"></span> · <span dmx-text="replacementSummary.data.summary.replacement_status_name"></span></p></div><a class="btn btn-bmobile-secondary btn-sm" dmx-bind:href="'/permanent-replacements/detail?id=' + replacementSummary.data.summary.replacement_case_id">Open Permanent Replacement</a></div></section><div class="alert alert-danger" role="alert" dmx-show="exceptionDetail.lastError.status" dmx-text="exceptionDetail.lastError.response && exceptionDetail.lastError.response.error ? exceptionDetail.lastError.response.error : 'Exception case could not be loaded.'"></div>
      <section class="portal-section mb-3" dmx-show="authContext.data.can_temporary_loans_view && temporaryLoanSummary.data.summary.temporary_loan_case_id"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2"><div><h2 class="h5 mb-1">Temporary Loan</h2><p class="mb-0"><span dmx-text="temporaryLoanSummary.data.summary.loan_number"></span> · <span dmx-text="temporaryLoanSummary.data.summary.loan_status_name"></span></p></div><a class="btn btn-bmobile-secondary btn-sm" dmx-bind:href="'/temporary-loans/detail?id=' + temporaryLoanSummary.data.summary.temporary_loan_case_id">Open Temporary Loan</a></div></section>
      <section class="portal-section exception-case-hero mb-3" dmx-show="exceptionDetail.data.case.exception_case_id"><div class="exception-device-icon"><i class="fas fa-laptop"></i></div><div class="exception-case-copy"><p class="text-muted mb-1">Exception Case <span dmx-text="exceptionDetail.data.case.exception_case_id"></span></p><h2 class="h3 mb-1" dmx-text="exceptionDetail.data.case.ticket_number + ' · ' + exceptionDetail.data.case.serial_number"></h2><p class="mb-0"><i class="fas fa-map-marker-alt me-2"></i><span dmx-text="exceptionDetail.data.case.school_name || 'School unavailable'"></span><span class="text-muted"> · </span><span dmx-text="exceptionDetail.data.case.district_name || 'District unavailable'"></span></p></div><span class="badge exception-status-badge" dmx-text="exceptionDetail.data.case.current_status_code"></span></section>
      <section class="portal-section mb-3" dmx-show="exceptionDetail.data.case.current_status_code == 'PERMANENT_REPLACEMENT_COMPLETED'"><h2 class="h5">Permanent Replacement Completed</h2><dl class="row mb-2"><dt class="col-sm-3">Original Device</dt><dd class="col-sm-9" dmx-text="exceptionDetail.data.case.serial_number + ' · Replaced'"></dd><dt class="col-sm-3">Current Replacement Device</dt><dd class="col-sm-9" dmx-text="replacementSummary.data.summary.replacement_serial_number"></dd><dt class="col-sm-3">Replacement</dt><dd class="col-sm-9" dmx-text="replacementSummary.data.summary.replacement_number"></dd></dl><div class="d-flex flex-wrap gap-2"><a class="btn btn-bmobile-secondary btn-sm" dmx-bind:href="'/permanent-replacements/detail?id=' + replacementSummary.data.summary.replacement_case_id">Open Replacement</a><a class="btn btn-bmobile-secondary btn-sm" dmx-bind:href="'/tickets/detail?id=' + exceptionDetail.data.case.ticket_id">Open Ticket</a><a class="btn btn-bmobile-secondary btn-sm" dmx-bind:href="'/logistics/detail?id=' + exceptionDetail.data.case.logistics_case_id">Open Logistics</a></div></section>
      <div class="row g-3 mb-3 exception-detail-grid"><div class="col-lg-6"><section class="portal-section exception-info-card h-100"><h2 class="h5"><span class="exception-section-icon"><i class="fas fa-cog"></i></span><span>Operational State</span></h2><p class="exception-section-subtitle">Current operational state and lifecycle information for this device.</p><dl class="row mb-0"><dt class="col-sm-5">Ticket State</dt><dd class="col-sm-7" dmx-text="exceptionDetail.data.case.ticket_status_code"></dd><dt class="col-sm-5">Logistics State</dt><dd class="col-sm-7" dmx-text="exceptionDetail.data.case.logistics_status_code"></dd><dt class="col-sm-5">Physical Custody</dt><dd class="col-sm-7" dmx-text="manufacturerReturnSummary.data.summary.physical_custody_code || exceptionDetail.data.case.physical_state_code"></dd><dt class="col-sm-5">Device Lifecycle</dt><dd class="col-sm-7" dmx-text="exceptionDetail.data.case.device_lifecycle_code"></dd></dl></section></div><div class="col-lg-6"><section class="portal-section exception-info-card h-100"><h2 class="h5"><span class="exception-section-icon"><i class="fas fa-wrench"></i></span><span>Repair Disposition</span></h2><p class="exception-section-subtitle">Outcome and recommended disposition from the repair process.</p><dl class="row mb-0"><dt class="col-sm-5">Repair Outcome</dt><dd class="col-sm-7" dmx-text="exceptionDetail.data.case.originating_outcome_code"></dd><dt class="col-sm-5">Recommended Disposition</dt><dd class="col-sm-7" dmx-text="exceptionDetail.data.case.recommended_disposition_code || 'District Decision Required'"></dd><dt class="col-sm-5">Repair Centre</dt><dd class="col-sm-7" dmx-text="exceptionDetail.data.case.repair_centre_name"></dd><dt class="col-sm-5">Logistics Reference</dt><dd class="col-sm-7" dmx-text="exceptionDetail.data.case.logistics_number"></dd></dl></section></div></div>
      <section class="portal-section exception-history-card mb-3"><div class="exception-section-header"><div class="exception-section-title"><span class="exception-section-icon"><i class="far fa-file-alt"></i></span><div><h2 class="h5 mb-0">Warranty / Financial Assessment</h2><p class="exception-section-subtitle">Append-only assessment revisions. No payment collection or invoice processing occurs here.</p></div></div><button type="button" class="btn btn-bmobile-primary btn-sm" dmx-show="authContext.data.can_exceptions_assess && (exceptionDetail.data.case.current_status_code == 'ASSESSMENT_REQUIRED' || exceptionDetail.data.case.current_status_code == 'REPAIR_CENTRE_REVIEW_REQUIRED')" dmx-on:click="assessmentForm.reset(true);assessmentModal.show()"><i class="fas fa-plus-circle me-2"></i>Record Assessment</button></div><div class="table-responsive portal-table-wrapper"><table class="table portal-table align-middle"><thead><tr><th>Recorded</th><th>Warranty</th><th>Responsibility</th><th>Negligence / Misuse</th><th>Estimated</th><th>Approved Charge</th><th>Actual Cost</th><th>Financial Status</th><th>Reference / Notes</th><th>Recorded By</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="exceptionDetail.data.assessments"><tr><td class="text-nowrap" dmx-text="recorded_at_display || 'Not recorded'"></td><td><span dmx-text="warranty_decision_code"></span><small class="d-block text-muted" dmx-text="warranty_rejection_reason || ''"></small></td><td dmx-text="responsibility_party_code"></td><td dmx-text="negligence_determination_code"></td><td dmx-text="estimated_cost == null ? '-' : estimated_cost.formatNumber(2)"></td><td dmx-text="approved_charge_amount == null ? '-' : approved_charge_amount.formatNumber(2)"></td><td dmx-text="actual_cost == null ? '-' : actual_cost.formatNumber(2)"></td><td dmx-text="financial_status_code"></td><td><span dmx-text="reference || '-' "></span><small class="d-block text-muted text-break" dmx-text="notes || ''"></small></td><td dmx-text="created_by || 'System'"></td></tr></tbody></table></div><div class="exception-empty-state" dmx-show="exceptionDetail.data.assessments.count() == 0"><span class="exception-empty-icon"><i class="far fa-file-alt"></i></span><strong>No financial assessment recorded.</strong><span>Assessment records will appear here when available.</span></div></section>
      <section class="portal-section exception-history-card mb-3"><div class="exception-section-header"><div class="exception-section-title"><span class="exception-section-icon exception-purple"><i class="far fa-file"></i></span><div><h2 class="h5 mb-0">Decision History</h2><p class="exception-section-subtitle">Record of decisions and disposition changes for this exception case.</p></div></div></div><div class="table-responsive portal-table-wrapper"><table class="table portal-table align-middle"><thead><tr><th>Recorded</th><th>Decision Type</th><th>Decision</th><th>Selected Disposition</th><th>Reason</th><th>Recorded By</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="exceptionDetail.data.decisions"><tr><td class="text-nowrap" dmx-text="recorded_at_display || 'Not recorded'"></td><td dmx-text="decision_type_code"></td><td dmx-text="decision_code"></td><td dmx-text="selected_disposition_code || '-' "></td><td class="text-break" dmx-text="reason || '-' "></td><td dmx-text="actor_display_name || 'System'"></td></tr></tbody></table></div><div class="exception-empty-state" dmx-show="exceptionDetail.data.decisions.count() == 0"><span class="exception-empty-icon"><i class="far fa-file"></i></span><strong>No decisions recorded.</strong><span>Decisions made on this exception case will appear here.</span></div></section>
      <section class="portal-section exception-history-card mb-3"><div class="exception-section-header"><div class="exception-section-title"><span class="exception-section-icon"><i class="far fa-clock"></i></span><div><h2 class="h5 mb-0">Status History</h2><p class="exception-section-subtitle">Chronological history of status changes for this exception case.</p></div></div></div><div class="table-responsive portal-table-wrapper"><table class="table portal-table align-middle"><thead><tr><th>Recorded</th><th>From</th><th>To</th><th>Reason</th><th>Recorded By</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="exceptionDetail.data.status_history"><tr><td class="text-nowrap" dmx-text="recorded_at_display || 'Not recorded'"></td><td dmx-text="from_status_code || 'Created'"></td><td dmx-text="to_status_code"></td><td class="text-break" dmx-text="reason || '-' "></td><td dmx-text="actor_display_name || 'System'"></td></tr></tbody></table></div></section>
      <section class="portal-section exception-actions-card"><div class="exception-section-header"><div class="exception-section-title"><span class="exception-section-icon"><i class="fas fa-bolt"></i></span><div><h2 class="h5 mb-0">Available Actions</h2><p class="exception-section-subtitle">Perform actions related to this exception case.</p></div></div></div><div class="exception-action-controls"><form id="submitExceptionForm" is="dmx-serverconnect-form" method="post" action="/api/exceptions/submit" class="d-flex flex-wrap gap-2" dmx-show="authContext.data.can_exceptions_submit && (exceptionDetail.data.case.current_status_code == 'ASSESSMENT_REQUIRED' || exceptionDetail.data.case.current_status_code == 'REPAIR_CENTRE_REVIEW_REQUIRED')" dmx-on:success="exceptionDetail.load();exceptionNotice.setValue('Exception review submitted.')"><input type="hidden" name="exception_case_id" dmx-bind:value="exceptionDetail.data.case.exception_case_id"><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="submitExceptionForm.state.executing || exceptionDetail.data.assessments.count() == 0">Submit Exception Review</button></form>
        <form id="startManufacturerReturnForm" is="dmx-serverconnect-form" method="post" action="/api/manufacturer-returns/start" class="d-flex flex-wrap gap-2 mt-2" dmx-show="authContext.data.can_manufacturer_returns_start && exceptionDetail.data.case.current_status_code == 'MANUFACTURER_RETURN_APPROVED' && !manufacturerReturnSummary.data.summary.manufacturer_return_case_id" dmx-on:success="exceptionDetail.load();manufacturerReturnSummary.load({ticket_id:exceptionDetail.data.case.ticket_id}, true);exceptionNotice.setValue('Manufacturer return processing started.')"><input type="hidden" name="exception_case_id" dmx-bind:value="exceptionDetail.data.case.exception_case_id"><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="startManufacturerReturnForm.state.executing">Start Manufacturer Return</button></form><div class="alert alert-danger mt-2" role="alert" dmx-show="startManufacturerReturnForm.lastError.status" dmx-text="startManufacturerReturnForm.lastError.response && startManufacturerReturnForm.lastError.response.error ? startManufacturerReturnForm.lastError.response.error : 'Manufacturer return could not be started.'"></div>
        <form id="startPermanentReplacementForm" is="dmx-serverconnect-form" method="post" action="/api/permanent-replacements/start" class="d-flex flex-wrap gap-2 mt-2" dmx-show="authContext.data.can_replacements_start && exceptionDetail.data.case.current_status_code == 'REPLACEMENT_APPROVED' && !replacementSummary.data.summary.replacement_case_id" dmx-on:success="exceptionDetail.load();replacementSummary.load({exception_case_id:exceptionDetail.data.case.exception_case_id}, true);exceptionNotice.setValue('Permanent replacement processing started.')"><input type="hidden" name="exception_case_id" dmx-bind:value="exceptionDetail.data.case.exception_case_id"><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="startPermanentReplacementForm.state.executing">Start Permanent Replacement</button></form><div class="alert alert-danger mt-2" role="alert" dmx-show="startPermanentReplacementForm.lastError.status" dmx-text="startPermanentReplacementForm.lastError.response && startPermanentReplacementForm.lastError.response.error ? startPermanentReplacementForm.lastError.response.error : 'Permanent replacement could not be started.'"></div>
        <div class="d-flex flex-wrap gap-2 mt-2" dmx-show="authContext.data.can_exceptions_district_decide && exceptionDetail.data.case.current_status_code == 'PENDING_DISTRICT_APPROVAL'"><button class="btn btn-bmobile-primary" type="button" dmx-on:click="decisionAction.setValue('APPROVE_MANUFACTURER_RETURN');districtDecisionForm.reset(true);districtDecisionModal.show()">Approve Manufacturer Return</button><button class="btn btn-bmobile-secondary" type="button" dmx-on:click="decisionAction.setValue('RETURN_FOR_REVIEW');districtDecisionForm.reset(true);districtDecisionModal.show()">Return for Review</button></div>
        <div class="d-flex flex-wrap gap-2 mt-2" dmx-show="authContext.data.can_exceptions_district_decide && exceptionDetail.data.case.current_status_code == 'PENDING_DISTRICT_DECISION'"><button class="btn btn-bmobile-primary" type="button" dmx-on:click="decisionAction.setValue('SELECT_MANUFACTURER_RETURN');districtDecisionForm.reset(true);districtDecisionModal.show()">Choose Manufacturer Return</button><button class="btn btn-bmobile-primary" type="button" dmx-on:click="decisionAction.setValue('SELECT_PERMANENT_REPLACEMENT');districtDecisionForm.reset(true);districtDecisionModal.show()">Choose Permanent Replacement</button><button class="btn btn-bmobile-secondary" type="button" dmx-on:click="decisionAction.setValue('RETURN_FOR_REVIEW');districtDecisionForm.reset(true);districtDecisionModal.show()">Return for Review</button></div>
        <div class="d-flex flex-wrap gap-2 mt-2" dmx-show="authContext.data.can_exceptions_head_office_approve && exceptionDetail.data.case.current_status_code == 'PENDING_HEAD_OFFICE_APPROVAL'"><button class="btn btn-bmobile-primary" type="button" dmx-on:click="decisionAction.setValue('APPROVE_REPLACEMENT');headOfficeDecisionForm.reset(true);headOfficeDecisionModal.show()">Approve Permanent Replacement</button><button class="btn btn-bmobile-secondary" type="button" dmx-on:click="decisionAction.setValue('RETURN_FOR_REVIEW');headOfficeDecisionForm.reset(true);headOfficeDecisionModal.show()">Return for Review</button></div>
        <div class="alert alert-info mt-3 mb-0" dmx-show="exceptionDetail.data.case.current_status_code == 'MANUFACTURER_RETURN_APPROVED'">Approved for Manufacturer Return. Awaiting Manufacturer Return Processing; shipment and RMA controls belong to Phase 8B.</div><div class="alert alert-info mt-3 mb-0" dmx-show="exceptionDetail.data.case.current_status_code == 'REPLACEMENT_APPROVED'">Permanent Replacement Approved. Awaiting Replacement Processing; approval does not select or assign a replacement device. Execution belongs to Phase 8C.</div></div>
      </section>
    </main>
  </div>
</div>
