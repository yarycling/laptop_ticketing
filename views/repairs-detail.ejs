<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="repairDetailPage" appConnect="local" components="{dmxBootstrap5Modal:{}}" -->
<meta name="ac:route" content="/repairs/detail">
<div class="portal-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context" dmx-on:success="authContext.data.can_temporary_loans_view && repairDetail.data.repair.ticket_id ? temporaryLoanSummary.load({ticket_id:repairDetail.data.repair.ticket_id}, true) : null"></dmx-serverconnect>
  <dmx-serverconnect id="repairDetail" url="/api/repairs/detail" dmx-param:id="query.id" dmx-on:success="manufacturerReturnSummary.load({ticket_id:repairDetail.data.repair.ticket_id}, true);authContext.data.can_temporary_loans_view ? temporaryLoanSummary.load({ticket_id:repairDetail.data.repair.ticket_id}, true) : null"></dmx-serverconnect>
  <dmx-serverconnect id="manufacturerReturnSummary" url="/api/manufacturer-returns/ticket-summary"></dmx-serverconnect>
  <dmx-serverconnect id="temporaryLoanSummary" url="/api/temporary-loans/ticket-summary" noload="true"></dmx-serverconnect>
  <dmx-serverconnect id="repairOutcomes" url="/api/repairs/outcomes"></dmx-serverconnect>
  <dmx-value id="repairNotice" value=""></dmx-value>
  <%- await include("partials/portal-sidebar", { currentPage: "repairs" }) %>
  <div class="portal-workspace"><%- await include("partials/portal-topbar", { backHref: "/repairs", pageTitle: "Repair Detail" }) %>
    <main class="portal-main service-page">
      <div id="assessmentModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="assessmentTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="assessmentTitle">Add Repair Assessment</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="assessmentForm" is="dmx-serverconnect-form" method="post" action="/api/repairs/assessment/create" dmx-on:success="assessmentModal.hide();assessmentForm.reset(true);repairDetail.load();repairNotice.setValue('Repair assessment recorded.')"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="assessmentForm.lastError.status" dmx-text="assessmentForm.lastError.response && assessmentForm.lastError.response.error ? assessmentForm.lastError.response.error : 'Assessment could not be recorded.'"></div><input type="hidden" name="repair_job_id" dmx-bind:value="repairDetail.data.repair.repair_job_id"><div class="mb-3"><label class="form-label" for="assessmentSummary">Assessment Summary <span aria-hidden="true">*</span></label><textarea id="assessmentSummary" name="assessment_summary" class="form-control" rows="4" maxlength="2000" required></textarea></div><div class="mb-3"><label class="form-label" for="suspectedCause">Suspected Cause</label><textarea id="suspectedCause" name="suspected_cause" class="form-control" rows="2" maxlength="1000"></textarea></div><div><label class="form-label" for="recommendedAction">Recommended Action</label><textarea id="recommendedAction" name="recommended_action" class="form-control" rows="2" maxlength="1000"></textarea></div><p class="small text-muted mt-3 mb-0">These are Repair Centre operational records.</p></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="assessmentForm.state.executing">Save Assessment</button></div></form></div></div></div>
      <div id="workModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="workTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="workTitle">Record Repair Work</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="workForm" is="dmx-serverconnect-form" method="post" action="/api/repairs/work/create" dmx-on:success="workModal.hide();workForm.reset(true);repairDetail.load();repairNotice.setValue('Repair work recorded.')"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="workForm.lastError.status" dmx-text="workForm.lastError.response && workForm.lastError.response.error ? workForm.lastError.response.error : 'Repair work could not be recorded.'"></div><input type="hidden" name="repair_job_id" dmx-bind:value="repairDetail.data.repair.repair_job_id"><div class="mb-3"><label class="form-label" for="actionSummary">Action Performed <span aria-hidden="true">*</span></label><textarea id="actionSummary" name="action_summary" class="form-control" rows="4" maxlength="2000" required></textarea></div><div><label class="form-label" for="resultSummary">Result / Observation</label><textarea id="resultSummary" name="result_summary" class="form-control" rows="3" maxlength="1000"></textarea></div></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="workForm.state.executing">Save Work Log</button></div></form></div></div></div>
      <div id="completeModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="completeTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="completeTitle">Complete Repair Processing</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="completeForm" is="dmx-serverconnect-form" method="post" action="/api/repairs/complete" dmx-on:success="completeModal.hide();completeForm.reset(true);repairDetail.load();repairNotice.setValue('Repair processing outcome recorded.')"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="completeForm.lastError.status" dmx-text="completeForm.lastError.response && completeForm.lastError.response.error ? completeForm.lastError.response.error : 'Repair completion could not be recorded.'"></div><input type="hidden" name="repair_job_id" dmx-bind:value="repairDetail.data.repair.repair_job_id"><div class="mb-3"><label class="form-label" for="completeOutcome">Outcome <span aria-hidden="true">*</span></label><select id="completeOutcome" name="outcome_code" class="form-select" required><option value="">Select outcome</option><option dmx-repeat="repairOutcomes.data.outcomes" dmx-bind:value="code" dmx-text="is_return_ready == 1 ? 'Return Ready — ' + name : 'Requires Further Disposition — ' + name"></option></select></div><div class="alert alert-info py-2" dmx-show="completeOutcome.value == 'REPAIRED_SUCCESSFULLY' || completeOutcome.value == 'NO_FAULT_FOUND'">This will complete repair processing, mark the ticket Completed, mark logistics Ready for Return, and restore the device operational lifecycle. The device remains physically at the Repair Centre until the return handoff is started.</div><div class="alert alert-warning py-2" dmx-show="completeOutcome.value && completeOutcome.value != 'REPAIRED_SUCCESSFULLY' && completeOutcome.value != 'NO_FAULT_FOUND'">This records the repair disposition. The ticket and logistics case will remain under repair / at the Repair Centre until the appropriate downstream workflow is performed.</div><div class="mb-3"><label class="form-label" for="completionSummary">Completion Summary <span aria-hidden="true">*</span></label><textarea id="completionSummary" name="completion_summary" class="form-control" rows="4" maxlength="2000" required></textarea></div></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="completeForm.state.executing || !completeOutcome.value">Complete Repair</button></div></form></div></div></div>
      <div class="alert alert-success" role="status" dmx-show="repairNotice.value" dmx-text="repairNotice.value"></div>
      <section class="portal-section mb-3" dmx-show="authContext.data.can_manufacturer_returns_view && manufacturerReturnSummary.data.summary.manufacturer_return_case_id"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2"><div><h2 class="h5 mb-1">Manufacturer Return</h2><p class="mb-0"><span dmx-text="manufacturerReturnSummary.data.summary.manufacturer_return_number"></span> · <span dmx-text="manufacturerReturnSummary.data.summary.manufacturer_return_status_name"></span></p></div><a class="btn btn-bmobile-secondary btn-sm" dmx-bind:href="'/manufacturer-returns/detail?id=' + manufacturerReturnSummary.data.summary.manufacturer_return_case_id">Open Manufacturer Return</a></div></section>
      <section class="portal-section mb-3" dmx-show="authContext.data.can_temporary_loans_view && temporaryLoanSummary.data.summary.temporary_loan_case_id"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2"><div><h2 class="h5 mb-1">Temporary Loan</h2><p class="mb-0"><span dmx-text="temporaryLoanSummary.data.summary.loan_number"></span> · <span dmx-text="temporaryLoanSummary.data.summary.loan_status_name"></span></p></div><a class="btn btn-bmobile-secondary btn-sm" dmx-bind:href="'/temporary-loans/detail?id=' + temporaryLoanSummary.data.summary.temporary_loan_case_id">Open Temporary Loan</a></div></section>
      <div class="alert alert-danger" role="alert" dmx-show="repairDetail.lastError.status" dmx-text="repairDetail.lastError.response && repairDetail.lastError.response.error ? repairDetail.lastError.response.error : 'Repair case could not be loaded.'"></div>
      <div class="repair-detail-layout" dmx-show="repairDetail.data.repair.logistics_case_id">
        <section class="repair-overview-card">
          <header class="repair-overview-heading"><div><span>Repair Case</span><h1 dmx-text="repairDetail.data.repair.logistics_number"></h1></div><span class="repair-state-pill" dmx-class:repair-state-active="repairDetail.data.repair.repair_state == 'IN_PROGRESS'" dmx-class:repair-state-ready="repairDetail.data.repair.repair_state == 'READY_FOR_RETURN'" dmx-text="repairDetail.data.repair.repair_state == 'AWAITING_REPAIR_START' ? 'Awaiting Repair Start' : repairDetail.data.repair.repair_state == 'IN_PROGRESS' ? 'In Progress' : repairDetail.data.repair.repair_state == 'READY_FOR_RETURN' ? 'Ready for Return' : 'Disposition Recorded'"></span></header>
          <div class="repair-overview-grid">
            <dl class="repair-overview-column">
              <div class="repair-overview-row"><span class="repair-overview-icon"><i class="fas fa-ticket-alt" aria-hidden="true"></i></span><dt>Ticket</dt><dd dmx-text="repairDetail.data.repair.ticket_number"></dd></div>
              <div class="repair-overview-row"><span class="repair-overview-icon"><i class="far fa-clipboard" aria-hidden="true"></i></span><dt>Ticket Status</dt><dd dmx-text="repairDetail.data.repair.ticket_status_code"></dd></div>
              <div class="repair-overview-row"><span class="repair-overview-icon"><i class="fas fa-laptop" aria-hidden="true"></i></span><dt>Device</dt><dd><span dmx-text="repairDetail.data.repair.serial_number"></span><span dmx-show="repairDetail.data.repair.asset_tag"> · <span dmx-text="repairDetail.data.repair.asset_tag"></span></span></dd></div>
              <div class="repair-overview-row"><span class="repair-overview-icon"><i class="fas fa-university" aria-hidden="true"></i></span><dt>Repair Centre</dt><dd dmx-text="repairDetail.data.repair.repair_centre_location_name"></dd></div>
              <div class="repair-overview-row"><span class="repair-overview-icon"><i class="fas fa-user-friends" aria-hidden="true"></i></span><dt>Physical Custody</dt><dd dmx-text="repairDetail.data.repair.physical_state_code == 'REPAIR_CENTRE_CUSTODY' ? 'Repair Centre' : repairDetail.data.repair.physical_state_code"></dd></div>
            </dl>
            <dl class="repair-overview-column">
              <div class="repair-overview-row"><span class="repair-overview-icon"><i class="fas fa-truck" aria-hidden="true"></i></span><dt>Logistics Status</dt><dd dmx-text="repairDetail.data.repair.logistics_status_code"></dd></div>
              <div class="repair-overview-row"><span class="repair-overview-icon"><i class="fas fa-sync-alt" aria-hidden="true"></i></span><dt>Device Lifecycle</dt><dd dmx-text="repairDetail.data.repair.device_lifecycle_code"></dd></div>
              <div class="repair-overview-row"><span class="repair-overview-icon"><i class="fas fa-graduation-cap" aria-hidden="true"></i></span><dt>Allocation Context</dt><dd dmx-text="repairDetail.data.repair.allocation_custody_level"></dd></div>
              <div class="repair-overview-row"><span class="repair-overview-icon"><i class="far fa-calendar-alt" aria-hidden="true"></i></span><dt>Started</dt><dd dmx-text="repairDetail.data.repair.started_at ? repairDetail.data.repair.started_at.formatDate('MMMM d, yyyy, h:mm A') + ' by ' + (repairDetail.data.repair.started_by_display_name || 'user') : 'Not started'"></dd></div>
              <div class="repair-overview-row" dmx-show="repairDetail.data.repair.completed_at"><span class="repair-overview-icon"><i class="far fa-check-circle" aria-hidden="true"></i></span><dt>Completed</dt><dd dmx-text="repairDetail.data.repair.completed_at.formatDate('MMMM d, yyyy, h:mm A') + ' by ' + (repairDetail.data.repair.completed_by_display_name || 'user')"></dd></div>
              <div class="repair-overview-row" dmx-show="repairDetail.data.repair.outcome_name"><span class="repair-overview-icon"><i class="fas fa-clipboard-check" aria-hidden="true"></i></span><dt>Outcome</dt><dd dmx-text="repairDetail.data.repair.outcome_name"></dd></div>
            </dl>
          </div>
          <div class="repair-detail-notices">
            <div class="alert alert-success" dmx-show="repairDetail.data.repair.repair_state == 'READY_FOR_RETURN'">Repair processing complete — awaiting return logistics.</div>
            <div class="alert alert-warning" dmx-show="repairDetail.data.repair.repair_state == 'DISPOSITION_RECORDED'">Downstream disposition workflow required. No return logistics has been started.</div>
            <div class="alert alert-info d-flex flex-wrap justify-content-between align-items-center gap-2" dmx-show="repairDetail.data.exception_summary.exception_case_id"><span>Exception disposition: <strong dmx-text="repairDetail.data.exception_summary.current_status_code"></strong></span><a class="btn btn-bmobile-secondary btn-sm" dmx-show="authContext.data.can_exceptions_view" dmx-bind:href="'/exceptions/detail?id=' + repairDetail.data.exception_summary.exception_case_id">Open Exception</a></div>
          </div>
          <form id="startRepairForm" class="repair-detail-actions" is="dmx-serverconnect-form" method="post" action="/api/repairs/start" dmx-on:success="startRepairForm.reset(true);repairDetail.load();repairNotice.setValue('Repair processing started.')" dmx-show="repairDetail.data.repair.repair_state == 'AWAITING_REPAIR_START' && authContext.data.can_repairs_start"><input type="hidden" name="logistics_case_id" dmx-bind:value="repairDetail.data.repair.logistics_case_id"><div class="alert alert-danger" role="alert" dmx-show="startRepairForm.lastError.status" dmx-text="startRepairForm.lastError.response && startRepairForm.lastError.response.error ? startRepairForm.lastError.response.error : 'Repair could not be started.'"></div><button class="btn btn-bmobile-primary repair-start-button" type="submit" aria-label="Start Repair" dmx-bind:disabled="startRepairForm.state.executing"><span class="visually-hidden">Start Repair</span></button></form>
          <div class="repair-detail-actions" dmx-show="repairDetail.data.repair.repair_state == 'IN_PROGRESS'"><button class="btn btn-bmobile-primary" type="button" dmx-show="authContext.data.can_repairs_assess" dmx-on:click="assessmentForm.reset(true);assessmentModal.show()"><i class="far fa-clipboard me-2" aria-hidden="true"></i>Add Assessment</button><button class="btn btn-bmobile-secondary" type="button" dmx-show="authContext.data.can_repairs_record_work" dmx-on:click="workForm.reset(true);workModal.show()"><i class="fas fa-wrench me-2" aria-hidden="true"></i>Record Repair Work</button><button class="btn btn-bmobile-primary" type="button" dmx-show="authContext.data.can_repairs_complete && repairDetail.data.assessments.count() > 0" dmx-on:click="completeForm.reset(true);repairOutcomes.load();completeModal.show()"><i class="fas fa-check me-2" aria-hidden="true"></i>Complete Repair</button></div>
        </section>

        <section class="repair-history-card">
          <header class="repair-history-heading"><span class="repair-history-icon"><i class="far fa-file-alt" aria-hidden="true"></i></span><div><h2>Assessment History</h2><p>List of repair assessments recorded for this case.</p></div></header>
          <div class="table-responsive portal-table-wrapper"><table class="table portal-table align-middle"><thead><tr><th>Recorded</th><th>Assessment Summary</th><th>Suspected Cause</th><th>Recommended Action</th><th>Recorded By</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="repairDetail.data.assessments"><tr><td class="text-nowrap" dmx-text="created_at_display"></td><td dmx-text="assessment_summary"></td><td dmx-text="suspected_cause || '-' "></td><td dmx-text="recommended_action || '-' "></td><td dmx-text="created_by_display_name || 'System'"></td></tr></tbody></table><div class="repair-history-empty" dmx-show="repairDetail.data.assessments.count() == 0"><span><i class="far fa-file-alt" aria-hidden="true"></i></span><strong>No repair assessments recorded.</strong><p>Assessments will appear here once they are added to this repair case.</p></div></div>
        </section>

        <section class="repair-history-card">
          <header class="repair-history-heading"><span class="repair-history-icon"><i class="fas fa-wrench" aria-hidden="true"></i></span><div><h2>Repair Work History</h2><p>List of repair work recorded for this case.</p></div></header>
          <div class="table-responsive portal-table-wrapper"><table class="table portal-table align-middle"><thead><tr><th>Recorded</th><th>Action Performed</th><th>Result / Observation</th><th>Recorded By</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="repairDetail.data.work_logs"><tr><td class="text-nowrap" dmx-text="created_at_display"></td><td dmx-text="action_summary"></td><td dmx-text="result_summary || '-' "></td><td dmx-text="created_by_display_name || 'System'"></td></tr></tbody></table><div class="repair-history-empty" dmx-show="repairDetail.data.work_logs.count() == 0"><span><i class="fas fa-wrench" aria-hidden="true"></i></span><strong>No repair work recorded.</strong><p>Repair work entries will appear here once they are added to this repair case.</p></div></div>
        </section>
      </div>
    </main>
  </div>
</div>
