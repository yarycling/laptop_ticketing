<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="studentAssignmentPage" appConnect="local" -->
<meta name="ac:route" content="/device-assignments/students">
<div class="portal-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context"></dmx-serverconnect>
  <dmx-serverconnect id="scopeContext" url="/api/auth/scope_context"></dmx-serverconnect>
  <dmx-serverconnect id="schoolOptions" url="/api/device-student-assignments/school-options"></dmx-serverconnect>
  <dmx-serverconnect id="schoolDevices" url="/api/device-student-assignments/school-devices" noload="true" dmx-param:school_id="schoolSelect.value" dmx-param:search="inventorySearch.value" dmx-param:manufacturer_id="manufacturerFilter.value" dmx-param:device_model_id="modelFilter.value" dmx-param:condition_id="conditionFilter.value" dmx-param:page="inventoryPage.value" dmx-param:page_size="25"></dmx-serverconnect>
  <dmx-serverconnect id="studentOptions" url="/api/device-student-assignments/student-options" noload="true" dmx-param:school_id="schoolSelect.value" dmx-param:search="studentSearch.value" dmx-param:page="studentPage.value" dmx-param:page_size="50"></dmx-serverconnect>
  <dmx-serverconnect id="studentAssignments" url="/api/device-student-assignments/list" dmx-param:status="assignmentStatus.value" dmx-param:school_id="schoolSelect.value" dmx-param:search="assignmentSearch.value" dmx-param:page="assignmentPage.value" dmx-param:page_size="25"></dmx-serverconnect>
  <dmx-serverconnect id="assignmentSummary" url="/api/device-student-assignments/summary"></dmx-serverconnect>
  <dmx-serverconnect id="assignmentDetail" url="/api/device-student-assignments/detail" noload="true"></dmx-serverconnect>
  <dmx-serverconnect id="deviceOptions" url="/api/devices/form-options"></dmx-serverconnect>
  <dmx-value id="selectedSchoolId" value=""></dmx-value>
  <dmx-value id="selectedDeviceId" value=""></dmx-value>
  <dmx-value id="selectedDeviceSerial" value=""></dmx-value>
  <dmx-value id="selectedDeviceAsset" value=""></dmx-value>
  <dmx-value id="selectedDeviceDistrict" value=""></dmx-value>
  <dmx-value id="selectedDeviceSchool" value=""></dmx-value>
  <dmx-value id="selectedDeviceManufacturer" value=""></dmx-value>
  <dmx-value id="selectedDeviceModel" value=""></dmx-value>
  <dmx-value id="selectedDeviceCondition" value=""></dmx-value>
  <dmx-value id="selectedDeviceWarranty" value=""></dmx-value>
  <dmx-value id="selectedDeviceImage" value=""></dmx-value>
  <dmx-value id="selectedStudentId" value=""></dmx-value>
  <dmx-value id="selectedStudentName" value=""></dmx-value>
  <dmx-value id="selectedStudentReference" value=""></dmx-value>
  <dmx-value id="selectedStudentSchoolId" value=""></dmx-value>
  <dmx-value id="returnAssignmentId" value=""></dmx-value>
  <dmx-value id="returnDeviceSerial" value=""></dmx-value>
  <dmx-value id="returnStudentName" value=""></dmx-value>
  <dmx-value id="returnSchoolName" value=""></dmx-value>
  <dmx-value id="inventoryPage" value="1"></dmx-value>
  <dmx-value id="assignmentPage" value="1"></dmx-value>
  <dmx-value id="studentPage" value="1"></dmx-value>
  <dmx-value id="assignmentNotice"></dmx-value>
  <%- await include("../partials/portal-sidebar", { currentPage: "student-assignment" }) %>
  <div class="portal-workspace">
    <%- await include("../partials/portal-topbar", { pageTitle: "Student Assignment" }) %>
    <main class="portal-main school-assignment-page">
      <section class="school-assignment-page-heading"><h1>Student Assignment</h1><p>Assign available school-held devices to active students at the same school.</p></section>
      <section class="district-allocation-hero student-assignment-hero" aria-label="Connecting students to learning"><div class="district-allocation-hero-copy"><div class="district-allocation-eyebrow">STUDENT ASSIGNMENT</div><h1>Connecting Students to Learning</h1><p>Assign school-held devices to active students<br class="d-none d-lg-block"> and keep every learner connected.</p></div></section>
      <div class="alert alert-success school-assignment-notice" role="status" dmx-show="assignmentNotice.value" dmx-text="assignmentNotice.value"></div>
      <div class="alert alert-danger school-assignment-error" role="alert" dmx-show="schoolDevices.lastError.status || studentAssignments.lastError.status" dmx-text="schoolDevices.lastError.response && schoolDevices.lastError.response.error ? schoolDevices.lastError.response.error : (studentAssignments.lastError.response && studentAssignments.lastError.response.error ? studentAssignments.lastError.response.error : 'Student assignments could not be loaded.')"></div>
      <section class="district-allocation-summary school-assignment-summary" aria-label="Student assignment overview">
        <article class="district-allocation-stat"><span class="district-allocation-stat-icon green"><i class="fas fa-laptop" aria-hidden="true"></i></span><div><strong dmx-text="assignmentSummary.data.school_available || 0">0</strong><h2>School Available</h2><p>Devices available at schools</p></div></article>
        <article class="district-allocation-stat"><span class="district-allocation-stat-icon green"><i class="fas fa-users" aria-hidden="true"></i></span><div><strong dmx-text="assignmentSummary.data.student_assigned || 0">0</strong><h2>Assigned to Students</h2><p>Devices currently assigned</p></div></article>
        <article class="district-allocation-stat"><span class="district-allocation-stat-icon green"><i class="fas fa-graduation-cap" aria-hidden="true"></i></span><div><strong dmx-text="assignmentSummary.data.students_with_devices || 0">0</strong><h2>Students with Devices</h2><p>Students currently supported</p></div></article>
      </section>
      <section class="school-assignment-school-card" aria-labelledby="schoolSelectLabel"><div class="school-assignment-school-heading"><span><i class="fas fa-school" aria-hidden="true"></i></span><div><label id="schoolSelectLabel" for="schoolSelect">School</label><p>Select a school to view its inventory and student assignments.</p></div></div><select id="schoolSelect" class="form-select" dmx-bind:value="selectedSchoolId.value" dmx-on:change="selectedSchoolId.setValue(schoolSelect.value);inventoryPage.setValue(1);studentPage.setValue(1);schoolDevices.load();studentOptions.load();studentAssignments.load()"><option value="">Select school</option><option dmx-repeat="schoolOptions.data.schools" dmx-bind:value="id" dmx-text="district_name + ' · ' + name"></option></select></section>
      <ul class="nav nav-tabs district-allocation-tabs school-assignment-tabs" role="tablist">
        <li class="nav-item"><button class="nav-link active" type="button" data-bs-toggle="tab" data-bs-target="#schoolInventoryPanel" role="tab"><i class="fas fa-laptop" aria-hidden="true"></i> School Inventory</button></li>
        <li class="nav-item"><button class="nav-link" type="button" data-bs-toggle="tab" data-bs-target="#studentAssignmentsPanel" role="tab"><i class="fas fa-user-graduate" aria-hidden="true"></i> Student Assignments</button></li>
      </ul>
      <div class="tab-content">
        <section class="tab-pane fade show active district-allocation-panel" id="schoolInventoryPanel" role="tabpanel">
          <div class="school-allocation-filter-heading"><span><i class="fas fa-filter" aria-hidden="true"></i></span><div><h2>Filter School Inventory</h2><p>Search devices by serial number, asset tag, manufacturer, model, or condition.</p></div></div>
          <div class="row g-2 mb-3">
            <div class="col-12 col-md-4"><label class="form-label" for="inventorySearch">Search inventory</label><input id="inventorySearch" class="form-control" placeholder="Serial, asset tag or reference" dmx-on:input="inventoryPage.setValue(1);schoolDevices.load()"></div>
            <div class="col-12 col-md-3"><label class="form-label" for="manufacturerFilter">Manufacturer</label><select id="manufacturerFilter" class="form-select" dmx-on:change="inventoryPage.setValue(1);schoolDevices.load()"><option value="">All manufacturers</option><option dmx-repeat="deviceOptions.data.manufacturers" dmx-bind:value="id" dmx-text="name"></option></select></div>
            <div class="col-12 col-md-3"><label class="form-label" for="modelFilter">Model</label><select id="modelFilter" class="form-select" dmx-on:change="inventoryPage.setValue(1);schoolDevices.load()"><option value="">All models</option><option dmx-repeat="deviceOptions.data.models" dmx-bind:value="id" dmx-text="manufacturer_name + ' · ' + model_name"></option></select></div>
            <div class="col-12 col-md-2"><label class="form-label" for="conditionFilter">Condition</label><select id="conditionFilter" class="form-select" dmx-on:change="inventoryPage.setValue(1);schoolDevices.load()"><option value="">All conditions</option><option dmx-repeat="deviceOptions.data.conditions" dmx-bind:value="id" dmx-text="name"></option></select></div>
          </div>
          <div class="table-responsive portal-table-wrapper"><table class="table portal-table align-middle district-allocation-table"><thead><tr><th>Serial</th><th>Asset Tag</th><th>Manufacturer / Model</th><th>Condition</th><th>Warranty</th><th>District</th><th>School</th><th>Allocated to School</th><th>Action</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="schoolDevices.data.devices"><tr><td><a dmx-bind:href="'/devices/detail?id=' + device_id" dmx-text="serial_number"></a></td><td dmx-text="asset_tag || '-'">-</td><td><span dmx-text="manufacturer"></span><br><small class="text-muted" dmx-text="model"></small></td><td dmx-text="condition"></td><td dmx-text="warranty_end_date ? warranty_end_date.formatDate('MMM d, yyyy') : 'Not recorded'"></td><td dmx-text="district_name"></td><td dmx-text="school_name"></td><td dmx-text="school_allocated_at.formatDate('MMM d, yyyy, hh:mm A')"></td><td><button class="btn btn-bmobile-primary btn-sm" type="button" dmx-show="authContext.data.can_device_student_assignments_manage" dmx-on:click="selectedDeviceId.setValue(device_id);selectedDeviceSerial.setValue(serial_number);selectedDeviceAsset.setValue(asset_tag || '');selectedDeviceDistrict.setValue(district_name);selectedDeviceSchool.setValue(school_name);selectedDeviceManufacturer.setValue(manufacturer);selectedDeviceModel.setValue(model);selectedDeviceCondition.setValue(condition);selectedDeviceWarranty.setValue(warranty_end_date ? 'Active until ' + warranty_end_date.formatDate('d MMM yyyy') : 'Not recorded');selectedDeviceImage.setValue(image_available ? '/api/devices/image?id=' + device_id : '');selectedStudentId.setValue('');studentSearch.setValue('');studentPage.setValue(1);studentOptions.load({school_id:schoolSelect.value});assignStudentModal.show()">Assign to Student</button></td></tr></tbody></table></div>
          <div class="district-allocation-empty" dmx-show="!schoolSelect.value || (!schoolDevices.state.executing && schoolDevices.data.success && schoolDevices.data.total == 0)"><span><i class="fas fa-laptop" aria-hidden="true"></i></span><strong dmx-text="schoolSelect.value ? 'No available devices' : 'Select a school'">Select a school</strong><p dmx-text="schoolSelect.value ? 'There are currently no devices matching your selected criteria.' : 'Choose a school to view its available devices.'">Choose a school to view its available devices.</p></div>
          <div class="d-flex justify-content-between align-items-center mt-2"><span class="text-muted" dmx-text="(schoolDevices.data.total || 0) + ' available devices'">0 available devices</span><div class="btn-group"><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-bind:disabled="inventoryPage.value <= 1" dmx-on:click="inventoryPage.setValue(inventoryPage.value - 1);schoolDevices.load()" aria-label="Previous page">‹</button><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-bind:disabled="inventoryPage.value >= schoolDevices.data.total_pages" dmx-on:click="inventoryPage.setValue(inventoryPage.value + 1);schoolDevices.load()" aria-label="Next page">›</button></div></div>
        </section>
        <section class="tab-pane fade district-allocation-panel" id="studentAssignmentsPanel" role="tabpanel">
          <div class="school-allocation-filter-heading"><span><i class="fas fa-filter" aria-hidden="true"></i></span><div><h2>Filter Student Assignments</h2><p>Assignment Status shows whether the student link is active; Device Lifecycle shows the device’s current operational state, such as In Repair.</p></div></div>
          <div class="row g-2 mb-3"><div class="col-12 col-md-8"><label class="form-label" for="assignmentSearch">Search assignments</label><input id="assignmentSearch" class="form-control" placeholder="Serial, asset tag, student or school" dmx-on:input="assignmentPage.setValue(1);studentAssignments.load()"></div><div class="col-12 col-md-4"><label class="form-label" for="assignmentStatus">Status</label><select id="assignmentStatus" class="form-select" dmx-on:change="assignmentPage.setValue(1);studentAssignments.load()"><option value="active">Active</option><option value="historical">Historical</option><option value="all">All</option></select></div></div>
          <div class="table-responsive portal-table-wrapper student-assignment-records-wrap"><table class="table portal-table align-middle student-assignment-records-table"><thead><tr><th>Serial</th><th>Asset Tag</th><th>Manufacturer / Model</th><th>District</th><th>School</th><th>Student Reference</th><th>Student Name</th><th>Type</th><th>Device Lifecycle</th><th>Assigned Date</th><th>Assigned By</th><th>Returned At</th><th>Returned By</th><th>Return Reason</th><th>Assignment Status</th><th>Action</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="studentAssignments.data.assignments"><tr><td><a dmx-bind:href="'/devices/detail?id=' + device_id" dmx-text="serial_number"></a></td><td dmx-text="asset_tag || '-'">-</td><td><span class="student-assignment-device-maker" dmx-text="manufacturer"></span><br><small class="text-muted" dmx-text="model"></small></td><td dmx-text="district_name"></td><td dmx-text="school_name"></td><td dmx-text="student_reference"></td><td dmx-text="first_name + ' ' + last_name"></td><td><span class="student-assignment-type-pill" dmx-text="assignment_type"></span></td><td><span class="student-assignment-lifecycle-pill" dmx-class:is-in-repair="lifecycle == 'IN_REPAIR'" dmx-class:is-replaced="lifecycle == 'REPLACED'" dmx-class:is-available="lifecycle == 'AVAILABLE'" dmx-text="lifecycle"></span></td><td dmx-text="assigned_at.formatDate('MMM d, yyyy, hh:mm A')"></td><td dmx-text="assigned_by || '-'">-</td><td dmx-text="returned_at ? returned_at.formatDate('MMM d, yyyy, hh:mm A') : '-'">-</td><td dmx-text="returned_by || '-'">-</td><td class="text-break" dmx-text="return_reason || '-'">-</td><td><span class="student-assignment-status-pill" dmx-class:is-active="is_active == 1" dmx-class:is-returned="is_active != 1"><i aria-hidden="true"></i><span dmx-text="is_active == 1 ? 'Assigned' : 'Returned'">Assigned</span></span></td><td class="text-nowrap student-assignment-actions"><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-on:click="assignmentDetail.load({id:student_assignment_id});assignmentDetailModal.show()">View</button> <button class="btn btn-bmobile-primary btn-sm" type="button" dmx-show="is_active == 1 && authContext.data.can_device_student_returns_manage && (authContext.data.is_super_admin || scopeContext.data.has_national_scope || scopeContext.data.schools.flatten('id').contains(school_id))" dmx-on:click="returnAssignmentId.setValue(student_assignment_id);returnDeviceSerial.setValue(serial_number);returnStudentName.setValue(student_reference + ' — ' + first_name + ' ' + last_name);returnSchoolName.setValue(school_name);returnStudentModal.show()">Return to School</button></td></tr></tbody></table></div>
          <div class="district-allocation-empty" dmx-show="studentAssignments.data.total == 0"><span><i class="fas fa-user-graduate" aria-hidden="true"></i></span><strong>No student assignments found</strong><p>No assignments match your current search and filters.</p></div>
          <div class="d-flex justify-content-between align-items-center mt-2"><span class="text-muted" dmx-text="(studentAssignments.data.total || 0) + ' assignments'">0 assignments</span><div class="btn-group"><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-bind:disabled="assignmentPage.value <= 1" dmx-on:click="assignmentPage.setValue(assignmentPage.value - 1);studentAssignments.load()" aria-label="Previous page">‹</button><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-bind:disabled="assignmentPage.value >= studentAssignments.data.total_pages" dmx-on:click="assignmentPage.setValue(assignmentPage.value + 1);studentAssignments.load()" aria-label="Next page">›</button></div></div>
        </section>
      </div>
    </main>
  </div>
</div>
<div id="assignStudentModal" is="dmx-bs5-modal" class="modal assign-student-modal" tabindex="-1" aria-labelledby="assignStudentTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-xl"><div class="modal-content portal-modal assign-student-dialog"><div class="assign-student-banner"><div class="assign-student-banner-icon"><i class="fas fa-laptop" aria-hidden="true"></i></div><div class="assign-student-banner-copy"><span>ASSIGN DEVICE</span><h2 id="assignStudentTitle">Assign Device to Student</h2><p>Allocate a device from your inventory to a student and<br class="d-none d-md-block"> give them access to learning.</p></div><div class="assign-student-banner-art" aria-hidden="true"><i class="fas fa-laptop"></i><i class="fas fa-user-graduate"></i></div><button class="btn-close assign-student-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="assignStudentForm" is="dmx-serverconnect-form" method="post" action="/api/device-student-assignments/assign" dmx-on:success="assignStudentModal.hide();schoolDevices.load();studentAssignments.load();assignmentSummary.load();assignmentNotice.setValue('Device assigned to student successfully.');assignStudentForm.reset(true);studentSearch.setValue('')"><div class="modal-body assign-student-body"><div class="alert alert-danger" role="alert" dmx-show="studentOptions.lastError.status" dmx-text="studentOptions.lastError.response && studentOptions.lastError.response.error ? studentOptions.lastError.response.error : 'Student options could not be loaded.'"></div><div class="alert alert-danger" role="alert" dmx-show="assignStudentForm.lastError.status" dmx-text="assignStudentForm.lastError.response && assignStudentForm.lastError.response.error ? assignStudentForm.lastError.response.error : 'The device could not be assigned.'"></div><input type="hidden" name="device_id" dmx-bind:value="selectedDeviceId.value"><input type="hidden" name="student_id" dmx-bind:value="selectedStudentId.value"><section class="assign-modal-step"><div class="assign-modal-step-heading"><span class="assign-modal-step-number">1</span><div><h3>Device Information</h3><p>Review the selected device details.</p></div><a class="btn btn-bmobile-secondary btn-sm" href="#schoolInventoryPanel" data-bs-dismiss="modal"><i class="fas fa-exchange-alt me-1" aria-hidden="true"></i>Change Device</a></div><div class="assign-device-card"><div class="assign-device-image"><img dmx-show="selectedDeviceImage.value" dmx-bind:src="selectedDeviceImage.value" dmx-bind:alt="'Device image for ' + selectedDeviceSerial.value"><div class="assign-no-image" dmx-show="!selectedDeviceImage.value"><i class="fas fa-laptop" aria-hidden="true"></i><span>No image provided</span></div></div><div class="assign-device-fields"><div><span>Device</span><strong dmx-text="selectedDeviceSerial.value"></strong></div><div><span>Asset Tag</span><strong dmx-text="selectedDeviceAsset.value || 'Not recorded'"></strong></div><div><span>Manufacturer</span><strong dmx-text="selectedDeviceManufacturer.value || 'Not recorded'"></strong></div><div><span>Model</span><strong dmx-text="selectedDeviceModel.value || 'Not recorded'"></strong></div></div><div class="assign-device-fields assign-device-fields-secondary"><div><span>Condition</span><strong dmx-text="selectedDeviceCondition.value || 'Not recorded'"></strong></div><div><span>District</span><strong dmx-text="selectedDeviceDistrict.value"></strong></div><div><span>School</span><strong dmx-text="selectedDeviceSchool.value"></strong></div><div><span>Warranty</span><strong class="assign-warranty-badge" dmx-text="selectedDeviceWarranty.value"></strong></div></div></div></section><section class="assign-modal-step assign-student-step"><div class="assign-modal-step-heading"><span class="assign-modal-step-number">2</span><div><h3>Find and Select Student</h3><p>Search for a student by reference, name or school ID.</p></div></div><label class="form-label" for="studentSearch">Search student</label><div class="assign-student-search"><i class="fas fa-search" aria-hidden="true"></i><input id="studentSearch" class="form-control" placeholder="Enter reference number, student name or school ID..." dmx-on:input.debounce:250="selectedStudentId.setValue('');studentPage.setValue(1);studentOptions.load({school_id:schoolSelect.value,search:studentSearch.value,page:1,page_size:50},true)"></div><div class="table-responsive assign-student-table-wrap mt-2"><table class="table portal-table align-middle assign-student-table mb-0"><thead><tr><th scope="col">Student Name</th><th scope="col">Reference Number</th><th scope="col">Student ID</th><th scope="col" class="text-end">Select</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="studentOptions.data.students"><tr dmx-class:table-success="student_id.toString() == selectedStudentId.value"><td dmx-text="first_name + ' ' + last_name"></td><td dmx-text="student_reference"></td><td dmx-text="school_student_id_number || 'Not recorded'"></td><td class="text-end"><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-on:click="selectedStudentId.setValue(student_id);selectedStudentName.setValue(first_name + ' ' + last_name);selectedStudentReference.setValue(student_reference);selectedStudentSchoolId.setValue(school_student_id_number || 'Not recorded')" dmx-bind:aria-pressed="student_id.toString() == selectedStudentId.value" dmx-text="student_id.toString() == selectedStudentId.value ? 'Selected' : 'Select'"></button></td></tr></tbody></table><div class="assign-student-table-empty" dmx-show="!studentOptions.state.executing && studentOptions.data.success && studentOptions.data.total == 0">No students match your search.</div></div><div class="d-flex justify-content-between align-items-center mt-2" dmx-show="studentOptions.data.total_pages > 1"><span class="small text-muted" dmx-text="'Page ' + studentPage.value + ' of ' + studentOptions.data.total_pages"></span><div class="btn-group"><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-bind:disabled="studentPage.value <= 1 || studentOptions.state.executing" dmx-on:click="studentPage.setValue(studentPage.value - 1);studentOptions.load()" aria-label="Previous student page">‹</button><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-bind:disabled="studentPage.value >= studentOptions.data.total_pages || studentOptions.state.executing" dmx-on:click="studentPage.setValue(studentPage.value + 1);studentOptions.load()" aria-label="Next student page">›</button></div></div><div class="assign-selected-student" dmx-show="selectedStudentId.value"><span class="assign-selected-student-avatar"><i class="fas fa-user" aria-hidden="true"></i><i class="fas fa-graduation-cap" aria-hidden="true"></i></span><div class="assign-selected-student-copy"><strong dmx-text="selectedStudentName.value"></strong><span dmx-text="(selectedStudentSchoolId.value && selectedStudentSchoolId.value != 'Not recorded' ? 'Student ID: ' + selectedStudentSchoolId.value : 'Reference: ' + selectedStudentReference.value) + '  ·  School: ' + selectedDeviceSchool.value"></span></div><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-on:click="studentAssignmentDetailsModal.show()"><i class="fas fa-eye me-1" aria-hidden="true"></i>View Details</button></div><label class="form-label mt-3" for="assignmentNotes">Notes (optional)</label><textarea id="assignmentNotes" name="notes" class="form-control" maxlength="2000" rows="2"></textarea><div class="assign-info-note"><i class="fas fa-info-circle" aria-hidden="true"></i><div><strong>You are assigning this device to the selected student.</strong><span>The device lifecycle will change from Available to Assigned.</span></div></div></section></div><div class="modal-footer assign-student-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="assignStudentForm.state.executing || !selectedStudentId.value"><i class="fas fa-user-plus me-1" aria-hidden="true"></i>Assign Device</button></div></form></div></div></div>
<div id="studentAssignmentDetailsModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="studentAssignmentDetailsTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="studentAssignmentDetailsTitle">Student Details</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><dl class="row mb-0"><dt class="col-5">Student</dt><dd class="col-7" dmx-text="selectedStudentName.value"></dd><dt class="col-5">Reference</dt><dd class="col-7" dmx-text="selectedStudentReference.value"></dd><dt class="col-5">School ID</dt><dd class="col-7" dmx-text="selectedStudentSchoolId.value || 'Not recorded'"></dd><dt class="col-5">School</dt><dd class="col-7" dmx-text="selectedDeviceSchool.value"></dd></dl></div></div></div></div>
<div id="assignmentDetailModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="assignmentDetailTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="assignmentDetailTitle">Student Assignment</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="text-muted" dmx-show="assignmentDetail.state.executing">Loading assignment...</div><dl class="row mb-0"><dt class="col-5">Device</dt><dd class="col-7"><a dmx-bind:href="'/devices/detail?id=' + assignmentDetail.data.assignment.device_id" dmx-text="assignmentDetail.data.assignment.serial_number"></a></dd><dt class="col-5">Student</dt><dd class="col-7" dmx-text="assignmentDetail.data.assignment.student_reference + ' — ' + assignmentDetail.data.assignment.first_name + ' ' + assignmentDetail.data.assignment.last_name"></dd><dt class="col-5">District</dt><dd class="col-7" dmx-text="assignmentDetail.data.assignment.district_name"></dd><dt class="col-5">School</dt><dd class="col-7" dmx-text="assignmentDetail.data.assignment.school_name"></dd><dt class="col-5">Assignment Type</dt><dd class="col-7" dmx-text="assignmentDetail.data.assignment.assignment_type"></dd><dt class="col-5">Assignment Status</dt><dd class="col-7" dmx-text="assignmentDetail.data.assignment.is_active == 1 ? 'Assigned' : 'Returned'"></dd><dt class="col-5">Device Lifecycle</dt><dd class="col-7" dmx-text="assignmentDetail.data.assignment.lifecycle"></dd><dt class="col-5">Assigned</dt><dd class="col-7" dmx-text="assignmentDetail.data.assignment.assigned_at.formatDate('MMM d, yyyy, hh:mm A')"></dd><dt class="col-5">Assigned By</dt><dd class="col-7" dmx-text="assignmentDetail.data.assignment.assigned_by"></dd><dt class="col-5">Current Custody</dt><dd class="col-7" dmx-text="assignmentDetail.data.assignment.current_custody_level"></dd><dt class="col-5" dmx-show="assignmentDetail.data.assignment.returned_at">Returned</dt><dd class="col-7" dmx-show="assignmentDetail.data.assignment.returned_at" dmx-text="assignmentDetail.data.assignment.returned_at.formatDate('MMM d, yyyy, hh:mm A')"></dd><dt class="col-5" dmx-show="assignmentDetail.data.assignment.return_reason">Return Reason</dt><dd class="col-7" dmx-show="assignmentDetail.data.assignment.return_reason" dmx-text="assignmentDetail.data.assignment.return_reason"></dd></dl></div></div></div></div>
<div id="returnStudentModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="returnStudentTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="returnStudentTitle">Return Device to School</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="returnStudentForm" is="dmx-serverconnect-form" method="post" action="/api/device-student-assignments/return" dmx-on:success="returnStudentModal.hide();studentAssignments.load();schoolDevices.load();assignmentSummary.load();assignmentNotice.setValue('Device returned to School inventory and is available for reassignment.');returnStudentForm.reset(true);returnAssignmentId.setValue('')"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="returnStudentForm.lastError.status" dmx-text="returnStudentForm.lastError.response && returnStudentForm.lastError.response.error ? returnStudentForm.lastError.response.error : 'The device could not be returned.'"></div><input type="hidden" name="student_assignment_id" dmx-bind:value="returnAssignmentId.value"><dl class="row"><dt class="col-4">Device</dt><dd class="col-8" dmx-text="returnDeviceSerial.value"></dd><dt class="col-4">Student</dt><dd class="col-8" dmx-text="returnStudentName.value"></dd><dt class="col-4">School</dt><dd class="col-8" dmx-text="returnSchoolName.value"></dd><dt class="col-4">Current lifecycle</dt><dd class="col-8">Assigned</dd><dt class="col-4">Resulting lifecycle</dt><dd class="col-8">Available</dd></dl><p dmx-text="'Return device ' + returnDeviceSerial.value + ' from ' + returnStudentName.value + ' to ' + returnSchoolName.value + '? The device will become Available in School inventory.'"></p><label class="form-label" for="studentReturnReason">Return reason (required)</label><textarea id="studentReturnReason" name="return_reason" class="form-control" maxlength="500" required aria-describedby="studentReturnReasonHelp"></textarea><div id="studentReturnReasonHelp" class="form-text">Enter a reason for the return before submitting.</div></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="returnStudentForm.state.executing">Return to School</button></div></form></div></div></div>

