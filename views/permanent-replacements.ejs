<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="permanentReplacementsPage" appConnect="local" -->
<meta name="ac:route" content="/permanent-replacements">
<div class="portal-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context"></dmx-serverconnect>
  <dmx-serverconnect id="replacementList" url="/api/permanent-replacements/list" dmx-param:status="statusFilter.value" dmx-param:district_id="districtFilter.value" dmx-param:repair_centre_id="repairCentreFilter.value" dmx-param:search="searchInput.value"></dmx-serverconnect>
  <dmx-serverconnect id="replacementFilterOptions" url="/api/permanent-replacements/filter-options"></dmx-serverconnect>
  <dmx-value id="replacementChartsVisible" value="true"></dmx-value>
  <%- await include("partials/portal-sidebar", { currentPage: "permanent-replacements" }) %>
  <div class="portal-workspace"><%- await include("partials/portal-topbar", { backHref: "/", pageTitle: "Permanent Replacements" }) %>
    <main class="portal-main service-page permanent-replacements-dashboard-page">
      <section class="permanent-replacements-hero" aria-labelledby="permanentReplacementsTitle"><div class="permanent-replacements-hero-copy"><span class="permanent-replacements-icon"><i class="fas fa-exchange-alt" aria-hidden="true"></i></span><div><div class="permanent-replacements-eyebrow">REPAIRS &amp; LOGISTICS</div><h1 id="permanentReplacementsTitle">Permanent Replacements</h1><p>Manage the permanent replacement of laptops for devices that cannot be repaired.<br>Track, approve and monitor replacement cases from allocation to completion.</p></div></div><div class="permanent-replacements-benefits" aria-label="Replacement program benefits"><div><i class="fas fa-shield-alt" aria-hidden="true"></i><span>Replace<br>Unrepairable Devices</span></div><div><i class="fas fa-users" aria-hidden="true"></i><span>Keep Students<br>Connected</span></div><div><i class="fas fa-laptop" aria-hidden="true"></i><span>Support Learning<br>Without Disruption</span></div></div></section>
      <div class="alert alert-danger replacements-alert" role="alert" dmx-show="replacementList.lastError.status || replacementFilterOptions.lastError.status" dmx-text="replacementList.lastError.response && replacementList.lastError.response.error ? replacementList.lastError.response.error : 'Permanent replacement cases could not be loaded.'"></div>

      <section class="replacement-status-summary" aria-label="Replacement cases by status"><div class="replacement-summary-description"><span class="replacement-summary-icon"><i class="fas fa-layer-group" aria-hidden="true"></i></span><div><h2>Replacement cases by status</h2><p>Overview of permanent replacement cases within your authorized scope.</p></div></div><div class="replacement-summary-metrics"><article class="replacement-summary-item"><span class="replacement-summary-item-icon pending"><i class="far fa-file-alt" aria-hidden="true"></i></span><div><strong dmx-text="replacementList.data.cases.where('replacement_status_code', '==', 'SELECTION_REQUIRED').count()">0</strong><span><i class="status-dot pending-dot"></i>Pending</span></div></article><article class="replacement-summary-item"><span class="replacement-summary-item-icon approved"><i class="far fa-check-circle" aria-hidden="true"></i></span><div><strong dmx-text="replacementList.data.cases.where('replacement_status_code', '==', 'REPLACEMENT_SELECTED').count()">0</strong><span><i class="status-dot approved-dot"></i>Approved</span></div></article><article class="replacement-summary-item"><span class="replacement-summary-item-icon in-progress"><i class="fas fa-truck" aria-hidden="true"></i></span><div><strong dmx-text="replacementList.data.cases.where('replacement_status_code', '==', 'AWAITING_ACCEPTANCE').count()">0</strong><span><i class="status-dot progress-dot"></i>In Progress</span></div></article><article class="replacement-summary-item"><span class="replacement-summary-item-icon completed"><i class="fas fa-cube" aria-hidden="true"></i></span><div><strong dmx-text="replacementList.data.cases.where('replacement_status_code', '==', 'COMPLETED').count()">0</strong><span><i class="status-dot completed-dot"></i>Completed</span></div></article></div></section>

      <section class="replacement-visible-status" aria-labelledby="visibleReplacementStatusTitle"><div class="replacement-visible-heading"><div class="replacement-summary-description"><span class="replacement-summary-icon chart"><i class="fas fa-chart-bar" aria-hidden="true"></i></span><div><h2 id="visibleReplacementStatusTitle">Visible Cases by Status</h2><p>Breakdown of permanent replacement cases based on your current filters.</p></div></div><div class="replacement-visible-controls"><label class="replacement-toggle"><input type="checkbox" role="switch" id="replacementChartsVisibleSwitch" dmx-bind:checked="replacementChartsVisible.value" dmx-on:change="replacementChartsVisible.setValue(replacementChartsVisibleSwitch.checked)"><span>Show charts</span></label><label class="replacement-toggle"><input type="checkbox" role="switch" id="selectionNeededSwitch" dmx-bind:checked="statusFilter.value == 'SELECTION_REQUIRED'" dmx-on:change="statusFilter.setValue(selectionNeededSwitch.checked ? 'SELECTION_REQUIRED' : 'ALL');replacementList.load({search:searchInput.value,status:selectionNeededSwitch.checked ? 'SELECTION_REQUIRED' : 'ALL',district_id:districtFilter.value,repair_centre_id:repairCentreFilter.value}, true)"><span>Selection needed</span></label><button type="button" class="replacement-clear-button" dmx-on:click="searchInput.setValue('');statusFilter.setValue('ALL');districtFilter.setValue('');repairCentreFilter.setValue('');replacementList.load({search:'',status:'ALL',district_id:'',repair_centre_id:''}, true)">Clear filters</button></div></div><div class="replacement-chart-grid" dmx-show="replacementChartsVisible.value && replacementList.data.cases.count() > 0"><div class="replacement-chart-row"><span>Pending</span><div class="replacement-chart-track"><span class="pending-fill" dmx-bind:style="'width:' + (replacementList.data.cases.count() ? replacementList.data.cases.where('replacement_status_code', '==', 'SELECTION_REQUIRED').count() / replacementList.data.cases.count() * 100 : 0) + '%' "></span></div><strong dmx-text="replacementList.data.cases.where('replacement_status_code', '==', 'SELECTION_REQUIRED').count()">0</strong></div><div class="replacement-chart-row"><span>Approved</span><div class="replacement-chart-track"><span class="approved-fill" dmx-bind:style="'width:' + (replacementList.data.cases.count() ? replacementList.data.cases.where('replacement_status_code', '==', 'REPLACEMENT_SELECTED').count() / replacementList.data.cases.count() * 100 : 0) + '%' "></span></div><strong dmx-text="replacementList.data.cases.where('replacement_status_code', '==', 'REPLACEMENT_SELECTED').count()">0</strong></div><div class="replacement-chart-row"><span>In Progress</span><div class="replacement-chart-track"><span class="progress-fill" dmx-bind:style="'width:' + (replacementList.data.cases.count() ? replacementList.data.cases.where('replacement_status_code', '==', 'AWAITING_ACCEPTANCE').count() / replacementList.data.cases.count() * 100 : 0) + '%' "></span></div><strong dmx-text="replacementList.data.cases.where('replacement_status_code', '==', 'AWAITING_ACCEPTANCE').count()">0</strong></div><div class="replacement-chart-row"><span>Completed</span><div class="replacement-chart-track"><span class="completed-fill" dmx-bind:style="'width:' + (replacementList.data.cases.count() ? replacementList.data.cases.where('replacement_status_code', '==', 'COMPLETED').count() / replacementList.data.cases.count() * 100 : 0) + '%' "></span></div><strong dmx-text="replacementList.data.cases.where('replacement_status_code', '==', 'COMPLETED').count()">0</strong></div></div><p class="replacement-no-visible" dmx-show="!replacementList.state.executing && replacementList.data.cases.count() == 0">No visible permanent replacement cases.</p></section>

      <section class="replacement-filter-card" aria-labelledby="replacementFilterTitle"><div class="replacement-filter-heading"><span class="replacement-summary-icon search"><i class="fas fa-search" aria-hidden="true"></i></span><div><h2 id="replacementFilterTitle">Search &amp; Filter</h2><p>Find replacement cases by ticket, device, or location.</p></div></div><div class="replacement-filter-grid"><div><label for="searchInput">Search</label><div class="replacement-search-input"><i class="fas fa-search" aria-hidden="true"></i><input id="searchInput" class="form-control" placeholder="Ticket, replacement #, serial..." dmx-on:input="replacementList.load({search:searchInput.value,status:statusFilter.value,district_id:districtFilter.value,repair_centre_id:repairCentreFilter.value}, true)"></div></div><div><label for="statusFilter">Status</label><select id="statusFilter" class="form-select" dmx-on:change="replacementList.load({search:searchInput.value,status:statusFilter.value,district_id:districtFilter.value,repair_centre_id:repairCentreFilter.value}, true)"><option value="ALL">All statuses</option><option value="SELECTION_REQUIRED">Selection Required</option><option value="REPLACEMENT_SELECTED">Replacement Selected</option><option value="AWAITING_ACCEPTANCE">Awaiting Acceptance</option><option value="COMPLETED">Completed</option><option value="CANCELLED">Cancelled</option></select></div><div><label for="districtFilter">District ID</label><select id="districtFilter" class="form-select" dmx-on:change="replacementList.load({search:searchInput.value,status:statusFilter.value,district_id:districtFilter.value,repair_centre_id:repairCentreFilter.value}, true)"><option value="">All districts</option><option dmx-repeat="replacementFilterOptions.data.districts" dmx-bind:value="id" dmx-text="name"></option></select></div><div><label for="repairCentreFilter">Repair Centre ID</label><select id="repairCentreFilter" class="form-select" dmx-on:change="replacementList.load({search:searchInput.value,status:statusFilter.value,district_id:districtFilter.value,repair_centre_id:repairCentreFilter.value}, true)"><option value="">All repair centres</option><option dmx-repeat="replacementFilterOptions.data.repair_centres" dmx-bind:value="id" dmx-text="name"></option></select></div></div></section>

      <section class="replacement-cases-card" aria-labelledby="replacementCasesTitle"><div class="replacement-cases-heading"><span class="replacement-summary-icon cases"><i class="fas fa-list" aria-hidden="true"></i></span><div><h2 id="replacementCasesTitle">Permanent Replacement Cases</h2><p>Showing cases that match your current filters.</p></div></div><div class="table-responsive replacement-table-scroll"><table class="table replacement-cases-table align-middle"><thead><tr><th>Replacement #</th><th>Ticket</th><th>Original Device</th><th>Replacement Device / Pending</th><th>Source Type</th><th>Repair Centre</th><th>District</th><th>Status</th><th>Updated</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="replacementList.data.cases"><tr><td><a class="replacement-number-link" dmx-bind:href="'/permanent-replacements/detail?id=' + replacement_case_id" dmx-text="replacement_number"></a></td><td dmx-text="ticket_number"></td><td><span dmx-text="original_serial_number"></span><small class="d-block text-muted" dmx-text="original_asset_tag || '-' "></small></td><td dmx-text="replacement_source_type == 'MANUFACTURER_SUPPLIED' ? 'Manufacturer supplied unit selected' : (replacement_asset_tag || replacement_serial_number || 'Pending selection')"></td><td><span dmx-text="replacement_source_type == 'TEMPORARY_LOAN_CONVERSION' ? 'Temporary Loan Conversion' : (replacement_source_type == 'MANUFACTURER_SUPPLIED' ? 'Manufacturer Supplied' : (replacement_source_type == 'EXISTING_INVENTORY' ? 'Existing Inventory' : 'Pending'))"></span><a class="d-block small" dmx-show="temporary_loan_case_id" dmx-bind:href="'/temporary-loans/detail?id=' + temporary_loan_case_id" dmx-text="loan_number"></a></td><td dmx-text="repair_centre_name"></td><td dmx-text="origin_district_name || '-' "></td><td><span class="replacement-status-badge" dmx-text="replacement_status_name"></span></td><td class="text-nowrap" dmx-text="updated_at_display"></td></tr></tbody></table></div><div class="replacement-empty-state" dmx-show="!replacementList.state.executing && replacementList.data.cases.count() == 0"><span><i class="fas fa-laptop" aria-hidden="true"></i></span><strong>No permanent replacement cases found</strong><p>There are no cases matching your current filters.</p></div></section>
    </main>
  </div>
</div>
