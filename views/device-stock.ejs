<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="deviceStockPage" appConnect="local" components="{dmxBootstrap5Modal:{}}" -->
<meta name="ac:route" content="/device-stock">
<div class="portal-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context" dmx-on:success="authContext.data.can_device_stock_intake ? intakeOptions.load({search:''}, true) : null"></dmx-serverconnect>
  <dmx-serverconnect id="scopeContext" url="/api/auth/scope_context"></dmx-serverconnect>
  <dmx-serverconnect id="stockList" url="/api/device-stock/list" dmx-param:search="stockSearch.value"></dmx-serverconnect>
  <dmx-serverconnect id="intakeOptions" url="/api/device-stock/intake-options" noload="true"></dmx-serverconnect>
  <dmx-value id="stockChartsVisible" value="true"></dmx-value>
  <dmx-value id="reservedStockOnly" value="false"></dmx-value>
  <dmx-value id="stockNotice" value=""></dmx-value><dmx-value id="selectedStockDeviceId" value=""></dmx-value>
  <%- await include("partials/portal-sidebar", { currentPage: "device-stock" }) %>
  <div class="portal-workspace">
    <%- await include("partials/portal-topbar", { backHref: "/", pageTitle: "Repair Centre Stock" }) %>
    <main class="portal-main service-page device-stock-dashboard-page">
      <section class="device-stock-hero" aria-labelledby="deviceStockTitle">
        <div class="device-stock-heading"><span class="device-stock-hero-icon"><i class="fas fa-warehouse" aria-hidden="true"></i></span><div><div class="device-stock-eyebrow">REPAIRS &amp; LOGISTICS</div><h1 id="deviceStockTitle">Repair Centre Stock</h1><p>Manage and track stock of devices at the repair centre, including available, reserved and total listed inventory.</p></div></div>
        <div class="device-stock-hero-actions"><a class="device-stock-primary text-decoration-none" href="/admin/spare-pools" dmx-show="authContext.data.can_spare_pools_manage"><i class="fas fa-boxes" aria-hidden="true"></i> Manage Spare Pools</a><button type="button" class="device-stock-primary" dmx-show="authContext.data.can_device_stock_intake" dmx-on:click="intakeForm.reset(true);selectedStockDeviceId.setValue('');intakeOptions.load({search:'',page:1,page_size:10}, true);intakeModal.show()"><i class="fas fa-plus" aria-hidden="true"></i> Record Stock Intake</button><label class="device-stock-switch"><input type="checkbox" role="switch" id="stockChartsVisibleSwitch" dmx-bind:checked="stockChartsVisible.value" dmx-on:change="stockChartsVisible.setValue(stockChartsVisibleSwitch.checked)"><span>Show charts</span></label></div>
      </section>
      <div class="alert alert-success stock-alert" role="status" dmx-show="stockNotice.value" dmx-text="stockNotice.value"></div>
      <div class="alert alert-danger stock-alert" role="alert" dmx-show="stockList.lastError.status" dmx-text="stockList.lastError.response && stockList.lastError.response.error ? stockList.lastError.response.error : 'Stock could not be loaded.'"></div>

      <section class="device-stock-metrics" aria-label="Repair centre stock summary">
        <article class="device-stock-metric"><div class="device-stock-metric-head"><span class="device-stock-metric-icon available"><i class="fas fa-cube" aria-hidden="true"></i></span><div><span class="device-stock-metric-label">Available</span><strong dmx-text="stockList.data.stock.where('is_reserved_for_replacement', '==', 0).count()">0</strong></div><span class="device-stock-metric-pill available-pill" dmx-text="(stockList.data.stock.count() ? (stockList.data.stock.where('is_reserved_for_replacement', '==', 0).count() / stockList.data.stock.count() * 100).formatNumber(0) : 0) + '% of total'">0% of total</span></div><div class="device-stock-progress" dmx-show="stockChartsVisible.value"><span class="available-fill" dmx-bind:style="'width:' + (stockList.data.stock.count() ? stockList.data.stock.where('is_reserved_for_replacement', '==', 0).count() / stockList.data.stock.count() * 100 : 0) + '%' "></span></div><div class="device-stock-metric-foot"><span dmx-text="stockList.data.stock.where('is_reserved_for_replacement', '==', 0).count() ? 'Devices available' : 'No stock available'">No stock available</span><strong><span dmx-text="stockList.data.stock.where('is_reserved_for_replacement', '==', 0).count()">0</span> / <span dmx-text="stockList.data.stock.count()">0</span></strong></div></article>
        <article class="device-stock-metric"><div class="device-stock-metric-head"><span class="device-stock-metric-icon reserved"><i class="fas fa-lock" aria-hidden="true"></i></span><div><span class="device-stock-metric-label">Reserved</span><strong dmx-text="stockList.data.stock.where('is_reserved_for_replacement', '==', 1).count()">0</strong></div><span class="device-stock-metric-pill reserved-pill" dmx-text="(stockList.data.stock.count() ? (stockList.data.stock.where('is_reserved_for_replacement', '==', 1).count() / stockList.data.stock.count() * 100).formatNumber(0) : 0) + '% of total'">0% of total</span></div><div class="device-stock-progress" dmx-show="stockChartsVisible.value"><span class="reserved-fill" dmx-bind:style="'width:' + (stockList.data.stock.count() ? stockList.data.stock.where('is_reserved_for_replacement', '==', 1).count() / stockList.data.stock.count() * 100 : 0) + '%' "></span></div><div class="device-stock-metric-foot"><span dmx-text="stockList.data.stock.where('is_reserved_for_replacement', '==', 1).count() ? 'Devices reserved' : 'No stock reserved'">No stock reserved</span><strong><span dmx-text="stockList.data.stock.where('is_reserved_for_replacement', '==', 1).count()">0</span> / <span dmx-text="stockList.data.stock.count()">0</span></strong></div></article>
        <article class="device-stock-metric"><div class="device-stock-metric-head"><span class="device-stock-metric-icon total"><i class="fas fa-layer-group" aria-hidden="true"></i></span><div><span class="device-stock-metric-label">Total Listed</span><strong dmx-text="stockList.data.stock.count()">0</strong></div><span class="device-stock-metric-pill total-pill"><span dmx-text="stockList.data.stock.count()">0</span> devices</span></div><div class="device-stock-progress" dmx-show="stockChartsVisible.value"><span class="total-fill" dmx-bind:style="stockList.data.stock.count() ? 'width:100%' : 'width:0%'"></span></div><div class="device-stock-metric-foot"><span>Total devices in stock</span><strong dmx-text="stockList.data.stock.count()">0</strong></div></article>
      </section>

      <section class="device-stock-search-card" aria-label="Search stock"><div class="device-stock-search-main"><label for="stockSearch">Search stock</label><div class="device-stock-search-field"><i class="fas fa-search" aria-hidden="true"></i><input id="stockSearch" class="form-control" placeholder="Enter serial number or asset tag..." dmx-on:input="stockList.load({search:stockSearch.value}, true)"></div></div><label class="device-stock-switch reserved-filter"><input type="checkbox" role="switch" id="reservedStockSwitch" dmx-bind:checked="reservedStockOnly.value" dmx-on:change="reservedStockOnly.setValue(reservedStockSwitch.checked)"><span>Reserved only</span></label><button type="button" class="device-stock-clear" dmx-on:click="stockSearch.setValue('');reservedStockOnly.setValue(false);stockList.load({search:''}, true)"><i class="fas fa-sliders-h" aria-hidden="true"></i> Clear filters</button></section>

      <section class="device-stock-table-card" aria-label="Repair centre stock devices">
        <div class="table-responsive device-stock-table-scroll"><table class="table device-stock-table align-middle"><thead><tr><th>Device</th><th>Manufacturer / Model</th><th>Lifecycle</th><th>Phase 5 Allocation</th><th>Physical Location</th><th>Stock Status</th><th>Placed At</th><th>Reservation</th><th>Replacement</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="reservedStockOnly.value ? stockList.data.stock.where('is_reserved_for_replacement', '==', 1) : stockList.data.stock"><tr><td><a class="device-stock-device-link" dmx-bind:href="'/device-stock/detail?device_id=' + device_id" dmx-text="serial_number"></a><small class="d-block text-muted" dmx-text="asset_tag || 'No asset tag'"></small></td><td dmx-text="manufacturer_name + ' / ' + model_name"></td><td dmx-text="lifecycle_code"></td><td dmx-text="allocation_level + (school_name ? ' / ' + school_name : (district_name ? ' / ' + district_name : ''))"></td><td dmx-text="service_location_name"></td><td><span class="device-stock-status" dmx-text="stock_status"></span></td><td class="text-nowrap" dmx-text="placed_at_display"></td><td dmx-text="is_reserved_for_replacement == 1 ? 'Reserved' : 'Available'"></td><td dmx-text="replacement_number || '-' "></td></tr></tbody></table></div>
        <div class="device-stock-empty" dmx-show="!stockList.state.executing && (reservedStockOnly.value ? stockList.data.stock.where('is_reserved_for_replacement', '==', 1).count() : stockList.data.stock.count()) == 0"><span class="device-stock-empty-icon"><i class="fas fa-box-open" aria-hidden="true"></i></span><strong>No stock matches the current search</strong><p>Try adjusting your search criteria or filters, or record a new stock intake<br class="d-none d-md-block"> to add devices to the repair centre stock.</p><button type="button" class="device-stock-primary" dmx-show="authContext.data.can_device_stock_intake" dmx-on:click="intakeForm.reset(true);selectedStockDeviceId.setValue('');intakeOptions.load({search:'',page:1,page_size:10}, true);intakeModal.show()"><i class="fas fa-plus" aria-hidden="true"></i> Record Stock Intake</button></div>
      </section>

      <div id="intakeModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="intakeTitle" aria-hidden="true"><div class="modal-dialog modal-lg"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="intakeTitle">Record Stock Intake</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="intakeForm" is="dmx-serverconnect-form" method="post" action="/api/device-stock/intake" dmx-on:success="intakeModal.hide();intakeForm.reset(true);selectedStockDeviceId.setValue('');stockList.load({search:stockSearch.value}, true);intakeOptions.load({search:''}, true);stockNotice.setValue('Stock intake recorded.')"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="intakeForm.lastError.status" dmx-text="intakeForm.lastError.response && intakeForm.lastError.response.error ? intakeForm.lastError.response.error : 'Stock intake could not be recorded.'"></div><input type="hidden" name="device_id" dmx-bind:value="selectedStockDeviceId.value"><div class="row g-3"><div class="col-12"><label class="form-label" for="deviceSearch">Search available devices by serial number or asset tag</label><div class="input-group"><input id="deviceSearch" class="form-control" placeholder="Search serial number or asset tag"><button type="button" class="btn btn-bmobile-secondary" dmx-on:click="intakeOptions.load({search:deviceSearch.value,page:1,page_size:10}, true)"><i class="fas fa-search" aria-hidden="true"></i><span class="visually-hidden">Search devices</span></button></div></div><div class="col-12"><div class="device-intake-table-wrap"><table class="table device-intake-table align-middle"><thead><tr><th class="device-intake-select-heading"><span class="visually-hidden">Select</span></th><th>Serial Number</th><th>Asset Tag</th><th>Manufacturer / Model</th><th>Lifecycle</th><th>Current Allocation</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="intakeOptions.data.devices"><tr dmx-bind:class="selectedStockDeviceId.value == device_id ? 'device-intake-selected' : ''" dmx-on:click="selectedStockDeviceId.setValue(device_id)"><td><input class="device-intake-radio" type="radio" name="stock_device_choice" required aria-label="Select device" dmx-bind:value="device_id" dmx-bind:checked="selectedStockDeviceId.value == device_id" dmx-on:click="selectedStockDeviceId.setValue(device_id)"></td><td class="fw-semibold" dmx-text="serial_number"></td><td dmx-text="asset_tag || '-' "></td><td><span dmx-text="manufacturer_name"></span><small class="d-block text-muted" dmx-text="model_name"></small></td><td><span class="device-intake-lifecycle" dmx-text="lifecycle_code"></span></td><td dmx-text="allocation_level"></td></tr></tbody></table><div class="device-intake-empty" dmx-show="intakeOptions.data.devices.count() == 0"><i class="fas fa-search"></i><span>No eligible available devices found.</span></div></div><div class="device-intake-pagination"><span dmx-text="'Showing ' + (intakeOptions.data.total == 0 ? 0 : ((intakeOptions.data.page - 1) * intakeOptions.data.page_size + 1)) + '–' + ((intakeOptions.data.page - 1) * intakeOptions.data.page_size + intakeOptions.data.devices.count()) + ' of ' + (intakeOptions.data.total || 0) + ' eligible devices'"></span><div class="device-intake-page-controls"><button type="button" class="btn btn-bmobile-secondary btn-sm" aria-label="Previous page" dmx-bind:disabled="intakeOptions.data.page <= 1" dmx-on:click="intakeOptions.load({search:deviceSearch.value,page:intakeOptions.data.page - 1,page_size:10}, true)"><i class="fas fa-chevron-left"></i></button><span dmx-text="(intakeOptions.data.page || 1) + ' / ' + (intakeOptions.data.total_pages || 1)"></span><button type="button" class="btn btn-bmobile-secondary btn-sm" aria-label="Next page" dmx-bind:disabled="intakeOptions.data.page >= intakeOptions.data.total_pages" dmx-on:click="intakeOptions.load({search:deviceSearch.value,page:intakeOptions.data.page + 1,page_size:10}, true)"><i class="fas fa-chevron-right"></i></button></div></div></div><div class="col-12"><label class="form-label" for="stockLocation">Repair Centre</label><select id="stockLocation" name="service_location_id" class="form-select" required><option value="">Select Repair Centre</option><option dmx-repeat="intakeOptions.data.locations" dmx-bind:value="id" dmx-text="name"></option></select></div></div></div><div class="modal-footer"><button type="button" class="btn btn-bmobile-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-bmobile-primary" dmx-bind:disabled="intakeForm.state.executing">Record Intake</button></div></form></div></div></div>
    </main>
  </div>
</div>
