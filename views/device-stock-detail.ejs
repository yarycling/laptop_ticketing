<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="deviceStockDetailPage" appConnect="local" -->
<meta name="ac:route" content="/device-stock/detail">
<div class="portal-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context"></dmx-serverconnect>
  <dmx-serverconnect id="scopeContext" url="/api/auth/scope_context"></dmx-serverconnect>
  <dmx-serverconnect id="stockDetail" url="/api/device-stock/detail" dmx-param:device_id="query.device_id"></dmx-serverconnect>
  <%- await include("partials/portal-sidebar", { currentPage: "device-stock" }) %>
  <div class="portal-workspace"><%- await include("partials/portal-topbar", { backHref: "/device-stock", pageTitle: "Stock Detail" }) %>
    <main class="portal-main service-page">
      <div class="alert alert-danger" role="alert" dmx-show="stockDetail.lastError.status" dmx-text="stockDetail.lastError.response && stockDetail.lastError.response.error ? stockDetail.lastError.response.error : 'Stock detail could not be loaded.'"></div>
      <div class="alert alert-success" role="status" dmx-show="releaseNotice.value" dmx-text="releaseNotice.value"></div><dmx-value id="releaseNotice" dmx-bind:value="''"></dmx-value>
      <div dmx-show="stockDetail.data.device"><div class="d-flex flex-wrap justify-content-between gap-2 align-items-start mb-4"><div><p class="text-muted mb-1">Device Stock</p><h1 class="h3 mb-0" dmx-text="stockDetail.data.device.serial_number"></h1><p class="text-muted mb-0" dmx-text="stockDetail.data.device.asset_tag || 'No asset tag'"></p></div><form id="releaseForm" is="dmx-serverconnect-form" method="post" action="/api/device-stock/release" dmx-show="authContext.data.can_device_stock_release && stockDetail.data.current.stock_location_id && stockDetail.data.current.is_reserved_for_replacement != 1" dmx-on:success="stockDetail.load();releaseNotice.setValue('Stock released.')"><input type="hidden" name="stock_location_id" dmx-bind:value="stockDetail.data.current.stock_location_id"><button type="submit" class="btn btn-bmobile-secondary" dmx-bind:disabled="releaseForm.state.executing">Release Stock</button></form></div>
        <div class="alert alert-danger" role="alert" dmx-show="releaseForm.lastError.status" dmx-text="releaseForm.lastError.response && releaseForm.lastError.response.error ? releaseForm.lastError.response.error : 'Stock could not be released.'"></div>
        <div class="row g-4"><section class="col-12 col-lg-6"><h2 class="h5 border-bottom pb-2">Device</h2><dl class="row"><dt class="col-sm-5">Manufacturer</dt><dd class="col-sm-7" dmx-text="stockDetail.data.device.manufacturer_name"></dd><dt class="col-sm-5">Model</dt><dd class="col-sm-7" dmx-text="stockDetail.data.device.model_name"></dd><dt class="col-sm-5">Lifecycle</dt><dd class="col-sm-7" dmx-text="stockDetail.data.device.lifecycle_code"></dd><dt class="col-sm-5">Phase 5 Allocation</dt><dd class="col-sm-7" dmx-text="stockDetail.data.device.allocation_level"></dd><dt class="col-sm-5">District</dt><dd class="col-sm-7" dmx-text="stockDetail.data.device.district_name || '-' "></dd><dt class="col-sm-5">School</dt><dd class="col-sm-7" dmx-text="stockDetail.data.device.school_name || '-' "></dd></dl></section><section class="col-12 col-lg-6"><h2 class="h5 border-bottom pb-2">Physical Stock Location</h2><dl class="row"><dt class="col-sm-5">Custody</dt><dd class="col-sm-7" dmx-text="stockDetail.data.device.has_active_logistics || stockDetail.data.device.has_active_manufacturer_return || stockDetail.data.device.has_active_repair ? 'Active workflow custody' : (stockDetail.data.current.physical_custody_name || 'No active stock location')"></dd><dt class="col-sm-5">Repair Centre</dt><dd class="col-sm-7" dmx-text="stockDetail.data.current.service_location_name || 'Not in stock'"></dd><dt class="col-sm-5">Stock Status</dt><dd class="col-sm-7" dmx-text="stockDetail.data.current.stock_status || 'Not in stock'"></dd><dt class="col-sm-5">Reservation</dt><dd class="col-sm-7" dmx-text="stockDetail.data.current.is_reserved_for_replacement == 1 ? 'Reserved for permanent replacement' : (stockDetail.data.current.stock_location_id ? 'Available' : 'Not in stock')"></dd><dt class="col-sm-5">Replacement</dt><dd class="col-sm-7" dmx-text="stockDetail.data.current.replacement_number || '-' "></dd><dt class="col-sm-5">Placed At</dt><dd class="col-sm-7" dmx-text="stockDetail.data.placed_at_display"></dd></dl></section></div>
        <section class="mt-4"><h2 class="h5 border-bottom pb-2">Stock Placement History</h2><div class="table-responsive portal-table-wrapper"><table class="table portal-table align-middle"><thead><tr><th>Repair Centre</th><th>Placed At</th><th>Placed By</th><th>Released At</th><th>Released By</th><th>Status</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="stockDetail.data.history"><tr><td dmx-text="service_location_name"></td><td class="text-nowrap" dmx-text="placed_at_display"></td><td dmx-text="placed_by_name"></td><td class="text-nowrap" dmx-text="removed_at_display"></td><td dmx-text="removed_by_name || '-' "></td><td dmx-text="stock_status"></td></tr></tbody></table></div></section>
      </div>
    </main>
  </div>
</div>
