<header class="portal-topbar">
  <dmx-serverconnect id="notificationUnread" url="/api/notifications/unread-count"></dmx-serverconnect>
  <div class="topbar-left">
    <button class="btn sidebar-toggle d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#portalMobileNav" aria-controls="portalMobileNav" aria-label="Open navigation">
      <i class="fas fa-bars" aria-hidden="true"></i>
    </button>
    <button class="btn sidebar-toggle d-none d-lg-inline-flex" type="button" aria-label="Sidebar toggle placeholder">
      <i class="fas fa-bars" aria-hidden="true"></i>
    </button>
    <% if (typeof backHref !== 'undefined' && backHref && typeof pageTitle !== 'undefined' && pageTitle) { %>
    <a class="btn btn-bmobile-secondary btn-sm" href="<%= backHref %>" aria-label="Back"><i class="fas fa-arrow-left" aria-hidden="true"></i></a>
    <strong><%= pageTitle %></strong>
    <% } %>
    <label class="visually-hidden" for="globalSearch">Global search</label>
    <div class="global-search">
      <i class="fas fa-search" aria-hidden="true"></i>
      <input id="globalSearch" type="search" class="form-control" placeholder="Search laptops, tickets, students, schools...">
    </div>
  </div>
  <div class="topbar-actions">
    <a class="btn topbar-icon-button position-relative" href="/notifications" aria-label="Notifications" dmx-show="authContext.data.can_notifications_view"><i class="far fa-bell" aria-hidden="true"></i><span class="notification-badge" dmx-text="notificationUnread.data.unread_count || 0" dmx-attr:aria-label="(notificationUnread.data.unread_count || 0) + ' unread notifications'"></span></a>
    <button class="btn topbar-icon-button d-none d-sm-inline-flex" type="button" aria-label="Applications"><i class="fas fa-th" aria-hidden="true"></i></button>
    <div class="topbar-user dropdown">
      <span class="user-avatar" aria-hidden="true">U</span>
      <button class="btn topbar-user-toggle dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <strong dmx-text="authContext.data.user.display_name">User</strong>
        <span dmx-text="authContext.data.roles[0]">Role / Organisation</span>
      </button>
      <ul class="dropdown-menu dropdown-menu-end">
        <li><button class="dropdown-item" type="button" disabled>My Profile</button></li>
        <li><button class="dropdown-item" type="button" dmx-on:click="changePasswordModal.show()">Change Password</button></li>
        <li><hr class="dropdown-divider"></li>
        <li><button class="dropdown-item" type="submit" form="logoutForm">Sign Out</button></li>
      </ul>
    </div>
  </div>
  <form id="logoutForm" is="dmx-serverconnect-form" method="post" action="/api/auth/logout" class="d-none" dmx-on:success="portalRedirect('/login')"></form>
</header>

<div id="changePasswordModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="changePasswordTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content portal-modal">
      <div class="modal-header">
        <h2 class="modal-title" id="changePasswordTitle">Change Password</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="changePasswordForm" is="dmx-serverconnect-form" method="post" action="/api/auth/change_password" dmx-on:success="changePasswordModal.hide();changePasswordForm.reset()">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label" for="currentPassword">Current Password</label>
            <input id="currentPassword" class="form-control" type="password" name="current_password" autocomplete="current-password" required>
          </div>
          <div class="mb-3">
            <label class="form-label" for="newPassword">New Password</label>
            <input id="newPassword" class="form-control" type="password" name="new_password" autocomplete="new-password" minlength="10" required>
          </div>
          <div class="mb-0">
            <label class="form-label" for="confirmPassword">Confirm New Password</label>
            <input id="confirmPassword" class="form-control" type="password" name="confirm_password" autocomplete="new-password" minlength="10" required>
          </div>
          <div class="portal-alert portal-alert-danger mt-3" dmx-show="changePasswordForm.lastError.status">
            Password change could not be completed. Please check the fields and try again.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-bmobile-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-bmobile-primary" dmx-bind:disabled="changePasswordForm.state.executing">Update Password</button>
        </div>
      </form>
    </div>
  </div>
</div>
