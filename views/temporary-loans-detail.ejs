<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="temporaryLoanDetailPage" appConnect="local" -->
<meta name="ac:route" content="/temporary-loans/detail">
<div class="portal-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context"></dmx-serverconnect>
  <dmx-serverconnect id="loanDetail" url="/api/temporary-loans/detail" dmx-param:id="query.id"></dmx-serverconnect>
  <dmx-serverconnect id="spareOptions" url="/api/temporary-loans/spare-options" noload="true"></dmx-serverconnect>
  <dmx-serverconnect id="returnReasons" url="/api/temporary-loans/return-reasons" noload="true"></dmx-serverconnect>
  <dmx-serverconnect id="conversionReasons" url="/api/temporary-loans/conversion-reasons" noload="true"></dmx-serverconnect>
  <dmx-value id="decisionMode" dmx-bind:value="'APPROVE'"></dmx-value>
  <dmx-value id="conversionDecisionMode" dmx-bind:value="'APPROVE'"></dmx-value>
  <dmx-value id="workflowNotice"></dmx-value>
  <div id="returnRequestModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="returnRequestTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="returnRequestTitle">Request Spare Return</h2><button class="btn-close" type="button" dmx-on:click="returnRequestModal.hide()" aria-label="Close"></button></div><form id="returnRequestForm" is="dmx-serverconnect-form" method="post" action="/api/temporary-loans/request-return" dmx-on:success="returnRequestModal.hide();returnRequestForm.reset(true);loanDetail.load();workflowNotice.setValue('Return requested. The temporary spare remains outstanding and is not in Repair Centre stock.')"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="returnRequestForm.lastError.status" dmx-text="returnRequestForm.lastError.response && returnRequestForm.lastError.response.error ? returnRequestForm.lastError.response.error : 'Spare return could not be requested.'"></div><input type="hidden" name="temporary_loan_case_id" dmx-bind:value="query.id"><p><strong dmx-text="loanDetail.data.case.loan_number"></strong> · <span dmx-text="loanDetail.data.case.selected_spare_asset_tag || loanDetail.data.case.selected_spare_serial_number"></span></p><label class="form-label" for="returnReasonSelect">Return reason</label><select id="returnReasonSelect" name="return_reason_code" class="form-select" required><option value="">Select a reason</option><option dmx-repeat="returnReasons.data.reasons" dmx-bind:value="code" dmx-text="name"></option></select><label class="form-label mt-3" for="returnRequestNotes">Notes <span class="text-muted">(required for Other)</span></label><textarea id="returnRequestNotes" name="return_notes" class="form-control" rows="3" maxlength="1000" dmx-bind:required="returnReasonSelect.value == 'OTHER'"></textarea><p class="small text-muted mt-3 mb-0">This marks the temporary spare as due for return. It does not place it back into Repair Centre stock.</p></div><div class="modal-footer"><button type="button" class="btn btn-bmobile-secondary" dmx-on:click="returnRequestModal.hide()">Cancel</button><button type="submit" class="btn btn-bmobile-primary" dmx-bind:disabled="returnRequestForm.state.executing">Request Return</button></div></form></div></div></div>
  <div id="reclaimModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="reclaimTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="reclaimTitle">Record Spare Reclaimed</h2><button class="btn-close" type="button" dmx-on:click="reclaimModal.hide()" aria-label="Close"></button></div><form id="reclaimForm" is="dmx-serverconnect-form" method="post" action="/api/temporary-loans/reclaim" dmx-on:success="reclaimModal.hide();reclaimForm.reset(true);loanDetail.load();workflowNotice.setValue('Serviceable spare reclaimed and returned to Repair Centre free stock.')"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="reclaimForm.lastError.status" dmx-text="reclaimForm.lastError.response && reclaimForm.lastError.response.error ? reclaimForm.lastError.response.error : 'Spare could not be reclaimed.'"></div><input type="hidden" name="temporary_loan_case_id" dmx-bind:value="query.id"><p><strong dmx-text="loanDetail.data.case.loan_number"></strong> · <span dmx-text="loanDetail.data.case.selected_spare_asset_tag || loanDetail.data.case.selected_spare_serial_number"></span></p><label class="form-label" for="returnCondition">Return condition</label><select id="returnCondition" name="return_condition_code" class="form-select" required><option value="">Confirm condition</option><option value="SERVICEABLE">Serviceable</option></select><p class="small text-muted mt-3 mb-0">Confirm the physical spare has been received by the Repair Centre. The device will return to AVAILABLE / free stock.</p></div><div class="modal-footer"><button type="button" class="btn btn-bmobile-secondary" dmx-on:click="reclaimModal.hide()">Cancel</button><button type="submit" class="btn btn-bmobile-primary" dmx-bind:disabled="reclaimForm.state.executing || !returnCondition.value">Confirm Reclaim</button></div></form></div></div></div>
  <div id="conversionRequestModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="conversionRequestTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="conversionRequestTitle">Request Permanent Conversion</h2><button class="btn-close" type="button" dmx-on:click="conversionRequestModal.hide()" aria-label="Close"></button></div><form id="conversionRequestForm" is="dmx-serverconnect-form" method="post" action="/api/temporary-loans/request-conversion" dmx-on:success="conversionRequestModal.hide();conversionRequestForm.reset(true);loanDetail.load();workflowNotice.setValue('Conversion request submitted for Head Office decision. No permanent allocation changed.')"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="conversionRequestForm.lastError.status" dmx-text="conversionRequestForm.lastError.response && conversionRequestForm.lastError.response.error ? conversionRequestForm.lastError.response.error : 'Conversion request could not be submitted.'"></div><input type="hidden" name="temporary_loan_case_id" dmx-bind:value="query.id"><p><strong dmx-text="loanDetail.data.case.loan_number"></strong> · <span dmx-text="loanDetail.data.case.selected_spare_asset_tag || loanDetail.data.case.selected_spare_serial_number"></span></p><label class="form-label" for="conversionReason">Reason</label><select id="conversionReason" name="reason_code" class="form-select" required><option value="">Select a reason</option><option dmx-repeat="conversionReasons.data.reasons" dmx-bind:value="code" dmx-text="name"></option></select><label class="form-label mt-3" for="conversionRequestNotes">Notes <span class="text-muted">(required for Other)</span></label><textarea id="conversionRequestNotes" name="request_notes" class="form-control" rows="3" maxlength="1000" dmx-bind:required="conversionReason.value == 'OTHER'"></textarea><div class="alert alert-info mt-3 mb-0">This requests Head Office approval to permanently convert the temporary spare. No permanent allocation or replacement relationship is created until approval.</div></div><div class="modal-footer"><button type="button" class="btn btn-bmobile-secondary" dmx-on:click="conversionRequestModal.hide()">Cancel</button><button type="submit" class="btn btn-bmobile-primary" dmx-bind:disabled="conversionRequestForm.state.executing || !conversionReason.value">Submit Request</button></div></form></div></div></div>
  <div id="conversionDecisionModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="conversionDecisionTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="conversionDecisionTitle" dmx-text="conversionDecisionMode.value == 'APPROVE' ? 'Approve Permanent Conversion' : 'Reject Permanent Conversion'"></h2><button class="btn-close" type="button" dmx-on:click="conversionDecisionModal.hide()" aria-label="Close"></button></div><form id="conversionDecisionForm" is="dmx-serverconnect-form" method="post" action="/api/temporary-loans/conversion-decide" dmx-on:success="conversionDecisionModal.hide();conversionDecisionForm.reset(true);loanDetail.load();workflowNotice.setValue('Head Office conversion decision recorded.')"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="conversionDecisionForm.lastError.status" dmx-text="conversionDecisionForm.lastError.response && conversionDecisionForm.lastError.response.error ? conversionDecisionForm.lastError.response.error : 'Head Office decision could not be recorded.'"></div><input type="hidden" name="conversion_request_id" dmx-bind:value="loanDetail.data.case.latest_conversion_request_id"><input type="hidden" name="decision" dmx-bind:value="conversionDecisionMode.value"><p><strong dmx-text="loanDetail.data.case.loan_number"></strong> · <span dmx-text="loanDetail.data.case.selected_spare_asset_tag || loanDetail.data.case.selected_spare_serial_number"></span></p><div class="alert alert-warning" dmx-show="conversionDecisionMode.value == 'APPROVE'">Approval permanently replaces the original device, transfers its Phase 5 educational allocation to the current temporary spare, ends the temporary loan, and marks the original REPLACED. The spare remains with its current recipient and will NOT return to Repair Centre stock.</div><p dmx-show="conversionDecisionMode.value == 'REJECT'">Rejection returns the case to Active Loan. The spare remains with its recipient as a temporary device.</p><label class="form-label" for="conversionDecisionNotes">Decision note (optional)</label><textarea id="conversionDecisionNotes" name="decision_notes" class="form-control" rows="3" maxlength="1000"></textarea></div><div class="modal-footer"><button type="button" class="btn btn-bmobile-secondary" dmx-on:click="conversionDecisionModal.hide()">Cancel</button><button type="submit" class="btn btn-bmobile-primary" dmx-bind:disabled="conversionDecisionForm.state.executing" dmx-text="conversionDecisionMode.value == 'APPROVE' ? 'Approve and Convert' : 'Reject Request'"></button></div></form></div></div></div>
  <%- await include("partials/portal-sidebar", { currentPage: "temporary-loans" }) %>
  <div class="portal-workspace"><%- await include("partials/portal-topbar", { backHref: "/temporary-loans", pageTitle: "Temporary Loan Detail" }) %>
    <main class="portal-main service-page">
      <div id="decisionModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="decisionTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="decisionTitle" dmx-text="decisionMode.value == 'APPROVE' ? 'Authorize Temporary Loan' : 'Reject Temporary Loan'"></h2><button class="btn-close" type="button" dmx-on:click="decisionModal.hide()" aria-label="Close"></button></div><form id="decisionForm" is="dmx-serverconnect-form" method="post" action="/api/temporary-loans/district-decide" dmx-on:success="decisionModal.hide();decisionForm.reset(true);loanDetail.load();workflowNotice.setValue('District decision recorded.')"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="decisionForm.lastError.status" dmx-text="decisionForm.lastError.response && decisionForm.lastError.response.error ? decisionForm.lastError.response.error : 'Decision could not be recorded.'"></div><input type="hidden" name="temporary_loan_case_id" dmx-bind:value="query.id"><input type="hidden" name="decision" dmx-bind:value="decisionMode.value"><p><strong dmx-text="loanDetail.data.case.loan_number"></strong> · <span dmx-text="loanDetail.data.case.ticket_number"></span></p><label class="form-label" for="decisionNotes" dmx-text="decisionMode.value == 'REJECT' ? 'Rejection reason' : 'Decision note (optional)'"></label><textarea id="decisionNotes" name="notes" class="form-control" rows="3" maxlength="1000" dmx-bind:required="decisionMode.value == 'REJECT'"></textarea><p class="small text-muted mt-2 mb-0">Authorization does not select or issue a spare device.</p></div><div class="modal-footer"><button type="button" class="btn btn-bmobile-secondary" dmx-on:click="decisionModal.hide()">Cancel</button><button type="submit" class="btn btn-bmobile-primary" dmx-bind:disabled="decisionForm.state.executing" dmx-text="decisionMode.value == 'APPROVE' ? 'Authorize' : 'Reject'"></button></div></form></div></div></div>
      <div id="selectionModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="selectionTitle" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="selectionTitle">Select Temporary Spare</h2><button class="btn-close" type="button" dmx-on:click="selectionModal.hide()" aria-label="Close"></button></div><form id="selectionForm" is="dmx-serverconnect-form" method="post" action="/api/temporary-loans/select-spare" dmx-on:success="selectionModal.hide();selectionForm.reset(true);loanDetail.load();workflowNotice.setValue('Spare selected and reserved. It remains in Repair Centre stock until issue.')"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="selectionForm.lastError.status" dmx-text="selectionForm.lastError.response && selectionForm.lastError.response.error ? selectionForm.lastError.response.error : 'Spare could not be selected.'"></div><input type="hidden" name="temporary_loan_case_id" dmx-bind:value="query.id"><label class="form-label" for="spareDevice">Available Repair Centre spare</label><select id="spareDevice" name="device_id" class="form-select" required><option value="">Select an available spare</option><option dmx-repeat="spareOptions.data.candidates" dmx-bind:value="device_id" dmx-text="(asset_tag || serial_number) + ' · ' + manufacturer_name + ' ' + model_name + ' · ' + service_location_name"></option></select><p class="small text-muted mt-2 mb-0">Selection reserves the device. Its lifecycle stays Available and its stock stays In Stock until issue.</p><p class="text-muted mb-0 mt-2" dmx-show="spareOptions.data.candidates.length == 0">No eligible central stock is available in this Repair Centre pool.</p></div><div class="modal-footer"><button type="button" class="btn btn-bmobile-secondary" dmx-on:click="selectionModal.hide()">Cancel</button><button type="submit" class="btn btn-bmobile-primary" dmx-bind:disabled="selectionForm.state.executing || !spareDevice.value">Reserve Spare</button></div></form></div></div></div>
      <div id="issueModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="issueTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="issueTitle">Issue Temporary Spare</h2><button class="btn-close" type="button" dmx-on:click="issueModal.hide()" aria-label="Close"></button></div><form id="issueForm" is="dmx-serverconnect-form" method="post" action="/api/temporary-loans/issue" dmx-on:success="issueModal.hide();issueForm.reset(true);loanDetail.load();workflowNotice.setValue('Temporary loan activated at the Repair Centre. Recipient handoff and receipt remain unrecorded.')"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="issueForm.lastError.status" dmx-text="issueForm.lastError.response && issueForm.lastError.response.error ? issueForm.lastError.response.error : 'Temporary spare could not be issued.'"></div><input type="hidden" name="temporary_loan_case_id" dmx-bind:value="query.id"><dl class="row"><dt class="col-4">Loan</dt><dd class="col-8" dmx-text="loanDetail.data.case.loan_number"></dd><dt class="col-4">Spare</dt><dd class="col-8" dmx-text="loanDetail.data.case.selected_spare_asset_tag || loanDetail.data.case.selected_spare_serial_number"></dd></dl><label class="form-label" for="issueNotes">Notes (optional)</label><textarea id="issueNotes" name="notes" class="form-control" maxlength="1000" rows="3"></textarea><p class="small text-muted mt-2 mb-0">Issue changes the spare lifecycle and removes it from free stock. No school receipt, TTPost custody, or transport is recorded.</p></div><div class="modal-footer"><button type="button" class="btn btn-bmobile-secondary" dmx-on:click="issueModal.hide()">Cancel</button><button type="submit" class="btn btn-bmobile-primary" dmx-bind:disabled="issueForm.state.executing">Confirm Issue</button></div></form></div></div></div>
      <div class="alert alert-danger" role="alert" dmx-show="loanDetail.lastError.status" dmx-text="loanDetail.lastError.response && loanDetail.lastError.response.error ? loanDetail.lastError.response.error : 'Temporary loan detail could not be loaded.'"></div>
      <div class="alert alert-success" role="status" dmx-show="workflowNotice.value" dmx-text="workflowNotice.value"></div>
      <div class="temporary-loan-detail" dmx-show="loanDetail.data.case.temporary_loan_case_id">
        <section class="temporary-loan-detail-hero">
          <div class="temporary-loan-detail-mark"><i class="fas fa-laptop" aria-hidden="true"></i></div>
          <div class="temporary-loan-detail-identity"><p>Temporary Loan</p><h1 dmx-text="loanDetail.data.case.loan_number"></h1><a dmx-bind:href="'/tickets/detail?id=' + loanDetail.data.case.ticket_id" dmx-text="loanDetail.data.case.ticket_number"></a></div>
          <div class="temporary-loan-detail-state"><i class="far fa-clock" aria-hidden="true"></i><div><strong dmx-text="loanDetail.data.case.current_status_code == 'CONVERTED_PERMANENT' ? 'Completed' : loanDetail.data.case.loan_status_name"></strong><span dmx-text="loanDetail.data.case.current_status_code == 'PENDING_DISTRICT_APPROVAL' ? 'Waiting for district authorization' : loanDetail.data.case.current_status_code == 'AUTHORIZED' ? 'Awaiting spare selection' : loanDetail.data.case.current_status_code == 'SPARE_SELECTED' ? 'Spare reserved and awaiting issue' : loanDetail.data.case.current_status_code == 'ACTIVE_LOAN' ? 'Temporary spare is in use' : loanDetail.data.case.current_status_code == 'RETURN_REQUIRED' ? 'Spare return is outstanding' : loanDetail.data.case.current_status_code == 'RETURNED' ? 'Spare returned to Repair Centre stock' : loanDetail.data.case.current_status_code == 'CONVERTED_PERMANENT' ? 'Completed as permanent replacement; no return required' : 'Request decision recorded'"></span></div></div>
          <div class="temporary-loan-detail-actions">
            <button type="button" class="btn btn-bmobile-primary" dmx-show="authContext.data.can_temporary_loans_authorize && loanDetail.data.case.current_status_code == 'PENDING_DISTRICT_APPROVAL'" dmx-on:click="decisionMode.setValue('APPROVE');decisionModal.show()"><i class="fas fa-check me-2" aria-hidden="true"></i>Review Request</button>
            <div class="dropdown" dmx-show="!['CONVERTED_PERMANENT','RETURNED','REJECTED','CANCELLED'].contains(loanDetail.data.case.current_status_code)"><button class="btn btn-bmobile-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="fas fa-ellipsis-h me-2" aria-hidden="true"></i>More Actions</button><ul class="dropdown-menu dropdown-menu-end">
              <li dmx-show="authContext.data.can_temporary_loans_authorize && loanDetail.data.case.current_status_code == 'PENDING_DISTRICT_APPROVAL'"><button class="dropdown-item text-danger" type="button" dmx-on:click="decisionMode.setValue('REJECT');decisionModal.show()">Reject Request</button></li>
              <li dmx-show="authContext.data.can_temporary_loans_select_spare && loanDetail.data.case.current_status_code == 'AUTHORIZED'"><button class="dropdown-item" type="button" dmx-on:click="spareOptions.load({temporary_loan_case_id:query.id}, true);selectionForm.reset(true);selectionModal.show()">Select Spare</button></li>
              <li dmx-show="authContext.data.can_temporary_loans_issue && loanDetail.data.case.current_status_code == 'SPARE_SELECTED'"><button class="dropdown-item" type="button" dmx-on:click="issueForm.reset(true);issueModal.show()">Issue Temporary Spare</button></li>
              <li dmx-show="loanDetail.data.case.current_status_code == 'ACTIVE_LOAN' && authContext.data.can_temporary_loans_request_conversion && (!loanDetail.data.replacement_conflict.id || (loanDetail.data.replacement_conflict.ticket_id == loanDetail.data.case.ticket_id && loanDetail.data.replacement_conflict.current_status_code == 'SELECTION_REQUIRED' && !loanDetail.data.replacement_conflict.replacement_source_type && !loanDetail.data.replacement_conflict.active_selection_key && loanDetail.data.replacement_conflict.exception_status_code == 'REPLACEMENT_APPROVED'))"><button class="dropdown-item" type="button" dmx-on:click="conversionReasons.load();conversionRequestForm.reset(true);conversionRequestModal.show()">Request Permanent Conversion</button></li>
              <li dmx-show="loanDetail.data.case.current_status_code == 'ACTIVE_LOAN' && authContext.data.can_temporary_loans_request_return"><button class="dropdown-item" type="button" dmx-on:click="returnReasons.load();returnRequestForm.reset(true);returnRequestModal.show()">Request Spare Return</button></li>
              <li dmx-show="loanDetail.data.case.current_status_code == 'RETURN_REQUIRED' && authContext.data.can_temporary_loans_reclaim"><button class="dropdown-item" type="button" dmx-on:click="reclaimForm.reset(true);reclaimModal.show()">Record Spare Reclaimed</button></li>
              <li dmx-show="authContext.data.can_temporary_loans_approve_conversion && loanDetail.data.case.current_status_code == 'CONVERSION_PENDING_HEAD_OFFICE'"><button class="dropdown-item" type="button" dmx-on:click="conversionDecisionMode.setValue('APPROVE');conversionDecisionForm.reset(true);conversionDecisionModal.show()">Approve Permanent Conversion</button></li>
              <li dmx-show="authContext.data.can_temporary_loans_approve_conversion && loanDetail.data.case.current_status_code == 'CONVERSION_PENDING_HEAD_OFFICE'"><button class="dropdown-item text-danger" type="button" dmx-on:click="conversionDecisionMode.setValue('REJECT');conversionDecisionForm.reset(true);conversionDecisionModal.show()">Reject Permanent Conversion</button></li>
            </ul></div>
          </div>
        </section>
        <div class="alert alert-success temporary-loan-conversion-conflict mb-0" role="status" dmx-show="loanDetail.data.case.current_status_code == 'ACTIVE_LOAN' && loanDetail.data.replacement_conflict.id && loanDetail.data.replacement_conflict.ticket_id == loanDetail.data.case.ticket_id && loanDetail.data.replacement_conflict.current_status_code == 'SELECTION_REQUIRED' && !loanDetail.data.replacement_conflict.replacement_source_type && !loanDetail.data.replacement_conflict.active_selection_key && loanDetail.data.replacement_conflict.exception_status_code == 'REPLACEMENT_APPROVED"><div><strong>The existing replacement case can use this issued spare.</strong><p class="mb-1">No new stock source is needed. Submit <strong>Request Permanent Conversion</strong> from this loan. After Head Office approval, the system will complete <a class="alert-link" dmx-bind:href="'/permanent-replacements/detail?id=' + loanDetail.data.replacement_conflict.id" dmx-text="loanDetail.data.replacement_conflict.replacement_number"></a> using the spare already issued under this loan.</p></div></div><div class="alert alert-warning temporary-loan-conversion-conflict mb-0" role="status" dmx-show="loanDetail.data.case.current_status_code == 'ACTIVE_LOAN' && loanDetail.data.replacement_conflict.id && !(loanDetail.data.replacement_conflict.ticket_id == loanDetail.data.case.ticket_id && loanDetail.data.replacement_conflict.current_status_code == 'SELECTION_REQUIRED' && !loanDetail.data.replacement_conflict.replacement_source_type && !loanDetail.data.replacement_conflict.active_selection_key && loanDetail.data.replacement_conflict.exception_status_code == 'REPLACEMENT_APPROVED')"><div><strong>An active permanent replacement case already exists for this device.</strong><p class="mb-0">The open case <a class="alert-link" dmx-bind:href="'/permanent-replacements/detail?id=' + loanDetail.data.replacement_conflict.id" dmx-text="loanDetail.data.replacement_conflict.replacement_number"></a> cannot be completed with this temporary loan. Resolve that case before starting another replacement workflow.</p></div></div>
        <section class="temporary-loan-progress" aria-label="Temporary loan progress">
          <div class="temporary-loan-progress-step is-complete"><span class="temporary-loan-progress-icon"><i class="fas fa-check" aria-hidden="true"></i></span><strong>Request Created</strong><small dmx-text="loanDetail.data.case.requested_at ? loanDetail.data.case.requested_at.formatDate('MMM d, yyyy, h:mm A') : 'Not recorded'"></small></div>
          <div class="temporary-loan-progress-step" dmx-bind:class="'temporary-loan-progress-step ' + (loanDetail.data.case.current_status_code != 'PENDING_DISTRICT_APPROVAL' && loanDetail.data.case.current_status_code != 'REJECTED' ? 'is-complete' : 'is-current')"><span class="temporary-loan-progress-icon"><i class="far fa-clock" aria-hidden="true"></i></span><strong>Pending District Approval</strong><small dmx-text="loanDetail.data.case.authorized_at ? loanDetail.data.case.authorized_at.formatDate('MMM d, yyyy, h:mm A') : loanDetail.data.case.rejected_at ? loanDetail.data.case.rejected_at.formatDate('MMM d, yyyy, h:mm A') : 'Not started'"></small><em dmx-show="loanDetail.data.case.current_status_code == 'PENDING_DISTRICT_APPROVAL'">Current Stage</em></div>
          <div class="temporary-loan-progress-step" dmx-bind:class="'temporary-loan-progress-step' + (loanDetail.data.case.selected_at ? ' is-complete' : (loanDetail.data.case.current_status_code == 'AUTHORIZED' ? ' is-current' : ''))"><span class="temporary-loan-progress-icon"><i class="fas fa-wrench" aria-hidden="true"></i></span><strong>Device Allocation</strong><small dmx-text="loanDetail.data.case.selected_at ? loanDetail.data.case.selected_at.formatDate('MMM d, yyyy, h:mm A') : 'Not started'"></small><em dmx-show="loanDetail.data.case.current_status_code == 'AUTHORIZED'">Current Stage</em></div>
          <div class="temporary-loan-progress-step" dmx-bind:class="'temporary-loan-progress-step' + (loanDetail.data.case.issued_at || loanDetail.data.case.current_status_code == 'CONVERTED_PERMANENT' ? ' is-complete' : (loanDetail.data.case.current_status_code == 'SPARE_SELECTED' ? ' is-current' : ''))"><span class="temporary-loan-progress-icon"><i class="fas fa-truck" aria-hidden="true"></i></span><strong>In Use</strong><small dmx-text="loanDetail.data.case.issued_at ? loanDetail.data.case.issued_at.formatDate('MMM d, yyyy, h:mm A') : loanDetail.data.case.current_status_code == 'CONVERTED_PERMANENT' ? 'Continued as permanent replacement' : 'Not started'"></small><em dmx-show="loanDetail.data.case.current_status_code == 'SPARE_SELECTED'">Current Stage</em></div>
          <div class="temporary-loan-progress-step" dmx-bind:class="'temporary-loan-progress-step' + (loanDetail.data.case.returned_at || loanDetail.data.case.current_status_code == 'CONVERTED_PERMANENT' ? ' is-complete' : (loanDetail.data.case.current_status_code == 'RETURN_REQUIRED' ? ' is-current' : ''))"><span class="temporary-loan-progress-icon"><i class="fas fa-check" aria-hidden="true"></i></span><strong>Completed</strong><small dmx-text="loanDetail.data.case.returned_at ? loanDetail.data.case.returned_at.formatDate('MMM d, yyyy, h:mm A') : loanDetail.data.case.current_status_code == 'CONVERTED_PERMANENT' ? 'Converted to permanent replacement' : 'Not started'"></small><em dmx-show="loanDetail.data.case.current_status_code == 'RETURN_REQUIRED'">Current Stage</em></div>
        </section>
        <div class="temporary-loan-detail-grid">
          <section class="temporary-loan-detail-card"><header><i class="fas fa-file-alt" aria-hidden="true"></i><h2>Loan Overview</h2></header><dl>
            <div><dt><i class="fas fa-laptop" aria-hidden="true"></i>Original Device</dt><dd dmx-text="loanDetail.data.case.original_asset_tag || loanDetail.data.case.original_serial_number"></dd></div>
            <div><dt><i class="fas fa-university" aria-hidden="true"></i>District / School</dt><dd dmx-text="loanDetail.data.case.origin_district_name + ' / ' + loanDetail.data.case.origin_school_name"></dd></div>
            <div><dt><i class="fas fa-wrench" aria-hidden="true"></i>Repair Centre</dt><dd dmx-text="loanDetail.data.case.repair_centre_name"></dd></div>
            <div><dt><i class="fas fa-layer-group" aria-hidden="true"></i>Spare Pool</dt><dd dmx-text="loanDetail.data.case.spare_pool_name"></dd></div>
            <div><dt><i class="fas fa-info-circle" aria-hidden="true"></i>Request Reason</dt><dd dmx-text="loanDetail.data.case.request_reason_code == 'MANUFACTURER_RETURN' ? 'Manufacturer return' : 'Repair in progress'"></dd></div>
            <div><dt><i class="far fa-file-alt" aria-hidden="true"></i>Request Note</dt><dd class="text-break" dmx-text="loanDetail.data.case.request_notes || '-' "></dd></div>
            <div><dt><i class="far fa-calendar-alt" aria-hidden="true"></i>Requested</dt><dd dmx-text="loanDetail.data.case.requested_at ? loanDetail.data.case.requested_at.formatDate('MMM d, yyyy, h:mm A') : 'Not recorded'"></dd></div>
          </dl></section>
          <section class="temporary-loan-detail-card"><header><i class="fas fa-cube" aria-hidden="true"></i><h2>Spare Device</h2></header><dl>
            <div><dt><i class="fas fa-laptop" aria-hidden="true"></i>Device</dt><dd dmx-text="loanDetail.data.case.selected_spare_asset_tag || loanDetail.data.case.selected_spare_serial_number || 'Not Selected'"></dd></div>
            <div dmx-show="loanDetail.data.case.selected_spare_device_id"><dt><i class="fas fa-sync-alt" aria-hidden="true"></i>Manufacturer / Model</dt><dd dmx-text="loanDetail.data.case.selected_spare_manufacturer_name + ' / ' + loanDetail.data.case.selected_spare_model_name"></dd></div>
            <div><dt><i class="fas fa-sync-alt" aria-hidden="true"></i>Lifecycle</dt><dd dmx-text="loanDetail.data.case.selected_spare_lifecycle_code || 'Not assigned'"></dd></div>
            <div><dt><i class="fas fa-box-open" aria-hidden="true"></i>Free Stock</dt><dd dmx-text="loanDetail.data.case.selected_spare_stock_status || 'Not applicable'"></dd></div>
            <div><dt><i class="far fa-bookmark" aria-hidden="true"></i>Reservation</dt><dd dmx-text="loanDetail.data.case.spare_reservation_status == 'RESERVED' && loanDetail.data.case.spare_reservation_active == 1 ? 'Reserved for this loan' : (loanDetail.data.case.spare_reservation_status == 'CONSUMED' ? 'Consumed at issue' : 'None')"></dd></div>
            <div><dt><i class="fas fa-map-marker-alt" aria-hidden="true"></i>Issued At</dt><dd dmx-text="loanDetail.data.case.issued_at ? loanDetail.data.case.issued_at.formatDate('MMM d, yyyy, h:mm A') : 'Not issued'"></dd></div>
            <div><dt><i class="fas fa-user" aria-hidden="true"></i>Temporary Loan Custody</dt><dd dmx-text="loanDetail.data.case.physical_custody_code || 'No temporary-loan custody event'"></dd></div>
          </dl></section>
          <section class="temporary-loan-detail-card"><header><i class="fas fa-sitemap" aria-hidden="true"></i><h2>Current Workflow</h2></header><dl>
            <div><dt><i class="fas fa-ticket-alt" aria-hidden="true"></i>Ticket</dt><dd dmx-text="loanDetail.data.case.ticket_status_code"></dd></div>
            <div><dt><i class="fas fa-truck" aria-hidden="true"></i>Logistics</dt><dd dmx-text="loanDetail.data.case.logistics_status_code"></dd></div>
            <div><dt><i class="fas fa-reply" aria-hidden="true"></i>Manufacturer Return</dt><dd dmx-text="loanDetail.data.case.manufacturer_return_status_code || 'Not active'"></dd></div>
            <div><dt><i class="fas fa-check-circle" aria-hidden="true"></i>Repair Completed</dt><dd dmx-text="loanDetail.data.case.repair_completed_at ? loanDetail.data.case.repair_completed_at.formatDate('MMM d, yyyy, h:mm A') : 'Not completed'"></dd></div>
          </dl></section>
          <section class="temporary-loan-detail-card"><header><i class="fas fa-info-circle" aria-hidden="true"></i><h2>Additional Information</h2></header>
            <div class="temporary-loan-detail-info" dmx-show="loanDetail.data.case.current_status_code != 'CONVERTED_PERMANENT'"><i class="fas fa-info-circle" aria-hidden="true"></i><p>The original device remains the Phase 5 educational asset.<br>The temporary spare receives no Phase 5 allocation.</p></div>
            <div class="temporary-loan-detail-info" dmx-show="loanDetail.data.case.current_status_code == 'CONVERTED_PERMANENT'"><i class="fas fa-info-circle" aria-hidden="true"></i><p>The spare is now the permanent Phase 5 asset. The original remains in history with lifecycle REPLACED.</p></div>
          </section>
        </div>
        <section class="temporary-loan-detail-card temporary-loan-history"><header><i class="fas fa-history" aria-hidden="true"></i><h2>Loan History</h2></header><div class="table-responsive portal-table-wrapper"><table class="table portal-table align-middle"><thead><tr><th>Recorded</th><th>From</th><th>To</th><th>Note</th><th>By</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="loanDetail.data.history"><tr><td class="text-nowrap" dmx-text="recorded_at_display"></td><td dmx-text="from_status_code || 'Created'"></td><td dmx-text="to_status_code"></td><td class="text-break" dmx-text="notes || '-' "></td><td dmx-text="actor_display_name || 'System'"></td></tr></tbody></table></div></section>
        <section class="temporary-loan-detail-card temporary-loan-history" dmx-show="loanDetail.data.case.latest_conversion_request_id"><header><i class="fas fa-exchange-alt" aria-hidden="true"></i><h2>Permanent Conversion</h2></header><dl class="row mb-0"><dt class="col-sm-4">Conversion Status</dt><dd class="col-sm-8" dmx-text="loanDetail.data.case.conversion_request_status == 'PENDING' ? 'Pending Head Office Approval' : (loanDetail.data.case.conversion_request_status == 'APPROVED' ? 'Approved' : 'Rejected')"></dd><dt class="col-sm-4">Conversion Request</dt><dd class="col-sm-8" dmx-text="loanDetail.data.case.conversion_request_number"></dd><dt class="col-sm-4">Requested</dt><dd class="col-sm-8" dmx-text="loanDetail.data.case.conversion_requested_at ? loanDetail.data.case.conversion_requested_at.formatDate('MMM d, yyyy, h:mm A') : 'Not recorded'"></dd><dt class="col-sm-4">Requested By</dt><dd class="col-sm-8" dmx-text="loanDetail.data.case.conversion_requested_by_name || 'Not recorded'"></dd><dt class="col-sm-4">Reason</dt><dd class="col-sm-8" dmx-text="loanDetail.data.case.conversion_reason_name"></dd><dt class="col-sm-4" dmx-show="loanDetail.data.case.conversion_request_notes">Request Notes</dt><dd class="col-sm-8 text-break" dmx-show="loanDetail.data.case.conversion_request_notes" dmx-text="loanDetail.data.case.conversion_request_notes"></dd><dt class="col-sm-4" dmx-show="loanDetail.data.case.conversion_decision">Head Office Decision</dt><dd class="col-sm-8" dmx-show="loanDetail.data.case.conversion_decision" dmx-text="loanDetail.data.case.conversion_decision == 'APPROVE' ? 'Approved' : 'Rejected'"></dd><dt class="col-sm-4" dmx-show="loanDetail.data.case.conversion_decided_at">Decided At</dt><dd class="col-sm-8" dmx-show="loanDetail.data.case.conversion_decided_at" dmx-text="loanDetail.data.case.conversion_decided_at.formatDate('MMM d, yyyy, h:mm A')"></dd><dt class="col-sm-4" dmx-show="loanDetail.data.case.permanent_replacement_number">Permanent Replacement</dt><dd class="col-sm-8"><a dmx-show="loanDetail.data.case.permanent_replacement_case_id" dmx-bind:href="'/permanent-replacements/detail?id=' + loanDetail.data.case.permanent_replacement_case_id" dmx-text="loanDetail.data.case.permanent_replacement_number"></a></dd></dl></section>
        <section class="temporary-loan-detail-card temporary-loan-history" dmx-show="loanDetail.data.case.return_requested_at || loanDetail.data.case.returned_at"><header><i class="fas fa-undo" aria-hidden="true"></i><h2>Spare Return</h2></header><dl class="row mb-0"><dt class="col-sm-4" dmx-show="loanDetail.data.case.return_requested_at">Return Requested</dt><dd class="col-sm-8" dmx-show="loanDetail.data.case.return_requested_at" dmx-text="loanDetail.data.case.return_requested_at.formatDate('MMM d, yyyy, h:mm A')"></dd><dt class="col-sm-4" dmx-show="loanDetail.data.case.return_reason_name">Reason</dt><dd class="col-sm-8" dmx-show="loanDetail.data.case.return_reason_name" dmx-text="loanDetail.data.case.return_reason_name"></dd><dt class="col-sm-4" dmx-show="loanDetail.data.case.return_notes">Return Notes</dt><dd class="col-sm-8 text-break" dmx-show="loanDetail.data.case.return_notes" dmx-text="loanDetail.data.case.return_notes"></dd><dt class="col-sm-4" dmx-show="loanDetail.data.case.returned_at">Returned At</dt><dd class="col-sm-8" dmx-show="loanDetail.data.case.returned_at" dmx-text="loanDetail.data.case.returned_at.formatDate('MMM d, yyyy, h:mm A')"></dd><dt class="col-sm-4" dmx-show="loanDetail.data.case.return_condition_code">Condition</dt><dd class="col-sm-8" dmx-show="loanDetail.data.case.return_condition_code" dmx-text="loanDetail.data.case.return_condition_code"></dd></dl></section>
        <section class="temporary-loan-detail-card temporary-loan-history" dmx-show="loanDetail.data.decision.decision_code"><header><i class="fas fa-clipboard-check" aria-hidden="true"></i><h2>District Decision</h2></header><dl class="row mb-0"><dt class="col-sm-4">Decision</dt><dd class="col-sm-8" dmx-text="loanDetail.data.decision.decision_code == 'APPROVE' ? 'Authorized' : 'Rejected'"></dd><dt class="col-sm-4">Recorded</dt><dd class="col-sm-8" dmx-text="loanDetail.data.decision.created_at ? loanDetail.data.decision.created_at.formatDate('MMM d, yyyy, h:mm A') : 'Not recorded'"></dd><dt class="col-sm-4">By</dt><dd class="col-sm-8" dmx-text="loanDetail.data.decision.actor_display_name || 'System'"></dd><dt class="col-sm-4">Note</dt><dd class="col-sm-8 text-break" dmx-text="loanDetail.data.decision.notes || '-' "></dd></dl></section>
        <section class="temporary-loan-detail-card temporary-loan-history" dmx-show="loanDetail.data.custody_history.length"><header><i class="fas fa-people-carry" aria-hidden="true"></i><h2>Temporary Loan Custody</h2></header><div class="table-responsive portal-table-wrapper"><table class="table portal-table align-middle"><thead><tr><th>Recorded</th><th>Spare Device</th><th>From</th><th>To</th><th>Note</th><th>Recorded By</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="loanDetail.data.custody_history"><tr><td class="text-nowrap" dmx-text="recorded_at_display"></td><td dmx-text="loanDetail.data.case.selected_spare_asset_tag || loanDetail.data.case.selected_spare_serial_number"></td><td dmx-text="from_custody_code || '-' "></td><td dmx-text="to_custody_code"></td><td dmx-text="notes || '-' "></td><td dmx-text="actor_display_name || 'System'"></td></tr></tbody></table></div></section>
        <section class="temporary-loan-detail-card temporary-loan-history" dmx-show="loanDetail.data.case.current_status_code == 'RETURNED'"><p class="mb-0">The serviceable spare was received by the Repair Centre and returned to AVAILABLE free stock. It remains a temporary asset, not a permanent replacement for the original educational device.</p></section>
        <section class="temporary-loan-detail-card temporary-loan-history" dmx-show="loanDetail.data.case.current_status_code == 'CONVERTED_PERMANENT'"><header><i class="fas fa-exchange-alt" aria-hidden="true"></i><h2>Converted to Permanent</h2></header><dl class="row mb-0"><dt class="col-sm-4">Permanent Replacement</dt><dd class="col-sm-8"><a dmx-bind:href="'/permanent-replacements/detail?id=' + loanDetail.data.case.permanent_replacement_case_id" dmx-text="loanDetail.data.case.permanent_replacement_number"></a></dd><dt class="col-sm-4">Original Device</dt><dd class="col-sm-8" dmx-text="loanDetail.data.case.original_serial_number"></dd><dt class="col-sm-4">Current Permanent Device</dt><dd class="col-sm-8" dmx-text="loanDetail.data.case.selected_spare_serial_number"></dd><dt class="col-sm-4">Physical Custody</dt><dd class="col-sm-8">With Recipient</dd></dl><p class="small text-muted mb-0 mt-2">No Repair Centre stock return, TTPost movement, or school receipt is recorded by this conversion.</p></section>
      </div>
    </main>
  </div>
</div>
