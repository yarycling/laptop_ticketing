<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="manufacturerReturnDetailPage" appConnect="local" components="{dmxBootstrap5Modal:{}}" -->
<meta name="ac:route" content="/manufacturer-returns/detail">
<div class="portal-shell">
	  <dmx-serverconnect id="authContext" url="/api/auth/context"></dmx-serverconnect><dmx-serverconnect id="returnDetail" url="/api/manufacturer-returns/detail" dmx-param:id="query.id"></dmx-serverconnect><dmx-serverconnect id="carrierOptions" url="/api/manufacturer-returns/carrier-options"></dmx-serverconnect><dmx-serverconnect id="outcomeOptions" url="/api/manufacturer-returns/outcome-options"></dmx-serverconnect>
	  <dmx-value id="returnNotice" value=""></dmx-value>
	  <div id="outboundPrepareModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="outboundPrepareTitle" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="outboundPrepareTitle">Prepare Outbound Shipment</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="outboundPrepareForm" is="dmx-serverconnect-form" method="post" action="/api/manufacturer-returns/outbound/prepare" dmx-on:success="outboundPrepareModal.hide();outboundPrepareForm.reset(true);returnDetail.load();returnNotice.setValue('Outbound shipment prepared.')"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="outboundPrepareForm.lastError.status" dmx-text="outboundPrepareForm.lastError.response && outboundPrepareForm.lastError.response.error ? outboundPrepareForm.lastError.response.error : 'Outbound shipment could not be prepared.'"></div><input type="hidden" name="manufacturer_return_case_id" dmx-bind:value="query.id"><div class="row g-3"><div class="col-md-6"><label class="form-label" for="outboundCarrier">Outbound carrier</label><select id="outboundCarrier" name="carrier_id" class="form-select" required><option value="">Select carrier</option><option dmx-repeat="carrierOptions.data.carriers" dmx-bind:value="id" dmx-text="name"></option></select></div><div class="col-md-6"><label class="form-label" for="expectedReturn">Expected return date</label><input id="expectedReturn" name="expected_return_date" class="form-control" type="date"></div><div class="col-md-6"><label class="form-label" for="outboundRma">RMA number</label><input id="outboundRma" name="rma_number" class="form-control" maxlength="180"></div><div class="col-md-6"><label class="form-label" for="outboundCaseRef">Manufacturer case reference</label><input id="outboundCaseRef" name="manufacturer_case_reference" class="form-control" maxlength="180"></div><div class="col-md-6"><label class="form-label" for="outboundTracking">Tracking reference</label><input id="outboundTracking" name="tracking_reference" class="form-control" maxlength="180"></div><div class="col-md-6"><label class="form-label" for="outboundShipmentRef">Shipment reference</label><input id="outboundShipmentRef" name="shipment_reference" class="form-control" maxlength="180"></div></div></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="outboundPrepareForm.state.executing">Prepare Outbound Shipment</button></div></form></div></div></div>
	  <div id="outcomeModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="outcomeTitle" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="outcomeTitle">Record Manufacturer Outcome</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="outcomeForm" is="dmx-serverconnect-form" method="post" action="/api/manufacturer-returns/outcome/create" dmx-on:success="outcomeModal.hide();outcomeForm.reset(true);returnDetail.load();returnNotice.setValue('Manufacturer outcome recorded.')"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="outcomeForm.lastError.status" dmx-text="outcomeForm.lastError.response && outcomeForm.lastError.response.error ? outcomeForm.lastError.response.error : 'Manufacturer outcome could not be recorded.'"></div><input type="hidden" name="manufacturer_return_case_id" dmx-bind:value="query.id"><div class="row g-3"><div class="col-md-4"><label class="form-label" for="outcomeCode">Outcome</label><select id="outcomeCode" name="outcome_code" class="form-select" required><option value="">Select outcome</option><option dmx-repeat="outcomeOptions.data.outcomes" dmx-bind:value="code" dmx-text="name"></option></select></div><div class="col-md-4"><label class="form-label" for="outcomeDate">Outcome date</label><input id="outcomeDate" name="outcome_date" type="date" class="form-control" required></div><div class="col-md-4"><label class="form-label" for="outcomeReason">Reason / operational notes</label><input id="outcomeReason" name="reason" class="form-control" maxlength="1000"></div><div class="col-12" dmx-show="outcomeCode.value == 'REPLACEMENT_SUPPLIED'"><div class="row g-3"><div class="col-md-4"><label class="form-label" for="stagedSerial">Supplied unit serial</label><input id="stagedSerial" name="serial_number" class="form-control" maxlength="150" dmx-bind:required="outcomeCode.value == 'REPLACEMENT_SUPPLIED'"></div><div class="col-md-4"><label class="form-label" for="stagedModelRef">Manufacturer model reference</label><input id="stagedModelRef" name="manufacturer_model_reference" class="form-control" maxlength="180"></div><div class="col-md-4"><label class="form-label" for="stagedModelDescription">Model description</label><input id="stagedModelDescription" name="model_description" class="form-control" maxlength="500"></div><div class="col-md-4"><label class="form-label" for="stagedWarrantyRef">Warranty reference</label><input id="stagedWarrantyRef" name="manufacturer_warranty_reference" class="form-control" maxlength="180"></div><div class="col-md-4"><label class="form-label" for="stagedWarrantyStart">Warranty start</label><input id="stagedWarrantyStart" name="warranty_start" type="date" class="form-control"></div><div class="col-md-4"><label class="form-label" for="stagedWarrantyEnd">Warranty end</label><input id="stagedWarrantyEnd" name="warranty_end" type="date" class="form-control"></div></div><p class="small text-warning mt-2 mb-0">The supplied unit is staged only and will not be added to the asset register in Phase 8B.</p></div><div class="col-12"><label class="form-label" for="outcomeNotes">Notes</label><textarea id="outcomeNotes" name="notes" class="form-control" rows="3" maxlength="4000"></textarea></div></div></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="outcomeForm.state.executing">Record Manufacturer Outcome</button></div></form></div></div></div>
	  <%- await include("partials/portal-sidebar", { currentPage: "manufacturer-returns" }) %>
  <div class="portal-workspace"><%- await include("partials/portal-topbar", { backHref: "/manufacturer-returns", pageTitle: "Manufacturer Return Detail" }) %>
    <main class="portal-main service-page">
      <div class="alert alert-success" role="status" dmx-show="returnNotice.value" dmx-text="returnNotice.value"></div><div class="alert alert-danger" role="alert" dmx-show="returnDetail.lastError.status" dmx-text="returnDetail.lastError.response && returnDetail.lastError.response.error ? returnDetail.lastError.response.error : 'Return details could not be loaded.'"></div>
      <section class="portal-section mb-3"><div class="d-flex justify-content-between align-items-start"><div><h1 class="h3 mb-1" dmx-text="returnDetail.data.case.manufacturer_return_number"></h1><p class="text-muted mb-0"><span dmx-text="returnDetail.data.case.ticket_number"></span> · <span dmx-text="returnDetail.data.case.serial_number"></span></p></div><span class="badge text-bg-light" dmx-text="returnDetail.data.case.manufacturer_return_status_name"></span></div></section>
      <div class="row g-3">
        <div class="col-lg-6"><section class="portal-section h-100"><h2 class="h5">Ticket Context / Phase 7 Logistics</h2><dl class="row mb-0"><dt class="col-5">Ticket</dt><dd class="col-7" dmx-text="returnDetail.data.case.ticket_number"></dd><dt class="col-5">Logistics #</dt><dd class="col-7" dmx-text="returnDetail.data.case.logistics_number"></dd><dt class="col-5">Phase 7 Logistics</dt><dd class="col-7" dmx-text="returnDetail.data.case.logistics_status_name"></dd><dt class="col-5">Phase 7 Physical Custody</dt><dd class="col-7" dmx-text="returnDetail.data.case.phase7_physical_state_code"></dd><dt class="col-5">Manufacturer return</dt><dd class="col-7" dmx-text="returnDetail.data.case.manufacturer_return_status_name"></dd><dt class="col-5">Manufacturer physical custody</dt><dd class="col-7" dmx-text="returnDetail.data.case.physical_custody_code"></dd><dt class="col-5">Original device</dt><dd class="col-7" dmx-text="returnDetail.data.case.serial_number + ' · ' + (returnDetail.data.case.asset_tag || 'No asset tag')"></dd><dt class="col-5">Exception</dt><dd class="col-7" dmx-text="returnDetail.data.case.exception_status_code"></dd></dl></section></div>
        <div class="col-lg-6"><section class="portal-section h-100"><h2 class="h5">Manufacturer / RMA</h2><dl class="row mb-0"><dt class="col-5">Manufacturer</dt><dd class="col-7" dmx-text="returnDetail.data.manufacturer.manufacturer_name"></dd><dt class="col-5">RMA</dt><dd class="col-7" dmx-text="returnDetail.data.manufacturer.rma_number || 'Not recorded'"></dd><dt class="col-5">Case reference</dt><dd class="col-7" dmx-text="returnDetail.data.manufacturer.manufacturer_case_reference || 'Not recorded'"></dd><dt class="col-5">Warranty reference</dt><dd class="col-7" dmx-text="returnDetail.data.manufacturer.warranty_reference || 'Not recorded'"></dd><dt class="col-5">Expected return</dt><dd class="col-7" dmx-text="returnDetail.data.manufacturer.expected_return_date ? returnDetail.data.manufacturer.expected_return_date.formatDate('MMM d, yyyy') : 'Not recorded'"></dd></dl></section></div>
        <div class="col-12"><section class="portal-section"><h2 class="h5">Shipment History</h2><div class="table-responsive portal-table-wrapper"><table class="table portal-table"><thead><tr><th>Direction</th><th>Carrier</th><th>Tracking</th><th>Shipment Reference</th><th>Prepared</th><th>Pickup</th><th>Received</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="returnDetail.data.shipments"><tr><td dmx-text="direction"></td><td dmx-text="carrier_name"></td><td dmx-text="tracking_reference || 'Not recorded'"></td><td dmx-text="shipment_reference || 'Not recorded'"></td><td dmx-text="prepared_at.formatDate('MMM d, yyyy, h:mm A')"></td><td dmx-text="carrier_pickup_at ? carrier_pickup_at.formatDate('MMM d, yyyy, h:mm A') : 'Pending'"></td><td dmx-text="destination_received_at ? destination_received_at.formatDate('MMM d, yyyy, h:mm A') : 'Pending'"></td></tr></tbody></table></div></section></div>
        <div class="col-lg-6"><section class="portal-section h-100"><h2 class="h5">Manufacturer Outcome</h2><p class="mb-1" dmx-text="returnDetail.data.outcome.outcome_code || 'No outcome recorded'"></p><p class="small text-muted" dmx-text="returnDetail.data.outcome.notes || ''"></p><div class="alert alert-warning mb-0" dmx-show="returnDetail.data.outcome.outcome_code == 'REPLACEMENT_SUPPLIED'"><strong>Staged — Not Yet Added to Asset Register.</strong><div dmx-text="returnDetail.data.staged_unit.serial_number"></div></div></section></div>
        <div class="col-lg-6"><section class="portal-section h-100"><h2 class="h5">Status History</h2><div class="table-responsive portal-table-wrapper"><table class="table portal-table"><thead><tr><th>Recorded</th><th>From</th><th>To</th><th>Reason</th><th>By</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="returnDetail.data.history"><tr><td class="text-nowrap" dmx-text="created_at.formatDate('MMM d, yyyy, h:mm A')"></td><td dmx-text="from_status_code || 'Created'"></td><td dmx-text="to_status_code"></td><td dmx-text="reason || '-' "></td><td dmx-text="actor_display_name || 'System'"></td></tr></tbody></table></div></section></div>
      </div>
      <section class="portal-section mt-3"><h2 class="h5">Workflow Actions</h2><p class="small text-muted">Actions appear only for the current workflow state. The Server Connect action applies authoritative permission and state checks.</p>
		        <button class="btn btn-bmobile-primary mb-2" type="button" dmx-show="authContext.data.can_manufacturer_returns_prepare_outbound && returnDetail.data.case.manufacturer_return_status_code == 'PREPARATION_REQUIRED'" dmx-on:click="outboundPrepareForm.reset(true);outboundPrepareModal.show()">Prepare Outbound Shipment</button>
	        <form id="outboundTtpostForm" is="dmx-serverconnect-form" method="post" action="/api/manufacturer-returns/outbound/tt-post-pickup" class="mb-2" dmx-show="authContext.data.can_manufacturer_returns_ttpost_outbound_pickup && returnDetail.data.case.manufacturer_return_status_code == 'AWAITING_OUTBOUND_CARRIER_PICKUP' && returnDetail.data.case.outbound_carrier_type == 'TTPOST'" dmx-on:success="returnDetail.load();returnNotice.setValue('TTPost pickup recorded.')"><input type="hidden" name="manufacturer_return_case_id" dmx-bind:value="query.id"><button class="btn btn-bmobile-primary" type="submit">Confirm TTPost Manufacturer Pickup</button></form>
	        <form id="outboundExternalForm" is="dmx-serverconnect-form" method="post" action="/api/manufacturer-returns/outbound/external-pickup" class="mb-2" dmx-show="authContext.data.can_manufacturer_returns_external_outbound_pickup && returnDetail.data.case.manufacturer_return_status_code == 'AWAITING_OUTBOUND_CARRIER_PICKUP' && returnDetail.data.case.outbound_carrier_type == 'EXTERNAL'" dmx-on:success="returnDetail.load();returnNotice.setValue('External courier pickup recorded.')"><input type="hidden" name="manufacturer_return_case_id" dmx-bind:value="query.id"><button class="btn btn-bmobile-secondary" type="submit">Record External Courier Pickup</button></form>
	        <form id="ackForm" is="dmx-serverconnect-form" method="post" action="/api/manufacturer-returns/manufacturer/acknowledge" class="mb-2" dmx-show="authContext.data.can_manufacturer_returns_manufacturer_acknowledge && returnDetail.data.case.manufacturer_return_status_code == 'OUTBOUND_IN_TRANSIT'" dmx-on:success="returnDetail.load();returnNotice.setValue('Manufacturer receipt acknowledged.')"><input type="hidden" name="manufacturer_return_case_id" dmx-bind:value="query.id"><button class="btn btn-bmobile-primary" type="submit">Record Manufacturer Acknowledgement</button></form>
		        <button class="btn btn-bmobile-primary mb-2" type="button" dmx-show="authContext.data.can_manufacturer_returns_record_outcome && returnDetail.data.case.manufacturer_return_status_code == 'AT_MANUFACTURER' && !returnDetail.data.outcome.outcome_code" dmx-on:click="outcomeForm.reset(true);outcomeModal.show()">Record Manufacturer Outcome</button>
	        <form id="returnPrepareForm" is="dmx-serverconnect-form" method="post" action="/api/manufacturer-returns/return/prepare" class="row g-2 mb-3" dmx-show="authContext.data.can_manufacturer_returns_prepare_return && returnDetail.data.case.manufacturer_return_status_code == 'AT_MANUFACTURER' && returnDetail.data.outcome.outcome_code" dmx-on:success="returnDetail.load();returnNotice.setValue('Return shipment prepared.')"><input type="hidden" name="manufacturer_return_case_id" dmx-bind:value="query.id"><div class="col-md-4"><label class="form-label" for="returnCarrier">Return carrier</label><select id="returnCarrier" name="carrier_id" class="form-select" required><option value="">Select carrier</option><option dmx-repeat="carrierOptions.data.carriers" dmx-bind:value="id" dmx-text="name"></option></select></div><div class="col-md-4"><label class="form-label" for="returnTracking">Tracking reference</label><input id="returnTracking" name="tracking_reference" class="form-control" maxlength="180"></div><div class="col-md-4"><label class="form-label" for="returnShipmentRef">Shipment reference</label><input id="returnShipmentRef" name="shipment_reference" class="form-control" maxlength="180"></div><div class="col-12"><button class="btn btn-bmobile-primary" type="submit">Prepare Return Shipment</button></div></form>
	        <form id="returnTtpostForm" is="dmx-serverconnect-form" method="post" action="/api/manufacturer-returns/return/tt-post-pickup" class="mb-2" dmx-show="authContext.data.can_manufacturer_returns_ttpost_return_pickup && returnDetail.data.case.manufacturer_return_status_code == 'AWAITING_RETURN_CARRIER_PICKUP' && returnDetail.data.case.return_carrier_type == 'TTPOST'" dmx-on:success="returnDetail.load();returnNotice.setValue('TTPost return pickup recorded.')"><input type="hidden" name="manufacturer_return_case_id" dmx-bind:value="query.id"><button class="btn btn-bmobile-primary" type="submit">Confirm TTPost Return Pickup</button></form>
	        <form id="returnExternalForm" is="dmx-serverconnect-form" method="post" action="/api/manufacturer-returns/return/external-pickup" class="mb-2" dmx-show="authContext.data.can_manufacturer_returns_external_return_pickup && returnDetail.data.case.manufacturer_return_status_code == 'AWAITING_RETURN_CARRIER_PICKUP' && returnDetail.data.case.return_carrier_type == 'EXTERNAL'" dmx-on:success="returnDetail.load();returnNotice.setValue('External return pickup recorded.')"><input type="hidden" name="manufacturer_return_case_id" dmx-bind:value="query.id"><button class="btn btn-bmobile-secondary" type="submit">Record External Return Pickup</button></form>
	        <form id="repairReceiveForm" is="dmx-serverconnect-form" method="post" action="/api/manufacturer-returns/return/repair-centre-receive" class="mb-2" dmx-show="authContext.data.can_manufacturer_returns_repair_receive && returnDetail.data.case.manufacturer_return_status_code == 'RETURN_IN_TRANSIT'" dmx-on:success="returnDetail.load();returnNotice.setValue('Manufacturer return received at the Repair Centre.')"><input type="hidden" name="manufacturer_return_case_id" dmx-bind:value="query.id"><button class="btn btn-bmobile-primary" type="submit">Confirm Manufacturer Return Receipt</button></form>
      </section>
    </main>
  </div>
</div>
