<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="logisticsPage" appConnect="local" components="{dmxBootstrap5Modal:{}}" -->
<meta name="ac:route" content="/logistics">
<div class="portal-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context" dmx-on:success="authContext.data.can_logistics_repair_receive && !authContext.data.can_logistics_forward_to_repair ? logisticsList.load({search:'',status_code:'ALL',handoff_state:'PENDING_REPAIR_CENTRE_RECEIPT',district_id:'',school_id:'',page:1,page_size:rowsPerPage.value}, true) : ''"></dmx-serverconnect>
  <dmx-serverconnect id="logisticsList" url="/api/logistics/list" dmx-param:status_code="statusFilter.value" dmx-param:handoff_state="handoffStateFilter.value" dmx-param:district_id="districtFilter.value" dmx-param:school_id="schoolFilter.value" dmx-param:search="searchInput.value" dmx-param:page="currentPage.value" dmx-param:page_size="rowsPerPage.value"></dmx-serverconnect>
  <dmx-serverconnect id="logisticsFilterOptions" url="/api/logistics/filter-options"></dmx-serverconnect>
  <dmx-serverconnect id="logisticsSchoolOptions" url="/api/logistics/school-options" dmx-param:district_id="districtFilter.value"></dmx-serverconnect>
  <dmx-serverconnect id="logisticsSummary" url="/api/logistics/summary"></dmx-serverconnect>
  <dmx-value id="currentPage" value="1"></dmx-value>
  <dmx-value id="rowsPerPage" value="10"></dmx-value>
  <dmx-value id="queueNotice" value=""></dmx-value>
  <dmx-value id="logisticsChartsVisible" value="true"></dmx-value>
  <%- await include("partials/portal-sidebar", { currentPage: "logistics" }) %>
  <div class="portal-workspace"><%- await include("partials/portal-topbar", { pageTitle: "Logistics" }) %>
    <main class="portal-main phase8cd-mobile-tables service-page logistics-dashboard-page">
      <section class="logistics-hero-banner" aria-labelledby="logisticsPageTitle">
        <div class="logistics-hero-icon"><i class="fas fa-truck" aria-hidden="true"></i></div>
        <div class="logistics-hero-copy">
          <div class="logistics-hero-eyebrow">REPAIRS &amp; LOGISTICS</div>
          <h1 id="logisticsPageTitle">Logistics</h1>
          <p dmx-text="authContext.data.can_logistics_repair_receive && !authContext.data.can_logistics_forward_to_repair ? 'Repair Centre incoming devices and physical receipt.' : 'TTPost pickup requests and physical handoffs.'">TTPost pickup requests and physical handoffs.</p>
        </div>
      </section>

      <div class="alert alert-success logistics-notice" role="status" dmx-show="queueNotice.value" dmx-text="queueNotice.value"></div>
      <div class="alert alert-danger logistics-notice" role="alert" dmx-show="logisticsList.lastError.status" dmx-text="logisticsList.lastError.response && logisticsList.lastError.response.error ? logisticsList.lastError.response.error : 'Logistics requests could not be loaded.'"></div>

      <section class="logistics-kpi-grid" aria-label="Logistics status summary">
        <article class="logistics-kpi-card"><span class="logistics-kpi-icon mint"><i class="fas fa-file-alt" aria-hidden="true"></i></span><div><strong dmx-text="logisticsSummary.data.requested || 0">0</strong><span>Requested</span></div></article>
        <article class="logistics-kpi-card"><span class="logistics-kpi-icon mint"><i class="fas fa-check-circle" aria-hidden="true"></i></span><div><strong dmx-text="logisticsSummary.data.accepted || 0">0</strong><span>Accepted</span></div></article>
        <article class="logistics-kpi-card"><span class="logistics-kpi-icon amber"><i class="fas fa-cube" aria-hidden="true"></i></span><div><strong dmx-text="logisticsSummary.data.pending_ttpost_receipt || 0">0</strong><span>Awaiting TTPost Receipt</span></div></article>
        <article class="logistics-kpi-card"><span class="logistics-kpi-icon blue"><i class="fas fa-truck" aria-hidden="true"></i></span><div><strong dmx-text="logisticsSummary.data.ttpost_custody || 0">0</strong><span>In TTPost Custody</span></div></article>
        <article class="logistics-kpi-card"><span class="logistics-kpi-icon violet"><i class="fas fa-download" aria-hidden="true"></i></span><div><strong dmx-text="logisticsSummary.data.pending_repair_centre_receipt || 0">0</strong><span>Awaiting Repair Centre Receipt</span></div></article>
        <article class="logistics-kpi-card"><span class="logistics-kpi-icon coral"><i class="fas fa-wrench" aria-hidden="true"></i></span><div><strong dmx-text="logisticsSummary.data.repair_centre_custody || 0">0</strong><span>At Repair Centre</span></div></article>
        <article class="logistics-kpi-card"><span class="logistics-kpi-icon blue"><i class="fas fa-upload" aria-hidden="true"></i></span><div><strong dmx-text="logisticsSummary.data.pending_ttpost_return_receipt || 0">0</strong><span>Awaiting TTPost Return Receipt</span></div></article>
        <article class="logistics-kpi-card"><span class="logistics-kpi-icon mint"><i class="fas fa-school" aria-hidden="true"></i></span><div><strong dmx-text="logisticsSummary.data.ttpost_return_custody || 0">0</strong><span>Return to School</span></div></article>
        <article class="logistics-kpi-card"><span class="logistics-kpi-icon violet"><i class="fas fa-flag" aria-hidden="true"></i></span><div><strong dmx-text="logisticsSummary.data.pending_school_return_receipt || 0">0</strong><span>Awaiting School Return Receipt</span></div></article>
      </section>

      <section class="logistics-distribution-card" aria-label="Loaded logistics status">
        <div class="logistics-distribution-heading">
          <div class="logistics-panel-title"><span class="logistics-panel-icon mint"><i class="fas fa-chart-pie" aria-hidden="true"></i></span><div><h2>Loaded logistics status</h2><p>Current page distribution.</p></div></div>
          <div class="logistics-chart-controls">
            <label class="logistics-toggle"><input type="checkbox" role="switch" id="logisticsChartsVisibleSwitch" dmx-bind:checked="logisticsChartsVisible.value" dmx-on:change="logisticsChartsVisible.setValue(logisticsChartsVisibleSwitch.checked)"><span>Show charts</span></label>
            <label class="logistics-toggle"><input type="checkbox" role="switch" id="inTransitSwitch" dmx-bind:checked="statusFilter.value == 'OUTBOUND_IN_TRANSIT'" dmx-on:change="statusFilter.setValue(inTransitSwitch.checked ? 'OUTBOUND_IN_TRANSIT' : 'ALL');currentPage.setValue(1);logisticsList.load({search:searchInput.value,status_code:inTransitSwitch.checked ? 'OUTBOUND_IN_TRANSIT' : 'ALL',handoff_state:handoffStateFilter.value,district_id:districtFilter.value,school_id:schoolFilter.value,page:1,page_size:rowsPerPage.value}, true)"><span>In transit only</span></label>
            <button type="button" class="btn logistics-clear-button" dmx-on:click="searchInput.setValue('');statusFilter.setValue('ALL');handoffStateFilter.setValue('ALL');districtFilter.setValue('');schoolFilter.setValue('');currentPage.setValue(1);logisticsSchoolOptions.load({district_id:''}, true);logisticsList.load({search:'',status_code:'ALL',handoff_state:'ALL',district_id:'',school_id:'',page:1,page_size:rowsPerPage.value}, true)"><i class="fas fa-filter" aria-hidden="true"></i> Clear filters</button>
          </div>
        </div>
        <div class="logistics-distribution-bars" dmx-show="logisticsChartsVisible.value">
          <div class="logistics-distribution-item"><div class="logistics-bar-track"><span class="bar-mint" dmx-bind:style="'width:' + (logisticsList.data.cases.count() ? logisticsList.data.cases.where('current_logistics_status_code', '==', 'REQUESTED').count() / logisticsList.data.cases.count() * 100 : 0) + '%' "></span></div><div class="logistics-bar-label"><span>Requested</span><strong dmx-text="logisticsList.data.cases.where('current_logistics_status_code', '==', 'REQUESTED').count()">0</strong></div></div>
          <div class="logistics-distribution-item"><div class="logistics-bar-track"><span class="bar-blue" dmx-bind:style="'width:' + (logisticsList.data.cases.count() ? logisticsList.data.cases.where('current_logistics_status_code', '==', 'OUTBOUND_IN_TRANSIT').count() / logisticsList.data.cases.count() * 100 : 0) + '%' "></span></div><div class="logistics-bar-label"><span>Outbound</span><strong dmx-text="logisticsList.data.cases.where('current_logistics_status_code', '==', 'OUTBOUND_IN_TRANSIT').count()">0</strong></div></div>
          <div class="logistics-distribution-item"><div class="logistics-bar-track"><span class="bar-violet" dmx-bind:style="'width:' + (logisticsList.data.cases.count() ? logisticsList.data.cases.where('current_logistics_status_code', '==', 'RETURN_IN_TRANSIT').count() / logisticsList.data.cases.count() * 100 : 0) + '%' "></span></div><div class="logistics-bar-label"><span>Return transit</span><strong dmx-text="logisticsList.data.cases.where('current_logistics_status_code', '==', 'RETURN_IN_TRANSIT').count()">0</strong></div></div>
        </div>
      </section>

      <section class="logistics-filter-card" aria-labelledby="logisticsFiltersTitle">
        <div class="logistics-panel-title logistics-filter-title"><span class="logistics-panel-icon mint"><i class="fas fa-search" aria-hidden="true"></i></span><h2 id="logisticsFiltersTitle">Search &amp; filters</h2></div>
        <div class="logistics-filter-grid">
          <div><label for="searchInput">Search</label><div class="logistics-input-icon"><i class="fas fa-search" aria-hidden="true"></i><input id="searchInput" class="form-control" placeholder="Logistics, ticket, serial or school" dmx-on:input="currentPage.setValue(1);logisticsList.load({search:searchInput.value,status_code:statusFilter.value,handoff_state:handoffStateFilter.value,district_id:districtFilter.value,school_id:schoolFilter.value,page:1,page_size:rowsPerPage.value}, true)"></div></div>
          <div><label for="statusFilter">Status</label><select id="statusFilter" class="form-select" dmx-on:change="currentPage.setValue(1);logisticsList.load({search:searchInput.value,status_code:statusFilter.value,handoff_state:handoffStateFilter.value,district_id:districtFilter.value,school_id:schoolFilter.value,page:1,page_size:rowsPerPage.value}, true)"><option value="ALL">All statuses</option><option value="REQUESTED">Requested</option><option value="ACCEPTED">Accepted</option><option value="OUTBOUND_IN_TRANSIT">Outbound in transit</option><option value="AT_REPAIR_CENTRE">At Repair Centre</option><option value="READY_FOR_RETURN">Ready for Return</option><option value="RETURN_IN_TRANSIT">Return in Transit</option><option value="RETURNED_TO_SCHOOL">Returned to School</option></select></div>
          <div><label for="handoffStateFilter">Physical handoff state</label><select id="handoffStateFilter" class="form-select" dmx-bind:value="authContext.data.can_logistics_repair_receive && !authContext.data.can_logistics_forward_to_repair ? 'PENDING_REPAIR_CENTRE_RECEIPT' : 'ALL'" dmx-on:change="currentPage.setValue(1);logisticsList.load({search:searchInput.value,status_code:statusFilter.value,handoff_state:handoffStateFilter.value,district_id:districtFilter.value,school_id:schoolFilter.value,page:1,page_size:rowsPerPage.value}, true)"><option value="ALL">All handoff states</option><option value="AWAITING_SCHOOL_HANDOFF">Awaiting school release</option><option value="PENDING_TTPOST_RECEIPT">Awaiting TTPost receipt</option><option value="TTPOST_CUSTODY">TTPost custody</option><option value="PENDING_REPAIR_CENTRE_RECEIPT">Awaiting Repair Centre receipt</option><option value="REPAIR_CENTRE_CUSTODY">Repair Centre custody</option><option value="PENDING_TTPOST_RETURN_RECEIPT">Awaiting TTPost return receipt</option><option value="TTPOST_RETURN_CUSTODY">TTPost return custody</option><option value="PENDING_SCHOOL_RETURN_RECEIPT">Awaiting School return receipt</option></select></div>
          <div><label for="districtFilter">District</label><select id="districtFilter" class="form-select" dmx-on:change="schoolFilter.setValue('');currentPage.setValue(1);logisticsSchoolOptions.load({district_id:districtFilter.value}, true);logisticsList.load({search:searchInput.value,status_code:statusFilter.value,handoff_state:handoffStateFilter.value,district_id:districtFilter.value,school_id:'',page:1,page_size:rowsPerPage.value}, true)"><option value="">All districts</option><option dmx-repeat="logisticsFilterOptions.data.districts" dmx-bind:value="id" dmx-text="name"></option></select></div>
          <div><label for="schoolFilter">School</label><select id="schoolFilter" class="form-select" dmx-bind:disabled="logisticsSchoolOptions.state.executing" dmx-on:change="currentPage.setValue(1);logisticsList.load({search:searchInput.value,status_code:statusFilter.value,handoff_state:handoffStateFilter.value,district_id:districtFilter.value,school_id:schoolFilter.value,page:1,page_size:rowsPerPage.value}, true)"><option value="">All schools</option><option dmx-repeat="logisticsSchoolOptions.data.schools" dmx-bind:value="id" dmx-text="name"></option></select></div>
        </div>
      </section>

      <section class="logistics-list-card" aria-labelledby="logisticsRequestsTitle">
        <div class="logistics-list-heading">
          <div class="logistics-panel-title"><span class="logistics-panel-icon slate"><i class="fas fa-list" aria-hidden="true"></i></span><div><h2 id="logisticsRequestsTitle">Logistics requests</h2><p>All logistics requests in the system.</p></div></div>
          <div class="logistics-pagination-top"><label for="rowsPerPageSelect">Rows per page</label><select id="rowsPerPageSelect" class="form-select" dmx-bind:value="rowsPerPage.value" dmx-on:change="rowsPerPage.setValue(rowsPerPageSelect.value);currentPage.setValue(1);logisticsList.load({search:searchInput.value,status_code:statusFilter.value,handoff_state:handoffStateFilter.value,district_id:districtFilter.value,school_id:schoolFilter.value,page:1,page_size:rowsPerPageSelect.value}, true)"><option value="10">10</option><option value="25">25</option><option value="50">50</option></select><button type="button" class="logistics-page-button" aria-label="Previous page" dmx-bind:disabled="currentPage.value <= 1" dmx-on:click="currentPage.setValue(currentPage.value - 1);logisticsList.load({search:searchInput.value,status_code:statusFilter.value,handoff_state:handoffStateFilter.value,district_id:districtFilter.value,school_id:schoolFilter.value,page:currentPage.value - 1,page_size:rowsPerPage.value}, true)"><i class="fas fa-chevron-left"></i></button><span class="logistics-current-page" dmx-text="currentPage.value">1</span><button type="button" class="logistics-page-button" aria-label="Next page" dmx-bind:disabled="logisticsList.data.cases.count() < logisticsList.data.page_size" dmx-on:click="currentPage.setValue(currentPage.value + 1);logisticsList.load({search:searchInput.value,status_code:statusFilter.value,handoff_state:handoffStateFilter.value,district_id:districtFilter.value,school_id:schoolFilter.value,page:currentPage.value + 1,page_size:rowsPerPage.value}, true)"><i class="fas fa-chevron-right"></i></button></div>
        </div>
        <div class="table-responsive logistics-table-scroll"><table class="table logistics-table align-middle"><thead><tr><th>Logistics #</th><th>Ticket #</th><th>Return Device</th><th>District</th><th>Pickup School</th><th>Logistics Status</th><th>Physical State</th><th>TTPost Location</th><th>Repair Centre</th><th>Requested</th><th>Accepted</th><th>Action</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="logisticsList.data.cases"><tr><td><a class="logistics-number" dmx-bind:href="'/logistics/detail?id=' + logistics_case_id" dmx-text="logistics_number"></a></td><td dmx-text="ticket_number"></td><td><span dmx-text="asset_tag || serial_number"></span><small class="d-block text-muted" dmx-text="device_source == 'PERMANENT_REPLACEMENT' ? 'Permanent Replacement · ' + replacement_number : manufacturer_name + ' ' + model_name"></small><small class="d-block text-muted" dmx-show="device_source == 'PERMANENT_REPLACEMENT'" dmx-text="'Original device #' + original_device_id"></small></td><td dmx-text="pickup_district_name"></td><td dmx-text="pickup_school_name"></td><td><span class="badge logistics-status-badge" dmx-text="current_logistics_status_name"></span></td><td dmx-text="physical_state_code == 'AWAITING_SCHOOL_HANDOFF' ? 'Awaiting school release' : physical_state_code == 'PENDING_TTPOST_RECEIPT' ? 'Awaiting TTPost receipt' : physical_state_code == 'TTPOST_CUSTODY' ? 'TTPost custody' : physical_state_code == 'PENDING_REPAIR_CENTRE_RECEIPT' ? 'Awaiting Repair Centre receipt' : physical_state_code == 'REPAIR_CENTRE_CUSTODY' ? 'Repair Centre custody' : physical_state_code == 'PENDING_TTPOST_RETURN_RECEIPT' ? 'Awaiting TTPost return receipt' : physical_state_code == 'TTPOST_RETURN_CUSTODY' ? 'TTPost return custody' : physical_state_code == 'PENDING_SCHOOL_RETURN_RECEIPT' ? 'Awaiting School receipt' : 'Not recorded'"></td><td dmx-text="ttpost_location_name || '-'">-</td><td dmx-text="repair_centre_location_name || '-'">-</td><td dmx-text="requested_at ? requested_at.formatDate('MMM d, yyyy, h:mm A') : '-'">-</td><td dmx-text="accepted_at ? accepted_at.formatDate('MMM d, yyyy, h:mm A') : '-'">-</td><td><a class="btn logistics-view-button btn-sm" dmx-bind:href="'/logistics/detail?id=' + logistics_case_id">View</a></td></tr></tbody></table></div>
        <div class="logistics-empty-state" dmx-show="!logisticsList.state.executing && logisticsList.data.cases.count() == 0"><span><i class="fas fa-file-alt" aria-hidden="true"></i><i class="fas fa-search logistics-empty-search" aria-hidden="true"></i></span><strong>No logistics requests match these filters.</strong><p>Try adjusting your search or filter criteria.</p></div>
        <div class="logistics-list-footer"><span>Showing <strong dmx-text="logisticsList.data.cases.count()">0</strong> logistics requests</span><div class="logistics-pagination-bottom"><button type="button" class="logistics-page-button" aria-label="Previous page" dmx-bind:disabled="currentPage.value <= 1" dmx-on:click="currentPage.setValue(currentPage.value - 1);logisticsList.load({search:searchInput.value,status_code:statusFilter.value,handoff_state:handoffStateFilter.value,district_id:districtFilter.value,school_id:schoolFilter.value,page:currentPage.value - 1,page_size:rowsPerPage.value}, true)"><i class="fas fa-chevron-left"></i></button><span class="logistics-current-page" dmx-text="currentPage.value">1</span><button type="button" class="logistics-page-button" aria-label="Next page" dmx-bind:disabled="logisticsList.data.cases.count() < logisticsList.data.page_size" dmx-on:click="currentPage.setValue(currentPage.value + 1);logisticsList.load({search:searchInput.value,status_code:statusFilter.value,handoff_state:handoffStateFilter.value,district_id:districtFilter.value,school_id:schoolFilter.value,page:currentPage.value + 1,page_size:rowsPerPage.value}, true)"><i class="fas fa-chevron-right"></i></button></div></div>
      </section>
    </main>
  </div>
</div>
