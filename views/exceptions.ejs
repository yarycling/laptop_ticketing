<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="exceptionsPage" appConnect="local" -->
<meta name="ac:route" content="/exceptions">
<div class="portal-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context"></dmx-serverconnect>
  <dmx-serverconnect id="exceptionList" url="/api/exceptions/list" dmx-param:status="statusFilter.value" dmx-param:outcome_code="outcomeFilter.value" dmx-param:recommended_disposition="dispositionFilter.value" dmx-param:search="searchInput.value" dmx-param:page="page.value"></dmx-serverconnect>
  <dmx-serverconnect id="exceptionSummary" url="/api/exceptions/summary"></dmx-serverconnect>
  <dmx-value id="page" value="1"></dmx-value>
  <dmx-value id="exceptionChartsVisible" value="true"></dmx-value>
  <%- await include("partials/portal-sidebar", { currentPage: "exceptions" }) %>
  <div class="portal-workspace"><%- await include("partials/portal-topbar", { pageTitle: "Exceptions" }) %>
    <main class="portal-main">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 monitoring-heading"><span class="monitoring-heading-icon"><i class="fas fa-exclamation-triangle" aria-hidden="true"></i></span><div class="me-auto"><div class="monitoring-eyebrow">MONITORING &amp; REPORTS</div><h1 class="h3 mb-1">Exceptions</h1><p class="text-muted mb-0">Warranty, financial responsibility, and disposition review.</p></div><div class="form-check form-switch monitoring-switch"><input class="form-check-input" type="checkbox" role="switch" id="exceptionChartsSwitch" dmx-bind:checked="exceptionChartsVisible.value" dmx-on:change="exceptionChartsVisible.setValue(exceptionChartsSwitch.checked)"><label class="form-check-label" for="exceptionChartsSwitch">Show charts</label></div></div>
      <div class="logistics-stats mb-3"><article class="logistics-stat-card"><div class="logistics-stat-icon"><i class="fas fa-clipboard-list" aria-hidden="true"></i></div><div class="logistics-stat-copy"><span>Assessment required</span><strong dmx-text="exceptionSummary.data.assessment_required || 0"></strong><small>Pending assessment</small></div></article><article class="logistics-stat-card"><div class="logistics-stat-icon logistics-stat-icon-box"><i class="fas fa-landmark" aria-hidden="true"></i></div><div class="logistics-stat-copy"><span>District decisions</span><strong dmx-text="exceptionSummary.data.pending_district_approval + exceptionSummary.data.pending_district_decision || 0"></strong><small>Approval or decision needed</small></div></article><article class="logistics-stat-card"><div class="logistics-stat-icon logistics-stat-icon-repair"><i class="fas fa-tools" aria-hidden="true"></i></div><div class="logistics-stat-copy"><span>Repair Centre review</span><strong dmx-text="exceptionSummary.data.repair_centre_review_required || 0"></strong><small>Review required</small></div></article></div>
      <section class="monitoring-card mb-3" dmx-show="exceptionChartsVisible.value"><div class="monitoring-card-heading"><div><h2 class="h6 mb-1">Exception case distribution</h2><p class="small text-muted mb-0">All cases in your authorized scope.</p></div></div><div class="monitoring-chart-grid monitoring-chart-grid-2">
        <div class="monitoring-chart-row"><span>Assessment required</span><progress dmx-bind:max="exceptionSummary.data.total || 1" dmx-bind:value="exceptionSummary.data.assessment_required || 0"></progress><strong dmx-text="exceptionSummary.data.assessment_required || 0"></strong></div>
        <div class="monitoring-chart-row"><span>District approval</span><progress dmx-bind:max="exceptionSummary.data.total || 1" dmx-bind:value="exceptionSummary.data.pending_district_approval || 0"></progress><strong dmx-text="exceptionSummary.data.pending_district_approval || 0"></strong></div>
        <div class="monitoring-chart-row"><span>District decision</span><progress class="monitoring-progress-warning" dmx-bind:max="exceptionSummary.data.total || 1" dmx-bind:value="exceptionSummary.data.pending_district_decision || 0"></progress><strong dmx-text="exceptionSummary.data.pending_district_decision || 0"></strong></div>
        <div class="monitoring-chart-row"><span>Head Office approval</span><progress dmx-bind:max="exceptionSummary.data.total || 1" dmx-bind:value="exceptionSummary.data.pending_head_office_approval || 0"></progress><strong dmx-text="exceptionSummary.data.pending_head_office_approval || 0"></strong></div>
        <div class="monitoring-chart-row"><span>Repair Centre review</span><progress class="monitoring-progress-warning" dmx-bind:max="exceptionSummary.data.total || 1" dmx-bind:value="exceptionSummary.data.repair_centre_review_required || 0"></progress><strong dmx-text="exceptionSummary.data.repair_centre_review_required || 0"></strong></div>
        <div class="monitoring-chart-row"><span>Approved</span><progress class="monitoring-progress-success" dmx-bind:max="exceptionSummary.data.total || 1" dmx-bind:value="exceptionSummary.data.approved || 0"></progress><strong dmx-text="exceptionSummary.data.approved || 0"></strong></div>
      </div></section>
      <div class="alert alert-danger" role="alert" dmx-show="exceptionList.lastError.status" dmx-text="exceptionList.lastError.response && exceptionList.lastError.response.error ? exceptionList.lastError.response.error : 'Exception queue could not be loaded.'"></div>
      <section class="portal-section monitoring-page">
        <section class="monitoring-filter-card mb-3" aria-label="Exception filters"><div class="row g-3 align-items-end">
          <div class="col-12 col-lg-4"><label class="form-label" for="searchInput">Search</label><input id="searchInput" class="form-control" placeholder="Ticket, logistics or serial" dmx-on:input="page.setValue(1);exceptionList.load({search:searchInput.value,status:statusFilter.value,outcome_code:outcomeFilter.value,recommended_disposition:dispositionFilter.value,page:1}, true)"></div>
          <div class="col-12 col-sm-4 col-lg-3"><label class="form-label" for="statusFilter">Exception status</label><select id="statusFilter" class="form-select" dmx-on:change="page.setValue(1);exceptionList.load({search:searchInput.value,status:statusFilter.value,outcome_code:outcomeFilter.value,recommended_disposition:dispositionFilter.value,page:1}, true)"><option value="ALL">All statuses</option><option value="ASSESSMENT_REQUIRED">Assessment Required</option><option value="PENDING_DISTRICT_APPROVAL">Pending District Approval</option><option value="PENDING_DISTRICT_DECISION">Pending District Decision</option><option value="PENDING_HEAD_OFFICE_APPROVAL">Pending Head Office Approval</option><option value="REPAIR_CENTRE_REVIEW_REQUIRED">Repair Centre Review Required</option><option value="MANUFACTURER_RETURN_APPROVED">Manufacturer Return Approved</option><option value="REPLACEMENT_APPROVED">Replacement Approved</option></select></div>
          <div class="col-12 col-sm-4 col-lg-2"><label class="form-label" for="outcomeFilter">Repair outcome</label><select id="outcomeFilter" class="form-select" dmx-on:change="page.setValue(1);exceptionList.load({search:searchInput.value,status:statusFilter.value,outcome_code:outcomeFilter.value,recommended_disposition:dispositionFilter.value,page:1}, true)"><option value="">All outcomes</option><option value="UNABLE_TO_REPAIR">Unable to Repair</option><option value="MANUFACTURER_RETURN_REQUIRED">Manufacturer Return Required</option><option value="REPLACEMENT_REQUIRED">Replacement Required</option></select></div>
          <div class="col-12 col-sm-4 col-lg-3"><label class="form-label" for="dispositionFilter">Recommended disposition</label><select id="dispositionFilter" class="form-select" dmx-on:change="page.setValue(1);exceptionList.load({search:searchInput.value,status:statusFilter.value,outcome_code:outcomeFilter.value,recommended_disposition:dispositionFilter.value,page:1}, true)"><option value="">All dispositions</option><option value="MANUFACTURER_RETURN">Manufacturer Return</option><option value="PERMANENT_REPLACEMENT">Permanent Replacement</option><option value="DECISION_REQUIRED">District Decision Required</option></select></div>
          <div class="col-12 col-lg-3"><div class="form-check form-switch monitoring-switch"><input class="form-check-input" type="checkbox" role="switch" id="exceptionDecisionSwitch" dmx-bind:checked="statusFilter.value == 'PENDING_DISTRICT_DECISION'" dmx-on:change="statusFilter.setValue(exceptionDecisionSwitch.checked ? 'PENDING_DISTRICT_DECISION' : 'ALL');page.setValue(1);exceptionList.load({search:searchInput.value,status:exceptionDecisionSwitch.checked ? 'PENDING_DISTRICT_DECISION' : 'ALL',outcome_code:outcomeFilter.value,recommended_disposition:dispositionFilter.value,page:1}, true)"><label class="form-check-label" for="exceptionDecisionSwitch">District decision required</label></div></div>
          <div class="col-12 d-flex justify-content-end"><button type="button" class="btn btn-bmobile-secondary btn-sm" dmx-on:click="searchInput.setValue('');statusFilter.setValue('ALL');outcomeFilter.setValue('');dispositionFilter.setValue('');page.setValue(1);exceptionList.load({search:'',status:'ALL',outcome_code:'',recommended_disposition:'',page:1}, true)">Clear filters</button></div>
        </div></section>
        <div class="table-responsive portal-table-wrapper"><table class="table portal-table align-middle"><thead><tr><th>Ticket</th><th>Device</th><th>School / District</th><th>Repair Outcome</th><th>Status</th><th>Disposition</th><th>Repair Centre</th><th>Updated</th><th></th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="exceptionList.data.cases"><tr><td><span class="fw-semibold" dmx-text="ticket_number"></span><small class="d-block text-muted" dmx-text="logistics_number"></small></td><td dmx-text="serial_number"></td><td><span dmx-text="school_name || '-' "></span><small class="d-block text-muted" dmx-text="district_name || '-' "></small></td><td dmx-text="originating_outcome_code"></td><td dmx-text="current_status_code"></td><td dmx-text="recommended_disposition_code || 'District Decision Required'"></td><td dmx-text="repair_centre_name || '-' "></td><td class="text-nowrap" dmx-text="updated_at.formatDate('MMM d, yyyy, h:mm A')"></td><td><a class="btn btn-bmobile-secondary btn-sm" dmx-bind:href="'/exceptions/detail?id=' + exception_case_id">Open</a></td></tr></tbody></table></div>
        <p class="text-muted mb-0" dmx-show="!exceptionList.state.executing && exceptionList.data.cases.count() == 0">No exception cases match these filters.</p>
        <div class="d-flex justify-content-between align-items-center mt-3"><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-bind:disabled="page.value <= 1" dmx-on:click="page.setValue(page.value - 1);exceptionList.load({search:searchInput.value,status:statusFilter.value,outcome_code:outcomeFilter.value,recommended_disposition:dispositionFilter.value,page:page.value - 1}, true)">Previous</button><span class="small text-muted" dmx-text="'Page ' + page.value"></span><button class="btn btn-bmobile-secondary btn-sm" type="button" dmx-bind:disabled="exceptionList.data.cases.count() < exceptionList.data.page_size" dmx-on:click="page.setValue(page.value + 1);exceptionList.load({search:searchInput.value,status:statusFilter.value,outcome_code:outcomeFilter.value,recommended_disposition:dispositionFilter.value,page:page.value + 1}, true)">Next</button></div>
      </section>
    </main>
  </div>
</div>
