<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="logisticsDetailPage" appConnect="local" components="{dmxBootstrap5Modal:{}}" -->
<meta name="ac:route" content="/logistics/detail">
<div class="portal-shell">
  <dmx-serverconnect id="authContext" url="/api/auth/context"></dmx-serverconnect>
  <dmx-serverconnect id="logisticsDetail" url="/api/logistics/detail" dmx-param:id="query.id"></dmx-serverconnect>
  <dmx-serverconnect id="ttPostOptions" url="/api/logistics/tt-post-options"></dmx-serverconnect>
  <dmx-serverconnect id="returnTtPostOptions" url="/api/logistics/return/tt-post-options"></dmx-serverconnect>
  <dmx-serverconnect id="repairCentreOptions" url="/api/logistics/repair-centre-options"></dmx-serverconnect>
  <dmx-value id="detailNotice" value=""></dmx-value>
  <%- await include("partials/portal-sidebar", { currentPage: "logistics" }) %>
  <div class="portal-workspace"><%- await include("partials/portal-topbar", { backHref: "/logistics", pageTitle: "Logistics Detail" }) %>
    <main class="portal-main phase8cd-mobile-tables service-page">
      <div id="returnDispatchModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="returnDispatchTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="returnDispatchTitle">Dispatch Return to TTPost</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="returnDispatchForm" is="dmx-serverconnect-form" method="post" action="/api/logistics/handoff/repair-centre-return-dispatch" dmx-on:success="returnDispatchModal.hide();logisticsDetail.load();returnDispatchForm.reset(true);detailNotice.setValue('Repair Centre dispatch recorded. Awaiting TTPost return receipt.')"><div class="modal-body"><div class="alert alert-danger" dmx-show="returnDispatchForm.lastError.status" dmx-text="returnDispatchForm.lastError.response && returnDispatchForm.lastError.response.error ? returnDispatchForm.lastError.response.error : 'Return dispatch could not be recorded.'"></div><dl class="row"><dt class="col-4">Logistics #</dt><dd class="col-8" dmx-text="logisticsDetail.data.logistics_case.logistics_number"></dd><dt class="col-4">Ticket #</dt><dd class="col-8" dmx-text="logisticsDetail.data.logistics_case.ticket_number"></dd><dt class="col-4">Device</dt><dd class="col-8" dmx-text="logisticsDetail.data.logistics_case.serial_number"></dd><dt class="col-4">Repair Centre</dt><dd class="col-8" dmx-text="logisticsDetail.data.repair_centre_name"></dd></dl><input type="hidden" name="logistics_case_id" dmx-bind:value="logisticsDetail.data.logistics_case.logistics_case_id"><label class="form-label" for="returnTtPostLocation">TTPost Return Location</label><select id="returnTtPostLocation" name="ttpost_location_id" class="form-select" required><option value="">Select TTPost location</option><option dmx-repeat="returnTtPostOptions.data.locations" dmx-bind:value="id" dmx-text="name + ' (' + code + ')' "></option></select><label class="form-label mt-3" for="returnTracking">Tracking Reference (optional)</label><input id="returnTracking" name="tracking_reference" class="form-control" maxlength="180"><label class="form-label mt-3" for="returnDispatchScan">Verification Reference (optional)</label><input id="returnDispatchScan" name="scan_reference" class="form-control" maxlength="255"><p class="alert alert-warning mt-3 mb-0">This records Repair Centre dispatch to TTPost. TTPost must independently confirm receipt before return transit custody is recorded.</p></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="returnDispatchForm.state.executing || !returnTtPostLocation.value">Record Dispatch</button></div></form></div></div></div>
      <div id="returnTtPostReceiveModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="returnTtPostReceiveTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="returnTtPostReceiveTitle">Confirm TTPost Return Receipt</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="returnTtPostReceiveForm" is="dmx-serverconnect-form" method="post" action="/api/logistics/handoff/tt-post-return-receive" dmx-on:success="returnTtPostReceiveModal.hide();logisticsDetail.load();returnTtPostReceiveForm.reset(true);detailNotice.setValue('TTPost return receipt confirmed. Return transit has started.')"><div class="modal-body"><div class="alert alert-danger" dmx-show="returnTtPostReceiveForm.lastError.status" dmx-text="returnTtPostReceiveForm.lastError.response && returnTtPostReceiveForm.lastError.response.error ? returnTtPostReceiveForm.lastError.response.error : 'Receipt could not be recorded.'"></div><input type="hidden" name="logistics_case_id" dmx-bind:value="logisticsDetail.data.logistics_case.logistics_case_id"><p>Confirm that TTPost has physically received this returned device from the Repair Centre?</p><label class="form-label" for="returnTtPostScan">Verification Reference (optional)</label><input id="returnTtPostScan" name="scan_reference" class="form-control" maxlength="255"></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="returnTtPostReceiveForm.state.executing">Confirm Receipt</button></div></form></div></div></div>
      <div id="schoolReturnDispatchModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="schoolReturnDispatchTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="schoolReturnDispatchTitle">Dispatch Return to School</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="schoolReturnDispatchForm" is="dmx-serverconnect-form" method="post" action="/api/logistics/handoff/tt-post-school-dispatch" dmx-on:success="schoolReturnDispatchModal.hide();logisticsDetail.load();schoolReturnDispatchForm.reset(true);detailNotice.setValue('TTPost dispatch to School recorded. Awaiting School receipt.')"><div class="modal-body"><div class="alert alert-danger" dmx-show="schoolReturnDispatchForm.lastError.status" dmx-text="schoolReturnDispatchForm.lastError.response && schoolReturnDispatchForm.lastError.response.error ? schoolReturnDispatchForm.lastError.response.error : 'School dispatch could not be recorded.'"></div><input type="hidden" name="logistics_case_id" dmx-bind:value="logisticsDetail.data.logistics_case.logistics_case_id"><dl class="row"><dt class="col-4">Logistics #</dt><dd class="col-8" dmx-text="logisticsDetail.data.logistics_case.logistics_number"></dd><dt class="col-4">Ticket #</dt><dd class="col-8" dmx-text="logisticsDetail.data.logistics_case.ticket_number"></dd><dt class="col-4">Device</dt><dd class="col-8" dmx-text="logisticsDetail.data.logistics_case.serial_number"></dd><dt class="col-4">Current TTPost Location</dt><dd class="col-8" dmx-text="logisticsDetail.data.ttpost_location_name"></dd><dt class="col-4">Destination School</dt><dd class="col-8" dmx-text="logisticsDetail.data.logistics_case.pickup_school_name"></dd></dl><label class="form-label" for="schoolReturnTracking">Tracking Reference (optional)</label><input id="schoolReturnTracking" name="tracking_reference" class="form-control" maxlength="180"><label class="form-label mt-3" for="schoolReturnScan">Verification Reference (optional)</label><input id="schoolReturnScan" name="scan_reference" class="form-control" maxlength="255"><p class="alert alert-warning mt-3 mb-0">The School must independently confirm physical receipt.</p></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="schoolReturnDispatchForm.state.executing">Record Dispatch</button></div></form></div></div></div>
      <div id="schoolReturnReceiveModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="schoolReturnReceiveTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="schoolReturnReceiveTitle">Confirm Returned Device Receipt</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="schoolReturnReceiveForm" is="dmx-serverconnect-form" method="post" action="/api/logistics/handoff/school-return-receive" dmx-on:success="schoolReturnReceiveModal.hide();logisticsDetail.load();schoolReturnReceiveForm.reset(true);detailNotice.setValue('Return journey complete. School receipt recorded.')"><div class="modal-body"><div class="alert alert-danger" dmx-show="schoolReturnReceiveForm.lastError.status" dmx-text="schoolReturnReceiveForm.lastError.response && schoolReturnReceiveForm.lastError.response.error ? schoolReturnReceiveForm.lastError.response.error : 'School receipt could not be recorded.'"></div><input type="hidden" name="logistics_case_id" dmx-bind:value="logisticsDetail.data.logistics_case.logistics_case_id"><p>Confirm that the School has physically received this return device from TTPost?</p><p><strong dmx-text="logisticsDetail.data.logistics_case.asset_tag || logisticsDetail.data.logistics_case.serial_number"></strong> · <span dmx-text="logisticsDetail.data.allocation_context.school_name || logisticsDetail.data.logistics_case.pickup_school_name"></span></p><label class="form-label" for="schoolReturnReceiveScan">Verification Reference (optional)</label><input id="schoolReturnReceiveScan" name="scan_reference" class="form-control" maxlength="255"></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="schoolReturnReceiveForm.state.executing">Confirm Receipt</button></div></form></div></div></div>
      <div id="repairDispatchModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="repairDispatchTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="repairDispatchTitle">Dispatch to Repair Centre</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="repairDispatchForm" is="dmx-serverconnect-form" method="post" action="/api/logistics/handoff/tt-post-dispatch-repair" dmx-on:success="repairDispatchModal.hide();logisticsDetail.load();repairDispatchForm.reset(true);detailNotice.setValue('TTPost dispatch recorded. Awaiting Repair Centre receipt.')"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="repairDispatchForm.lastError.status" dmx-text="repairDispatchForm.lastError.response && repairDispatchForm.lastError.response.error ? repairDispatchForm.lastError.response.error : 'Dispatch could not be recorded.'"></div><dl class="row"><dt class="col-4">Logistics #</dt><dd class="col-8" dmx-text="logisticsDetail.data.logistics_case.logistics_number"></dd><dt class="col-4">Ticket #</dt><dd class="col-8" dmx-text="logisticsDetail.data.logistics_case.ticket_number"></dd><dt class="col-4">Device</dt><dd class="col-8" dmx-text="logisticsDetail.data.logistics_case.serial_number"></dd><dt class="col-4">Current TTPost Location</dt><dd class="col-8" dmx-text="logisticsDetail.data.ttpost_location_name"></dd></dl><input type="hidden" name="logistics_case_id" dmx-bind:value="logisticsDetail.data.logistics_case.logistics_case_id"><div class="mb-3"><label class="form-label" for="repairCentreSelect">Repair Centre</label><select id="repairCentreSelect" name="repair_centre_location_id" class="form-select" required><option value="">Select Repair Centre</option><option dmx-repeat="repairCentreOptions.data.locations" dmx-bind:value="id" dmx-text="name + ' (' + code + ')' "></option></select></div><div class="mb-3"><label class="form-label" for="repairTrackingReference">Tracking Reference (optional)</label><input id="repairTrackingReference" name="tracking_reference" class="form-control" maxlength="180"></div><div class="mb-3"><label class="form-label" for="repairScanReference">Verification Reference (optional)</label><input id="repairScanReference" name="scan_reference" class="form-control" maxlength="255"></div><div class="alert alert-warning mb-0">This records TTPost dispatching the physical device. The Repair Centre must independently confirm receipt.</div></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="repairDispatchForm.state.executing || !repairCentreSelect.value">Record Dispatch</button></div></form></div></div></div>
      <div id="repairReceiveModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="repairReceiveTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="repairReceiveTitle">Confirm Repair Centre Receipt</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="repairReceiveForm" is="dmx-serverconnect-form" method="post" action="/api/logistics/handoff/repair-centre-receive" dmx-on:success="repairReceiveModal.hide();logisticsDetail.load();repairReceiveForm.reset(true);detailNotice.setValue('Repair Centre receipt recorded. The device is now in repair custody.')"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="repairReceiveForm.lastError.status" dmx-text="repairReceiveForm.lastError.response && repairReceiveForm.lastError.response.error ? repairReceiveForm.lastError.response.error : 'Receipt could not be recorded.'"></div><p>Confirm that this Repair Centre has physically received the device from TTPost?</p><p class="mb-0"><strong dmx-text="logisticsDetail.data.repair_centre_name || logisticsDetail.data.logistics_case.repair_centre_name"></strong></p><input type="hidden" name="logistics_case_id" dmx-bind:value="logisticsDetail.data.logistics_case.logistics_case_id"><div class="mt-3"><label class="form-label" for="repairReceiveScanReference">Verification Reference (optional)</label><input id="repairReceiveScanReference" name="scan_reference" class="form-control" maxlength="255"></div></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="repairReceiveForm.state.executing">Confirm Receipt</button></div></form></div></div></div>
      <div id="acceptRequestModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="acceptRequestTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="acceptRequestTitle">Accept Pickup Request</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="acceptRequestForm" is="dmx-serverconnect-form" method="post" action="/api/logistics/accept" dmx-on:success="acceptRequestModal.hide();logisticsDetail.load();detailNotice.setValue('Pickup request accepted for TTPost processing. Awaiting physical handoff.');acceptRequestForm.reset(true)"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="acceptRequestForm.lastError.status" dmx-text="acceptRequestForm.lastError.response && acceptRequestForm.lastError.response.error ? acceptRequestForm.lastError.response.error : 'Request could not be accepted.'"></div><input type="hidden" name="logistics_case_id" dmx-bind:value="logisticsDetail.data.logistics_case.logistics_case_id"><p>Accept this pickup request for TTPost processing?</p><p class="small text-muted mb-0">Acceptance does not mean the device has been received, collected, or transferred to TTPost.</p></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="acceptRequestForm.state.executing">Accept Request</button></div></form></div></div></div>
      <div id="schoolDispatchModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="schoolDispatchTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="schoolDispatchTitle">Release Device to TTPost</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="schoolDispatchForm" is="dmx-serverconnect-form" method="post" action="/api/logistics/handoff/school-dispatch" dmx-on:success="schoolDispatchModal.hide();logisticsDetail.load();schoolDispatchForm.reset(true);detailNotice.setValue('School release recorded. Awaiting TTPost receipt.')"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="schoolDispatchForm.lastError.status" dmx-text="schoolDispatchForm.lastError.response && schoolDispatchForm.lastError.response.error ? schoolDispatchForm.lastError.response.error : 'School release could not be recorded.'"></div><dl class="row"><dt class="col-4">Logistics #</dt><dd class="col-8" dmx-text="logisticsDetail.data.logistics_case.logistics_number"></dd><dt class="col-4">Ticket #</dt><dd class="col-8" dmx-text="logisticsDetail.data.logistics_case.ticket_number"></dd><dt class="col-4">Device</dt><dd class="col-8" dmx-text="logisticsDetail.data.logistics_case.serial_number"></dd><dt class="col-4">Pickup School</dt><dd class="col-8" dmx-text="logisticsDetail.data.logistics_case.pickup_school_name"></dd></dl><input type="hidden" name="logistics_case_id" dmx-bind:value="logisticsDetail.data.logistics_case.logistics_case_id"><div class="mb-3"><label class="form-label" for="dispatchLocation">TTPost Location</label><select id="dispatchLocation" name="ttpost_location_id" class="form-select" required><option value="">Select TTPost location</option><option dmx-repeat="ttPostOptions.data.locations" dmx-bind:value="id" dmx-text="name + ' (' + code + ')' "></option></select></div><div class="mb-3"><label class="form-label" for="trackingReference">Tracking Reference (optional)</label><input id="trackingReference" name="tracking_reference" class="form-control" maxlength="180"></div><div class="mb-3"><label class="form-label" for="dispatchScanReference">Scan/Verification Reference (optional)</label><input id="dispatchScanReference" name="scan_reference" class="form-control" maxlength="255"></div><div class="alert alert-warning mb-0">This records the School releasing the physical device to TTPost. TTPost must independently confirm receipt before custody is recorded as TTPost.</div></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="schoolDispatchForm.state.executing || !dispatchLocation.value">Record School Release</button></div></form></div></div></div>
      <div id="ttPostReceiveModal" is="dmx-bs5-modal" class="modal" tabindex="-1" aria-labelledby="ttPostReceiveTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content portal-modal"><div class="modal-header"><h2 class="modal-title h5" id="ttPostReceiveTitle">Confirm Device Receipt</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><form id="ttPostReceiveForm" is="dmx-serverconnect-form" method="post" action="/api/logistics/handoff/tt-post-receive" dmx-on:success="ttPostReceiveModal.hide();logisticsDetail.load();ttPostReceiveForm.reset(true);detailNotice.setValue('TTPost receipt recorded. Outbound transit has started.')"><div class="modal-body"><div class="alert alert-danger" role="alert" dmx-show="ttPostReceiveForm.lastError.status" dmx-text="ttPostReceiveForm.lastError.response && ttPostReceiveForm.lastError.response.error ? ttPostReceiveForm.lastError.response.error : 'TTPost receipt could not be recorded.'"></div><dl class="row"><dt class="col-4">Logistics #</dt><dd class="col-8" dmx-text="logisticsDetail.data.logistics_case.logistics_number"></dd><dt class="col-4">Device</dt><dd class="col-8" dmx-text="logisticsDetail.data.logistics_case.serial_number"></dd><dt class="col-4">TTPost Location</dt><dd class="col-8" dmx-text="logisticsDetail.data.ttpost_location_name"></dd></dl><input type="hidden" name="logistics_case_id" dmx-bind:value="logisticsDetail.data.logistics_case.logistics_case_id"><p>Confirm that TTPost has physically received this device from the School?</p><div class="mb-3"><label class="form-label" for="receiveScanReference">Scan/Verification Reference (optional)</label><input id="receiveScanReference" name="scan_reference" class="form-control" maxlength="255"></div><div class="alert alert-warning mb-0">Only confirm after the device has physically arrived with TTPost. Confirmation starts outbound transit.</div></div><div class="modal-footer"><button class="btn btn-bmobile-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-bmobile-primary" type="submit" dmx-bind:disabled="ttPostReceiveForm.state.executing">Confirm Receipt</button></div></form></div></div></div>
      <div class="alert alert-success" role="status" dmx-show="detailNotice.value" dmx-text="detailNotice.value"></div>
      <div class="alert alert-danger" role="alert" dmx-show="logisticsDetail.lastError.status" dmx-text="logisticsDetail.lastError.response && logisticsDetail.lastError.response.error ? logisticsDetail.lastError.response.error : 'Logistics case could not be loaded.'"></div>
      <div class="alert alert-danger" role="alert" dmx-show="schoolDispatchForm.lastError.status || ttPostReceiveForm.lastError.status || repairDispatchForm.lastError.status || repairReceiveForm.lastError.status" dmx-text="schoolDispatchForm.lastError.response && schoolDispatchForm.lastError.response.error ? schoolDispatchForm.lastError.response.error : (ttPostReceiveForm.lastError.response && ttPostReceiveForm.lastError.response.error ? ttPostReceiveForm.lastError.response.error : (repairDispatchForm.lastError.response && repairDispatchForm.lastError.response.error ? repairDispatchForm.lastError.response.error : (repairReceiveForm.lastError.response && repairReceiveForm.lastError.response.error ? repairReceiveForm.lastError.response.error : 'The handoff could not be recorded.')))"></div>
      <div class="logistics-detail-layout" dmx-show="logisticsDetail.data.logistics_case">
        <header class="logistics-detail-hero">
          <div class="logistics-detail-hero-copy">
            <div class="logistics-detail-breadcrumb"><span>Repairs &amp; Logistics</span><i class="fas fa-chevron-right" aria-hidden="true"></i><strong>Logistics Detail</strong></div>
            <h1>Logistics Detail</h1>
            <p>Track pickup requests, handoff progress and custody history.</p>
          </div>
          <div class="logistics-detail-hero-art" aria-hidden="true"><span class="route-line"></span><i class="fas fa-laptop"></i><i class="fas fa-truck"></i><i class="fas fa-map-marker-alt"></i><i class="fas fa-school"></i></div>
        </header>

        <section class="logistics-case-progress portal-section" aria-label="Logistics progress">
          <div class="logistics-case-heading"><div class="logistics-case-icon"><i class="far fa-file-alt" aria-hidden="true"></i></div><div><span class="logistics-case-label">Logistics Case</span><h2 dmx-text="logisticsDetail.data.logistics_case.logistics_number"></h2></div><span class="logistics-status-pill" dmx-text="logisticsDetail.data.logistics_case.current_logistics_status_name"></span></div>
          <ol class="logistics-stepper">
            <li dmx-class:is-current="logisticsDetail.data.logistics_case.current_logistics_status_code == 'REQUESTED'" dmx-class:is-complete="logisticsDetail.data.logistics_case.current_logistics_status_code != 'REQUESTED'"><span class="logistics-step-icon"><i class="far fa-file-alt" aria-hidden="true"></i></span><strong>Requested</strong><small dmx-text="logisticsDetail.data.requested_at ? logisticsDetail.data.requested_at.formatDate('MMM d, yyyy, h:mm A') : ''"></small></li>
            <li dmx-class:is-current="logisticsDetail.data.logistics_case.current_logistics_status_code == 'ACCEPTED'" dmx-class:is-complete="logisticsDetail.data.logistics_case.current_logistics_status_code != 'REQUESTED' && logisticsDetail.data.logistics_case.current_logistics_status_code != 'ACCEPTED'"><span class="logistics-step-icon"><i class="far fa-user" aria-hidden="true"></i></span><strong>Accepted</strong><small dmx-text="logisticsDetail.data.accepted_at ? logisticsDetail.data.accepted_at.formatDate('MMM d, yyyy, h:mm A') : ''"></small></li>
            <li dmx-class:is-current="logisticsDetail.data.physical_state_code == 'PENDING_TTPOST_RECEIPT' || logisticsDetail.data.physical_state_code == 'AWAITING_SCHOOL_HANDOFF'" dmx-class:is-complete="logisticsDetail.data.physical_state_code == 'TTPOST_CUSTODY' || logisticsDetail.data.physical_state_code == 'PENDING_REPAIR_CENTRE_RECEIPT' || logisticsDetail.data.physical_state_code == 'REPAIR_CENTRE_CUSTODY' || logisticsDetail.data.physical_state_code == 'TTPOST_RETURN_CUSTODY' || logisticsDetail.data.physical_state_code == 'PENDING_SCHOOL_RETURN_RECEIPT' || logisticsDetail.data.logistics_case.current_logistics_status_code == 'RETURNED_TO_SCHOOL'"><span class="logistics-step-icon"><i class="fas fa-box" aria-hidden="true"></i></span><strong>Awaiting TTPost<br>Receipt</strong><small dmx-text="logisticsDetail.data.school_to_ttpost_handoff.dispatched_at ? logisticsDetail.data.school_to_ttpost_handoff.dispatched_at.formatDate('MMM d, yyyy, h:mm A') : ''"></small></li>
            <li dmx-class:is-current="logisticsDetail.data.physical_state_code == 'TTPOST_CUSTODY' || logisticsDetail.data.physical_state_code == 'PENDING_TTPOST_RETURN_RECEIPT' || logisticsDetail.data.physical_state_code == 'TTPOST_RETURN_CUSTODY'" dmx-class:is-complete="logisticsDetail.data.physical_state_code == 'PENDING_REPAIR_CENTRE_RECEIPT' || logisticsDetail.data.physical_state_code == 'REPAIR_CENTRE_CUSTODY' || logisticsDetail.data.logistics_case.current_logistics_status_code == 'RETURNED_TO_SCHOOL'"><span class="logistics-step-icon"><i class="fas fa-truck" aria-hidden="true"></i></span><strong>In TTPost Custody</strong><small dmx-text="logisticsDetail.data.school_to_ttpost_handoff.received_at ? logisticsDetail.data.school_to_ttpost_handoff.received_at.formatDate('MMM d, yyyy, h:mm A') : ''"></small></li>
            <li dmx-class:is-current="logisticsDetail.data.physical_state_code == 'PENDING_REPAIR_CENTRE_RECEIPT' || logisticsDetail.data.physical_state_code == 'REPAIR_CENTRE_CUSTODY'" dmx-class:is-complete="logisticsDetail.data.physical_state_code == 'PENDING_TTPOST_RETURN_RECEIPT' || logisticsDetail.data.physical_state_code == 'TTPOST_RETURN_CUSTODY' || logisticsDetail.data.physical_state_code == 'PENDING_SCHOOL_RETURN_RECEIPT' || logisticsDetail.data.logistics_case.current_logistics_status_code == 'RETURNED_TO_SCHOOL'"><span class="logistics-step-icon"><i class="fas fa-wrench" aria-hidden="true"></i></span><strong>At Repair Centre</strong><small dmx-text="logisticsDetail.data.ttpost_to_repair_handoff.received_at ? logisticsDetail.data.ttpost_to_repair_handoff.received_at.formatDate('MMM d, yyyy, h:mm A') : ''"></small></li>
            <li dmx-class:is-current="logisticsDetail.data.physical_state_code == 'PENDING_TTPOST_RETURN_RECEIPT' || logisticsDetail.data.physical_state_code == 'TTPOST_RETURN_CUSTODY' || logisticsDetail.data.physical_state_code == 'PENDING_SCHOOL_RETURN_RECEIPT'" dmx-class:is-complete="logisticsDetail.data.logistics_case.current_logistics_status_code == 'RETURNED_TO_SCHOOL'"><span class="logistics-step-icon"><i class="far fa-building" aria-hidden="true"></i></span><strong>Return to School</strong><small dmx-text="logisticsDetail.data.ttpost_to_school_handoff.received_at ? logisticsDetail.data.ttpost_to_school_handoff.received_at.formatDate('MMM d, yyyy, h:mm A') : ''"></small></li>
          </ol>
        </section>

        <div class="logistics-detail-grid logistics-detail-grid-primary">
          <section class="logistics-detail-card"><h2><i class="fas fa-laptop" aria-hidden="true"></i>Device &amp; Ticket Details</h2><dl class="logistics-detail-fields"><dt>Ticket</dt><dd dmx-text="logisticsDetail.data.logistics_case.ticket_number || 'Not recorded'"></dd><dt>Ticket Status</dt><dd><span class="logistics-inline-status" dmx-text="logisticsDetail.data.logistics_case.ticket_current_status_code || 'Not recorded'"></span></dd><dt>Device</dt><dd><span dmx-text="logisticsDetail.data.logistics_case.serial_number"></span><span dmx-show="logisticsDetail.data.logistics_case.asset_tag"> · <span dmx-text="logisticsDetail.data.logistics_case.asset_tag"></span></span></dd><dt>Manufacturer / Model</dt><dd dmx-text="logisticsDetail.data.manufacturer_name + ' / ' + logisticsDetail.data.model_name"></dd></dl></section>
          <section class="logistics-detail-card"><h2><i class="far fa-building" aria-hidden="true"></i>Pickup School &amp; Location</h2><dl class="logistics-detail-fields"><dt>Pickup School</dt><dd dmx-text="logisticsDetail.data.logistics_case.pickup_school_name || 'Not recorded'"></dd><dt>District</dt><dd dmx-text="logisticsDetail.data.logistics_case.pickup_district_name || 'Not recorded'"></dd><dt>TTPost Destination / Location</dt><dd dmx-text="logisticsDetail.data.ttpost_location_name || 'Not assigned'"></dd></dl></section>
          <section class="logistics-detail-card"><h2><i class="far fa-user" aria-hidden="true"></i>Handling &amp; Assignment</h2><dl class="logistics-detail-fields"><dt>Requested By</dt><dd dmx-text="logisticsDetail.data.requested_by_display_name || 'Not recorded'"></dd><dt>Requested</dt><dd dmx-text="logisticsDetail.data.requested_at ? logisticsDetail.data.requested_at.formatDate('MMMM d, yyyy, h:mm A') : 'Not recorded'"></dd><dt>Accepted</dt><dd dmx-text="logisticsDetail.data.accepted_at ? logisticsDetail.data.accepted_at.formatDate('MMMM d, yyyy, h:mm A') : 'Not accepted'"></dd><dt>Accepted By</dt><dd dmx-text="logisticsDetail.data.accepted_by_display_name || 'Not accepted'"></dd></dl></section>
        </div>

        <div class="logistics-detail-grid logistics-detail-grid-secondary">
          <section class="logistics-detail-card"><h2><i class="fas fa-cube" aria-hidden="true"></i>Logistics &amp; Custody Information</h2><dl class="logistics-detail-fields"><dt>Physical State</dt><dd dmx-text="logisticsDetail.data.physical_state_label || 'Not recorded'"></dd><dt>Repair Centre</dt><dd dmx-text="logisticsDetail.data.repair_centre_name || logisticsDetail.data.logistics_case.repair_centre_name || 'Not assigned'"></dd><dt>School Released</dt><dd dmx-text="logisticsDetail.data.handoff_dispatched_at ? logisticsDetail.data.handoff_dispatched_at.formatDate('MMM d, yyyy, h:mm A') + ' · ' + (logisticsDetail.data.handoff_dispatched_by || 'user') : 'Not recorded'"></dd><dt>TTPost Received</dt><dd dmx-text="logisticsDetail.data.handoff_received_at ? logisticsDetail.data.handoff_received_at.formatDate('MMM d, yyyy, h:mm A') + ' · ' + (logisticsDetail.data.handoff_received_by || 'user') : 'Not recorded'"></dd><dt>Allocation Context</dt><dd dmx-text="logisticsDetail.data.allocation_context.custody_level || 'Not recorded'"></dd><dt dmx-show="logisticsDetail.data.return_device_identity.completed_replacement_case_id">Physical Return Device</dt><dd dmx-show="logisticsDetail.data.return_device_identity.completed_replacement_case_id" dmx-text="logisticsDetail.data.return_device.asset_tag || logisticsDetail.data.return_device.serial_number"></dd></dl></section>
          <section class="logistics-detail-card logistics-next-action"><h2><i class="far fa-clipboard" aria-hidden="true"></i>Next Action</h2>
            <div class="logistics-action-message" dmx-show="logisticsDetail.data.logistics_case.current_logistics_status_code == 'REQUESTED'"><span class="logistics-action-icon"><i class="fas fa-info" aria-hidden="true"></i></span><div><strong>Pickup request awaiting acceptance</strong><p>Review the request details and accept the pickup request to proceed with the logistics process.</p></div></div>
            <div class="logistics-action-message" dmx-show="logisticsDetail.data.physical_state_code == 'AWAITING_SCHOOL_HANDOFF'"><span class="logistics-action-icon"><i class="fas fa-info" aria-hidden="true"></i></span><div><strong>Awaiting School handoff</strong><p>Coordinate release of the physical device to TTPost.</p></div></div>
            <div class="logistics-action-message" dmx-show="logisticsDetail.data.physical_state_code == 'PENDING_TTPOST_RECEIPT'"><span class="logistics-action-icon"><i class="fas fa-info" aria-hidden="true"></i></span><div><strong>Awaiting TTPost receipt</strong><p>Confirm receipt only after TTPost has physically received the device.</p></div></div>
            <div class="logistics-action-message" dmx-show="logisticsDetail.data.physical_state_code == 'TTPOST_CUSTODY'"><span class="logistics-action-icon"><i class="fas fa-info" aria-hidden="true"></i></span><div><strong>Device is in TTPost custody</strong><p>Continue the outbound movement to the Repair Centre.</p></div></div>
            <div class="logistics-action-message" dmx-show="logisticsDetail.data.physical_state_code == 'PENDING_REPAIR_CENTRE_RECEIPT'"><span class="logistics-action-icon"><i class="fas fa-info" aria-hidden="true"></i></span><div><strong>Awaiting Repair Centre receipt</strong><p>Dispatch does not establish Repair Centre custody.</p></div></div>
            <div class="logistics-action-message" dmx-show="logisticsDetail.data.physical_state_code == 'REPAIR_CENTRE_CUSTODY'"><span class="logistics-action-icon"><i class="fas fa-info" aria-hidden="true"></i></span><div><strong>Device at Repair Centre</strong><p>Physical custody is confirmed at the Repair Centre.</p></div></div>
            <div class="logistics-action-message" dmx-show="logisticsDetail.data.physical_state_code == 'PENDING_TTPOST_RETURN_RECEIPT'"><span class="logistics-action-icon"><i class="fas fa-info" aria-hidden="true"></i></span><div><strong>Awaiting TTPost return receipt</strong><p>Return transit starts after TTPost confirms receipt.</p></div></div>
            <div class="logistics-action-message" dmx-show="logisticsDetail.data.physical_state_code == 'TTPOST_RETURN_CUSTODY'"><span class="logistics-action-icon"><i class="fas fa-info" aria-hidden="true"></i></span><div><strong>Return shipment in TTPost custody</strong><p>Dispatch to the destination School when ready.</p></div></div>
            <div class="logistics-action-message" dmx-show="logisticsDetail.data.physical_state_code == 'PENDING_SCHOOL_RETURN_RECEIPT'"><span class="logistics-action-icon"><i class="fas fa-info" aria-hidden="true"></i></span><div><strong>Awaiting School receipt</strong><p>Confirm physical receipt at the destination School.</p></div></div>
            <div class="logistics-action-message" dmx-show="logisticsDetail.data.logistics_case.current_logistics_status_code == 'RETURNED_TO_SCHOOL'"><span class="logistics-action-icon"><i class="fas fa-check" aria-hidden="true"></i></span><div><strong>Return journey complete</strong><p>The School received the device. Device lifecycle and allocation were not changed.</p></div></div>
            <button class="btn btn-bmobile-primary logistics-action-button" type="button" dmx-show="authContext.data.can_logistics_accept && logisticsDetail.data.logistics_case.current_logistics_status_code == 'REQUESTED'" dmx-on:click="acceptRequestForm.reset(true);acceptRequestModal.show()"><i class="fas fa-check-circle me-2" aria-hidden="true"></i>Accept Pickup Request</button>
            <button class="btn btn-bmobile-primary logistics-action-button" type="button" dmx-show="authContext.data.can_logistics_dispatch && logisticsDetail.data.physical_state_code == 'AWAITING_SCHOOL_HANDOFF'" dmx-on:click="schoolDispatchForm.reset(true);ttPostOptions.load();schoolDispatchModal.show()">Release Device to TTPost</button>
            <button class="btn btn-bmobile-primary logistics-action-button" type="button" dmx-show="authContext.data.can_logistics_receive && logisticsDetail.data.physical_state_code == 'PENDING_TTPOST_RECEIPT'" dmx-on:click="ttPostReceiveForm.reset(true);ttPostReceiveModal.show()">Confirm Device Receipt</button>
            <button class="btn btn-bmobile-primary logistics-action-button" type="button" dmx-show="authContext.data.can_logistics_forward_to_repair && logisticsDetail.data.physical_state_code == 'TTPOST_CUSTODY'" dmx-on:click="repairDispatchForm.reset(true);repairCentreOptions.load();repairDispatchModal.show()">Dispatch to Repair Centre</button>
            <button class="btn btn-bmobile-primary logistics-action-button" type="button" dmx-show="authContext.data.can_logistics_repair_receive && logisticsDetail.data.physical_state_code == 'PENDING_REPAIR_CENTRE_RECEIPT'" dmx-on:click="repairReceiveForm.reset(true);repairReceiveModal.show()">Confirm Device Receipt</button>
            <button class="btn btn-bmobile-primary logistics-action-button" type="button" dmx-show="authContext.data.can_logistics_return_dispatch && logisticsDetail.data.logistics_case.current_logistics_status_code == 'READY_FOR_RETURN' && logisticsDetail.data.physical_state_code == 'REPAIR_CENTRE_CUSTODY' && (!logisticsDetail.data.return_device_identity.completed_replacement_case_id || logisticsDetail.data.allocation_context.school_id) && (logisticsDetail.data.return_device_identity.completed_replacement_case_id || logisticsDetail.data.repair.outcome_is_return_ready == 1 || logisticsDetail.data.manufacturer_return_eligible)" dmx-on:click="returnDispatchForm.reset(true);returnTtPostOptions.load();returnDispatchModal.show()">Dispatch Return to TTPost</button>
            <button class="btn btn-bmobile-primary logistics-action-button" type="button" dmx-show="authContext.data.can_logistics_return_ttpost_receive && logisticsDetail.data.physical_state_code == 'PENDING_TTPOST_RETURN_RECEIPT'" dmx-on:click="returnTtPostReceiveForm.reset(true);returnTtPostReceiveModal.show()">Confirm TTPost Return Receipt</button>
            <button class="btn btn-bmobile-primary logistics-action-button" type="button" dmx-show="authContext.data.can_logistics_return_school_dispatch && logisticsDetail.data.physical_state_code == 'TTPOST_RETURN_CUSTODY'" dmx-on:click="schoolReturnDispatchForm.reset(true);schoolReturnDispatchModal.show()">Dispatch to School</button>
            <button class="btn btn-bmobile-primary logistics-action-button" type="button" dmx-show="authContext.data.can_logistics_return_school_receive && logisticsDetail.data.physical_state_code == 'PENDING_SCHOOL_RETURN_RECEIPT'" dmx-on:click="schoolReturnReceiveForm.reset(true);schoolReturnReceiveModal.show()">Confirm Returned Device Receipt</button>
            <p class="alert alert-warning py-2 mb-0" dmx-show="logisticsDetail.data.return_device_identity.completed_replacement_case_id && logisticsDetail.data.logistics_case.current_logistics_status_code == 'READY_FOR_RETURN' && !logisticsDetail.data.allocation_context.school_id">This replacement has no School destination in its active allocation. School return is unavailable.</p>
          </section>
          <section class="logistics-detail-card"><h2><i class="fas fa-info-circle" aria-hidden="true"></i>Additional Information</h2>
            <div dmx-show="logisticsDetail.data.logistics_case.device_source == 'TEMPORARY_LOAN_CONVERSION'"><strong>Temporary Loan Conversion Fulfillment</strong><dl class="logistics-detail-fields mt-2"><dt>Status</dt><dd>Fulfilled at Recipient</dd><dt>Original Device</dt><dd dmx-text="logisticsDetail.data.logistics_case.original_asset_tag || logisticsDetail.data.logistics_case.original_serial_number"></dd><dt>Effective Device</dt><dd dmx-text="logisticsDetail.data.logistics_case.asset_tag || logisticsDetail.data.logistics_case.serial_number"></dd><dt>Physical Custody</dt><dd>With Recipient</dd></dl></div>
            <div dmx-show="logisticsDetail.data.logistics_case.device_source == 'PERMANENT_REPLACEMENT'"><strong>Permanent Replacement Return</strong><dl class="logistics-detail-fields mt-2"><dt>Return Device</dt><dd dmx-text="logisticsDetail.data.logistics_case.asset_tag || logisticsDetail.data.logistics_case.serial_number"></dd><dt>Original Device</dt><dd dmx-text="logisticsDetail.data.logistics_case.original_asset_tag || logisticsDetail.data.logistics_case.original_serial_number"></dd><dt>Replacement</dt><dd><a dmx-bind:href="'/permanent-replacements/detail?id=' + logisticsDetail.data.logistics_case.replacement_case_id" dmx-text="logisticsDetail.data.logistics_case.replacement_number"></a></dd><dt>Destination School</dt><dd dmx-text="logisticsDetail.data.allocation_context.school_name || 'No School destination in current allocation'"></dd></dl></div>
            <div dmx-show="logisticsDetail.data.repair.repair_state"><strong>Repair Processing</strong><dl class="logistics-detail-fields mt-2"><dt>Repair State</dt><dd dmx-text="logisticsDetail.data.repair.repair_state == 'AWAITING_REPAIR_START' ? 'Awaiting Repair Start' : logisticsDetail.data.repair.repair_state == 'IN_PROGRESS' ? 'In Progress' : logisticsDetail.data.repair.repair_state == 'READY_FOR_RETURN' ? 'Ready for Return' : 'Disposition Recorded'"></dd><dt>Outcome</dt><dd dmx-text="logisticsDetail.data.repair.outcome_name || 'Not recorded'"></dd><dt>Started</dt><dd dmx-text="logisticsDetail.data.repair.started_at ? logisticsDetail.data.repair.started_at.formatDate('MMM d, yyyy, h:mm A') : 'Not started'"></dd><dt>Completed</dt><dd dmx-text="logisticsDetail.data.repair.completed_at ? logisticsDetail.data.repair.completed_at.formatDate('MMM d, yyyy, h:mm A') : 'Not completed'"></dd></dl></div>
            <div dmx-show="logisticsDetail.data.manufacturer_return_status && !logisticsDetail.data.return_device_identity.completed_replacement_case_id"><strong>Manufacturer Return Context</strong><dl class="logistics-detail-fields mt-2"><dt>Manufacturer Return</dt><dd dmx-text="logisticsDetail.data.manufacturer_return_status"></dd><dt>Physical Custody</dt><dd dmx-text="logisticsDetail.data.manufacturer_return_custody"></dd></dl></div>
            <div dmx-show="logisticsDetail.data.logistics_case.current_logistics_status_code == 'RETURNED_TO_SCHOOL'"><strong>Final School Return</strong><dl class="logistics-detail-fields mt-2"><dt>Returned School</dt><dd dmx-text="logisticsDetail.data.returned_school.school_name || logisticsDetail.data.logistics_case.pickup_school_name"></dd><dt>Returned At</dt><dd dmx-text="logisticsDetail.data.returned_at_display"></dd><dt>Received By</dt><dd dmx-text="logisticsDetail.data.returned_school.received_by_display_name || 'Not recorded'"></dd></dl></div>
            <div class="logistics-empty-context" dmx-show="!logisticsDetail.data.repair.repair_state && !logisticsDetail.data.manufacturer_return_status && logisticsDetail.data.logistics_case.device_source != 'TEMPORARY_LOAN_CONVERSION' && logisticsDetail.data.logistics_case.device_source != 'PERMANENT_REPLACEMENT' && logisticsDetail.data.logistics_case.current_logistics_status_code != 'RETURNED_TO_SCHOOL'"><span><i class="far fa-file-alt" aria-hidden="true"></i></span><p>No additional notes or logistics information<br>recorded for this case.</p></div>
          </section>
        </div>

        <section class="logistics-detail-card logistics-history-card"><h2><i class="fas fa-exchange-alt" aria-hidden="true"></i>Physical Handoff History</h2><div class="table-responsive portal-table-wrapper"><table class="table portal-table align-middle"><thead><tr><th>Movement</th><th>Source</th><th>Destination</th><th>Dispatched</th><th>Dispatched By</th><th>Received</th><th>Received By</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="logisticsDetail.data.handoffs"><tr><td dmx-text="handoff_type == 'SCHOOL_TO_TTPOST' ? 'School to TTPost' : handoff_type == 'TTPOST_TO_REPAIR_CENTRE' ? 'TTPost to Repair Centre' : handoff_type == 'REPAIR_CENTRE_TO_TTPOST' ? 'Repair Centre to TTPost' : handoff_type == 'TTPOST_TO_SCHOOL' ? 'TTPost to School' : handoff_type"></td><td dmx-text="from_school_name || from_location_name || 'Not recorded'"></td><td dmx-text="to_school_name || to_location_name || 'Not recorded'"></td><td class="text-nowrap" dmx-text="dispatched_at_display"></td><td dmx-text="dispatched_by_display_name || 'Unknown user'"></td><td class="text-nowrap" dmx-text="received_at_display"></td><td dmx-text="received_by_display_name || 'Not recorded'"></td></tr></tbody></table></div><p class="logistics-history-empty" dmx-show="logisticsDetail.data.handoffs.count() == 0"><i class="fas fa-cube" aria-hidden="true"></i>No physical handoffs recorded.</p></section>
        <section class="logistics-detail-card logistics-history-card"><h2><i class="far fa-clock" aria-hidden="true"></i>Logistics Status History</h2><div class="table-responsive portal-table-wrapper"><table class="table portal-table"><thead><tr><th>Recorded</th><th>From</th><th>To</th><th>Recorded By</th></tr></thead><tbody is="dmx-repeat" dmx-bind:repeat="logisticsDetail.data.status_history"><tr><td class="text-nowrap" dmx-text="changed_at_display"></td><td dmx-text="from_status_name || 'Created'"></td><td dmx-text="to_status_name"></td><td dmx-text="changed_by_display_name || 'System'"></td></tr></tbody></table></div></section>
      </div>
    </main>
  </div>
</div>
