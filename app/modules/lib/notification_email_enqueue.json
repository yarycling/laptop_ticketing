{
  "exec": {
    "steps": [
      { "name": "recipient", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "notification_recipients", "alias": "nr" }, "columns": [{ "table": "nr", "column": "id" }, { "table": "nr", "column": "user_id" }, { "table": "e", "column": "id", "alias": "event_id" }, { "table": "e", "column": "event_type_code" }, { "table": "e", "column": "title" }, { "table": "e", "column": "message" }, { "table": "t", "column": "ticket_number" }, { "table": "u", "column": "email" }, { "table": "u", "column": "display_name" }, { "table": "u", "column": "status", "alias": "user_status" }], "joins": [{ "table": "notification_events", "alias": "e", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "e", "column": "id", "operation": "=", "value": { "table": "nr", "column": "notification_event_id" } }] } }, { "table": "users", "alias": "u", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "u", "column": "id", "operation": "=", "value": { "table": "nr", "column": "user_id" } }] } }, { "table": "tickets", "alias": "t", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "t", "column": "id", "operation": "=", "value": { "table": "e", "column": "ticket_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "nr", "column": "user_id" }, "operation": "=", "value": "{{$_PARAM.recipient_user_id}}" }, { "data": { "table": "e", "column": "id" }, "operation": "=", "value": "{{$_PARAM.notification_event_id}}" }] } } } },
      { "name": "channel_rule", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "notification_channel_rules", "columns": [{ "column": "max_attempts" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "event_type_code" }, "operation": "=", "value": "{{recipient.event_type_code}}" }, { "data": { "column": "channel_code" }, "operation": "=", "value": "EMAIL" }, { "data": { "column": "is_enabled" }, "operation": "=", "value": 1 }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!recipient.id || recipient.user_status != 'active' || (!channel_rule.max_attempts && !$_PARAM.force_email)}}", "then": { "steps": [{ "name": "skipped", "module": "core", "action": "setvalue", "output": true, "options": { "key": "email_enqueue_skipped", "value": true } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{recipient.id && recipient.user_status == 'active' && (channel_rule.max_attempts || $_PARAM.force_email)}}", "then": { "steps": [
        { "name": "existing", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "notification_deliveries", "columns": [{ "column": "id" }, { "column": "status_code" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "notification_recipient_id" }, "operation": "=", "value": "{{recipient.id}}" }, { "data": { "column": "channel_code" }, "operation": "=", "value": "EMAIL" }] } } } },
        { "module": "core", "action": "condition", "options": { "if": "{{!existing.id}}", "then": { "steps": [
          { "name": "email_normalized", "module": "core", "action": "setvalue", "output": true, "options": { "key": "email_normalized", "value": "{{(recipient.email || '').trim().lowercase()}}" } },
          { "name": "delivery_state", "module": "core", "action": "setvalue", "output": true, "options": { "key": "delivery_state", "value": "{{!email_normalized ? 'SKIPPED_NO_ADDRESS' : (email_normalized.length() < 6 || !email_normalized.contains('@') || !email_normalized.contains('.') ? 'SKIPPED_INVALID_ADDRESS' : 'PENDING')}}" } },
          { "name": "delivery_insert", "module": "dbupdater", "action": "insert", "output": true, "options": { "connection": "db", "sql": { "table": "notification_deliveries", "values": [{ "column": "notification_event_id", "value": "{{recipient.event_id}}" }, { "column": "notification_recipient_id", "value": "{{recipient.id}}" }, { "column": "user_id", "value": "{{recipient.user_id}}" }, { "column": "channel_code", "value": "EMAIL" }, { "column": "recipient_address", "value": "{{email_normalized || null}}" }, { "column": "recipient_name", "value": "{{recipient.display_name || null}}" }, { "column": "subject_snapshot", "value": "{{recipient.title}}" }, { "column": "body_text_snapshot", "value": "{{recipient.title + '\\n\\n' + recipient.message + (recipient.ticket_number ? '\\n\\nTicket: ' + recipient.ticket_number : '')}}" }, { "column": "action_url_snapshot", "value": null }, { "column": "status_code", "value": "{{delivery_state}}" }, { "column": "max_attempts", "value": "{{channel_rule.max_attempts || 3}}" }] } } },
          { "name": "delivery_number", "module": "dbupdater", "action": "update", "options": { "connection": "db", "sql": { "table": "notification_deliveries", "values": [{ "column": "delivery_number", "value": "{{'EML-' + delivery_insert.identity}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{delivery_insert.identity}}" }] } } } }
        ] } } },
        { "name": "delivery", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "notification_deliveries", "columns": [{ "column": "id" }, { "column": "status_code" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "notification_recipient_id" }, "operation": "=", "value": "{{recipient.id}}" }, { "data": { "column": "channel_code" }, "operation": "=", "value": "EMAIL" }] } } } },
        { "module": "core", "action": "condition", "options": { "if": "{{delivery.id && delivery.status_code == 'PENDING' && !$_PARAM.defer_send}}", "then": { "steps": [{ "module": "core", "action": "exec", "options": { "exec": "notification_email_send", "params": { "delivery_id": "{{delivery.id}}", "actor_user_id": "{{$_PARAM.actor_user_id || null}}" } } }] } } },
        { "name": "email_enqueue_result", "module": "core", "action": "setvalue", "output": true, "options": { "key": "email_delivery_id", "value": "{{delivery.id || existing.id || delivery_insert.identity}}" } }
      ] } } }
    ],
    "catch": [{ "module": "core", "action": "setvalue", "output": true, "options": { "key": "email_enqueue_failed", "value": true } }]
  }
}
