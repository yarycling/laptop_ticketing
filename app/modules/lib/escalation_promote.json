{
  "exec": { "steps": [
    { "name": "sla", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "sla_instances", "alias": "i" }, "columns": [{ "table": "i", "column": "id" }, { "table": "i", "column": "policy_id" }, { "table": "i", "column": "policy_code_snapshot" }, { "table": "i", "column": "ticket_id" }, { "table": "i", "column": "logistics_case_id" }, { "table": "i", "column": "repair_job_id" }, { "table": "i", "column": "current_state_code" }, { "table": "t", "column": "origin_district_id" }, { "table": "t", "column": "origin_school_id" }, { "table": "lc", "column": "repair_centre_location_id" }], "joins": [{ "table": "tickets", "alias": "t", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "t", "column": "id", "operation": "=", "value": { "table": "i", "column": "ticket_id" } }] } }, { "table": "ticket_logistics_cases", "alias": "lc", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "lc", "column": "id", "operation": "=", "value": { "table": "i", "column": "logistics_case_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "i", "column": "id" }, "operation": "=", "value": "{{$_PARAM.sla_instance_id}}" }, { "data": { "table": "i", "column": "current_state_code" }, "operation": "=", "value": "BREACHED" }] } } } },
    { "name": "rules", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "escalation_rules", "alias": "er" }, "columns": [{ "table": "er", "column": "id" }, { "table": "er", "column": "escalation_level" }, { "table": "er", "column": "trigger_code" }, { "table": "er", "column": "target_role_id" }, { "table": "er", "column": "reason_label" }, { "table": "r", "column": "name", "alias": "target_role_name" }], "joins": [{ "table": "roles", "alias": "r", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "r", "column": "id", "operation": "=", "value": { "table": "er", "column": "target_role_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "er", "column": "policy_id" }, "operation": "=", "value": "{{sla.policy_id}}" }, { "data": { "table": "er", "column": "trigger_code" }, "operation": "=", "value": "BREACHED" }, { "data": { "table": "er", "column": "escalation_level" }, "operation": "=", "value": 2 }, { "data": { "table": "er", "column": "status" }, "operation": "=", "value": "active" }] } } } },
    { "name": "case", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "escalation_cases", "columns": [{ "column": "id" }, { "column": "current_state_code" }, { "column": "current_level" }, { "column": "current_trigger" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "sla_instance_id" }, "operation": "=", "value": "{{sla.id}}" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{sla.id && rules.length > 0 && !case.id}}", "then": { "steps": [
      { "name": "new_case", "module": "dbupdater", "action": "insert", "output": true, "options": { "connection": "db", "sql": { "table": "escalation_cases", "values": [{ "column": "sla_instance_id", "value": "{{sla.id}}" }, { "column": "escalation_number", "value": "{{'TMP-' + sla.id}}" }, { "column": "policy_code_snapshot", "value": "{{sla.policy_code_snapshot}}" }, { "column": "ticket_id", "value": "{{sla.ticket_id}}" }, { "column": "logistics_case_id", "value": "{{sla.logistics_case_id}}" }, { "column": "repair_job_id", "value": "{{sla.repair_job_id}}" }, { "column": "district_id", "value": "{{sla.origin_district_id}}" }, { "column": "school_id", "value": "{{sla.origin_school_id}}" }, { "column": "repair_centre_location_id", "value": "{{sla.repair_centre_location_id}}" }, { "column": "current_level", "value": 1 }, { "column": "current_trigger", "value": "BREACHED" }, { "column": "current_state_code", "value": "OPEN" }, { "column": "reason_snapshot", "value": "{{rules[0].reason_label}}" }, { "column": "opened_at", "value": "{{$_PARAM.event_at}}" }] } } },
      { "module": "dbupdater", "action": "update", "options": { "connection": "db", "sql": { "table": "escalation_cases", "values": [{ "column": "escalation_number", "value": "{{'ESC' + new_case.identity.padNumber(8)}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{new_case.identity}}" }] } } } },
      { "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "escalation_history", "values": [{ "column": "escalation_case_id", "value": "{{new_case.identity}}" }, { "column": "event_code", "value": "OPENED" }, { "column": "event_key", "value": "{{'SLA:' + sla.id + ':OPENED'}}" }, { "column": "old_state_code", "value": null }, { "column": "new_state_code", "value": "OPEN" }, { "column": "old_level", "value": null }, { "column": "new_level", "value": 1 }, { "column": "trigger_code", "value": "BREACHED" }, { "column": "source_sla_event_id", "value": "{{$_PARAM.sla_event_id}}" }, { "column": "actor_user_id", "value": "{{$_PARAM.actor_user_id || null}}" }, { "column": "event_at", "value": "{{$_PARAM.event_at}}" }, { "column": "notes", "value": "Created from breach because no prior at-risk escalation existed." }] } } },
      { "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{$_PARAM.actor_user_id || null}}" }, { "column": "action", "value": "escalation_opened" }, { "column": "module", "value": "escalations" }, { "column": "entity_type", "value": "escalation_case" }, { "column": "entity_id", "value": "{{new_case.identity}}" }, { "column": "description", "value": "{{'Opened escalation after SLA breach for ticket ' + sla.ticket_id}}" }] } } },
      { "name": "assign_promoted", "module": "core", "action": "repeat", "options": { "repeat": "{{rules}}", "exec": { "steps": [
        { "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "escalation_assignments", "values": [{ "column": "escalation_case_id", "value": "{{new_case.identity}}" }, { "column": "escalation_rule_id", "value": "{{id}}" }, { "column": "level_snapshot", "value": 2 }, { "column": "trigger_snapshot", "value": "BREACHED" }, { "column": "target_role_id", "value": "{{target_role_id}}" }, { "column": "target_role_name_snapshot", "value": "{{target_role_name}}" }, { "column": "reason_snapshot", "value": "{{reason_label}}" }, { "column": "assigned_at", "value": "{{$_PARAM.event_at}}" }, { "column": "assigned_by", "value": "{{$_PARAM.actor_user_id || null}}" }] } } }
      ] } } },
      { "name": "update_new_case_level", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "escalation_cases", "values": [{ "column": "current_level", "value": 2 }, { "column": "reason_snapshot", "value": "{{rules[0].reason_label}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{new_case.identity}}" }, { "data": { "column": "current_level" }, "operation": "=", "value": 1 }] } } } },
      { "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "escalation_history", "values": [{ "column": "escalation_case_id", "value": "{{new_case.identity}}" }, { "column": "event_code", "value": "PROMOTED" }, { "column": "event_key", "value": "{{'SLA:' + sla.id + ':PROMOTED:2'}}" }, { "column": "old_state_code", "value": "OPEN" }, { "column": "new_state_code", "value": "OPEN" }, { "column": "old_level", "value": 1 }, { "column": "new_level", "value": 2 }, { "column": "trigger_code", "value": "BREACHED" }, { "column": "source_sla_event_id", "value": "{{$_PARAM.sla_event_id}}" }, { "column": "actor_user_id", "value": "{{$_PARAM.actor_user_id || null}}" }, { "column": "event_at", "value": "{{$_PARAM.event_at}}" }, { "column": "notes", "value": "{{rules[0].reason_label}}" }] } } },
      { "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{$_PARAM.actor_user_id || null}}" }, { "column": "action", "value": "escalation_promoted" }, { "column": "module", "value": "escalations" }, { "column": "entity_type", "value": "escalation_case" }, { "column": "entity_id", "value": "{{new_case.identity}}" }, { "column": "description", "value": "Escalation created at breach and assigned at level 2." }] } } }
    ] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{sla.id && rules.length > 0 && case.id && case.current_level < 2 && ['OPEN','ACKNOWLEDGED'].contains(case.current_state_code)}}", "then": { "steps": [
      { "name": "promote_case", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "escalation_cases", "values": [{ "column": "current_level", "value": 2 }, { "column": "current_trigger", "value": "BREACHED" }, { "column": "reason_snapshot", "value": "{{rules[0].reason_label}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{case.id}}" }, { "data": { "column": "current_level" }, "operation": "=", "value": "{{case.current_level}}" }, { "data": { "column": "current_state_code" }, "operation": "=", "value": "{{case.current_state_code}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{promote_case.affected == 1}}", "then": { "steps": [
        { "name": "assign_each", "module": "core", "action": "repeat", "options": { "repeat": "{{rules}}", "exec": { "steps": [
          { "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "escalation_assignments", "values": [{ "column": "escalation_case_id", "value": "{{case.id}}" }, { "column": "escalation_rule_id", "value": "{{id}}" }, { "column": "level_snapshot", "value": 2 }, { "column": "trigger_snapshot", "value": "BREACHED" }, { "column": "target_role_id", "value": "{{target_role_id}}" }, { "column": "target_role_name_snapshot", "value": "{{target_role_name}}" }, { "column": "reason_snapshot", "value": "{{reason_label}}" }, { "column": "assigned_at", "value": "{{$_PARAM.event_at}}" }, { "column": "assigned_by", "value": "{{$_PARAM.actor_user_id || null}}" }] } } }
        ] } } },
        { "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "escalation_history", "values": [{ "column": "escalation_case_id", "value": "{{case.id}}" }, { "column": "event_code", "value": "PROMOTED" }, { "column": "event_key", "value": "{{'SLA:' + sla.id + ':PROMOTED:2'}}" }, { "column": "old_state_code", "value": "{{case.current_state_code}}" }, { "column": "new_state_code", "value": "{{case.current_state_code}}" }, { "column": "old_level", "value": "{{case.current_level}}" }, { "column": "new_level", "value": 2 }, { "column": "trigger_code", "value": "BREACHED" }, { "column": "source_sla_event_id", "value": "{{$_PARAM.sla_event_id}}" }, { "column": "actor_user_id", "value": "{{$_PARAM.actor_user_id || null}}" }, { "column": "event_at", "value": "{{$_PARAM.event_at}}" }, { "column": "notes", "value": "{{rules[0].reason_label}}" }] } } },
        { "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{$_PARAM.actor_user_id || null}}" }, { "column": "action", "value": "escalation_promoted" }, { "column": "module", "value": "escalations" }, { "column": "entity_type", "value": "escalation_case" }, { "column": "entity_id", "value": "{{case.id}}" }, { "column": "description", "value": "{{'Promoted SLA-' + sla.id + ' escalation to level 2 after breach.'}}" }] } } }
      ] } } }
    ] } } }
  ] }
}
