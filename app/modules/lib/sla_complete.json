{
  "exec": {
    "steps": [
      { "name": "instance", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_sla_completion_context", "columns": [{ "column": "id" }, { "column": "current_state_code" }, { "column": "due_at" }, { "column": "policy_code_snapshot" }, { "column": "calendar_id" }, { "column": "timezone_name" }, { "column": "completion_business_datetime" }, { "column": "timezone_resolution_error" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "idempotency_key" }, "operation": "=", "value": "{{$_PARAM.idempotency_key}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{instance.id && (!instance.completion_business_datetime || instance.timezone_resolution_error == 1)}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "SLA_COMPLETION_CONFIGURATION" } }] } } },
      { "name": "completion_state", "module": "core", "action": "setvalue", "output": true, "options": { "key": "completion_state", "value": "{{instance.current_state_code == 'BREACHED' || instance.completion_business_datetime > instance.due_at ? 'COMPLETED_OUTSIDE_SLA' : 'COMPLETED_WITHIN_SLA'}}" } },
      { "module": "core", "action": "condition", "options": { "if": "{{instance.id && ['ACTIVE','AT_RISK','BREACHED'].contains(instance.current_state_code)}}", "then": { "steps": [
        { "name": "completion_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
          { "name": "complete_instance", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "sla_instances", "values": [{ "column": "current_state_code", "value": "{{completion_state}}" }, { "column": "completed_at", "value": "{{instance.completion_business_datetime}}" }, { "column": "completion_event", "value": "{{$_PARAM.completion_event}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{instance.id}}" }, { "condition": "OR", "rules": [{ "data": { "column": "current_state_code" }, "operation": "=", "value": "ACTIVE" }, { "data": { "column": "current_state_code" }, "operation": "=", "value": "AT_RISK" }, { "data": { "column": "current_state_code" }, "operation": "=", "value": "BREACHED" }] }] } } } },
          { "module": "core", "action": "condition", "options": { "if": "{{complete_instance.affected == 1}}", "then": { "steps": [
            { "name": "completed_event", "module": "dbupdater", "action": "insert", "output": true, "options": { "connection": "db", "sql": { "table": "sla_instance_events", "values": [{ "column": "sla_instance_id", "value": "{{instance.id}}" }, { "column": "event_code", "value": "COMPLETED" }, { "column": "from_state_code", "value": "{{instance.current_state_code}}" }, { "column": "to_state_code", "value": "{{completion_state}}" }, { "column": "event_at", "value": "{{instance.completion_business_datetime}}" }, { "column": "source_entity_type", "value": "{{$_PARAM.source_entity_type}}" }, { "column": "source_entity_id", "value": "{{$_PARAM.source_entity_id}}" }, { "column": "actor_user_id", "value": "{{$_PARAM.actor_user_id || null}}" }] } } },
            { "name": "resolve_escalation", "module": "core", "action": "exec", "output": true, "options": { "exec": "escalation_close", "params": { "sla_instance_id": "{{instance.id}}", "sla_event_id": "{{completed_event.identity}}", "terminal_code": "RESOLVED", "event_at": "{{instance.completion_business_datetime}}", "source_entity_type": "{{$_PARAM.source_entity_type}}", "source_entity_id": "{{$_PARAM.source_entity_id}}", "actor_user_id": "{{$_PARAM.actor_user_id || null}}", "notes": "Underlying SLA completed." } } },
            { "name": "completed_audit", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{$_PARAM.actor_user_id || null}}" }, { "column": "action", "value": "sla_completed" }, { "column": "module", "value": "sla" }, { "column": "entity_type", "value": "sla_instance" }, { "column": "entity_id", "value": "{{instance.id}}" }, { "column": "description", "value": "{{'Completed ' + instance.policy_code_snapshot + ' SLA as ' + completion_state}}" }] } } }
          ] } } }
        ] } } }
      ] } } },
      { "name": "completed_escalation", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "escalation_cases", "columns": [{ "column": "id" }, { "column": "current_state_code" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "sla_instance_id" }, "operation": "=", "value": "{{instance.id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{completed_escalation.current_state_code == 'RESOLVED'}}", "then": { "steps": [{ "name": "resolution_notification", "module": "core", "action": "exec", "output": true, "options": { "exec": "notification_from_escalation", "params": { "escalation_case_id": "{{completed_escalation.id}}", "event_type_code": "ESCALATION_RESOLVED", "actor_user_id": "{{$_PARAM.actor_user_id || null}}" } } }] } } }
    ]
  }
}
