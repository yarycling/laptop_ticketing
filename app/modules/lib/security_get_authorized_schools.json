{
  "exec": {
    "steps": [
      {
        "name": "scope_context",
        "module": "core",
        "action": "exec",
        "options": {
          "exec": "security_get_scope_context",
          "params": {}
        },
        "output": true
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{$_PARAM.super_admin || scope_context.has_national_scope}}",
          "then": {
            "steps": [
              {
                "name": "allowed_schools",
                "module": "dbconnector",
                "action": "select",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": {
                      "name": "schools",
                      "alias": "s"
                    },
                    "columns": [
                      {
                        "table": "s",
                        "column": "id",
                        "alias": "id"
                      },
                      {
                        "table": "s",
                        "column": "school_code",
                        "alias": "school_code"
                      },
                      {
                        "table": "s",
                        "column": "name",
                        "alias": "name"
                      },
                      {
                        "table": "s",
                        "column": "district_id",
                        "alias": "district_id"
                      },
                      {
                        "table": "d",
                        "column": "name",
                        "alias": "district_name"
                      },
                      {
                        "table": "s",
                        "column": "status",
                        "alias": "status"
                      }
                    ],
                    "joins": [
                      {
                        "table": "districts",
                        "alias": "d",
                        "type": "left",
                        "clauses": {
                          "condition": "AND",
                          "rules": [
                            {
                              "table": "d",
                              "column": "id",
                              "operation": "=",
                              "value": {
                                "table": "s",
                                "column": "district_id"
                              }
                            }
                          ]
                        }
                      }
                    ],
                    "orders": [
                      {
                        "table": "s",
                        "column": "name",
                        "direction": "asc"
                      }
                    ]
                  }
                }
              }
            ]
          },
          "else": {
            "steps": [
              {
                "name": "allowed_schools",
                "module": "dbconnector",
                "action": "select",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": {
                      "name": "schools",
                      "alias": "s"
                    },
                    "columns": [
                      {
                        "table": "s",
                        "column": "id",
                        "alias": "id"
                      },
                      {
                        "table": "s",
                        "column": "school_code",
                        "alias": "school_code"
                      },
                      {
                        "table": "s",
                        "column": "name",
                        "alias": "name"
                      },
                      {
                        "table": "s",
                        "column": "district_id",
                        "alias": "district_id"
                      },
                      {
                        "table": "d",
                        "column": "name",
                        "alias": "district_name"
                      },
                      {
                        "table": "s",
                        "column": "status",
                        "alias": "status"
                      }
                    ],
                    "joins": [
                      {
                        "table": "districts",
                        "alias": "d",
                        "type": "left",
                        "clauses": {
                          "condition": "AND",
                          "rules": [
                            {
                              "table": "d",
                              "column": "id",
                              "operation": "=",
                              "value": {
                                "table": "s",
                                "column": "district_id"
                              }
                            }
                          ]
                        }
                      }
                    ],
                    "wheres": {
                      "condition": "OR",
                      "rules": [
                        {
                          "data": {
                            "table": "s",
                            "column": "id"
                          },
                          "operator": "in",
                          "value": "{{scope_context.schools.flatten('id')}}"
                        },
                        {
                          "data": {
                            "table": "s",
                            "column": "district_id"
                          },
                          "operator": "in",
                          "value": "{{scope_context.districts.flatten('id')}}"
                        }
                      ]
                    },
                    "orders": [
                      {
                        "table": "s",
                        "column": "name",
                        "direction": "asc"
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    ]
  }
}
