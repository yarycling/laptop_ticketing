{
  "exec": {
    "steps": [
      { "module": "core", "action": "condition", "options": { "if": "{{!$_PARAM.idempotency_key || $_PARAM.idempotency_key.length > 180 || !$_PARAM.recipient_user_id || !$_PARAM.title || $_PARAM.title.length > 180 || !$_PARAM.message || $_PARAM.message.length > 1000}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "NOTIFICATION_INPUT_INVALID" } }] } } },
      { "name": "event_type", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "notification_event_types", "columns": [{ "column": "code" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "{{$_PARAM.event_type_code}}" }] } } } },
      { "name": "severity", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "notification_severities", "columns": [{ "column": "code" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "{{$_PARAM.severity_code}}" }] } } } },
      { "name": "recipient_user", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "users", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{$_PARAM.recipient_user_id}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!event_type.code || !severity.code}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "NOTIFICATION_TYPE_OR_SEVERITY_INVALID" } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!recipient_user.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "NOTIFICATION_RECIPIENT_INVALID" } }] } } },
      { "name": "existing", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "notification_events", "columns": [{ "column": "id" }, { "column": "event_type_code" }, { "column": "severity_code" }, { "column": "title" }, { "column": "message" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "idempotency_key" }, "operation": "=", "value": "{{$_PARAM.idempotency_key}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{existing.id && (existing.event_type_code != $_PARAM.event_type_code || existing.severity_code != $_PARAM.severity_code || existing.title != $_PARAM.title || existing.message != $_PARAM.message)}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "NOTIFICATION_IDEMPOTENCY_CONFLICT" } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{existing.id}}", "then": { "steps": [
        { "name": "existing_recipient", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "notification_recipients", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "notification_event_id" }, "operation": "=", "value": "{{existing.id}}" }, { "data": { "column": "user_id" }, "operation": "=", "value": "{{$_PARAM.recipient_user_id}}" }] } } } },
        { "module": "core", "action": "condition", "options": { "if": "{{!existing_recipient.id}}", "then": { "steps": [
          { "name": "retry_recipient", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
            { "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "notification_recipients", "values": [{ "column": "notification_event_id", "value": "{{existing.id}}" }, { "column": "user_id", "value": "{{$_PARAM.recipient_user_id}}" }, { "column": "recipient_role_code", "value": "{{$_PARAM.recipient_role_code || null}}" }] } } },
            { "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{$_PARAM.created_by || null}}" }, { "column": "action", "value": "notification_recipient_added" }, { "column": "module", "value": "notifications" }, { "column": "entity_type", "value": "notification_event" }, { "column": "entity_id", "value": "{{existing.id}}" }, { "column": "description", "value": "Added an explicit notification recipient." }] } } }
          ] } } }
        ] } } },
        { "name": "event_id", "module": "core", "action": "setvalue", "output": true, "options": { "key": "event_id", "value": "{{existing.id}}" } },
        { "name": "created", "module": "core", "action": "setvalue", "output": true, "options": { "key": "created", "value": false } }
      ] }, "else": { "steps": [
        { "name": "create_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
          { "name": "new_event", "module": "dbupdater", "action": "insert", "output": true, "options": { "connection": "db", "sql": { "table": "notification_events", "values": [{ "column": "idempotency_key", "value": "{{$_PARAM.idempotency_key}}" }, { "column": "event_type_code", "value": "{{$_PARAM.event_type_code}}" }, { "column": "source_type", "value": "{{$_PARAM.source_type || null}}" }, { "column": "source_id", "value": "{{$_PARAM.source_id || null}}" }, { "column": "ticket_id", "value": "{{$_PARAM.ticket_id || null}}" }, { "column": "sla_instance_id", "value": "{{$_PARAM.sla_instance_id || null}}" }, { "column": "escalation_case_id", "value": "{{$_PARAM.escalation_case_id || null}}" }, { "column": "logistics_case_id", "value": "{{$_PARAM.logistics_case_id || null}}" }, { "column": "repair_job_id", "value": "{{$_PARAM.repair_job_id || null}}" }, { "column": "severity_code", "value": "{{$_PARAM.severity_code}}" }, { "column": "title", "value": "{{$_PARAM.title}}" }, { "column": "message", "value": "{{$_PARAM.message}}" }, { "column": "action_type", "value": "{{$_PARAM.action_type || null}}" }, { "column": "action_reference", "value": "{{$_PARAM.action_reference || null}}" }, { "column": "created_by", "value": "{{$_PARAM.created_by || null}}" }] } } },
          { "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "notification_recipients", "values": [{ "column": "notification_event_id", "value": "{{new_event.identity}}" }, { "column": "user_id", "value": "{{$_PARAM.recipient_user_id}}" }, { "column": "recipient_role_code", "value": "{{$_PARAM.recipient_role_code || null}}" }] } } },
          { "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{$_PARAM.created_by || null}}" }, { "column": "action", "value": "notification_created" }, { "column": "module", "value": "notifications" }, { "column": "entity_type", "value": "notification_event" }, { "column": "entity_id", "value": "{{new_event.identity}}" }, { "column": "description", "value": "Created a logical in-app notification event." }] } } }
        ] } } },
        { "name": "event_id", "module": "core", "action": "setvalue", "output": true, "options": { "key": "event_id", "value": "{{new_event.identity}}" } },
        { "name": "created", "module": "core", "action": "setvalue", "output": true, "options": { "key": "created", "value": true } }
      ] } } },
      { "name": "success", "module": "core", "action": "setvalue", "output": true, "options": { "key": "success", "value": true } },
      { "name": "email_delivery", "module": "core", "action": "exec", "output": true, "options": { "exec": "notification_email_enqueue", "params": { "notification_event_id": "{{event_id}}", "recipient_user_id": "{{$_PARAM.recipient_user_id}}", "actor_user_id": "{{$_PARAM.created_by || null}}", "force_email": "{{$_PARAM.force_email == true || $_PARAM.force_email == 'true' || $_PARAM.force_email == '1'}}", "defer_send": "{{$_PARAM.defer_email_send == true || $_PARAM.defer_email_send == 'true' || $_PARAM.defer_email_send == '1'}}" } } }
    ]
  }
}
