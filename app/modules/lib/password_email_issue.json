{
  "exec": {
    "steps": [
      {
        "module": "core",
        "action": "setvalue",
        "options": {
          "key": "sent",
          "value": false
        },
        "name": "sent"
      },
      {
        "module": "core",
        "action": "setvalue",
        "options": {
          "key": "identifier",
          "value": "{{($_PARAM.identifier || '').trim().lowercase()}}"
        },
        "name": "identifier"
      },
      {
        "name": "account",
        "module": "dbconnector",
        "action": "single",
        "options": {
          "connection": "db",
          "sql": {
            "table": "users",
            "columns": [
              {
                "column": "id"
              },
              {
                "column": "username"
              },
              {
                "column": "email"
              },
              {
                "column": "display_name"
              },
              {
                "column": "status"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "condition": "AND",
                  "rules": [
                    {
                      "data": {
                        "column": "id"
                      },
                      "operation": "=",
                      "value": "{{$_PARAM.user_id}}"
                    }
                  ],
                  "conditional": "{{$_PARAM.user_id}}"
                },
                {
                  "condition": "OR",
                  "rules": [
                    {
                      "data": {
                        "column": "username"
                      },
                      "operation": "=",
                      "value": "{{identifier}}"
                    },
                    {
                      "data": {
                        "column": "email"
                      },
                      "operation": "=",
                      "value": "{{identifier}}"
                    }
                  ],
                  "conditional": "{{!$_PARAM.user_id}}"
                }
              ]
            }
          }
        }
      },
      {
        "module": "dbconnector",
        "action": "select",
        "options": {
          "connection": "db",
          "sql": {
            "table": "admin_user_roles",
            "columns": [
              {
                "column": "label"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "data": {
                    "column": "user_id"
                  },
                  "operation": "=",
                  "value": "{{account.id}}"
                }
              ]
            }
          }
        },
        "name": "account_roles"
      },
      {
        "name": "reset_secret",
        "module": "otp",
        "action": "generateSecret",
        "options": {
          "size": 32
        }
      },
      {
        "name": "reset_request_id",
        "module": "otp",
        "action": "generateSecret",
        "options": {
          "size": 32
        }
      },
      {
        "name": "reset_secret_hash",
        "module": "crypto",
        "action": "passwordHash",
        "options": {
          "password": "{{reset_secret}}",
          "algo": "argon2id"
        }
      },
      {
        "module": "core",
        "action": "setvalue",
        "options": {
          "key": "reset_issued",
          "value": false
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{($_PARAM.user_id || (identifier.length() > 0 && identifier.length() <= 254)) && account.id && account.status == 'active' && account.email}}",
          "then": {
            "steps": [
              {
                "name": "reset_url",
                "module": "core",
                "action": "setvalue",
                "options": {
                  "key": "reset_url",
                  "value": "{{$_ENV.APP_BASE_URL + '/reset-password?r=' + reset_request_id + '&token=' + reset_secret}}"
                }
              },
              {
                "name": "create_reset_request",
                "module": "dbupdater",
                "action": "transaction",
                "options": {
                  "connection": "db",
                  "exec": {
                    "steps": [
                      {
                        "name": "lock_account_for_throttle",
                        "module": "dbupdater",
                        "action": "update",
                        "options": {
                          "connection": "db",
                          "sql": {
                            "table": "users",
                            "values": [
                              {
                                "column": "password_reset_throttle_touched_at",
                                "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss.SSS')}}"
                              }
                            ],
                            "wheres": {
                              "condition": "AND",
                              "rules": [
                                {
                                  "data": {
                                    "column": "id"
                                  },
                                  "operation": "=",
                                  "value": "{{account.id}}"
                                },
                                {
                                  "data": {
                                    "column": "status"
                                  },
                                  "operation": "=",
                                  "value": "active"
                                }
                              ]
                            }
                          }
                        }
                      },
                      {
                        "name": "account",
                        "module": "dbconnector",
                        "action": "single",
                        "options": {
                          "connection": "db",
                          "sql": {
                            "table": "users",
                            "columns": [
                              {
                                "column": "id"
                              },
                              {
                                "column": "username"
                              },
                              {
                                "column": "email"
                              },
                              {
                                "column": "display_name"
                              },
                              {
                                "column": "status"
                              }
                            ],
                            "wheres": {
                              "condition": "AND",
                              "rules": [
                                {
                                  "data": {
                                    "column": "id"
                                  },
                                  "operation": "=",
                                  "value": "{{account.id}}"
                                }
                              ]
                            }
                          }
                        }
                      },
                      {
                        "name": "recent_request_count",
                        "module": "dbconnector",
                        "action": "count",
                        "options": {
                          "connection": "db",
                          "sql": {
                            "table": "password_reset_requests",
                            "wheres": {
                              "condition": "AND",
                              "rules": [
                                {
                                  "data": {
                                    "column": "user_id"
                                  },
                                  "operation": "=",
                                  "value": "{{account.id}}"
                                },
                                {
                                  "data": {
                                    "column": "created_at"
                                  },
                                  "operation": ">",
                                  "value": "{{'now'.dateAdd('minutes', -15).formatDate('yyyy-MM-dd HH:mm:ss')}}"
                                }
                              ]
                            }
                          }
                        }
                      },
                      {
                        "module": "core",
                        "action": "condition",
                        "options": {
                          "if": "{{account.status == 'active' && ($_PARAM.actor_id || recent_request_count < 3)}}",
                          "then": {
                            "steps": [
                              {
                                "name": "invalidate_older_requests",
                                "module": "dbupdater",
                                "action": "update",
                                "options": {
                                  "connection": "db",
                                  "sql": {
                                    "table": "password_reset_requests",
                                    "values": [
                                      {
                                        "column": "invalidated_at",
                                        "value": "{{NOW}}"
                                      }
                                    ],
                                    "wheres": {
                                      "condition": "AND",
                                      "rules": [
                                        {
                                          "data": {
                                            "column": "user_id"
                                          },
                                          "operation": "=",
                                          "value": "{{account.id}}"
                                        },
                                        {
                                          "data": {
                                            "column": "used_at"
                                          },
                                          "operator": "is_null"
                                        },
                                        {
                                          "data": {
                                            "column": "invalidated_at"
                                          },
                                          "operator": "is_null"
                                        }
                                      ]
                                    }
                                  }
                                }
                              },
                              {
                                "name": "insert_reset_request",
                                "module": "dbupdater",
                                "action": "insert",
                                "options": {
                                  "connection": "db",
                                  "sql": {
                                    "table": "password_reset_requests",
                                    "values": [
                                      {
                                        "column": "request_id",
                                        "value": "{{reset_request_id}}"
                                      },
                                      {
                                        "column": "user_id",
                                        "value": "{{account.id}}"
                                      },
                                      {
                                        "column": "token_hash",
                                        "value": "{{reset_secret_hash}}"
                                      },
                                      {
                                        "column": "email_snapshot",
                                        "value": "{{account.email}}"
                                      },
                                      {
                                        "column": "expires_at",
                                        "value": "{{'now'.dateAdd('minutes', 15).formatDate('yyyy-MM-dd HH:mm:ss')}}"
                                      },
                                      {
                                        "column": "purpose",
                                        "value": "{{$_PARAM.purpose == 'ACCOUNT_SETUP' ? 'ACCOUNT_SETUP' : 'PASSWORD_RESET'}}"
                                      }
                                    ]
                                  }
                                }
                              },
                              {
                                "module": "core",
                                "action": "setvalue",
                                "options": {
                                  "key": "reset_issued",
                                  "value": true
                                }
                              }
                            ]
                          }
                        }
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{($_PARAM.user_id || (identifier.length() > 0 && identifier.length() <= 254)) && account.id && account.status == 'active' && account.email && !reset_issued}}",
          "then": {
            "steps": [
              {
                "name": "audit_reset_rate_limited",
                "module": "dbupdater",
                "action": "insert",
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "audit_logs",
                    "values": [
                      {
                        "column": "actor_user_id",
                        "value": "{{$_PARAM.actor_id || null}}"
                      },
                      {
                        "column": "action",
                        "value": "PASSWORD_RESET_RATE_LIMITED"
                      },
                      {
                        "column": "module",
                        "value": "{{$_PARAM.actor_id ? 'user_administration' : 'security'}}"
                      },
                      {
                        "column": "entity_type",
                        "value": "user"
                      },
                      {
                        "column": "entity_id",
                        "value": "{{account.id}}"
                      },
                      {
                        "column": "description",
                        "value": "Password reset issuance was suppressed by the per-account rate limit."
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{reset_issued}}",
          "then": {
            "steps": [
              {
                "name": "audit_reset_requested",
                "module": "dbupdater",
                "action": "insert",
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "audit_logs",
                    "values": [
                      {
                        "column": "actor_user_id",
                        "value": "{{$_PARAM.actor_id || null}}"
                      },
                      {
                        "column": "action",
                        "value": "{{$_PARAM.purpose == 'ACCOUNT_SETUP' ? 'ACCOUNT_SETUP_REQUESTED' : 'PASSWORD_RESET_REQUESTED'}}"
                      },
                      {
                        "column": "module",
                        "value": "{{$_PARAM.actor_id ? 'user_administration' : 'security'}}"
                      },
                      {
                        "column": "entity_type",
                        "value": "user"
                      },
                      {
                        "column": "entity_id",
                        "value": "{{account.id}}"
                      },
                      {
                        "column": "description",
                        "value": "A secure password setup/reset email was requested for this account."
                      }
                    ]
                  }
                }
              },
              {
                "module": "core",
                "action": "trycatch",
                "options": {
                  "try": [
                    {
                      "module": "mail",
                      "action": "send",
                      "options": {
                        "instance": "mail",
                        "subject": "{{$_PARAM.purpose == 'ACCOUNT_SETUP' ? 'Your TSTT Laptop Portal account is ready' : 'Reset your TSTT Laptop Portal password'}}",
                        "fromName": "TSTT Laptop Portal",
                        "fromEmail": "no+reply@tstt.co.tt",
                        "replyTo": "no+reply@tstt.co.tt",
                        "toName": "{{account.display_name || account.email}}",
                        "toEmail": "{{account.email}}",
                        "body": "{{$_PARAM.purpose == 'ACCOUNT_SETUP' ? 'Your TSTT Laptop Portal account is ready. Use the secure link in this email to set your password. The link expires in 15 minutes.' : 'A password reset was requested for your TSTT Laptop Portal account. Use the secure link in this email to reset your password. The link expires in 15 minutes.'}}",
                        "source": "file",
                        "contentType": "html",
                        "bodyFile": "{{$_PARAM.purpose == 'ACCOUNT_SETUP' ? '/app/emails/account-setup.html' : '/app/emails/password-reset.html'}}",
                        "embedImages": false
                      }
                    },
                    {
                      "name": "mark_email_sent",
                      "module": "dbupdater",
                      "action": "update",
                      "options": {
                        "connection": "db",
                        "sql": {
                          "table": "password_reset_requests",
                          "values": [
                            {
                              "column": "email_sent_at",
                              "value": "{{NOW}}"
                            }
                          ],
                          "wheres": {
                            "condition": "AND",
                            "rules": [
                              {
                                "data": {
                                  "column": "request_id"
                                },
                                "operation": "=",
                                "value": "{{reset_request_id}}"
                              }
                            ]
                          }
                        }
                      }
                    },
                    {
                      "name": "audit_reset_email_sent",
                      "module": "dbupdater",
                      "action": "insert",
                      "options": {
                        "connection": "db",
                        "sql": {
                          "table": "audit_logs",
                          "values": [
                            {
                              "column": "actor_user_id",
                              "value": "{{$_PARAM.actor_id || null}}"
                            },
                            {
                              "column": "action",
                              "value": "{{$_PARAM.purpose == 'ACCOUNT_SETUP' ? 'ACCOUNT_SETUP_EMAIL_SENT' : ($_PARAM.actor_id ? 'ADMIN_PASSWORD_RESET_EMAIL_SENT' : 'PASSWORD_RESET_EMAIL_SENT')}}"
                            },
                            {
                              "column": "module",
                              "value": "{{$_PARAM.actor_id ? 'user_administration' : 'security'}}"
                            },
                            {
                              "column": "entity_type",
                              "value": "user"
                            },
                            {
                              "column": "entity_id",
                              "value": "{{account.id}}"
                            },
                            {
                              "column": "description",
                              "value": "A secure password setup/reset email was accepted by Wappler Mailer."
                            }
                          ]
                        }
                      }
                    },
                    {
                      "module": "core",
                      "action": "setvalue",
                      "options": {
                        "key": "sent",
                        "value": true
                      },
                      "name": "sent"
                    }
                  ],
                  "catch": [
                    {
                      "name": "audit_reset_email_failed",
                      "module": "dbupdater",
                      "action": "insert",
                      "options": {
                        "connection": "db",
                        "sql": {
                          "table": "audit_logs",
                          "values": [
                            {
                              "column": "actor_user_id",
                              "value": "{{$_PARAM.actor_id || null}}"
                            },
                            {
                              "column": "action",
                              "value": "{{$_PARAM.purpose == 'ACCOUNT_SETUP' ? 'ACCOUNT_SETUP_EMAIL_FAILED' : ($_PARAM.actor_id ? 'ADMIN_PASSWORD_RESET_EMAIL_FAILED' : 'PASSWORD_RESET_EMAIL_FAILED')}}"
                            },
                            {
                              "column": "module",
                              "value": "{{$_PARAM.actor_id ? 'user_administration' : 'security'}}"
                            },
                            {
                              "column": "entity_type",
                              "value": "user"
                            },
                            {
                              "column": "entity_id",
                              "value": "{{account.id}}"
                            },
                            {
                              "column": "description",
                              "value": "Password email delivery failed. The administrator may retry."
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      {
        "module": "core",
        "action": "setvalue",
        "options": {
          "key": "sent",
          "value": "{{sent}}"
        },
        "name": "sent",
        "output": true
      }
    ],
    "catch": [
      {
        "module": "core",
        "action": "setvalue",
        "options": {
          "key": "sent",
          "value": false
        },
        "name": "sent",
        "output": true
      }
    ]
  },
  "meta": {
    "$_PARAM": [
      {
        "name": "identifier",
        "type": "text"
      },
      {
        "name": "user_id",
        "type": "text"
      },
      {
        "name": "actor_id",
        "type": "text"
      },
      {
        "name": "purpose",
        "type": "text"
      }
    ]
  }
}
