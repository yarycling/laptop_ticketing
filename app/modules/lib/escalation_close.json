{
  "exec": { "steps": [
    { "name": "case", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "escalation_cases", "columns": [{ "column": "id" }, { "column": "current_state_code" }, { "column": "current_level" }, { "column": "current_trigger" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "sla_instance_id" }, "operation": "=", "value": "{{$_PARAM.sla_instance_id}}" }, { "condition": "OR", "rules": [{ "data": { "column": "current_state_code" }, "operation": "=", "value": "OPEN" }, { "data": { "column": "current_state_code" }, "operation": "=", "value": "ACKNOWLEDGED" }] }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{case.id && ['RESOLVED','CANCELLED'].contains($_PARAM.terminal_code)}}", "then": { "steps": [
      { "name": "close_case", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "escalation_cases", "values": [{ "column": "current_state_code", "value": "{{$_PARAM.terminal_code}}" }, { "column": "resolved_at", "value": "{{$_PARAM.terminal_code == 'RESOLVED' ? $_PARAM.event_at : null}}" }, { "column": "cancelled_at", "value": "{{$_PARAM.terminal_code == 'CANCELLED' ? $_PARAM.event_at : null}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{case.id}}" }, { "condition": "OR", "rules": [{ "data": { "column": "current_state_code" }, "operation": "=", "value": "OPEN" }, { "data": { "column": "current_state_code" }, "operation": "=", "value": "ACKNOWLEDGED" }] }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{close_case.affected == 1}}", "then": { "steps": [
        { "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "escalation_history", "values": [{ "column": "escalation_case_id", "value": "{{case.id}}" }, { "column": "event_code", "value": "{{$_PARAM.terminal_code}}" }, { "column": "event_key", "value": "{{'SLA:' + $_PARAM.sla_instance_id + ':' + $_PARAM.terminal_code}}" }, { "column": "old_state_code", "value": "{{case.current_state_code}}" }, { "column": "new_state_code", "value": "{{$_PARAM.terminal_code}}" }, { "column": "old_level", "value": "{{case.current_level}}" }, { "column": "new_level", "value": "{{case.current_level}}" }, { "column": "trigger_code", "value": "{{case.current_trigger}}" }, { "column": "source_sla_event_id", "value": "{{$_PARAM.sla_event_id || null}}" }, { "column": "actor_user_id", "value": "{{$_PARAM.actor_user_id || null}}" }, { "column": "event_at", "value": "{{$_PARAM.event_at}}" }, { "column": "notes", "value": "{{$_PARAM.notes || null}}" }] } } },
        { "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{$_PARAM.actor_user_id || null}}" }, { "column": "action", "value": "{{$_PARAM.terminal_code == 'RESOLVED' ? 'escalation_resolved' : 'escalation_cancelled'}}" }, { "column": "module", "value": "escalations" }, { "column": "entity_type", "value": "escalation_case" }, { "column": "entity_id", "value": "{{case.id}}" }, { "column": "description", "value": "{{$_PARAM.terminal_code == 'RESOLVED' ? 'Escalation ' + case.id + ' resolved by SLA workflow.' : 'Escalation ' + case.id + ' cancelled by SLA workflow.'}}" }] } } }
      ] } } }
    ] } } }
  ] }
}
