{
  "exec": {
    "steps": [
      { "name": "delivery", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "notification_deliveries", "columns": [{ "column": "id" }, { "column": "delivery_number" }, { "column": "recipient_address" }, { "column": "recipient_name" }, { "column": "subject_snapshot" }, { "column": "body_text_snapshot" }, { "column": "status_code" }, { "column": "attempt_count" }, { "column": "max_attempts" }, { "column": "next_attempt_at" }, { "column": "notification_event_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{$_PARAM.delivery_id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!delivery.id || !delivery.recipient_address || delivery.status_code == 'SENT' || delivery.status_code == 'FAILED_PERMANENT' || delivery.status_code == 'SKIPPED_NO_ADDRESS' || delivery.status_code == 'SKIPPED_INVALID_ADDRESS' || delivery.status_code == 'PROCESSING' || (delivery.status_code == 'RETRY_PENDING' && (!delivery.next_attempt_at || delivery.next_attempt_at > 'now'.formatDate('yyyy-MM-dd HH:mm:ss')))}}", "then": { "steps": [{ "name": "not_claimed", "module": "core", "action": "setvalue", "output": true, "options": { "key": "email_send_claimed", "value": false } }] } } },
      { "name": "claim_token", "module": "core", "action": "setvalue", "output": true, "options": { "key": "claim_token", "value": "{{'EML:' + delivery.id + ':' + 'now'.formatDate('yyyyMMddHHmmss') + ':' + ($_PARAM.actor_user_id || 'SYSTEM')}}" } },
      { "name": "claim_pending", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "notification_deliveries", "values": [{ "column": "status_code", "value": "PROCESSING" }, { "column": "processing_started_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss')}}" }, { "column": "processing_token", "value": "{{claim_token}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{delivery.id}}" }, { "data": { "column": "status_code" }, "operation": "=", "value": "PENDING" }] } } } },
      { "name": "claim_retry", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "notification_deliveries", "values": [{ "column": "status_code", "value": "PROCESSING" }, { "column": "processing_started_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss')}}" }, { "column": "processing_token", "value": "{{claim_token}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{delivery.id}}" }, { "data": { "column": "status_code" }, "operation": "=", "value": "RETRY_PENDING" }, { "data": { "column": "next_attempt_at" }, "operation": "<=", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss')}}" }] } } } },
      { "name": "claim_success", "module": "core", "action": "setvalue", "output": true, "options": { "key": "claim_success", "value": "{{claim_pending.affected == 1 || claim_retry.affected == 1}}" } },
      { "module": "core", "action": "condition", "options": { "if": "{{claim_success}}", "then": { "steps": [
        { "name": "send_mail", "module": "mail", "action": "send", "output": true, "options": { "instance": "mail", "subject": "{{delivery.subject_snapshot}}", "fromName": "TSTT Laptop Portal", "fromEmail": "no+reply@tstt.co.tt", "replyTo": "no+reply@tstt.co.tt", "toName": "{{delivery.recipient_name || delivery.recipient_address}}", "toEmail": "{{delivery.recipient_address}}", "body": "{{delivery.body_text_snapshot}}", "source": "file", "contentType": "html", "bodyFile": "/app/emails/notification.html", "embedImages": false } },
        { "name": "attempt_success", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "notification_delivery_attempts", "values": [{ "column": "notification_delivery_id", "value": "{{delivery.id}}" }, { "column": "attempt_number", "value": "{{delivery.attempt_count + 1}}" }, { "column": "outcome_code", "value": "SENT" }] } } },
        { "name": "mark_sent", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "notification_deliveries", "values": [{ "column": "status_code", "value": "SENT" }, { "column": "attempt_count", "value": "{{delivery.attempt_count + 1}}" }, { "column": "last_attempt_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss.SSS')}}" }, { "column": "sent_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss.SSS')}}" }, { "column": "next_attempt_at", "value": null }, { "column": "processing_started_at", "value": null }, { "column": "processing_token", "value": null }, { "column": "last_error_code", "value": null }, { "column": "last_error_message", "value": null }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{delivery.id}}" }, { "data": { "column": "status_code" }, "operation": "=", "value": "PROCESSING" }, { "data": { "column": "processing_token" }, "operation": "=", "value": "{{claim_token}}" }] } } } },
        { "module": "core", "action": "exec", "options": { "exec": "notification_email_audit", "params": { "delivery_id": "{{delivery.id}}", "actor_user_id": "{{$_PARAM.actor_user_id || null}}", "action": "EMAIL_DELIVERY_SENT", "description": "Notification email delivery was accepted by the configured Wappler Mailer." } } }
      ] } } }
      ,{ "name": "send_claim_result", "module": "core", "action": "setvalue", "output": true, "options": { "key": "email_send_claimed", "value": "{{claim_success}}" } }
    ],
    "catch": [
      { "module": "core", "action": "condition", "options": { "if": "{{claim_success}}", "then": { "steps": [
        { "name": "failure_terminal", "module": "core", "action": "setvalue", "output": true, "options": { "key": "failure_terminal", "value": "{{delivery.attempt_count + 1 >= delivery.max_attempts}}" } },
        { "name": "attempt_failure", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "notification_delivery_attempts", "values": [{ "column": "notification_delivery_id", "value": "{{delivery.id}}" }, { "column": "attempt_number", "value": "{{delivery.attempt_count + 1}}" }, { "column": "outcome_code", "value": "{{failure_terminal ? 'FAILED_PERMANENT' : 'RETRY_PENDING'}}" }, { "column": "error_code", "value": "MAIL_SEND_FAILED" }, { "column": "error_message", "value": "The configured Wappler Mailer did not complete the send operation." }] } } },
        { "name": "mark_failed_or_retry", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "notification_deliveries", "values": [{ "column": "status_code", "value": "{{failure_terminal ? 'FAILED_PERMANENT' : 'RETRY_PENDING'}}" }, { "column": "attempt_count", "value": "{{delivery.attempt_count + 1}}" }, { "column": "last_attempt_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss.SSS')}}" }, { "column": "next_attempt_at", "value": "{{failure_terminal ? null : 'now'.dateAdd('minutes', delivery.attempt_count == 0 ? 5 : 30).formatDate('yyyy-MM-dd HH:mm:ss.SSS')}}" }, { "column": "processing_started_at", "value": null }, { "column": "processing_token", "value": null }, { "column": "last_error_code", "value": "MAIL_SEND_FAILED" }, { "column": "last_error_message", "value": "The configured Wappler Mailer did not complete the send operation." }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{delivery.id}}" }, { "data": { "column": "status_code" }, "operation": "=", "value": "PROCESSING" }, { "data": { "column": "processing_token" }, "operation": "=", "value": "{{claim_token}}" }] } } } },
        { "module": "core", "action": "exec", "options": { "exec": "notification_email_audit", "params": { "delivery_id": "{{delivery.id}}", "actor_user_id": "{{$_PARAM.actor_user_id || null}}", "action": "{{failure_terminal ? 'EMAIL_DELIVERY_FAILED_PERMANENT' : 'EMAIL_DELIVERY_RETRY_SCHEDULED'}}", "description": "Notification email attempt failed; a bounded retry was scheduled or the delivery reached its retry limit." } } }
      ] } } },
      { "name": "contained_mail_failure", "module": "core", "action": "setvalue", "output": true, "options": { "key": "email_send_failed", "value": true } }
    ]
  }
}
