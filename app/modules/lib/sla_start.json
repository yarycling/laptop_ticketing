{
  "exec": {
    "steps": [
      { "module": "core", "action": "condition", "options": { "if": "{{!$_PARAM.policy_code || !$_PARAM.idempotency_key || !$_PARAM.ticket_id || !$_PARAM.started_at || !$_PARAM.source_workflow || !$_PARAM.source_entity_type || !$_PARAM.source_entity_id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "SLA_START_PARAMETERS" } }] } } },
      { "name": "existing", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "sla_instances", "columns": [{ "column": "id" }, { "column": "current_state_code" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "idempotency_key" }, "operation": "=", "value": "{{$_PARAM.idempotency_key}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!existing.id}}", "then": { "steps": [
        { "name": "policy", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_sla_policy_current", "columns": [{ "column": "policy_id" }, { "column": "policy_code" }, { "column": "policy_version_id" }, { "column": "target_business_days" }, { "column": "calendar_id" }, { "column": "status" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "policy_code" }, "operation": "=", "value": "{{$_PARAM.policy_code}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
        { "name": "target_days", "module": "core", "action": "setvalue", "output": true, "options": { "key": "target_days", "value": "{{policy.target_business_days * 1}}" } },
        { "name": "calendar", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "sla_calendars", "columns": [{ "column": "id" }, { "column": "timezone_name" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{policy.calendar_id}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
        { "name": "due_dates", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": "v_sla_calendar_business_dates", "columns": [{ "column": "calendar_id" }, { "column": "calendar_date" }, { "column": "business_due_at" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "calendar_id" }, "operation": "=", "value": "{{policy.calendar_id}}" }, { "data": { "column": "is_business_day" }, "operation": "=", "value": 1 }, { "data": { "column": "calendar_date" }, "operation": ">=", "value": "{{$_PARAM.started_at.substr(0, 10)}}" }] }, "orders": [{ "column": "calendar_date", "direction": "asc" }], "limit": "{{target_days}}" } } },
        { "module": "core", "action": "condition", "options": { "if": "{{!policy.policy_id || !calendar.id || !target_days || due_dates.length < target_days || target_days != floor(target_days)}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "SLA_START_CONFIGURATION" } }] } } },
        { "name": "instance", "module": "dbupdater", "action": "insert", "output": true, "options": { "connection": "db", "sql": { "table": "sla_instances", "values": [
          { "column": "idempotency_key", "value": "{{$_PARAM.idempotency_key}}" }, { "column": "policy_id", "value": "{{policy.policy_id}}" }, { "column": "policy_version_id", "value": "{{policy.policy_version_id}}" }, { "column": "policy_code_snapshot", "value": "{{policy.policy_code}}" }, { "column": "target_business_days_snapshot", "value": "{{target_days}}" }, { "column": "calendar_id", "value": "{{policy.calendar_id}}" }, { "column": "ticket_id", "value": "{{$_PARAM.ticket_id}}" }, { "column": "logistics_case_id", "value": "{{$_PARAM.logistics_case_id || null}}" }, { "column": "repair_job_id", "value": "{{$_PARAM.repair_job_id || null}}" }, { "column": "device_id", "value": "{{$_PARAM.device_id || null}}" }, { "column": "effective_device_id", "value": "{{$_PARAM.effective_device_id || null}}" }, { "column": "source_workflow", "value": "{{$_PARAM.source_workflow}}" }, { "column": "source_entity_type", "value": "{{$_PARAM.source_entity_type}}" }, { "column": "source_entity_id", "value": "{{$_PARAM.source_entity_id}}" }, { "column": "current_state_code", "value": "ACTIVE" }, { "column": "started_at", "value": "{{$_PARAM.started_at}}" }, { "column": "due_at", "value": "{{due_dates.last().business_due_at}}" }, { "column": "started_by_user_id", "value": "{{$_PARAM.actor_user_id || null}}" }
        ] } } },
        { "name": "started_event", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "sla_instance_events", "values": [{ "column": "sla_instance_id", "value": "{{instance.identity}}" }, { "column": "event_code", "value": "STARTED" }, { "column": "from_state_code", "value": "PENDING" }, { "column": "to_state_code", "value": "ACTIVE" }, { "column": "event_at", "value": "{{$_PARAM.started_at}}" }, { "column": "source_entity_type", "value": "{{$_PARAM.source_entity_type}}" }, { "column": "source_entity_id", "value": "{{$_PARAM.source_entity_id}}" }, { "column": "actor_user_id", "value": "{{$_PARAM.actor_user_id || null}}" }] } } },
        { "name": "started_audit", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{$_PARAM.actor_user_id || null}}" }, { "column": "action", "value": "sla_started" }, { "column": "module", "value": "sla" }, { "column": "entity_type", "value": "sla_instance" }, { "column": "entity_id", "value": "{{instance.identity}}" }, { "column": "description", "value": "{{'Started ' + policy.policy_code + ' SLA for ticket ' + $_PARAM.ticket_number}}" }] } } }
      ] } } },
      { "name": "result", "module": "core", "action": "setvalue", "output": true, "options": { "key": "sla_start_result", "value": "{{existing.id || instance.identity || null}}" } }
    ]
  }
}
