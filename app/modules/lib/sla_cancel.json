{
  "exec": {
    "steps": [
      { "name": "instance", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "sla_instances", "columns": [{ "column": "id" }, { "column": "current_state_code" }, { "column": "policy_code_snapshot" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "idempotency_key" }, "operation": "=", "value": "{{$_PARAM.idempotency_key}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{instance.id && ['ACTIVE','AT_RISK','BREACHED'].contains(instance.current_state_code)}}", "then": { "steps": [
        { "name": "cancellation_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
          { "name": "cancel_instance", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "sla_instances", "values": [{ "column": "current_state_code", "value": "CANCELLED" }, { "column": "cancelled_at", "value": "{{$_PARAM.cancelled_at}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{instance.id}}" }, { "condition": "OR", "rules": [{ "data": { "column": "current_state_code" }, "operation": "=", "value": "ACTIVE" }, { "data": { "column": "current_state_code" }, "operation": "=", "value": "AT_RISK" }, { "data": { "column": "current_state_code" }, "operation": "=", "value": "BREACHED" }] }] } } } },
          { "module": "core", "action": "condition", "options": { "if": "{{cancel_instance.affected == 1}}", "then": { "steps": [
            { "name": "cancelled_event", "module": "dbupdater", "action": "insert", "output": true, "options": { "connection": "db", "sql": { "table": "sla_instance_events", "values": [{ "column": "sla_instance_id", "value": "{{instance.id}}" }, { "column": "event_code", "value": "CANCELLED" }, { "column": "from_state_code", "value": "{{instance.current_state_code}}" }, { "column": "to_state_code", "value": "CANCELLED" }, { "column": "event_at", "value": "{{$_PARAM.cancelled_at}}" }, { "column": "source_entity_type", "value": "{{$_PARAM.source_entity_type}}" }, { "column": "source_entity_id", "value": "{{$_PARAM.source_entity_id}}" }, { "column": "actor_user_id", "value": "{{$_PARAM.actor_user_id || null}}" }, { "column": "notes", "value": "{{$_PARAM.reason || null}}" }] } } },
            { "name": "cancel_escalation", "module": "core", "action": "exec", "output": true, "options": { "exec": "escalation_close", "params": { "sla_instance_id": "{{instance.id}}", "sla_event_id": "{{cancelled_event.identity}}", "terminal_code": "CANCELLED", "event_at": "{{$_PARAM.cancelled_at}}", "source_entity_type": "{{$_PARAM.source_entity_type}}", "source_entity_id": "{{$_PARAM.source_entity_id}}", "actor_user_id": "{{$_PARAM.actor_user_id || null}}", "notes": "{{$_PARAM.reason || 'Underlying SLA cancelled.'}}" } } },
            { "name": "cancelled_audit", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{$_PARAM.actor_user_id || null}}" }, { "column": "action", "value": "sla_cancelled" }, { "column": "module", "value": "sla" }, { "column": "entity_type", "value": "sla_instance" }, { "column": "entity_id", "value": "{{instance.id}}" }, { "column": "description", "value": "{{'Cancelled ' + instance.policy_code_snapshot + ' SLA: ' + ($_PARAM.reason || 'workflow no longer applies')}}" }] } } }
          ] } } }
        ] } } }
      ] } } },
      { "name": "cancelled_escalation", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "escalation_cases", "columns": [{ "column": "id" }, { "column": "current_state_code" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "sla_instance_id" }, "operation": "=", "value": "{{instance.id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{cancelled_escalation.current_state_code == 'CANCELLED'}}", "then": { "steps": [{ "name": "cancellation_notification", "module": "core", "action": "exec", "output": true, "options": { "exec": "notification_from_escalation", "params": { "escalation_case_id": "{{cancelled_escalation.id}}", "event_type_code": "ESCALATION_CANCELLED", "actor_user_id": "{{$_PARAM.actor_user_id || null}}" } } }] } } }
    ]
  }
}
