{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "meta": { "$_GET": [{ "name": "id", "type": "number" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "escalations.view" } } },
    { "name": "scope_context", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_get_scope_context", "params": {} } },
    { "name": "ttpost_role", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "user_roles", "alias": "ur" }, "columns": [{ "table": "r", "column": "name", "alias": "role_name" }], "joins": [{ "table": "roles", "alias": "r", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "r", "column": "id", "operation": "=", "value": { "table": "ur", "column": "role_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "ur", "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "table": "r", "column": "name" }, "operation": "=", "value": "TTPOST_LOGISTICS" }] } } } },
    { "name": "case", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_escalation_operational_queue", "columns": [{ "column": "escalation_case_id" }, { "column": "escalation_number" }, { "column": "sla_instance_id" }, { "column": "policy_code_snapshot" }, { "column": "ticket_id" }, { "column": "ticket_number" }, { "column": "logistics_case_id" }, { "column": "logistics_number" }, { "column": "repair_job_id" }, { "column": "district_id" }, { "column": "district_name" }, { "column": "school_id" }, { "column": "school_name" }, { "column": "repair_centre_location_id" }, { "column": "repair_centre_name" }, { "column": "current_level" }, { "column": "current_trigger" }, { "column": "current_state_code" }, { "column": "current_state_name" }, { "column": "reason_snapshot" }, { "column": "opened_at" }, { "column": "opened_at_display" }, { "column": "acknowledged_at" }, { "column": "acknowledged_at_display" }, { "column": "acknowledged_by_name" }, { "column": "acknowledgement_note" }, { "column": "resolved_at" }, { "column": "resolved_at_display" }, { "column": "cancelled_at" }, { "column": "cancelled_at_display" }, { "column": "sla_state_code" }, { "column": "sla_state_name" }, { "column": "sla_started_at" }, { "column": "sla_started_at_display" }, { "column": "sla_due_at" }, { "column": "sla_due_at_display" }, { "column": "sla_at_risk_at" }, { "column": "sla_breached_at" }, { "column": "sla_completed_at" }, { "column": "responsible_roles"}], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "escalation_case_id" }, "operation": "=", "value": "{{$_GET.id}}" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!case.escalation_case_id || (permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && ttpost_role.role_name != 'TTPOST_LOGISTICS' && !scope_context.districts.flatten('id').contains(case.district_id) && !scope_context.schools.flatten('id').contains(case.school_id) && !scope_context.service_locations.flatten('id').contains(case.repair_centre_location_id))}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Escalation was not found." } } }] } } },
    { "name": "assignments", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": "escalation_assignments", "columns": [{ "column": "level_snapshot" }, { "column": "trigger_snapshot" }, { "column": "target_role_name_snapshot" }, { "column": "reason_snapshot" }, { "column": "assigned_at" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "escalation_case_id" }, "operation": "=", "value": "{{case.escalation_case_id}}" }] }, "orders": [{ "column": "level_snapshot", "direction": "asc" }, { "column": "assigned_at", "direction": "asc" }] } } },
    { "name": "history", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "escalation_history", "alias": "h" }, "columns": [{ "table": "h", "column": "event_code" }, { "table": "h", "column": "old_state_code" }, { "table": "h", "column": "new_state_code" }, { "table": "h", "column": "old_level" }, { "table": "h", "column": "new_level" }, { "table": "h", "column": "trigger_code" }, { "table": "h", "column": "event_at" }, { "table": "h", "column": "notes" }, { "table": "u", "column": "display_name", "alias": "actor_name" }], "joins": [{ "table": "users", "alias": "u", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "u", "column": "id", "operation": "=", "value": { "table": "h", "column": "actor_user_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "h", "column": "escalation_case_id" }, "operation": "=", "value": "{{case.escalation_case_id}}" }] }, "orders": [{ "table": "h", "column": "event_at", "direction": "asc" }, { "table": "h", "column": "id", "direction": "asc" }] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "escalation": "{{case}}", "assignments": "{{assignments}}", "history": "{{history}}" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Escalation detail could not be loaded." } } }] }
}
