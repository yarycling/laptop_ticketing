{
  "settings": { "options": { "method": "post", "nocsrf": true } },
  "meta": { "$_POST": [{ "name": "escalation_case_id", "type": "number" }, { "name": "acknowledgement_note", "type": "text" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "escalations.respond" } } },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "name": "scope_context", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_get_scope_context", "params": {} } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.escalation_case_id || $_POST.escalation_case_id < 1 || ($_POST.acknowledgement_note && $_POST.acknowledgement_note.length > 500)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Provide a valid escalation and a note no longer than 500 characters." } } }] } } },
    { "name": "case", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "escalation_cases", "columns": [{ "column": "id" }, { "column": "sla_instance_id" }, { "column": "current_state_code" }, { "column": "current_level" }, { "column": "current_trigger" }, { "column": "district_id" }, { "column": "school_id" }, { "column": "repair_centre_location_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{$_POST.escalation_case_id}}" }] } } } },
    { "name": "target_role", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "escalation_assignments", "alias": "a" }, "columns": [{ "table": "r", "column": "name", "alias": "role_name" }], "joins": [{ "table": "roles", "alias": "r", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "r", "column": "id", "operation": "=", "value": { "table": "a", "column": "target_role_id" } }] } }, { "table": "user_roles", "alias": "ur", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ur", "column": "role_id", "operation": "=", "value": { "table": "r", "column": "id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "a", "column": "escalation_case_id" }, "operation": "=", "value": "{{case.id}}" }, { "data": { "table": "a", "column": "level_snapshot" }, "operation": "=", "value": "{{case.current_level}}" }, { "data": { "table": "ur", "column": "user_id" }, "operation": "=", "value": "{{identity}}" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!case.id || (permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && (!target_role.role_name || (target_role.role_name != 'TTPOST_LOGISTICS' && !scope_context.districts.flatten('id').contains(case.district_id) && !scope_context.schools.flatten('id').contains(case.school_id) && !scope_context.service_locations.flatten('id').contains(case.repair_centre_location_id))))}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "You are not authorized for this escalation target or scope." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{case.current_state_code != 'OPEN'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "This escalation is no longer open. Reload the queue." } } }] } } },
    { "name": "ack_at", "module": "core", "action": "setvalue", "output": true, "options": { "key": "ack_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss')}}" } },
    { "name": "ack_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "update_case", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "escalation_cases", "values": [{ "column": "current_state_code", "value": "ACKNOWLEDGED" }, { "column": "acknowledged_at", "value": "{{ack_at}}" }, { "column": "acknowledged_by", "value": "{{identity}}" }, { "column": "acknowledgement_note", "value": "{{($_POST.acknowledgement_note || '').trim() || null}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{case.id}}" }, { "data": { "column": "current_state_code" }, "operation": "=", "value": "OPEN" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{update_case.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "ESCALATION_ACK_CONFLICT" } }] } } },
      { "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "escalation_history", "values": [{ "column": "escalation_case_id", "value": "{{case.id}}" }, { "column": "event_code", "value": "ACKNOWLEDGED" }, { "column": "event_key", "value": "{{'ESC:' + case.id + ':ACKNOWLEDGED'}}" }, { "column": "old_state_code", "value": "OPEN" }, { "column": "new_state_code", "value": "ACKNOWLEDGED" }, { "column": "old_level", "value": "{{case.current_level}}" }, { "column": "new_level", "value": "{{case.current_level}}" }, { "column": "trigger_code", "value": "{{case.current_trigger}}" }, { "column": "actor_user_id", "value": "{{identity}}" }, { "column": "event_at", "value": "{{ack_at}}" }, { "column": "notes", "value": "{{($_POST.acknowledgement_note || '').trim() || null}}" }] } } },
      { "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "escalation_acknowledged" }, { "column": "module", "value": "escalations" }, { "column": "entity_type", "value": "escalation_case" }, { "column": "entity_id", "value": "{{case.id}}" }, { "column": "description", "value": "{{'Acknowledged escalation ' + case.id + ' at level ' + case.current_level}}" }] } } }
    ] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "escalation_case_id": "{{case.id}}", "current_state_code": "ACKNOWLEDGED", "current_level": "{{case.current_level}}", "acknowledged_at": "{{ack_at}}" } } }
  ], "catch": [{ "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'ESCALATION_ACK_CONFLICT'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "This escalation is no longer open. Reload the queue." } } }] } } }, { "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Escalation acknowledgement could not be recorded." } } }] }
}
