{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "meta": { "$_GET": [{ "name": "state", "type": "text" }, { "name": "level", "type": "number" }, { "name": "trigger", "type": "text" }, { "name": "policy", "type": "text" }, { "name": "responsible_role", "type": "text" }, { "name": "district_id", "type": "number" }, { "name": "school_id", "type": "number" }, { "name": "ticket_number", "type": "text" }, { "name": "page", "type": "number" }, { "name": "page_size", "type": "number" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "escalations.view" } } },
    { "name": "scope_context", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_get_scope_context", "params": {} } },
    { "name": "ttpost_role", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "user_roles", "alias": "ur" }, "columns": [{ "table": "r", "column": "name", "alias": "role_name" }], "joins": [{ "table": "roles", "alias": "r", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "r", "column": "id", "operation": "=", "value": { "table": "ur", "column": "role_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "ur", "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "table": "r", "column": "name" }, "operation": "=", "value": "TTPOST_LOGISTICS" }] } } } },
    { "name": "repair_role", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "user_roles", "alias": "ur" }, "columns": [{ "table": "r", "column": "name", "alias": "role_name" }], "joins": [{ "table": "roles", "alias": "r", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "r", "column": "id", "operation": "=", "value": { "table": "ur", "column": "role_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "ur", "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "table": "r", "column": "name" }, "operation": "=", "value": "REPAIR_CENTRE" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_GET.state && !['ALL','OPEN','ACKNOWLEDGED','RESOLVED','CANCELLED'].contains($_GET.state)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Choose a valid escalation state." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_GET.level && ![1,2].contains($_GET.level * 1)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Choose level 1 or 2." } } }] } } },
    { "name": "page", "module": "core", "action": "setvalue", "options": { "key": "page", "value": "{{$_GET.page || 1}}" } },
    { "name": "page_size", "module": "core", "action": "setvalue", "options": { "key": "page_size", "value": "{{$_GET.page_size || 25}}" } },
    { "name": "rows", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": "v_escalation_operational_queue", "columns": [{ "column": "escalation_case_id" }, { "column": "escalation_number" }, { "column": "sla_instance_id" }, { "column": "policy_code_snapshot" }, { "column": "ticket_id" }, { "column": "ticket_number" }, { "column": "logistics_case_id" }, { "column": "logistics_number" }, { "column": "district_id" }, { "column": "district_name" }, { "column": "school_id" }, { "column": "school_name" }, { "column": "repair_centre_location_id" }, { "column": "repair_centre_name" }, { "column": "current_level" }, { "column": "current_trigger" }, { "column": "current_state_code" }, { "column": "current_state_name" }, { "column": "responsible_roles" }, { "column": "opened_at" }, { "column": "opened_at_display" }, { "column": "acknowledged_at" }, { "column": "sla_state_code" }, { "column": "sla_state_name" }, { "column": "sla_due_at" }, { "column": "sla_due_at_display" }], "wheres": { "condition": "AND", "rules": [
      { "condition": "AND", "conditional": "{{$_GET.state && $_GET.state != 'ALL'}}", "rules": [{ "data": { "column": "current_state_code" }, "operation": "=", "value": "{{$_GET.state}}" }] },
      { "condition": "AND", "conditional": "{{$_GET.level}}", "rules": [{ "data": { "column": "current_level" }, "operation": "=", "value": "{{$_GET.level}}" }] },
      { "condition": "AND", "conditional": "{{$_GET.trigger && $_GET.trigger != 'ALL'}}", "rules": [{ "data": { "column": "current_trigger" }, "operation": "=", "value": "{{$_GET.trigger}}" }] },
      { "condition": "AND", "conditional": "{{$_GET.policy && $_GET.policy != 'ALL'}}", "rules": [{ "data": { "column": "policy_code_snapshot" }, "operation": "=", "value": "{{$_GET.policy}}" }] },
      { "condition": "AND", "conditional": "{{$_GET.responsible_role && $_GET.responsible_role != 'ALL'}}", "rules": [{ "data": { "column": "responsible_roles" }, "operator": "contains", "value": "{{$_GET.responsible_role}}" }] },
      { "condition": "AND", "conditional": "{{$_GET.district_id}}", "rules": [{ "data": { "column": "district_id" }, "operation": "=", "value": "{{$_GET.district_id}}" }] },
      { "condition": "AND", "conditional": "{{$_GET.school_id}}", "rules": [{ "data": { "column": "school_id" }, "operation": "=", "value": "{{$_GET.school_id}}" }] },
      { "condition": "AND", "conditional": "{{$_GET.ticket_number}}", "rules": [{ "data": { "column": "ticket_number" }, "operator": "contains", "value": "{{$_GET.ticket_number}}" }] },
      { "condition": "OR", "rules": [
        { "condition": "AND", "conditional": "{{permission.bypass == 'SUPER_ADMIN' || scope_context.has_national_scope || ttpost_role.role_name == 'TTPOST_LOGISTICS'}}", "rules": [{ "data": { "column": "escalation_case_id" }, "operation": ">", "value": 0 }] },
        { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length > 0}}", "rules": [{ "data": { "column": "district_id" }, "operation": "in", "value": "{{scope_context.districts.flatten('id')}}" }] },
        { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.schools.length > 0}}", "rules": [{ "data": { "column": "school_id" }, "operation": "in", "value": "{{scope_context.schools.flatten('id')}}" }] },
        { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && scope_context.service_locations.length > 0}}", "rules": [{ "data": { "column": "repair_centre_location_id" }, "operation": "in", "value": "{{scope_context.service_locations.flatten('id')}}" }] }
      ] }
    ] }, "orders": [{ "column": "sla_due_at", "direction": "asc" }, { "column": "escalation_case_id", "direction": "desc" }], "limit": "{{page_size}}", "offset": "{{(page - 1) * page_size}}" } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "escalations": "{{rows}}", "page": "{{page}}", "page_size": "{{page_size}}" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Escalations could not be loaded." } } }] }
}
