{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "escalations.manage" } } },
    { "name": "rules", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "escalation_rules", "alias": "er" }, "columns": [{ "table": "er", "column": "id" }, { "table": "er", "column": "policy_id" }, { "table": "p", "column": "policy_code" }, { "table": "er", "column": "trigger_code" }, { "table": "er", "column": "escalation_level" }, { "table": "er", "column": "target_role_id" }, { "table": "r", "column": "name", "alias": "target_role_name" }, { "table": "r", "column": "label", "alias": "target_role_label" }, { "table": "er", "column": "reason_label" }, { "table": "er", "column": "sort_order" }, { "table": "er", "column": "status" }, { "table": "er", "column": "updated_at" }], "joins": [{ "table": "sla_policies", "alias": "p", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "p", "column": "id", "operation": "=", "value": { "table": "er", "column": "policy_id" } }] } }, { "table": "roles", "alias": "r", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "r", "column": "id", "operation": "=", "value": { "table": "er", "column": "target_role_id" } }] } }], "orders": [{ "table": "p", "column": "policy_code", "direction": "asc" }, { "table": "er", "column": "escalation_level", "direction": "asc" }] } } },
    { "name": "policies", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": "sla_policies", "columns": [{ "column": "id" }, { "column": "policy_code" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "policy_code" }, "operation": "!=", "value": "QA" }] }, "orders": [{ "column": "policy_code", "direction": "asc" }] } } },
    { "name": "roles", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": "roles", "columns": [{ "column": "id" }, { "column": "name" }, { "column": "label" }], "orders": [{ "column": "label", "direction": "asc" }] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "rules": "{{rules}}", "policies": "{{policies}}", "roles": "{{roles}}" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Escalation rules could not be loaded." } } }] }
}
