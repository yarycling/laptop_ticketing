{
  "settings": { "options": { "method": "post", "nocsrf": true } },
  "meta": { "$_POST": [{ "name": "id", "type": "number" }, { "name": "policy_id", "type": "number" }, { "name": "trigger_code", "type": "text" }, { "name": "escalation_level", "type": "number" }, { "name": "target_role_id", "type": "number" }, { "name": "reason_label", "type": "text" }, { "name": "sort_order", "type": "number" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "escalations.manage" } } },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.policy_id || !['AT_RISK','BREACHED'].contains($_POST.trigger_code) || ![1,2].contains($_POST.escalation_level * 1) || !$_POST.target_role_id || !$_POST.reason_label || !$_POST.reason_label.trim() || $_POST.reason_label.length > 240 || ($_POST.sort_order && ($_POST.sort_order < 0 || floor($_POST.sort_order) != $_POST.sort_order))}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Provide a valid implemented SLA policy, trigger, level, target role and reason." } } }] } } },
    { "name": "policy", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "sla_policies", "columns": [{ "column": "id" }, { "column": "policy_code" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{$_POST.policy_id}}" }] } } } },
    { "name": "role", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "roles", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{$_POST.target_role_id}}" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!policy.id || policy.policy_code == 'QA' || !role.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "QA is deferred and escalation targets must be existing roles." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_POST.id}}", "then": { "steps": [
      { "name": "existing", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "escalation_rules", "columns": [{ "column": "id" }, { "column": "status" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{$_POST.id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!existing.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Escalation rule was not found." } } }] } } },
      { "name": "save_update", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "escalation_rules", "values": [{ "column": "policy_id", "value": "{{policy.id}}" }, { "column": "trigger_code", "value": "{{$_POST.trigger_code}}" }, { "column": "escalation_level", "value": "{{$_POST.escalation_level}}" }, { "column": "target_role_id", "value": "{{role.id}}" }, { "column": "reason_label", "value": "{{$_POST.reason_label.trim()}}" }, { "column": "sort_order", "value": "{{$_POST.sort_order || 100}}" }, { "column": "updated_by", "value": "{{identity}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{existing.id}}" }] } } } },
      { "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "escalation_rule_updated" }, { "column": "module", "value": "escalations" }, { "column": "entity_type", "value": "escalation_rule" }, { "column": "entity_id", "value": "{{existing.id}}" }, { "column": "description", "value": "{{'Updated ' + policy.policy_code + ' ' + $_POST.trigger_code + ' level ' + $_POST.escalation_level + ' escalation rule.'}}" }] } } }
    ] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.id}}", "then": { "steps": [
      { "name": "save_insert", "module": "dbupdater", "action": "insert", "output": true, "options": { "connection": "db", "sql": { "table": "escalation_rules", "values": [{ "column": "policy_id", "value": "{{policy.id}}" }, { "column": "trigger_code", "value": "{{$_POST.trigger_code}}" }, { "column": "escalation_level", "value": "{{$_POST.escalation_level}}" }, { "column": "target_role_id", "value": "{{role.id}}" }, { "column": "reason_label", "value": "{{$_POST.reason_label.trim()}}" }, { "column": "sort_order", "value": "{{$_POST.sort_order || 100}}" }, { "column": "status", "value": "inactive" }, { "column": "created_by", "value": "{{identity}}" }, { "column": "updated_by", "value": "{{identity}}" }] } } },
      { "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "escalation_rule_created" }, { "column": "module", "value": "escalations" }, { "column": "entity_type", "value": "escalation_rule" }, { "column": "entity_id", "value": "{{save_insert.identity}}" }, { "column": "description", "value": "{{'Created inactive ' + policy.policy_code + ' escalation rule.'}}" }] } } }
    ] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "rule_id": "{{$_POST.id || save_insert.identity}}", "message": "Escalation rule saved. New rules start inactive; activate explicitly." } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The rule conflicts with an existing active rule or could not be saved." } } }] }
}
