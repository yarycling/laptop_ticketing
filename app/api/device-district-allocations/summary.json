{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "device_district_allocations.view" } }, "output": true },
    { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
    { "name": "district_allocated", "module": "dbconnector", "action": "count", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "device_district_allocations", "alias": "a" }, "wheres": { "condition": "AND", "rules": [{ "data": { "table": "a", "column": "active_record_key" }, "operation": "=", "value": 1 }, { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope}}", "rules": [{ "data": { "table": "a", "column": "district_id" }, "operation": "in", "value": "{{scope_context.districts.flatten('id')}}" }] }] } } } },
    { "name": "districts_with_inventory", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "device_district_allocations", "alias": "a" }, "distinct": true, "columns": [{ "table": "a", "column": "district_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "a", "column": "active_record_key" }, "operation": "=", "value": 1 }, { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope}}", "rules": [{ "data": { "table": "a", "column": "district_id" }, "operation": "in", "value": "{{scope_context.districts.flatten('id')}}" }] }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass == 'SUPER_ADMIN' || scope_context.has_national_scope}}", "then": { "steps": [
      { "name": "central_available", "module": "dbconnector", "action": "count", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "devices", "alias": "dv" }, "columns": [{ "table": "dv", "column": "id" }], "joins": [{ "table": "device_lifecycle_statuses", "alias": "ls", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ls", "column": "id", "operation": "=", "value": { "table": "dv", "column": "lifecycle_status_id" } }] } }, { "table": "v_device_current_custody", "alias": "cc", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "cc", "column": "device_id", "operation": "=", "value": { "table": "dv", "column": "id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "ls", "column": "code" }, "operation": "=", "value": "AVAILABLE" }, { "data": { "table": "cc", "column": "current_custody_level" }, "operation": "=", "value": "CENTRAL" }] } } } }
    ] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "central_available": "{{permission.bypass == 'SUPER_ADMIN' || scope_context.has_national_scope ? central_available : null}}", "district_allocated": "{{district_allocated}}", "districts_with_inventory": "{{districts_with_inventory.length}}" } } }
  ], "catch": { "steps": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Allocation summary could not be loaded." } } }] } }
}
