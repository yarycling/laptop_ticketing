{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "meta": { "$_GET": [
    { "name": "search", "type": "text" },
    { "name": "manufacturer_id", "type": "number" },
    { "name": "device_model_id", "type": "number" },
    { "name": "condition_id", "type": "number" },
    { "name": "page", "type": "number" },
    { "name": "page_size", "type": "number" }
  ] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "device_district_allocations.view" } }, "output": true },
    { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
    { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Central inventory is not available for this account." } } }] } } },
    { "name": "page", "module": "core", "action": "setvalue", "options": { "key": "page", "value": "{{$_GET.page && $_GET.page > 0 ? floor($_GET.page) : 1}}" } },
    { "name": "page_size", "module": "core", "action": "setvalue", "options": { "key": "page_size", "value": "{{!$_GET.page_size || $_GET.page_size < 1 ? 25 : ($_GET.page_size > 100 ? 100 : floor($_GET.page_size))}}" } },
    { "name": "total", "module": "dbconnector", "action": "count", "output": true, "options": { "connection": "db", "sql": {
      "table": { "name": "devices", "alias": "dv" },
      "columns": [{ "table": "dv", "column": "id" }],
      "joins": [
        { "table": "device_models", "alias": "m", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "m", "column": "id", "operation": "=", "value": { "table": "dv", "column": "device_model_id" } }] } },
        { "table": "manufacturers", "alias": "mf", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "mf", "column": "id", "operation": "=", "value": { "table": "m", "column": "manufacturer_id" } }] } },
        { "table": "device_lifecycle_statuses", "alias": "ls", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ls", "column": "id", "operation": "=", "value": { "table": "dv", "column": "lifecycle_status_id" } }] } },
        { "table": "v_device_current_custody", "alias": "cc", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "cc", "column": "device_id", "operation": "=", "value": { "table": "dv", "column": "id" } }] } }
      ],
      "wheres": { "condition": "AND", "rules": [
        { "data": { "table": "cc", "column": "current_custody_level" }, "operation": "=", "value": "CENTRAL" },
        { "data": { "table": "ls", "column": "code" }, "operation": "=", "value": "AVAILABLE" },
        { "condition": "OR", "conditional": "{{$_GET.search}}", "rules": [
          { "data": { "table": "dv", "column": "serial_number" }, "operator": "contains", "value": "{{$_GET.search}}" },
          { "data": { "table": "dv", "column": "asset_tag" }, "operator": "contains", "value": "{{$_GET.search}}" },
          { "data": { "table": "dv", "column": "procurement_reference" }, "operator": "contains", "value": "{{$_GET.search}}" },
          { "data": { "table": "dv", "column": "supplier_name" }, "operator": "contains", "value": "{{$_GET.search}}" }
        ] },
        { "condition": "AND", "conditional": "{{$_GET.manufacturer_id}}", "rules": [{ "data": { "table": "mf", "column": "id" }, "operation": "=", "value": "{{$_GET.manufacturer_id}}" }] },
        { "condition": "AND", "conditional": "{{$_GET.device_model_id}}", "rules": [{ "data": { "table": "m", "column": "id" }, "operation": "=", "value": "{{$_GET.device_model_id}}" }] },
        { "condition": "AND", "conditional": "{{$_GET.condition_id}}", "rules": [{ "data": { "table": "dv", "column": "condition_id" }, "operation": "=", "value": "{{$_GET.condition_id}}" }] }
      ] }
    } } },
    { "name": "devices", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": {
      "table": { "name": "devices", "alias": "dv" },
      "joins": [
        { "table": "device_models", "alias": "m", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "m", "column": "id", "operation": "=", "value": { "table": "dv", "column": "device_model_id" } }] } },
        { "table": "manufacturers", "alias": "mf", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "mf", "column": "id", "operation": "=", "value": { "table": "m", "column": "manufacturer_id" } }] } },
        { "table": "device_lifecycle_statuses", "alias": "ls", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ls", "column": "id", "operation": "=", "value": { "table": "dv", "column": "lifecycle_status_id" } }] } },
        { "table": "device_conditions", "alias": "c", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "c", "column": "id", "operation": "=", "value": { "table": "dv", "column": "condition_id" } }] } },
        { "table": "v_device_current_custody", "alias": "cc", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "cc", "column": "device_id", "operation": "=", "value": { "table": "dv", "column": "id" } }] } }
      ],
      "columns": [
        { "table": "dv", "column": "id", "alias": "device_id" }, { "table": "dv", "column": "serial_number" }, { "table": "dv", "column": "asset_tag" },
        { "table": "mf", "column": "name", "alias": "manufacturer" }, { "table": "m", "column": "model_name", "alias": "model" }, { "table": "c", "column": "name", "alias": "condition" },
        { "table": "ls", "column": "code", "alias": "lifecycle" }, { "table": "dv", "column": "warranty_end_date" }, { "table": "dv", "column": "received_date" }
      ],
      "wheres": { "condition": "AND", "rules": [
        { "data": { "table": "cc", "column": "current_custody_level" }, "operation": "=", "value": "CENTRAL" },
        { "data": { "table": "ls", "column": "code" }, "operation": "=", "value": "AVAILABLE" },
        { "condition": "OR", "conditional": "{{$_GET.search}}", "rules": [
          { "data": { "table": "dv", "column": "serial_number" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "table": "dv", "column": "asset_tag" }, "operator": "contains", "value": "{{$_GET.search}}" },
          { "data": { "table": "dv", "column": "procurement_reference" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "table": "dv", "column": "supplier_name" }, "operator": "contains", "value": "{{$_GET.search}}" }
        ] },
        { "condition": "AND", "conditional": "{{$_GET.manufacturer_id}}", "rules": [{ "data": { "table": "mf", "column": "id" }, "operation": "=", "value": "{{$_GET.manufacturer_id}}" }] },
        { "condition": "AND", "conditional": "{{$_GET.device_model_id}}", "rules": [{ "data": { "table": "m", "column": "id" }, "operation": "=", "value": "{{$_GET.device_model_id}}" }] },
        { "condition": "AND", "conditional": "{{$_GET.condition_id}}", "rules": [{ "data": { "table": "dv", "column": "condition_id" }, "operation": "=", "value": "{{$_GET.condition_id}}" }] }
      ] },
      "orders": [{ "table": "dv", "column": "serial_number", "direction": "asc" }], "limit": "{{page_size}}", "offset": "{{(page - 1) * page_size}}"
    } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "devices": "{{devices}}", "page": "{{page}}", "page_size": "{{page_size}}", "total": "{{total}}", "total_pages": "{{ceil(total / page_size)}}" } } }
  ], "catch": { "steps": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Central inventory could not be loaded." } } }] } }
}
