{
  "settings": {
    "options": {
      "method": "get",
      "nocsrf": true
    }
  },
  "meta": {
    "$_GET": [
      {
        "type": "number",
        "name": "id"
      }
    ]
  },
  "exec": {
    "steps": [
      {
        "name": "require_permission",
        "module": "core",
        "action": "exec",
        "options": {
          "exec": "security_require_permission",
          "params": {
            "permission": "students.view"
          }
        },
        "output": true
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{!$_GET.id || $_GET.id < 1}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 400,
                  "data": {
                    "success": false,
                    "error": "Student ID is required."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "name": "student",
        "module": "dbconnector",
        "action": "single",
        "options": {
          "connection": "db",
          "sql": {
            "table": {
              "name": "students",
              "alias": "st"
            },
            "joins": [
              {
                "table": "schools",
                "alias": "s",
                "type": "inner",
                "clauses": {
                  "condition": "AND",
                  "rules": [
                    {
                      "table": "s",
                      "column": "id",
                      "operation": "=",
                      "value": {
                        "table": "st",
                        "column": "school_id"
                      }
                    }
                  ]
                }
              },
              {
                "table": "districts",
                "alias": "d",
                "type": "inner",
                "clauses": {
                  "condition": "AND",
                  "rules": [
                    {
                      "table": "d",
                      "column": "id",
                      "operation": "=",
                      "value": {
                        "table": "s",
                        "column": "district_id"
                      }
                    }
                  ]
                }
              }
            ],
            "columns": [
              {
                "table": "st",
                "column": "id",
                "alias": "id"
              },
              {
                "table": "st",
                "column": "student_reference",
                "alias": "student_reference"
              },
              {
                "table": "st",
                "column": "first_name",
                "alias": "first_name"
              },
              {
                "table": "st",
                "column": "last_name",
                "alias": "last_name"
              },
              {
                "table": "st",
                "column": "status",
                "alias": "status"
              },
              {
                "table": "st",
                "column": "school_id",
                "alias": "school_id"
              },
              {
                "table": "s",
                "column": "school_code",
                "alias": "school_code"
              },
              {
                "table": "s",
                "column": "name",
                "alias": "school_name"
              },
              {
                "table": "s",
                "column": "district_id",
                "alias": "district_id"
              },
              {
                "table": "d",
                "column": "name",
                "alias": "district_name"
              },
              {
                "table": "st",
                "column": "created_at",
                "alias": "created_at"
              },
              {
                "table": "st",
                "column": "updated_at",
                "alias": "updated_at"
              },
              {
                "table": "st",
                "column": "school_student_id_number",
                "alias": "school_student_id_number"
              },
              {
                "table": "st",
                "column": "school_start_date",
                "alias": "school_start_date"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "data": {
                    "table": "st",
                    "column": "id"
                  },
                  "operation": "=",
                  "value": "{{$_GET.id}}"
                }
              ]
            }
          }
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{!student.id}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 404,
                  "data": {
                    "success": false,
                    "error": "Student was not found."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "name": "school_access",
        "module": "core",
        "action": "exec",
        "options": {
          "exec": "security_get_authorized_schools",
          "params": {
            "super_admin": "{{require_permission.bypass == 'SUPER_ADMIN'}}"
          }
        },
        "output": true
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{!school_access.allowed_schools.flatten('id').contains(student.school_id)}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 403,
                  "data": {
                    "success": false,
                    "error": "Forbidden."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "module": "core",
        "action": "response",
        "options": {
          "status": 200,
          "data": {
            "success": true,
            "student": "{{student}}"
          }
        }
      }
    ],
    "catch": {
      "steps": [
        {
          "module": "core",
          "action": "condition",
          "options": {
            "if": "{{$_EXCEPTION.code == 'ER_DUP_ENTRY' || ($_ERROR && $_ERROR.contains('Duplicate entry'))}}",
            "then": {
              "steps": [
                {
                  "module": "core",
                  "action": "response",
                  "options": {
                    "status": 409,
                    "data": {
                      "success": false,
                      "error": "A record with these identifiers already exists."
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "module": "core",
          "action": "response",
          "options": {
            "status": 500,
            "data": {
              "success": false,
              "error": "An unexpected server error occurred."
            }
          }
        }
      ]
    }
  }
}
