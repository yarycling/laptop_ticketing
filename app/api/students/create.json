{
  "settings": {
    "options": {
      "method": "post",
      "nocsrf": true
    }
  },
  "meta": {
    "$_POST": [
      {
        "type": "number",
        "name": "school_id"
      },
      {
        "type": "text",
        "name": "first_name"
      },
      {
        "type": "text",
        "name": "last_name"
      },
      {
        "type": "text",
        "name": "school_student_id_number"
      },
      {
        "type": "text",
        "name": "school_start_date"
      }
    ]
  },
  "exec": {
    "steps": [
      {
        "name": "require_permission",
        "module": "core",
        "action": "exec",
        "options": {
          "exec": "security_require_permission",
          "params": {
            "permission": "students.manage"
          }
        },
        "output": true
      },
      {
        "name": "identity",
        "module": "auth",
        "action": "identify",
        "options": {
          "provider": "portalSecurity"
        }
      },
      {
        "name": "first_name",
        "module": "core",
        "action": "setvalue",
        "options": {
          "key": "first_name",
          "value": "{{($_POST.first_name || '').trim()}}"
        }
      },
      {
        "name": "last_name",
        "module": "core",
        "action": "setvalue",
        "options": {
          "key": "last_name",
          "value": "{{($_POST.last_name || '').trim()}}"
        }
      },
      {
        "name": "school_student_id_number",
        "module": "core",
        "action": "setvalue",
        "options": {
          "key": "school_student_id_number",
          "value": "{{($_POST.school_student_id_number || '').trim()}}"
        }
      },
      {
        "name": "school_start_date",
        "module": "core",
        "action": "setvalue",
        "options": {
          "key": "school_start_date",
          "value": "{{($_POST.school_start_date || '').trim()}}"
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{!$_POST.school_id || $_POST.school_id < 1 || !first_name || !last_name || first_name.length() > 100 || last_name.length() > 100 || school_student_id_number.length() > 100}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 400,
                  "data": {
                    "success": false,
                    "error": "School, first name, and last name are required within their length limits."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "name": "school_access",
        "module": "core",
        "action": "exec",
        "options": {
          "exec": "security_get_authorized_schools",
          "params": {
            "super_admin": "{{require_permission.bypass == 'SUPER_ADMIN'}}"
          }
        },
        "output": true
      },
      {
        "name": "target_school",
        "module": "dbconnector",
        "action": "single",
        "options": {
          "connection": "db",
          "sql": {
            "table": "schools",
            "columns": [
              {
                "column": "id"
              },
              {
                "column": "status"
              },
              {
                "column": "name"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "data": {
                    "column": "id"
                  },
                  "operation": "=",
                  "value": "{{$_POST.school_id}}"
                }
              ]
            }
          }
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{!target_school.id || target_school.status != 'active'}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 400,
                  "data": {
                    "success": false,
                    "error": "Select an active school."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{!school_access.allowed_schools.flatten('id').contains(target_school.id)}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 403,
                  "data": {
                    "success": false,
                    "error": "Forbidden."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "name": "student_reference_base",
        "module": "core",
        "action": "setvalue",
        "options": {
          "key": "student_reference_base",
          "value": "{{(first_name.substr(0, 1) + last_name).slugify().substr(0, 90) || 'student'}}"
        }
      },
      {
        "name": "student_reference",
        "module": "core",
        "action": "setvalue",
        "options": {
          "key": "student_reference",
          "value": "{{student_reference_base}}"
        }
      },
      {
        "name": "reference_match",
        "module": "dbconnector",
        "action": "single",
        "options": {
          "connection": "db",
          "sql": {
            "table": "students",
            "columns": [
              {
                "column": "id"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "data": {
                    "column": "student_reference"
                  },
                  "operation": "=",
                  "value": "{{student_reference}}"
                }
              ]
            }
          }
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{reference_match.id}}",
          "then": {
            "steps": [
              {
                "name": "reference_suffix",
                "module": "core",
                "action": "setvalue",
                "options": {
                  "key": "reference_suffix",
                  "value": 1
                }
              },
              {
                "name": "student_reference_candidate",
                "module": "core",
                "action": "setvalue",
                "options": {
                  "key": "student_reference",
                  "value": "{{student_reference_base + '-' + reference_suffix}}"
                }
              },
              {
                "name": "reference_match",
                "module": "dbconnector",
                "action": "single",
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "students",
                    "columns": [
                      {
                        "column": "id"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "student_reference"
                          },
                          "operation": "=",
                          "value": "{{student_reference}}"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "module": "core",
                "action": "while",
                "options": {
                  "while": "{{reference_match.id}}",
                  "max": 100000,
                  "exec": {
                    "steps": [
                      {
                        "name": "reference_suffix",
                        "module": "core",
                        "action": "setvalue",
                        "options": {
                          "key": "reference_suffix",
                          "value": "{{reference_suffix + 1}}"
                        }
                      },
                      {
                        "name": "student_reference_candidate",
                        "module": "core",
                        "action": "setvalue",
                        "options": {
                          "key": "student_reference",
                          "value": "{{student_reference_base + '-' + reference_suffix}}"
                        }
                      },
                      {
                        "name": "reference_match",
                        "module": "dbconnector",
                        "action": "single",
                        "options": {
                          "connection": "db",
                          "sql": {
                            "table": "students",
                            "columns": [
                              {
                                "column": "id"
                              }
                            ],
                            "wheres": {
                              "condition": "AND",
                              "rules": [
                                {
                                  "data": {
                                    "column": "student_reference"
                                  },
                                  "operation": "=",
                                  "value": "{{student_reference}}"
                                }
                              ]
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      {
        "name": "save_student",
        "module": "dbupdater",
        "action": "transaction",
        "options": {
          "connection": "db",
          "exec": {
            "steps": [
              {
                "name": "create_student",
                "module": "dbupdater",
                "action": "insert",
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "students",
                    "values": [
                      {
                        "column": "school_id",
                        "value": "{{$_POST.school_id}}"
                      },
                      {
                        "column": "student_reference",
                        "value": "{{student_reference}}"
                      },
                      {
                        "column": "first_name",
                        "value": "{{first_name}}"
                      },
                      {
                        "column": "last_name",
                        "value": "{{last_name}}"
                      },
                      {
                        "column": "updated_by_user_id",
                        "value": "{{identity}}"
                      },
                      {
                        "column": "status",
                        "value": "active"
                      },
                      {
                        "column": "created_by_user_id",
                        "value": "{{identity}}"
                      },
                      {
                        "column": "school_student_id_number",
                        "value": "{{school_student_id_number || null}}"
                      },
                      {
                        "column": "school_start_date",
                        "value": "{{school_start_date || null}}"
                      }
                    ]
                  }
                }
              },
              {
                "name": "audit_student_created",
                "module": "dbupdater",
                "action": "insert",
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "audit_logs",
                    "values": [
                      {
                        "column": "actor_user_id",
                        "value": "{{identity}}"
                      },
                      {
                        "column": "action",
                        "value": "student_created"
                      },
                      {
                        "column": "module",
                        "value": "students"
                      },
                      {
                        "column": "entity_type",
                        "value": "student"
                      },
                      {
                        "column": "entity_id",
                        "value": "{{create_student.identity}}"
                      },
                      {
                        "column": "description",
                        "value": "Student created."
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      {
        "module": "core",
        "action": "response",
        "options": {
          "status": 200,
          "data": {
            "success": true
          }
        }
      }
    ],
    "catch": {
      "steps": [
        {
          "module": "core",
          "action": "condition",
          "options": {
            "if": "{{$_EXCEPTION.code == 'ER_DUP_ENTRY' || ($_ERROR && $_ERROR.contains('Duplicate entry'))}}",
            "then": {
              "steps": [
                {
                  "module": "core",
                  "action": "response",
                  "options": {
                    "status": 409,
                    "data": {
                      "success": false,
                      "error": "A record with these identifiers already exists."
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "module": "core",
          "action": "response",
          "options": {
            "status": 500,
            "data": {
              "success": false,
              "error": "An unexpected server error occurred."
            }
          }
        }
      ]
    }
  }
}
