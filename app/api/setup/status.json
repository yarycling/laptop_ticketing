{
  "settings": {
    "options": {
      "method": "get",
      "nocsrf": true
    }
  },
  "exec": {
    "steps": [
      {
        "name": "count_users",
        "module": "dbconnector",
        "action": "count",
        "options": {
          "connection": "db",
          "sql": {
            "table": "users"
          }
        }
      },
      {
        "module": "core",
        "action": "response",
        "options": {
          "status": 200,
          "data": {
            "initialized": "{{count_users > 0}}"
          }
        }
      }
    ],
    "catch": {
      "steps": [
        {
          "module": "core",
          "action": "response",
          "options": {
            "status": 500,
            "data": {
              "success": false,
              "error": "An unexpected server error occurred."
            }
          }
        }
      ]
    }
  }
}
