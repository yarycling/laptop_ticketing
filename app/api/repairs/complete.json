{
  "settings": { "options": { "method": "post" } },
  "meta": { "$_POST": [{ "name": "repair_job_id", "type": "number" }, { "name": "outcome_code", "type": "text" }, { "name": "completion_summary", "type": "text" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "repairs.complete" } } },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "name": "completion_at", "module": "core", "action": "setvalue", "options": { "key": "completion_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss.SSS')}}" } },
    { "name": "scope_context", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_get_scope_context", "params": {} } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.repair_job_id || $_POST.repair_job_id < 1 || !$_POST.outcome_code || !$_POST.completion_summary || !$_POST.completion_summary.trim() || $_POST.completion_summary.length > 2000}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "A valid repair job, outcome and completion summary are required." } } }] } } },
    { "name": "outcome", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "repair_outcomes", "columns": [{ "column": "id" }, { "column": "code" }, { "column": "name" }, { "column": "is_return_ready" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "{{$_POST.outcome_code}}" }, { "data": { "column": "is_active" }, "operation": "=", "value": 1 }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!outcome.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Choose a valid active repair outcome." } } }] } } },
    { "name": "completed_status", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_statuses", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "COMPLETED" }, { "data": { "column": "is_active" }, "operation": "=", "value": 1 }] } } } },
    { "name": "ready_status", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "logistics_statuses", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "READY_FOR_RETURN" }, { "data": { "column": "is_active" }, "operation": "=", "value": 1 }] } } } },
    { "name": "assigned_status", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "device_lifecycle_statuses", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "ASSIGNED" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
    { "name": "available_status", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "device_lifecycle_statuses", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "AVAILABLE" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
    { "name": "completion_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "job", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "repair_jobs", "alias": "j" }, "columns": [{ "table": "j", "column": "id" }, { "table": "j", "column": "logistics_case_id" }, { "table": "j", "column": "completed_at" }, { "table": "r", "column": "ticket_id" }, { "table": "r", "column": "ticket_number" }, { "table": "r", "column": "device_id" }, { "table": "r", "column": "repair_centre_location_id" }, { "table": "r", "column": "physical_state_code" }, { "table": "r", "column": "logistics_status_code" }, { "table": "r", "column": "ticket_status_code" }, { "table": "r", "column": "device_lifecycle_code" }, { "table": "r", "column": "allocation_custody_level" }, { "table": "r", "column": "allocation_student_id" }, { "table": "d", "column": "lifecycle_status_id", "alias": "device_lifecycle_status_id" }, { "table": "r", "column": "outcome_code" }], "joins": [{ "table": "v_repair_current_context", "alias": "r", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "r", "column": "logistics_case_id", "operation": "=", "value": { "table": "j", "column": "logistics_case_id" } }] } }, { "table": "devices", "alias": "d", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "d", "column": "id", "operation": "=", "value": { "table": "r", "column": "device_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "j", "column": "id" }, "operation": "=", "value": "{{$_POST.repair_job_id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!job.id || job.completed_at || job.physical_state_code != 'REPAIR_CENTRE_CUSTODY' || job.logistics_status_code != 'AT_REPAIR_CENTRE' || job.ticket_status_code != 'UNDER_REPAIR' || job.device_lifecycle_code != 'IN_REPAIR'}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7E_COMPLETE_STATE_CONFLICT" } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.service_locations.flatten('id').contains(job.repair_centre_location_id)}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7E_COMPLETE_SCOPE_CONFLICT" } }] } } },
      { "name": "assessment", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "repair_assessments", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "repair_job_id" }, "operation": "=", "value": "{{job.id}}" }] } } } },
      { "name": "work", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "repair_work_logs", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "repair_job_id" }, "operation": "=", "value": "{{job.id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!assessment.id || (outcome.code == 'REPAIRED_SUCCESSFULLY' && !work.id)}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7E_COMPLETE_REQUIREMENTS_CONFLICT" } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!completed_status.id || (outcome.is_return_ready == 1 && !ready_status.id) || (outcome.is_return_ready == 1 && !assigned_status.id) || (outcome.is_return_ready == 1 && !available_status.id)}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7E_COMPLETE_CONFIGURATION_CONFLICT" } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{outcome.is_return_ready == 1 && job.allocation_custody_level != 'STUDENT' && job.allocation_custody_level != 'SCHOOL' && job.allocation_custody_level != 'DISTRICT' && job.allocation_custody_level != 'CENTRAL'}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7E_COMPLETE_ALLOCATION_CONFLICT" } }] } } },
      { "name": "complete_job", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "repair_jobs", "values": [{ "column": "completed_at", "value": "{{completion_at}}" }, { "column": "completed_by_user_id", "value": "{{identity}}" }, { "column": "outcome_id", "value": "{{outcome.id}}" }, { "column": "completion_summary", "value": "{{$_POST.completion_summary.trim()}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{job.id}}" }, { "data": { "column": "completed_at" }, "operator": "is_null" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{complete_job.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7E_COMPLETE_STATE_CONFLICT" } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{outcome.is_return_ready != 1}}", "then": { "steps": [
        { "name": "exception_case", "module": "dbupdater", "action": "insert", "output": true, "options": { "connection": "db", "sql": { "table": "repair_exception_cases", "values": [ { "column": "ticket_id", "value": "{{job.ticket_id}}" }, { "column": "logistics_case_id", "value": "{{job.logistics_case_id}}" }, { "column": "repair_job_id", "value": "{{job.id}}" }, { "column": "device_id", "value": "{{job.device_id}}" }, { "column": "originating_repair_outcome_id", "value": "{{outcome.id}}" }, { "column": "current_status_code", "value": "ASSESSMENT_REQUIRED" }, { "column": "recommended_disposition_code", "value": "{{outcome.code == 'MANUFACTURER_RETURN_REQUIRED' ? 'MANUFACTURER_RETURN' : (outcome.code == 'REPLACEMENT_REQUIRED' ? 'PERMANENT_REPLACEMENT' : null)}}" }, { "column": "created_by_user_id", "value": "{{identity}}" } ] } } },
        { "name": "exception_history", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "exception_case_status_history", "values": [ { "column": "exception_case_id", "value": "{{exception_case.identity}}" }, { "column": "from_status_code", "value": null }, { "column": "to_status_code", "value": "ASSESSMENT_REQUIRED" }, { "column": "actor_user_id", "value": "{{identity}}" }, { "column": "reason", "value": "Exception case created from completed non-return repair outcome." } ] } } },
        { "name": "exception_created_audit", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [ { "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "exception_case_created" }, { "column": "module", "value": "exceptions" }, { "column": "entity_type", "value": "repair_exception_case" }, { "column": "entity_id", "value": "{{exception_case.identity}}" }, { "column": "description", "value": "Exception case created for repair job; assessment is required." } ] } } }
      ] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{outcome.is_return_ready == 1}}", "then": { "steps": [
        { "name": "logistics_status", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "logistics_statuses", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "AT_REPAIR_CENTRE" }] } } } },
        { "name": "update_logistics", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_logistics_cases", "values": [{ "column": "current_status_id", "value": "{{ready_status.id}}" }, { "column": "updated_by_user_id", "value": "{{identity}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{job.logistics_case_id}}" }, { "data": { "column": "current_status_id" }, "operation": "=", "value": "{{logistics_status.id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "closed_at" }, "operator": "is_null" }] } } } },
        { "module": "core", "action": "condition", "options": { "if": "{{update_logistics.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7E_COMPLETE_STATE_CONFLICT" } }] } } },
        { "name": "logistics_history", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "logistics_status_history", "values": [{ "column": "logistics_case_id", "value": "{{job.logistics_case_id}}" }, { "column": "from_status_id", "value": "{{logistics_status.id}}" }, { "column": "to_status_id", "value": "{{ready_status.id}}" }, { "column": "changed_by_user_id", "value": "{{identity}}" }, { "column": "reason", "value": "Repair processing completed; return logistics is pending." }] } } },
        { "name": "under_repair_status", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_statuses", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "UNDER_REPAIR" }] } } } },
        { "name": "update_ticket", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "tickets", "values": [{ "column": "current_status_id", "value": "{{completed_status.id}}" }, { "column": "updated_by_user_id", "value": "{{identity}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{job.ticket_id}}" }, { "data": { "column": "current_status_id" }, "operation": "=", "value": "{{under_repair_status.id}}" }] } } } },
        { "module": "core", "action": "condition", "options": { "if": "{{update_ticket.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7E_COMPLETE_STATE_CONFLICT" } }] } } },
        { "name": "ticket_history", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "ticket_status_history", "values": [{ "column": "ticket_id", "value": "{{job.ticket_id}}" }, { "column": "from_status_id", "value": "{{under_repair_status.id}}" }, { "column": "to_status_id", "value": "{{completed_status.id}}" }, { "column": "changed_by_user_id", "value": "{{identity}}" }, { "column": "reason", "value": "Repair completed and ready for return logistics." }] } } },
        { "name": "allocation", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_device_current_custody", "columns": [{ "column": "current_custody_level" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "device_id" }, "operation": "=", "value": "{{job.device_id}}" }] } } } },
        { "module": "core", "action": "condition", "options": { "if": "{{allocation.current_custody_level != job.allocation_custody_level}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7E_COMPLETE_ALLOCATION_CONFLICT" } }] } } },
        { "name": "device_lifecycle", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "devices", "values": [{ "column": "lifecycle_status_id", "value": "{{allocation.current_custody_level == 'STUDENT' ? assigned_status.id : available_status.id}}" }, { "column": "updated_by_user_id", "value": "{{identity}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{job.device_id}}" }, { "data": { "column": "lifecycle_status_id" }, "operation": "=", "value": "{{job.device_lifecycle_status_id}}" }] } } } },
        { "module": "core", "action": "condition", "options": { "if": "{{device_lifecycle.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7E_COMPLETE_STATE_CONFLICT" } }] } } },
        { "name": "audit_ready", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "repair_completed_ready_for_return" }, { "column": "module", "value": "repairs" }, { "column": "entity_type", "value": "repair_job" }, { "column": "entity_id", "value": "{{job.id}}" }, { "column": "description", "value": "Repair processing completed; case is awaiting return logistics." }] } } }
      ] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{outcome.is_return_ready != 1}}", "then": { "steps": [{ "name": "audit_disposition", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "repair_disposition_recorded" }, { "column": "module", "value": "repairs" }, { "column": "entity_type", "value": "repair_job" }, { "column": "entity_id", "value": "{{job.id}}" }, { "column": "description", "value": "Repair disposition recorded; downstream workflow is required." }] } } }] } } }
    ] } } },
    { "name": "completed", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "repair_jobs", "columns": [{ "column": "id", "alias": "repair_job_id" }, { "column": "logistics_case_id" }, { "column": "completed_at" }, { "column": "outcome_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{$_POST.repair_job_id}}" }] } } } },
    { "name": "completion_context", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_repair_current_context", "columns": [{ "column": "ticket_id" }, { "column": "ticket_number" }, { "column": "logistics_case_id" }, { "column": "device_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "repair_job_id" }, "operation": "=", "value": "{{completed.repair_job_id}}" }] } } } },
    { "name": "effective_return", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_ticket_effective_device", "columns": [{ "column": "effective_device_id" }, { "column": "device_source" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "logistics_case_id" }, "operation": "=", "value": "{{completed.logistics_case_id}}" }] } } } },
    { "name": "post_commit_sla", "module": "core", "action": "exec", "output": true, "options": { "exec": "repair_sla_after_completion", "params": { "outcome_code": "{{outcome.code}}", "is_return_ready": "{{outcome.is_return_ready}}", "idempotency_key": "{{'REPAIR:JOB:' + completed.repair_job_id}}", "completed_at": "{{completion_at}}", "ticket_id": "{{completion_context.ticket_id}}", "ticket_number": "{{completion_context.ticket_number}}", "logistics_case_id": "{{completed.logistics_case_id}}", "repair_job_id": "{{completed.repair_job_id}}", "device_id": "{{completion_context.device_id}}", "effective_device_id": "{{effective_return.effective_device_id}}", "effective_device_source": "{{effective_return.device_source}}", "actor_user_id": "{{identity}}" } } },
    { "module": "core", "action": "condition", "options": { "if": "{{outcome.is_return_ready == 1}}", "then": { "steps": [
      { "name": "notify_repair_completed", "module": "core", "action": "exec", "options": { "exec": "notification_from_workflow", "params": { "event_type_code": "REPAIR_COMPLETED", "ticket_id": "{{job.ticket_id}}", "logistics_case_id": "{{completed.logistics_case_id}}", "repair_job_id": "{{completed.repair_job_id}}", "source_id": "{{completed.repair_job_id}}", "actor_user_id": "{{identity}}", "message": "{{'Successful repair work is complete for ' + job.ticket_number + '; the case is ready for return logistics.'}}" } } },
      { "name": "notify_return_pickup_ready", "module": "core", "action": "exec", "options": { "exec": "notification_from_workflow", "params": { "event_type_code": "LOGISTICS_READY_FOR_RETURN_PICKUP", "ticket_id": "{{job.ticket_id}}", "logistics_case_id": "{{completed.logistics_case_id}}", "repair_job_id": "{{completed.repair_job_id}}", "source_id": "{{completed.logistics_case_id}}", "actor_user_id": "{{identity}}", "message": "{{'Repair is complete for ' + job.ticket_number + '; TTPost pickup is now the next action.'}}" } } }
    ] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "repair_job": "{{completed}}", "outcome": "{{outcome.code}}", "repair_state": "{{outcome.is_return_ready == 1 ? 'READY_FOR_RETURN' : 'DISPOSITION_RECORDED'}}" } } }
  ], "catch": [
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P7E_COMPLETE_SCOPE_CONFLICT'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P7E_COMPLETE_REQUIREMENTS_CONFLICT'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "Record at least one assessment; a successful repair also requires a work log." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P7E_COMPLETE_ALLOCATION_CONFLICT'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The current device allocation is inconsistent. No changes were committed." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P7E_COMPLETE_CONFIGURATION_CONFLICT'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "Required configured statuses are unavailable. No changes were committed." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P7E_COMPLETE_STATE_CONFLICT'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The repair job or case state changed. No partial changes were committed." } } }] } } },
    { "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Repair completion could not be recorded. No partial changes were committed." } } }
  ] }
}
