{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "repairs.view" } } },
    { "name": "outcomes", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": "repair_outcomes", "columns": [{ "column": "id" }, { "column": "code" }, { "column": "name" }, { "column": "is_return_ready" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "is_active" }, "operation": "=", "value": 1 }] }, "orders": [{ "column": "sort_order", "direction": "asc" }] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "outcomes": "{{outcomes}}" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Repair outcomes could not be loaded." } } }] }
}
