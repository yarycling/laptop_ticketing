{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "meta": { "$_GET": [{ "name": "repair_state", "type": "text" }, { "name": "outcome_code", "type": "text" }, { "name": "search", "type": "text" }, { "name": "page", "type": "number" }, { "name": "page_size", "type": "number" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "repairs.view" } } },
    { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_GET.repair_state && $_GET.repair_state != 'ALL' && $_GET.repair_state != 'AWAITING_REPAIR_START' && $_GET.repair_state != 'IN_PROGRESS' && $_GET.repair_state != 'READY_FOR_RETURN' && $_GET.repair_state != 'DISPOSITION_RECORDED'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Choose a valid repair state." } } }] } } },
    { "name": "outcome_filter", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "repair_outcomes", "columns": [{ "column": "code" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "{{$_GET.outcome_code}}" }, { "data": { "column": "is_active" }, "operation": "=", "value": 1 }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_GET.outcome_code && !outcome_filter.code}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Choose a valid active repair outcome." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{($_GET.page && ($_GET.page < 1 || floor($_GET.page) != $_GET.page)) || ($_GET.page_size && ($_GET.page_size < 1 || $_GET.page_size > 100 || floor($_GET.page_size) != $_GET.page_size))}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Page must be a positive integer and page size must be from 1 to 100." } } }] } } },
    { "name": "page", "module": "core", "action": "setvalue", "options": { "key": "page", "value": "{{$_GET.page || 1}}" } },
    { "name": "page_size", "module": "core", "action": "setvalue", "options": { "key": "page_size", "value": "{{$_GET.page_size || 25}}" } },
    { "name": "rows", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": {
      "table": { "name": "v_repair_current_context", "alias": "r" },
      "columns": [{ "table": "r", "column": "logistics_case_id" }, { "table": "r", "column": "logistics_number" }, { "table": "r", "column": "ticket_id" }, { "table": "r", "column": "ticket_number" }, { "table": "r", "column": "device_id" }, { "table": "r", "column": "serial_number" }, { "table": "r", "column": "asset_tag" }, { "table": "mf", "column": "name", "alias": "manufacturer_name" }, { "table": "m", "column": "model_name" }, { "table": "r", "column": "repair_centre_location_id" }, { "table": "r", "column": "repair_centre_location_name" }, { "table": "r", "column": "physical_state_code" }, { "table": "r", "column": "logistics_status_code" }, { "table": "r", "column": "ticket_status_code" }, { "table": "r", "column": "device_lifecycle_code" }, { "table": "r", "column": "allocation_custody_level" }, { "table": "r", "column": "repair_job_id" }, { "table": "r", "column": "repair_state_code" }, { "table": "r", "column": "started_at" }, { "table": "r", "column": "completed_at" }, { "table": "r", "column": "outcome_code" }, { "table": "r", "column": "outcome_name" }],
      "joins": [{ "table": "devices", "alias": "d", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "d", "column": "id", "operation": "=", "value": { "table": "r", "column": "device_id" } }] } }, { "table": "device_models", "alias": "m", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "m", "column": "id", "operation": "=", "value": { "table": "d", "column": "device_model_id" } }] } }, { "table": "manufacturers", "alias": "mf", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "mf", "column": "id", "operation": "=", "value": { "table": "m", "column": "manufacturer_id" } }] } }],
      "wheres": { "condition": "AND", "rules": [
        { "condition": "AND", "conditional": "{{$_GET.repair_state && $_GET.repair_state != 'ALL'}}", "rules": [{ "data": { "table": "r", "column": "repair_state_code" }, "operation": "=", "value": "{{$_GET.repair_state}}" }] },
        { "condition": "AND", "conditional": "{{$_GET.outcome_code}}", "rules": [{ "data": { "table": "r", "column": "outcome_code" }, "operation": "=", "value": "{{$_GET.outcome_code}}" }] },
        { "condition": "OR", "conditional": "{{$_GET.search}}", "rules": [{ "data": { "table": "r", "column": "ticket_number" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "table": "r", "column": "logistics_number" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "table": "r", "column": "serial_number" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "table": "r", "column": "asset_tag" }, "operator": "contains", "value": "{{$_GET.search}}" }] },
        { "condition": "OR", "rules": [
          { "condition": "AND", "conditional": "{{permission.bypass == 'SUPER_ADMIN'}}", "rules": [{ "data": { "table": "r", "column": "logistics_case_id" }, "operation": ">", "value": 0 }] },
          { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && scope_context.service_locations.length > 0}}", "rules": [{ "data": { "table": "r", "column": "repair_centre_location_id" }, "operation": "in", "value": "{{scope_context.service_locations.flatten('id')}}" }] },
          { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && scope_context.service_locations.length == 0}}", "rules": [{ "data": { "table": "r", "column": "logistics_case_id" }, "operation": "=", "value": -1 }] }
        ] }
      ] },
      "orders": [{ "table": "r", "column": "started_at", "direction": "desc" }, { "table": "r", "column": "logistics_case_id", "direction": "desc" }], "limit": "{{page_size}}", "offset": "{{(page - 1) * page_size}}"
    } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "repairs": "{{rows}}", "page": "{{page}}", "page_size": "{{page_size}}" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Repair queue could not be loaded." } } }] }
}
