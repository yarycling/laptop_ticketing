{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "repairs.view" } } },
    { "name": "scope_context", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_get_scope_context", "params": {} } },
    { "name": "rows", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": "v_repair_current_context", "columns": [{ "column": "logistics_case_id" }, { "column": "repair_centre_location_id" }, { "column": "repair_state_code" }], "wheres": { "condition": "AND", "rules": [{ "condition": "OR", "rules": [{ "condition": "AND", "conditional": "{{permission.bypass == 'SUPER_ADMIN'}}", "rules": [{ "data": { "column": "logistics_case_id" }, "operation": ">", "value": 0 }] }, { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && scope_context.service_locations.length > 0}}", "rules": [{ "data": { "column": "repair_centre_location_id" }, "operation": "in", "value": "{{scope_context.service_locations.flatten('id')}}" }] }, { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && scope_context.service_locations.length == 0}}", "rules": [{ "data": { "column": "logistics_case_id" }, "operation": "=", "value": -1 }] }] }] } } } },
    { "name": "awaiting", "module": "core", "action": "setvalue", "output": true, "options": { "key": "awaiting_repair_start", "value": "{{rows.where('repair_state_code', '==', 'AWAITING_REPAIR_START').count()}}" } },
    { "name": "in_progress", "module": "core", "action": "setvalue", "output": true, "options": { "key": "in_progress", "value": "{{rows.where('repair_state_code', '==', 'IN_PROGRESS').count()}}" } },
    { "name": "ready", "module": "core", "action": "setvalue", "output": true, "options": { "key": "ready_for_return", "value": "{{rows.where('repair_state_code', '==', 'READY_FOR_RETURN').count()}}" } },
    { "name": "disposition", "module": "core", "action": "setvalue", "output": true, "options": { "key": "disposition_recorded", "value": "{{rows.where('repair_state_code', '==', 'DISPOSITION_RECORDED').count()}}" } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "awaiting_repair_start": "{{awaiting_repair_start}}", "in_progress": "{{in_progress}}", "ready_for_return": "{{ready_for_return}}", "disposition_recorded": "{{disposition_recorded}}", "active_total": "{{awaiting_repair_start + in_progress + ready_for_return + disposition_recorded}}" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Repair summary could not be loaded." } } }] }
}
