{
  "settings": { "options": { "method": "post" } },
  "meta": { "$_POST": [{ "name": "logistics_case_id", "type": "number" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "repairs.start" } } },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "name": "scope_context", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_get_scope_context", "params": {} } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.logistics_case_id || $_POST.logistics_case_id < 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "A valid logistics case ID is required." } } }] } } },
    { "name": "start_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "current", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_repair_current_context", "columns": [{ "column": "logistics_case_id" }, { "column": "ticket_id" }, { "column": "ticket_number" }, { "column": "device_id" }, { "column": "repair_centre_location_id" }, { "column": "physical_state_code" }, { "column": "logistics_status_code" }, { "column": "ticket_status_code" }, { "column": "device_lifecycle_code" }, { "column": "repair_job_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "logistics_case_id" }, "operation": "=", "value": "{{$_POST.logistics_case_id}}" }] } } } },
      { "name": "destination", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "service_locations", "columns": [{ "column": "id" }, { "column": "location_type" }, { "column": "is_active" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{current.repair_centre_location_id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!current.logistics_case_id || current.repair_job_id || current.physical_state_code != 'REPAIR_CENTRE_CUSTODY' || current.logistics_status_code != 'AT_REPAIR_CENTRE' || current.ticket_status_code != 'UNDER_REPAIR' || current.device_lifecycle_code != 'IN_REPAIR' || !destination.id || destination.location_type != 'REPAIR_CENTRE' || destination.is_active != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7E_START_STATE_CONFLICT" } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.service_locations.flatten('id').contains(current.repair_centre_location_id)}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7E_START_SCOPE_CONFLICT" } }] } } },
      { "name": "insert_job", "module": "dbupdater", "action": "insert", "output": true, "options": { "connection": "db", "sql": { "table": "repair_jobs", "values": [{ "column": "logistics_case_id", "value": "{{current.logistics_case_id}}" }, { "column": "repair_centre_location_id", "value": "{{current.repair_centre_location_id}}" }, { "column": "started_by_user_id", "value": "{{identity}}" }] } } },
      { "name": "new_job", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "repair_jobs", "columns": [{ "column": "id" }, { "column": "started_at" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "logistics_case_id" }, "operation": "=", "value": "{{current.logistics_case_id}}" }] } } } },
      { "name": "start_audit", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "repair_started" }, { "column": "module", "value": "repairs" }, { "column": "entity_type", "value": "repair_job" }, { "column": "entity_id", "value": "{{new_job.id}}" }, { "column": "description", "value": "{{'Repair processing started for repair job ' + new_job.id}}" }] } } },
      { "name": "sla_repair_start", "module": "core", "action": "exec", "output": true, "options": { "exec": "sla_start", "params": { "policy_code": "REPAIR", "idempotency_key": "{{'REPAIR:JOB:' + new_job.id}}", "ticket_id": "{{current.ticket_id}}", "ticket_number": "{{current.ticket_number}}", "logistics_case_id": "{{current.logistics_case_id}}", "repair_job_id": "{{new_job.id}}", "device_id": "{{current.device_id}}", "effective_device_id": "{{current.device_id}}", "source_workflow": "LOCAL_REPAIR", "source_entity_type": "repair_job", "source_entity_id": "{{new_job.id}}", "started_at": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss.SSS')}}", "actor_user_id": "{{identity}}" } } }
    ] } } },
    { "name": "created", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "repair_jobs", "columns": [{ "column": "id", "alias": "repair_job_id" }, { "column": "logistics_case_id" }, { "column": "started_at" }, { "column": "started_by_user_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "logistics_case_id" }, "operation": "=", "value": "{{$_POST.logistics_case_id}}" }] } } } },
    { "name": "repair_notification_ticket", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_logistics_cases", "columns": [{ "column": "ticket_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{created.logistics_case_id}}" }] } } } },
    { "name": "notify_repair_started", "module": "core", "action": "exec", "options": { "exec": "notification_from_workflow", "params": { "event_type_code": "REPAIR_STARTED", "ticket_id": "{{repair_notification_ticket.ticket_id}}", "logistics_case_id": "{{created.logistics_case_id}}", "repair_job_id": "{{created.repair_job_id}}", "source_id": "{{created.repair_job_id}}", "actor_user_id": "{{identity}}", "message": "{{'Repair work has started for repair job ' + created.repair_job_id + '.'}}" } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "repair_job": "{{created}}" } } }
  ], "catch": [
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.code == 'ER_DUP_ENTRY' || ($_ERROR && $_ERROR.contains('Duplicate entry'))}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "Repair processing has already been started for this logistics case." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P7E_START_SCOPE_CONFLICT'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "This Repair Centre user is not scoped to the Repair Centre location." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P7E_START_STATE_CONFLICT'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "This case is not eligible to start repair processing, or repair processing has already started." } } }] } } },
    { "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Repair processing could not be started. No partial changes were committed." } } }
  ] }
}
