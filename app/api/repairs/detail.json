{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "meta": { "$_GET": [{ "name": "id", "type": "number" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "repairs.view" } } },
    { "name": "scope_context", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_get_scope_context", "params": {} } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_GET.id || $_GET.id < 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "A valid logistics case ID is required." } } }] } } },
    { "name": "repair", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "v_repair_current_context", "alias": "r" }, "columns": [{ "table": "r", "column": "logistics_case_id" }, { "table": "r", "column": "logistics_number" }, { "table": "r", "column": "ticket_id" }, { "table": "r", "column": "ticket_number" }, { "table": "r", "column": "device_id" }, { "table": "r", "column": "serial_number" }, { "table": "r", "column": "asset_tag" }, { "table": "r", "column": "repair_centre_location_id" }, { "table": "r", "column": "repair_centre_location_name" }, { "table": "r", "column": "physical_state_code" }, { "table": "r", "column": "logistics_status_code" }, { "table": "r", "column": "ticket_status_code" }, { "table": "r", "column": "device_lifecycle_code" }, { "table": "r", "column": "allocation_custody_level" }, { "table": "r", "column": "allocation_district_id" }, { "table": "r", "column": "allocation_school_id" }, { "table": "r", "column": "repair_job_id" }, { "table": "r", "column": "started_at" }, { "table": "r", "column": "started_by_user_id" }, { "table": "r", "column": "started_by_display_name" }, { "table": "r", "column": "completed_at" }, { "table": "r", "column": "completed_by_user_id" }, { "table": "r", "column": "completed_by_display_name" }, { "table": "r", "column": "outcome_code" }, { "table": "r", "column": "outcome_name" }, { "table": "r", "column": "outcome_is_return_ready" }, { "table": "r", "column": "is_return_ready" }, { "table": "r", "column": "repair_state_code" }, { "table": "r", "column": "repair_state" }, { "table": "j", "column": "completion_summary" }], "joins": [{ "table": "repair_jobs", "alias": "j", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "j", "column": "id", "operation": "=", "value": { "table": "r", "column": "repair_job_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "r", "column": "logistics_case_id" }, "operation": "=", "value": "{{$_GET.id}}" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!repair.logistics_case_id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Repair case was not found." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.service_locations.flatten('id').contains(repair.repair_centre_location_id)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "name": "assessments", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "repair_assessments", "alias": "a" }, "columns": [{ "table": "a", "column": "id" }, { "table": "a", "column": "assessment_summary" }, { "table": "a", "column": "suspected_cause" }, { "table": "a", "column": "recommended_action" }, { "table": "a", "column": "created_at" }, { "table": "u", "column": "display_name", "alias": "created_by_display_name" }], "joins": [{ "table": "users", "alias": "u", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "u", "column": "id", "operation": "=", "value": { "table": "a", "column": "created_by_user_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "a", "column": "repair_job_id" }, "operation": "=", "value": "{{repair.repair_job_id}}" }] }, "orders": [{ "table": "a", "column": "created_at", "direction": "desc" }, { "table": "a", "column": "id", "direction": "desc" }] } } },
    { "name": "display_assessments", "module": "core", "action": "repeat", "options": { "repeat": "{{assessments}}", "outputFilter": "exclude", "outputFields": [], "exec": { "steps": [{ "name": "created_at_display", "module": "core", "action": "setvalue", "output": true, "options": { "key": "created_at_display", "value": "{{created_at ? created_at.formatDate('MMMM d, yyyy, h:mm A') : 'Not recorded'}}" } }] } } },
    { "name": "work_logs", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "repair_work_logs", "alias": "w" }, "columns": [{ "table": "w", "column": "id" }, { "table": "w", "column": "action_summary" }, { "table": "w", "column": "result_summary" }, { "table": "w", "column": "created_at" }, { "table": "u", "column": "display_name", "alias": "created_by_display_name" }], "joins": [{ "table": "users", "alias": "u", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "u", "column": "id", "operation": "=", "value": { "table": "w", "column": "created_by_user_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "w", "column": "repair_job_id" }, "operation": "=", "value": "{{repair.repair_job_id}}" }] }, "orders": [{ "table": "w", "column": "created_at", "direction": "desc" }, { "table": "w", "column": "id", "direction": "desc" }] } } },
    { "name": "display_work_logs", "module": "core", "action": "repeat", "options": { "repeat": "{{work_logs}}", "outputFilter": "exclude", "outputFields": [], "exec": { "steps": [{ "name": "created_at_display", "module": "core", "action": "setvalue", "output": true, "options": { "key": "created_at_display", "value": "{{created_at ? created_at.formatDate('MMMM d, yyyy, h:mm A') : 'Not recorded'}}" } }] } } },
    { "name": "exception_summary", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "repair_exception_cases", "columns": [{ "column": "id", "alias": "exception_case_id" }, { "column": "current_status_code" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "repair_job_id" }, "operation": "=", "value": "{{repair.repair_job_id}}" }] } } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "repair": "{{repair}}", "assessments": "{{display_assessments}}", "work_logs": "{{display_work_logs}}", "exception_summary": "{{exception_summary}}" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Repair detail could not be loaded." } } }] }
}
