{
  "settings": { "options": { "method": "post" } },
  "meta": { "$_POST": [{ "name": "repair_job_id", "type": "number" }, { "name": "action_summary", "type": "text" }, { "name": "result_summary", "type": "text" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "repairs.record_work" } } },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "name": "scope_context", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_get_scope_context", "params": {} } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.repair_job_id || $_POST.repair_job_id < 1 || !$_POST.action_summary || !$_POST.action_summary.trim() || $_POST.action_summary.length > 2000 || ($_POST.result_summary && $_POST.result_summary.length > 1000)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Provide a valid repair job and action summary within the allowed field lengths." } } }] } } },
    { "name": "work_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "job", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "repair_jobs", "alias": "j" }, "columns": [{ "table": "j", "column": "id" }, { "table": "j", "column": "completed_at" }, { "table": "j", "column": "logistics_case_id" }, { "table": "r", "column": "repair_centre_location_id" }, { "table": "r", "column": "physical_state_code" }, { "table": "r", "column": "logistics_status_code" }, { "table": "r", "column": "ticket_status_code" }, { "table": "r", "column": "device_lifecycle_code" }], "joins": [{ "table": "v_repair_current_context", "alias": "r", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "r", "column": "logistics_case_id", "operation": "=", "value": { "table": "j", "column": "logistics_case_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "j", "column": "id" }, "operation": "=", "value": "{{$_POST.repair_job_id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!job.id || job.completed_at || job.physical_state_code != 'REPAIR_CENTRE_CUSTODY' || job.logistics_status_code != 'AT_REPAIR_CENTRE' || job.ticket_status_code != 'UNDER_REPAIR' || job.device_lifecycle_code != 'IN_REPAIR'}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7E_WORK_STATE_CONFLICT" } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.service_locations.flatten('id').contains(job.repair_centre_location_id)}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7E_WORK_SCOPE_CONFLICT" } }] } } },
      { "name": "work", "module": "dbupdater", "action": "insert", "output": true, "options": { "connection": "db", "sql": { "table": "repair_work_logs", "values": [{ "column": "repair_job_id", "value": "{{job.id}}" }, { "column": "action_summary", "value": "{{$_POST.action_summary.trim()}}" }, { "column": "result_summary", "value": "{{($_POST.result_summary || '').trim() || null}}" }, { "column": "created_by_user_id", "value": "{{identity}}" }] } } },
      { "name": "audit", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "repair_work_recorded" }, { "column": "module", "value": "repairs" }, { "column": "entity_type", "value": "repair_job" }, { "column": "entity_id", "value": "{{$_POST.repair_job_id}}" }, { "column": "description", "value": "Repair work recorded for repair job." }] } } }
    ] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "repair_job_id": "{{job.id}}" } } }
  ], "catch": [
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P7E_WORK_SCOPE_CONFLICT'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P7E_WORK_STATE_CONFLICT'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The repair job is not open or its case is no longer at the Repair Centre." } } }] } } },
    { "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Repair work could not be recorded." } } }
  ] }
}
