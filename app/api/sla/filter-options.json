{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_require_permission", "params": { "permission": "sla.view" } } },
    { "name": "scope_context", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_get_scope_context", "params": {} } },
    { "name": "districts", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "districts", "alias": "d" }, "columns": [{ "table": "d", "column": "id" }, { "table": "d", "column": "name" }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "d", "column": "status" }, "operation": "=", "value": "active" }, { "condition": "OR", "rules": [
      { "condition": "AND", "conditional": "{{permission.bypass == 'SUPER_ADMIN' || scope_context.has_national_scope}}", "rules": [{ "data": { "table": "d", "column": "id" }, "operation": ">", "value": 0 }] },
      { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length > 0}}", "rules": [{ "data": { "table": "d", "column": "id" }, "operation": "in", "value": "{{scope_context.districts.flatten('id')}}" }] },
      { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length == 0 && scope_context.schools.length > 0}}", "rules": [{ "data": { "table": "d", "column": "id" }, "operation": "in", "value": "{{scope_context.schools.flatten('district_id')}}" }] }
    ] }] }, "orders": [{ "table": "d", "column": "name", "direction": "asc" }] } } },
    { "name": "schools", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "schools", "alias": "s" }, "columns": [{ "table": "s", "column": "id" }, { "table": "s", "column": "name" }, { "table": "s", "column": "district_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "s", "column": "status" }, "operation": "=", "value": "active" }, { "condition": "OR", "rules": [
      { "condition": "AND", "conditional": "{{permission.bypass == 'SUPER_ADMIN' || scope_context.has_national_scope}}", "rules": [{ "data": { "table": "s", "column": "id" }, "operation": ">", "value": 0 }] },
      { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length > 0}}", "rules": [{ "data": { "table": "s", "column": "district_id" }, "operation": "in", "value": "{{scope_context.districts.flatten('id')}}" }] },
      { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length == 0 && scope_context.schools.length > 0}}", "rules": [{ "data": { "table": "s", "column": "id" }, "operation": "in", "value": "{{scope_context.schools.flatten('id')}}" }] }
    ] }] }, "orders": [{ "table": "s", "column": "name", "direction": "asc" }] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "districts": "{{districts}}", "schools": "{{schools}}" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "SLA filter options could not be loaded." } } }] }
}
