{
  "settings": { "options": { "method": "post" } },
  "meta": { "$_POST": [
    { "name": "override_id", "type": "number" }, { "name": "override_date", "type": "text" },
    { "name": "override_type", "type": "text" }, { "name": "is_business_day", "type": "text" },
    { "name": "description", "type": "text" }, { "name": "status", "type": "text" }
  ] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_require_permission", "params": { "permission": "sla.manage" } } },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.override_date || $_POST.override_date.length != 10 || !$_POST.description || $_POST.description.trim().length > 500 || !['PUBLIC_HOLIDAY','EXCEPTIONAL_CLOSURE','EXCEPTIONAL_WORKING_DAY'].contains($_POST.override_type) || ($_POST.is_business_day != '0' && $_POST.is_business_day != '1') || !['active','inactive'].contains($_POST.status) || (($_POST.override_type == 'EXCEPTIONAL_WORKING_DAY') != ($_POST.is_business_day == '1'))}}", "then": { "steps": [ { "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Enter a valid date, override type, business-day value, description and status." } } } ] } } },
    { "name": "calendar", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "sla_calendars", "columns": [ { "column": "id" }, { "column": "calendar_code" } ], "wheres": { "condition": "AND", "rules": [ { "data": { "column": "calendar_code" }, "operation": "=", "value": "TTO_PORTAL_OPERATIONS" }, { "data": { "column": "status" }, "operation": "=", "value": "active" } ] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!calendar.id}}", "then": { "steps": [ { "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The default business calendar is unavailable." } } } ] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_POST.override_id}}", "then": { "steps": [
      { "name": "current_override", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "sla_calendar_overrides", "columns": [ { "column": "id" }, { "column": "status" }, { "column": "override_date" } ], "wheres": { "condition": "AND", "rules": [ { "data": { "column": "id" }, "operation": "=", "value": "{{$_POST.override_id}}" }, { "data": { "column": "calendar_id" }, "operation": "=", "value": "{{calendar.id}}" } ] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!current_override.id}}", "then": { "steps": [ { "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Calendar override was not found." } } } ] } } }
    ] } } },
    { "name": "override_action", "module": "core", "action": "setvalue", "output": true, "options": { "key": "override_action", "value": "{{$_POST.override_id ? (current_override.status == 'active' && $_POST.status == 'inactive' ? 'DEACTIVATED' : (current_override.status == 'inactive' && $_POST.status == 'active' ? 'ACTIVATED' : 'CHANGED')) : 'ADDED'}}" } },
    { "name": "override_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "module": "core", "action": "condition", "options": { "if": "{{$_POST.override_id}}", "then": { "steps": [
        { "name": "update_override", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "sla_calendar_overrides", "values": [ { "column": "override_date", "value": "{{$_POST.override_date}}" }, { "column": "override_type", "value": "{{$_POST.override_type}}" }, { "column": "is_business_day", "value": "{{$_POST.is_business_day}}" }, { "column": "description", "value": "{{$_POST.description.trim()}}" }, { "column": "status", "value": "{{$_POST.status}}" }, { "column": "updated_by", "value": "{{identity}}" }, { "column": "updated_at", "value": "{{NOW}}" } ], "wheres": { "condition": "AND", "rules": [ { "data": { "column": "id" }, "operation": "=", "value": "{{current_override.id}}" } ] } } } },
        { "name": "history_updated", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "sla_calendar_override_history", "values": [ { "column": "calendar_override_id", "value": "{{current_override.id}}" }, { "column": "calendar_id", "value": "{{calendar.id}}" }, { "column": "override_date", "value": "{{$_POST.override_date}}" }, { "column": "override_type", "value": "{{$_POST.override_type}}" }, { "column": "is_business_day", "value": "{{$_POST.is_business_day}}" }, { "column": "description", "value": "{{$_POST.description.trim()}}" }, { "column": "status", "value": "{{$_POST.status}}" }, { "column": "action_code", "value": "{{override_action}}" }, { "column": "changed_by", "value": "{{identity}}" } ] } } },
        { "name": "audit_override_updated", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [ { "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "{{'sla.calendar_override.' + override_action.lowercase()}}" }, { "column": "module", "value": "sla" }, { "column": "entity_type", "value": "sla_calendar_override" }, { "column": "entity_id", "value": "{{current_override.id}}" }, { "column": "description", "value": "{{'Calendar override ' + $_POST.override_date + ' ' + override_action.lowercase() + '.'}}" }, { "column": "created_at", "value": "{{NOW}}" } ] } } }
      ] }, "else": { "steps": [
        { "name": "insert_override", "module": "dbupdater", "action": "insert", "output": true, "options": { "connection": "db", "sql": { "table": "sla_calendar_overrides", "values": [ { "column": "calendar_id", "value": "{{calendar.id}}" }, { "column": "override_date", "value": "{{$_POST.override_date}}" }, { "column": "override_type", "value": "{{$_POST.override_type}}" }, { "column": "is_business_day", "value": "{{$_POST.is_business_day}}" }, { "column": "description", "value": "{{$_POST.description.trim()}}" }, { "column": "status", "value": "{{$_POST.status}}" }, { "column": "created_by", "value": "{{identity}}" }, { "column": "updated_by", "value": "{{identity}}" } ] } } },
        { "name": "history_added", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "sla_calendar_override_history", "values": [ { "column": "calendar_override_id", "value": "{{insert_override.identity}}" }, { "column": "calendar_id", "value": "{{calendar.id}}" }, { "column": "override_date", "value": "{{$_POST.override_date}}" }, { "column": "override_type", "value": "{{$_POST.override_type}}" }, { "column": "is_business_day", "value": "{{$_POST.is_business_day}}" }, { "column": "description", "value": "{{$_POST.description.trim()}}" }, { "column": "status", "value": "{{$_POST.status}}" }, { "column": "action_code", "value": "ADDED" }, { "column": "changed_by", "value": "{{identity}}" } ] } } },
        { "name": "audit_override_added", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [ { "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "sla.calendar_override.added" }, { "column": "module", "value": "sla" }, { "column": "entity_type", "value": "sla_calendar_override" }, { "column": "entity_id", "value": "{{insert_override.identity}}" }, { "column": "description", "value": "{{'Calendar override ' + $_POST.override_date + ' added.'}}" }, { "column": "created_at", "value": "{{NOW}}" } ] } } }
      ] } } }
    ] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "override_id": "{{$_POST.override_id || insert_override.identity}}", "action": "{{override_action}}" } } }
  ], "catch": [
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.code == 'ER_DUP_ENTRY' || ($_ERROR && $_ERROR.contains('Duplicate entry'))}}", "then": { "steps": [ { "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "An override already exists for this calendar date. Reload and edit that entry." } } } ] } } },
    { "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Calendar override could not be saved. No partial changes were committed." } } }
  ] }
}
