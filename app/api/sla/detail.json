{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "meta": { "$_GET": [{ "name": "id", "type": "number" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_require_permission", "params": { "permission": "sla.view" } } },
    { "name": "scope_context", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_get_scope_context", "params": {} } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_GET.id || $_GET.id < 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "A valid SLA reference is required." } } }] } } },
    { "name": "sla", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_sla_operational_queue", "columns": [{ "column": "sla_instance_id" }, { "column": "idempotency_key" }, { "column": "policy_code_snapshot" }, { "column": "policy_name" }, { "column": "target_business_days_snapshot" }, { "column": "current_state_code" }, { "column": "current_state_name" }, { "column": "started_at" }, { "column": "started_at_display" }, { "column": "due_at" }, { "column": "due_at_display" }, { "column": "at_risk_at" }, { "column": "at_risk_at_display" }, { "column": "breached_at" }, { "column": "breached_at_display" }, { "column": "completed_at" }, { "column": "completed_at_display" }, { "column": "cancelled_at" }, { "column": "cancelled_at_display" }, { "column": "completion_event" }, { "column": "ticket_id" }, { "column": "ticket_number" }, { "column": "origin_district_id" }, { "column": "origin_district_name" }, { "column": "origin_school_id" }, { "column": "origin_school_name" }, { "column": "logistics_case_id" }, { "column": "logistics_number" }, { "column": "repair_centre_location_id" }, { "column": "repair_job_id" }, { "column": "device_id" }, { "column": "effective_device_id" }, { "column": "source_workflow" }, { "column": "source_entity_type" }, { "column": "source_entity_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "sla_instance_id" }, "operation": "=", "value": "{{$_GET.id}}" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!sla.sla_instance_id || (permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && !scope_context.districts.flatten('id').contains(sla.origin_district_id) && !scope_context.schools.flatten('id').contains(sla.origin_school_id) && !scope_context.service_locations.flatten('id').contains(sla.repair_centre_location_id))}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "SLA record was not found." } } }] } } },
    { "name": "evaluation", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_sla_evaluation_queue", "columns": [{ "column": "calendar_id" }, { "column": "timezone_name" }, { "column": "evaluation_business_datetime" }, { "column": "due_business_date" }, { "column": "evaluation_business_date" }, { "column": "is_at_risk" }, { "column": "is_breached" }, { "column": "timezone_resolution_error" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{sla.sla_instance_id}}" }] } } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "sla": "{{sla}}", "evaluation": "{{evaluation}}" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "SLA record could not be loaded." } } }] }
}
