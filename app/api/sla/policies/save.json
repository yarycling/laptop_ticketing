{
  "settings": { "options": { "method": "post" } },
  "meta": { "$_POST": [
    { "name": "policy_id", "type": "number" }, { "name": "policy_code", "type": "text" },
    { "name": "name", "type": "text" }, { "name": "description", "type": "text" },
    { "name": "calendar_id", "type": "number" }, { "name": "target_business_days", "type": "number" },
    { "name": "status", "type": "text" }, { "name": "sort_order", "type": "number" },
    { "name": "start_event_code", "type": "text" }, { "name": "completion_event_code", "type": "text" },
    { "name": "pause_condition_code", "type": "text" }
  ] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_require_permission", "params": { "permission": "sla.manage" } } },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.name || $_POST.name.trim().length > 180 || !$_POST.calendar_id || !$_POST.target_business_days || floor($_POST.target_business_days) != $_POST.target_business_days || $_POST.target_business_days > 365 || !['active','inactive'].contains($_POST.status) || ($_POST.sort_order && (floor($_POST.sort_order) != $_POST.sort_order || $_POST.sort_order < 0))}}", "then": { "steps": [ { "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Enter a policy name, calendar, whole-number target from 1 to 365, and valid status/order." } } } ] } } },
    { "name": "calendar", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "sla_calendars", "columns": [ { "column": "id" } ], "wheres": { "condition": "AND", "rules": [ { "data": { "column": "id" }, "operation": "=", "value": "{{$_POST.calendar_id}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" } ] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!calendar.id}}", "then": { "steps": [ { "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Choose an active business calendar." } } } ] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_POST.policy_id}}", "then": { "steps": [
      { "name": "policy", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "sla_policies", "columns": [ { "column": "id" }, { "column": "policy_code" } ], "wheres": { "condition": "AND", "rules": [ { "data": { "column": "id" }, "operation": "=", "value": "{{$_POST.policy_id}}" } ] } } } },
      { "name": "latest_version", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "sla_policy_versions", "columns": [ { "column": "id" }, { "column": "version_number" }, { "column": "status" } ], "wheres": { "condition": "AND", "rules": [ { "data": { "column": "policy_id" }, "operation": "=", "value": "{{$_POST.policy_id}}" } ] }, "orders": [ { "column": "version_number", "direction": "desc" } ] } } },
      { "name": "next_version", "module": "core", "action": "setvalue", "output": true, "options": { "key": "next_version", "value": "{{latest_version.version_number + 1}}" } },
      { "module": "core", "action": "condition", "options": { "if": "{{!policy.id || !latest_version.id}}", "then": { "steps": [ { "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "SLA policy was not found." } } } ] } } }
    ] }, "else": { "steps": [
      { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.policy_code || $_POST.policy_code.trim().length > 50 || $_POST.policy_code.trim().contains(' ')}}", "then": { "steps": [ { "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Enter a valid new policy code." } } } ] } } },
      { "name": "next_version", "module": "core", "action": "setvalue", "output": true, "options": { "key": "next_version", "value": 1 } }
    ] } } },
    { "name": "policy_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "module": "core", "action": "condition", "options": { "if": "{{$_POST.policy_id}}", "then": { "steps": [
        { "name": "update_policy_metadata", "module": "dbupdater", "action": "update", "options": { "connection": "db", "sql": { "table": "sla_policies", "values": [ { "column": "updated_by", "value": "{{identity}}" }, { "column": "updated_at", "value": "{{NOW}}" } ], "wheres": { "condition": "AND", "rules": [ { "data": { "column": "id" }, "operation": "=", "value": "{{policy.id}}" } ] } } } },
        { "name": "insert_policy_version", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "sla_policy_versions", "values": [ { "column": "policy_id", "value": "{{policy.id}}" }, { "column": "version_number", "value": "{{next_version}}" }, { "column": "name", "value": "{{$_POST.name.trim()}}" }, { "column": "description", "value": "{{$_POST.description}}" }, { "column": "calendar_id", "value": "{{calendar.id}}" }, { "column": "target_business_days", "value": "{{$_POST.target_business_days}}" }, { "column": "status", "value": "{{$_POST.status}}" }, { "column": "sort_order", "value": "{{$_POST.sort_order || 100}}" }, { "column": "start_event_code", "value": "{{$_POST.start_event_code}}" }, { "column": "completion_event_code", "value": "{{$_POST.completion_event_code}}" }, { "column": "pause_condition_code", "value": "{{$_POST.pause_condition_code}}" }, { "column": "created_by", "value": "{{identity}}" } ] } } },
        { "name": "audit_policy_updated", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [ { "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "{{latest_version.status != $_POST.status ? ($_POST.status == 'active' ? 'sla.policy.activated' : 'sla.policy.deactivated') : 'sla.policy.updated'}}" }, { "column": "module", "value": "sla" }, { "column": "entity_type", "value": "sla_policy" }, { "column": "entity_id", "value": "{{policy.id}}" }, { "column": "description", "value": "{{'SLA policy ' + policy.policy_code + ' version ' + next_version + ' saved.'}}" }, { "column": "created_at", "value": "{{NOW}}" } ] } } }
      ] }, "else": { "steps": [
        { "name": "create_policy", "module": "dbupdater", "action": "insert", "output": true, "options": { "connection": "db", "sql": { "table": "sla_policies", "values": [ { "column": "policy_code", "value": "{{$_POST.policy_code.trim().uppercase()}}" }, { "column": "created_by", "value": "{{identity}}" }, { "column": "updated_by", "value": "{{identity}}" } ] } } },
        { "name": "create_policy_version", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "sla_policy_versions", "values": [ { "column": "policy_id", "value": "{{create_policy.identity}}" }, { "column": "version_number", "value": 1 }, { "column": "name", "value": "{{$_POST.name.trim()}}" }, { "column": "description", "value": "{{$_POST.description}}" }, { "column": "calendar_id", "value": "{{calendar.id}}" }, { "column": "target_business_days", "value": "{{$_POST.target_business_days}}" }, { "column": "status", "value": "{{$_POST.status}}" }, { "column": "sort_order", "value": "{{$_POST.sort_order || 100}}" }, { "column": "start_event_code", "value": "{{$_POST.start_event_code}}" }, { "column": "completion_event_code", "value": "{{$_POST.completion_event_code}}" }, { "column": "pause_condition_code", "value": "{{$_POST.pause_condition_code}}" }, { "column": "created_by", "value": "{{identity}}" } ] } } },
        { "name": "audit_policy_created", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [ { "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "sla.policy.created" }, { "column": "module", "value": "sla" }, { "column": "entity_type", "value": "sla_policy" }, { "column": "entity_id", "value": "{{create_policy.identity}}" }, { "column": "description", "value": "{{'SLA policy ' + $_POST.policy_code.trim().uppercase() + ' created.'}}" }, { "column": "created_at", "value": "{{NOW}}" } ] } } }
      ] } } }
    ] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "policy_id": "{{$_POST.policy_id || create_policy.identity}}", "version_number": "{{next_version}}" } } }
  ], "catch": [
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.code == 'ER_DUP_ENTRY' || ($_ERROR && $_ERROR.contains('Duplicate entry'))}}", "then": { "steps": [ { "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "A policy with this code or version already exists. Reload and retry." } } } ] } } },
    { "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "SLA policy could not be saved. No partial changes were committed." } } }
  ] }
}
