{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "meta": { "$_GET": [ { "name": "policy_id", "type": "number" } ] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "sla.view" } } },
    { "name": "policy", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_sla_policy_current", "columns": [ { "column": "policy_id" }, { "column": "policy_code" }, { "column": "policy_version_id" }, { "column": "version_number" }, { "column": "name" }, { "column": "description" }, { "column": "calendar_id" }, { "column": "calendar_code" }, { "column": "calendar_name" }, { "column": "target_business_days" }, { "column": "status" }, { "column": "sort_order" }, { "column": "start_event_code" }, { "column": "completion_event_code" }, { "column": "pause_condition_code" } ], "wheres": { "condition": "AND", "rules": [ { "data": { "column": "policy_id" }, "operation": "=", "value": "{{$_GET.policy_id}}" } ] } } } },
    { "name": "versions", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "sla_policy_versions", "alias": "v" }, "columns": [ { "table": "v", "column": "id", "alias": "policy_version_id" }, { "table": "v", "column": "version_number" }, { "table": "v", "column": "name" }, { "table": "v", "column": "description" }, { "table": "v", "column": "calendar_id" }, { "table": "c", "column": "name", "alias": "calendar_name" }, { "table": "v", "column": "target_business_days" }, { "table": "v", "column": "status" }, { "table": "v", "column": "sort_order" }, { "table": "v", "column": "start_event_code" }, { "table": "v", "column": "completion_event_code" }, { "table": "v", "column": "pause_condition_code" }, { "table": "v", "column": "created_by" }, { "table": "v", "column": "created_at" } ], "joins": [ { "table": "sla_calendars", "alias": "c", "type": "inner", "clauses": { "condition": "AND", "rules": [ { "table": "c", "column": "id", "operation": "=", "value": { "table": "v", "column": "calendar_id" } } ] } } ], "wheres": { "condition": "AND", "rules": [ { "data": { "table": "v", "column": "policy_id" }, "operation": "=", "value": "{{$_GET.policy_id}}" } ] }, "orders": [ { "table": "v", "column": "version_number", "direction": "desc" } ] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "policy": "{{policy}}", "versions": "{{versions}}" } } }
  ], "catch": [ { "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "SLA policy history could not be loaded." } } } ] }
}
