{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "meta": { "$_GET": [{ "name": "ticket_id", "type": "number" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_require_permission", "params": { "permission": "sla.view" } } },
    { "name": "scope_context", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_get_scope_context", "params": {} } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_GET.ticket_id || $_GET.ticket_id < 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "A valid ticket is required." } } }] } } },
    { "name": "ticket", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "tickets", "columns": [{ "column": "id" }, { "column": "origin_district_id" }, { "column": "origin_school_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{$_GET.ticket_id}}" }] } } } },
    { "name": "repair_scope", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_logistics_case_detail_context", "columns": [{ "column": "ticket_id" }, { "column": "repair_centre_location_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "ticket_id" }, "operation": "=", "value": "{{ticket.id}}" }, { "data": { "column": "repair_centre_location_id" }, "operation": "in", "conditional": "{{scope_context.service_locations.length > 0}}", "value": "{{scope_context.service_locations.flatten('id')}}" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!ticket.id || (permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && !scope_context.districts.flatten('id').contains(ticket.origin_district_id) && !scope_context.schools.flatten('id').contains(ticket.origin_school_id) && !(scope_context.service_locations.length > 0 && repair_scope.ticket_id))}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Ticket was not found." } } }] } } },
    { "name": "instances", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": "v_sla_operational_queue", "columns": [{ "column": "sla_instance_id" }, { "column": "policy_code_snapshot" }, { "column": "policy_name" }, { "column": "target_business_days_snapshot" }, { "column": "current_state_code" }, { "column": "current_state_name" }, { "column": "started_at" }, { "column": "started_at_display" }, { "column": "due_at" }, { "column": "due_at_display" }, { "column": "completed_at" }, { "column": "completed_at_display" }, { "column": "completion_event" }, { "column": "source_workflow" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "ticket_id" }, "operation": "=", "value": "{{ticket.id}}" }] }, "orders": [{ "column": "started_at", "direction": "desc" }, { "column": "sla_instance_id", "direction": "desc" }] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "slas": "{{instances}}" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Ticket SLA summary could not be loaded." } } }] }
}
