{
  "settings": { "options": { "method": "post", "nocsrf": true } },
  "meta": { "$_POST": [{ "name": "logistics_case_id", "type": "number" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "logistics.accept" } }, "output": true },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "name": "ttpost_role", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "user_roles", "alias": "ur" }, "columns": [{ "table": "r", "column": "name", "alias": "role_name" }], "joins": [{ "table": "roles", "alias": "r", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "r", "column": "id", "operation": "=", "value": { "table": "ur", "column": "role_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "ur", "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "table": "r", "column": "name" }, "operation": "=", "value": "TTPOST_LOGISTICS" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !ttpost_role.role_name}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Only TTPost Logistics can accept a pickup request." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.logistics_case_id || $_POST.logistics_case_id < 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "A valid logistics case is required." } } }] } } },
    { "name": "accepted_status", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "logistics_statuses", "columns": [{ "column": "id" }, { "column": "code" }, { "column": "name" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "ACCEPTED" }, { "data": { "column": "is_active" }, "operation": "=", "value": 1 }] } } } },
    { "name": "accept_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "current_case", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "v_logistics_current_context", "alias": "lc" }, "columns": [{ "table": "lc", "column": "logistics_case_id", "alias": "id" }, { "table": "lc", "column": "logistics_number" }, { "table": "lc", "column": "ticket_id" }, { "table": "lc", "column": "ticket_number" }, { "table": "lc", "column": "current_logistics_status_id", "alias": "current_status_id" }, { "table": "lc", "column": "current_logistics_status_code", "alias": "status_code" }, { "table": "lc", "column": "ticket_current_status_code", "alias": "ticket_status_code" }, { "table": "lc", "column": "is_active" }, { "table": "lc", "column": "pending_handoff_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "lc", "column": "logistics_case_id" }, "operation": "=", "value": "{{$_POST.logistics_case_id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!current_case.id || current_case.is_active != 1 || current_case.status_code != 'REQUESTED' || current_case.ticket_status_code != 'APPROVED_FOR_PICKUP' || current_case.pending_handoff_id || !accepted_status.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7B_ACCEPT_STATE_CONFLICT" } }] } } },
      { "name": "case_update", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_logistics_cases", "values": [{ "column": "current_status_id", "value": "{{accepted_status.id}}" }, { "column": "updated_by_user_id", "value": "{{identity}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{current_case.id}}" }, { "data": { "column": "current_status_id" }, "operation": "=", "value": "{{current_case.current_status_id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "closed_at" }, "operator": "is_null" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{case_update.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7B_ACCEPT_STATE_CONFLICT" } }] } } },
      { "name": "accept_history", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "logistics_status_history", "values": [{ "column": "logistics_case_id", "value": "{{current_case.id}}" }, { "column": "from_status_id", "value": "{{current_case.current_status_id}}" }, { "column": "to_status_id", "value": "{{accepted_status.id}}" }, { "column": "changed_by_user_id", "value": "{{identity}}" }] } } },
      { "name": "accept_audit", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "logistics_request_accepted" }, { "column": "module", "value": "logistics" }, { "column": "entity_type", "value": "ticket_logistics_case" }, { "column": "entity_id", "value": "{{current_case.id}}" }, { "column": "description", "value": "{{'Accepted ' + current_case.logistics_number + ' for ticket ' + current_case.ticket_number}}" }] } } }
    ] } } },
    { "name": "accepted_case", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "logistics_status_history", "alias": "h" }, "columns": [{ "table": "h", "column": "logistics_case_id" }, { "table": "h", "column": "changed_at", "alias": "accepted_at" }, { "table": "u", "column": "display_name", "alias": "accepted_by_display_name" }, { "table": "lc", "column": "logistics_number" }], "joins": [{ "table": "users", "alias": "u", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "u", "column": "id", "operation": "=", "value": { "table": "h", "column": "changed_by_user_id" } }] } }, { "table": "ticket_logistics_cases", "alias": "lc", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "lc", "column": "id", "operation": "=", "value": { "table": "h", "column": "logistics_case_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "h", "column": "logistics_case_id" }, "operation": "=", "value": "{{$_POST.logistics_case_id}}" }, { "data": { "table": "h", "column": "to_status_id" }, "operation": "=", "value": "{{accepted_status.id}}" }] }, "orders": [{ "table": "h", "column": "changed_at", "direction": "desc" }], "limit": 1 } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "logistics_case_id": "{{accepted_case.logistics_case_id}}", "logistics_number": "{{accepted_case.logistics_number}}", "status_code": "ACCEPTED", "accepted_at": "{{accepted_case.accepted_at}}", "accepted_by_display_name": "{{accepted_case.accepted_by_display_name}}" } } }
  ], "catch": [{ "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P7B_ACCEPT_STATE_CONFLICT'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "This pickup request is no longer awaiting acceptance. Reload the queue and try again." } } }] } } }, { "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The pickup request could not be accepted because its state changed." } } }] }
}
