{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "exec": {
    "steps": [
      { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "logistics.view" } }, "output": true },
      { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
      { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
      { "name": "ttpost_role", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "user_roles", "alias": "ur" }, "columns": [{ "table": "r", "column": "name", "alias": "role_name" }], "joins": [{ "table": "roles", "alias": "r", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "r", "column": "id", "operation": "=", "value": { "table": "ur", "column": "role_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "ur", "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "table": "r", "column": "name" }, "operation": "=", "value": "TTPOST_LOGISTICS" }] } } } },
      { "name": "repair_role", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "user_roles", "alias": "ur" }, "columns": [{ "table": "r", "column": "name", "alias": "role_name" }], "joins": [{ "table": "roles", "alias": "r", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "r", "column": "id", "operation": "=", "value": { "table": "ur", "column": "role_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "ur", "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "table": "r", "column": "name" }, "operation": "=", "value": "REPAIR_CENTRE" }] } } } },
      { "name": "active_cases", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": {
        "table": { "name": "v_logistics_current_context", "alias": "lc" },
        "columns": [{ "table": "lc", "column": "current_logistics_status_code" }, { "table": "p", "column": "physical_state_code" }],
        "joins": [{ "table": "v_logistics_physical_custody", "alias": "p", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "p", "column": "logistics_case_id", "operation": "=", "value": { "table": "lc", "column": "logistics_case_id" } }] } }],
        "wheres": { "condition": "AND", "rules": [
          { "data": { "table": "lc", "column": "active_record_key" }, "operation": "=", "value": 1 },
          { "data": { "table": "lc", "column": "closed_at" }, "operator": "is_null" },
          { "condition": "OR", "rules": [
            { "condition": "AND", "conditional": "{{permission.bypass == 'SUPER_ADMIN' || ttpost_role.role_name == 'TTPOST_LOGISTICS'}}", "rules": [{ "data": { "table": "lc", "column": "logistics_case_id" }, "operation": ">", "value": 0 }] },
            { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && repair_role.role_name == 'REPAIR_CENTRE' && scope_context.service_locations.length > 0}}", "rules": [{ "data": { "table": "p", "column": "repair_centre_location_id" }, "operation": "in", "value": "{{scope_context.service_locations.flatten('id')}}" }, { "condition": "OR", "rules": [{ "data": { "table": "p", "column": "physical_state_code" }, "operation": "=", "value": "PENDING_REPAIR_CENTRE_RECEIPT" }, { "data": { "table": "p", "column": "physical_state_code" }, "operation": "=", "value": "REPAIR_CENTRE_CUSTODY" }] }] },
            { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && repair_role.role_name != 'REPAIR_CENTRE' && ttpost_role.role_name != 'TTPOST_LOGISTICS' && scope_context.has_national_scope}}", "rules": [{ "data": { "table": "lc", "column": "logistics_case_id" }, "operation": ">", "value": 0 }] },
            { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && repair_role.role_name != 'REPAIR_CENTRE' && ttpost_role.role_name != 'TTPOST_LOGISTICS' && !scope_context.has_national_scope && scope_context.districts.length > 0}}", "rules": [{ "data": { "table": "lc", "column": "pickup_district_id" }, "operation": "in", "value": "{{scope_context.districts.flatten('id')}}" }] },
            { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && repair_role.role_name != 'REPAIR_CENTRE' && ttpost_role.role_name != 'TTPOST_LOGISTICS' && !scope_context.has_national_scope && scope_context.districts.length == 0 && scope_context.schools.length > 0}}", "rules": [{ "data": { "table": "lc", "column": "pickup_school_id" }, "operation": "in", "value": "{{scope_context.schools.flatten('id')}}" }] },
            { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && repair_role.role_name != 'REPAIR_CENTRE' && ttpost_role.role_name != 'TTPOST_LOGISTICS' && !scope_context.has_national_scope && scope_context.districts.length == 0 && scope_context.schools.length == 0}}", "rules": [{ "data": { "table": "lc", "column": "logistics_case_id" }, "operation": "=", "value": -1 }] }
          ] }
        ] }
      } } },
      { "name": "requested_count", "module": "core", "action": "setvalue", "options": { "key": "requested_count", "value": "{{active_cases.where('current_logistics_status_code', '==', 'REQUESTED').count()}}" }, "output": true },
      { "name": "accepted_count", "module": "core", "action": "setvalue", "options": { "key": "accepted_count", "value": "{{active_cases.where('current_logistics_status_code', '==', 'ACCEPTED').count()}}" }, "output": true },
      { "name": "awaiting_school_handoff", "module": "core", "action": "setvalue", "options": { "key": "awaiting_school_handoff", "value": "{{active_cases.where('physical_state_code', '==', 'AWAITING_SCHOOL_HANDOFF').count()}}" }, "output": true },
      { "name": "pending_ttpost_receipt", "module": "core", "action": "setvalue", "options": { "key": "pending_ttpost_receipt", "value": "{{active_cases.where('physical_state_code', '==', 'PENDING_TTPOST_RECEIPT').count()}}" }, "output": true },
      { "name": "ttpost_custody", "module": "core", "action": "setvalue", "options": { "key": "ttpost_custody", "value": "{{active_cases.where('physical_state_code', '==', 'TTPOST_CUSTODY').count()}}" }, "output": true },
      { "name": "pending_repair_centre_receipt", "module": "core", "action": "setvalue", "options": { "key": "pending_repair_centre_receipt", "value": "{{active_cases.where('physical_state_code', '==', 'PENDING_REPAIR_CENTRE_RECEIPT').count()}}" }, "output": true },
      { "name": "repair_centre_custody", "module": "core", "action": "setvalue", "options": { "key": "repair_centre_custody", "value": "{{active_cases.where('physical_state_code', '==', 'REPAIR_CENTRE_CUSTODY').count()}}" }, "output": true },
      { "name": "pending_ttpost_return_receipt", "module": "core", "action": "setvalue", "options": { "key": "pending_ttpost_return_receipt", "value": "{{active_cases.where('physical_state_code', '==', 'PENDING_TTPOST_RETURN_RECEIPT').count()}}" }, "output": true },
      { "name": "ttpost_return_custody", "module": "core", "action": "setvalue", "options": { "key": "ttpost_return_custody", "value": "{{active_cases.where('physical_state_code', '==', 'TTPOST_RETURN_CUSTODY').count()}}" }, "output": true },
      { "name": "pending_school_return_receipt", "module": "core", "action": "setvalue", "options": { "key": "pending_school_return_receipt", "value": "{{active_cases.where('physical_state_code', '==', 'PENDING_SCHOOL_RETURN_RECEIPT').count()}}" }, "output": true },
      { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "active_total": "{{active_cases.length}}", "requested": "{{requested_count}}", "accepted": "{{accepted_count}}", "other_active": "{{active_cases.length - requested_count - accepted_count}}", "awaiting_school_handoff": "{{awaiting_school_handoff}}", "pending_ttpost_receipt": "{{pending_ttpost_receipt}}", "ttpost_custody": "{{ttpost_custody}}", "pending_repair_centre_receipt": "{{pending_repair_centre_receipt}}", "repair_centre_custody": "{{repair_centre_custody}}", "pending_ttpost_return_receipt": "{{pending_ttpost_return_receipt}}", "ttpost_return_custody": "{{ttpost_return_custody}}", "pending_school_return_receipt": "{{pending_school_return_receipt}}" } } }
    ],
    "catch": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Logistics summary could not be loaded." } } }]
  }
}
