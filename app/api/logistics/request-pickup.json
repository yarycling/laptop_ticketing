{
  "settings": { "options": { "method": "post", "nocsrf": true } },
  "meta": { "$_POST": [{ "name": "ticket_id", "type": "number" }] },
  "exec": {
    "steps": [
      { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "logistics.request_pickup" } }, "output": true },
      { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
      { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
      { "name": "request_roles", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "user_roles", "alias": "ur" }, "columns": [{ "table": "r", "column": "name", "alias": "role_name" }], "joins": [{ "table": "roles", "alias": "r", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "r", "column": "id", "operation": "=", "value": { "table": "ur", "column": "role_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "ur", "column": "user_id" }, "operation": "=", "value": "{{identity}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.ticket_id || $_POST.ticket_id < 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Provide a valid ticket." } } }] } } },
      { "name": "ticket", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": {
        "table": { "name": "tickets", "alias": "t" },
        "columns": [{ "table": "t", "column": "id" }, { "table": "t", "column": "ticket_number" }, { "table": "t", "column": "device_id" }, { "table": "t", "column": "origin_school_id" }, { "table": "t", "column": "origin_district_id" }, { "table": "ts", "column": "code", "alias": "ticket_status_code" }, { "table": "school", "column": "name", "alias": "pickup_school_name" }, { "table": "school", "column": "district_id", "alias": "school_district_id" }],
        "joins": [
          { "table": "ticket_statuses", "alias": "ts", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ts", "column": "id", "operation": "=", "value": { "table": "t", "column": "current_status_id" } }] } },
          { "table": "schools", "alias": "school", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "school", "column": "id", "operation": "=", "value": { "table": "t", "column": "origin_school_id" } }] } }
        ],
        "wheres": { "condition": "AND", "rules": [{ "data": { "table": "t", "column": "id" }, "operation": "=", "value": "{{$_POST.ticket_id}}" }] }
      } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!ticket.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Ticket was not found." } } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !((request_roles.flatten('role_name').contains('SCHOOL_ADMINISTRATOR') && scope_context.schools.flatten('id').contains(ticket.origin_school_id)) || (request_roles.flatten('role_name').contains('ICT_DISTRICT_COORDINATOR') && scope_context.districts.flatten('id').contains(ticket.origin_district_id)))}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{ticket.ticket_status_code != 'APPROVED_FOR_PICKUP'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "Pickup can only be requested after District approval." } } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!ticket.device_id || !ticket.origin_school_id || ticket.school_district_id != ticket.origin_district_id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The approved ticket has incomplete or inconsistent origin details." } } }] } } },
      { "name": "existing_ticket_case", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_logistics_cases", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "ticket_id" }, "operation": "=", "value": "{{ticket.id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "closed_at" }, "operator": "is_null" }] } } } },
      { "name": "existing_device_case", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_logistics_cases", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "device_id" }, "operation": "=", "value": "{{ticket.device_id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "closed_at" }, "operator": "is_null" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{existing_ticket_case.id || existing_device_case.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "This ticket or device already has an active pickup request." } } }] } } },
      { "name": "request_uuid", "module": "core", "action": "randomUUID", "output": true, "options": {} },
      { "name": "request_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
        { "name": "current_ticket", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "tickets", "alias": "t" }, "columns": [{ "table": "t", "column": "id" }, { "table": "t", "column": "ticket_number" }, { "table": "t", "column": "device_id" }, { "table": "t", "column": "origin_school_id" }, { "table": "t", "column": "origin_district_id" }, { "table": "ts", "column": "code", "alias": "ticket_status_code" }, { "table": "school", "column": "name", "alias": "pickup_school_name" }, { "table": "school", "column": "district_id", "alias": "school_district_id" }], "joins": [{ "table": "ticket_statuses", "alias": "ts", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ts", "column": "id", "operation": "=", "value": { "table": "t", "column": "current_status_id" } }] } }, { "table": "schools", "alias": "school", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "school", "column": "id", "operation": "=", "value": { "table": "t", "column": "origin_school_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "t", "column": "id" }, "operation": "=", "value": "{{ticket.id}}" }] } } } },
        { "name": "requested_status", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "logistics_statuses", "columns": [{ "column": "id" }, { "column": "code" }, { "column": "name" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "REQUESTED" }, { "data": { "column": "is_active" }, "operation": "=", "value": 1 }] } } } },
        { "name": "active_ticket_case", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_logistics_cases", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "ticket_id" }, "operation": "=", "value": "{{current_ticket.id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "closed_at" }, "operator": "is_null" }] } } } },
        { "name": "active_device_case", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_logistics_cases", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "device_id" }, "operation": "=", "value": "{{current_ticket.device_id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "closed_at" }, "operator": "is_null" }] } } } },
        { "name": "active_stock", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_device_current_stock_location", "columns": [{ "column": "stock_location_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "device_id" }, "operation": "=", "value": "{{current_ticket.device_id}}" }] } } } },
        { "module": "core", "action": "condition", "options": { "if": "{{!current_ticket.id || current_ticket.ticket_status_code != 'APPROVED_FOR_PICKUP' || !current_ticket.device_id || !current_ticket.origin_school_id || current_ticket.school_district_id != current_ticket.origin_district_id || !requested_status.id || active_ticket_case.id || active_device_case.id || active_stock.stock_location_id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7B_PICKUP_STATE_CONFLICT" } }] } } },
        { "name": "create_case", "module": "dbupdater", "action": "insert", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_logistics_cases", "values": [{ "column": "logistics_number", "value": "{{'TMP-' + request_uuid}}" }, { "column": "ticket_id", "value": "{{current_ticket.id}}" }, { "column": "device_id", "value": "{{current_ticket.device_id}}" }, { "column": "pickup_school_id", "value": "{{current_ticket.origin_school_id}}" }, { "column": "repair_centre_location_id", "value": null }, { "column": "current_status_id", "value": "{{requested_status.id}}" }, { "column": "requested_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss')}}" }, { "column": "created_by_user_id", "value": "{{identity}}" }, { "column": "active_record_key", "value": 1 }] } } },
        { "name": "finalize_logistics_number", "module": "dbupdater", "action": "update", "options": { "connection": "db", "sql": { "table": "ticket_logistics_cases", "values": [{ "column": "logistics_number", "value": "{{'LOG' + create_case.identity.padNumber(8)}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{create_case.identity}}" }] } } } },
        { "name": "initial_history", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "logistics_status_history", "values": [{ "column": "logistics_case_id", "value": "{{create_case.identity}}" }, { "column": "from_status_id", "value": null }, { "column": "to_status_id", "value": "{{requested_status.id}}" }, { "column": "changed_by_user_id", "value": "{{identity}}" }] } } },
        { "name": "request_audit", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "logistics_pickup_requested" }, { "column": "module", "value": "logistics" }, { "column": "entity_type", "value": "ticket_logistics_case" }, { "column": "entity_id", "value": "{{create_case.identity}}" }, { "column": "description", "value": "{{'Created LOG' + create_case.identity.padNumber(8) + ' for ticket ' + current_ticket.ticket_number + ' at ' + current_ticket.pickup_school_name}}" }] } } }
      ] } } },
    { "name": "created_case", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_logistics_cases", "columns": [{ "column": "id" }, { "column": "logistics_number" }, { "column": "requested_at" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{create_case.identity}}" }] } } } },
    { "name": "notify_pickup_requested", "module": "core", "action": "exec", "options": { "exec": "notification_from_workflow", "params": { "event_type_code": "LOGISTICS_PICKUP_REQUESTED", "ticket_id": "{{current_ticket.id}}", "logistics_case_id": "{{created_case.id}}", "source_id": "{{created_case.id}}", "actor_user_id": "{{identity}}", "message": "A pickup request for {{created_case.logistics_number}} is ready for TTPost action." } } },
      { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "logistics_case_id": "{{created_case.id}}", "logistics_number": "{{created_case.logistics_number}}", "status_code": "REQUESTED", "status_name": "Requested", "requested_at": "{{created_case.requested_at}}" } } }
    ],
    "catch": [
      { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P7B_PICKUP_STATE_CONFLICT'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The ticket or device changed or already has an active pickup request. Reload and try again." } } }] } } },
      { "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The pickup request could not be created because the ticket or device already has an active request." } } }
    ]
  }
}
