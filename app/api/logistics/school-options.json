{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "meta": { "$_GET": [{ "name": "district_id", "type": "number" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "logistics.view" } }, "output": true },
    { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "name": "ttpost_role", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "user_roles", "alias": "ur" }, "columns": [{ "table": "r", "column": "name", "alias": "role_name" }], "joins": [{ "table": "roles", "alias": "r", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "r", "column": "id", "operation": "=", "value": { "table": "ur", "column": "role_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "ur", "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "table": "r", "column": "name" }, "operation": "=", "value": "TTPOST_LOGISTICS" }] } } } },
    { "name": "schools", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": {
      "table": { "name": "v_logistics_current_context", "alias": "lc" },
      "distinct": true,
      "columns": [{ "table": "lc", "column": "pickup_school_id", "alias": "id" }, { "table": "lc", "column": "pickup_school_name", "alias": "name" }, { "table": "lc", "column": "pickup_district_id", "alias": "district_id" }],
      "wheres": { "condition": "AND", "rules": [
        { "data": { "table": "lc", "column": "active_record_key" }, "operation": "=", "value": 1 },
        { "data": { "table": "lc", "column": "closed_at" }, "operator": "is_null" },
        { "condition": "AND", "conditional": "{{$_GET.district_id}}", "rules": [{ "data": { "table": "lc", "column": "pickup_district_id" }, "operation": "=", "value": "{{$_GET.district_id}}" }] },
        { "condition": "OR", "rules": [
          { "condition": "AND", "conditional": "{{permission.bypass == 'SUPER_ADMIN' || ttpost_role.role_name == 'TTPOST_LOGISTICS' || scope_context.has_national_scope}}", "rules": [{ "data": { "table": "lc", "column": "logistics_case_id" }, "operation": ">", "value": 0 }] },
          { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && ttpost_role.role_name != 'TTPOST_LOGISTICS' && !scope_context.has_national_scope && scope_context.districts.length > 0}}", "rules": [{ "data": { "table": "lc", "column": "pickup_district_id" }, "operation": "in", "value": "{{scope_context.districts.flatten('id')}}" }] },
          { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && ttpost_role.role_name != 'TTPOST_LOGISTICS' && !scope_context.has_national_scope && scope_context.districts.length == 0 && scope_context.schools.length > 0}}", "rules": [{ "data": { "table": "lc", "column": "pickup_school_id" }, "operation": "in", "value": "{{scope_context.schools.flatten('id')}}" }] },
          { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && ttpost_role.role_name != 'TTPOST_LOGISTICS' && !scope_context.has_national_scope && scope_context.districts.length == 0 && scope_context.schools.length == 0}}", "rules": [{ "data": { "table": "lc", "column": "logistics_case_id" }, "operation": "=", "value": -1 }] }
        ] }
      ] },
      "orders": [{ "table": "lc", "column": "pickup_school_name", "direction": "asc" }]
    } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "schools": "{{schools}}" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Logistics school options could not be loaded." } } }] }
}
