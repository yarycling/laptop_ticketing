{
  "settings": { "options": { "method": "post", "nocsrf": true } },
  "meta": { "$_POST": [{ "name": "logistics_case_id", "type": "number" }, { "name": "scan_reference", "type": "text" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "logistics.repair_receive" } }, "output": true },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "name": "repair_role", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "user_roles", "alias": "ur" }, "columns": [{ "table": "r", "column": "name", "alias": "role_name" }], "joins": [{ "table": "roles", "alias": "r", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "r", "column": "id", "operation": "=", "value": { "table": "ur", "column": "role_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "ur", "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "table": "r", "column": "name" }, "operation": "=", "value": "REPAIR_CENTRE" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !repair_role.role_name}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Only an authorized Repair Centre user may confirm receipt." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.logistics_case_id || $_POST.logistics_case_id < 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "A valid logistics case is required." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_POST.scan_reference && $_POST.scan_reference.length > 255}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "The scan reference exceeds the allowed length." } } }] } } },
    { "name": "case_precheck", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_logistics_current_context", "columns": [{ "column": "logistics_case_id" }, { "column": "logistics_number" }, { "column": "ticket_id" }, { "column": "ticket_number" }, { "column": "device_id" }, { "column": "current_logistics_status_code" }, { "column": "ticket_current_status_code" }, { "column": "is_active" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "logistics_case_id" }, "operation": "=", "value": "{{$_POST.logistics_case_id}}" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!case_precheck.logistics_case_id || case_precheck.is_active != 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Active logistics case was not found." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{case_precheck.current_logistics_status_code != 'OUTBOUND_IN_TRANSIT' || case_precheck.ticket_current_status_code != 'IN_TRANSIT'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The case is not awaiting Repair Centre receipt." } } }] } } },
    { "name": "repair_status", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "logistics_statuses", "columns": [{ "column": "id" }, { "column": "code" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "AT_REPAIR_CENTRE" }, { "data": { "column": "is_active" }, "operation": "=", "value": 1 }] } } } },
    { "name": "under_repair_status", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_statuses", "columns": [{ "column": "id" }, { "column": "code" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "UNDER_REPAIR" }, { "data": { "column": "is_active" }, "operation": "=", "value": 1 }] } } } },
    { "name": "in_repair_lifecycle", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "device_lifecycle_statuses", "columns": [{ "column": "id" }, { "column": "code" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "IN_REPAIR" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
    { "name": "receive_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "current_case", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_logistics_current_context", "columns": [{ "column": "logistics_case_id" }, { "column": "logistics_number" }, { "column": "ticket_id" }, { "column": "ticket_number" }, { "column": "device_id" }, { "column": "repair_centre_location_id" }, { "column": "current_logistics_status_id", "alias": "logistics_status_id" }, { "column": "current_logistics_status_code" }, { "column": "ticket_current_status_id" }, { "column": "ticket_current_status_code" }, { "column": "is_active" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "logistics_case_id" }, "operation": "=", "value": "{{$_POST.logistics_case_id}}" }] } } } },
      { "name": "pending_handoff", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "logistics_handoffs", "columns": [{ "column": "id" }, { "column": "handoff_type" }, { "column": "received_at" }, { "column": "active_record_key" }, { "column": "to_service_location_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "logistics_case_id" }, "operation": "=", "value": "{{current_case.logistics_case_id}}" }, { "data": { "column": "handoff_type" }, "operation": "=", "value": "TTPOST_TO_REPAIR_CENTRE" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "received_at" }, "operator": "is_null" }] } } } },
      { "name": "destination", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "service_locations", "columns": [{ "column": "id" }, { "column": "name" }, { "column": "location_type" }, { "column": "is_active" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{pending_handoff.to_service_location_id}}" }] } } } },
      { "name": "user_location_scope", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "user_service_location_scopes", "alias": "usls" }, "columns": [{ "table": "usls", "column": "id" }], "joins": [{ "table": "service_locations", "alias": "loc", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "loc", "column": "id", "operation": "=", "value": { "table": "usls", "column": "service_location_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "usls", "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "table": "usls", "column": "service_location_id" }, "operation": "=", "value": "{{pending_handoff.to_service_location_id}}" }, { "data": { "table": "usls", "column": "status" }, "operation": "=", "value": "active" }, { "data": { "table": "loc", "column": "location_type" }, "operation": "=", "value": "REPAIR_CENTRE" }, { "data": { "table": "loc", "column": "is_active" }, "operation": "=", "value": 1 }] } } } },
      { "name": "physical", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_logistics_physical_custody", "columns": [{ "column": "physical_state_code" }, { "column": "pending_handoff_id" }, { "column": "pending_handoff_type" }, { "column": "pending_repair_handoff_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "logistics_case_id" }, "operation": "=", "value": "{{current_case.logistics_case_id}}" }] } } } },
      { "name": "ticket_check", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "tickets", "columns": [{ "column": "id" }, { "column": "device_id" }, { "column": "current_status_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{current_case.ticket_id}}" }] } } } },
      { "name": "device_check", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "devices", "alias": "dv" }, "columns": [{ "table": "dv", "column": "id" }, { "table": "dv", "column": "lifecycle_status_id" }, { "table": "ls", "column": "code", "alias": "lifecycle_code" }], "joins": [{ "table": "device_lifecycle_statuses", "alias": "ls", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ls", "column": "id", "operation": "=", "value": { "table": "dv", "column": "lifecycle_status_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "dv", "column": "id" }, "operation": "=", "value": "{{current_case.device_id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!current_case.logistics_case_id || current_case.is_active != 1 || current_case.current_logistics_status_code != 'OUTBOUND_IN_TRANSIT' || current_case.ticket_current_status_code != 'IN_TRANSIT' || !pending_handoff.id || pending_handoff.handoff_type != 'TTPOST_TO_REPAIR_CENTRE' || pending_handoff.received_at || pending_handoff.active_record_key != 1 || !destination.id || destination.location_type != 'REPAIR_CENTRE' || destination.is_active != 1 || current_case.repair_centre_location_id != pending_handoff.to_service_location_id || physical.physical_state_code != 'PENDING_REPAIR_CENTRE_RECEIPT' || physical.pending_repair_handoff_id != pending_handoff.id || !ticket_check.id || ticket_check.device_id != current_case.device_id || ticket_check.current_status_id != current_case.ticket_current_status_id || !device_check.id || !repair_status.id || !under_repair_status.id || !in_repair_lifecycle.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7D_RECEIVE_STATE_CONFLICT" } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && (!repair_role.role_name || !user_location_scope.id)}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7D_RECEIVE_SCOPE_CONFLICT" } }] } } },
      { "name": "complete_handoff", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "logistics_handoffs", "values": [{ "column": "received_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss')}}" }, { "column": "received_by_user_id", "value": "{{identity}}" }, { "column": "active_record_key", "value": null }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{pending_handoff.id}}" }, { "data": { "column": "received_at" }, "operator": "is_null" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{complete_handoff.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7D_RECEIVE_STATE_CONFLICT" } }] } } },
      { "name": "receive_scan", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "logistics_handoff_scans", "values": [{ "column": "logistics_handoff_id", "value": "{{pending_handoff.id}}" }, { "column": "scan_type", "value": "RECEIVE" }, { "column": "scan_method", "value": "MANUAL" }, { "column": "scan_reference", "value": "{{($_POST.scan_reference || '').trim() || null}}" }, { "column": "scanned_by_user_id", "value": "{{identity}}" }] } } },
      { "name": "update_logistics_case", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_logistics_cases", "values": [{ "column": "current_status_id", "value": "{{repair_status.id}}" }, { "column": "updated_by_user_id", "value": "{{identity}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{current_case.logistics_case_id}}" }, { "data": { "column": "current_status_id" }, "operation": "=", "value": "{{current_case.logistics_status_id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "closed_at" }, "operator": "is_null" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{update_logistics_case.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7D_RECEIVE_STATE_CONFLICT" } }] } } },
      { "name": "logistics_history", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "logistics_status_history", "values": [{ "column": "logistics_case_id", "value": "{{current_case.logistics_case_id}}" }, { "column": "from_status_id", "value": "{{current_case.logistics_status_id}}" }, { "column": "to_status_id", "value": "{{repair_status.id}}" }, { "column": "changed_by_user_id", "value": "{{identity}}" }] } } },
      { "name": "update_ticket", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "tickets", "values": [{ "column": "current_status_id", "value": "{{under_repair_status.id}}" }, { "column": "updated_by_user_id", "value": "{{identity}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{current_case.ticket_id}}" }, { "data": { "column": "current_status_id" }, "operation": "=", "value": "{{current_case.ticket_current_status_id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{update_ticket.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7D_RECEIVE_STATE_CONFLICT" } }] } } },
      { "name": "ticket_history", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "ticket_status_history", "values": [{ "column": "ticket_id", "value": "{{current_case.ticket_id}}" }, { "column": "from_status_id", "value": "{{current_case.ticket_current_status_id}}" }, { "column": "to_status_id", "value": "{{under_repair_status.id}}" }, { "column": "changed_by_user_id", "value": "{{identity}}" }] } } },
      { "name": "update_device", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "devices", "values": [{ "column": "lifecycle_status_id", "value": "{{in_repair_lifecycle.id}}" }, { "column": "updated_by_user_id", "value": "{{identity}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{current_case.device_id}}" }, { "data": { "column": "lifecycle_status_id" }, "operation": "=", "value": "{{device_check.lifecycle_status_id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{update_device.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7D_RECEIVE_STATE_CONFLICT" } }] } } },
      { "name": "receive_audit", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "logistics_repair_centre_received" }, { "column": "module", "value": "logistics" }, { "column": "entity_type", "value": "logistics_handoff" }, { "column": "entity_id", "value": "{{pending_handoff.id}}" }, { "column": "description", "value": "{{'Repair Centre received ' + current_case.logistics_number + ' for ticket ' + current_case.ticket_number + ' at ' + destination.name}}" }] } } },
      { "name": "sla_diagnosis_start", "module": "core", "action": "exec", "output": true, "options": { "exec": "sla_start", "params": { "policy_code": "DIAGNOSIS", "idempotency_key": "{{'DIAGNOSIS:LOGISTICS:' + current_case.logistics_case_id}}", "ticket_id": "{{current_case.ticket_id}}", "ticket_number": "{{current_case.ticket_number}}", "logistics_case_id": "{{current_case.logistics_case_id}}", "repair_job_id": null, "device_id": "{{current_case.device_id}}", "effective_device_id": "{{current_case.device_id}}", "source_workflow": "REPAIR_CENTRE_DIAGNOSIS", "source_entity_type": "logistics_handoff", "source_entity_id": "{{pending_handoff.id}}", "started_at": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss.SSS')}}", "actor_user_id": "{{identity}}" } } }
    ] } } },
    { "name": "received_details", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "v_logistics_physical_custody", "alias": "p" }, "columns": [{ "table": "p", "column": "logistics_case_id" }, { "table": "p", "column": "logistics_number" }, { "table": "p", "column": "ticket_status_code" }, { "table": "p", "column": "logistics_status_code" }, { "table": "p", "column": "physical_state_code" }, { "table": "p", "column": "repair_centre_location_id" }, { "table": "p", "column": "repair_centre_location_name" }, { "table": "p", "column": "last_completed_handoff_id", "alias": "handoff_id" }, { "table": "p", "column": "last_handoff_received_at", "alias": "received_at" }, { "table": "h", "column": "received_by_user_id" }, { "table": "u", "column": "display_name", "alias": "received_by_display_name" }, { "table": "dv", "column": "lifecycle_status_id" }, { "table": "ls", "column": "code", "alias": "device_lifecycle_code" }], "joins": [{ "table": "logistics_handoffs", "alias": "h", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "h", "column": "id", "operation": "=", "value": { "table": "p", "column": "last_completed_handoff_id" } }] } }, { "table": "users", "alias": "u", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "u", "column": "id", "operation": "=", "value": { "table": "h", "column": "received_by_user_id" } }] } }, { "table": "devices", "alias": "dv", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "dv", "column": "id", "operation": "=", "value": { "table": "p", "column": "device_id" } }] } }, { "table": "device_lifecycle_statuses", "alias": "ls", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ls", "column": "id", "operation": "=", "value": { "table": "dv", "column": "lifecycle_status_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "p", "column": "logistics_case_id" }, "operation": "=", "value": "{{$_POST.logistics_case_id}}" }] } } } },
    { "name": "notify_origin_school_repair_receipt", "module": "core", "action": "exec", "options": { "exec": "notification_from_workflow", "params": { "event_type_code": "LOGISTICS_RECEIVED_BY_REPAIR_CENTRE", "ticket_id": "{{case_precheck.ticket_id}}", "logistics_case_id": "{{received_details.logistics_case_id}}", "handoff_id": "{{received_details.handoff_id}}", "location_id": "{{received_details.repair_centre_location_id}}", "actor_user_id": "{{identity}}", "message": "{{received_details.logistics_number + ' was received by ' + received_details.repair_centre_location_name + '.'}}" } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "handoff_id": "{{received_details.handoff_id}}", "logistics_case_id": "{{received_details.logistics_case_id}}", "logistics_number": "{{received_details.logistics_number}}", "repair_centre_location_id": "{{received_details.repair_centre_location_id}}", "repair_centre_name": "{{received_details.repair_centre_location_name}}", "ticket_status_code": "{{received_details.ticket_status_code}}", "logistics_status_code": "{{received_details.logistics_status_code}}", "device_lifecycle_code": "{{received_details.device_lifecycle_code}}", "physical_state_code": "{{received_details.physical_state_code}}", "received_at": "{{received_details.received_at}}", "received_by_display_name": "{{received_details.received_by_display_name}}" } } }
  ], "catch": [
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P7D_RECEIVE_SCOPE_CONFLICT'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "This Repair Centre user is not scoped to the destination location." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P7D_RECEIVE_STATE_CONFLICT'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The case is no longer awaiting receipt. No partial changes were committed." } } }] } } },
    { "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Repair Centre receipt could not be recorded. No partial changes were committed." } } }
  ] }
}
