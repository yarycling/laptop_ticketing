{
  "settings": { "options": { "method": "post", "nocsrf": true } },
  "meta": { "$_POST": [{ "name": "logistics_case_id", "type": "number" }, { "name": "scan_reference", "type": "text" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "logistics.receive" } }, "output": true },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.logistics_case_id || $_POST.logistics_case_id < 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Provide a valid logistics case." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_POST.scan_reference && $_POST.scan_reference.length > 255}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "The scan reference exceeds the allowed length." } } }] } } },
    { "name": "case_precheck", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_logistics_current_context", "columns": [{ "column": "logistics_case_id" }, { "column": "logistics_number" }, { "column": "ticket_id" }, { "column": "ticket_number" }, { "column": "device_id" }, { "column": "pickup_school_id" }, { "column": "pickup_district_id" }, { "column": "current_logistics_status_id" }, { "column": "current_logistics_status_code" }, { "column": "ticket_current_status_id" }, { "column": "ticket_current_status_code" }, { "column": "is_active" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "logistics_case_id" }, "operation": "=", "value": "{{$_POST.logistics_case_id}}" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!case_precheck.logistics_case_id || case_precheck.is_active != 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Active logistics case was not found." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{case_precheck.current_logistics_status_code != 'ACCEPTED' || case_precheck.ticket_current_status_code != 'APPROVED_FOR_PICKUP'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The logistics case is not awaiting TTPost receipt." } } }] } } },
    { "name": "outbound_status", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "logistics_statuses", "columns": [{ "column": "id" }, { "column": "code" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "OUTBOUND_IN_TRANSIT" }, { "data": { "column": "is_active" }, "operation": "=", "value": 1 }] } } } },
    { "name": "ticket_in_transit", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_statuses", "columns": [{ "column": "id" }, { "column": "code" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "IN_TRANSIT" }, { "data": { "column": "is_active" }, "operation": "=", "value": 1 }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!outbound_status.id || !ticket_in_transit.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The required outbound status configuration is unavailable." } } }] } } },
    { "name": "receive_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "current_case", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_logistics_current_context", "columns": [{ "column": "logistics_case_id" }, { "column": "logistics_number" }, { "column": "ticket_id" }, { "column": "ticket_number" }, { "column": "device_id" }, { "column": "pickup_school_id" }, { "column": "pickup_district_id" }, { "column": "current_logistics_status_id" }, { "column": "current_logistics_status_code" }, { "column": "ticket_current_status_id" }, { "column": "ticket_current_status_code" }, { "column": "is_active" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "logistics_case_id" }, "operation": "=", "value": "{{$_POST.logistics_case_id}}" }] } } } },
      { "name": "pending_handoff", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "logistics_handoffs", "alias": "h" }, "columns": [{ "table": "h", "column": "id" }, { "table": "h", "column": "handoff_type" }, { "table": "h", "column": "received_at" }, { "table": "h", "column": "to_service_location_id" }, { "table": "loc", "column": "location_type" }], "joins": [{ "table": "service_locations", "alias": "loc", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "loc", "column": "id", "operation": "=", "value": { "table": "h", "column": "to_service_location_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "h", "column": "logistics_case_id" }, "operation": "=", "value": "{{current_case.logistics_case_id}}" }, { "data": { "table": "h", "column": "active_record_key" }, "operation": "=", "value": 1 }] } } } },
      { "name": "completed_handoff", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "logistics_handoffs", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "logistics_case_id" }, "operation": "=", "value": "{{current_case.logistics_case_id}}" }, { "data": { "column": "handoff_type" }, "operation": "=", "value": "SCHOOL_TO_TTPOST" }, { "data": { "column": "received_at" }, "operator": "is_not_null" }] } } } },
      { "name": "ticket_consistency", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "tickets", "columns": [{ "column": "id" }, { "column": "device_id" }, { "column": "origin_school_id" }, { "column": "origin_district_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{current_case.ticket_id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!current_case.logistics_case_id || current_case.is_active != 1 || current_case.current_logistics_status_code != 'ACCEPTED' || current_case.ticket_current_status_code != 'APPROVED_FOR_PICKUP' || !ticket_consistency.id || ticket_consistency.device_id != current_case.device_id || ticket_consistency.origin_school_id != current_case.pickup_school_id || ticket_consistency.origin_district_id != current_case.pickup_district_id || !pending_handoff.id || pending_handoff.handoff_type != 'SCHOOL_TO_TTPOST' || pending_handoff.received_at || pending_handoff.location_type != 'TTPOST' || completed_handoff.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7C_RECEIVE_STATE_CONFLICT" } }] } } },
      { "name": "complete_handoff", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "logistics_handoffs", "values": [{ "column": "received_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss')}}" }, { "column": "received_by_user_id", "value": "{{identity}}" }, { "column": "active_record_key", "value": null }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{pending_handoff.id}}" }, { "data": { "column": "received_at" }, "operator": "is_null" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{complete_handoff.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7C_RECEIVE_STATE_CONFLICT" } }] } } },
      { "name": "receive_scan", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "logistics_handoff_scans", "values": [{ "column": "logistics_handoff_id", "value": "{{pending_handoff.id}}" }, { "column": "scan_type", "value": "RECEIVE" }, { "column": "scan_method", "value": "MANUAL" }, { "column": "scan_reference", "value": "{{($_POST.scan_reference || '').trim() || null}}" }, { "column": "scanned_by_user_id", "value": "{{identity}}" }] } } },
      { "name": "update_logistics_case", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_logistics_cases", "values": [{ "column": "current_status_id", "value": "{{outbound_status.id}}" }, { "column": "updated_by_user_id", "value": "{{identity}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{current_case.logistics_case_id}}" }, { "data": { "column": "current_status_id" }, "operation": "=", "value": "{{current_case.current_logistics_status_id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "closed_at" }, "operator": "is_null" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{update_logistics_case.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7C_RECEIVE_STATE_CONFLICT" } }] } } },
      { "name": "logistics_history", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "logistics_status_history", "values": [{ "column": "logistics_case_id", "value": "{{current_case.logistics_case_id}}" }, { "column": "from_status_id", "value": "{{current_case.current_logistics_status_id}}" }, { "column": "to_status_id", "value": "{{outbound_status.id}}" }, { "column": "changed_by_user_id", "value": "{{identity}}" }] } } },
      { "name": "update_ticket", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "tickets", "values": [{ "column": "current_status_id", "value": "{{ticket_in_transit.id}}" }, { "column": "updated_by_user_id", "value": "{{identity}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{current_case.ticket_id}}" }, { "data": { "column": "current_status_id" }, "operation": "=", "value": "{{current_case.ticket_current_status_id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{update_ticket.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7C_RECEIVE_STATE_CONFLICT" } }] } } },
      { "name": "ticket_history", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "ticket_status_history", "values": [{ "column": "ticket_id", "value": "{{current_case.ticket_id}}" }, { "column": "from_status_id", "value": "{{current_case.ticket_current_status_id}}" }, { "column": "to_status_id", "value": "{{ticket_in_transit.id}}" }, { "column": "changed_by_user_id", "value": "{{identity}}" }] } } },
      { "name": "receive_audit", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "logistics_ttpost_handoff_received" }, { "column": "module", "value": "logistics" }, { "column": "entity_type", "value": "logistics_handoff" }, { "column": "entity_id", "value": "{{pending_handoff.id}}" }, { "column": "description", "value": "{{'TTPost received ' + current_case.logistics_number + ' for ticket ' + current_case.ticket_number}}" }] } } }
    ] } } },
    { "name": "received_details", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "v_logistics_physical_custody", "alias": "p" }, "columns": [{ "table": "p", "column": "logistics_case_id" }, { "table": "p", "column": "logistics_number" }, { "table": "p", "column": "ticket_status_code" }, { "table": "p", "column": "logistics_status_code" }, { "table": "p", "column": "physical_state_code" }, { "table": "p", "column": "current_service_location_id", "alias": "ttpost_location_id" }, { "table": "p", "column": "current_service_location_name", "alias": "ttpost_location_name" }, { "table": "p", "column": "last_completed_handoff_id", "alias": "handoff_id" }, { "table": "p", "column": "last_handoff_received_at", "alias": "received_at" }, { "table": "h", "column": "received_by_user_id" }, { "table": "u", "column": "display_name", "alias": "received_by_display_name" }], "joins": [{ "table": "logistics_handoffs", "alias": "h", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "h", "column": "id", "operation": "=", "value": { "table": "p", "column": "last_completed_handoff_id" } }] } }, { "table": "users", "alias": "u", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "u", "column": "id", "operation": "=", "value": { "table": "h", "column": "received_by_user_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "p", "column": "logistics_case_id" }, "operation": "=", "value": "{{$_POST.logistics_case_id}}" }] } } } },
    { "name": "sla_pickup_complete", "module": "core", "action": "exec", "output": true, "options": { "exec": "sla_complete", "params": { "idempotency_key": "{{'PICKUP:TICKET:' + case_precheck.ticket_id}}", "completed_at": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss.SSS')}}", "completion_event": "SCHOOL_TO_TTPOST_RECEIVED", "source_entity_type": "logistics_handoff", "source_entity_id": "{{received_details.handoff_id}}", "actor_user_id": "{{identity}}" } } },
    { "name": "notify_school_ttpost_receipt", "module": "core", "action": "exec", "options": { "exec": "notification_from_workflow", "params": { "event_type_code": "LOGISTICS_RECEIVED_BY_TTPOST", "ticket_id": "{{case_precheck.ticket_id}}", "logistics_case_id": "{{received_details.logistics_case_id}}", "handoff_id": "{{received_details.handoff_id}}", "actor_user_id": "{{identity}}", "message": "{{'TTPost received ' + received_details.logistics_number + ' for ' + case_precheck.ticket_number + '.'}}" } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "handoff_id": "{{received_details.handoff_id}}", "logistics_case_id": "{{received_details.logistics_case_id}}", "logistics_number": "{{received_details.logistics_number}}", "ticket_status_code": "{{received_details.ticket_status_code}}", "logistics_status_code": "{{received_details.logistics_status_code}}", "physical_state_code": "{{received_details.physical_state_code}}", "ttpost_location_id": "{{received_details.ttpost_location_id}}", "ttpost_location_name": "{{received_details.ttpost_location_name}}", "received_at": "{{received_details.received_at}}", "received_by_display_name": "{{received_details.received_by_display_name}}" } } }
  ], "catch": [
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P7C_RECEIVE_STATE_CONFLICT'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The case is no longer awaiting TTPost receipt. Reload and try again." } } }] } } },
    { "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "TTPost receipt could not be recorded. No partial changes were committed." } } }
  ] }
}
