{
  "settings": {
    "options": {
      "method": "post"
    }
  },
  "meta": {
    "$_POST": [
      {
        "name": "logistics_case_id",
        "type": "number"
      },
      {
        "name": "scan_reference",
        "type": "text"
      }
    ]
  },
  "exec": {
    "steps": [
      {
        "name": "permission",
        "module": "core",
        "action": "exec",
        "options": {
          "exec": "security_require_permission",
          "params": {
            "permission": "logistics.return_ttpost_receive"
          }
        },
        "output": true
      },
      {
        "name": "identity",
        "module": "auth",
        "action": "identify",
        "options": {
          "provider": "portalSecurity"
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{!$_POST.logistics_case_id || $_POST.logistics_case_id < 1}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 400,
                  "data": {
                    "success": false,
                    "error": "A valid logistics case is required."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{$_POST.scan_reference && $_POST.scan_reference.length > 255}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 400,
                  "data": {
                    "success": false,
                    "error": "The scan reference exceeds the allowed length."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "name": "receive_transaction",
        "module": "dbupdater",
        "action": "transaction",
        "options": {
          "connection": "db",
          "exec": {
            "steps": [
              {
                "name": "current",
                "module": "dbconnector",
                "action": "single",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "v_logistics_physical_custody",
                    "columns": [
                      {
                        "column": "logistics_case_id"
                      },
                      {
                        "column": "logistics_number"
                      },
                      {
                        "column": "ticket_id"
                      },
                      {
                        "column": "device_id"
                      },
                      {
                        "column": "replacement_case_id"
                      },
                      {
                        "column": "logistics_status_id"
                      },
                      {
                        "column": "physical_state_code"
                      },
                      {
                        "column": "logistics_status_code"
                      },
                      {
                        "column": "ticket_status_code"
                      },
                      {
                        "column": "device_lifecycle_code"
                      },
                      {
                        "column": "allocation_custody_level"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "logistics_case_id"
                          },
                          "operation": "=",
                          "value": "{{$_POST.logistics_case_id}}"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "name": "case_record",
                "module": "dbconnector",
                "action": "single",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "ticket_logistics_cases",
                    "columns": [
                      {
                        "column": "current_status_id"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "id"
                          },
                          "operation": "=",
                          "value": "{{current.logistics_case_id}}"
                        },
                        {
                          "data": {
                            "column": "active_record_key"
                          },
                          "operation": "=",
                          "value": 1
                        }
                      ]
                    }
                  }
                }
              },
              {
                "name": "return_job",
                "module": "dbconnector",
                "action": "single",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": {
                      "name": "repair_jobs",
                      "alias": "j"
                    },
                    "columns": [
                      {
                        "table": "j",
                        "column": "id"
                      },
                      {
                        "table": "j",
                        "column": "completed_at"
                      },
                      {
                        "table": "o",
                        "column": "is_return_ready"
                      }
                    ],
                    "joins": [
                      {
                        "table": "repair_outcomes",
                        "alias": "o",
                        "type": "inner",
                        "clauses": {
                          "condition": "AND",
                          "rules": [
                            {
                              "table": "o",
                              "column": "id",
                              "operation": "=",
                              "value": {
                                "table": "j",
                                "column": "outcome_id"
                              }
                            }
                          ]
                        }
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "table": "j",
                            "column": "logistics_case_id"
                          },
                          "operation": "=",
                          "value": "{{current.logistics_case_id}}"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "name": "pending",
                "module": "dbconnector",
                "action": "single",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "logistics_handoffs",
                    "columns": [
                      {
                        "column": "id"
                      },
                      {
                        "column": "device_id"
                      },
                      {
                        "column": "handoff_type"
                      },
                      {
                        "column": "from_service_location_id"
                      },
                      {
                        "column": "to_service_location_id"
                      },
                      {
                        "column": "received_at"
                      },
                      {
                        "column": "active_record_key"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "logistics_case_id"
                          },
                          "operation": "=",
                          "value": "{{current.logistics_case_id}}"
                        },
                        {
                          "data": {
                            "column": "handoff_type"
                          },
                          "operation": "=",
                          "value": "REPAIR_CENTRE_TO_TTPOST"
                        },
                        {
                          "data": {
                            "column": "active_record_key"
                          },
                          "operation": "=",
                          "value": 1
                        },
                        {
                          "data": {
                            "column": "received_at"
                          },
                          "operator": "is_null"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "name": "destination",
                "module": "dbconnector",
                "action": "single",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "service_locations",
                    "columns": [
                      {
                        "column": "id"
                      },
                      {
                        "column": "name"
                      },
                      {
                        "column": "location_type"
                      },
                      {
                        "column": "is_active"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "id"
                          },
                          "operation": "=",
                          "value": "{{pending.to_service_location_id}}"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "name": "transit",
                "module": "dbconnector",
                "action": "single",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "logistics_statuses",
                    "columns": [
                      {
                        "column": "id"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "code"
                          },
                          "operation": "=",
                          "value": "RETURN_IN_TRANSIT"
                        },
                        {
                          "data": {
                            "column": "is_active"
                          },
                          "operation": "=",
                          "value": 1
                        }
                      ]
                    }
                  }
                }
              },
              {
                "module": "core",
                "action": "condition",
                "options": {
                  "if": "{{current.device_source == 'TEMPORARY_LOAN_CONVERSION' || !current.logistics_case_id || ($_POST.device_id && $_POST.device_id != current.device_id) || current.logistics_status_code != 'READY_FOR_RETURN' || current.ticket_status_code != 'COMPLETED' || current.physical_state_code != 'PENDING_TTPOST_RETURN_RECEIPT' || !return_job.id || !return_job.completed_at || (!current.replacement_case_id && return_job.is_return_ready != 1) || !pending.id || (current.replacement_case_id && pending.device_id != current.device_id) || pending.received_at || pending.active_record_key != 1 || !destination.id || destination.location_type != 'TTPOST' || destination.is_active != 1 || !transit.id || !current.allocation_custody_level || (current.allocation_custody_level == 'STUDENT' && current.device_lifecycle_code != 'ASSIGNED') || (current.allocation_custody_level != 'STUDENT' && current.device_lifecycle_code != 'AVAILABLE')}}",
                  "then": {
                    "steps": [
                      {
                        "module": "core",
                        "action": "error",
                        "options": {
                          "message": "P7F_TTPOST_RECEIVE_STATE"
                        }
                      }
                    ]
                  }
                }
              },
              {
                "name": "complete_handoff",
                "module": "dbupdater",
                "action": "update",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "logistics_handoffs",
                    "values": [
                      {
                        "column": "received_at",
                        "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss.SSS')}}"
                      },
                      {
                        "column": "received_by_user_id",
                        "value": "{{identity}}"
                      },
                      {
                        "column": "active_record_key",
                        "value": null
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "id"
                          },
                          "operation": "=",
                          "value": "{{pending.id}}"
                        },
                        {
                          "data": {
                            "column": "received_at"
                          },
                          "operator": "is_null"
                        },
                        {
                          "data": {
                            "column": "active_record_key"
                          },
                          "operation": "=",
                          "value": 1
                        }
                      ]
                    }
                  }
                }
              },
              {
                "module": "core",
                "action": "condition",
                "options": {
                  "if": "{{complete_handoff.affected != 1}}",
                  "then": {
                    "steps": [
                      {
                        "module": "core",
                        "action": "error",
                        "options": {
                          "message": "P7F_TTPOST_RECEIVE_STATE"
                        }
                      }
                    ]
                  }
                }
              },
              {
                "name": "scan",
                "module": "dbupdater",
                "action": "insert",
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "logistics_handoff_scans",
                    "values": [
                      {
                        "column": "logistics_handoff_id",
                        "value": "{{pending.id}}"
                      },
                      {
                        "column": "scan_type",
                        "value": "RECEIVE"
                      },
                      {
                        "column": "scan_method",
                        "value": "MANUAL"
                      },
                      {
                        "column": "scan_reference",
                        "value": "{{($_POST.scan_reference || '').trim() || null}}"
                      },
                      {
                        "column": "scanned_by_user_id",
                        "value": "{{identity}}"
                      }
                    ]
                  }
                }
              },
              {
                "name": "update_case",
                "module": "dbupdater",
                "action": "update",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "ticket_logistics_cases",
                    "values": [
                      {
                        "column": "current_status_id",
                        "value": "{{transit.id}}"
                      },
                      {
                        "column": "updated_by_user_id",
                        "value": "{{identity}}"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "id"
                          },
                          "operation": "=",
                          "value": "{{current.logistics_case_id}}"
                        },
                        {
                          "data": {
                            "column": "current_status_id"
                          },
                          "operation": "=",
                          "value": "{{case_record.current_status_id}}"
                        },
                        {
                          "data": {
                            "column": "active_record_key"
                          },
                          "operation": "=",
                          "value": 1
                        },
                        {
                          "data": {
                            "column": "closed_at"
                          },
                          "operator": "is_null"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "module": "core",
                "action": "condition",
                "options": {
                  "if": "{{update_case.affected != 1}}",
                  "then": {
                    "steps": [
                      {
                        "module": "core",
                        "action": "error",
                        "options": {
                          "message": "P7F_TTPOST_RECEIVE_STATE"
                        }
                      }
                    ]
                  }
                }
              },
              {
                "name": "status_history",
                "module": "dbupdater",
                "action": "insert",
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "logistics_status_history",
                    "values": [
                      {
                        "column": "logistics_case_id",
                        "value": "{{current.logistics_case_id}}"
                      },
                      {
                        "column": "from_status_id",
                        "value": "{{case_record.current_status_id}}"
                      },
                      {
                        "column": "to_status_id",
                        "value": "{{transit.id}}"
                      },
                      {
                        "column": "changed_by_user_id",
                        "value": "{{identity}}"
                      }
                    ]
                  }
                }
              },
              {
                "name": "audit",
                "module": "dbupdater",
                "action": "insert",
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "audit_logs",
                    "values": [
                      {
                        "column": "actor_user_id",
                        "value": "{{identity}}"
                      },
                      {
                        "column": "action",
                        "value": "logistics_return_ttpost_received"
                      },
                      {
                        "column": "module",
                        "value": "logistics"
                      },
                      {
                        "column": "entity_type",
                        "value": "logistics_handoff"
                      },
                      {
                        "column": "entity_id",
                        "value": "{{pending.id}}"
                      },
                      {
                        "column": "description",
                        "value": "{{'TTPost received return device for ' + current.logistics_number + '.'}}"
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      {
        "name": "result",
        "module": "dbconnector",
        "action": "single",
        "output": true,
        "options": {
          "connection": "db",
          "sql": {
            "table": {
              "name": "logistics_handoffs",
              "alias": "h"
            },
            "columns": [
              {
                "table": "h",
                "column": "id",
                "alias": "handoff_id"
              },
              {
                "table": "h",
                "column": "logistics_case_id"
              },
              {
                "table": "h",
                "column": "received_at"
              },
              {
                "table": "l",
                "column": "id",
                "alias": "ttpost_location_id"
              },
              {
                "table": "l",
                "column": "name",
                "alias": "ttpost_location_name"
              },
              {
                "table": "u",
                "column": "display_name",
                "alias": "received_by_display_name"
              }
            ],
            "joins": [
              {
                "table": "service_locations",
                "alias": "l",
                "type": "inner",
                "clauses": {
                  "condition": "AND",
                  "rules": [
                    {
                      "table": "l",
                      "column": "id",
                      "operation": "=",
                      "value": {
                        "table": "h",
                        "column": "to_service_location_id"
                      }
                    }
                  ]
                }
              },
              {
                "table": "users",
                "alias": "u",
                "type": "left",
                "clauses": {
                  "condition": "AND",
                  "rules": [
                    {
                      "table": "u",
                      "column": "id",
                      "operation": "=",
                      "value": {
                        "table": "h",
                        "column": "received_by_user_id"
                      }
                    }
                  ]
                }
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "data": {
                    "table": "h",
                    "column": "logistics_case_id"
                  },
                  "operation": "=",
                  "value": "{{$_POST.logistics_case_id}}"
                },
                {
                  "data": {
                    "table": "h",
                    "column": "handoff_type"
                  },
                  "operation": "=",
                  "value": "REPAIR_CENTRE_TO_TTPOST"
                }
              ]
            },
            "orders": [
              {
                "table": "h",
                "column": "id",
                "direction": "desc"
              }
            ],
            "limit": 1
          }
        }
      },
      {
        "name": "notification_ticket",
        "module": "dbconnector",
        "action": "single",
        "output": true,
        "options": { "connection": "db", "sql": { "table": "ticket_logistics_cases", "columns": [{ "column": "ticket_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{result.logistics_case_id}}" }] } } }
      },
      {
        "name": "notify_return_received_by_ttpost",
        "module": "core",
        "action": "exec",
        "options": { "exec": "notification_from_workflow", "params": { "event_type_code": "LOGISTICS_RETURN_RECEIVED_BY_TTPOST", "ticket_id": "{{notification_ticket.ticket_id}}", "logistics_case_id": "{{result.logistics_case_id}}", "handoff_id": "{{result.handoff_id}}", "actor_user_id": "{{identity}}", "message": "TTPost has received the repaired device for return delivery." } }
      },
      {
        "module": "core",
        "action": "response",
        "options": {
          "status": 200,
          "data": {
            "success": true,
            "handoff_id": "{{result.handoff_id}}",
            "logistics_case_id": "{{result.logistics_case_id}}",
            "received_at": "{{result.received_at}}",
            "received_by_display_name": "{{result.received_by_display_name}}",
            "ttpost_location_id": "{{result.ttpost_location_id}}",
            "ttpost_location_name": "{{result.ttpost_location_name}}",
            "ticket_status_code": "COMPLETED",
            "logistics_status_code": "RETURN_IN_TRANSIT",
            "physical_state_code": "TTPOST_RETURN_CUSTODY"
          }
        }
      }
    ],
    "catch": [
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{$_EXCEPTION.message == 'P7F_TTPOST_RECEIVE_STATE'}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 409,
                  "data": {
                    "success": false,
                    "error": "The return handoff is no longer awaiting receipt. No changes were committed."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "module": "core",
        "action": "response",
        "options": {
          "status": 500,
          "data": {
            "success": false,
            "error": "TTPost return receipt could not be recorded. No partial changes were committed."
          }
        }
      }
    ]
  }
}
