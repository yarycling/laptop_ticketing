{
  "settings": { "options": { "method": "post", "nocsrf": true } },
  "meta": { "$_POST": [{ "name": "logistics_case_id", "type": "number" }, { "name": "ttpost_location_id", "type": "number" }, { "name": "tracking_reference", "type": "text" }, { "name": "scan_reference", "type": "text" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "logistics.dispatch" } }, "output": true },
    { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.logistics_case_id || $_POST.logistics_case_id < 1 || !$_POST.ttpost_location_id || $_POST.ttpost_location_id < 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Choose a logistics case and active TTPost destination." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{($_POST.tracking_reference && $_POST.tracking_reference.length > 180) || ($_POST.scan_reference && $_POST.scan_reference.length > 255)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "The supplied references exceed the allowed length." } } }] } } },
    { "name": "case_precheck", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_logistics_current_context", "columns": [{ "column": "logistics_case_id" }, { "column": "logistics_number" }, { "column": "ticket_id" }, { "column": "ticket_number" }, { "column": "device_id" }, { "column": "pickup_school_id" }, { "column": "pickup_district_id" }, { "column": "current_logistics_status_code" }, { "column": "ticket_current_status_code" }, { "column": "is_active" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "logistics_case_id" }, "operation": "=", "value": "{{$_POST.logistics_case_id}}" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!case_precheck.logistics_case_id || case_precheck.is_active != 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Active logistics case was not found." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && !scope_context.districts.flatten('id').contains(case_precheck.pickup_district_id) && !scope_context.schools.flatten('id').contains(case_precheck.pickup_school_id)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "You are not authorized to release this device from its ticket origin." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{case_precheck.current_logistics_status_code != 'ACCEPTED' || case_precheck.ticket_current_status_code != 'APPROVED_FOR_PICKUP' || !case_precheck.pickup_school_id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The case is not ready for School-to-TTPost release." } } }] } } },
    { "name": "dispatch_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "current_case", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_logistics_current_context", "columns": [{ "column": "logistics_case_id" }, { "column": "logistics_number" }, { "column": "ticket_id" }, { "column": "ticket_number" }, { "column": "device_id" }, { "column": "pickup_school_id" }, { "column": "pickup_district_id" }, { "column": "current_logistics_status_code" }, { "column": "ticket_current_status_code" }, { "column": "is_active" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "logistics_case_id" }, "operation": "=", "value": "{{$_POST.logistics_case_id}}" }] } } } },
      { "name": "transaction_scope", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_get_scope_context", "params": {} } },
      { "name": "ticket_consistency", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "tickets", "columns": [{ "column": "id" }, { "column": "device_id" }, { "column": "origin_school_id" }, { "column": "origin_district_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{current_case.ticket_id}}" }] } } } },
      { "name": "selected_location", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "service_locations", "columns": [{ "column": "id" }, { "column": "location_type" }, { "column": "code" }, { "column": "name" }, { "column": "is_active" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{$_POST.ttpost_location_id}}" }] } } } },
      { "name": "pending_handoff", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "logistics_handoffs", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "logistics_case_id" }, "operation": "=", "value": "{{current_case.logistics_case_id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }] } } } },
      { "name": "completed_handoff", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "logistics_handoffs", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "logistics_case_id" }, "operation": "=", "value": "{{current_case.logistics_case_id}}" }, { "data": { "column": "handoff_type" }, "operation": "=", "value": "SCHOOL_TO_TTPOST" }, { "data": { "column": "received_at" }, "operator": "is_not_null" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!current_case.logistics_case_id || current_case.is_active != 1 || current_case.current_logistics_status_code != 'ACCEPTED' || current_case.ticket_current_status_code != 'APPROVED_FOR_PICKUP' || !current_case.pickup_school_id || !ticket_consistency.id || ticket_consistency.device_id != current_case.device_id || ticket_consistency.origin_school_id != current_case.pickup_school_id || ticket_consistency.origin_district_id != current_case.pickup_district_id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7C_DISPATCH_STATE_CONFLICT" } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !transaction_scope.has_national_scope && !transaction_scope.districts.flatten('id').contains(current_case.pickup_district_id) && !transaction_scope.schools.flatten('id').contains(current_case.pickup_school_id)}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7C_DISPATCH_SCOPE_CONFLICT" } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!selected_location.id || selected_location.location_type != 'TTPOST' || selected_location.is_active != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7C_DISPATCH_LOCATION_CONFLICT" } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{pending_handoff.id || completed_handoff.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7C_DISPATCH_ALREADY_EXISTS" } }] } } },
      { "name": "create_handoff", "module": "dbupdater", "action": "insert", "output": true, "options": { "connection": "db", "sql": { "table": "logistics_handoffs", "values": [{ "column": "logistics_case_id", "value": "{{current_case.logistics_case_id}}" }, { "column": "handoff_type", "value": "SCHOOL_TO_TTPOST" }, { "column": "from_school_id", "value": "{{current_case.pickup_school_id}}" }, { "column": "from_service_location_id", "value": null }, { "column": "to_school_id", "value": null }, { "column": "to_service_location_id", "value": "{{selected_location.id}}" }, { "column": "dispatched_by_user_id", "value": "{{identity}}" }, { "column": "received_at", "value": null }, { "column": "received_by_user_id", "value": null }, { "column": "tracking_reference", "value": "{{($_POST.tracking_reference || '').trim() || null}}" }, { "column": "active_record_key", "value": 1 }] } } },
      { "name": "dispatch_scan", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "logistics_handoff_scans", "values": [{ "column": "logistics_handoff_id", "value": "{{create_handoff.identity}}" }, { "column": "scan_type", "value": "DISPATCH" }, { "column": "scan_method", "value": "MANUAL" }, { "column": "scan_reference", "value": "{{($_POST.scan_reference || '').trim() || null}}" }, { "column": "scanned_by_user_id", "value": "{{identity}}" }] } } },
      { "name": "dispatch_audit", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "logistics_school_handoff_dispatched" }, { "column": "module", "value": "logistics" }, { "column": "entity_type", "value": "logistics_handoff" }, { "column": "entity_id", "value": "{{create_handoff.identity}}" }, { "column": "description", "value": "{{'Released ' + current_case.logistics_number + ' for ticket ' + current_case.ticket_number + ' to ' + selected_location.name}}" }] } } }
    ] } } },
    { "name": "created_handoff", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "logistics_handoffs", "alias": "h" }, "columns": [{ "table": "h", "column": "id", "alias": "handoff_id" }, { "table": "h", "column": "logistics_case_id" }, { "table": "h", "column": "handoff_type" }, { "table": "h", "column": "to_service_location_id", "alias": "ttpost_location_id" }, { "table": "h", "column": "dispatched_at" }, { "table": "c", "column": "logistics_number" }, { "table": "loc", "column": "name", "alias": "ttpost_location_name" }], "joins": [{ "table": "ticket_logistics_cases", "alias": "c", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "c", "column": "id", "operation": "=", "value": { "table": "h", "column": "logistics_case_id" } }] } }, { "table": "service_locations", "alias": "loc", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "loc", "column": "id", "operation": "=", "value": { "table": "h", "column": "to_service_location_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "h", "column": "id" }, "operation": "=", "value": "{{create_handoff.identity}}" }] } } } },
    { "name": "notify_school_released", "module": "core", "action": "exec", "options": { "exec": "notification_from_workflow", "params": { "event_type_code": "LOGISTICS_SCHOOL_RELEASED", "ticket_id": "{{case_precheck.ticket_id}}", "logistics_case_id": "{{created_handoff.logistics_case_id}}", "handoff_id": "{{created_handoff.handoff_id}}", "location_id": "{{created_handoff.ttpost_location_id}}", "actor_user_id": "{{identity}}", "message": "{{'The school released ' + created_handoff.logistics_number + ' to TTPost at ' + created_handoff.ttpost_location_name + '.'}}" } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "handoff_id": "{{created_handoff.handoff_id}}", "logistics_case_id": "{{created_handoff.logistics_case_id}}", "logistics_number": "{{created_handoff.logistics_number}}", "handoff_type": "{{created_handoff.handoff_type}}", "ttpost_location_id": "{{created_handoff.ttpost_location_id}}", "ttpost_location_name": "{{created_handoff.ttpost_location_name}}", "dispatched_at": "{{created_handoff.dispatched_at}}", "physical_state_code": "PENDING_TTPOST_RECEIPT" } } }
  ], "catch": [
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P7C_DISPATCH_SCOPE_CONFLICT'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "You are not authorized to release this device from its ticket origin." } } }] } } },
    { "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The handoff could not be started because the case state changed or a handoff already exists." } } }
  ] }
}
