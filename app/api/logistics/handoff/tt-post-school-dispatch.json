{
  "settings": {
    "options": {
      "method": "post"
    }
  },
  "meta": {
    "$_POST": [
      {
        "name": "logistics_case_id",
        "type": "number"
      },
      {
        "name": "tracking_reference",
        "type": "text"
      },
      {
        "name": "scan_reference",
        "type": "text"
      }
    ]
  },
  "exec": {
    "steps": [
      {
        "name": "permission",
        "module": "core",
        "action": "exec",
        "options": {
          "exec": "security_require_permission",
          "params": {
            "permission": "logistics.return_school_dispatch"
          }
        },
        "output": true
      },
      {
        "name": "identity",
        "module": "auth",
        "action": "identify",
        "options": {
          "provider": "portalSecurity"
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{!$_POST.logistics_case_id || $_POST.logistics_case_id < 1}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 400,
                  "data": {
                    "success": false,
                    "error": "A valid logistics case is required."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{($_POST.tracking_reference && $_POST.tracking_reference.length > 180) || ($_POST.scan_reference && $_POST.scan_reference.length > 255)}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 400,
                  "data": {
                    "success": false,
                    "error": "The supplied references exceed the allowed length."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "name": "dispatch_transaction",
        "module": "dbupdater",
        "action": "transaction",
        "options": {
          "connection": "db",
          "exec": {
            "steps": [
              {
                "name": "current",
                "module": "dbconnector",
                "action": "single",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "v_logistics_physical_custody",
                    "columns": [
                      {
                        "column": "logistics_case_id"
                      },
                      {
                        "column": "logistics_number"
                      },
                      {
                        "column": "ticket_id"
                      },
                      {
                        "column": "device_id"
                      },
                      {
                        "column": "replacement_case_id"
                      },
                      {
                        "column": "last_completed_handoff_device_id"
                      },
                      {
                        "column": "logistics_status_code"
                      },
                      {
                        "column": "ticket_status_code"
                      },
                      {
                        "column": "physical_state_code"
                      },
                      {
                        "column": "current_service_location_id"
                      },
                      {
                        "column": "allocation_custody_level"
                      },
                      {
                        "column": "allocation_district_id"
                      },
                      {
                        "column": "allocation_school_id"
                      },
                      {
                        "column": "allocation_student_id"
                      },
                      {
                        "column": "device_lifecycle_code"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "logistics_case_id"
                          },
                          "operation": "=",
                          "value": "{{$_POST.logistics_case_id}}"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "name": "case_record",
                "module": "dbconnector",
                "action": "single",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": {
                      "name": "ticket_logistics_cases",
                      "alias": "c"
                    },
                    "columns": [
                      {
                        "table": "c",
                        "column": "pickup_school_id"
                      },
                      {
                        "table": "c",
                        "column": "ticket_id"
                      },
                      {
                        "table": "c",
                        "column": "active_record_key"
                      },
                      {
                        "table": "t",
                        "column": "origin_school_id"
                      }
                    ],
                    "joins": [
                      {
                        "table": "tickets",
                        "alias": "t",
                        "type": "inner",
                        "clauses": {
                          "condition": "AND",
                          "rules": [
                            {
                              "table": "t",
                              "column": "id",
                              "operation": "=",
                              "value": {
                                "table": "c",
                                "column": "ticket_id"
                              }
                            }
                          ]
                        }
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "table": "c",
                            "column": "id"
                          },
                          "operation": "=",
                          "value": "{{$_POST.logistics_case_id}}"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "name": "destination",
                "module": "dbconnector",
                "action": "single",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "schools",
                    "columns": [
                      {
                        "column": "id"
                      },
                      {
                        "column": "name"
                      },
                      {
                        "column": "district_id"
                      },
                      {
                        "column": "status"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "id"
                          },
                          "operation": "=",
                          "value": "{{current.replacement_case_id ? current.allocation_school_id : case_record.pickup_school_id}}"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "name": "pending",
                "module": "dbconnector",
                "action": "single",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "logistics_handoffs",
                    "columns": [
                      {
                        "column": "id"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "logistics_case_id"
                          },
                          "operation": "=",
                          "value": "{{current.logistics_case_id}}"
                        },
                        {
                          "data": {
                            "column": "active_record_key"
                          },
                          "operation": "=",
                          "value": 1
                        },
                        {
                          "data": {
                            "column": "received_at"
                          },
                          "operator": "is_null"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "name": "existing",
                "module": "dbconnector",
                "action": "single",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "logistics_handoffs",
                    "columns": [
                      {
                        "column": "id"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "logistics_case_id"
                          },
                          "operation": "=",
                          "value": "{{current.logistics_case_id}}"
                        },
                        {
                          "data": {
                            "column": "handoff_type"
                          },
                          "operation": "=",
                          "value": "TTPOST_TO_SCHOOL"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "module": "core",
                "action": "condition",
                "options": {
                  "if": "{{current.device_source == 'TEMPORARY_LOAN_CONVERSION' || !current.logistics_case_id || ($_POST.device_id && $_POST.device_id != current.device_id) || current.logistics_status_code != 'RETURN_IN_TRANSIT' || current.ticket_status_code != 'COMPLETED' || current.physical_state_code != 'TTPOST_RETURN_CUSTODY' || (current.replacement_case_id && current.last_completed_handoff_device_id != current.device_id) || !current.current_service_location_id || !case_record.ticket_id || case_record.active_record_key != 1 || case_record.pickup_school_id != case_record.origin_school_id || !destination.id || destination.status != 'active' || pending.id || existing.id || !current.allocation_custody_level || (current.allocation_custody_level == 'STUDENT' && current.device_lifecycle_code != 'ASSIGNED') || (current.allocation_custody_level != 'STUDENT' && current.device_lifecycle_code != 'AVAILABLE')}}",
                  "then": {
                    "steps": [
                      {
                        "module": "core",
                        "action": "error",
                        "options": {
                          "message": "P7F_SCHOOL_DISPATCH_STATE"
                        }
                      }
                    ]
                  }
                }
              },
              {
                "name": "handoff",
                "module": "dbupdater",
                "action": "insert",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "logistics_handoffs",
                    "values": [
                      {
                        "column": "logistics_case_id",
                        "value": "{{current.logistics_case_id}}"
                      },
                      {
                        "column": "device_id",
                        "value": "{{current.device_id}}"
                      },
                      {
                        "column": "handoff_type",
                        "value": "TTPOST_TO_SCHOOL"
                      },
                      {
                        "column": "from_service_location_id",
                        "value": "{{current.current_service_location_id}}"
                      },
                      {
                        "column": "to_school_id",
                        "value": "{{destination.id}}"
                      },
                      {
                        "column": "dispatched_by_user_id",
                        "value": "{{identity}}"
                      },
                      {
                        "column": "tracking_reference",
                        "value": "{{($_POST.tracking_reference || '').trim() || null}}"
                      },
                      {
                        "column": "active_record_key",
                        "value": 1
                      }
                    ]
                  }
                }
              },
              {
                "name": "scan",
                "module": "dbupdater",
                "action": "insert",
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "logistics_handoff_scans",
                    "values": [
                      {
                        "column": "logistics_handoff_id",
                        "value": "{{handoff.identity}}"
                      },
                      {
                        "column": "scan_type",
                        "value": "DISPATCH"
                      },
                      {
                        "column": "scan_method",
                        "value": "MANUAL"
                      },
                      {
                        "column": "scan_reference",
                        "value": "{{($_POST.scan_reference || '').trim() || null}}"
                      },
                      {
                        "column": "scanned_by_user_id",
                        "value": "{{identity}}"
                      }
                    ]
                  }
                }
              },
              {
                "name": "audit",
                "module": "dbupdater",
                "action": "insert",
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "audit_logs",
                    "values": [
                      {
                        "column": "actor_user_id",
                        "value": "{{identity}}"
                      },
                      {
                        "column": "action",
                        "value": "logistics_school_return_dispatched"
                      },
                      {
                        "column": "module",
                        "value": "logistics"
                      },
                      {
                        "column": "entity_type",
                        "value": "logistics_handoff"
                      },
                      {
                        "column": "entity_id",
                        "value": "{{handoff.identity}}"
                      },
                      {
                        "column": "description",
                        "value": "{{'TTPost dispatched ' + current.logistics_number + ' to the origin School.'}}"
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      {
        "name": "result",
        "module": "dbconnector",
        "action": "single",
        "output": true,
        "options": {
          "connection": "db",
          "sql": {
            "table": "logistics_handoffs",
            "columns": [
              {
                "column": "id",
                "alias": "handoff_id"
              },
              {
                "column": "logistics_case_id"
              },
              {
                "column": "dispatched_at"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "data": {
                    "column": "logistics_case_id"
                  },
                  "operation": "=",
                  "value": "{{$_POST.logistics_case_id}}"
                },
                {
                  "data": {
                    "column": "handoff_type"
                  },
                  "operation": "=",
                  "value": "TTPOST_TO_SCHOOL"
                },
                {
                  "data": {
                    "column": "active_record_key"
                  },
                  "operation": "=",
                  "value": 1
                }
              ]
            }
          }
        }
      },
      {
        "name": "notification_ticket",
        "module": "dbconnector",
        "action": "single",
        "output": true,
        "options": { "connection": "db", "sql": { "table": "ticket_logistics_cases", "columns": [{ "column": "ticket_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{result.logistics_case_id}}" }] } } }
      },
      {
        "name": "notify_return_in_transit_to_school",
        "module": "core",
        "action": "exec",
        "options": { "exec": "notification_from_workflow", "params": { "event_type_code": "LOGISTICS_RETURN_IN_TRANSIT_TO_SCHOOL", "ticket_id": "{{notification_ticket.ticket_id}}", "logistics_case_id": "{{result.logistics_case_id}}", "handoff_id": "{{result.handoff_id}}", "actor_user_id": "{{identity}}", "message": "The returned device is in transit to the school." } }
      },
      {
        "module": "core",
        "action": "response",
        "options": {
          "status": 200,
          "data": {
            "success": true,
            "handoff_id": "{{result.handoff_id}}",
            "logistics_case_id": "{{result.logistics_case_id}}",
            "school_id": "{{destination.id}}",
            "school_name": "{{destination.name}}",
            "dispatched_at": "{{result.dispatched_at}}",
            "ticket_status_code": "COMPLETED",
            "logistics_status_code": "RETURN_IN_TRANSIT",
            "physical_state_code": "PENDING_SCHOOL_RETURN_RECEIPT"
          }
        }
      }
    ],
    "catch": [
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{$_EXCEPTION.code == 'ER_DUP_ENTRY'}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 409,
                  "data": {
                    "success": false,
                    "error": "The School return handoff was recorded concurrently. Reload the case before trying again."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{$_EXCEPTION.message == 'P7F_SCHOOL_DISPATCH_STATE'}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 409,
                  "data": {
                    "success": false,
                    "error": "This return is not eligible for dispatch to School. No changes were committed."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "module": "core",
        "action": "response",
        "options": {
          "status": 500,
          "data": {
            "success": false,
            "error": "School return dispatch could not be recorded. No partial changes were committed."
          }
        }
      }
    ]
  }
}
