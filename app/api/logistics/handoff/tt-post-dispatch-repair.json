{
  "settings": { "options": { "method": "post", "nocsrf": true } },
  "meta": { "$_POST": [{ "name": "logistics_case_id", "type": "number" }, { "name": "repair_centre_location_id", "type": "number" }, { "name": "tracking_reference", "type": "text" }, { "name": "scan_reference", "type": "text" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "logistics.forward_to_repair" } }, "output": true },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "name": "ttpost_role", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "user_roles", "alias": "ur" }, "columns": [{ "table": "r", "column": "name", "alias": "role_name" }], "joins": [{ "table": "roles", "alias": "r", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "r", "column": "id", "operation": "=", "value": { "table": "ur", "column": "role_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "ur", "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "table": "r", "column": "name" }, "operation": "=", "value": "TTPOST_LOGISTICS" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !ttpost_role.role_name}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Only TTPost Logistics may dispatch a device to a Repair Centre." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.logistics_case_id || $_POST.logistics_case_id < 1 || !$_POST.repair_centre_location_id || $_POST.repair_centre_location_id < 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Choose a logistics case and Repair Centre." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{($_POST.tracking_reference && $_POST.tracking_reference.length > 180) || ($_POST.scan_reference && $_POST.scan_reference.length > 255)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "The supplied references exceed the allowed length." } } }] } } },
    { "name": "case_precheck", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_logistics_current_context", "columns": [{ "column": "logistics_case_id" }, { "column": "logistics_number" }, { "column": "ticket_id" }, { "column": "ticket_number" }, { "column": "device_id" }, { "column": "pickup_school_id" }, { "column": "pickup_district_id" }, { "column": "current_logistics_status_code" }, { "column": "ticket_current_status_code" }, { "column": "repair_centre_location_id" }, { "column": "is_active" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "logistics_case_id" }, "operation": "=", "value": "{{$_POST.logistics_case_id}}" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!case_precheck.logistics_case_id || case_precheck.is_active != 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Active logistics case was not found." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{case_precheck.current_logistics_status_code != 'OUTBOUND_IN_TRANSIT' || case_precheck.ticket_current_status_code != 'IN_TRANSIT'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The case is not ready for TTPost dispatch to a Repair Centre." } } }] } } },
    { "name": "outbound_status", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "logistics_statuses", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "OUTBOUND_IN_TRANSIT" }, { "data": { "column": "is_active" }, "operation": "=", "value": 1 }] } } } },
    { "name": "transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "current_case", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_logistics_current_context", "columns": [{ "column": "logistics_case_id" }, { "column": "logistics_number" }, { "column": "ticket_id" }, { "column": "ticket_number" }, { "column": "device_id" }, { "column": "repair_centre_location_id" }, { "column": "current_logistics_status_id", "alias": "logistics_status_id" }, { "column": "current_logistics_status_code" }, { "column": "ticket_current_status_id" }, { "column": "ticket_current_status_code" }, { "column": "is_active" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "logistics_case_id" }, "operation": "=", "value": "{{$_POST.logistics_case_id}}" }] } } } },
      { "name": "physical", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_logistics_physical_custody", "columns": [{ "column": "physical_state_code" }, { "column": "current_service_location_id" }, { "column": "pending_handoff_id" }, { "column": "pending_repair_handoff_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "logistics_case_id" }, "operation": "=", "value": "{{$_POST.logistics_case_id}}" }] } } } },
      { "name": "ticket_check", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "tickets", "columns": [{ "column": "id" }, { "column": "device_id" }, { "column": "current_status_id" }, { "column": "origin_school_id" }, { "column": "origin_district_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{current_case.ticket_id}}" }] } } } },
      { "name": "source_handoff", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "logistics_handoffs", "alias": "h" }, "columns": [{ "table": "h", "column": "id" }, { "table": "h", "column": "to_service_location_id" }, { "table": "loc", "column": "id", "alias": "location_id" }, { "table": "loc", "column": "location_type" }, { "table": "loc", "column": "is_active" }], "joins": [{ "table": "service_locations", "alias": "loc", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "loc", "column": "id", "operation": "=", "value": { "table": "h", "column": "to_service_location_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "h", "column": "logistics_case_id" }, "operation": "=", "value": "{{current_case.logistics_case_id}}" }, { "data": { "table": "h", "column": "handoff_type" }, "operation": "=", "value": "SCHOOL_TO_TTPOST" }, { "data": { "table": "h", "column": "received_at" }, "operator": "is_not_null" }] }, "orders": [{ "table": "h", "column": "id", "direction": "desc" }], "limit": 1 } } },
      { "name": "destination", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "service_locations", "columns": [{ "column": "id" }, { "column": "location_type" }, { "column": "is_active" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{$_POST.repair_centre_location_id}}" }] } } } },
      { "name": "prior_repair_handoff", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "logistics_handoffs", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "logistics_case_id" }, "operation": "=", "value": "{{current_case.logistics_case_id}}" }, { "data": { "column": "handoff_type" }, "operation": "=", "value": "TTPOST_TO_REPAIR_CENTRE" }, { "data": { "column": "received_at" }, "operator": "is_not_null" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!current_case.logistics_case_id || current_case.is_active != 1 || current_case.current_logistics_status_code != 'OUTBOUND_IN_TRANSIT' || current_case.ticket_current_status_code != 'IN_TRANSIT' || physical.physical_state_code != 'TTPOST_CUSTODY' || physical.pending_handoff_id || physical.pending_repair_handoff_id || !ticket_check.id || ticket_check.device_id != current_case.device_id || ticket_check.current_status_id != current_case.ticket_current_status_id || !source_handoff.id || source_handoff.location_type != 'TTPOST' || source_handoff.is_active != 1 || !destination.id || destination.location_type != 'REPAIR_CENTRE' || destination.is_active != 1 || prior_repair_handoff.id || (current_case.repair_centre_location_id && current_case.repair_centre_location_id != destination.id)}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7D_DISPATCH_STATE_CONFLICT" } }] } } },
      { "name": "update_case_location", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_logistics_cases", "values": [{ "column": "repair_centre_location_id", "value": "{{destination.id}}" }, { "column": "updated_by_user_id", "value": "{{identity}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{current_case.logistics_case_id}}" }, { "data": { "column": "current_status_id" }, "operation": "=", "value": "{{outbound_status.id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "closed_at" }, "operator": "is_null" }, { "data": { "column": "ticket_id" }, "operation": "=", "value": "{{current_case.ticket_id}}" }, { "data": { "column": "device_id" }, "operation": "=", "value": "{{current_case.device_id}}" }, { "data": { "column": "repair_centre_location_id" }, "operator": "is_null" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!current_case.repair_centre_location_id && update_case_location.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P7D_DISPATCH_STATE_CONFLICT" } }] } } },
      { "name": "create_handoff", "module": "dbupdater", "action": "insert", "output": true, "options": { "connection": "db", "sql": { "table": "logistics_handoffs", "values": [{ "column": "logistics_case_id", "value": "{{current_case.logistics_case_id}}" }, { "column": "handoff_type", "value": "TTPOST_TO_REPAIR_CENTRE" }, { "column": "from_school_id", "value": null }, { "column": "from_service_location_id", "value": "{{physical.current_service_location_id}}" }, { "column": "to_school_id", "value": null }, { "column": "to_service_location_id", "value": "{{destination.id}}" }, { "column": "dispatched_by_user_id", "value": "{{identity}}" }, { "column": "received_at", "value": null }, { "column": "received_by_user_id", "value": null }, { "column": "tracking_reference", "value": "{{($_POST.tracking_reference || '').trim() || null}}" }, { "column": "active_record_key", "value": 1 }] } } },
      { "name": "dispatch_scan", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "logistics_handoff_scans", "values": [{ "column": "logistics_handoff_id", "value": "{{create_handoff.identity}}" }, { "column": "scan_type", "value": "DISPATCH" }, { "column": "scan_method", "value": "MANUAL" }, { "column": "scan_reference", "value": "{{($_POST.scan_reference || '').trim() || null}}" }, { "column": "scanned_by_user_id", "value": "{{identity}}" }] } } },
      { "name": "dispatch_audit", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "logistics_repair_handoff_dispatched" }, { "column": "module", "value": "logistics" }, { "column": "entity_type", "value": "logistics_handoff" }, { "column": "entity_id", "value": "{{create_handoff.identity}}" }, { "column": "description", "value": "{{'Dispatched ' + current_case.logistics_number + ' for ticket ' + current_case.ticket_number + ' to ' + destination.name}}" }] } } }
    ] } } },
    { "name": "dispatch_result", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "logistics_handoffs", "alias": "h" }, "columns": [{ "table": "h", "column": "id", "alias": "handoff_id" }, { "table": "h", "column": "logistics_case_id" }, { "table": "h", "column": "to_service_location_id", "alias": "repair_centre_location_id" }, { "table": "h", "column": "dispatched_at" }, { "table": "c", "column": "logistics_number" }, { "table": "c", "column": "ticket_id" }, { "table": "c", "column": "device_id" }, { "table": "loc", "column": "name", "alias": "repair_centre_name" }], "joins": [{ "table": "ticket_logistics_cases", "alias": "c", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "c", "column": "id", "operation": "=", "value": { "table": "h", "column": "logistics_case_id" } }] } }, { "table": "service_locations", "alias": "loc", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "loc", "column": "id", "operation": "=", "value": { "table": "h", "column": "to_service_location_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "h", "column": "id" }, "operation": "=", "value": "{{create_handoff.identity}}" }] } } } },
    { "name": "notify_repair_centre_dispatch", "module": "core", "action": "exec", "options": { "exec": "notification_from_workflow", "params": { "event_type_code": "LOGISTICS_SENT_TO_REPAIR_CENTRE", "ticket_id": "{{dispatch_result.ticket_id}}", "logistics_case_id": "{{dispatch_result.logistics_case_id}}", "handoff_id": "{{dispatch_result.handoff_id}}", "location_id": "{{dispatch_result.repair_centre_location_id}}", "actor_user_id": "{{identity}}", "message": "{{dispatch_result.logistics_number + ' is in transit to ' + dispatch_result.repair_centre_name + '.'}}" } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "handoff_id": "{{dispatch_result.handoff_id}}", "logistics_case_id": "{{dispatch_result.logistics_case_id}}", "logistics_number": "{{dispatch_result.logistics_number}}", "repair_centre_location_id": "{{dispatch_result.repair_centre_location_id}}", "repair_centre_name": "{{dispatch_result.repair_centre_name}}", "dispatched_at": "{{dispatch_result.dispatched_at}}", "ticket_status_code": "IN_TRANSIT", "logistics_status_code": "OUTBOUND_IN_TRANSIT", "physical_state_code": "PENDING_REPAIR_CENTRE_RECEIPT" } } }
  ], "catch": [
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P7D_DISPATCH_STATE_CONFLICT'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The logistics case is no longer ready for Repair Centre dispatch, or a handoff already exists." } } }] } } },
    { "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Repair Centre dispatch could not be recorded. No partial changes were committed." } } }
  ] }
}
