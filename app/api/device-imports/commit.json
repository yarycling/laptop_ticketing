{
  "settings": { "options": { "method": "post", "nocsrf": true } },
  "meta": { "$_POST": [{ "name": "batch_id", "type": "number" }] },
  "exec": { "steps": [
    { "name": "require_permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "device_imports.manage" } }, "output": true },
    { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
    { "module": "core", "action": "condition", "options": { "if": "{{require_permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.batch_id || $_POST.batch_id < 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "A valid batch ID is required." } } }] } } },
    { "name": "batch", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "device_import_batches", "columns": [{ "column": "id" }, { "column": "status" }, { "column": "valid_rows" }, { "column": "invalid_rows" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{$_POST.batch_id}}" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!batch.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Import batch was not found." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{batch.status == 'committed'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "Batch has already been committed." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{batch.status != 'ready' || batch.invalid_rows != 0 || batch.valid_rows < 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "Only a fully valid ready batch can be committed." } } }] } } },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "name": "valid_rows", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": "device_import_rows", "columns": [{ "column": "id" }, { "column": "serial_number_normalized" }, { "column": "asset_tag_normalized" }, { "column": "resolved_model_id" }, { "column": "resolved_condition_id" }, { "column": "warranty_start_raw" }, { "column": "warranty_end_raw" }, { "column": "received_date_raw" }, { "column": "procurement_reference_raw" }, { "column": "supplier_name_raw" }, { "column": "warranty_reference_raw" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "batch_id" }, "operation": "=", "value": "{{batch.id}}" }, { "data": { "column": "validation_status" }, "operation": "=", "value": "valid" }] }, "orders": [{ "column": "row_number", "direction": "asc" }] } } },
    { "name": "received_lifecycle", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "device_lifecycle_statuses", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "RECEIVED" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!received_lifecycle.id || valid_rows.length != batch.valid_rows}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The batch changed or the Received lifecycle is unavailable. Nothing was imported." } } }] } } },
    { "name": "commit_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "import_each_row", "module": "core", "action": "repeat", "options": { "repeat": "{{valid_rows}}", "exec": { "steps": [
        { "name": "serial_exists", "module": "dbconnector", "action": "count", "output": true, "options": { "connection": "db", "sql": { "table": "devices", "wheres": { "condition": "AND", "rules": [{ "data": { "column": "serial_number" }, "operation": "=", "value": "{{serial_number_normalized}}" }] } } } },
        { "name": "asset_exists", "module": "dbconnector", "action": "count", "output": true, "options": { "connection": "db", "sql": { "table": "devices", "wheres": { "condition": "AND", "rules": [{ "data": { "column": "asset_tag" }, "operation": "=", "value": "{{asset_tag_normalized}}", "conditional": "{{asset_tag_normalized}}" }] } } } },
        { "name": "active_model", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "device_models", "alias": "m" }, "columns": [{ "table": "m", "column": "id" }], "joins": [{ "table": "manufacturers", "alias": "mf", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "mf", "column": "id", "operation": "=", "value": { "table": "m", "column": "manufacturer_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "m", "column": "id" }, "operation": "=", "value": "{{resolved_model_id}}" }, { "data": { "table": "m", "column": "status" }, "operation": "=", "value": "active" }, { "data": { "table": "mf", "column": "status" }, "operation": "=", "value": "active" }] } } } },
        { "name": "active_condition", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "device_conditions", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{resolved_condition_id}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
        { "module": "core", "action": "condition", "options": { "if": "{{serial_exists > 0 || asset_exists > 0 || !active_model.id || !active_condition.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "DEVICE_IMPORT_COMMIT_RECHECK_FAILED" } }] } } },
        { "name": "create_device", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "devices", "values": [{ "column": "serial_number", "value": "{{serial_number_normalized}}" }, { "column": "asset_tag", "value": "{{asset_tag_normalized}}" }, { "column": "device_model_id", "value": "{{active_model.id}}" }, { "column": "condition_id", "value": "{{active_condition.id}}" }, { "column": "lifecycle_status_id", "value": "{{received_lifecycle.id}}" }, { "column": "warranty_start_date", "value": "{{(warranty_start_raw || '').trim() || null}}" }, { "column": "warranty_end_date", "value": "{{(warranty_end_raw || '').trim() || null}}" }, { "column": "received_date", "value": "{{(received_date_raw || '').trim() || null}}" }, { "column": "procurement_reference", "value": "{{(procurement_reference_raw || '').trim() || null}}" }, { "column": "supplier_name", "value": "{{(supplier_name_raw || '').trim() || null}}" }, { "column": "warranty_reference", "value": "{{(warranty_reference_raw || '').trim() || null}}" }, { "column": "created_by_user_id", "value": "{{identity}}" }, { "column": "updated_by_user_id", "value": "{{identity}}" }] } } },
        { "name": "mark_row_imported", "module": "dbupdater", "action": "update", "options": { "connection": "db", "sql": { "table": "device_import_rows", "values": [{ "column": "validation_status", "value": "imported" }, { "column": "imported_device_id", "value": "{{create_device.identity}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{id}}" }] } } } }
      ] } } },
      { "name": "mark_batch_committed", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "device_import_batches", "values": [{ "column": "status", "value": "committed" }, { "column": "imported_rows", "value": "{{batch.valid_rows}}" }, { "column": "committed_at", "value": "{{NOW}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{batch.id}}" }, { "data": { "column": "status" }, "operation": "=", "value": "ready" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{mark_batch_committed.affected < 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "DEVICE_IMPORT_COMMIT_STATE_CHANGED" } }] } } },
      { "name": "audit_commit", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "device_import_committed" }, { "column": "module", "value": "device_imports" }, { "column": "entity_type", "value": "device_import_batch" }, { "column": "entity_id", "value": "{{batch.id}}" }, { "column": "description", "value": "Device import batch committed." }] } } }
    ] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "status": "committed", "imported_rows": "{{batch.valid_rows}}" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The batch could not be committed. No partial import was completed." } } }] }
}
