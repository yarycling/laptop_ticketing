{
  "settings": { "options": { "method": "post", "nocsrf": true } },
  "meta": { "$_POST": [{ "name": "batch_id", "type": "number" }] },
  "exec": { "steps": [
    { "name": "require_permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "device_imports.manage" } }, "output": true },
    { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
    { "module": "core", "action": "condition", "options": { "if": "{{require_permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.batch_id || $_POST.batch_id < 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "A valid batch ID is required." } } }] } } },
    { "name": "batch", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "device_import_batches", "columns": [{ "column": "id" }, { "column": "status" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{$_POST.batch_id}}" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!batch.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Import batch was not found." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{batch.status == 'committed' || batch.status == 'cancelled'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "This batch can no longer be validated." } } }] } } },
    { "module": "dbupdater", "action": "update", "options": { "connection": "db", "sql": { "table": "device_import_batches", "values": [{ "column": "status", "value": "validating" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{batch.id}}" }] } } } },
    { "module": "dbupdater", "action": "update", "options": { "connection": "db", "sql": { "table": "device_import_rows", "values": [{ "column": "validation_status", "value": "pending" }, { "column": "validation_errors", "value": null }, { "column": "resolved_manufacturer_id", "value": null }, { "column": "resolved_model_id", "value": null }, { "column": "resolved_condition_id", "value": null }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "batch_id" }, "operation": "=", "value": "{{batch.id}}" }] } } } },
    { "name": "raw_rows", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": "device_import_rows", "columns": [{ "column": "id" }, { "column": "serial_number_raw" }, { "column": "asset_tag_raw" }, { "column": "manufacturer_code_raw" }, { "column": "model_code_raw" }, { "column": "condition_code_raw" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "batch_id" }, "operation": "=", "value": "{{batch.id}}" }] }, "orders": [{ "column": "row_number", "direction": "asc" }] } } },
    { "name": "normalize_rows", "module": "core", "action": "repeat", "options": { "repeat": "{{raw_rows}}", "exec": { "steps": [
      { "name": "update_normalized_row", "module": "dbupdater", "action": "update", "options": { "connection": "db", "sql": { "table": "device_import_rows", "values": [{ "column": "serial_number_normalized", "value": "{{(serial_number_raw || '').trim().uppercase()}}" }, { "column": "asset_tag_normalized", "value": "{{(asset_tag_raw || '').trim().uppercase() || null}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{id}}" }] } } } }
    ] } } },
    { "name": "normalized_rows", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": "device_import_rows", "columns": [{ "column": "id" }, { "column": "row_number" }, { "column": "raw_payload" }, { "column": "serial_number_raw" }, { "column": "serial_number_normalized" }, { "column": "asset_tag_raw" }, { "column": "asset_tag_normalized" }, { "column": "manufacturer_code_raw" }, { "column": "model_code_raw" }, { "column": "condition_code_raw" }, { "column": "warranty_start_raw" }, { "column": "warranty_end_raw" }, { "column": "received_date_raw" }, { "column": "procurement_reference_raw" }, { "column": "supplier_name_raw" }, { "column": "warranty_reference_raw" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "batch_id" }, "operation": "=", "value": "{{batch.id}}" }] }, "orders": [{ "column": "row_number", "direction": "asc" }] } } },
    { "name": "validate_rows", "module": "core", "action": "repeat", "options": { "repeat": "{{normalized_rows}}", "exec": { "steps": [
      { "name": "serial_exists", "module": "dbconnector", "action": "count", "output": true, "options": { "connection": "db", "sql": { "table": "devices", "wheres": { "condition": "AND", "rules": [{ "data": { "column": "serial_number" }, "operation": "=", "value": "{{serial_number_normalized}}" }] } } } },
      { "name": "serial_duplicates", "module": "dbconnector", "action": "count", "output": true, "options": { "connection": "db", "sql": { "table": "device_import_rows", "wheres": { "condition": "AND", "rules": [{ "data": { "column": "batch_id" }, "operation": "=", "value": "{{batch.id}}" }, { "data": { "column": "serial_number_normalized" }, "operation": "=", "value": "{{serial_number_normalized}}" }] } } } },
      { "name": "asset_exists", "module": "dbconnector", "action": "count", "output": true, "options": { "connection": "db", "sql": { "table": "devices", "wheres": { "condition": "AND", "rules": [{ "data": { "column": "asset_tag" }, "operation": "=", "value": "{{asset_tag_normalized}}", "conditional": "{{asset_tag_normalized}}" }] } } } },
      { "name": "asset_duplicates", "module": "dbconnector", "action": "count", "output": true, "options": { "connection": "db", "sql": { "table": "device_import_rows", "wheres": { "condition": "AND", "rules": [{ "data": { "column": "batch_id" }, "operation": "=", "value": "{{batch.id}}" }, { "data": { "column": "asset_tag_normalized" }, "operation": "=", "value": "{{asset_tag_normalized}}", "conditional": "{{asset_tag_normalized}}" }] } } } },
      { "name": "manufacturer", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "manufacturers", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "manufacturer_code" }, "operation": "=", "value": "{{(manufacturer_code_raw || '').trim().uppercase()}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
      { "name": "model", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "device_models", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "model_code" }, "operation": "=", "value": "{{(model_code_raw || '').trim().uppercase()}}" }, { "data": { "column": "manufacturer_id" }, "operation": "=", "value": "{{manufacturer.id}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
      { "name": "condition", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "device_conditions", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "{{(condition_code_raw || '').trim().uppercase()}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
      { "name": "row_errors", "module": "core", "action": "setvalue", "options": { "key": "row_errors", "value": "{{(raw_payload.contains('P4DX2_FORMULA_ERROR|') ? 'Formula values are not allowed in workbook input cells. ' : '') + (!serial_number_normalized ? 'Serial number is required. ' : '') + ((serial_number_raw || '').trim().length() > 150 ? 'Serial number exceeds 150 characters. ' : '') + (serial_exists > 0 ? 'Serial number already exists. ' : '') + (serial_duplicates > 1 ? 'Duplicate serial number within this import. ' : '') + (asset_tag_normalized && asset_exists > 0 ? 'Asset tag already exists. ' : '') + ((asset_tag_raw || '').trim().length() > 120 ? 'Asset tag exceeds 120 characters. ' : '') + (asset_tag_normalized && asset_duplicates > 1 ? 'Duplicate asset tag within this import. ' : '') + (!manufacturer.id ? 'Manufacturer code was not found or is inactive. ' : '') + (!model.id ? 'Model code was not found for this manufacturer or is inactive. ' : '') + (!condition.id ? 'Condition code was not found or is inactive. ' : '') + ((warranty_start_raw || '').trim() && (warranty_start_raw || '').trim().formatDate('yyyy-MM-dd') != (warranty_start_raw || '').trim() ? 'Warranty start date is invalid. ' : '') + ((warranty_end_raw || '').trim() && (warranty_end_raw || '').trim().formatDate('yyyy-MM-dd') != (warranty_end_raw || '').trim() ? 'Warranty end date is invalid. ' : '') + ((received_date_raw || '').trim() && (received_date_raw || '').trim().formatDate('yyyy-MM-dd') != (received_date_raw || '').trim() ? 'Received date is invalid. ' : '') + (warranty_start_raw && warranty_end_raw && warranty_end_raw < warranty_start_raw ? 'Warranty end date cannot precede warranty start date. ' : '') + ((procurement_reference_raw || '').trim().length() > 180 ? 'Procurement reference exceeds 180 characters. ' : '') + ((supplier_name_raw || '').trim().length() > 180 ? 'Supplier name exceeds 180 characters. ' : '') + ((warranty_reference_raw || '').trim().length() > 180 ? 'Warranty reference exceeds 180 characters. ' : '')}}" } },
      { "name": "save_validation", "module": "dbupdater", "action": "update", "options": { "connection": "db", "sql": { "table": "device_import_rows", "values": [{ "column": "validation_status", "value": "{{row_errors ? 'invalid' : 'valid'}}" }, { "column": "validation_errors", "value": "{{row_errors || null}}" }, { "column": "resolved_manufacturer_id", "value": "{{manufacturer.id || null}}" }, { "column": "resolved_model_id", "value": "{{model.id || null}}" }, { "column": "resolved_condition_id", "value": "{{condition.id || null}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{id}}" }] } } } }
    ] } } },
    { "name": "valid_count", "module": "dbconnector", "action": "count", "output": true, "options": { "connection": "db", "sql": { "table": "device_import_rows", "wheres": { "condition": "AND", "rules": [{ "data": { "column": "batch_id" }, "operation": "=", "value": "{{batch.id}}" }, { "data": { "column": "validation_status" }, "operation": "=", "value": "valid" }] } } } },
    { "name": "invalid_count", "module": "dbconnector", "action": "count", "output": true, "options": { "connection": "db", "sql": { "table": "device_import_rows", "wheres": { "condition": "AND", "rules": [{ "data": { "column": "batch_id" }, "operation": "=", "value": "{{batch.id}}" }, { "data": { "column": "validation_status" }, "operation": "=", "value": "invalid" }] } } } },
    { "module": "dbupdater", "action": "update", "options": { "connection": "db", "sql": { "table": "device_import_batches", "values": [{ "column": "status", "value": "{{invalid_count == 0 && valid_count > 0 ? 'ready' : 'validation_failed'}}" }, { "column": "valid_rows", "value": "{{valid_count}}" }, { "column": "invalid_rows", "value": "{{invalid_count}}" }, { "column": "total_rows", "value": "{{valid_count + invalid_count}}" }, { "column": "validated_at", "value": "{{NOW}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{batch.id}}" }] } } } },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "name": "audit_validation", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "device_import_validated" }, { "column": "module", "value": "device_imports" }, { "column": "entity_type", "value": "device_import_batch" }, { "column": "entity_id", "value": "{{batch.id}}" }, { "column": "description", "value": "Device import batch validation completed." }] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "batch_id": "{{batch.id}}", "status": "{{invalid_count == 0 && valid_count > 0 ? 'ready' : 'validation_failed'}}", "total_rows": "{{valid_count + invalid_count}}", "valid_rows": "{{valid_count}}", "invalid_rows": "{{invalid_count}}" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Batch validation could not be completed." } } }] }
}
