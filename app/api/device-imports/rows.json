{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "meta": { "$_GET": [{ "name": "batch_id", "type": "number" }, { "name": "validation_status", "type": "text" }, { "name": "search", "type": "text" }, { "name": "page", "type": "number" }, { "name": "page_size", "type": "number" }] },
  "exec": { "steps": [
    { "name": "require_permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "device_imports.view" } }, "output": true },
    { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
    { "module": "core", "action": "condition", "options": { "if": "{{require_permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "name": "batch", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "device_import_batches", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{$_GET.batch_id}}" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!batch.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Import batch was not found." } } }] } } },
    { "name": "page", "module": "core", "action": "setvalue", "options": { "key": "page", "value": "{{$_GET.page && $_GET.page > 0 ? floor($_GET.page) : 1}}" } },
    { "name": "page_size", "module": "core", "action": "setvalue", "options": { "key": "page_size", "value": "{{!$_GET.page_size || $_GET.page_size < 1 ? 25 : ($_GET.page_size > 100 ? 100 : floor($_GET.page_size))}}" } },
    { "name": "total", "module": "dbconnector", "action": "count", "output": true, "options": { "connection": "db", "sql": { "table": "device_import_rows", "wheres": { "condition": "AND", "rules": [{ "data": { "column": "batch_id" }, "operation": "=", "value": "{{batch.id}}" }, { "condition": "AND", "conditional": "{{$_GET.validation_status}}", "rules": [{ "data": { "column": "validation_status" }, "operation": "=", "value": "{{$_GET.validation_status}}" }] }, { "condition": "OR", "conditional": "{{$_GET.search}}", "rules": [{ "data": { "column": "serial_number_raw" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "column": "asset_tag_raw" }, "operator": "contains", "value": "{{$_GET.search}}" }] }] } } } },
    { "name": "rows", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": "device_import_rows", "columns": [{ "column": "row_number" }, { "column": "serial_number_raw" }, { "column": "serial_number_normalized" }, { "column": "asset_tag_raw" }, { "column": "asset_tag_normalized" }, { "column": "manufacturer_code_raw" }, { "column": "model_code_raw" }, { "column": "condition_code_raw" }, { "column": "warranty_start_raw" }, { "column": "warranty_end_raw" }, { "column": "received_date_raw" }, { "column": "procurement_reference_raw" }, { "column": "supplier_name_raw" }, { "column": "warranty_reference_raw" }, { "column": "validation_status" }, { "column": "validation_errors" }, { "column": "imported_device_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "batch_id" }, "operation": "=", "value": "{{batch.id}}" }, { "condition": "AND", "conditional": "{{$_GET.validation_status}}", "rules": [{ "data": { "column": "validation_status" }, "operation": "=", "value": "{{$_GET.validation_status}}" }] }, { "condition": "OR", "conditional": "{{$_GET.search}}", "rules": [{ "data": { "column": "serial_number_raw" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "column": "asset_tag_raw" }, "operator": "contains", "value": "{{$_GET.search}}" }] }] }, "orders": [{ "column": "row_number", "direction": "asc" }], "limit": "{{page_size}}", "offset": "{{(page - 1) * page_size}}" } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "rows": "{{rows}}", "page": "{{page}}", "page_size": "{{page_size}}", "total": "{{total}}", "total_pages": "{{ceil(total / page_size)}}" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Import rows could not be loaded." } } }] }
}
