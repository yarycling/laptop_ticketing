{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "meta": { "$_GET": [{ "name": "search", "type": "text" }, { "name": "status", "type": "text" }, { "name": "page", "type": "number" }, { "name": "page_size", "type": "number" }] },
  "exec": { "steps": [
    { "name": "require_permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "device_imports.view" } }, "output": true },
    { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
    { "name": "page", "module": "core", "action": "setvalue", "options": { "key": "page", "value": "{{$_GET.page && $_GET.page > 0 ? floor($_GET.page) : 1}}" } },
    { "name": "page_size", "module": "core", "action": "setvalue", "options": { "key": "page_size", "value": "{{!$_GET.page_size || $_GET.page_size < 1 ? 25 : ($_GET.page_size > 100 ? 100 : floor($_GET.page_size))}}" } },
    { "module": "core", "action": "condition", "options": { "if": "{{require_permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "batches": [], "page": "{{page}}", "page_size": "{{page_size}}", "total": 0, "total_pages": 0 } } }] } } },
    { "name": "total", "module": "dbconnector", "action": "count", "output": true, "options": { "connection": "db", "sql": { "table": "device_import_batches", "wheres": { "condition": "AND", "rules": [{ "condition": "AND", "conditional": "{{$_GET.status}}", "rules": [{ "data": { "column": "status" }, "operation": "=", "value": "{{$_GET.status}}" }] }, { "condition": "OR", "conditional": "{{$_GET.search}}", "rules": [{ "data": { "column": "batch_number" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "column": "original_filename" }, "operator": "contains", "value": "{{$_GET.search}}" }] }] } } } },
    { "name": "batches", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "device_import_batches", "alias": "b" }, "columns": [{ "table": "b", "column": "id" }, { "table": "b", "column": "batch_number" }, { "table": "b", "column": "original_filename" }, { "table": "b", "column": "status" }, { "table": "b", "column": "total_rows" }, { "table": "b", "column": "valid_rows" }, { "table": "b", "column": "invalid_rows" }, { "table": "b", "column": "imported_rows" }, { "table": "u", "column": "display_name", "alias": "uploaded_by" }, { "table": "b", "column": "created_at" }, { "table": "b", "column": "validated_at" }, { "table": "b", "column": "committed_at" }, { "table": "b", "column": "cancelled_at" }], "joins": [{ "table": "users", "alias": "u", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "u", "column": "id", "operation": "=", "value": { "table": "b", "column": "uploaded_by_user_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "condition": "AND", "conditional": "{{$_GET.status}}", "rules": [{ "data": { "table": "b", "column": "status" }, "operation": "=", "value": "{{$_GET.status}}" }] }, { "condition": "OR", "conditional": "{{$_GET.search}}", "rules": [{ "data": { "table": "b", "column": "batch_number" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "table": "b", "column": "original_filename" }, "operator": "contains", "value": "{{$_GET.search}}" }] }] }, "orders": [{ "table": "b", "column": "created_at", "direction": "desc" }, { "table": "b", "column": "id", "direction": "desc" }], "limit": "{{page_size}}", "offset": "{{(page - 1) * page_size}}" } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "batches": "{{batches}}", "page": "{{page}}", "page_size": "{{page_size}}", "total": "{{total}}", "total_pages": "{{ceil(total / page_size)}}" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Import batches could not be loaded." } } }] }
}
