{
  "settings": { "options": { "method": "post", "nocsrf": true } },
  "exec": {
    "steps": [
      { "name": "require_permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "device_imports.manage" } }, "output": true },
      { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
      { "module": "core", "action": "condition", "options": { "if": "{{require_permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
      { "name": "file_validation", "module": "validator", "action": "validate", "options": { "noError": true, "data": [{ "name": "xlsx_file", "value": "{{$_POST.xlsx_file}}", "rules": { "upload:minfiles": { "param": 1, "message": "Select one Excel workbook." }, "upload:maxfiles": { "param": 1, "message": "Select only one Excel workbook." }, "upload:accept": { "param": ".xlsx", "message": "Only .xlsx workbooks are accepted." }, "upload:maxtotalsize": { "param": 10485760, "message": "The Excel workbook must be 10 MB or smaller." } } }] } },
      { "module": "core", "action": "condition", "options": { "if": "{{!file_validation}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Select one .xlsx workbook no larger than 10 MB." } } }] } } },
      { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
      { "name": "stored_file", "module": "upload", "action": "upload", "output": true, "options": { "fields": ["xlsx_file"], "path": "/storage/device-imports", "template": "{guid}.xlsx", "throwErrors": true, "createPath": true } },
      { "module": "core", "action": "condition", "options": { "if": "{{!stored_file || stored_file.length == 0}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "The Excel workbook could not be uploaded." } } }] } } },
      { "name": "parsed_workbook", "module": "device_xlsx", "action": "parseWorkbook", "output": true, "options": { "path": "{{stored_file[0].path}}" } },
      { "module": "core", "action": "condition", "options": { "if": "{{parsed_workbook.row_count == 0}}", "then": { "steps": [{ "module": "fs", "action": "remove", "options": { "path": "{{stored_file[0].path}}" } }, { "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "The Excel workbook must contain at least one device row." } } }] } } },
      { "name": "batch_uuid", "module": "core", "action": "randomUUID", "output": true, "options": {} },
      { "name": "batch_number", "module": "core", "action": "setvalue", "options": { "key": "batch_number", "value": "{{'IMP-' + batch_uuid}}" } },
      { "name": "create_batch", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
        { "name": "insert_batch", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "device_import_batches", "values": [{ "column": "batch_number", "value": "{{batch_number}}" }, { "column": "original_filename", "value": "{{($_POST.original_filename || 'device-import.xlsx').substr(0, 255)}}" }, { "column": "stored_file_path", "value": "{{stored_file[0].path}}" }, { "column": "status", "value": "uploaded" }, { "column": "uploaded_by_user_id", "value": "{{identity}}" }] } } },
        { "name": "stage_rows", "module": "core", "action": "repeat", "options": { "repeat": "{{parsed_workbook.rows}}", "exec": { "steps": [
          { "name": "insert_row", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "device_import_rows", "values": [{ "column": "batch_id", "value": "{{insert_batch.identity}}" }, { "column": "row_number", "value": "{{row_number}}" }, { "column": "raw_payload", "value": "{{(formula_errors.length ? 'P4DX2_FORMULA_ERROR|' : '') + serial_number + '|' + asset_tag + '|' + manufacturer_code + '|' + model_code + '|' + condition_code + '|' + warranty_start_date + '|' + warranty_end_date + '|' + received_date + '|' + procurement_reference + '|' + supplier_name + '|' + warranty_reference}}" }, { "column": "serial_number_raw", "value": "{{serial_number}}" }, { "column": "asset_tag_raw", "value": "{{asset_tag}}" }, { "column": "manufacturer_code_raw", "value": "{{manufacturer_code}}" }, { "column": "model_code_raw", "value": "{{model_code}}" }, { "column": "condition_code_raw", "value": "{{condition_code}}" }, { "column": "warranty_start_raw", "value": "{{warranty_start_date}}" }, { "column": "warranty_end_raw", "value": "{{warranty_end_date}}" }, { "column": "received_date_raw", "value": "{{received_date}}" }, { "column": "procurement_reference_raw", "value": "{{procurement_reference}}" }, { "column": "supplier_name_raw", "value": "{{supplier_name}}" }, { "column": "warranty_reference_raw", "value": "{{warranty_reference}}" }] } } }
        ] } } },
        { "name": "set_batch_total", "module": "dbupdater", "action": "update", "options": { "connection": "db", "sql": { "table": "device_import_batches", "values": [{ "column": "total_rows", "value": "{{parsed_workbook.row_count}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{insert_batch.identity}}" }] } } } },
        { "name": "audit_upload", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "device_import_uploaded" }, { "column": "module", "value": "device_imports" }, { "column": "entity_type", "value": "device_import_batch" }, { "column": "entity_id", "value": "{{insert_batch.identity}}" }, { "column": "description", "value": "Excel device import batch uploaded." }] } } }
      ] } } },
      { "module": "core", "action": "response", "options": { "status": 201, "data": { "success": true, "batch": { "id": "{{insert_batch.identity}}", "batch_number": "{{batch_number}}", "original_filename": "{{($_POST.original_filename || 'device-import.xlsx').substr(0, 255)}}", "status": "uploaded", "total_rows": "{{parsed_workbook.row_count}}" } } } }
    ],
    "catch": [
      { "module": "core", "action": "condition", "options": { "if": "{{stored_file && stored_file.length > 0}}", "then": { "steps": [{ "module": "fs", "action": "remove", "options": { "path": "{{stored_file[0].path}}" } }] } } },
      { "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "The Excel workbook could not be accepted. Use the downloaded template and check the workbook structure and device rows." } } }
    ]
  }
}
