{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "meta": { "$_GET": [{ "name": "status", "type": "text" }, { "name": "district_id", "type": "number" }, { "name": "school_id", "type": "number" }, { "name": "student_id", "type": "number" }, { "name": "device_id", "type": "number" }, { "name": "search", "type": "text" }, { "name": "page", "type": "number" }, { "name": "page_size", "type": "number" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "device_student_assignments.view" } }, "output": true },
    { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
    { "name": "page", "module": "core", "action": "setvalue", "options": { "key": "page", "value": "{{$_GET.page && $_GET.page > 0 ? floor($_GET.page) : 1}}" } },
    { "name": "page_size", "module": "core", "action": "setvalue", "options": { "key": "page_size", "value": "{{!$_GET.page_size || $_GET.page_size < 1 ? 25 : ($_GET.page_size > 100 ? 100 : floor($_GET.page_size))}}" } },
    { "name": "assignments", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": {
      "table": { "name": "device_student_assignments", "alias": "a" },
      "joins": [
        { "table": "devices", "alias": "dv", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "dv", "column": "id", "operation": "=", "value": { "table": "a", "column": "device_id" } }] } },
        { "table": "device_school_allocations", "alias": "sha", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "sha", "column": "id", "operation": "=", "value": { "table": "a", "column": "school_allocation_id" } }, { "table": "sha", "column": "device_id", "operation": "=", "value": { "table": "a", "column": "device_id" } }] } },
        { "table": "device_district_allocations", "alias": "da", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "da", "column": "id", "operation": "=", "value": { "table": "sha", "column": "district_allocation_id" } }, { "table": "da", "column": "device_id", "operation": "=", "value": { "table": "sha", "column": "device_id" } }] } },
        { "table": "schools", "alias": "s", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "s", "column": "id", "operation": "=", "value": { "table": "sha", "column": "school_id" } }] } },
        { "table": "districts", "alias": "d", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "d", "column": "id", "operation": "=", "value": { "table": "da", "column": "district_id" } }] } },
        { "table": "students", "alias": "st", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "st", "column": "id", "operation": "=", "value": { "table": "a", "column": "student_id" } }] } },
        { "table": "device_models", "alias": "m", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "m", "column": "id", "operation": "=", "value": { "table": "dv", "column": "device_model_id" } }] } },
        { "table": "manufacturers", "alias": "mf", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "mf", "column": "id", "operation": "=", "value": { "table": "m", "column": "manufacturer_id" } }] } },
        { "table": "device_conditions", "alias": "c", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "c", "column": "id", "operation": "=", "value": { "table": "dv", "column": "condition_id" } }] } },
        { "table": "device_lifecycle_statuses", "alias": "ls", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ls", "column": "id", "operation": "=", "value": { "table": "dv", "column": "lifecycle_status_id" } }] } },
        { "table": "users", "alias": "u", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "u", "column": "id", "operation": "=", "value": { "table": "a", "column": "assigned_by_user_id" } }] } },
        { "table": "users", "alias": "ru", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "ru", "column": "id", "operation": "=", "value": { "table": "a", "column": "returned_by_user_id" } }] } },
        { "table": "v_device_current_custody", "alias": "cc", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "cc", "column": "device_id", "operation": "=", "value": { "table": "dv", "column": "id" } }] } }
      ],
      "columns": [{ "table": "a", "column": "id", "alias": "student_assignment_id" }, { "table": "a", "column": "school_allocation_id" }, { "table": "da", "column": "id", "alias": "district_allocation_id" }, { "table": "dv", "column": "id", "alias": "device_id" }, { "table": "dv", "column": "serial_number" }, { "table": "dv", "column": "asset_tag" }, { "table": "mf", "column": "name", "alias": "manufacturer" }, { "table": "m", "column": "model_name", "alias": "model" }, { "table": "c", "column": "name", "alias": "condition" }, { "table": "ls", "column": "code", "alias": "lifecycle" }, { "table": "da", "column": "district_id" }, { "table": "d", "column": "name", "alias": "district_name" }, { "table": "sha", "column": "school_id" }, { "table": "s", "column": "name", "alias": "school_name" }, { "table": "st", "column": "id", "alias": "student_id" }, { "table": "st", "column": "student_reference" }, { "table": "st", "column": "first_name" }, { "table": "st", "column": "last_name" }, { "table": "a", "column": "assignment_type" }, { "table": "a", "column": "assigned_at" }, { "table": "u", "column": "display_name", "alias": "assigned_by" }, { "table": "a", "column": "returned_at" }, { "table": "ru", "column": "display_name", "alias": "returned_by" }, { "table": "a", "column": "return_reason" }, { "table": "a", "column": "active_record_key", "alias": "is_active" }, { "table": "cc", "column": "current_custody_level" }],
      "wheres": { "condition": "AND", "rules": [
        { "condition": "AND", "conditional": "{{!$_GET.status || $_GET.status == 'active'}}", "rules": [{ "data": { "table": "a", "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "table": "a", "column": "returned_at" }, "operator": "is_null" }] },
        { "condition": "AND", "conditional": "{{$_GET.status == 'historical'}}", "rules": [{ "data": { "table": "a", "column": "active_record_key" }, "operator": "is_null" }, { "data": { "table": "a", "column": "returned_at" }, "operator": "is_not_null" }] },
        { "condition": "AND", "conditional": "{{$_GET.status && $_GET.status != 'active' && $_GET.status != 'historical' && $_GET.status != 'all'}}", "rules": [{ "data": { "table": "a", "column": "id" }, "operation": "=", "value": -1 }] },
        { "condition": "AND", "conditional": "{{$_GET.district_id}}", "rules": [{ "data": { "table": "da", "column": "district_id" }, "operation": "=", "value": "{{$_GET.district_id}}" }] },
        { "condition": "AND", "conditional": "{{$_GET.school_id}}", "rules": [{ "data": { "table": "sha", "column": "school_id" }, "operation": "=", "value": "{{$_GET.school_id}}" }] },
        { "condition": "AND", "conditional": "{{$_GET.student_id}}", "rules": [{ "data": { "table": "a", "column": "student_id" }, "operation": "=", "value": "{{$_GET.student_id}}" }] },
        { "condition": "AND", "conditional": "{{$_GET.device_id}}", "rules": [{ "data": { "table": "a", "column": "device_id" }, "operation": "=", "value": "{{$_GET.device_id}}" }] },
        { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length > 0}}", "rules": [{ "data": { "table": "da", "column": "district_id" }, "operation": "in", "value": "{{scope_context.districts.flatten('id')}}" }] },
        { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length == 0 && scope_context.schools.length > 0}}", "rules": [{ "data": { "table": "sha", "column": "school_id" }, "operation": "in", "value": "{{scope_context.schools.flatten('id')}}" }] },
        { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length == 0 && scope_context.schools.length == 0}}", "rules": [{ "data": { "table": "a", "column": "id" }, "operation": "=", "value": -1 }] },
        { "condition": "OR", "conditional": "{{$_GET.search}}", "rules": [{ "data": { "table": "dv", "column": "serial_number" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "table": "dv", "column": "asset_tag" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "table": "st", "column": "student_reference" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "table": "st", "column": "first_name" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "table": "st", "column": "last_name" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "table": "s", "column": "name" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "table": "s", "column": "school_code" }, "operator": "contains", "value": "{{$_GET.search}}" }] }
      ] }, "orders": [{ "table": "a", "column": "assigned_at", "direction": "desc" }, { "table": "a", "column": "id", "direction": "desc" }], "limit": "{{page_size}}", "offset": "{{(page - 1) * page_size}}"
    } } },
    { "name": "total", "module": "dbconnector", "action": "count", "output": true, "options": { "connection": "db", "sql": {
      "table": { "name": "device_student_assignments", "alias": "a" },
      "joins": [
        { "table": "devices", "alias": "dv", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "dv", "column": "id", "operation": "=", "value": { "table": "a", "column": "device_id" } }] } },
        { "table": "device_school_allocations", "alias": "sha", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "sha", "column": "id", "operation": "=", "value": { "table": "a", "column": "school_allocation_id" } }] } },
        { "table": "device_district_allocations", "alias": "da", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "da", "column": "id", "operation": "=", "value": { "table": "sha", "column": "district_allocation_id" } }] } },
        { "table": "schools", "alias": "s", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "s", "column": "id", "operation": "=", "value": { "table": "sha", "column": "school_id" } }] } },
        { "table": "students", "alias": "st", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "st", "column": "id", "operation": "=", "value": { "table": "a", "column": "student_id" } }] } }
      ],
      "columns": [{ "table": "a", "column": "id" }],
      "wheres": { "condition": "AND", "rules": [
        { "condition": "AND", "conditional": "{{!$_GET.status || $_GET.status == 'active'}}", "rules": [{ "data": { "table": "a", "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "table": "a", "column": "returned_at" }, "operator": "is_null" }] },
        { "condition": "AND", "conditional": "{{$_GET.status == 'historical'}}", "rules": [{ "data": { "table": "a", "column": "active_record_key" }, "operator": "is_null" }, { "data": { "table": "a", "column": "returned_at" }, "operator": "is_not_null" }] },
        { "condition": "AND", "conditional": "{{$_GET.status && $_GET.status != 'active' && $_GET.status != 'historical' && $_GET.status != 'all'}}", "rules": [{ "data": { "table": "a", "column": "id" }, "operation": "=", "value": -1 }] },
        { "condition": "AND", "conditional": "{{$_GET.district_id}}", "rules": [{ "data": { "table": "da", "column": "district_id" }, "operation": "=", "value": "{{$_GET.district_id}}" }] },
        { "condition": "AND", "conditional": "{{$_GET.school_id}}", "rules": [{ "data": { "table": "sha", "column": "school_id" }, "operation": "=", "value": "{{$_GET.school_id}}" }] },
        { "condition": "AND", "conditional": "{{$_GET.student_id}}", "rules": [{ "data": { "table": "a", "column": "student_id" }, "operation": "=", "value": "{{$_GET.student_id}}" }] },
        { "condition": "AND", "conditional": "{{$_GET.device_id}}", "rules": [{ "data": { "table": "a", "column": "device_id" }, "operation": "=", "value": "{{$_GET.device_id}}" }] },
        { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length > 0}}", "rules": [{ "data": { "table": "da", "column": "district_id" }, "operation": "in", "value": "{{scope_context.districts.flatten('id')}}" }] },
        { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length == 0 && scope_context.schools.length > 0}}", "rules": [{ "data": { "table": "sha", "column": "school_id" }, "operation": "in", "value": "{{scope_context.schools.flatten('id')}}" }] },
        { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length == 0 && scope_context.schools.length == 0}}", "rules": [{ "data": { "table": "a", "column": "id" }, "operation": "=", "value": -1 }] },
        { "condition": "OR", "conditional": "{{$_GET.search}}", "rules": [{ "data": { "table": "dv", "column": "serial_number" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "table": "dv", "column": "asset_tag" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "table": "st", "column": "student_reference" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "table": "st", "column": "first_name" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "table": "st", "column": "last_name" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "table": "s", "column": "name" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "table": "s", "column": "school_code" }, "operator": "contains", "value": "{{$_GET.search}}" }] }
      ] }
    } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "assignments": "{{assignments}}", "page": "{{page}}", "page_size": "{{page_size}}", "total": "{{total}}", "total_pages": "{{ceil(total / page_size)}}" } } }
  ], "catch": { "steps": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Student assignments could not be loaded." } } }] } }
}
