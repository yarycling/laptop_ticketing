{
  "settings": { "options": { "method": "post", "nocsrf": true } },
  "meta": { "$_POST": [{ "name": "student_assignment_id", "type": "number" }, { "name": "return_reason", "type": "text" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "device_student_returns.manage" } }, "output": true },
    { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.student_assignment_id || $_POST.student_assignment_id < 1 || !$_POST.return_reason || !$_POST.return_reason.trim() || $_POST.return_reason.trim().length > 500}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "A valid assignment and return reason of 1 to 500 characters are required." } } }] } } },
    { "name": "assignment", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "device_student_assignments", "alias": "a" }, "joins": [
      { "table": "devices", "alias": "dv", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "dv", "column": "id", "operation": "=", "value": { "table": "a", "column": "device_id" } }] } },
      { "table": "device_lifecycle_statuses", "alias": "ls", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ls", "column": "id", "operation": "=", "value": { "table": "dv", "column": "lifecycle_status_id" } }] } },
      { "table": "v_device_current_custody", "alias": "cc", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "cc", "column": "device_id", "operation": "=", "value": { "table": "dv", "column": "id" } }] } },
      { "table": "device_school_allocations", "alias": "sha", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "sha", "column": "id", "operation": "=", "value": { "table": "a", "column": "school_allocation_id" } }, { "table": "sha", "column": "device_id", "operation": "=", "value": { "table": "a", "column": "device_id" } }] } },
      { "table": "device_district_allocations", "alias": "da", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "da", "column": "id", "operation": "=", "value": { "table": "sha", "column": "district_allocation_id" } }, { "table": "da", "column": "device_id", "operation": "=", "value": { "table": "sha", "column": "device_id" } }] } },
      { "table": "students", "alias": "st", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "st", "column": "id", "operation": "=", "value": { "table": "a", "column": "student_id" } }] } },
      { "table": "schools", "alias": "s", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "s", "column": "id", "operation": "=", "value": { "table": "sha", "column": "school_id" } }] } }
    ], "columns": [{ "table": "a", "column": "id", "alias": "student_assignment_id" }, { "table": "a", "column": "device_id" }, { "table": "a", "column": "student_id" }, { "table": "a", "column": "school_allocation_id" }, { "table": "a", "column": "active_record_key" }, { "table": "a", "column": "returned_at" }, { "table": "dv", "column": "serial_number" }, { "table": "dv", "column": "lifecycle_status_id" }, { "table": "ls", "column": "code", "alias": "lifecycle_code" }, { "table": "cc", "column": "current_custody_level" }, { "table": "cc", "column": "school_id" }, { "table": "cc", "column": "district_id" }, { "table": "cc", "column": "student_assignment_id", "alias": "current_assignment_id" }, { "table": "sha", "column": "active_record_key", "alias": "school_active" }, { "table": "sha", "column": "school_id" }, { "table": "da", "column": "active_record_key", "alias": "district_active" }, { "table": "st", "column": "student_reference" }, { "table": "st", "column": "first_name" }, { "table": "st", "column": "last_name" }, { "table": "s", "column": "name", "alias": "school_name" }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "a", "column": "id" }, "operation": "=", "value": "{{$_POST.student_assignment_id}}" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!assignment.student_assignment_id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Student assignment was not found." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{assignment.active_record_key != 1 || assignment.returned_at}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "This student assignment has already been returned." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && !scope_context.schools.flatten('id').contains(assignment.school_id)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "You are not authorized to return this school's student assignment." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{assignment.lifecycle_code != 'ASSIGNED' || assignment.current_custody_level != 'STUDENT' || assignment.current_assignment_id != assignment.student_assignment_id || assignment.school_active != 1 || assignment.district_active != 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The device custody or lifecycle state is inconsistent; no changes were made." } } }] } } },
    { "name": "return_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "active_assignment", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "device_student_assignments", "alias": "a" }, "joins": [
        { "table": "devices", "alias": "dv", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "dv", "column": "id", "operation": "=", "value": { "table": "a", "column": "device_id" } }] } },
        { "table": "device_lifecycle_statuses", "alias": "ls", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ls", "column": "id", "operation": "=", "value": { "table": "dv", "column": "lifecycle_status_id" } }] } },
        { "table": "v_device_current_custody", "alias": "cc", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "cc", "column": "device_id", "operation": "=", "value": { "table": "dv", "column": "id" } }] } },
        { "table": "device_school_allocations", "alias": "sha", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "sha", "column": "id", "operation": "=", "value": { "table": "a", "column": "school_allocation_id" } }, { "table": "sha", "column": "device_id", "operation": "=", "value": { "table": "a", "column": "device_id" } }] } },
        { "table": "device_district_allocations", "alias": "da", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "da", "column": "id", "operation": "=", "value": { "table": "sha", "column": "district_allocation_id" } }, { "table": "da", "column": "device_id", "operation": "=", "value": { "table": "sha", "column": "device_id" } }] } }
      ], "columns": [{ "table": "a", "column": "id", "alias": "student_assignment_id" }, { "table": "a", "column": "device_id" }, { "table": "a", "column": "school_allocation_id" }, { "table": "a", "column": "student_id" }, { "table": "a", "column": "active_record_key" }, { "table": "a", "column": "returned_at" }, { "table": "dv", "column": "lifecycle_status_id" }, { "table": "dv", "column": "serial_number" }, { "table": "ls", "column": "code", "alias": "lifecycle_code" }, { "table": "cc", "column": "current_custody_level" }, { "table": "cc", "column": "school_id" }, { "table": "cc", "column": "student_assignment_id", "alias": "current_assignment_id" }, { "table": "sha", "column": "active_record_key", "alias": "school_active" }, { "table": "da", "column": "active_record_key", "alias": "district_active" }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "a", "column": "id" }, "operation": "=", "value": "{{$_POST.student_assignment_id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!active_assignment.student_assignment_id || active_assignment.active_record_key != 1 || active_assignment.returned_at}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P5E_ASSIGNMENT_NOT_ACTIVE" } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{active_assignment.lifecycle_code != 'ASSIGNED' || active_assignment.current_custody_level != 'STUDENT' || active_assignment.current_assignment_id != active_assignment.student_assignment_id || active_assignment.school_active != 1 || active_assignment.district_active != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P5E_STUDENT_LINEAGE_INVALID" } }] } } },
      { "name": "active_school_scope", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "user_school_scopes", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "column": "school_id" }, "operation": "=", "value": "{{active_assignment.school_id}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
      { "name": "active_national_scope", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "user_national_scopes", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !active_national_scope.id && !active_school_scope.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P5E_STUDENT_SCOPE_INVALID" } }] } } },
      { "name": "available_lifecycle", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "device_lifecycle_statuses", "columns": [{ "column": "id" }, { "column": "code" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "AVAILABLE" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!available_lifecycle.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P5E_AVAILABLE_LIFECYCLE_MISSING" } }] } } },
      { "name": "close_assignment", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "device_student_assignments", "values": [{ "column": "returned_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss')}}" }, { "column": "returned_by_user_id", "value": "{{identity}}" }, { "column": "return_reason", "value": "{{$_POST.return_reason.trim()}}" }, { "column": "active_record_key", "value": null }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{active_assignment.student_assignment_id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "returned_at" }, "operator": "is_null" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{close_assignment.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P5E_ASSIGNMENT_CLOSE_FAILED" } }] } } },
      { "name": "update_lifecycle", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "devices", "values": [{ "column": "lifecycle_status_id", "value": "{{available_lifecycle.id}}" }, { "column": "updated_by_user_id", "value": "{{identity}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{active_assignment.device_id}}" }, { "data": { "column": "lifecycle_status_id" }, "operation": "=", "value": "{{active_assignment.lifecycle_status_id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{update_lifecycle.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P5E_LIFECYCLE_UPDATE_FAILED" } }] } } },
      { "name": "audit", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "device_returned_from_student" }, { "column": "module", "value": "device_assignments" }, { "column": "entity_type", "value": "device_student_assignment" }, { "column": "entity_id", "value": "{{active_assignment.student_assignment_id}}" }, { "column": "description", "value": "{{'Returned device ' + active_assignment.serial_number + ' from student assignment'}}" }] } } }
    ] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "message": "Device returned to School inventory and is available for assignment.", "student_assignment_id": "{{assignment.student_assignment_id}}", "lifecycle": "AVAILABLE" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The student assignment could not be returned because its state changed or the device is no longer eligible. No changes were saved." } } }] }
}
