{
  "settings": { "options": { "method": "post", "nocsrf": true } },
  "meta": { "$_POST": [{ "name": "device_id", "type": "number" }, { "name": "student_id", "type": "number" }, { "name": "notes", "type": "text" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "device_student_assignments.manage" } }, "output": true },
    { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.device_id || $_POST.device_id < 1 || !$_POST.student_id || $_POST.student_id < 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "A valid device and student are required." } } }] } } },
    { "name": "device", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": {
      "table": { "name": "devices", "alias": "dv" },
      "joins": [
        { "table": "device_lifecycle_statuses", "alias": "ls", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ls", "column": "id", "operation": "=", "value": { "table": "dv", "column": "lifecycle_status_id" } }] } },
        { "table": "v_device_current_custody", "alias": "cc", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "cc", "column": "device_id", "operation": "=", "value": { "table": "dv", "column": "id" } }] } },
        { "table": "device_school_allocations", "alias": "sha", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "sha", "column": "id", "operation": "=", "value": { "table": "cc", "column": "school_allocation_id" } }] } },
        { "table": "device_district_allocations", "alias": "da", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "da", "column": "id", "operation": "=", "value": { "table": "cc", "column": "district_allocation_id" } }] } },
        { "table": "schools", "alias": "s", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "s", "column": "id", "operation": "=", "value": { "table": "sha", "column": "school_id" } }] } },
        { "table": "districts", "alias": "d", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "d", "column": "id", "operation": "=", "value": { "table": "da", "column": "district_id" } }] } }
      ],
      "columns": [{ "table": "dv", "column": "id" }, { "table": "dv", "column": "serial_number" }, { "table": "dv", "column": "asset_tag" }, { "table": "dv", "column": "lifecycle_status_id" }, { "table": "ls", "column": "code", "alias": "lifecycle_code" }, { "table": "cc", "column": "current_custody_level" }, { "table": "cc", "column": "district_id" }, { "table": "cc", "column": "school_id" }, { "table": "cc", "column": "school_allocation_id" }, { "table": "cc", "column": "district_allocation_id" }, { "table": "sha", "column": "active_record_key", "alias": "school_allocation_active" }, { "table": "da", "column": "active_record_key", "alias": "district_allocation_active" }, { "table": "s", "column": "name", "alias": "school_name" }, { "table": "d", "column": "name", "alias": "district_name" }],
      "wheres": { "condition": "AND", "rules": [{ "data": { "table": "dv", "column": "id" }, "operation": "=", "value": "{{$_POST.device_id}}" }, { "data": { "table": "sha", "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "table": "da", "column": "active_record_key" }, "operation": "=", "value": 1 }] }
    } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!device.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Device was not found." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && !scope_context.schools.flatten('id').contains(device.school_id)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "You are not authorized to assign this school's device." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{device.lifecycle_code != 'AVAILABLE' || device.current_custody_level != 'SCHOOL' || device.school_allocation_active != 1 || device.district_allocation_active != 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The selected device is no longer eligible for student assignment." } } }] } } },
    { "name": "student", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "students", "columns": [{ "column": "id" }, { "column": "student_reference" }, { "column": "first_name" }, { "column": "last_name" }, { "column": "school_id" }, { "column": "status" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{$_POST.student_id}}" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!student.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Student was not found." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{student.status != 'active'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "Only active students can receive a device." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{student.school_id != device.school_id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The student and device must belong to the same school." } } }] } } },
    { "name": "existing_primary", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "device_student_assignments", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "student_id" }, "operation": "=", "value": "{{student.id}}" }, { "data": { "column": "assignment_type" }, "operation": "=", "value": "PRIMARY" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{existing_primary.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The selected student already has an active primary device assignment." } } }] } } },
    { "name": "assignment_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "active_device", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": {
        "table": { "name": "devices", "alias": "dv" },
        "joins": [
          { "table": "device_lifecycle_statuses", "alias": "ls", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ls", "column": "id", "operation": "=", "value": { "table": "dv", "column": "lifecycle_status_id" } }] } },
          { "table": "v_device_current_custody", "alias": "cc", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "cc", "column": "device_id", "operation": "=", "value": { "table": "dv", "column": "id" } }] } },
          { "table": "device_school_allocations", "alias": "sha", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "sha", "column": "id", "operation": "=", "value": { "table": "cc", "column": "school_allocation_id" } }] } },
          { "table": "device_district_allocations", "alias": "da", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "da", "column": "id", "operation": "=", "value": { "table": "cc", "column": "district_allocation_id" } }] } },
          { "table": "schools", "alias": "s", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "s", "column": "id", "operation": "=", "value": { "table": "sha", "column": "school_id" } }] } }
        ],
        "columns": [{ "table": "dv", "column": "id" }, { "table": "dv", "column": "serial_number" }, { "table": "dv", "column": "asset_tag" }, { "table": "dv", "column": "lifecycle_status_id" }, { "table": "ls", "column": "code", "alias": "lifecycle_code" }, { "table": "cc", "column": "current_custody_level" }, { "table": "cc", "column": "district_id" }, { "table": "cc", "column": "school_id" }, { "table": "cc", "column": "school_allocation_id" }, { "table": "cc", "column": "district_allocation_id" }, { "table": "s", "column": "name", "alias": "school_name" }],
        "wheres": { "condition": "AND", "rules": [{ "data": { "table": "dv", "column": "id" }, "operation": "=", "value": "{{$_POST.device_id}}" }, { "data": { "table": "sha", "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "table": "da", "column": "active_record_key" }, "operation": "=", "value": 1 }] }
      } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!active_device.id || active_device.lifecycle_code != 'AVAILABLE' || active_device.current_custody_level != 'SCHOOL' || !active_device.school_allocation_id || !active_device.district_allocation_id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P5D_DEVICE_RECHECK_FAILED" } }] } } },
      { "name": "active_stock", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_device_current_stock_location", "columns": [{ "column": "stock_location_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "device_id" }, "operation": "=", "value": "{{active_device.id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{active_stock.stock_location_id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P8CB2_STOCK_ACTIVE" } }] } } },
      { "name": "active_student", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "students", "columns": [{ "column": "id" }, { "column": "student_reference" }, { "column": "first_name" }, { "column": "last_name" }, { "column": "school_id" }, { "column": "status" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{$_POST.student_id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!active_student.id || active_student.status != 'active' || active_student.school_id != active_device.school_id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P5D_STUDENT_RECHECK_FAILED" } }] } } },
      { "name": "national_scope_recheck", "module": "dbconnector", "action": "count", "output": true, "options": { "connection": "db", "sql": { "table": "user_national_scopes", "wheres": { "condition": "AND", "rules": [{ "data": { "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
      { "name": "school_scope_recheck", "module": "dbconnector", "action": "count", "output": true, "options": { "connection": "db", "sql": { "table": "user_school_scopes", "wheres": { "condition": "AND", "rules": [{ "data": { "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "column": "school_id" }, "operation": "=", "value": "{{active_device.school_id}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && national_scope_recheck == 0 && school_scope_recheck == 0}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P5D_SCOPE_RECHECK_FAILED" } }] } } },
      { "name": "active_device_assignment", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "device_student_assignments", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "device_id" }, "operation": "=", "value": "{{active_device.id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }] } } } },
      { "name": "active_primary_assignment", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "device_student_assignments", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "student_id" }, "operation": "=", "value": "{{active_student.id}}" }, { "data": { "column": "assignment_type" }, "operation": "=", "value": "PRIMARY" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{active_device_assignment.id || active_primary_assignment.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P5D_ACTIVE_ASSIGNMENT_EXISTS" } }] } } },
      { "name": "assigned_lifecycle", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "device_lifecycle_statuses", "columns": [{ "column": "id" }, { "column": "code" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "ASSIGNED" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!assigned_lifecycle.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P5D_ASSIGNED_LIFECYCLE_MISSING" } }] } } },
      { "name": "student_assignment", "module": "dbupdater", "action": "insert", "output": true, "options": { "connection": "db", "sql": { "table": "device_student_assignments", "values": [
        { "column": "device_id", "value": "{{active_device.id}}" }, { "column": "school_allocation_id", "value": "{{active_device.school_allocation_id}}" }, { "column": "student_id", "value": "{{active_student.id}}" }, { "column": "assignment_type", "value": "PRIMARY" }, { "column": "assigned_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss')}}" }, { "column": "assigned_by_user_id", "value": "{{identity}}" }, { "column": "notes", "value": "{{($_POST.notes || '').trim() || null}}" }, { "column": "active_record_key", "value": 1 }
      ] } } },
      { "name": "update_device_lifecycle", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "devices", "values": [{ "column": "lifecycle_status_id", "value": "{{assigned_lifecycle.id}}" }, { "column": "updated_by_user_id", "value": "{{identity}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{active_device.id}}" }, { "data": { "column": "lifecycle_status_id" }, "operation": "=", "value": "{{active_device.lifecycle_status_id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{update_device_lifecycle.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P5D_LIFECYCLE_UPDATE_FAILED" } }] } } },
      { "name": "lifecycle_recheck", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "devices", "alias": "dv" }, "joins": [{ "table": "device_lifecycle_statuses", "alias": "ls", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ls", "column": "id", "operation": "=", "value": { "table": "dv", "column": "lifecycle_status_id" } }] } }], "columns": [{ "table": "ls", "column": "code" }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "dv", "column": "id" }, "operation": "=", "value": "{{active_device.id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{lifecycle_recheck.code != 'ASSIGNED'}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P5D_LIFECYCLE_UPDATE_FAILED" } }] } } },
      { "name": "audit", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "device_assigned_to_student" }, { "column": "module", "value": "device_assignments" }, { "column": "entity_type", "value": "device_student_assignment" }, { "column": "entity_id", "value": "{{student_assignment.identity}}" }, { "column": "description", "value": "{{'Assigned device ' + active_device.serial_number + ' to ' + active_student.student_reference + ' at ' + active_device.school_name}}" }] } } }
    ] } } },
    { "name": "created_assignment", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "device_student_assignments", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "device_id" }, "operation": "=", "value": "{{$_POST.device_id}}" }, { "data": { "column": "student_id" }, "operation": "=", "value": "{{$_POST.student_id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }] } } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "assignment_id": "{{created_assignment.id}}", "assignment_type": "PRIMARY", "lifecycle": "ASSIGNED" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The device or student is no longer eligible for assignment. No changes were saved." } } }] }
}
