{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "device_student_assignments.view" } }, "output": true },
    { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
    { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length == 0 && scope_context.schools.length == 0}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "school_available": 0, "student_assigned": 0, "students_with_devices": 0 } } }] } } },
    { "name": "school_available", "module": "dbconnector", "action": "count", "output": true, "options": { "connection": "db", "sql": {
      "table": { "name": "devices", "alias": "dv" },
      "joins": [
        { "table": "device_lifecycle_statuses", "alias": "ls", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ls", "column": "id", "operation": "=", "value": { "table": "dv", "column": "lifecycle_status_id" } }] } },
        { "table": "v_device_current_custody", "alias": "cc", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "cc", "column": "device_id", "operation": "=", "value": { "table": "dv", "column": "id" } }] } },
        { "table": "device_school_allocations", "alias": "sha", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "sha", "column": "id", "operation": "=", "value": { "table": "cc", "column": "school_allocation_id" } }] } }
      ], "columns": [{ "table": "dv", "column": "id" }], "wheres": { "condition": "AND", "rules": [
        { "data": { "table": "sha", "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "table": "ls", "column": "code" }, "operation": "=", "value": "AVAILABLE" }, { "data": { "table": "cc", "column": "current_custody_level" }, "operation": "=", "value": "SCHOOL" },
        { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length > 0}}", "rules": [{ "data": { "table": "cc", "column": "district_id" }, "operation": "in", "value": "{{scope_context.districts.flatten('id')}}" }] },
        { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length == 0 && scope_context.schools.length > 0}}", "rules": [{ "data": { "table": "cc", "column": "school_id" }, "operation": "in", "value": "{{scope_context.schools.flatten('id')}}" }] }
      ] }
    } } },
    { "name": "student_assigned", "module": "dbconnector", "action": "count", "output": true, "options": { "connection": "db", "sql": {
      "table": { "name": "device_student_assignments", "alias": "a" },
      "joins": [
        { "table": "device_school_allocations", "alias": "sha", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "sha", "column": "id", "operation": "=", "value": { "table": "a", "column": "school_allocation_id" } }] } },
        { "table": "device_district_allocations", "alias": "da", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "da", "column": "id", "operation": "=", "value": { "table": "sha", "column": "district_allocation_id" } }] } }
      ], "columns": [{ "table": "a", "column": "id" }], "wheres": { "condition": "AND", "rules": [
        { "data": { "table": "a", "column": "active_record_key" }, "operation": "=", "value": 1 },
        { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length > 0}}", "rules": [{ "data": { "table": "da", "column": "district_id" }, "operation": "in", "value": "{{scope_context.districts.flatten('id')}}" }] },
        { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length == 0 && scope_context.schools.length > 0}}", "rules": [{ "data": { "table": "sha", "column": "school_id" }, "operation": "in", "value": "{{scope_context.schools.flatten('id')}}" }] }
      ] }
    } } },
    { "name": "students_with_devices", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": {
      "table": { "name": "device_student_assignments", "alias": "a" }, "distinct": true,
      "joins": [
        { "table": "device_school_allocations", "alias": "sha", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "sha", "column": "id", "operation": "=", "value": { "table": "a", "column": "school_allocation_id" } }] } },
        { "table": "device_district_allocations", "alias": "da", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "da", "column": "id", "operation": "=", "value": { "table": "sha", "column": "district_allocation_id" } }] } }
      ], "columns": [{ "table": "a", "column": "student_id" }],
      "wheres": { "condition": "AND", "rules": [
        { "data": { "table": "a", "column": "active_record_key" }, "operation": "=", "value": 1 },
        { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length > 0}}", "rules": [{ "data": { "table": "da", "column": "district_id" }, "operation": "in", "value": "{{scope_context.districts.flatten('id')}}" }] },
        { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length == 0 && scope_context.schools.length > 0}}", "rules": [{ "data": { "table": "sha", "column": "school_id" }, "operation": "in", "value": "{{scope_context.schools.flatten('id')}}" }] }
      ] }
    } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "school_available": "{{school_available}}", "student_assigned": "{{student_assigned}}", "students_with_devices": "{{students_with_devices.length}}" } } }
  ], "catch": { "steps": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Student assignment summary could not be loaded." } } }] } }
}
