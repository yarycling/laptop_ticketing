{
  "settings": {
    "options": {
      "method": "post",
      "nocsrf": true
    }
  },
  "exec": {
    "steps": [
      {
        "module": "core",
        "action": "exec",
        "options": {
          "exec": "security_require_super_admin",
          "params": {}
        },
        "name": "admin_only"
      },
      {
        "module": "core",
        "action": "exec",
        "options": {
          "exec": "security_require_permission",
          "params": {
            "permission": "users.update"
          }
        },
        "name": "permission"
      },
      {
        "module": "auth",
        "action": "identify",
        "options": {
          "provider": "portalSecurity"
        },
        "name": "identity"
      },
      {
        "module": "core",
        "action": "response",
        "options": {
          "status": 409,
          "data": {
            "success": false,
            "error": "Manage security groups and scope together from Administration \u2192 Users.",
            "redirect": "/admin/users"
          }
        }
      }
    ],
    "catch": {
      "steps": [
        {
          "module": "core",
          "action": "response",
          "options": {
            "status": 400,
            "data": {
              "success": false,
              "error": "{{admin_error || 'The operation could not be completed. Check the supplied values and try again.'}}"
            }
          }
        }
      ]
    }
  }
}
