{
  "settings":{"options":{"method":"post","nocsrf":true}},
  "meta":{"$_POST":[{"name":"id","type":"number"},{"name":"pool_code","type":"text"},{"name":"name","type":"text"},{"name":"service_location_id","type":"number"},{"name":"is_default","type":"number"}]},
  "exec":{"steps":[
    {"name":"permission","module":"core","action":"exec","output":true,"options":{"exec":"security_require_permission","params":{"permission":"spare_pools.manage"}}},
    {"name":"identity","module":"auth","action":"identify","options":{"provider":"portalSecurity"}},
    {"module":"core","action":"condition","options":{"if":"{{!$_POST.name || !$_POST.name.trim() || (!$_POST.id && (!$_POST.pool_code || !$_POST.pool_code.trim() || !$_POST.service_location_id)) || (!$_POST.id && $_POST.is_default != 0 && $_POST.is_default != 1)}}","then":{"steps":[{"module":"core","action":"response","options":{"status":400,"data":{"success":false,"error":"Enter a pool name, code, repair centre and default setting."}}}]}}},
    {"name":"location","module":"dbconnector","action":"single","output":true,"options":{"connection":"db","sql":{"table":"service_locations","columns":[{"column":"id"},{"column":"name"}],"wheres":{"condition":"AND","rules":[{"data":{"column":"id"},"operation":"=","value":"{{$_POST.service_location_id}}"},{"data":{"column":"location_type"},"operation":"=","value":"REPAIR_CENTRE"},{"data":{"column":"is_active"},"operation":"=","value":1}]}}}},
    {"module":"core","action":"condition","options":{"if":"{{!$_POST.id && !location.id}}","then":{"steps":[{"module":"core","action":"response","options":{"status":400,"data":{"success":false,"error":"Choose an active repair centre."}}}]}}},
    {"name":"existing_pool","module":"dbconnector","action":"single","output":true,"options":{"connection":"db","sql":{"table":"spare_pools","columns":[{"column":"id"},{"column":"pool_code"},{"column":"name"},{"column":"service_location_id"}],"wheres":{"condition":"AND","rules":[{"data":{"column":"id"},"operation":"=","value":"{{$_POST.id}}"}]}}}},
    {"module":"core","action":"condition","options":{"if":"{{$_POST.id && !existing_pool.id}}","then":{"steps":[{"module":"core","action":"response","options":{"status":404,"data":{"success":false,"error":"Spare pool was not found."}}}]}}},
    {"module":"core","action":"condition","options":{"if":"{{$_POST.id}}","then":{"steps":[
      {"name":"edit_transaction","module":"dbupdater","action":"transaction","options":{"connection":"db","exec":{"steps":[
        {"name":"update_pool","module":"dbupdater","action":"update","output":true,"options":{"connection":"db","sql":{"table":"spare_pools","values":[{"column":"name","value":"{{$_POST.name.trim()}}"},{"column":"updated_by","value":"{{identity}}"}],"wheres":{"condition":"AND","rules":[{"data":{"column":"id"},"operation":"=","value":"{{existing_pool.id}}"}]}}}},
        {"name":"audit_edit","module":"dbupdater","action":"insert","options":{"connection":"db","sql":{"table":"audit_logs","values":[{"column":"actor_user_id","value":"{{identity}}"},{"column":"action","value":"spare_pool_updated"},{"column":"module","value":"spare_pools"},{"column":"entity_type","value":"spare_pool"},{"column":"entity_id","value":"{{existing_pool.id}}"},{"column":"description","value":"{{'Updated spare pool ' + existing_pool.pool_code + ': ' + existing_pool.name + ' → ' + $_POST.name.trim()}}"}]}}}
      ]}}},
      {"module":"core","action":"response","options":{"status":200,"data":{"success":true,"message":"Spare pool updated."}}}
    ]},"else":{"steps":[
      {"name":"code_count","module":"dbconnector","action":"count","output":true,"options":{"connection":"db","sql":{"table":"spare_pools","wheres":{"condition":"AND","rules":[{"data":{"column":"pool_code"},"operation":"=","value":"{{$_POST.pool_code.trim().uppercase()}}"}]}}}},
      {"module":"core","action":"condition","options":{"if":"{{code_count > 0}}","then":{"steps":[{"module":"core","action":"response","options":{"status":409,"data":{"success":false,"error":"That pool code is already in use."}}}]}}},
      {"name":"create_transaction","module":"dbupdater","action":"transaction","options":{"connection":"db","exec":{"steps":[
        {"module":"core","action":"condition","options":{"if":"{{$_POST.is_default == 1}}","then":{"steps":[{"module":"dbupdater","action":"update","options":{"connection":"db","sql":{"table":"spare_pools","values":[{"column":"is_default","value":0},{"column":"active_default_key","value":null},{"column":"updated_by","value":"{{identity}}"}],"wheres":{"condition":"AND","rules":[{"data":{"column":"service_location_id"},"operation":"=","value":"{{location.id}}"},{"data":{"column":"is_default"},"operation":"=","value":1}]}}}}]}}},
        {"name":"create_pool","module":"dbupdater","action":"insert","output":true,"options":{"connection":"db","sql":{"table":"spare_pools","values":[{"column":"pool_code","value":"{{$_POST.pool_code.trim().uppercase()}}"},{"column":"name","value":"{{$_POST.name.trim()}}"},{"column":"service_location_id","value":"{{location.id}}"},{"column":"status","value":"active"},{"column":"is_default","value":"{{$_POST.is_default == 1 ? 1 : 0}}"},{"column":"active_default_key","value":"{{$_POST.is_default == 1 ? 1 : null}}"},{"column":"created_by","value":"{{identity}}"},{"column":"updated_by","value":"{{identity}}"}]}}},
        {"name":"audit_create","module":"dbupdater","action":"insert","options":{"connection":"db","sql":{"table":"audit_logs","values":[{"column":"actor_user_id","value":"{{identity}}"},{"column":"action","value":"spare_pool_created"},{"column":"module","value":"spare_pools"},{"column":"entity_type","value":"spare_pool"},{"column":"entity_id","value":"{{create_pool.identity}}"},{"column":"description","value":"{{'Created spare pool ' + $_POST.pool_code.trim().uppercase() + ' at ' + location.name}}"}]}}}
      ]}}},
      {"module":"core","action":"response","options":{"status":201,"data":{"success":true,"message":"Spare pool created."}}}
    ]}}},
    {"module":"core","action":"response","options":{"status":200,"data":{"success":true}}}
  ],"catch":[{"module":"core","action":"response","options":{"status":409,"data":{"success":false,"error":"The pool could not be saved because a conflicting change occurred. Refresh and try again."}}}]}
}
