{
  "settings":{"options":{"method":"get","nocsrf":true}},
  "meta":{"$_GET":[{"name":"name","type":"text"},{"name":"service_location_id","type":"number"}]},
  "exec":{"steps":[
    {"name":"permission","module":"core","action":"exec","output":true,"options":{"exec":"security_require_permission","params":{"permission":"spare_pools.manage"}}},
    {"name":"location","module":"dbconnector","action":"single","output":true,"options":{"connection":"db","sql":{"table":"service_locations","columns":[{"column":"id"},{"column":"code"}],"wheres":{"condition":"AND","rules":[{"data":{"column":"id"},"operation":"=","value":"{{$_GET.service_location_id}}"},{"data":{"column":"location_type"},"operation":"=","value":"REPAIR_CENTRE"},{"data":{"column":"is_active"},"operation":"=","value":1}]}}}},
    {"name":"pool_code_base","module":"core","action":"setvalue","options":{"key":"pool_code_base","value":"{{location.code && $_GET.name ? location.code + '-' + $_GET.name.trim().slugify().uppercase() : ''}}"}},
    {"name":"matching_codes","module":"dbconnector","action":"count","output":true,"options":{"connection":"db","sql":{"table":"spare_pools","wheres":{"condition":"AND","rules":[{"data":{"column":"pool_code"},"operator":"begins_with","value":"{{pool_code_base}}"}]}}}},
    {"module":"core","action":"response","options":{"status":200,"data":{"success":true,"name":"{{$_GET.name}}","service_location_id":"{{location.id}}","code":"{{pool_code_base ? pool_code_base + (matching_codes ? '-' + (matching_codes + 1) : '') : ''}}"}}}
  ],"catch":[{"module":"core","action":"response","options":{"status":500,"data":{"success":false,"error":"A spare-pool code could not be generated."}}}]}
}
