{
  "settings": {
    "options": {
      "method": "get",
      "nocsrf": true
    }
  },
  "exec": {
    "steps": [
      {
        "name": "permission",
        "module": "core",
        "action": "exec",
        "output": true,
        "options": {
          "exec": "security_require_permission",
          "params": {
            "permission": "spare_pools.view"
          }
        }
      },
      {
        "name": "scope_context",
        "module": "core",
        "action": "exec",
        "output": true,
        "options": {
          "exec": "security_get_scope_context",
          "params": {}
        }
      },
      {
        "name": "pools",
        "module": "dbconnector",
        "action": "select",
        "output": true,
        "options": {
          "connection": "db",
          "sql": {
            "table": {
              "name": "spare_pools",
              "alias": "p"
            },
            "columns": [
              {
                "table": "p",
                "column": "id"
              },
              {
                "table": "p",
                "column": "pool_code"
              },
              {
                "table": "p",
                "column": "name"
              },
              {
                "table": "p",
                "column": "service_location_id"
              },
              {
                "table": "p",
                "column": "status"
              },
              {
                "table": "p",
                "column": "is_default"
              },
              {
                "table": "p",
                "column": "created_at"
              },
              {
                "table": "loc",
                "column": "code",
                "alias": "location_code"
              },
              {
                "table": "loc",
                "column": "name",
                "alias": "location_name"
              }
            ],
            "joins": [
              {
                "table": "service_locations",
                "alias": "loc",
                "type": "inner",
                "clauses": {
                  "condition": "AND",
                  "rules": [
                    {
                      "table": "loc",
                      "column": "id",
                      "operation": "=",
                      "value": {
                        "table": "p",
                        "column": "service_location_id"
                      }
                    }
                  ]
                }
              }
            ],
            "orders": [
              {
                "table": "loc",
                "column": "name",
                "direction": "asc"
              },
              {
                "table": "p",
                "column": "name",
                "direction": "asc"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "condition": "OR",
                  "conditional": "{{$_GET.search}}",
                  "rules": [
                    {
                      "data": {
                        "table": "p",
                        "column": "pool_code"
                      },
                      "operator": "contains",
                      "value": "{{$_GET.search}}"
                    },
                    {
                      "data": {
                        "table": "p",
                        "column": "name"
                      },
                      "operator": "contains",
                      "value": "{{$_GET.search}}"
                    }
                  ]
                },
                {
                  "condition": "AND",
                  "conditional": "{{$_GET.location_id}}",
                  "rules": [
                    {
                      "data": {
                        "table": "p",
                        "column": "service_location_id"
                      },
                      "operation": "=",
                      "value": "{{$_GET.location_id}}"
                    }
                  ]
                },
                {
                  "condition": "AND",
                  "conditional": "{{$_GET.status}}",
                  "rules": [
                    {
                      "data": {
                        "table": "p",
                        "column": "status"
                      },
                      "operation": "=",
                      "value": "{{$_GET.status}}"
                    }
                  ]
                },
                {
                  "condition": "AND",
                  "conditional": "{{$_GET.default_status == '0' || $_GET.default_status == '1'}}",
                  "rules": [
                    {
                      "data": {
                        "table": "p",
                        "column": "is_default"
                      },
                      "operation": "=",
                      "value": "{{$_GET.default_status}}"
                    }
                  ]
                },
                {
                  "condition": "OR",
                  "rules": [
                    {
                      "condition": "AND",
                      "conditional": "{{permission.bypass == 'SUPER_ADMIN' || scope_context.has_national_scope}}",
                      "rules": [
                        {
                          "data": {
                            "table": "p",
                            "column": "id"
                          },
                          "operation": ">",
                          "value": 0
                        }
                      ]
                    },
                    {
                      "condition": "AND",
                      "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.service_locations.length > 0}}",
                      "rules": [
                        {
                          "data": {
                            "table": "p",
                            "column": "service_location_id"
                          },
                          "operation": "in",
                          "value": "{{scope_context.service_locations.flatten('id')}}"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        }
      },
