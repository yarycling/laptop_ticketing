{
  "settings": {
    "options": {
      "method": "post",
      "nocsrf": true
    }
  },
  "meta": {
    "$_POST": [
      {
        "name": "id",
        "type": "number"
      }
    ]
  },
  "exec": {
    "steps": [
      {
        "name": "permission",
        "module": "core",
        "action": "exec",
        "output": true,
        "options": {
          "exec": "security_require_permission",
          "params": {
            "permission": "spare_pools.manage"
          }
        }
      },
      {
        "name": "identity",
        "module": "auth",
        "action": "identify",
        "options": {
          "provider": "portalSecurity"
        }
      },
      {
        "name": "pool",
        "module": "dbconnector",
        "action": "single",
        "output": true,
        "options": {
          "connection": "db",
          "sql": {
            "table": {
              "name": "spare_pools",
              "alias": "p"
            },
            "columns": [
              {
                "table": "p",
                "column": "id"
              },
              {
                "table": "p",
                "column": "pool_code"
              },
              {
                "table": "p",
                "column": "name"
              },
              {
                "table": "p",
                "column": "service_location_id"
              },
              {
                "table": "p",
                "column": "status"
              },
              {
                "table": "loc",
                "column": "name",
                "alias": "location_name"
              }
            ],
            "joins": [
              {
                "table": "service_locations",
                "alias": "loc",
                "type": "inner",
                "clauses": {
                  "condition": "AND",
                  "rules": [
                    {
                      "table": "loc",
                      "column": "id",
                      "operation": "=",
                      "value": {
                        "table": "p",
                        "column": "service_location_id"
                      }
                    }
                  ]
                }
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "data": {
                    "table": "p",
                    "column": "id"
                  },
                  "operation": "=",
                  "value": "{{$_POST.id}}"
                },
                {
                  "data": {
                    "table": "p",
                    "column": "status"
                  },
                  "operation": "=",
                  "value": "active"
                },
                {
                  "data": {
                    "table": "loc",
                    "column": "location_type"
                  },
                  "operation": "=",
                  "value": "REPAIR_CENTRE"
                },
                {
                  "data": {
                    "table": "loc",
                    "column": "is_active"
                  },
                  "operation": "=",
                  "value": 1
                }
              ]
            }
          }
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{!pool.id}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 400,
                  "data": {
                    "success": false,
                    "error": "Choose an active pool at an active repair centre."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "name": "default_transaction",
        "module": "dbupdater",
        "action": "transaction",
        "options": {
          "connection": "db",
          "exec": {
            "steps": [
              {
                "name": "serialize_location_default",
                "module": "dbupdater",
                "action": "update",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "service_locations",
                    "values": [
                      {
                        "column": "is_active",
                        "value": 1
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "id"
                          },
                          "operation": "=",
                          "value": "{{pool.service_location_id}}"
                        },
                        {
                          "data": {
                            "column": "is_active"
                          },
                          "operation": "=",
                          "value": 1
                        }
                      ]
                    }
                  }
                }
              },
              {
                "name": "previous_default",
                "module": "dbconnector",
                "action": "single",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "spare_pools",
                    "columns": [
                      {
                        "column": "id"
                      },
                      {
                        "column": "pool_code"
                      },
                      {
                        "column": "name"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "service_location_id"
                          },
                          "operation": "=",
                          "value": "{{pool.service_location_id}}"
                        },
                        {
                          "data": {
                            "column": "status"
                          },
                          "operation": "=",
                          "value": "active"
                        },
                        {
                          "data": {
                            "column": "is_default"
                          },
                          "operation": "=",
                          "value": 1
                        }
                      ]
                    }
                  }
                }
              },
              {
                "name": "clear_default",
                "module": "dbupdater",
                "action": "update",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "spare_pools",
                    "values": [
                      {
                        "column": "is_default",
                        "value": 0
                      },
                      {
                        "column": "active_default_key",
                        "value": null
                      },
                      {
                        "column": "updated_by",
                        "value": "{{identity}}"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "service_location_id"
                          },
                          "operation": "=",
                          "value": "{{pool.service_location_id}}"
                        },
                        {
                          "data": {
                            "column": "is_default"
                          },
                          "operation": "=",
                          "value": 1
                        }
                      ]
                    }
                  }
                }
              },
              {
                "name": "set_default",
                "module": "dbupdater",
                "action": "update",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "spare_pools",
                    "values": [
                      {
                        "column": "is_default",
                        "value": 1
                      },
                      {
                        "column": "active_default_key",
                        "value": 1
                      },
                      {
                        "column": "updated_by",
                        "value": "{{identity}}"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "id"
                          },
                          "operation": "=",
                          "value": "{{pool.id}}"
                        },
                        {
                          "data": {
                            "column": "status"
                          },
                          "operation": "=",
                          "value": "active"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "name": "audit_default",
                "module": "dbupdater",
                "action": "insert",
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "audit_logs",
                    "values": [
                      {
                        "column": "actor_user_id",
                        "value": "{{identity}}"
                      },
                      {
                        "column": "action",
                        "value": "spare_pool_default_changed"
                      },
                      {
                        "column": "module",
                        "value": "spare_pools"
                      },
                      {
                        "column": "entity_type",
                        "value": "spare_pool"
                      },
                      {
                        "column": "entity_id",
                        "value": "{{pool.id}}"
                      },
                      {
                        "column": "description",
                        "value": "{{'Changed default spare pool at ' + pool.location_name + ' from ' + (previous_default.pool_code || 'none') + ' to ' + pool.pool_code}}"
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      {
        "module": "core",
        "action": "response",
        "options": {
          "status": 200,
          "data": {
            "success": true,
            "message": "Default spare pool updated."
          }
        }
      }
    ],
    "catch": [
      {
        "module": "core",
        "action": "response",
        "options": {
          "status": 409,
          "data": {
            "success": false,
            "error": "The default pool changed at the same time. Refresh the list and try again."
          }
        }
      }
    ]
  }
}
