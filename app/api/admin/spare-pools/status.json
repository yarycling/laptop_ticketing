{
  "settings":{"options":{"method":"post","nocsrf":true}},
  "meta":{"$_POST":[{"name":"id","type":"number"},{"name":"status","type":"text"}]},
  "exec":{"steps":[
    {"name":"permission","module":"core","action":"exec","output":true,"options":{"exec":"security_require_permission","params":{"permission":"spare_pools.manage"}}},
    {"module":"core","action":"condition","options":{"if":"{{$_POST.status != 'active' && $_POST.status != 'inactive'}}","then":{"steps":[{"module":"core","action":"response","options":{"status":400,"data":{"success":false,"error":"Choose active or inactive status."}}}]}}},
    {"name":"pool","module":"dbconnector","action":"single","output":true,"options":{"connection":"db","sql":{"table":"spare_pools","columns":[{"column":"id"},{"column":"pool_code"},{"column":"name"},{"column":"service_location_id"},{"column":"status"},{"column":"is_default"}],"wheres":{"condition":"AND","rules":[{"data":{"column":"id"},"operation":"=","value":"{{$_POST.id}}"}]}}}},
    {"module":"core","action":"condition","options":{"if":"{{!pool.id}}","then":{"steps":[{"module":"core","action":"response","options":{"status":404,"data":{"success":false,"error":"Spare pool was not found."}}}]}}},
    {"name":"identity","module":"auth","action":"identify","options":{"provider":"portalSecurity"}},
    {"name":"status_transaction","module":"dbupdater","action":"transaction","options":{"connection":"db","exec":{"steps":[
      {"name":"update_status","module":"dbupdater","action":"update","output":true,"options":{"connection":"db","sql":{"table":"spare_pools","values":[{"column":"status","value":"{{$_POST.status}}"},{"column":"is_default","value":"{{$_POST.status == 'active' ? 0 : 0}}"},{"column":"active_default_key","value":null},{"column":"updated_by","value":"{{identity}}"}],"wheres":{"condition":"AND","rules":[{"data":{"column":"id"},"operation":"=","value":"{{pool.id}}"}]}}}},
      {"name":"audit_status","module":"dbupdater","action":"insert","options":{"connection":"db","sql":{"table":"audit_logs","values":[{"column":"actor_user_id","value":"{{identity}}"},{"column":"action","value":"{{$_POST.status == 'active' ? 'spare_pool_activated' : 'spare_pool_deactivated'}}"},{"column":"module","value":"spare_pools"},{"column":"entity_type","value":"spare_pool"},{"column":"entity_id","value":"{{pool.id}}"},{"column":"description","value":"{{(($_POST.status == 'active' ? 'Activated ' : 'Deactivated ') + pool.pool_code)}}"}]}}}
    ]}}},
    {"module":"core","action":"response","options":{"status":200,"data":{"success":true,"message":"{{$_POST.status == 'active' ? 'Spare pool activated.' : 'Spare pool deactivated.'}}","warning":"{{$_POST.status == 'inactive' && pool.is_default == 1 ? 'This repair centre now has no active default spare pool. Select another active pool as default to enable temporary loan requests.' : ''}}"}}}
  ],"catch":[{"module":"core","action":"response","options":{"status":500,"data":{"success":false,"error":"Spare pool status could not be changed."}}}]}
}
