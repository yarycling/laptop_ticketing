{
  "meta": { "$_GET": [{ "name": "delivery_id", "type": "number" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "notifications.manage" } } },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "name": "delivery", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "notification_deliveries", "columns": [{ "column": "id" }, { "column": "delivery_number" }, { "column": "notification_event_id" }, { "column": "notification_recipient_id" }, { "column": "user_id" }, { "column": "channel_code" }, { "column": "recipient_address" }, { "column": "recipient_name" }, { "column": "subject_snapshot" }, { "column": "body_text_snapshot" }, { "column": "body_html_snapshot" }, { "column": "action_url_snapshot" }, { "column": "status_code" }, { "column": "attempt_count" }, { "column": "max_attempts" }, { "column": "next_attempt_at" }, { "column": "last_attempt_at" }, { "column": "sent_at" }, { "column": "last_error_code" }, { "column": "last_error_message" }, { "column": "created_at" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{$_GET.delivery_id}}" }] } } } },
    { "name": "attempts", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": "notification_delivery_attempts", "columns": [{ "column": "id" }, { "column": "attempt_number" }, { "column": "attempted_at" }, { "column": "outcome_code" }, { "column": "error_code" }, { "column": "error_message" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "notification_delivery_id" }, "operation": "=", "value": "{{delivery.id}}" }] }, "orders": [{ "column": "attempt_number", "direction": "asc" }] } } },
    { "module": "core", "action": "response", "options": { "status": "{{delivery.id ? 200 : 404}}", "data": { "success": "{{!!delivery.id}}", "delivery": "{{delivery}}", "attempts": "{{attempts}}" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Email delivery detail could not be loaded." } } }] }
}
