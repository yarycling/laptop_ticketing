{
  "settings": { "options": { "method": "post", "nocsrf": true } },
  "meta": { "$_POST": [{ "name": "recipient_username", "type": "text" }, { "name": "fixture_slot", "type": "text" }, { "name": "event_type_code", "type": "text" }, { "name": "severity_code", "type": "text" }, { "name": "send_email", "type": "text" }, { "name": "defer_email_send", "type": "text" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "notifications.manage" } } },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "module": "core", "action": "condition", "options": { "if": "{{!['portal.admin','p7b.ttpost.test','p9db.ho.test'].contains($_POST.recipient_username)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Choose an approved Phase 9D test recipient." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{($_POST.fixture_slot && !['PRIMARY','BULK','GUI','BROWSER_BULK','FINAL','GUI_FINAL','EMAIL_SUCCESS','EMAIL_FINAL','EMAIL_RETRY','EMAIL_NOT_DUE','EMAIL_MAX','EMAIL_NO_ADDRESS','EMAIL_INVALID','EMAIL_CONCURRENCY'].contains($_POST.fixture_slot)) || ($_POST.event_type_code && $_POST.event_type_code != 'TEST_NOTIFICATION') || ($_POST.severity_code && $_POST.severity_code != 'INFO') || ($_POST.send_email && !['true','1'].contains($_POST.send_email)) || (['EMAIL_SUCCESS','EMAIL_FINAL','EMAIL_RETRY','EMAIL_NOT_DUE','EMAIL_MAX','EMAIL_NO_ADDRESS','EMAIL_INVALID','EMAIL_CONCURRENCY'].contains($_POST.fixture_slot) && $_POST.send_email != 'true' && $_POST.send_email != '1') || ($_POST.defer_email_send && (!['true','1'].contains($_POST.defer_email_send) || $_POST.send_email != 'true' && $_POST.send_email != '1'))}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Only controlled notification types and manager-authorized email test slots are supported." } } }] } } },
    { "name": "recipient", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "users", "columns": [{ "column": "id" }, { "column": "username" }, { "column": "status" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "username" }, "operation": "=", "value": "{{$_POST.recipient_username}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!recipient.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Test recipient is unavailable." } } }] } } },
    { "name": "create", "module": "core", "action": "exec", "output": true, "options": { "exec": "notification_create", "params": { "idempotency_key": "{{'PHASE9D-A:TEST:' + ($_POST.fixture_slot || 'PRIMARY') + ':' + recipient.username}}", "event_type_code": "{{$_POST.event_type_code || 'TEST_NOTIFICATION'}}", "severity_code": "{{$_POST.severity_code || 'INFO'}}", "title": "{{$_POST.send_email == 'true' || $_POST.send_email == '1' ? 'Phase 9D-D email delivery acceptance' : 'Phase 9D-A inbox test'}}", "message": "{{$_POST.send_email == 'true' || $_POST.send_email == '1' ? 'This controlled notification verifies the Wappler email delivery and retry path.' : 'This controlled notification verifies your in-app inbox and read state.'}}", "source_type": "PHASE9D_TEST", "source_id": "{{recipient.username}}", "recipient_user_id": "{{recipient.id}}", "created_by": "{{identity}}", "force_email": "{{$_POST.send_email == 'true' || $_POST.send_email == '1'}}", "defer_email_send": "{{$_POST.defer_email_send == 'true' || $_POST.defer_email_send == '1'}}" } } },
    { "name": "email_delivery", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "notification_deliveries", "columns": [{ "column": "id" }, { "column": "delivery_number" }, { "column": "status_code" }, { "column": "attempt_count" }, { "column": "sent_at" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "notification_event_id" }, "operation": "=", "value": "{{create.event_id}}" }, { "data": { "column": "notification_recipient_id" }, "operation": "=", "value": "{{recipient.id}}" }, { "data": { "column": "channel_code" }, "operation": "=", "value": "EMAIL" }] } } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "event_id": "{{create.event_id}}", "created": "{{create.created}}", "email_delivery": "{{email_delivery}}" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Test notification could not be created." } } }] }
}
