{
  "settings": {
    "options": {
      "method": "post",
      "nocsrf": true
    }
  },
  "meta": {
    "$_POST": [
      {
        "type": "number",
        "name": "id"
      },
      {
        "type": "text",
        "name": "district_id"
      },
      {
        "type": "text",
        "name": "name"
      },
      {
        "type": "text",
        "name": "status"
      }
    ]
  },
  "exec": {
    "steps": [
      {
        "name": "require_permission",
        "module": "core",
        "action": "exec",
        "options": {
          "exec": "security_require_permission",
          "params": {
            "permission": "schools.manage"
          }
        },
        "output": true
      },
      {
        "name": "identity",
        "module": "auth",
        "action": "identify",
        "options": {
          "provider": "portalSecurity"
        }
      },
      {
        "name": "school_name",
        "module": "core",
        "action": "setvalue",
        "options": {
          "key": "school_name",
          "value": "{{$_POST.name.trim()}}"
        }
      },
      {
        "name": "school_status",
        "module": "core",
        "action": "setvalue",
        "options": {
          "key": "school_status",
          "value": "{{$_POST.status == 'inactive' ? 'inactive' : 'active'}}"
        }
      },
      {
        "name": "school_code_base",
        "module": "core",
        "action": "setvalue",
        "options": {
          "key": "school_code_base",
          "value": "{{school_name.slugify().uppercase() || 'SCHOOL'}}"
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{!school_name}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 400,
                  "data": {
                    "success": false,
                    "error": "School name is required."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "name": "district",
        "module": "dbconnector",
        "action": "single",
        "options": {
          "connection": "db",
          "sql": {
            "table": "districts",
            "columns": [
              {
                "column": "id"
              },
              {
                "column": "status"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "data": {
                    "column": "id"
                  },
                  "operation": "=",
                  "value": "{{$_POST.district_id}}"
                }
              ]
            }
          }
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{$_POST.district_id && (!district.id || district.status != 'active')}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 400,
                  "data": {
                    "success": false,
                    "error": "Choose an active district or leave this school unassigned."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "name": "matching_school_code_count",
        "module": "dbconnector",
        "action": "count",
        "options": {
          "connection": "db",
          "sql": {
            "table": "schools",
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "data": {
                    "column": "school_code"
                  },
                  "operation": "=",
                  "value": "{{school_code_base}}"
                },
                {
                  "data": {
                    "column": "id"
                  },
                  "operation": "!=",
                  "value": "{{$_POST.id ? $_POST.id : 0}}"
                }
              ]
            }
          }
        }
      },
      {
        "name": "school_code_suffix_count",
        "module": "dbconnector",
        "action": "count",
        "options": {
          "connection": "db",
          "sql": {
            "table": "schools",
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "data": {
                    "column": "school_code"
                  },
                  "operator": "begins_with",
                  "value": "{{school_code_base + '-'}}"
                },
                {
                  "data": {
                    "column": "id"
                  },
                  "operation": "!=",
                  "value": "{{$_POST.id ? $_POST.id : 0}}"
                }
              ]
            }
          }
        }
      },
      {
        "name": "generated_school_code",
        "module": "core",
        "action": "setvalue",
        "options": {
          "key": "generated_school_code",
          "value": "{{matching_school_code_count > 0 ? school_code_base + '-' + (school_code_suffix_count + 1) : school_code_base}}"
        }
      },
      {
        "name": "save_school_transaction",
        "module": "dbupdater",
        "action": "transaction",
        "options": {
          "connection": "db",
          "exec": {
            "steps": [
              {
                "module": "core",
                "action": "condition",
                "options": {
                  "if": "{{$_POST.id}}",
                  "then": {
                    "steps": [
                      {
                        "name": "update_school",
                        "module": "dbupdater",
                        "action": "update",
                        "options": {
                          "connection": "db",
                          "sql": {
                            "table": "schools",
                            "values": [
                              {
                                "column": "district_id",
                                "value": "{{$_POST.district_id || null}}"
                              },
                              {
                                "column": "name",
                                "value": "{{school_name}}"
                              },
                              {
                                "column": "status",
                                "value": "{{school_status}}"
                              },
                              {
                                "column": "updated_at",
                                "value": "{{NOW}}"
                              }
                            ],
                            "wheres": {
                              "condition": "AND",
                              "rules": [
                                {
                                  "data": {
                                    "column": "id"
                                  },
                                  "operation": "=",
                                  "value": "{{$_POST.id}}"
                                }
                              ]
                            }
                          }
                        }
                      },
                      {
                        "name": "audit_school_updated",
                        "module": "dbupdater",
                        "action": "insert",
                        "options": {
                          "connection": "db",
                          "sql": {
                            "table": "audit_logs",
                            "values": [
                              {
                                "column": "actor_user_id",
                                "value": "{{identity}}"
                              },
                              {
                                "column": "action",
                                "value": "school.updated"
                              },
                              {
                                "column": "module",
                                "value": "organisation"
                              },
                              {
                                "column": "entity_type",
                                "value": "school"
                              },
                              {
                                "column": "entity_id",
                                "value": "{{$_POST.id}}"
                              },
                              {
                                "column": "description",
                                "value": "School updated."
                              },
                              {
                                "column": "created_at",
                                "value": "{{NOW}}"
                              }
                            ]
                          }
                        }
                      }
                    ]
                  }
                }
              },
              {
                "module": "core",
                "action": "condition",
                "options": {
                  "if": "{{!$_POST.id}}",
                  "then": {
                    "steps": [
                      {
                        "name": "create_school",
                        "module": "dbupdater",
                        "action": "insert",
                        "options": {
                          "connection": "db",
                          "sql": {
                            "table": "schools",
                            "values": [
                              {
                                "column": "district_id",
                                "value": "{{$_POST.district_id || null}}"
                              },
                              {
                                "column": "school_code",
                                "value": "{{generated_school_code}}"
                              },
                              {
                                "column": "name",
                                "value": "{{school_name}}"
                              },
                              {
                                "column": "status",
                                "value": "{{school_status}}"
                              },
                              {
                                "column": "created_at",
                                "value": "{{NOW}}"
                              },
                              {
                                "column": "updated_at",
                                "value": "{{NOW}}"
                              }
                            ]
                          }
                        }
                      },
                      {
                        "name": "audit_school_created",
                        "module": "dbupdater",
                        "action": "insert",
                        "options": {
                          "connection": "db",
                          "sql": {
                            "table": "audit_logs",
                            "values": [
                              {
                                "column": "actor_user_id",
                                "value": "{{identity}}"
                              },
                              {
                                "column": "action",
                                "value": "school.created"
                              },
                              {
                                "column": "module",
                                "value": "organisation"
                              },
                              {
                                "column": "entity_type",
                                "value": "school"
                              },
                              {
                                "column": "entity_id",
                                "value": "{{create_school.identity}}"
                              },
                              {
                                "column": "description",
                                "value": "School created."
                              },
                              {
                                "column": "created_at",
                                "value": "{{NOW}}"
                              }
                            ]
                          }
                        }
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      {
        "name": "saved_school",
        "module": "dbconnector",
        "action": "single",
        "output": true,
        "options": {
          "connection": "db",
          "sql": {
            "table": {
              "name": "schools",
              "alias": "s"
            },
            "columns": [
              {
                "table": "s",
                "column": "id",
                "alias": "id"
              },
              {
                "table": "s",
                "column": "name",
                "alias": "name"
              },
              {
                "table": "s",
                "column": "district_id",
                "alias": "district_id"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "data": {
                    "table": "s",
                    "column": "id"
                  },
                  "operation": "=",
                  "value": "{{$_POST.id ? $_POST.id : create_school.identity}}"
                }
              ]
            }
          }
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{!saved_school.id || saved_school.name != school_name || (($_POST.district_id || null) != (saved_school.district_id || null))}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 500,
                  "data": {
                    "success": false,
                    "error": "School changes could not be verified after saving."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "module": "core",
        "action": "response",
        "options": {
          "status": 200,
          "data": {
            "success": true
          }
        }
      }
    ],
    "catch": [
      {
        "module": "core",
        "action": "response",
        "options": {
          "status": 500,
          "data": {
            "success": false,
            "error": "School could not be saved."
          }
        }
      }
    ]
  }
}
