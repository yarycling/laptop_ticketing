{
  "settings": {
    "options": {
      "method": "get",
      "nocsrf": true
    }
  },
  "exec": {
    "steps": [
      {
        "module": "core",
        "action": "exec",
        "options": {
          "exec": "security_require_super_admin",
          "params": {}
        },
        "name": "admin_only"
      },
      {
        "module": "core",
        "action": "exec",
        "options": {
          "exec": "security_require_permission",
          "params": {
            "permission": "users.view"
          }
        },
        "name": "permission"
      },
      {
        "module": "auth",
        "action": "identify",
        "options": {
          "provider": "portalSecurity"
        },
        "name": "identity"
      },
      {
        "module": "dbconnector",
        "action": "select",
        "options": {
          "connection": "db",
          "sql": {
            "table": "admin_security_groups",
            "columns": [
              {
                "column": "id"
              },
              {
                "column": "name"
              },
              {
                "column": "label"
              },
              {
                "column": "description"
              },
              {
                "column": "scope_type"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "data": {
                    "column": "assignable"
                  },
                  "operation": "=",
                  "value": 1
                }
              ]
            }
          }
        },
        "name": "roles"
      },
      {
        "module": "dbconnector",
        "action": "select",
        "options": {
          "connection": "db",
          "sql": {
            "table": "districts",
            "columns": [
              {
                "column": "id"
              },
              {
                "column": "name"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "data": {
                    "column": "status"
                  },
                  "operation": "=",
                  "value": "active"
                }
              ]
            }
          }
        },
        "name": "districts"
      },
      {
        "module": "dbconnector",
        "action": "select",
        "options": {
          "connection": "db",
          "sql": {
            "table": "schools",
            "columns": [
              {
                "column": "id"
              },
              {
                "column": "name"
              },
              {
                "column": "district_id"
              }
            ],
            "orders": [
              {
                "column": "name",
                "direction": "asc"
              }
            ],
            "limit": 1000,
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "data": {
                    "column": "status"
                  },
                  "operation": "=",
                  "value": "active"
                },
                {
                  "data": {
                    "column": "district_id"
                  },
                  "operator": "in",
                  "value": "{{$_GET.district_ids ? $_GET.district_ids.toString().split(',') : []}}"
                }
              ]
            }
          }
        },
        "name": "schools"
      },
      {
        "module": "dbconnector",
        "action": "select",
        "options": {
          "connection": "db",
          "sql": {
            "table": "service_locations",
            "columns": [
              {
                "column": "id"
              },
              {
                "column": "name"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "data": {
                    "column": "is_active"
                  },
                  "operation": "=",
                  "value": 1
                },
                {
                  "data": {
                    "column": "location_type"
                  },
                  "operation": "=",
                  "value": "REPAIR_CENTRE"
                }
              ]
            }
          }
        },
        "name": "locations"
      },
      {
        "module": "core",
        "action": "response",
        "options": {
          "status": 200,
          "data": {
            "success": true,
            "roles": "{{roles}}",
            "districts": "{{districts}}",
            "schools": "{{schools}}",
            "locations": "{{locations}}"
          }
        }
      }
    ],
    "catch": [
      {
        "module": "core",
        "action": "response",
        "options": {
          "status": 400,
          "data": {
            "success": false,
            "error": "{{admin_error || 'The operation could not be completed. Check the supplied values and try again.'}}"
          }
        }
      }
    ]
  },
  "meta": {
    "$_GET": [
      {
        "name": "district_ids",
        "type": "text"
      }
    ]
  }
}
