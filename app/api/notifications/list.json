{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "meta": { "$_GET": [{ "name": "status", "type": "text" }, { "name": "severity", "type": "text" }, { "name": "event_type", "type": "text" }, { "name": "search", "type": "text" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "notifications.view" } } },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_GET.status && !['ALL','UNREAD','READ'].contains($_GET.status)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Choose All, Unread, or Read." } } }] } } },
    { "name": "rows", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": "v_notification_inbox", "columns": [{ "column": "recipient_id" }, { "column": "notification_event_id" }, { "column": "event_type_code" }, { "column": "event_type_name" }, { "column": "source_type" }, { "column": "source_id" }, { "column": "ticket_id" }, { "column": "ticket_number" }, { "column": "origin_school_id" }, { "column": "school_name" }, { "column": "origin_district_id" }, { "column": "district_name" }, { "column": "serial_number" }, { "column": "asset_tag" }, { "column": "sla_instance_id" }, { "column": "sla_policy_code" }, { "column": "escalation_case_id" }, { "column": "escalation_number" }, { "column": "escalation_level" }, { "column": "escalation_state_code" }, { "column": "logistics_case_id" }, { "column": "logistics_number" }, { "column": "handoff_type" }, { "column": "repair_job_id" }, { "column": "repair_centre_location_id" }, { "column": "repair_centre_name" }, { "column": "severity_code" }, { "column": "severity_name" }, { "column": "title" }, { "column": "message" }, { "column": "action_type" }, { "column": "action_reference" }, { "column": "created_at" }, { "column": "created_at_display" }, { "column": "created_by_name" }, { "column": "read_at" }, { "column": "read_state" }], "wheres": { "condition": "AND", "rules": [
      { "data": { "column": "user_id" }, "operation": "=", "value": "{{identity}}" },
      { "condition": "AND", "conditional": "{{$_GET.status == 'UNREAD'}}", "rules": [{ "data": { "column": "read_state" }, "operation": "=", "value": 0 }] },
      { "condition": "AND", "conditional": "{{$_GET.status == 'READ'}}", "rules": [{ "data": { "column": "read_state" }, "operation": "=", "value": 1 }] },
      { "condition": "AND", "conditional": "{{$_GET.severity && $_GET.severity != 'ALL'}}", "rules": [{ "data": { "column": "severity_code" }, "operation": "=", "value": "{{$_GET.severity}}" }] },
      { "condition": "AND", "conditional": "{{$_GET.event_type && $_GET.event_type != 'ALL'}}", "rules": [{ "data": { "column": "event_type_code" }, "operation": "=", "value": "{{$_GET.event_type}}" }] },
      { "condition": "OR", "conditional": "{{$_GET.search}}", "rules": [{ "data": { "column": "title" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "column": "message" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "column": "ticket_number" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "column": "school_name" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "column": "district_name" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "column": "logistics_number" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "column": "serial_number" }, "operator": "contains", "value": "{{$_GET.search}}" }] }
    ] }, "orders": [{ "column": "created_at", "direction": "desc" }, { "column": "notification_event_id", "direction": "desc" }], "limit": 100 } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "notifications": "{{rows}}" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Notifications could not be loaded." } } }] }
}
