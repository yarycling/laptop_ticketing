    {"name":"cases","module":"dbconnector","action":"select","output":true,"options":{"connection":"db","sql":{"table":{"name":"repair_exception_cases","alias":"ec"},"columns":[{"table":"ec","column":"id"},{"table":"ec","column":"current_status_code"},{"table":"t","column":"origin_district_id"},{"table":"j","column":"repair_centre_location_id"}],"joins":[{"table":"tickets","alias":"t","type":"inner","clauses":{"condition":"AND","rules":[{"table":"t","column":"id","operation":"=","value":{"table":"ec","column":"ticket_id"}}]}},{"table":"repair_jobs","alias":"j","type":"inner","clauses":{"condition":"AND","rules":[{"table":"j","column":"id","operation":"=","value":{"table":"ec","column":"repair_job_id"}}]}}],"wheres":{"condition":"AND","rules":[{"condition":"OR","rules":[{"condition":"AND","conditional":"{{permission.bypass == 'SUPER_ADMIN'}}","rules":[{"data":{"table":"ec","column":"id"},"operation":">","value":0}]},{"condition":"AND","conditional":"{{permission.bypass != 'SUPER_ADMIN' && scope_context.has_national_scope}}","rules":[{"data":{"table":"ec","column":"id"},"operation":">","value":0}]},{"condition":"AND","conditional":"{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length > 0}}","rules":[{"data":{"table":"t","column":"origin_district_id"},"operation":"in","value":"{{scope_context.districts.flatten('id')}}"}]},{"condition":"AND","conditional":"{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.service_locations.length > 0}}","rules":[{"data":{"table":"j","column":"repair_centre_location_id"},"operation":"in","value":"{{scope_context.service_locations.flatten('id')}}"}]}]}]}}}},
