{
  "settings": {
    "options": {
      "method": "get",
      "nocsrf": true
    }
  },
  "exec": {
    "steps": [
      {
        "name": "restrict",
        "module": "auth",
        "action": "restrict",
        "options": {
          "provider": "portalSecurity"
        }
      },
      {
        "name": "identity",
        "module": "auth",
        "action": "identify",
        "options": {
          "provider": "portalSecurity"
        }
      },
      {
        "name": "user",
        "module": "dbconnector",
        "action": "single",
        "options": {
          "connection": "db",
          "sql": {
            "table": "users",
            "columns": [
              {
                "column": "id"
              },
              {
                "column": "username"
              },
              {
                "column": "email"
              },
              {
                "column": "first_name"
              },
              {
                "column": "last_name"
              },
              {
                "column": "display_name"
              },
              {
                "column": "status"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "data": {
                    "column": "id"
                  },
                  "operation": "=",
                  "value": "{{identity}}"
                }
              ]
            }
          }
        }
      },
      {
        "name": "role_rows",
        "module": "dbconnector",
        "action": "select",
        "options": {
          "connection": "db",
          "sql": {
            "table": {
              "name": "user_roles",
              "alias": "ur"
            },
            "distinct": true,
            "columns": [
              {
                "table": "r",
                "column": "name",
                "alias": "name"
              }
            ],
            "joins": [
              {
                "table": "roles",
                "alias": "r",
                "type": "inner",
                "clauses": {
                  "condition": "AND",
                  "rules": [
                    {
                      "table": "r",
                      "column": "id",
                      "operation": "=",
                      "value": {
                        "table": "ur",
                        "column": "role_id"
                      }
                    }
                  ]
                }
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "data": {
                    "table": "ur",
                    "column": "user_id"
                  },
                  "operation": "=",
                  "value": "{{identity}}"
                }
              ]
            },
            "orders": [
              {
                "table": "r",
                "column": "name",
                "direction": "asc"
              }
            ]
          }
        }
      },
      {
        "name": "roles",
        "module": "core",
        "action": "setvalue",
        "options": {
          "key": "roles",
          "value": "{{role_rows.flatten('name')}}"
        }
      },
      {
        "name": "is_super_admin",
        "module": "core",
        "action": "setvalue",
        "options": {
          "key": "is_super_admin",
          "value": "{{roles.contains('SUPER_ADMIN')}}"
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{is_super_admin}}",
          "then": {
            "steps": [
              {
                "name": "permission_rows",
                "module": "dbconnector",
                "action": "select",
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "permissions",
                    "distinct": true,
                    "columns": [
                      {
                        "column": "name",
                        "alias": "name"
                      }
                    ],
                    "orders": [
                      {
                        "column": "name",
                        "direction": "asc"
                      }
                    ]
                  }
                }
              }
            ]
          },
          "else": {
            "steps": [
              {
                "name": "permission_rows",
                "module": "dbconnector",
                "action": "select",
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "user_effective_permissions",
                    "distinct": true,
                    "columns": [
                      {
                        "column": "permission_name",
                        "alias": "name"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "user_id"
                          },
                          "operation": "=",
                          "value": "{{identity}}"
                        }
                      ]
                    },
                    "orders": [
                      {
                        "column": "permission_name",
                        "direction": "asc"
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      {
        "name": "permissions",
        "module": "core",
        "action": "setvalue",
        "options": {
          "key": "permissions",
          "value": "{{permission_rows.flatten('name')}}"
        }
