{
  "settings": {
    "options": {
      "method": "post",
      "nocsrf": true
    }
  },
  "meta": {
    "$_POST": [
      {
        "name": "r",
        "type": "text"
      },
      {
        "name": "token",
        "type": "text"
      },
      {
        "name": "new_password",
        "type": "text"
      },
      {
        "name": "confirm_password",
        "type": "text"
      }
    ]
  },
  "exec": {
    "steps": [
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{!$_POST.r || $_POST.r.length() != 52 || !$_POST.token || $_POST.token.length() > 128}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 400,
                  "data": {
                    "success": false,
                    "error": "This password reset link is invalid or has expired."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "name": "reset_request",
        "module": "dbconnector",
        "action": "single",
        "options": {
          "connection": "db",
          "sql": {
            "table": "password_reset_requests",
            "columns": [
              {
                "column": "id"
              },
              {
                "column": "request_id"
              },
              {
                "column": "user_id"
              },
              {
                "column": "token_hash"
              },
              {
                "column": "expires_at"
              },
              {
                "column": "used_at"
              },
              {
                "column": "invalidated_at"
              },
              {
                "column": "purpose"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "data": {
                    "column": "request_id"
                  },
                  "operation": "=",
                  "value": "{{$_POST.r}}"
                }
              ]
            }
          }
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{!reset_request.id || !$_POST.token || $_POST.token.length() > 128 || reset_request.used_at || reset_request.invalidated_at || reset_request.expires_at <= NOW}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 400,
                  "data": {
                    "success": false,
                    "error": "This password reset link is invalid or has expired."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "name": "valid_secret",
        "module": "crypto",
        "action": "passwordVerify",
        "options": {
          "password": "{{$_POST.token}}",
          "hash": "{{reset_request.token_hash}}"
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{!valid_secret}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 400,
                  "data": {
                    "success": false,
                    "error": "This password reset link is invalid or has expired."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "name": "user",
        "module": "dbconnector",
        "action": "single",
        "options": {
          "connection": "db",
          "sql": {
            "table": "users",
            "columns": [
              {
                "column": "id"
              },
              {
                "column": "username"
              },
              {
                "column": "email"
              },
              {
                "column": "status"
              },
              {
                "column": "password_hash"
              },
              {
                "column": "auth_version"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "data": {
                    "column": "id"
                  },
                  "operation": "=",
                  "value": "{{reset_request.user_id}}"
                }
              ]
            }
          }
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{!user.id || user.status != 'active'}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 400,
                  "data": {
                    "success": false,
                    "error": "This password reset link is invalid or has expired."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "name": "password_normalized",
        "module": "core",
        "action": "setvalue",
        "options": {
          "key": "password_normalized",
          "value": "{{($_POST.new_password || '').lowercase()}}"
        }
      },
      {
        "name": "email_localpart",
        "module": "core",
        "action": "setvalue",
        "options": {
          "key": "email_localpart",
          "value": "{{user.email ? user.email.split('@')[0].lowercase() : ''}}"
        }
      },
      {
        "name": "blocked_passwords",
        "module": "core",
        "action": "setvalue",
        "options": {
          "key": "blocked_passwords",
          "value": "{{['password','password123','password123456','123456789012345','1234567890123456','qwertyuiopasdfgh','qwerty123456789','letmein123456789','administrator123','welcome12345678','changeme123456','iloveyou123456','correcthorsebatterystaple']}}"
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{!$_POST.new_password || $_POST.new_password.length() < 15 || $_POST.new_password.length() > 128 || $_POST.new_password != $_POST.confirm_password || blocked_passwords.contains(password_normalized) || (user.username.length() >= 3 && password_normalized.contains(user.username.lowercase())) || (email_localpart.length() >= 3 && password_normalized.contains(email_localpart)) || (user.email && password_normalized.contains(user.email.lowercase()))}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 400,
                  "data": {
                    "success": false,
                    "error": "Choose a password of 15 to 128 characters, avoid common or account-based passwords, and ensure both entries match."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "name": "current_password_reused",
        "module": "crypto",
        "action": "passwordVerify",
        "options": {
          "password": "{{$_POST.new_password}}",
          "hash": "{{user.password_hash}}"
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{current_password_reused}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 400,
                  "data": {
                    "success": false,
                    "error": "Choose a password you have not used as your current password."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "name": "new_password_hash",
        "module": "crypto",
        "action": "passwordHash",
        "options": {
          "password": "{{$_POST.new_password}}",
          "algo": "argon2id"
        }
      },
      {
        "name": "complete_reset",
        "module": "dbupdater",
        "action": "transaction",
        "options": {
          "connection": "db",
          "exec": {
            "steps": [
              {
                "name": "claim_token",
                "module": "dbupdater",
                "action": "update",
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "password_reset_requests",
                    "values": [
                      {
                        "column": "used_at",
                        "value": "{{NOW}}"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "id"
                          },
                          "operation": "=",
                          "value": "{{reset_request.id}}"
                        },
                        {
                          "data": {
                            "column": "used_at"
                          },
                          "operator": "is_null"
                        },
                        {
                          "data": {
                            "column": "invalidated_at"
                          },
                          "operator": "is_null"
                        },
                        {
                          "data": {
                            "column": "expires_at"
                          },
                          "operation": ">",
                          "value": "{{NOW}}"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "module": "core",
                "action": "condition",
                "options": {
                  "if": "{{claim_token.affected != 1}}",
                  "then": {
                    "steps": [
                      {
                        "module": "core",
                        "action": "response",
                        "options": {
                          "status": 400,
                          "data": {
                            "success": false,
                            "error": "This password reset link is invalid or has expired."
                          }
                        }
                      }
                    ]
                  }
                }
              },
              {
                "name": "update_password",
                "module": "dbupdater",
                "action": "update",
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "users",
                    "values": [
                      {
                        "column": "password_hash",
                        "value": "{{new_password_hash}}"
                      },
                      {
                        "column": "auth_version",
                        "value": "{{user.auth_version + 1}}"
                      },
                      {
                        "column": "password_changed_at",
                        "value": "{{NOW}}"
                      },
                      {
                        "column": "updated_at",
                        "value": "{{NOW}}"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "id"
                          },
                          "operation": "=",
                          "value": "{{user.id}}"
                        },
                        {
                          "data": {
                            "column": "auth_version"
                          },
                          "operation": "=",
                          "value": "{{user.auth_version}}"
                        },
                        {
                          "data": {
                            "column": "status"
                          },
                          "operation": "=",
                          "value": "active"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "module": "core",
                "action": "condition",
                "options": {
                  "if": "{{update_password.affected != 1}}",
                  "then": {
                    "steps": [
                      {
                        "module": "core",
                        "action": "error",
                        "options": {
                          "message": "PASSWORD_RESET_ACCOUNT_CHANGED"
                        }
                      }
                    ]
                  }
                }
              },
              {
                "name": "invalidate_other_requests",
                "module": "dbupdater",
                "action": "update",
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "password_reset_requests",
                    "values": [
                      {
                        "column": "invalidated_at",
                        "value": "{{NOW}}"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "user_id"
                          },
                          "operation": "=",
                          "value": "{{user.id}}"
                        },
                        {
                          "data": {
                            "column": "id"
                          },
                          "operation": "!=",
                          "value": "{{reset_request.id}}"
                        },
                        {
                          "data": {
                            "column": "used_at"
                          },
                          "operator": "is_null"
                        },
                        {
                          "data": {
                            "column": "invalidated_at"
                          },
                          "operator": "is_null"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "name": "audit_password_reset",
                "module": "dbupdater",
                "action": "insert",
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "audit_logs",
                    "values": [
                      {
                        "column": "actor_user_id",
                        "value": "{{user.id}}"
                      },
                      {
                        "column": "action",
                        "value": "{{reset_request.purpose == 'ACCOUNT_SETUP' ? 'ACCOUNT_SETUP_COMPLETED' : 'PASSWORD_RESET_COMPLETED'}}"
                      },
                      {
                        "column": "module",
                        "value": "security"
                      },
                      {
                        "column": "entity_type",
                        "value": "user"
                      },
                      {
                        "column": "entity_id",
                        "value": "{{user.id}}"
                      },
                      {
                        "column": "description",
                        "value": "User password reset completed."
                      }
                    ]
                  }
                }
              },
              {
                "name": "audit_session_revoked",
                "module": "dbupdater",
                "action": "insert",
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "audit_logs",
                    "values": [
                      {
                        "column": "actor_user_id",
                        "value": "{{user.id}}"
                      },
                      {
                        "column": "action",
                        "value": "SESSION_INVALIDATION_AFTER_PASSWORD_RESET"
                      },
                      {
                        "column": "module",
                        "value": "security"
                      },
                      {
                        "column": "entity_type",
                        "value": "user"
                      },
                      {
                        "column": "entity_id",
                        "value": "{{user.id}}"
                      },
                      {
                        "column": "description",
                        "value": "Outstanding authenticated sessions are revoked by the server-side auth-version guard."
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      {
        "module": "core",
        "action": "trycatch",
        "options": {
          "try": [
            {
              "module": "mail",
              "action": "send",
              "options": {
                "instance": "mail",
                "subject": "Your TSTT Laptop Portal password was changed",
                "fromName": "TSTT Laptop Portal",
                "fromEmail": "no+reply@tstt.co.tt",
                "replyTo": "no+reply@tstt.co.tt",
                "toName": "{{user.username}}",
                "toEmail": "{{user.email}}",
                "body": "Your TSTT Laptop Portal password has been changed. If you did not make this change, contact your administrator or support team immediately.",
                "source": "file",
                "contentType": "html",
                "bodyFile": "/app/emails/password-changed.html",
                "embedImages": false
              }
            }
          ],
          "catch": [
            {
              "name": "audit_confirmation_email_failed",
              "module": "dbupdater",
              "action": "insert",
              "options": {
                "connection": "db",
                "sql": {
                  "table": "audit_logs",
                  "values": [
                    {
                      "column": "actor_user_id",
                      "value": "{{user.id}}"
                    },
                    {
                      "column": "action",
                      "value": "PASSWORD_RESET_CONFIRMATION_EMAIL_FAILED"
                    },
                    {
                      "column": "module",
                      "value": "security"
                    },
                    {
                      "column": "entity_type",
                      "value": "user"
                    },
                    {
                      "column": "entity_id",
                      "value": "{{user.id}}"
                    },
                    {
                      "column": "description",
                      "value": "Password reset succeeded but the confirmation email could not be delivered."
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      {
        "module": "core",
        "action": "response",
        "options": {
          "status": 200,
          "data": {
            "success": true,
            "redirect": "/login?password_reset=success"
          }
        }
      }
    ],
    "catch": [
      {
        "module": "core",
        "action": "response",
        "options": {
          "status": 400,
          "data": {
            "success": false,
            "error": "This password reset link is invalid or has expired, or the password could not be accepted."
          }
        }
      }
    ]
  }
}
