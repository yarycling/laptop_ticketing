{
  "settings": {
    "options": {
      "method": "post",
      "nocsrf": true
    }
  },
  "exec": {
    "steps": [
      {
        "name": "restrict",
        "module": "auth",
        "action": "restrict",
        "options": {
          "provider": "portalSecurity"
        }
      },
      {
        "name": "identity",
        "module": "auth",
        "action": "identify",
        "options": {
          "provider": "portalSecurity"
        }
      },
      {
        "name": "user",
        "module": "dbconnector",
        "action": "single",
        "options": {
          "connection": "db",
          "sql": {
            "table": "users",
            "columns": [
              {
                "column": "id"
              },
              {
                "column": "password_hash"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "data": {
                    "column": "id"
                  },
                  "operation": "=",
                  "value": "{{identity}}"
                },
                {
                  "data": {
                    "column": "status"
                  },
                  "operation": "=",
                  "value": "active"
                }
              ]
            }
          }
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{!user.id}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 401,
                  "data": {
                    "success": false,
                    "error": "Authentication required."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{!$_POST.new_password || $_POST.new_password.length() < 10}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 400,
                  "data": {
                    "success": false,
                    "error": "New password must be at least 10 characters."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{$_POST.new_password != $_POST.confirm_password}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 400,
                  "data": {
                    "success": false,
                    "error": "New password confirmation must match."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "name": "valid_current_password",
        "module": "crypto",
        "action": "passwordVerify",
        "options": {
          "password": "{{$_POST.current_password}}",
          "hash": "{{user.password_hash}}"
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{!valid_current_password}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 400,
                  "data": {
                    "success": false,
                    "error": "Current password is incorrect."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "name": "new_password_hash",
        "module": "crypto",
        "action": "passwordHash",
        "options": {
          "password": "{{$_POST.new_password}}",
          "algo": "argon2id"
        }
      },
      {
        "name": "change_password_transaction",
        "module": "dbupdater",
        "action": "transaction",
        "options": {
          "connection": "db",
          "exec": {
            "steps": [
              {
                "name": "update_password",
                "module": "dbupdater",
                "action": "update",
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "users",
                    "values": [
                      {
                        "column": "password_hash",
                        "value": "{{new_password_hash}}"
                      },
                      {
                        "column": "password_changed_at",
                        "value": "{{NOW}}"
                      },
                      {
                        "column": "updated_at",
                        "value": "{{NOW}}"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "id"
                          },
                          "operation": "=",
                          "value": "{{identity}}"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "name": "invalidate_password_reset_requests",
                "module": "dbupdater",
                "action": "update",
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "password_reset_requests",
                    "values": [ { "column": "invalidated_at", "value": "{{NOW}}" } ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        { "data": { "column": "user_id" }, "operation": "=", "value": "{{identity}}" },
                        { "data": { "column": "used_at" }, "operator": "is_null" },
                        { "data": { "column": "invalidated_at" }, "operator": "is_null" }
                      ]
                    }
                  }
                }
              },
              {
                "name": "audit_password_changed",
                "module": "dbupdater",
                "action": "insert",
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "audit_logs",
                    "values": [
                      {
                        "column": "actor_user_id",
                        "value": "{{identity}}"
                      },
                      {
                        "column": "action",
                        "value": "password_changed"
                      },
                      {
                        "column": "module",
                        "value": "security"
                      },
                      {
                        "column": "entity_type",
                        "value": "user"
                      },
                      {
                        "column": "entity_id",
                        "value": "{{identity}}"
                      },
                      {
                        "column": "description",
                        "value": "User changed password."
                      },
                      {
                        "column": "created_at",
                        "value": "{{NOW}}"
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      {
        "module": "core",
        "action": "response",
        "options": {
          "status": 200,
          "data": {
            "success": true
          }
        }
      }
    ],
    "catch": {
      "steps": [
        {
          "module": "core",
          "action": "response",
          "options": {
            "status": 500,
            "data": {
              "success": false,
              "error": "Password change could not be completed."
            }
          }
        }
      ]
    }
  }
}
