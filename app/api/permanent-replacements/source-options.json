{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "meta": { "$_GET": [{ "name": "replacement_case_id", "type": "number" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "replacements.view" } }, "output": true },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "name": "scope_context", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_get_scope_context", "params": {} } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_GET.replacement_case_id || $_GET.replacement_case_id < 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "A valid replacement case ID is required." } } }] } } },
    { "name": "replacement_case", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_permanent_replacement_queue", "columns": [{ "column": "replacement_case_id" }, { "column": "exception_case_id" }, { "column": "repair_service_location_id" }, { "column": "origin_district_id" }, { "column": "replacement_status_code" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "replacement_case_id" }, "operation": "=", "value": "{{$_GET.replacement_case_id}}" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!replacement_case.replacement_case_id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Permanent replacement case was not found." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && !scope_context.districts.flatten('id').contains(replacement_case.origin_district_id) && !scope_context.service_locations.flatten('id').contains(replacement_case.repair_service_location_id)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "name": "manufacturer_candidates", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": {
      "table": { "name": "manufacturer_supplied_units", "alias": "su" },
      "columns": [{ "table": "su", "column": "id", "alias": "staged_unit_id" }, { "table": "su", "column": "manufacturer_return_case_id" }, { "table": "mrc", "column": "manufacturer_return_number" }, { "table": "su", "column": "serial_number" }, { "table": "mf", "column": "name", "alias": "manufacturer_name" }, { "table": "dm", "column": "model_name" }, { "table": "su", "column": "manufacturer_model_reference" }, { "table": "su", "column": "model_description" }, { "table": "su", "column": "received_at" }],
      "joins": [
        { "table": "manufacturer_return_cases", "alias": "mrc", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "mrc", "column": "id", "operation": "=", "value": { "table": "su", "column": "manufacturer_return_case_id" } }] } },
        { "table": "manufacturer_return_outcomes", "alias": "mro", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "mro", "column": "id", "operation": "=", "value": { "table": "su", "column": "manufacturer_return_outcome_id" } }] } },
        { "table": "manufacturers", "alias": "mf", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "mf", "column": "id", "operation": "=", "value": { "table": "su", "column": "manufacturer_id" } }] } },
        { "table": "device_models", "alias": "dm", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "dm", "column": "id", "operation": "=", "value": { "table": "su", "column": "resolved_model_id" } }] } },
        { "table": "permanent_replacement_cases", "alias": "selected", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "selected", "column": "staged_manufacturer_unit_id", "operation": "=", "value": { "table": "su", "column": "id" } }] } },
        { "table": "devices", "alias": "existing_device", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "existing_device", "column": "serial_number", "operation": "=", "value": { "table": "su", "column": "serial_number" } }] } }
      ],
      "wheres": { "condition": "AND", "rules": [
        { "data": { "table": "mrc", "column": "exception_case_id" }, "operation": "=", "value": "{{replacement_case.exception_case_id}}" },
        { "data": { "table": "mrc", "column": "repair_centre_location_id" }, "operation": "=", "value": "{{replacement_case.repair_service_location_id}}" },
        { "data": { "table": "mrc", "column": "current_status_code" }, "operation": "=", "value": "COMPLETED" },
        { "data": { "table": "mro", "column": "outcome_code" }, "operation": "=", "value": "REPLACEMENT_SUPPLIED" },
        { "data": { "table": "su", "column": "received_at" }, "operator": "is_not_null" },
        { "data": { "table": "selected", "column": "id" }, "operator": "is_null" },
        { "data": { "table": "existing_device", "column": "id" }, "operator": "is_null" }
      ] },
      "orders": [{ "table": "su", "column": "received_at", "direction": "desc" }, { "table": "su", "column": "id", "direction": "desc" }]
    } } },
    { "name": "display_manufacturer_candidates", "module": "core", "action": "repeat", "options": { "repeat": "{{manufacturer_candidates}}", "outputFilter": "exclude", "outputFields": [], "exec": { "steps": [{ "name": "received_at_display", "module": "core", "action": "setvalue", "output": true, "options": { "key": "received_at_display", "value": "{{received_at ? received_at.formatDate('MMM d, yyyy, h:mm A') : 'Not recorded'}}" } }] } } },
    { "name": "stock_read_permission", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "user_effective_permissions", "columns": [{ "column": "permission_name" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "column": "permission_name" }, "operation": "=", "value": "device_stock.view" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!stock_read_permission.permission_name}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "manufacturer_candidates": "{{display_manufacturer_candidates}}", "inventory_candidates": [], "existing_inventory_blocked": true, "existing_inventory_blocker": "STOCK_READ_PERMISSION_REQUIRED" } } }] } } },
    { "name": "inventory_candidates", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": "v_permanent_replacement_inventory_candidates", "columns": [{ "column": "device_id" }, { "column": "serial_number" }, { "column": "asset_tag" }, { "column": "manufacturer_name" }, { "column": "model_name" }, { "column": "lifecycle_code" }, { "column": "allocation_level" }, { "column": "district_name" }, { "column": "school_name" }, { "column": "service_location_id" }, { "column": "service_location_name" }, { "column": "stock_location_id" }, { "column": "stock_status" }, { "column": "is_reserved_for_replacement" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "replacement_case_id" }, "operation": "=", "value": "{{replacement_case.replacement_case_id}}" }] }, "orders": [{ "column": "device_id", "direction": "asc" }], "limit": 100 } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "manufacturer_candidates": "{{display_manufacturer_candidates}}", "inventory_candidates": "{{inventory_candidates}}", "existing_inventory_blocked": false, "existing_inventory_blocker": null } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Replacement source options could not be loaded." } } }] }
}
