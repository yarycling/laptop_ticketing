                                        "table": "d",
                                        "column": "lifecycle_status_id"
                                      }
                                    }
                                  ]
                                }
                              },
                              {
                                "table": "device_models",
                                "alias": "m",
                                "type": "inner",
                                "clauses": {
                                  "condition": "AND",
                                  "rules": [
                                    {
                                      "table": "m",
                                      "column": "id",
                                      "operation": "=",
                                      "value": {
                                        "table": "d",
                                        "column": "device_model_id"
                                      }
                                    }
                                  ]
                                }
                              }
                            ],
                            "wheres": {
