                      },
                      {
                        "name": "stock_read_permission",
                        "module": "dbconnector",
                        "action": "single",
                        "output": true,
                        "options": {
                          "connection": "db",
                          "sql": {
                            "table": "user_effective_permissions",
                            "columns": [
                              {
                                "column": "permission_name"
                              }
                            ],
                            "wheres": {
                              "condition": "AND",
                              "rules": [
                                {
                                  "data": {
                                    "column": "user_id"
                                  },
                                  "operation": "=",
                                  "value": "{{identity}}"
                                },
                                {
                                  "data": {
                                    "column": "permission_name"
                                  },
                                  "operation": "=",
                                  "value": "device_stock.view"
                                }
                              ]
                            }
                          }
                        }
                      },
                      {
                        "name": "selected_stock",
                        "module": "core",
                        "action": "setvalue",
                        "output": true,
                        "options": {
                          "key": "selected_stock",
                          "value": null
                        }
                      },
                      {
                        "module": "core",
                        "action": "condition",
                        "options": {
                          "if": "{{case.replacement_source_type == 'EXISTING_INVENTORY' && stock_read_permission.permission_name}}",
                          "then": {
                            "steps": [
                              {
                                "name": "selected_stock",
                                "module": "dbconnector",
                                "action": "single",
                                "output": true,
                                "options": {
                                  "connection": "db",
                                  "sql": {
                                    "table": "v_device_stock_queue",
                                    "columns": [
                                      {
                                        "column": "device_id"
                                      },
                                      {
                                        "column": "serial_number"
                                      },
                                      {
                                        "column": "asset_tag"
                                      },
                                      {
                                        "column": "manufacturer_name"
                                      },
                                      {
                                        "column": "model_name"
                                      },
                                      {
                                        "column": "lifecycle_code"
                                      },
                                      {
                                        "column": "allocation_level"
                                      },
                                      {
                                        "column": "district_name"
                                      },
                                      {
                                        "column": "school_name"
                                      },
                                      {
                                        "column": "service_location_id"
                                      },
                                      {
                                        "column": "service_location_name"
                                      },
                                      {
                                        "column": "stock_status"
                                      },
                                      {
                                        "column": "is_reserved_for_replacement"
                                      },
                                      {
                                        "column": "replacement_case_id"
                                      }
                                    ],
                                    "wheres": {
                                      "condition": "AND",
                                      "rules": [
                                        {
                                          "data": {
                                            "column": "device_id"
                                          },
                                          "operation": "=",
                                          "value": "{{case.replacement_device_id}}"
                                        },
                                        {
                                          "data": {
                                            "column": "replacement_case_id"
                                          },
                                          "operation": "=",
                                          "value": "{{case.replacement_case_id}}"
                                        },
                                        {
                                          "data": {
                                            "column": "service_location_id"
                                          },
                                          "operation": "=",
                                          "value": "{{case.repair_service_location_id}}"
                                        }
                                      ]
                                    }
                                  }
                                }
                              }
                            ]
                          }
                        }
                      },
                      {
                        "name": "selected_at_display",
                        "module": "core",
                        "action": "setvalue",
                        "output": true,
                        "options": {
                          "key": "selected_at_display",
                          "value": "{{selection.selected_at ? selection.selected_at.formatDate('MMM d, yyyy, h:mm A') : 'Not selected'}}"
                        }
                      },
                      {
                        "name": "display_history",
                        "module": "core",
                        "action": "repeat",
                        "options": {
                          "repeat": "{{history}}",
                          "outputFilter": "exclude",
                          "outputFields": [],
                          "exec": {
                            "steps": [
                              {
                                "name": "recorded_at_display",
                                "module": "core",
                                "action": "setvalue",
                                "output": true,
                                "options": {
                                  "key": "recorded_at_display",
                                  "value": "{{created_at ? created_at.formatDate('MMM d, yyyy, h:mm A') : 'Not recorded'}}"
                                }
                              }
                            ]
                          }
                        }
                      },
                      {
                        "module": "core",
                        "action": "response",
                        "options": {
                          "status": 200,
                          "data": {
                            "success": true,
                            "case": "{{case}}",
                            "selection": "{{selection}}",
                            "staged_unit": "{{staged_unit}}",
                            "staged_model_options": "{{staged_model_options}}",
                            "allocation_transfer": "{{allocation_transfer}}",
                            "return_identity": "{{case.replacement_source_type == 'TEMPORARY_LOAN_CONVERSION' ? null : return_identity}}",
                            "return_logistics": "{{return_logistics}}",
                            "return_custody": "{{case.replacement_source_type == 'TEMPORARY_LOAN_CONVERSION' ? null : return_custody}}",
                            "conversion_loan": "{{case.replacement_source_type == 'TEMPORARY_LOAN_CONVERSION' ? conversion_loan : null}}",
                            "replacement_device": "{{replacement_device}}",
                            "selected_stock": "{{selected_stock}}",
                            "selected_at_display": "{{selected_at_display}}",
                            "history": "{{display_history}}",
                            "active_temporary_loan": "{{active_temporary_loan}}"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    ],
    "catch": [
      {
        "module": "core",
        "action": "response",
        "options": {
          "status": 500,
          "data": {
            "success": false,
            "error": "Permanent replacement detail could not be loaded."
          }
        }
      }
    ]
  }
}
