{
  "settings": { "options": { "method": "post" } },
  "meta": { "$_POST": [{ "name": "replacement_case_id", "type": "number" }, { "name": "source_type", "type": "text" }, { "name": "staged_manufacturer_unit_id", "type": "number" }, { "name": "replacement_device_id", "type": "number" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "replacements.select" } }, "output": true },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "name": "scope_context", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_get_scope_context", "params": {} } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.replacement_case_id || $_POST.replacement_case_id < 1 || !['MANUFACTURER_SUPPLIED','EXISTING_INVENTORY'].contains($_POST.source_type)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Choose a valid replacement case and source type." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_POST.source_type == 'MANUFACTURER_SUPPLIED' && (!$_POST.staged_manufacturer_unit_id || $_POST.staged_manufacturer_unit_id < 1)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Select a valid staged manufacturer-supplied unit." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_POST.source_type == 'EXISTING_INVENTORY' && (!$_POST.replacement_device_id || $_POST.replacement_device_id < 1)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Select a valid existing-inventory device." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_POST.source_type == 'EXISTING_INVENTORY' && permission.bypass != 'SUPER_ADMIN'}}", "then": { "steps": [{ "name": "stock_view_permission", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_require_permission", "params": { "permission": "device_stock.view" } } }] } } },
    { "name": "available_lifecycle", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "device_lifecycle_statuses", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "AVAILABLE" }] } } } },
    { "name": "select_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "case_lock", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "permanent_replacement_cases", "values": [{ "column": "current_status_code", "value": "SELECTION_REQUIRED" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{$_POST.replacement_case_id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "current_status_code" }, "operation": "=", "value": "SELECTION_REQUIRED" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{case_lock.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P8CB_SELECT_STATE" } }] } } },
      { "name": "current", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": {
        "table": { "name": "permanent_replacement_cases", "alias": "prc" },
        "columns": [{ "table": "prc", "column": "id" }, { "table": "prc", "column": "exception_case_id" }, { "table": "prc", "column": "ticket_id" }, { "table": "prc", "column": "logistics_case_id" }, { "table": "prc", "column": "repair_job_id" }, { "table": "prc", "column": "original_device_id" }, { "table": "prc", "column": "repair_service_location_id" }, { "table": "prc", "column": "current_status_code" }, { "table": "prc", "column": "replacement_source_type" }, { "table": "prc", "column": "active_selection_key" }, { "table": "ec", "column": "current_status_code", "alias": "exception_status_code" }, { "table": "ctx", "column": "ticket_status_code" }, { "table": "ctx", "column": "logistics_status_code" }, { "table": "ctx", "column": "physical_state_code" }, { "table": "ctx", "column": "device_lifecycle_code" }, { "table": "ctx", "column": "repair_job_id", "alias": "context_repair_job_id" }],
        "joins": [
          { "table": "repair_exception_cases", "alias": "ec", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ec", "column": "id", "operation": "=", "value": { "table": "prc", "column": "exception_case_id" } }] } },
          { "table": "v_repair_current_context", "alias": "ctx", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ctx", "column": "logistics_case_id", "operation": "=", "value": { "table": "prc", "column": "logistics_case_id" } }] } }
        ],
        "wheres": { "condition": "AND", "rules": [{ "data": { "table": "prc", "column": "id" }, "operation": "=", "value": "{{$_POST.replacement_case_id}}" }, { "data": { "table": "prc", "column": "active_record_key" }, "operation": "=", "value": 1 }] }
      } } },
      { "name": "location_scope", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "user_service_location_scopes", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "column": "service_location_id" }, "operation": "=", "value": "{{current.repair_service_location_id}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!current.id || (permission.bypass != 'SUPER_ADMIN' && !location_scope.id)}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P8CB_SELECT_SCOPE" } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{current.current_status_code != 'SELECTION_REQUIRED' || current.replacement_source_type || current.active_selection_key || current.exception_status_code != 'REPLACEMENT_APPROVED' || current.repair_job_id != current.context_repair_job_id || current.ticket_status_code != 'UNDER_REPAIR' || current.logistics_status_code != 'AT_REPAIR_CENTRE'}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P8CB_SELECT_STATE" } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{$_POST.source_type == 'MANUFACTURER_SUPPLIED'}}", "then": { "steps": [
      { "name": "candidate", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": {
        "table": { "name": "manufacturer_supplied_units", "alias": "su" },
        "columns": [{ "table": "su", "column": "id" }, { "table": "su", "column": "manufacturer_return_case_id" }, { "table": "su", "column": "received_at" }, { "table": "mrc", "column": "exception_case_id" }, { "table": "mrc", "column": "repair_centre_location_id" }, { "table": "mrc", "column": "current_status_code", "alias": "manufacturer_return_status_code" }, { "table": "mro", "column": "outcome_code" }, { "table": "selected", "column": "id", "alias": "selected_case_id" }, { "table": "existing_device", "column": "id", "alias": "existing_device_id" }],
        "joins": [
          { "table": "manufacturer_return_cases", "alias": "mrc", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "mrc", "column": "id", "operation": "=", "value": { "table": "su", "column": "manufacturer_return_case_id" } }] } },
          { "table": "manufacturer_return_outcomes", "alias": "mro", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "mro", "column": "id", "operation": "=", "value": { "table": "su", "column": "manufacturer_return_outcome_id" } }] } },
          { "table": "permanent_replacement_cases", "alias": "selected", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "selected", "column": "staged_manufacturer_unit_id", "operation": "=", "value": { "table": "su", "column": "id" } }] } },
          { "table": "devices", "alias": "existing_device", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "existing_device", "column": "serial_number", "operation": "=", "value": { "table": "su", "column": "serial_number" } }] } }
        ],
        "wheres": { "condition": "AND", "rules": [{ "data": { "table": "su", "column": "id" }, "operation": "=", "value": "{{$_POST.staged_manufacturer_unit_id}}" }] }
      } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!candidate.id || candidate.exception_case_id != current.exception_case_id || candidate.repair_centre_location_id != current.repair_service_location_id || candidate.manufacturer_return_status_code != 'COMPLETED' || candidate.outcome_code != 'REPLACEMENT_SUPPLIED' || !candidate.received_at || candidate.selected_case_id || candidate.existing_device_id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P8CB_SELECT_STATE" } }] } } },
      { "name": "case_update", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "permanent_replacement_cases", "values": [{ "column": "replacement_source_type", "value": "MANUFACTURER_SUPPLIED" }, { "column": "staged_manufacturer_unit_id", "value": "{{candidate.id}}" }, { "column": "replacement_device_id", "value": null }, { "column": "selected_by", "value": "{{identity}}" }, { "column": "selected_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss')}}" }, { "column": "active_selection_key", "value": "{{'STAGED:' + candidate.id}}" }, { "column": "current_status_code", "value": "REPLACEMENT_SELECTED" }, { "column": "updated_by", "value": "{{identity}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{current.id}}" }, { "data": { "column": "current_status_code" }, "operation": "=", "value": "SELECTION_REQUIRED" }, { "data": { "column": "active_selection_key" }, "operator": "is_null" }, { "data": { "column": "replacement_source_type" }, "operator": "is_null" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{case_update.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P8CB_SELECT_STATE" } }] } } }
      ] }, "else": { "steps": [
        { "name": "inventory_candidate", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_permanent_replacement_inventory_candidates", "columns": [{ "column": "device_id" }, { "column": "stock_location_id" }, { "column": "service_location_id" }, { "column": "lifecycle_status_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "replacement_case_id" }, "operation": "=", "value": "{{current.id}}" }, { "data": { "column": "device_id" }, "operation": "=", "value": "{{$_POST.replacement_device_id}}" }] } } } },
        { "module": "core", "action": "condition", "options": { "if": "{{!inventory_candidate.device_id || inventory_candidate.service_location_id != current.repair_service_location_id || inventory_candidate.lifecycle_status_id != available_lifecycle.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P8CB_SELECT_STATE" } }] } } },
        { "name": "device_lock", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "devices", "values": [{ "column": "id", "value": "{{inventory_candidate.device_id}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{inventory_candidate.device_id}}" }, { "data": { "column": "lifecycle_status_id" }, "operation": "=", "value": "{{available_lifecycle.id}}" }] } } } },
        { "module": "core", "action": "condition", "options": { "if": "{{device_lock.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P8CB_SELECT_STATE" } }] } } },
        { "name": "stock_lock", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "device_stock_locations", "values": [{ "column": "stock_status", "value": "IN_STOCK" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{inventory_candidate.stock_location_id}}" }, { "data": { "column": "device_id" }, "operation": "=", "value": "{{inventory_candidate.device_id}}" }, { "data": { "column": "service_location_id" }, "operation": "=", "value": "{{current.repair_service_location_id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "stock_status" }, "operation": "=", "value": "IN_STOCK" }] } } } },
        { "module": "core", "action": "condition", "options": { "if": "{{stock_lock.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P8CB_SELECT_STATE" } }] } } },
        { "name": "inventory_case_update", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "permanent_replacement_cases", "values": [{ "column": "replacement_source_type", "value": "EXISTING_INVENTORY" }, { "column": "replacement_device_id", "value": "{{inventory_candidate.device_id}}" }, { "column": "staged_manufacturer_unit_id", "value": null }, { "column": "selected_by", "value": "{{identity}}" }, { "column": "selected_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss')}}" }, { "column": "active_selection_key", "value": "{{'DEVICE:' + inventory_candidate.device_id}}" }, { "column": "current_status_code", "value": "REPLACEMENT_SELECTED" }, { "column": "updated_by", "value": "{{identity}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{current.id}}" }, { "data": { "column": "current_status_code" }, "operation": "=", "value": "SELECTION_REQUIRED" }, { "data": { "column": "active_selection_key" }, "operator": "is_null" }, { "data": { "column": "replacement_source_type" }, "operator": "is_null" }] } } } },
        { "module": "core", "action": "condition", "options": { "if": "{{inventory_case_update.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P8CB_SELECT_STATE" } }] } } }
      ] } } },
      { "name": "history", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "permanent_replacement_status_history", "values": [{ "column": "replacement_case_id", "value": "{{current.id}}" }, { "column": "from_status_code", "value": "SELECTION_REQUIRED" }, { "column": "to_status_code", "value": "REPLACEMENT_SELECTED" }, { "column": "actor_user_id", "value": "{{identity}}" }, { "column": "reason", "value": "Permanent replacement source selected." }] } } },
      { "name": "audit", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "permanent_replacement_selected" }, { "column": "module", "value": "replacements" }, { "column": "entity_type", "value": "permanent_replacement_case" }, { "column": "entity_id", "value": "{{current.id}}" }, { "column": "description", "value": "Permanent replacement source selected." }] } } }
    ] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "replacement_case_id": "{{$_POST.replacement_case_id}}", "status": "REPLACEMENT_SELECTED", "source": "{{$_POST.source_type}}", "staged_manufacturer_unit_id": "{{$_POST.source_type == 'MANUFACTURER_SUPPLIED' ? $_POST.staged_manufacturer_unit_id : null}}", "replacement_device_id": "{{$_POST.source_type == 'EXISTING_INVENTORY' ? $_POST.replacement_device_id : null}}" } } }
  ], "catch": [
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P8CB_SELECT_SCOPE'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P8CB_SELECT_STATE' || $_EXCEPTION.code == 'ER_DUP_ENTRY'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The replacement source is no longer eligible or has already been selected." } } }] } } },
    { "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Replacement source could not be selected. No partial changes were committed." } } }
  ] }
}
