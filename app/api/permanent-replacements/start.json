{
  "settings": { "options": { "method": "post" } },
  "meta": { "$_POST": [{ "name": "exception_case_id", "type": "number" }] },
  "exec": {
    "steps": [
      { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "replacements.start" } } },
      { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
      { "name": "scope_context", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_get_scope_context", "params": {} } },
      { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.exception_case_id || $_POST.exception_case_id < 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "A valid exception case is required." } } }] } } },
      { "name": "start_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
        { "name": "current", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "repair_exception_cases", "alias": "ec" }, "columns": [{ "table": "ec", "column": "id" }, { "table": "ec", "column": "ticket_id" }, { "table": "ec", "column": "logistics_case_id" }, { "table": "ec", "column": "repair_job_id" }, { "table": "ec", "column": "device_id" }, { "table": "ec", "column": "current_status_code" }, { "table": "ec", "column": "recommended_disposition_code" }, { "table": "ctx", "column": "ticket_status_code" }, { "table": "ctx", "column": "logistics_status_code" }, { "table": "ctx", "column": "physical_state_code" }, { "table": "ctx", "column": "device_lifecycle_code" }, { "table": "ctx", "column": "repair_centre_location_id" }, { "table": "ctx", "column": "repair_job_id", "alias": "context_repair_job_id" }], "joins": [{ "table": "v_repair_current_context", "alias": "ctx", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ctx", "column": "logistics_case_id", "operation": "=", "value": { "table": "ec", "column": "logistics_case_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "ec", "column": "id" }, "operation": "=", "value": "{{$_POST.exception_case_id}}" }] } } } },
        { "name": "location_scope", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "user_service_location_scopes", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "column": "service_location_id" }, "operation": "=", "value": "{{current.repair_centre_location_id}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
        { "module": "core", "action": "condition", "options": { "if": "{{!current.id || (permission.bypass != 'SUPER_ADMIN' && !location_scope.id)}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P8C_START_SCOPE" } }] } } },
        { "name": "active_case", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "permanent_replacement_cases", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "exception_case_id" }, "operation": "=", "value": "{{current.id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }] } } } },
        { "module": "core", "action": "condition", "options": { "if": "{{current.current_status_code != 'REPLACEMENT_APPROVED' || current.repair_job_id != current.context_repair_job_id || active_case.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P8C_START_STATE" } }] } } },
        { "name": "new_case", "module": "dbupdater", "action": "insert", "output": true, "options": { "connection": "db", "sql": { "table": "permanent_replacement_cases", "values": [{ "column": "exception_case_id", "value": "{{current.id}}" }, { "column": "ticket_id", "value": "{{current.ticket_id}}" }, { "column": "logistics_case_id", "value": "{{current.logistics_case_id}}" }, { "column": "repair_job_id", "value": "{{current.repair_job_id}}" }, { "column": "original_device_id", "value": "{{current.device_id}}" }, { "column": "repair_service_location_id", "value": "{{current.repair_centre_location_id}}" }, { "column": "current_status_code", "value": "SELECTION_REQUIRED" }, { "column": "active_record_key", "value": 1 }, { "column": "created_by", "value": "{{identity}}" }] } } },
        { "name": "number", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "permanent_replacement_cases", "values": [{ "column": "replacement_number", "value": "{{'PR' + new_case.identity}}" }, { "column": "updated_by", "value": "{{identity}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{new_case.identity}}" }, { "data": { "column": "replacement_number" }, "operator": "is_null" }] } } } },
        { "module": "core", "action": "condition", "options": { "if": "{{number.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P8C_START_STATE" } }] } } },
        { "name": "replacement_history", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "permanent_replacement_status_history", "values": [{ "column": "replacement_case_id", "value": "{{new_case.identity}}" }, { "column": "from_status_code", "value": null }, { "column": "to_status_code", "value": "SELECTION_REQUIRED" }, { "column": "actor_user_id", "value": "{{identity}}" }, { "column": "reason", "value": "Permanent replacement case started after Head Office approval." }] } } },
        { "name": "audit", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "permanent_replacement_started" }, { "column": "module", "value": "replacements" }, { "column": "entity_type", "value": "permanent_replacement_case" }, { "column": "entity_id", "value": "{{new_case.identity}}" }, { "column": "description", "value": "Permanent replacement processing started." }] } } }
      ] } } },
      { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "replacement_case_id": "{{new_case.identity}}", "replacement_number": "{{'PR' + new_case.identity}}", "status": "SELECTION_REQUIRED" } } }
    ],
    "catch": [
      { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P8C_START_SCOPE'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P8C_START_STATE' || $_EXCEPTION.code == 'ER_DUP_ENTRY'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "This exception is no longer eligible or a permanent replacement case already exists." } } }] } } },
      { "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Permanent replacement could not be started. No partial changes were committed." } } }
    ]
  }
}
