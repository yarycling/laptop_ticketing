{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "replacements.view" } }, "output": true },
    { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
    { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length == 0 && scope_context.service_locations.length == 0}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "name": "districts", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": {
      "table": { "name": "v_permanent_replacement_queue", "alias": "q" }, "distinct": true,
      "columns": [{ "table": "q", "column": "origin_district_id", "alias": "id" }, { "table": "q", "column": "origin_district_name", "alias": "name" }],
      "wheres": { "condition": "AND", "rules": [
        { "data": { "table": "q", "column": "origin_district_id" }, "operation": ">", "value": 0 },
        { "condition": "OR", "rules": [
          { "condition": "AND", "conditional": "{{permission.bypass == 'SUPER_ADMIN' || scope_context.has_national_scope}}", "rules": [{ "data": { "table": "q", "column": "replacement_case_id" }, "operation": ">", "value": 0 }] },
          { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length > 0}}", "rules": [{ "data": { "table": "q", "column": "origin_district_id" }, "operation": "in", "value": "{{scope_context.districts.flatten('id')}}" }] },
          { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && scope_context.service_locations.length > 0}}", "rules": [{ "data": { "table": "q", "column": "repair_service_location_id" }, "operation": "in", "value": "{{scope_context.service_locations.flatten('id')}}" }] }
        ] }
      ] }, "orders": [{ "table": "q", "column": "origin_district_name", "direction": "asc" }]
    } } },
    { "name": "repair_centres", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": {
      "table": { "name": "v_permanent_replacement_queue", "alias": "q" }, "distinct": true,
      "columns": [{ "table": "q", "column": "repair_service_location_id", "alias": "id" }, { "table": "q", "column": "repair_centre_name", "alias": "name" }],
      "wheres": { "condition": "AND", "rules": [
        { "data": { "table": "q", "column": "repair_service_location_id" }, "operation": ">", "value": 0 },
        { "condition": "OR", "rules": [
          { "condition": "AND", "conditional": "{{permission.bypass == 'SUPER_ADMIN' || scope_context.has_national_scope}}", "rules": [{ "data": { "table": "q", "column": "replacement_case_id" }, "operation": ">", "value": 0 }] },
          { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length > 0}}", "rules": [{ "data": { "table": "q", "column": "origin_district_id" }, "operation": "in", "value": "{{scope_context.districts.flatten('id')}}" }] },
          { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && scope_context.service_locations.length > 0}}", "rules": [{ "data": { "table": "q", "column": "repair_service_location_id" }, "operation": "in", "value": "{{scope_context.service_locations.flatten('id')}}" }] }
        ] }
      ] }, "orders": [{ "table": "q", "column": "repair_centre_name", "direction": "asc" }]
    } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "districts": "{{districts}}", "repair_centres": "{{repair_centres}}" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Permanent replacement filter options could not be loaded." } } }] }
}
