{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "meta": { "$_GET": [{ "name": "ticket_id", "type": "number" }, { "name": "exception_case_id", "type": "number" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "replacements.view" } } },
    { "name": "scope_context", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_get_scope_context", "params": {} } },
    { "name": "summary", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_permanent_replacement_queue", "columns": [{ "column": "replacement_case_id" }, { "column": "replacement_number" }, { "column": "exception_case_id" }, { "column": "ticket_id" }, { "column": "ticket_number" }, { "column": "replacement_status_code" }, { "column": "replacement_status_name" }, { "column": "replacement_source_type" }, { "column": "original_serial_number" }, { "column": "replacement_serial_number" }, { "column": "staged_serial_number" }, { "column": "repair_service_location_id" }, { "column": "origin_district_id" }], "wheres": { "condition": "AND", "rules": [{ "condition": "AND", "conditional": "{{$_GET.ticket_id}}", "rules": [{ "data": { "column": "ticket_id" }, "operation": "=", "value": "{{$_GET.ticket_id}}" }] }, { "condition": "AND", "conditional": "{{$_GET.exception_case_id}}", "rules": [{ "data": { "column": "exception_case_id" }, "operation": "=", "value": "{{$_GET.exception_case_id}}" }] }] }, "orders": [{ "column": "replacement_case_id", "direction": "desc" }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{summary.replacement_case_id && permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && !scope_context.districts.flatten('id').contains(summary.origin_district_id) && !scope_context.service_locations.flatten('id').contains(summary.repair_service_location_id)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "summary": "{{summary}}" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Permanent replacement summary could not be loaded." } } }] }
}
