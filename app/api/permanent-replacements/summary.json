{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "replacements.view" } } },
    { "name": "scope_context", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_get_scope_context", "params": {} } },
    { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length == 0 && scope_context.service_locations.length == 0}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "name": "counts", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "v_permanent_replacement_queue", "alias": "q" }, "columns": [{ "table": "q", "column": "replacement_status_code" }, { "table": "q", "column": "replacement_status_name" }, { "table": "q", "column": "replacement_case_id", "aggregate": "count", "alias": "case_count" }], "groupBy": [{ "table": "q", "column": "replacement_status_code" }, { "table": "q", "column": "replacement_status_name" }], "wheres": { "condition": "AND", "rules": [{ "condition": "OR", "rules": [{ "condition": "AND", "conditional": "{{permission.bypass == 'SUPER_ADMIN' || scope_context.has_national_scope}}", "rules": [{ "data": { "table": "q", "column": "replacement_case_id" }, "operation": ">", "value": 0 }] }, { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length > 0}}", "rules": [{ "data": { "table": "q", "column": "origin_district_id" }, "operation": "in", "value": "{{scope_context.districts.flatten('id')}}" }] }, { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && scope_context.service_locations.length > 0}}", "rules": [{ "data": { "table": "q", "column": "repair_service_location_id" }, "operation": "in", "value": "{{scope_context.service_locations.flatten('id')}}" }] }] }] } } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "counts": "{{counts}}" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Permanent replacement summary could not be loaded." } } }] }
}
