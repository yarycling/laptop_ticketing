{
  "settings": {
    "options": {
      "method": "get",
      "nocsrf": true
    }
  },
  "meta": {
    "$_GET": [
      {
        "name": "search",
        "type": "text"
      },
      {
        "name": "manufacturer_id",
        "type": "number"
      },
      {
        "name": "device_model_id",
        "type": "number"
      },
      {
        "name": "lifecycle_status_id",
        "type": "number"
      },
      {
        "name": "condition_id",
        "type": "number"
      },
      {
        "name": "warranty_status",
        "type": "text"
      },
      {
        "name": "page",
        "type": "number"
      },
      {
        "name": "page_size",
        "type": "number"
      }
    ]
  },
  "exec": {
    "steps": [
      {
        "name": "require_permission",
        "module": "core",
        "action": "exec",
        "options": {
          "exec": "security_require_permission",
          "params": {
            "permission": "devices.view"
          }
        },
        "output": true
      },
      {
        "name": "scope_context",
        "module": "core",
        "action": "exec",
        "options": {
          "exec": "security_get_scope_context",
          "params": {}
        },
        "output": true
      },
      {
        "name": "page",
        "module": "core",
        "action": "setvalue",
        "options": {
          "key": "page",
          "value": "{{$_GET.page && $_GET.page > 0 ? floor($_GET.page) : 1}}"
        }
      },
      {
        "name": "page_size",
        "module": "core",
        "action": "setvalue",
        "options": {
          "key": "page_size",
          "value": "{{!$_GET.page_size || $_GET.page_size < 1 ? 25 : ($_GET.page_size > 100 ? 100 : floor($_GET.page_size))}}"
        }
      },
      {
        "name": "filtered_count",
        "module": "dbconnector",
        "action": "count",
        "output": true,
        "options": {
          "connection": "db",
          "sql": {
            "table": {
              "name": "devices",
              "alias": "dv"
            },
            "joins": [
              {
                "table": "device_models",
                "alias": "m",
                "type": "inner",
                "clauses": {
                  "condition": "AND",
                  "rules": [
                    {
                      "table": "m",
                      "column": "id",
                      "operation": "=",
                      "value": {
                        "table": "dv",
                        "column": "device_model_id"
                      }
                    }
                  ]
                }
              },
              {
                "table": "manufacturers",
                "alias": "mf",
                "type": "inner",
                "clauses": {
                  "condition": "AND",
                  "rules": [
                    {
                      "table": "mf",
                      "column": "id",
                      "operation": "=",
                      "value": {
                        "table": "m",
                        "column": "manufacturer_id"
                      }
                    }
                  ]
                }
              },
              {
                "table": "device_lifecycle_statuses",
                "alias": "ls",
                "type": "inner",
                "clauses": {
                  "condition": "AND",
                  "rules": [
                    {
                      "table": "ls",
                      "column": "id",
                      "operation": "=",
                      "value": {
                        "table": "dv",
                        "column": "lifecycle_status_id"
                      }
                    }
                  ]
                }
              },
              {
                "table": "device_conditions",
                "alias": "c",
                "type": "inner",
                "clauses": {
                  "condition": "AND",
                  "rules": [
                    {
                      "table": "c",
                      "column": "id",
                      "operation": "=",
                      "value": {
                        "table": "dv",
                        "column": "condition_id"
                      }
                    }
                  ]
                }
              },
              {
                "table": "v_device_current_custody",
                "alias": "cc",
                "type": "inner",
                "clauses": {
                  "condition": "AND",
                  "rules": [{ "table": "cc", "column": "device_id", "operation": "=", "value": { "table": "dv", "column": "id" } }]
                }
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "condition": "OR",
                  "conditional": "{{require_permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope}}",
                  "rules": [
                    { "condition": "AND", "conditional": "{{scope_context.districts.length > 0}}", "rules": [{ "data": { "table": "cc", "column": "district_id" }, "operation": "in", "value": "{{scope_context.districts.flatten('id')}}" }] },
                    { "condition": "AND", "conditional": "{{scope_context.schools.length > 0}}", "rules": [{ "data": { "table": "cc", "column": "school_id" }, "operation": "in", "value": "{{scope_context.schools.flatten('id')}}" }] },
                    { "condition": "AND", "conditional": "{{scope_context.districts.length == 0 && scope_context.schools.length == 0}}", "rules": [{ "data": { "table": "dv", "column": "id" }, "operation": "=", "value": -1 }] }
                  ]
                },
                {
                  "condition": "OR",
                  "conditional": "{{$_GET.search}}",
                  "rules": [
                    {
                      "data": {
                        "table": "dv",
                        "column": "serial_number"
                      },
                      "operator": "contains",
                      "value": "{{$_GET.search}}"
                    },
                    {
                      "data": {
                        "table": "dv",
                        "column": "asset_tag"
                      },
                      "operator": "contains",
                      "value": "{{$_GET.search}}"
                    },
                    {
                      "data": {
                        "table": "dv",
                        "column": "procurement_reference"
                      },
                      "operator": "contains",
                      "value": "{{$_GET.search}}"
                    },
                    {
                      "data": {
                        "table": "dv",
                        "column": "supplier_name"
                      },
                      "operator": "contains",
                      "value": "{{$_GET.search}}"
                    },
                    {
                      "data": {
                        "table": "dv",
                        "column": "warranty_reference"
                      },
                      "operator": "contains",
                      "value": "{{$_GET.search}}"
                    }
                  ]
                },
                {
                  "condition": "AND",
                  "conditional": "{{$_GET.manufacturer_id}}",
                  "rules": [
                    {
                      "data": {
                        "table": "mf",
                        "column": "id"
                      },
                      "operation": "=",
                      "value": "{{$_GET.manufacturer_id}}"
                    }
                  ]
                },
                {
                  "condition": "AND",
                  "conditional": "{{$_GET.device_model_id}}",
                  "rules": [
                    {
                      "data": {
                        "table": "m",
                        "column": "id"
                      },
                      "operation": "=",
                      "value": "{{$_GET.device_model_id}}"
                    }
                  ]
                },
                {
                  "condition": "AND",
                  "conditional": "{{$_GET.lifecycle_status_id}}",
                  "rules": [
                    {
                      "data": {
                        "table": "ls",
                        "column": "id"
                      },
                      "operation": "=",
                      "value": "{{$_GET.lifecycle_status_id}}"
                    }
                  ]
                },
                {
                  "condition": "AND",
                  "conditional": "{{$_GET.condition_id}}",
                  "rules": [
                    {
                      "data": {
                        "table": "c",
                        "column": "id"
                      },
                      "operation": "=",
                      "value": "{{$_GET.condition_id}}"
                    }
                  ]
                },
                {
                  "condition": "AND",
                  "conditional": "{{$_GET.warranty_status == 'not_recorded'}}",
                  "rules": [
                    {
                      "data": {
                        "table": "dv",
                        "column": "warranty_start_date"
                      },
                      "operator": "is_null"
                    },
                    {
                      "data": {
                        "table": "dv",
                        "column": "warranty_end_date"
                      },
                      "operator": "is_null"
                    }
                  ]
                },
                {
                  "condition": "AND",
                  "conditional": "{{$_GET.warranty_status == 'active'}}",
                  "rules": [
                    {
                      "data": {
                        "table": "dv",
                        "column": "warranty_end_date"
                      },
                      "operation": ">=",
                      "value": "{{'now'.formatDate('yyyy-MM-dd')}}"
                    }
                  ]
                },
                {
                  "condition": "AND",
                  "conditional": "{{$_GET.warranty_status == 'expired'}}",
                  "rules": [
                    {
                      "data": {
                        "table": "dv",
                        "column": "warranty_end_date"
                      },
                      "operation": "<",
                      "value": "{{'now'.formatDate('yyyy-MM-dd')}}"
                    }
                  ]
                }
              ]
            },
            "columns": [
              {
                "table": "dv",
                "column": "id"
              }
            ]
          }
        }
      },
      {
        "name": "devices",
        "module": "dbconnector",
        "action": "select",
        "output": true,
        "options": {
          "connection": "db",
          "sql": {
            "table": {
              "name": "devices",
              "alias": "dv"
            },
            "joins": [
              {
                "table": "device_models",
                "alias": "m",
                "type": "inner",
                "clauses": {
                  "condition": "AND",
                  "rules": [
                    {
                      "table": "m",
                      "column": "id",
                      "operation": "=",
                      "value": {
                        "table": "dv",
                        "column": "device_model_id"
                      }
                    }
                  ]
                }
              },
              {
                "table": "manufacturers",
                "alias": "mf",
                "type": "inner",
                "clauses": {
                  "condition": "AND",
                  "rules": [
                    {
                      "table": "mf",
                      "column": "id",
                      "operation": "=",
                      "value": {
                        "table": "m",
                        "column": "manufacturer_id"
                      }
                    }
                  ]
                }
              },
              {
                "table": "device_lifecycle_statuses",
                "alias": "ls",
                "type": "inner",
                "clauses": {
                  "condition": "AND",
                  "rules": [
                    {
                      "table": "ls",
                      "column": "id",
                      "operation": "=",
                      "value": {
                        "table": "dv",
                        "column": "lifecycle_status_id"
                      }
                    }
                  ]
                }
              },
              {
                "table": "device_conditions",
                "alias": "c",
                "type": "inner",
                "clauses": {
                  "condition": "AND",
                  "rules": [
                    {
                      "table": "c",
                      "column": "id",
                      "operation": "=",
                      "value": {
                        "table": "dv",
                        "column": "condition_id"
                      }
                    }
                  ]
                }
              },
              {
                "table": "v_device_current_custody",
                "alias": "cc",
                "type": "inner",
                "clauses": {
                  "condition": "AND",
                  "rules": [{ "table": "cc", "column": "device_id", "operation": "=", "value": { "table": "dv", "column": "id" } }]
                }
              }
            ],
            "columns": [
              {
                "table": "dv",
                "column": "id"
              },
              {
                "table": "dv",
                "column": "serial_number"
              },
              {
                "table": "dv",
                "column": "asset_tag"
              },
              {
                "table": "dv",
                "column": "device_model_id"
              },
              {
                "table": "m",
                "column": "model_code"
              },
              {
                "table": "m",
                "column": "model_name"
              },
              {
                "table": "mf",
                "column": "id",
                "alias": "manufacturer_id"
              },
              {
                "table": "mf",
                "column": "manufacturer_code"
              },
              {
                "table": "mf",
                "column": "name",
                "alias": "manufacturer_name"
              },
              {
                "table": "dv",
                "column": "lifecycle_status_id"
              },
              {
                "table": "ls",
                "column": "code",
                "alias": "lifecycle_code"
              },
              {
                "table": "ls",
                "column": "name",
                "alias": "lifecycle_name"
              },
              {
                "table": "dv",
                "column": "condition_id"
              },
              {
                "table": "c",
                "column": "code",
                "alias": "condition_code"
              },
              {
                "table": "c",
                "column": "name",
                "alias": "condition_name"
              },
              {
                "table": "dv",
                "column": "warranty_start_date"
              },
              {
                "table": "dv",
                "column": "warranty_end_date"
              },
              {
                "table": "dv",
                "column": "received_date"
              },
              {
                "table": "dv",
                "column": "procurement_reference"
              },
              {
                "table": "dv",
                "column": "supplier_name"
              },
              {
                "table": "dv",
                "column": "warranty_reference"
              },
              {
                "table": "dv",
                "column": "created_at"
              },
              {
                "table": "dv",
                "column": "updated_at"
              },
              {
                "table": "cc",
                "column": "current_custody_level"
              },
              {
                "table": "cc",
                "column": "district_id"
              },
              {
                "table": "cc",
                "column": "school_id"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "condition": "OR",
                  "conditional": "{{require_permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope}}",
                  "rules": [
                    { "condition": "AND", "conditional": "{{scope_context.districts.length > 0}}", "rules": [{ "data": { "table": "cc", "column": "district_id" }, "operation": "in", "value": "{{scope_context.districts.flatten('id')}}" }] },
                    { "condition": "AND", "conditional": "{{scope_context.schools.length > 0}}", "rules": [{ "data": { "table": "cc", "column": "school_id" }, "operation": "in", "value": "{{scope_context.schools.flatten('id')}}" }] },
                    { "condition": "AND", "conditional": "{{scope_context.districts.length == 0 && scope_context.schools.length == 0}}", "rules": [{ "data": { "table": "dv", "column": "id" }, "operation": "=", "value": -1 }] }
                  ]
                },
                {
                  "condition": "OR",
                  "conditional": "{{$_GET.search}}",
                  "rules": [
                    {
                      "data": {
                        "table": "dv",
                        "column": "serial_number"
                      },
                      "operator": "contains",
                      "value": "{{$_GET.search}}"
                    },
                    {
                      "data": {
                        "table": "dv",
                        "column": "asset_tag"
                      },
                      "operator": "contains",
                      "value": "{{$_GET.search}}"
                    },
                    {
                      "data": {
                        "table": "dv",
                        "column": "procurement_reference"
                      },
                      "operator": "contains",
                      "value": "{{$_GET.search}}"
                    },
                    {
                      "data": {
                        "table": "dv",
                        "column": "supplier_name"
                      },
                      "operator": "contains",
                      "value": "{{$_GET.search}}"
                    },
                    {
                      "data": {
                        "table": "dv",
                        "column": "warranty_reference"
                      },
                      "operator": "contains",
                      "value": "{{$_GET.search}}"
                    }
                  ]
                },
                {
                  "condition": "AND",
                  "conditional": "{{$_GET.manufacturer_id}}",
                  "rules": [
                    {
                      "data": {
                        "table": "mf",
                        "column": "id"
                      },
                      "operation": "=",
                      "value": "{{$_GET.manufacturer_id}}"
                    }
                  ]
                },
                {
                  "condition": "AND",
                  "conditional": "{{$_GET.device_model_id}}",
                  "rules": [
                    {
                      "data": {
                        "table": "m",
                        "column": "id"
                      },
                      "operation": "=",
                      "value": "{{$_GET.device_model_id}}"
                    }
                  ]
                },
                {
                  "condition": "AND",
                  "conditional": "{{$_GET.lifecycle_status_id}}",
                  "rules": [
                    {
                      "data": {
                        "table": "ls",
                        "column": "id"
                      },
                      "operation": "=",
                      "value": "{{$_GET.lifecycle_status_id}}"
                    }
                  ]
                },
                {
                  "condition": "AND",
                  "conditional": "{{$_GET.condition_id}}",
                  "rules": [
                    {
                      "data": {
                        "table": "c",
                        "column": "id"
                      },
                      "operation": "=",
                      "value": "{{$_GET.condition_id}}"
                    }
                  ]
                },
                {
                  "condition": "AND",
                  "conditional": "{{$_GET.warranty_status == 'not_recorded'}}",
                  "rules": [
                    {
                      "data": {
                        "table": "dv",
                        "column": "warranty_start_date"
                      },
                      "operator": "is_null"
                    },
                    {
                      "data": {
                        "table": "dv",
                        "column": "warranty_end_date"
                      },
                      "operator": "is_null"
                    }
                  ]
                },
                {
                  "condition": "AND",
                  "conditional": "{{$_GET.warranty_status == 'active'}}",
                  "rules": [
                    {
                      "data": {
                        "table": "dv",
                        "column": "warranty_end_date"
                      },
                      "operation": ">=",
                      "value": "{{'now'.formatDate('yyyy-MM-dd')}}"
                    }
                  ]
                },
                {
                  "condition": "AND",
                  "conditional": "{{$_GET.warranty_status == 'expired'}}",
                  "rules": [
                    {
                      "data": {
                        "table": "dv",
                        "column": "warranty_end_date"
                      },
                      "operation": "<",
                      "value": "{{'now'.formatDate('yyyy-MM-dd')}}"
                    }
                  ]
                }
              ]
            },
            "orders": [
              {
                "table": "dv",
                "column": "created_at",
                "direction": "desc"
              },
              {
                "table": "dv",
                "column": "id",
                "direction": "desc"
              }
            ],
            "limit": "{{page_size}}",
            "offset": "{{(page - 1) * page_size}}"
          }
        }
      },
      {
        "name": "display_devices",
        "module": "core",
        "action": "repeat",
        "options": {
          "repeat": "{{devices}}",
          "outputFilter": "exclude",
          "outputFields": [],
          "exec": {
            "steps": [
              {
                "name": "warranty_end_date_display",
                "module": "core",
                "action": "setvalue",
                "output": true,
                "options": {
                  "key": "warranty_end_date_display",
                  "value": "{{warranty_end_date ? warranty_end_date.formatDate('MMM d, yyyy') : 'Not recorded'}}"
                }
              },
              {
                "name": "received_date_display",
                "module": "core",
                "action": "setvalue",
                "output": true,
                "options": {
                  "key": "received_date_display",
                  "value": "{{received_date ? received_date.formatDate('MMM d, yyyy') : '-'}}"
                }
              }
            ]
          }
        }
      },
      {
        "module": "core",
        "action": "response",
        "options": {
          "status": 200,
          "data": {
            "success": true,
            "devices": "{{display_devices}}",
            "page": "{{page}}",
            "page_size": "{{page_size}}",
            "total": "{{filtered_count}}",
            "total_pages": "{{ceil(filtered_count / page_size)}}",
            "summary": {
              "total": "{{filtered_count}}"
            }
          }
        }
      }
    ],
    "catch": {
      "steps": [
        {
          "module": "core",
          "action": "response",
          "options": {
            "status": 500,
            "data": {
              "success": false,
              "error": "An unexpected server error occurred."
            }
          }
        }
      ]
    }
  }
}
