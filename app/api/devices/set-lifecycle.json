{
  "settings": { "options": { "method": "post", "nocsrf": true } },
  "meta": { "$_POST": [{ "name": "id", "type": "number" }, { "name": "lifecycle_code", "type": "text" }] },
  "exec": {
    "steps": [
      { "name": "require_permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "devices.manage" } }, "output": true },
      { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
      { "module": "core", "action": "condition", "options": { "if": "{{require_permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
      { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
      { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.id || $_POST.id < 1 || ($_POST.lifecycle_code != 'RECEIVED' && $_POST.lifecycle_code != 'AVAILABLE')}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "Only Received and Available lifecycle states are allowed in this phase." } } }] } } },
      { "name": "device", "module": "dbconnector", "action": "single", "options": { "connection": "db", "sql": { "table": { "name": "devices", "alias": "dv" }, "columns": [{ "table": "dv", "column": "id" }, { "table": "ls", "column": "code", "alias": "lifecycle_code" }, { "table": "cc", "column": "current_custody_level" }], "joins": [{ "table": "device_lifecycle_statuses", "alias": "ls", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ls", "column": "id", "operation": "=", "value": { "table": "dv", "column": "lifecycle_status_id" } }] } }, { "table": "v_device_current_custody", "alias": "cc", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "cc", "column": "device_id", "operation": "=", "value": { "table": "dv", "column": "id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "dv", "column": "id" }, "operation": "=", "value": "{{$_POST.id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!device.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Device was not found." } } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{device.current_custody_level != 'CENTRAL'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "Lifecycle changes are only allowed for centrally held devices." } } }] } } },
      { "name": "stock_location", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_device_current_stock_location", "columns": [{ "column": "stock_location_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "device_id" }, "operation": "=", "value": "{{$_POST.id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{stock_location.stock_location_id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "Release Repair Centre stock before changing lifecycle." } } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!((device.lifecycle_code == 'RECEIVED' && $_POST.lifecycle_code == 'AVAILABLE') || (device.lifecycle_code == 'AVAILABLE' && $_POST.lifecycle_code == 'RECEIVED'))}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "That lifecycle transition is not allowed." } } }] } } },
      { "name": "target_lifecycle", "module": "dbconnector", "action": "single", "options": { "connection": "db", "sql": { "table": "device_lifecycle_statuses", "columns": [{ "column": "id" }, { "column": "code" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "{{$_POST.lifecycle_code}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!target_lifecycle.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The requested lifecycle state is unavailable." } } }] } } },
      { "name": "save_lifecycle", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
        { "name": "custody_recheck", "module": "dbconnector", "action": "single", "options": { "connection": "db", "sql": { "table": "v_device_current_custody", "columns": [{ "column": "current_custody_level" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "device_id" }, "operation": "=", "value": "{{$_POST.id}}" }] } } } },
        { "module": "core", "action": "condition", "options": { "if": "{{custody_recheck.current_custody_level != 'CENTRAL'}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P5C_CENTRAL_CUSTODY_REQUIRED" } }] } } },
        { "name": "stock_recheck", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_device_current_stock_location", "columns": [{ "column": "stock_location_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "device_id" }, "operation": "=", "value": "{{$_POST.id}}" }] } } } },
        { "module": "core", "action": "condition", "options": { "if": "{{stock_recheck.stock_location_id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P8CB2_STOCK_ACTIVE" } }] } } },
        { "name": "update_lifecycle", "module": "dbupdater", "action": "update", "options": { "connection": "db", "sql": { "table": "devices", "values": [{ "column": "lifecycle_status_id", "value": "{{target_lifecycle.id}}" }, { "column": "updated_by_user_id", "value": "{{identity}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{$_POST.id}}" }] } } } },
        { "name": "audit_lifecycle", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "{{$_POST.lifecycle_code == 'AVAILABLE' ? 'device_marked_available' : 'device_returned_to_received'}}" }, { "column": "module", "value": "devices" }, { "column": "entity_type", "value": "device" }, { "column": "entity_id", "value": "{{$_POST.id}}" }, { "column": "description", "value": "Device lifecycle status changed." }] } } }
      ] } } },
      { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true } } }
    ],
    "catch": { "steps": [
      { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P8CB2_STOCK_ACTIVE'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "Release Repair Centre stock before changing lifecycle." } } }] } } },
      { "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "An unexpected server error occurred." } } }
    ] }
  }
}
