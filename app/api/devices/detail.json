{
  "settings": {
    "options": {
      "method": "get",
      "nocsrf": true
    }
  },
  "meta": {
    "$_GET": [
      {
        "name": "id",
        "type": "number"
      }
    ]
  },
  "exec": {
    "steps": [
      {
        "name": "require_permission",
        "module": "core",
        "action": "exec",
        "options": {
          "exec": "security_require_permission",
          "params": {
            "permission": "devices.view"
          }
        },
        "output": true
      },
      {
        "name": "scope_context",
        "module": "core",
        "action": "exec",
        "options": {
          "exec": "security_get_scope_context",
          "params": {}
        },
        "output": true
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{!$_GET.id || $_GET.id < 1}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 400,
                  "data": {
                    "success": false,
                    "error": "A valid device ID is required."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "name": "device",
        "module": "dbconnector",
        "action": "single",
        "output": true,
        "options": {
          "connection": "db",
          "sql": {
            "table": {
              "name": "devices",
              "alias": "dv"
            },
            "columns": [
              {
                "table": "dv",
                "column": "id"
              },
              {
                "table": "dv",
                "column": "serial_number"
              },
              {
                "table": "dv",
                "column": "asset_tag"
              },
              {
                "table": "dv",
                "column": "device_model_id"
              },
              {
                "table": "m",
                "column": "model_code"
              },
              {
                "table": "m",
                "column": "model_name"
              },
              {
                "table": "mf",
                "column": "id",
                "alias": "manufacturer_id"
              },
              {
                "table": "mf",
                "column": "manufacturer_code"
              },
              {
                "table": "mf",
                "column": "name",
                "alias": "manufacturer_name"
              },
              {
                "table": "dv",
                "column": "lifecycle_status_id"
              },
              {
                "table": "ls",
                "column": "code",
                "alias": "lifecycle_code"
              },
              {
                "table": "ls",
                "column": "name",
                "alias": "lifecycle_name"
              },
              {
                "table": "dv",
                "column": "condition_id"
              },
              {
                "table": "c",
                "column": "code",
                "alias": "condition_code"
              },
              {
                "table": "c",
                "column": "name",
                "alias": "condition_name"
              },
              {
                "table": "dv",
                "column": "warranty_start_date"
              },
              {
                "table": "dv",
                "column": "warranty_end_date"
              },
              {
                "table": "dv",
                "column": "received_date"
              },
              {
                "table": "dv",
                "column": "procurement_reference"
              },
              {
                "table": "dv",
                "column": "supplier_name"
              },
              {
                "table": "dv",
                "column": "warranty_reference"
              },
              {
                "table": "dv",
                "column": "notes"
              },
              {
                "table": "dv",
                "column": "created_by_user_id"
              },
              {
                "table": "dv",
                "column": "updated_by_user_id"
              },
              {
                "table": "dv",
                "column": "created_at"
              },
              {
                "table": "dv",
                "column": "updated_at"
              },
              {
                "table": "cc",
                "column": "current_custody_level"
              },
              {
                "table": "cc",
                "column": "district_id"
              },
              {
                "table": "d",
                "column": "name",
                "alias": "district_name"
              },
              {
                "table": "cc",
                "column": "school_id"
              },
              {
                "table": "s",
                "column": "name",
                "alias": "school_name"
              },
              {
                "table": "cc",
                "column": "student_id"
              },
              {
                "table": "st",
                "column": "student_reference"
              },
              {
                "table": "st",
                "column": "first_name",
                "alias": "student_first_name"
              },
              {
                "table": "st",
                "column": "last_name",
                "alias": "student_last_name"
              },
              {
                "table": "cc",
                "column": "student_assignment_type"
              },
              {
                "table": "m",
                "column": "image_available",
                "alias": "image_available"
              }
            ],
            "joins": [
              {
                "table": "device_models",
                "alias": "m",
                "type": "inner",
                "clauses": {
                  "condition": "AND",
                  "rules": [
                    {
                      "table": "m",
                      "column": "id",
                      "operation": "=",
                      "value": {
                        "table": "dv",
                        "column": "device_model_id"
                      }
                    }
                  ]
                }
              },
              {
                "table": "manufacturers",
                "alias": "mf",
                "type": "inner",
                "clauses": {
                  "condition": "AND",
                  "rules": [
                    {
                      "table": "mf",
                      "column": "id",
                      "operation": "=",
                      "value": {
                        "table": "m",
                        "column": "manufacturer_id"
                      }
                    }
                  ]
                }
              },
              {
                "table": "device_lifecycle_statuses",
                "alias": "ls",
                "type": "inner",
                "clauses": {
                  "condition": "AND",
                  "rules": [
                    {
                      "table": "ls",
                      "column": "id",
                      "operation": "=",
                      "value": {
                        "table": "dv",
                        "column": "lifecycle_status_id"
                      }
                    }
                  ]
                }
              },
              {
                "table": "device_conditions",
                "alias": "c",
                "type": "inner",
                "clauses": {
                  "condition": "AND",
                  "rules": [
                    {
                      "table": "c",
                      "column": "id",
                      "operation": "=",
                      "value": {
                        "table": "dv",
                        "column": "condition_id"
                      }
                    }
                  ]
                }
              },
              {
                "table": "v_device_current_custody",
                "alias": "cc",
                "type": "inner",
                "clauses": {
                  "condition": "AND",
                  "rules": [
                    {
                      "table": "cc",
                      "column": "device_id",
                      "operation": "=",
                      "value": {
                        "table": "dv",
                        "column": "id"
                      }
                    }
                  ]
                }
              },
              {
                "table": "districts",
                "alias": "d",
                "type": "left",
                "clauses": {
                  "condition": "AND",
                  "rules": [
                    {
                      "table": "d",
                      "column": "id",
                      "operation": "=",
                      "value": {
                        "table": "cc",
                        "column": "district_id"
                      }
                    }
                  ]
                }
              },
              {
                "table": "schools",
                "alias": "s",
                "type": "left",
                "clauses": {
                  "condition": "AND",
                  "rules": [
                    {
                      "table": "s",
                      "column": "id",
                      "operation": "=",
                      "value": {
                        "table": "cc",
                        "column": "school_id"
                      }
                    }
                  ]
                }
              },
              {
                "table": "students",
                "alias": "st",
                "type": "left",
                "clauses": {
                  "condition": "AND",
                  "rules": [
                    {
                      "table": "st",
                      "column": "id",
                      "operation": "=",
                      "value": {
                        "table": "cc",
                        "column": "student_id"
                      }
                    }
                  ]
                }
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "data": {
                    "table": "dv",
                    "column": "id"
                  },
                  "operation": "=",
                  "value": "{{$_GET.id}}"
                }
              ]
            }
          }
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{!device.id}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 404,
                  "data": {
                    "success": false,
                    "error": "Device was not found."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{require_permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && !scope_context.districts.flatten('id').contains(device.district_id) && !scope_context.schools.flatten('id').contains(device.school_id)}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 403,
                  "data": {
                    "success": false,
                    "error": "Forbidden."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "name": "stock_location",
        "module": "dbconnector",
        "action": "single",
        "output": true,
        "options": {
          "connection": "db",
          "sql": {
            "table": "v_device_stock_queue",
            "columns": [
              {
                "column": "stock_location_id"
              },
              {
                "column": "service_location_id"
              },
              {
                "column": "service_location_name"
              },
              {
                "column": "physical_custody_code"
              },
              {
                "column": "physical_custody_name"
              },
              {
                "column": "placed_at"
              },
              {
                "column": "is_reserved_for_replacement"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "data": {
                    "column": "device_id"
                  },
                  "operation": "=",
                  "value": "{{device.id}}"
                },
                {
                  "data": {
                    "column": "lifecycle_code"
                  },
                  "operation": "=",
                  "value": "AVAILABLE"
                },
                {
                  "data": {
                    "column": "has_active_logistics"
                  },
                  "operation": "=",
                  "value": 0
                },
                {
                  "data": {
                    "column": "has_active_manufacturer_return"
                  },
                  "operation": "=",
                  "value": 0
                },
                {
                  "data": {
                    "column": "has_active_repair"
                  },
                  "operation": "=",
                  "value": 0
                }
              ]
            }
          }
        }
      },
      {
        "module": "core",
        "action": "response",
        "options": {
          "status": 200,
          "data": {
            "success": true,
            "device": "{{device}}",
            "physical_stock_location": "{{stock_location}}",
            "date_inputs": {
              "received_date": "{{device.received_date ? device.received_date.formatDate('yyyy-MM-dd') : ''}}",
              "warranty_start_date": "{{device.warranty_start_date ? device.warranty_start_date.formatDate('yyyy-MM-dd') : ''}}",
              "warranty_end_date": "{{device.warranty_end_date ? device.warranty_end_date.formatDate('yyyy-MM-dd') : ''}}"
            },
            "date_display": {
              "received_date": "{{device.received_date ? device.received_date.formatDate('MMM d, yyyy, hh:mm A') : 'Not recorded'}}",
              "warranty_start_date": "{{device.warranty_start_date ? device.warranty_start_date.formatDate('MMM d, yyyy, hh:mm A') : 'Not recorded'}}",
              "warranty_end_date": "{{device.warranty_end_date ? device.warranty_end_date.formatDate('MMM d, yyyy, hh:mm A') : 'Not recorded'}}",
              "created_at": "{{device.created_at ? device.created_at.formatDate('MMM d, yyyy, hh:mm A') : 'Not recorded'}}",
              "updated_at": "{{device.updated_at ? device.updated_at.formatDate('MMM d, yyyy, hh:mm A') : 'Not recorded'}}"
            }
          }
        }
      }
    ],
    "catch": {
      "steps": [
        {
          "module": "core",
          "action": "response",
          "options": {
            "status": 500,
            "data": {
              "success": false,
              "error": "An unexpected server error occurred."
            }
          }
        }
      ]
    }
  }
}
