{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "meta": { "$_GET": [{ "name": "id", "type": "number" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "device_school_allocations.view" } }, "output": true },
    { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_GET.id || $_GET.id < 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "A valid school allocation ID is required." } } }] } } },
    { "name": "allocation", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "device_school_allocations", "alias": "a" }, "joins": [
      { "table": "device_district_allocations", "alias": "da", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "da", "column": "id", "operation": "=", "value": { "table": "a", "column": "district_allocation_id" } }, { "table": "da", "column": "device_id", "operation": "=", "value": { "table": "a", "column": "device_id" } }] } },
      { "table": "devices", "alias": "dv", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "dv", "column": "id", "operation": "=", "value": { "table": "a", "column": "device_id" } }] } },
      { "table": "schools", "alias": "s", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "s", "column": "id", "operation": "=", "value": { "table": "a", "column": "school_id" } }] } },
      { "table": "districts", "alias": "d", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "d", "column": "id", "operation": "=", "value": { "table": "da", "column": "district_id" } }] } },
      { "table": "device_models", "alias": "m", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "m", "column": "id", "operation": "=", "value": { "table": "dv", "column": "device_model_id" } }] } },
      { "table": "manufacturers", "alias": "mf", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "mf", "column": "id", "operation": "=", "value": { "table": "m", "column": "manufacturer_id" } }] } },
      { "table": "device_conditions", "alias": "c", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "c", "column": "id", "operation": "=", "value": { "table": "dv", "column": "condition_id" } }] } },
      { "table": "device_lifecycle_statuses", "alias": "ls", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ls", "column": "id", "operation": "=", "value": { "table": "dv", "column": "lifecycle_status_id" } }] } },
      { "table": "users", "alias": "u", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "u", "column": "id", "operation": "=", "value": { "table": "a", "column": "allocated_by_user_id" } }] } },
      { "table": "users", "alias": "ru", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "ru", "column": "id", "operation": "=", "value": { "table": "a", "column": "returned_by_user_id" } }] } },
      { "table": "v_device_current_custody", "alias": "cc", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "cc", "column": "device_id", "operation": "=", "value": { "table": "a", "column": "device_id" } }] } }
    ], "columns": [{ "table": "a", "column": "id", "alias": "school_allocation_id" }, { "table": "a", "column": "district_allocation_id" }, { "table": "a", "column": "device_id" }, { "table": "dv", "column": "serial_number" }, { "table": "dv", "column": "asset_tag" }, { "table": "mf", "column": "name", "alias": "manufacturer" }, { "table": "m", "column": "model_name", "alias": "model" }, { "table": "c", "column": "name", "alias": "condition" }, { "table": "ls", "column": "code", "alias": "lifecycle" }, { "table": "da", "column": "district_id" }, { "table": "d", "column": "name", "alias": "district_name" }, { "table": "s", "column": "id", "alias": "school_id" }, { "table": "s", "column": "school_code" }, { "table": "s", "column": "name", "alias": "school_name" }, { "table": "a", "column": "allocated_at" }, { "table": "u", "column": "display_name", "alias": "allocated_by" }, { "table": "a", "column": "returned_at" }, { "table": "ru", "column": "display_name", "alias": "returned_by" }, { "table": "a", "column": "return_reason" }, { "table": "a", "column": "active_record_key" }, { "table": "cc", "column": "current_custody_level" }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "a", "column": "id" }, "operation": "=", "value": "{{$_GET.id}}" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!allocation.school_allocation_id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "School allocation was not found." } } }] } } },
    { "name": "district_scope", "module": "dbconnector", "action": "single", "options": { "connection": "db", "sql": { "table": "user_district_scopes", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "column": "district_id" }, "operation": "=", "value": "{{allocation.district_id}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
    { "name": "school_scope", "module": "dbconnector", "action": "single", "options": { "connection": "db", "sql": { "table": "user_school_scopes", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "column": "school_id" }, "operation": "=", "value": "{{allocation.school_id}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length > 0 && !district_scope.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length == 0 && !school_scope.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "allocation": "{{allocation}}" } } }
  ], "catch": { "steps": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "School allocation details could not be loaded." } } }] } }
}
