{
  "settings": { "options": { "method": "post", "nocsrf": true } },
  "meta": { "$_POST": [{ "name": "school_id", "type": "number" }, { "name": "device_ids", "type": "array" }, { "name": "notes", "type": "text" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "device_school_allocations.manage" } }, "output": true },
    { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.school_id || $_POST.school_id < 1 || !$_POST.device_ids || $_POST.device_ids.length < 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Select an active school and at least one device." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_POST.device_ids.length > 500}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "A maximum of 500 devices can be allocated at one time." } } }] } } },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "name": "school", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "schools", "alias": "s" }, "columns": [{ "table": "s", "column": "id" }, { "table": "s", "column": "name" }, { "table": "s", "column": "school_code" }, { "table": "s", "column": "district_id" }, { "table": "s", "column": "status" }, { "table": "d", "column": "name", "alias": "district_name" }], "joins": [{ "table": "districts", "alias": "d", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "d", "column": "id", "operation": "=", "value": { "table": "s", "column": "district_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "s", "column": "id" }, "operation": "=", "value": "{{$_POST.school_id}}" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!school.id || school.status != 'active'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The selected school is unavailable." } } }] } } },
    { "name": "target_district_scope", "module": "dbconnector", "action": "single", "options": { "connection": "db", "sql": { "table": "user_district_scopes", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "column": "district_id" }, "operation": "=", "value": "{{school.district_id}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && !target_district_scope.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "You are not authorized to allocate devices to this school's district." } } }] } } },
    { "name": "allocation_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "active_school", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "schools", "columns": [{ "column": "id" }, { "column": "name" }, { "column": "district_id" }, { "column": "status" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{$_POST.school_id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!active_school.id || active_school.status != 'active'}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P5C_SCHOOL_RECHECK_FAILED" } }] } } },
      { "name": "active_target_district_scope", "module": "dbconnector", "action": "single", "options": { "connection": "db", "sql": { "table": "user_district_scopes", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "column": "district_id" }, "operation": "=", "value": "{{active_school.district_id}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && !active_target_district_scope.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P5C_SCOPE_RECHECK_FAILED" } }] } } },
      { "name": "eligible_devices", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": {
        "table": { "name": "device_district_allocations", "alias": "da" },
        "joins": [
          { "table": "devices", "alias": "dv", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "dv", "column": "id", "operation": "=", "value": { "table": "da", "column": "device_id" } }] } },
          { "table": "device_lifecycle_statuses", "alias": "ls", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ls", "column": "id", "operation": "=", "value": { "table": "dv", "column": "lifecycle_status_id" } }] } },
          { "table": "v_device_current_custody", "alias": "cc", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "cc", "column": "device_id", "operation": "=", "value": { "table": "dv", "column": "id" } }] } }
        ],
        "columns": [{ "table": "dv", "column": "id" }, { "table": "dv", "column": "serial_number" }, { "table": "da", "column": "id", "alias": "district_allocation_id" }, { "table": "da", "column": "district_id" }, { "table": "ls", "column": "code", "alias": "lifecycle_code" }, { "table": "cc", "column": "current_custody_level" }],
        "wheres": { "condition": "AND", "rules": [
          { "data": { "table": "da", "column": "active_record_key" }, "operation": "=", "value": 1 },
          { "data": { "table": "dv", "column": "id" }, "operation": "in", "value": "{{$_POST.device_ids}}" },
          { "data": { "table": "ls", "column": "code" }, "operation": "=", "value": "AVAILABLE" },
          { "data": { "table": "cc", "column": "current_custody_level" }, "operation": "=", "value": "DISTRICT" },
          { "data": { "table": "cc", "column": "district_id" }, "operation": "=", "value": "{{active_school.district_id}}" },
          { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope}}", "rules": [{ "data": { "table": "da", "column": "district_id" }, "operation": "in", "value": "{{scope_context.districts.flatten('id')}}" }] }
        ] }
      } } },
      { "module": "core", "action": "condition", "options": { "if": "{{eligible_devices.length != $_POST.device_ids.length}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P5C_DEVICE_RECHECK_FAILED" } }] } } },
      { "name": "allocate_each_device", "module": "core", "action": "repeat", "options": { "repeat": "{{eligible_devices}}", "exec": { "steps": [
        { "name": "active_school_allocation", "module": "dbconnector", "action": "count", "output": true, "options": { "connection": "db", "sql": { "table": "device_school_allocations", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "device_id" }, "operation": "=", "value": "{{id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }] } } } },
        { "module": "core", "action": "condition", "options": { "if": "{{active_school_allocation > 0}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P5C_ALREADY_ALLOCATED" } }] } } },
        { "module": "core", "action": "condition", "options": { "if": "{{district_id != active_school.district_id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P5C_CROSS_DISTRICT_REJECTED" } }] } } },
        { "name": "school_allocation", "module": "dbupdater", "action": "insert", "output": true, "options": { "connection": "db", "sql": { "table": "device_school_allocations", "values": [{ "column": "device_id", "value": "{{id}}" }, { "column": "district_allocation_id", "value": "{{district_allocation_id}}" }, { "column": "school_id", "value": "{{active_school.id}}" }, { "column": "allocated_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss')}}" }, { "column": "allocated_by_user_id", "value": "{{identity}}" }, { "column": "notes", "value": "{{($_POST.notes || '').trim() || null}}" }, { "column": "active_record_key", "value": 1 }] } } },
        { "name": "audit", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "device_allocated_to_school" }, { "column": "module", "value": "device_allocations" }, { "column": "entity_type", "value": "device_school_allocation" }, { "column": "entity_id", "value": "{{school_allocation.identity}}" }, { "column": "description", "value": "{{'Allocated device ' + serial_number + ' to ' + active_school.name + ' (' + active_school.district_id + ')'}}" }] } } }
      ] } } }
    ] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "allocated_count": "{{eligible_devices.length}}", "school_name": "{{school.name}}", "district_name": "{{school.district_name}}" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "One or more devices could not be allocated. No devices were allocated." } } }] }
}
