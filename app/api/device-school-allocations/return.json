{
  "settings": { "options": { "method": "post", "nocsrf": true } },
  "meta": { "$_POST": [{ "name": "school_allocation_id", "type": "number" }, { "name": "return_reason", "type": "text" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "device_school_returns.manage" } }, "output": true },
    { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.school_allocation_id || $_POST.school_allocation_id < 1 || !$_POST.return_reason || !$_POST.return_reason.trim() || $_POST.return_reason.trim().length > 500}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "A valid school allocation and return reason of 1 to 500 characters are required." } } }] } } },
    { "name": "allocation", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "device_school_allocations", "alias": "a" }, "joins": [
      { "table": "devices", "alias": "dv", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "dv", "column": "id", "operation": "=", "value": { "table": "a", "column": "device_id" } }] } },
      { "table": "device_lifecycle_statuses", "alias": "ls", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ls", "column": "id", "operation": "=", "value": { "table": "dv", "column": "lifecycle_status_id" } }] } },
      { "table": "v_device_current_custody", "alias": "cc", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "cc", "column": "device_id", "operation": "=", "value": { "table": "dv", "column": "id" } }] } },
      { "table": "device_district_allocations", "alias": "da", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "da", "column": "id", "operation": "=", "value": { "table": "a", "column": "district_allocation_id" } }, { "table": "da", "column": "device_id", "operation": "=", "value": { "table": "a", "column": "device_id" } }] } },
      { "table": "districts", "alias": "d", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "d", "column": "id", "operation": "=", "value": { "table": "da", "column": "district_id" } }] } },
      { "table": "schools", "alias": "s", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "s", "column": "id", "operation": "=", "value": { "table": "a", "column": "school_id" } }] } }
    ], "columns": [{ "table": "a", "column": "id", "alias": "school_allocation_id" }, { "table": "a", "column": "device_id" }, { "table": "a", "column": "school_id" }, { "table": "a", "column": "district_allocation_id" }, { "table": "a", "column": "active_record_key" }, { "table": "a", "column": "returned_at" }, { "table": "dv", "column": "serial_number" }, { "table": "ls", "column": "code", "alias": "lifecycle_code" }, { "table": "cc", "column": "current_custody_level" }, { "table": "cc", "column": "school_allocation_id", "alias": "current_school_allocation_id" }, { "table": "cc", "column": "district_allocation_id", "alias": "current_district_allocation_id" }, { "table": "cc", "column": "district_id" }, { "table": "da", "column": "active_record_key", "alias": "district_active" }, { "table": "s", "column": "name", "alias": "school_name" }, { "table": "d", "column": "name", "alias": "district_name" }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "a", "column": "id" }, "operation": "=", "value": "{{$_POST.school_allocation_id}}" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!allocation.school_allocation_id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "School allocation was not found." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{allocation.active_record_key != 1 || allocation.returned_at}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "This school allocation has already been returned." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && !scope_context.districts.flatten('id').contains(allocation.district_id)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "You are not authorized to return devices from this district." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{allocation.current_custody_level == 'STUDENT'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "Return the active student assignment before returning this device to the district." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{allocation.lifecycle_code != 'AVAILABLE' || allocation.current_custody_level != 'SCHOOL' || allocation.current_school_allocation_id != allocation.school_allocation_id || allocation.district_active != 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The device custody or lifecycle state is inconsistent; no changes were made." } } }] } } },
    { "name": "active_student", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "device_student_assignments", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "device_id" }, "operation": "=", "value": "{{allocation.device_id}}" }, { "data": { "column": "school_allocation_id" }, "operation": "=", "value": "{{allocation.school_allocation_id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "returned_at" }, "operator": "is_null" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{active_student.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "Return the active student assignment before returning this device to the district." } } }] } } },
    { "name": "return_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "active_allocation", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "device_school_allocations", "alias": "a" }, "joins": [
        { "table": "devices", "alias": "dv", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "dv", "column": "id", "operation": "=", "value": { "table": "a", "column": "device_id" } }] } },
        { "table": "device_lifecycle_statuses", "alias": "ls", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ls", "column": "id", "operation": "=", "value": { "table": "dv", "column": "lifecycle_status_id" } }] } },
        { "table": "v_device_current_custody", "alias": "cc", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "cc", "column": "device_id", "operation": "=", "value": { "table": "dv", "column": "id" } }] } },
        { "table": "device_district_allocations", "alias": "da", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "da", "column": "id", "operation": "=", "value": { "table": "a", "column": "district_allocation_id" } }, { "table": "da", "column": "device_id", "operation": "=", "value": { "table": "a", "column": "device_id" } }] } }
      ], "columns": [{ "table": "a", "column": "id", "alias": "school_allocation_id" }, { "table": "a", "column": "device_id" }, { "table": "a", "column": "school_id" }, { "table": "a", "column": "district_allocation_id" }, { "table": "a", "column": "active_record_key" }, { "table": "a", "column": "returned_at" }, { "table": "dv", "column": "serial_number" }, { "table": "ls", "column": "code", "alias": "lifecycle_code" }, { "table": "cc", "column": "current_custody_level" }, { "table": "cc", "column": "school_allocation_id", "alias": "current_school_allocation_id" }, { "table": "cc", "column": "district_allocation_id", "alias": "current_district_allocation_id" }, { "table": "cc", "column": "district_id" }, { "table": "da", "column": "active_record_key", "alias": "district_active" }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "a", "column": "id" }, "operation": "=", "value": "{{$_POST.school_allocation_id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!active_allocation.school_allocation_id || active_allocation.active_record_key != 1 || active_allocation.returned_at || active_allocation.lifecycle_code != 'AVAILABLE' || active_allocation.current_custody_level != 'SCHOOL' || active_allocation.current_school_allocation_id != active_allocation.school_allocation_id || active_allocation.district_active != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P5E_SCHOOL_LINEAGE_INVALID" } }] } } },
      { "name": "active_student_recheck", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "device_student_assignments", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "device_id" }, "operation": "=", "value": "{{active_allocation.device_id}}" }, { "data": { "column": "school_allocation_id" }, "operation": "=", "value": "{{active_allocation.school_allocation_id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "returned_at" }, "operator": "is_null" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{active_student_recheck.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P5E_ACTIVE_STUDENT_CHILD" } }] } } },
      { "name": "active_district_scope", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "user_district_scopes", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "column": "district_id" }, "operation": "=", "value": "{{active_allocation.district_id}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
      { "name": "active_national_scope", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "user_national_scopes", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !active_national_scope.id && !active_district_scope.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P5E_SCHOOL_SCOPE_INVALID" } }] } } },
      { "name": "close_allocation", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "device_school_allocations", "values": [{ "column": "returned_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss')}}" }, { "column": "returned_by_user_id", "value": "{{identity}}" }, { "column": "return_reason", "value": "{{$_POST.return_reason.trim()}}" }, { "column": "active_record_key", "value": null }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{active_allocation.school_allocation_id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "returned_at" }, "operator": "is_null" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{close_allocation.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P5E_SCHOOL_CLOSE_FAILED" } }] } } },
      { "name": "audit", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "device_returned_to_district" }, { "column": "module", "value": "device_allocations" }, { "column": "entity_type", "value": "device_school_allocation" }, { "column": "entity_id", "value": "{{active_allocation.school_allocation_id}}" }, { "column": "description", "value": "{{'Returned device ' + active_allocation.serial_number + ' from ' + active_allocation.school_id + ' to district ' + active_allocation.district_id}}" }] } } }
    ] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "message": "Device returned to District inventory. Lifecycle remains Available.", "school_allocation_id": "{{allocation.school_allocation_id}}" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The school allocation could not be returned because its state changed or it has an active student assignment. No changes were saved." } } }] }
}
