{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "device_school_allocations.view" } }, "output": true },
    { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
    { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length == 0 && scope_context.schools.length == 0}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "district_available": 0, "school_allocated": 0, "schools_with_inventory": 0, "district_available_visible": false } } }] } } },
    { "name": "school_allocated", "module": "dbconnector", "action": "count", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "device_school_allocations", "alias": "a" }, "columns": [{ "table": "a", "column": "id" }], "joins": [{ "table": "device_district_allocations", "alias": "da", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "da", "column": "id", "operation": "=", "value": { "table": "a", "column": "district_allocation_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "a", "column": "active_record_key" }, "operation": "=", "value": 1 }, { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length > 0}}", "rules": [{ "data": { "table": "da", "column": "district_id" }, "operation": "in", "value": "{{scope_context.districts.flatten('id')}}" }] }, { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length == 0 && scope_context.schools.length > 0}}", "rules": [{ "data": { "table": "a", "column": "school_id" }, "operation": "in", "value": "{{scope_context.schools.flatten('id')}}" }] }, { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length == 0 && scope_context.schools.length == 0}}", "rules": [{ "data": { "table": "a", "column": "id" }, "operation": "=", "value": -1 }] }] } } } },
    { "name": "schools_with_inventory_rows", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "device_school_allocations", "alias": "a" }, "joins": [{ "table": "device_district_allocations", "alias": "da", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "da", "column": "id", "operation": "=", "value": { "table": "a", "column": "district_allocation_id" } }] } }], "distinct": true, "columns": [{ "table": "a", "column": "school_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "a", "column": "active_record_key" }, "operation": "=", "value": 1 }, { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length > 0}}", "rules": [{ "data": { "table": "da", "column": "district_id" }, "operation": "in", "value": "{{scope_context.districts.flatten('id')}}" }] }, { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length == 0 && scope_context.schools.length > 0}}", "rules": [{ "data": { "table": "a", "column": "school_id" }, "operation": "in", "value": "{{scope_context.schools.flatten('id')}}" }] }, { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length == 0 && scope_context.schools.length == 0}}", "rules": [{ "data": { "table": "a", "column": "id" }, "operation": "=", "value": -1 }] }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass == 'SUPER_ADMIN' || scope_context.has_national_scope || scope_context.districts.length > 0}}", "then": { "steps": [{ "name": "district_available", "module": "dbconnector", "action": "count", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "devices", "alias": "dv" }, "columns": [{ "table": "dv", "column": "id" }], "joins": [{ "table": "device_lifecycle_statuses", "alias": "ls", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ls", "column": "id", "operation": "=", "value": { "table": "dv", "column": "lifecycle_status_id" } }] } }, { "table": "v_device_current_custody", "alias": "cc", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "cc", "column": "device_id", "operation": "=", "value": { "table": "dv", "column": "id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "ls", "column": "code" }, "operation": "=", "value": "AVAILABLE" }, { "data": { "table": "cc", "column": "current_custody_level" }, "operation": "=", "value": "DISTRICT" }, { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope}}", "rules": [{ "data": { "table": "cc", "column": "district_id" }, "operation": "in", "value": "{{scope_context.districts.flatten('id')}}" }] }] } } } }, { "module": "core", "action": "setvalue", "options": { "key": "district_available_safe", "value": "{{district_available}}" }, "output": true }] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "district_available": "{{district_available_safe || 0}}", "school_allocated": "{{school_allocated}}", "schools_with_inventory": "{{schools_with_inventory_rows.length}}", "district_available_visible": "{{permission.bypass == 'SUPER_ADMIN' || scope_context.has_national_scope || scope_context.districts.length > 0}}" } } }
  ], "catch": { "steps": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "School allocation summary could not be loaded." } } }] } }
}
