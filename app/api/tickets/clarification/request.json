{
  "settings": { "options": { "method": "post", "nocsrf": true } },
  "meta": { "$_POST": [{ "name": "ticket_id", "type": "number" }, { "name": "comment_text", "type": "text" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "tickets.clarification_request" } }, "output": true },
    { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "name": "comment_text", "module": "core", "action": "setvalue", "options": { "key": "comment_text", "value": "{{($_POST.comment_text || '').trim()}}" } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.ticket_id || $_POST.ticket_id < 1 || !comment_text || comment_text.length() > 20000}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Enter the clarification required, up to 20,000 characters." } } }] } } },
    { "name": "ticket", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "tickets", "alias": "t" }, "columns": [{ "table": "t", "column": "id" }, { "table": "t", "column": "ticket_number" }, { "table": "t", "column": "origin_school_id" }, { "table": "t", "column": "origin_district_id" }, { "table": "ts", "column": "code", "alias": "status_code" }], "joins": [{ "table": "ticket_statuses", "alias": "ts", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ts", "column": "id", "operation": "=", "value": { "table": "t", "column": "current_status_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "t", "column": "id" }, "operation": "=", "value": "{{$_POST.ticket_id}}" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!ticket.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Ticket was not found." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.schools.flatten('id').contains(ticket.origin_school_id) && !scope_context.districts.flatten('id').contains(ticket.origin_district_id)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{ticket.status_code != 'SUBMITTED'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "Clarification can only be requested for a submitted ticket." } } }] } } },
    { "name": "request_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "submitted_status", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_statuses", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "SUBMITTED" }] } } } },
      { "name": "clarification_status", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_statuses", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "NEEDS_CLARIFICATION" }] } } } },
      { "name": "current_ticket", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "tickets", "columns": [{ "column": "id" }, { "column": "current_status_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{ticket.id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{current_ticket.current_status_id != submitted_status.id || !clarification_status.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P6C_CLARIFICATION_REQUEST_STATE_CHANGED" } }] } } },
      { "name": "insert_request", "module": "dbupdater", "action": "insert", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_comments", "values": [{ "column": "ticket_id", "value": "{{ticket.id}}" }, { "column": "comment_type", "value": "CLARIFICATION_REQUEST" }, { "column": "comment_text", "value": "{{comment_text}}" }, { "column": "created_by_user_id", "value": "{{identity}}" }, { "column": "created_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss')}}" }, { "column": "is_internal", "value": 0 }] } } },
      { "name": "insert_history", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "ticket_status_history", "values": [{ "column": "ticket_id", "value": "{{ticket.id}}" }, { "column": "from_status_id", "value": "{{submitted_status.id}}" }, { "column": "to_status_id", "value": "{{clarification_status.id}}" }, { "column": "changed_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss')}}" }, { "column": "changed_by_user_id", "value": "{{identity}}" }] } } },
      { "name": "update_status", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "tickets", "values": [{ "column": "current_status_id", "value": "{{clarification_status.id}}" }, { "column": "updated_by_user_id", "value": "{{identity}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{ticket.id}}" }, { "data": { "column": "current_status_id" }, "operation": "=", "value": "{{submitted_status.id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{update_status.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P6C_CLARIFICATION_REQUEST_STATE_CHANGED" } }] } } },
      { "name": "audit_request", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "ticket_clarification_requested" }, { "column": "module", "value": "tickets" }, { "column": "entity_type", "value": "ticket" }, { "column": "entity_id", "value": "{{ticket.id}}" }, { "column": "description", "value": "{{'Clarification requested for ' + ticket.ticket_number}}" }] } } }
    ] } } },
    { "name": "notify_clarification_requested", "module": "core", "action": "exec", "options": { "exec": "notification_from_workflow", "params": { "event_type_code": "TICKET_CLARIFICATION_REQUESTED", "ticket_id": "{{ticket.id}}", "source_id": "{{insert_request.identity}}", "actor_user_id": "{{identity}}", "message": "Additional information is required for this ticket before work can continue." } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "ticket_id": "{{ticket.id}}", "status": "NEEDS_CLARIFICATION" } } }
  ], "catch": [
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P6C_CLARIFICATION_REQUEST_STATE_CHANGED'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "Ticket status changed. Reload the ticket before requesting clarification." } } }] } } },
    { "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Clarification could not be requested." } } }
  ] }
}
