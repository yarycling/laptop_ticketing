{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "meta": { "$_GET": [
    { "name": "submitted_from", "type": "text" }, { "name": "submitted_to", "type": "text" },
    { "name": "district_id", "type": "number" }, { "name": "school_id", "type": "number" },
    { "name": "status_code", "type": "text" }, { "name": "requester_type", "type": "text" },
    { "name": "assignment_filter", "type": "text" }, { "name": "assigned_to_user_id", "type": "number" },
    { "name": "search", "type": "text" }, { "name": "page", "type": "number" }, { "name": "page_size", "type": "number" }
  ] },
  "exec": {
    "steps": [
      { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "tickets.report" } }, "output": true },
      { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
      { "name": "page", "module": "core", "action": "setvalue", "options": { "key": "page", "value": "{{!$_GET.page ? 1 : floor($_GET.page)}}" } },
      { "name": "page_size", "module": "core", "action": "setvalue", "options": { "key": "page_size", "value": "{{!$_GET.page_size ? 25 : floor($_GET.page_size)}}" } },
      { "name": "assignment_filter", "module": "core", "action": "setvalue", "options": { "key": "assignment_filter", "value": "{{($_GET.assignment_filter || 'ALL').uppercase()}}" } },
      { "name": "requester_type", "module": "core", "action": "setvalue", "options": { "key": "requester_type", "value": "{{($_GET.requester_type || '').uppercase()}}" } },
      { "module": "core", "action": "condition", "options": { "if": "{{page < 1 || page != $_GET.page && $_GET.page || page_size < 1 || page_size > 100 || (assignment_filter != 'ALL' && assignment_filter != 'ASSIGNED' && assignment_filter != 'UNASSIGNED') || (requester_type && requester_type != 'STUDENT' && requester_type != 'PARENT' && requester_type != 'TEACHER' && requester_type != 'STAFF') || ($_GET.district_id && $_GET.district_id < 1) || ($_GET.school_id && $_GET.school_id < 1) || ($_GET.assigned_to_user_id && $_GET.assigned_to_user_id < 1)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Check the report filters, assignment filter, and pagination values." } } }] } } },
      { "name": "date_validation", "module": "validator", "action": "validate", "options": { "noError": true, "data": [
        { "name": "submitted_from", "value": "{{$_GET.submitted_from}}", "rules": { "core:date": { "message": "Enter a valid start date." } } },
        { "name": "submitted_to", "value": "{{$_GET.submitted_to}}", "rules": { "core:date": { "message": "Enter a valid end date." } } }
      ] } },
      { "module": "core", "action": "condition", "options": { "if": "{{!date_validation}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Enter dates in YYYY-MM-DD format." } } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{$_GET.submitted_from && $_GET.submitted_to && $_GET.submitted_from > $_GET.submitted_to}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "The start date must not be after the end date." } } }] } } },
      { "name": "total", "module": "dbconnector", "action": "count", "output": true, "options": { "connection": "db", "sql": {
        "table": { "name": "v_ticket_operational_metrics", "alias": "m" },
        "joins": [
          { "table": "devices", "alias": "dv", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "dv", "column": "id", "operation": "=", "value": { "table": "m", "column": "device_id" } }] } }
        ],
        "wheres": { "condition": "AND", "rules": [
          { "condition": "AND", "conditional": "{{$_GET.submitted_from}}", "rules": [{ "data": { "table": "m", "column": "submitted_at" }, "operation": ">=", "value": "{{$_GET.submitted_from}}" }] },
          { "condition": "AND", "conditional": "{{$_GET.submitted_to}}", "rules": [{ "data": { "table": "m", "column": "submitted_at" }, "operation": "<=", "value": "{{$_GET.submitted_to + ' 23:59:59'}}" }] },
          { "condition": "AND", "conditional": "{{$_GET.district_id}}", "rules": [{ "data": { "table": "m", "column": "origin_district_id" }, "operation": "=", "value": "{{$_GET.district_id}}" }] },
          { "condition": "AND", "conditional": "{{$_GET.school_id}}", "rules": [{ "data": { "table": "m", "column": "origin_school_id" }, "operation": "=", "value": "{{$_GET.school_id}}" }] },
          { "condition": "AND", "conditional": "{{$_GET.status_code}}", "rules": [{ "data": { "table": "m", "column": "current_status_code" }, "operation": "=", "value": "{{$_GET.status_code}}" }] },
          { "condition": "AND", "conditional": "{{requester_type}}", "rules": [{ "data": { "table": "m", "column": "requester_type" }, "operation": "=", "value": "{{requester_type}}" }] },
          { "condition": "AND", "conditional": "{{assignment_filter == 'UNASSIGNED'}}", "rules": [{ "data": { "table": "m", "column": "active_assignment_id" }, "operator": "is_null" }] },
          { "condition": "AND", "conditional": "{{assignment_filter == 'ASSIGNED'}}", "rules": [{ "data": { "table": "m", "column": "active_assignment_id" }, "operator": "is_not_null" }] },
          { "condition": "AND", "conditional": "{{$_GET.assigned_to_user_id}}", "rules": [{ "data": { "table": "m", "column": "assigned_to_user_id" }, "operation": "=", "value": "{{$_GET.assigned_to_user_id}}" }] },
          { "condition": "OR", "conditional": "{{$_GET.search}}", "rules": [
            { "data": { "table": "m", "column": "ticket_number" }, "operator": "contains", "value": "{{$_GET.search}}" },
            { "data": { "table": "dv", "column": "serial_number" }, "operator": "contains", "value": "{{$_GET.search}}" },
            { "data": { "table": "dv", "column": "asset_tag" }, "operator": "contains", "value": "{{$_GET.search}}" }
          ] },
          { "condition": "OR", "rules": [
            { "condition": "AND", "conditional": "{{permission.bypass == 'SUPER_ADMIN' || scope_context.has_national_scope}}", "rules": [{ "data": { "table": "m", "column": "ticket_id" }, "operation": ">", "value": 0 }] },
            { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length > 0}}", "rules": [{ "data": { "table": "m", "column": "origin_district_id" }, "operation": "in", "value": "{{scope_context.districts.flatten('id')}}" }] },
            { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length == 0 && scope_context.schools.length > 0}}", "rules": [{ "data": { "table": "m", "column": "origin_school_id" }, "operation": "in", "value": "{{scope_context.schools.flatten('id')}}" }] },
            { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length == 0 && scope_context.schools.length == 0}}", "rules": [{ "data": { "table": "m", "column": "ticket_id" }, "operation": "=", "value": -1 }] }
          ] }
        ]
      } } } },
      { "name": "tickets", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": {
        "table": { "name": "v_ticket_operational_metrics", "alias": "m" },
        "columns": [
          { "table": "m", "column": "ticket_id" }, { "table": "m", "column": "ticket_number" }, { "table": "m", "column": "device_id" },
          { "table": "dv", "column": "serial_number" }, { "table": "dv", "column": "asset_tag" },
          { "table": "m", "column": "origin_district_id" }, { "table": "d", "column": "name", "alias": "origin_district_name" },
          { "table": "m", "column": "origin_school_id" }, { "table": "s", "column": "name", "alias": "origin_school_name" },
          { "table": "m", "column": "requester_type" }, { "table": "m", "column": "current_status_code" }, { "table": "m", "column": "current_status_name" },
          { "table": "m", "column": "is_terminal" }, { "table": "m", "column": "submitted_at" }, { "table": "m", "column": "ticket_age_minutes" }, { "table": "m", "column": "current_status_age_minutes" },
          { "table": "assignee", "column": "display_name", "alias": "assigned_to_display_name" }, { "table": "m", "column": "assigned_at" }, { "table": "m", "column": "assignment_age_minutes" },
          { "table": "m", "column": "first_diagnosed_at" }, { "table": "m", "column": "time_to_first_diagnosis_minutes" }, { "table": "m", "column": "first_approved_at" }, { "table": "m", "column": "time_to_approval_minutes" }
        ],
        "joins": [
          { "table": "devices", "alias": "dv", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "dv", "column": "id", "operation": "=", "value": { "table": "m", "column": "device_id" } }] } },
          { "table": "districts", "alias": "d", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "d", "column": "id", "operation": "=", "value": { "table": "m", "column": "origin_district_id" } }] } },
          { "table": "schools", "alias": "s", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "s", "column": "id", "operation": "=", "value": { "table": "m", "column": "origin_school_id" } }] } },
          { "table": "users", "alias": "assignee", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "assignee", "column": "id", "operation": "=", "value": { "table": "m", "column": "assigned_to_user_id" } }] } }
        ],
        "wheres": { "condition": "AND", "rules": [
          { "condition": "AND", "conditional": "{{$_GET.submitted_from}}", "rules": [{ "data": { "table": "m", "column": "submitted_at" }, "operation": ">=", "value": "{{$_GET.submitted_from}}" }] },
          { "condition": "AND", "conditional": "{{$_GET.submitted_to}}", "rules": [{ "data": { "table": "m", "column": "submitted_at" }, "operation": "<=", "value": "{{$_GET.submitted_to + ' 23:59:59'}}" }] },
          { "condition": "AND", "conditional": "{{$_GET.district_id}}", "rules": [{ "data": { "table": "m", "column": "origin_district_id" }, "operation": "=", "value": "{{$_GET.district_id}}" }] },
          { "condition": "AND", "conditional": "{{$_GET.school_id}}", "rules": [{ "data": { "table": "m", "column": "origin_school_id" }, "operation": "=", "value": "{{$_GET.school_id}}" }] },
          { "condition": "AND", "conditional": "{{$_GET.status_code}}", "rules": [{ "data": { "table": "m", "column": "current_status_code" }, "operation": "=", "value": "{{$_GET.status_code}}" }] },
          { "condition": "AND", "conditional": "{{requester_type}}", "rules": [{ "data": { "table": "m", "column": "requester_type" }, "operation": "=", "value": "{{requester_type}}" }] },
          { "condition": "AND", "conditional": "{{assignment_filter == 'UNASSIGNED'}}", "rules": [{ "data": { "table": "m", "column": "active_assignment_id" }, "operator": "is_null" }] },
          { "condition": "AND", "conditional": "{{assignment_filter == 'ASSIGNED'}}", "rules": [{ "data": { "table": "m", "column": "active_assignment_id" }, "operator": "is_not_null" }] },
          { "condition": "AND", "conditional": "{{$_GET.assigned_to_user_id}}", "rules": [{ "data": { "table": "m", "column": "assigned_to_user_id" }, "operation": "=", "value": "{{$_GET.assigned_to_user_id}}" }] },
          { "condition": "OR", "conditional": "{{$_GET.search}}", "rules": [
            { "data": { "table": "m", "column": "ticket_number" }, "operator": "contains", "value": "{{$_GET.search}}" },
            { "data": { "table": "dv", "column": "serial_number" }, "operator": "contains", "value": "{{$_GET.search}}" },
            { "data": { "table": "dv", "column": "asset_tag" }, "operator": "contains", "value": "{{$_GET.search}}" }
          ] },
          { "condition": "OR", "rules": [
            { "condition": "AND", "conditional": "{{permission.bypass == 'SUPER_ADMIN' || scope_context.has_national_scope}}", "rules": [{ "data": { "table": "m", "column": "ticket_id" }, "operation": ">", "value": 0 }] },
            { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length > 0}}", "rules": [{ "data": { "table": "m", "column": "origin_district_id" }, "operation": "in", "value": "{{scope_context.districts.flatten('id')}}" }] },
            { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length == 0 && scope_context.schools.length > 0}}", "rules": [{ "data": { "table": "m", "column": "origin_school_id" }, "operation": "in", "value": "{{scope_context.schools.flatten('id')}}" }] },
            { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length == 0 && scope_context.schools.length == 0}}", "rules": [{ "data": { "table": "m", "column": "ticket_id" }, "operation": "=", "value": -1 }] }
          ] }
        ] },
        "orders": [{ "table": "m", "column": "submitted_at", "direction": "desc" }, { "table": "m", "column": "ticket_id", "direction": "desc" }],
        "limit": "{{page_size}}", "offset": "{{(page - 1) * page_size}}"
      } } },
      { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "tickets": "{{tickets}}", "page": "{{page}}", "page_size": "{{page_size}}", "total": "{{total}}", "total_pages": "{{ceil(total / page_size)}}", "assignment_filter": "{{assignment_filter}}" } } }
    ],
    "catch": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Operational ticket report could not be loaded." } } }]
  }
}
