{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "tickets.view" } }, "output": true },
    { "name": "statuses", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_statuses", "columns": [{ "column": "id" }, { "column": "code" }, { "column": "name" }, { "column": "is_terminal" }, { "column": "sort_order" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "is_active" }, "operation": "=", "value": 1 }] }, "orders": [{ "column": "sort_order", "direction": "asc" }] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "statuses": "{{statuses}}" } } }
  ], "catch": { "steps": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Ticket status options could not be loaded." } } }] } }
}
