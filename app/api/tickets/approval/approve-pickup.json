{
  "settings": { "options": { "method": "post", "nocsrf": true } },
  "meta": { "$_POST": [{ "name": "ticket_id", "type": "number" }, { "name": "decision_note", "type": "text" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "tickets.approve_pickup" } }, "output": true },
    { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "name": "decision_note", "module": "core", "action": "setvalue", "options": { "key": "decision_note", "value": "{{($_POST.decision_note || '').trim() || null}}" } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.ticket_id || $_POST.ticket_id < 1 || (decision_note && decision_note.length() > 20000)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Provide a valid ticket and keep the decision note within 20,000 characters." } } }] } } },
    { "name": "ticket", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "tickets", "alias": "t" }, "columns": [{ "table": "t", "column": "id" }, { "table": "t", "column": "ticket_number" }, { "table": "t", "column": "origin_school_id" }, { "table": "t", "column": "origin_district_id" }, { "table": "ts", "column": "code", "alias": "status_code" }], "joins": [{ "table": "ticket_statuses", "alias": "ts", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ts", "column": "id", "operation": "=", "value": { "table": "t", "column": "current_status_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "t", "column": "id" }, "operation": "=", "value": "{{$_POST.ticket_id}}" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!ticket.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Ticket was not found." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.districts.flatten('id').contains(ticket.origin_district_id)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{ticket.status_code != 'SUBMITTED'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "Only submitted tickets can be approved for pickup." } } }] } } },
    { "name": "approval_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "submitted_status", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_statuses", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "SUBMITTED" }] } } } },
      { "name": "approved_status", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_statuses", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "APPROVED_FOR_PICKUP" }] } } } },
      { "name": "current_ticket", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "tickets", "columns": [{ "column": "id" }, { "column": "ticket_number" }, { "column": "current_status_id" }, { "column": "origin_school_id" }, { "column": "origin_district_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{ticket.id}}" }] } } } },
      { "name": "origin_school", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "schools", "columns": [{ "column": "id" }, { "column": "name" }, { "column": "district_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{current_ticket.origin_school_id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{current_ticket.current_status_id != submitted_status.id || !approved_status.id || !origin_school.id || origin_school.district_id != current_ticket.origin_district_id || current_ticket.origin_district_id != ticket.origin_district_id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P6C_APPROVAL_STATE_CHANGED" } }] } } },
      { "name": "diagnoses", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_diagnoses", "columns": [{ "column": "id" }, { "column": "diagnosed_at" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "ticket_id" }, "operation": "=", "value": "{{ticket.id}}" }] }, "orders": [{ "column": "diagnosed_at", "direction": "desc" }, { "column": "id", "direction": "desc" }] } } },
      { "name": "latest_submitted_history", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_status_history", "columns": [{ "column": "id" }, { "column": "changed_at" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "ticket_id" }, "operation": "=", "value": "{{ticket.id}}" }, { "data": { "column": "to_status_id" }, "operation": "=", "value": "{{submitted_status.id}}" }] }, "orders": [{ "column": "changed_at", "direction": "desc" }, { "column": "id", "direction": "desc" }] } } },
      { "name": "existing_approvals", "module": "dbconnector", "action": "count", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_district_approvals", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "ticket_id" }, "operation": "=", "value": "{{ticket.id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{diagnoses.length == 0 || latest_submitted_history.length == 0 || diagnoses.first().diagnosed_at <= latest_submitted_history.first().changed_at || existing_approvals > 0}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P6C_APPROVAL_PREREQUISITE_FAILED" } }] } } },
      { "name": "insert_approval", "module": "dbupdater", "action": "insert", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_district_approvals", "values": [{ "column": "ticket_id", "value": "{{ticket.id}}" }, { "column": "decision", "value": "APPROVED" }, { "column": "decision_note", "value": "{{decision_note}}" }, { "column": "decided_by_user_id", "value": "{{identity}}" }, { "column": "decided_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss')}}" }] } } },
      { "name": "insert_history", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "ticket_status_history", "values": [{ "column": "ticket_id", "value": "{{ticket.id}}" }, { "column": "from_status_id", "value": "{{submitted_status.id}}" }, { "column": "to_status_id", "value": "{{approved_status.id}}" }, { "column": "changed_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss')}}" }, { "column": "changed_by_user_id", "value": "{{identity}}" }] } } },
      { "name": "update_status", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "tickets", "values": [{ "column": "current_status_id", "value": "{{approved_status.id}}" }, { "column": "updated_by_user_id", "value": "{{identity}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{ticket.id}}" }, { "data": { "column": "current_status_id" }, "operation": "=", "value": "{{submitted_status.id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{update_status.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P6C_APPROVAL_STATE_CHANGED" } }] } } },
      { "name": "audit_approval", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "ticket_approved_for_pickup" }, { "column": "module", "value": "tickets" }, { "column": "entity_type", "value": "ticket_district_approval" }, { "column": "entity_id", "value": "{{insert_approval.identity}}" }, { "column": "description", "value": "{{'Approved ' + ticket.ticket_number + ' for pickup at ' + origin_school.name}}" }] } } }
      ,{ "name": "sla_pickup_start", "module": "core", "action": "exec", "output": true, "options": { "exec": "sla_start", "params": { "policy_code": "PICKUP", "idempotency_key": "{{'PICKUP:TICKET:' + ticket.id}}", "ticket_id": "{{ticket.id}}", "ticket_number": "{{ticket.ticket_number}}", "logistics_case_id": null, "device_id": null, "effective_device_id": null, "source_workflow": "PICKUP", "source_entity_type": "ticket_district_approval", "source_entity_id": "{{insert_approval.identity}}", "started_at": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss.SSS')}}", "actor_user_id": "{{identity}}" } } }
    ] } } },
    { "name": "notify_ticket_approved", "module": "core", "action": "exec", "options": { "exec": "notification_from_workflow", "params": { "event_type_code": "TICKET_APPROVED_FOR_PICKUP", "ticket_id": "{{ticket.id}}", "source_id": "{{insert_approval.identity}}", "actor_user_id": "{{identity}}" } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "ticket_id": "{{ticket.id}}", "approval_id": "{{insert_approval.identity}}", "status": "APPROVED_FOR_PICKUP" } } }
  ], "catch": [
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P6C_APPROVAL_STATE_CHANGED'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "Ticket changed during approval. Reload and try again." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P6C_APPROVAL_PREREQUISITE_FAILED'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "A current School IT diagnosis is required before approval." } } }] } } },
    { "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Ticket approval could not be recorded." } } }
  ] }
}
