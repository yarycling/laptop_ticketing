{
  "settings": { "options": { "method": "post", "nocsrf": true } },
  "meta": { "$_POST": [{ "name": "ticket_id", "type": "number" }, { "name": "reason", "type": "text" }] },
  "exec": { "steps": [
    { "name": "view_permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "tickets.view" } }, "output": true },
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "tickets.assign" } }, "output": true },
    { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "name": "reason", "module": "core", "action": "setvalue", "options": { "key": "reason", "value": "{{($_POST.reason || '').trim()}}" } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.ticket_id || $_POST.ticket_id < 1 || !reason || reason.length() > 500}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Provide a valid ticket and a reason up to 500 characters." } } }] } } },
    { "name": "manager_roles", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "user_roles", "alias": "ur" }, "columns": [{ "table": "r", "column": "name" }], "joins": [{ "table": "roles", "alias": "r", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "r", "column": "id", "operation": "=", "value": { "table": "ur", "column": "role_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "ur", "column": "user_id" }, "operation": "=", "value": "{{identity}}" }] } } } },
    { "name": "ticket", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "tickets", "alias": "t" }, "columns": [{ "table": "t", "column": "id" }, { "table": "t", "column": "ticket_number" }, { "table": "t", "column": "origin_school_id" }, { "table": "t", "column": "origin_district_id" }, { "table": "ts", "column": "code", "alias": "status_code" }], "joins": [{ "table": "ticket_statuses", "alias": "ts", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ts", "column": "id", "operation": "=", "value": { "table": "t", "column": "current_status_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "t", "column": "id" }, "operation": "=", "value": "{{$_POST.ticket_id}}" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!ticket.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Ticket was not found." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{ticket.status_code != 'SUBMITTED' && ticket.status_code != 'NEEDS_CLARIFICATION' && ticket.status_code != 'APPROVED_FOR_PICKUP'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "Assignments are unavailable for this ticket status." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !((manager_roles.flatten('name').contains('SCHOOL_ADMINISTRATOR') && scope_context.schools.flatten('id').contains(ticket.origin_school_id)) || (manager_roles.flatten('name').contains('ICT_DISTRICT_COORDINATOR') && scope_context.districts.flatten('id').contains(ticket.origin_district_id)))}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "name": "release_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "current_ticket", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "tickets", "alias": "t" }, "columns": [{ "table": "t", "column": "id" }, { "table": "t", "column": "origin_school_id" }, { "table": "t", "column": "origin_district_id" }, { "table": "ts", "column": "code", "alias": "status_code" }], "joins": [{ "table": "ticket_statuses", "alias": "ts", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ts", "column": "id", "operation": "=", "value": { "table": "t", "column": "current_status_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "t", "column": "id" }, "operation": "=", "value": "{{ticket.id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!current_ticket.id || (current_ticket.status_code != 'SUBMITTED' && current_ticket.status_code != 'NEEDS_CLARIFICATION' && current_ticket.status_code != 'APPROVED_FOR_PICKUP') || (permission.bypass != 'SUPER_ADMIN' && !((scope_context.schools.flatten('id').contains(current_ticket.origin_school_id)) || (scope_context.districts.flatten('id').contains(current_ticket.origin_district_id))))}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P6D_TICKET_STATE_CHANGED" } }] } } },
      { "name": "active_assignment", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_assignments", "columns": [{ "column": "id" }, { "column": "assigned_to_user_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "ticket_id" }, "operation": "=", "value": "{{ticket.id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "ended_at" }, "operator": "is_null" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!active_assignment.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P6D_NO_ACTIVE_ASSIGNMENT" } }] } } },
      { "name": "close_assignment", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_assignments", "values": [{ "column": "ended_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss')}}" }, { "column": "ended_by_user_id", "value": "{{identity}}" }, { "column": "end_reason", "value": "{{reason}}" }, { "column": "active_record_key", "value": null }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{active_assignment.id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "ended_at" }, "operator": "is_null" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{close_assignment.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P6D_NO_ACTIVE_ASSIGNMENT" } }] } } },
      { "name": "audit_release", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "ticket_assignment_released" }, { "column": "module", "value": "tickets" }, { "column": "entity_type", "value": "ticket_assignment" }, { "column": "entity_id", "value": "{{active_assignment.id}}" }, { "column": "description", "value": "{{'Released ' + ticket.ticket_number + ' to the unassigned queue'}}" }] } } }
    ] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "ticket_id": "{{ticket.id}}", "released_assignment_id": "{{active_assignment.id}}" } } }
  ], "catch": [
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P6D_TICKET_STATE_CHANGED'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "Ticket status changed. Reload before releasing." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P6D_NO_ACTIVE_ASSIGNMENT'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "This ticket no longer has an active owner. Reload and try again." } } }] } } },
    { "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Ticket assignment could not be released." } } }
  ] }
}
