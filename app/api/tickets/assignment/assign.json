{
  "settings": { "options": { "method": "post", "nocsrf": true } },
  "meta": { "$_POST": [{ "name": "ticket_id", "type": "number" }, { "name": "assigned_to_user_id", "type": "number" }] },
  "exec": { "steps": [
    { "name": "view_permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "tickets.view" } }, "output": true },
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "tickets.assign" } }, "output": true },
    { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.ticket_id || $_POST.ticket_id < 1 || !$_POST.assigned_to_user_id || $_POST.assigned_to_user_id < 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Select a valid ticket and technical officer." } } }] } } },
    { "name": "manager_roles", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "user_roles", "alias": "ur" }, "columns": [{ "table": "r", "column": "name" }], "joins": [{ "table": "roles", "alias": "r", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "r", "column": "id", "operation": "=", "value": { "table": "ur", "column": "role_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "ur", "column": "user_id" }, "operation": "=", "value": "{{identity}}" }] } } } },
    { "name": "ticket", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "tickets", "alias": "t" }, "columns": [{ "table": "t", "column": "id" }, { "table": "t", "column": "ticket_number" }, { "table": "t", "column": "origin_school_id" }, { "table": "t", "column": "origin_district_id" }, { "table": "ts", "column": "code", "alias": "status_code" }], "joins": [{ "table": "ticket_statuses", "alias": "ts", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ts", "column": "id", "operation": "=", "value": { "table": "t", "column": "current_status_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "t", "column": "id" }, "operation": "=", "value": "{{$_POST.ticket_id}}" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!ticket.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Ticket was not found." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{ticket.status_code != 'SUBMITTED' && ticket.status_code != 'NEEDS_CLARIFICATION' && ticket.status_code != 'APPROVED_FOR_PICKUP'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "Assignments are unavailable for this ticket status." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !((manager_roles.flatten('name').contains('SCHOOL_ADMINISTRATOR') && scope_context.schools.flatten('id').contains(ticket.origin_school_id)) || (manager_roles.flatten('name').contains('ICT_DISTRICT_COORDINATOR') && scope_context.districts.flatten('id').contains(ticket.origin_district_id)))}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "name": "assignee", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "users", "alias": "u" }, "columns": [{ "table": "u", "column": "id" }, { "table": "u", "column": "display_name" }], "joins": [
      { "table": "user_roles", "alias": "ur", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ur", "column": "user_id", "operation": "=", "value": { "table": "u", "column": "id" } }] } },
      { "table": "roles", "alias": "r", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "r", "column": "id", "operation": "=", "value": { "table": "ur", "column": "role_id" } }] } },
      { "table": "user_school_scopes", "alias": "uss", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "uss", "column": "user_id", "operation": "=", "value": { "table": "u", "column": "id" } }] } },
      { "table": "user_district_scopes", "alias": "uds", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "uds", "column": "user_id", "operation": "=", "value": { "table": "u", "column": "id" } }] } },
      { "table": "user_national_scopes", "alias": "uns", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "uns", "column": "user_id", "operation": "=", "value": { "table": "u", "column": "id" } }] } }
    ], "wheres": { "condition": "AND", "rules": [
      { "data": { "table": "u", "column": "id" }, "operation": "=", "value": "{{$_POST.assigned_to_user_id}}" },
      { "data": { "table": "u", "column": "status" }, "operation": "=", "value": "active" },
      { "data": { "table": "r", "column": "name" }, "operation": "=", "value": "ICT_TECHNICAL_OFFICER" },
      { "condition": "OR", "rules": [
        { "condition": "AND", "rules": [{ "data": { "table": "uss", "column": "status" }, "operation": "=", "value": "active" }, { "data": { "table": "uss", "column": "school_id" }, "operation": "=", "value": "{{ticket.origin_school_id}}" }] },
        { "condition": "AND", "rules": [{ "data": { "table": "uds", "column": "status" }, "operation": "=", "value": "active" }, { "data": { "table": "uds", "column": "district_id" }, "operation": "=", "value": "{{ticket.origin_district_id}}" }] },
        { "data": { "table": "uns", "column": "status" }, "operation": "=", "value": "active" }
      ] }
    ] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!assignee.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The selected technical officer is inactive or outside this ticket's origin scope." } } }] } } },
    { "name": "assign_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "current_ticket", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "tickets", "alias": "t" }, "columns": [{ "table": "t", "column": "id" }, { "table": "t", "column": "origin_school_id" }, { "table": "t", "column": "origin_district_id" }, { "table": "ts", "column": "code", "alias": "status_code" }], "joins": [{ "table": "ticket_statuses", "alias": "ts", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ts", "column": "id", "operation": "=", "value": { "table": "t", "column": "current_status_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "t", "column": "id" }, "operation": "=", "value": "{{ticket.id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!current_ticket.id || (current_ticket.status_code != 'SUBMITTED' && current_ticket.status_code != 'NEEDS_CLARIFICATION' && current_ticket.status_code != 'APPROVED_FOR_PICKUP') || (permission.bypass != 'SUPER_ADMIN' && !((scope_context.schools.flatten('id').contains(current_ticket.origin_school_id)) || (scope_context.districts.flatten('id').contains(current_ticket.origin_district_id))))}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P6D_TICKET_STATE_CHANGED" } }] } } },
      { "name": "current_assignee", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "users", "alias": "u" }, "columns": [{ "table": "u", "column": "id" }], "joins": [
        { "table": "user_roles", "alias": "ur", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ur", "column": "user_id", "operation": "=", "value": { "table": "u", "column": "id" } }] } },
        { "table": "roles", "alias": "r", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "r", "column": "id", "operation": "=", "value": { "table": "ur", "column": "role_id" } }] } },
        { "table": "user_school_scopes", "alias": "uss", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "uss", "column": "user_id", "operation": "=", "value": { "table": "u", "column": "id" } }] } },
        { "table": "user_district_scopes", "alias": "uds", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "uds", "column": "user_id", "operation": "=", "value": { "table": "u", "column": "id" } }] } },
        { "table": "user_national_scopes", "alias": "uns", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "uns", "column": "user_id", "operation": "=", "value": { "table": "u", "column": "id" } }] } }
      ], "wheres": { "condition": "AND", "rules": [
        { "data": { "table": "u", "column": "id" }, "operation": "=", "value": "{{assignee.id}}" },
        { "data": { "table": "u", "column": "status" }, "operation": "=", "value": "active" },
        { "data": { "table": "r", "column": "name" }, "operation": "=", "value": "ICT_TECHNICAL_OFFICER" },
        { "condition": "OR", "rules": [
          { "condition": "AND", "rules": [{ "data": { "table": "uss", "column": "status" }, "operation": "=", "value": "active" }, { "data": { "table": "uss", "column": "school_id" }, "operation": "=", "value": "{{current_ticket.origin_school_id}}" }] },
          { "condition": "AND", "rules": [{ "data": { "table": "uds", "column": "status" }, "operation": "=", "value": "active" }, { "data": { "table": "uds", "column": "district_id" }, "operation": "=", "value": "{{current_ticket.origin_district_id}}" }] },
          { "data": { "table": "uns", "column": "status" }, "operation": "=", "value": "active" }
        ] }
      ] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!current_assignee.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P6D_ASSIGNEE_NO_LONGER_ELIGIBLE" } }] } } },
      { "name": "active_assignment", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_assignments", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "ticket_id" }, "operation": "=", "value": "{{ticket.id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "ended_at" }, "operator": "is_null" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{active_assignment.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P6D_TICKET_ALREADY_ASSIGNED" } }] } } },
      { "name": "insert_assignment", "module": "dbupdater", "action": "insert", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_assignments", "values": [{ "column": "ticket_id", "value": "{{ticket.id}}" }, { "column": "assigned_to_user_id", "value": "{{assignee.id}}" }, { "column": "assigned_by_user_id", "value": "{{identity}}" }, { "column": "assigned_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss')}}" }, { "column": "active_record_key", "value": 1 }] } } },
      { "name": "audit_assignment", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "ticket_assigned" }, { "column": "module", "value": "tickets" }, { "column": "entity_type", "value": "ticket_assignment" }, { "column": "entity_id", "value": "{{insert_assignment.identity}}" }, { "column": "description", "value": "{{'Assigned ' + ticket.ticket_number + ' to ' + assignee.display_name}}" }] } } }
    ] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "ticket_id": "{{ticket.id}}", "assignment_id": "{{insert_assignment.identity}}" } } }
  ], "catch": [
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P6D_TICKET_STATE_CHANGED'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "Ticket status changed. Reload before assigning." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P6D_ASSIGNEE_NO_LONGER_ELIGIBLE'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The selected technical officer is no longer eligible. Reload and try again." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P6D_TICKET_ALREADY_ASSIGNED' || $_EXCEPTION.code == 'ER_DUP_ENTRY'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "This ticket already has an active owner. Reload it before assigning." } } }] } } },
    { "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Ticket assignment could not be completed." } } }
  ] }
}
