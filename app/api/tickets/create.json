{
  "settings": { "options": { "method": "post", "nocsrf": true } },
  "meta": { "$_POST": [{ "name": "device_id", "type": "number" }, { "name": "requester_type", "type": "text" }, { "name": "requester_name", "type": "text" }, { "name": "requester_email", "type": "text" }, { "name": "requester_phone", "type": "text" }, { "name": "subject", "type": "text" }, { "name": "description", "type": "text" }] },
  "exec": { "steps": [
    { "name": "require_permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "tickets.create" } }, "output": true },
    { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "name": "requester_type", "module": "core", "action": "setvalue", "options": { "key": "requester_type", "value": "{{($_POST.requester_type || '').trim().uppercase()}}" } },
    { "name": "requester_name", "module": "core", "action": "setvalue", "options": { "key": "requester_name", "value": "{{($_POST.requester_name || '').trim()}}" } },
    { "name": "requester_email", "module": "core", "action": "setvalue", "options": { "key": "requester_email", "value": "{{($_POST.requester_email || '').trim() || null}}" } },
    { "name": "requester_phone", "module": "core", "action": "setvalue", "options": { "key": "requester_phone", "value": "{{($_POST.requester_phone || '').trim() || null}}" } },
    { "name": "subject", "module": "core", "action": "setvalue", "options": { "key": "subject", "value": "{{($_POST.subject || '').trim()}}" } },
    { "name": "description", "module": "core", "action": "setvalue", "options": { "key": "description", "value": "{{($_POST.description || '').trim()}}" } },
    { "name": "email_validation", "module": "validator", "action": "validate", "options": { "noError": true, "data": [{ "name": "requester_email", "value": "{{requester_email}}", "rules": { "core:email": { "message": "Enter a valid requester email address." } } }] } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.device_id || $_POST.device_id < 1 || !requester_name || requester_name.length() > 220 || !subject || subject.length() > 220 || !description || description.length() > 20000 || (requester_email && (requester_email.length() > 254 || !email_validation)) || (requester_phone && requester_phone.length() > 40) || (requester_type != 'STUDENT' && requester_type != 'PARENT' && requester_type != 'TEACHER' && requester_type != 'STAFF')}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Check the requester type, required fields, email, and field lengths." } } }] } } },
    { "name": "device", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": {
      "table": { "name": "devices", "alias": "dv" },
      "columns": [{ "table": "dv", "column": "id" }, { "table": "dv", "column": "serial_number" }, { "table": "cc", "column": "current_custody_level" }, { "table": "cc", "column": "district_id" }, { "table": "cc", "column": "school_id" }, { "table": "cc", "column": "student_id" }, { "table": "ls", "column": "code", "alias": "lifecycle_code" }, { "table": "d", "column": "name", "alias": "district_name" }, { "table": "s", "column": "name", "alias": "school_name" }, { "table": "s", "column": "district_id", "alias": "school_district_id" }, { "table": "s", "column": "status", "alias": "school_status" }],
      "joins": [
        { "table": "device_lifecycle_statuses", "alias": "ls", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ls", "column": "id", "operation": "=", "value": { "table": "dv", "column": "lifecycle_status_id" } }] } },
        { "table": "v_device_current_custody", "alias": "cc", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "cc", "column": "device_id", "operation": "=", "value": { "table": "dv", "column": "id" } }] } },
        { "table": "districts", "alias": "d", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "d", "column": "id", "operation": "=", "value": { "table": "cc", "column": "district_id" } }] } },
        { "table": "schools", "alias": "s", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "s", "column": "id", "operation": "=", "value": { "table": "cc", "column": "school_id" } }] } }
      ], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "dv", "column": "id" }, "operation": "=", "value": "{{$_POST.device_id}}" }] }
    } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!device.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "The selected device was not found." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!device.school_id || !device.district_id || (device.current_custody_level != 'SCHOOL' && device.current_custody_level != 'STUDENT')}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "Only devices currently at a school or assigned to a student can be reported." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{device.school_district_id != device.district_id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The current device school and district lineage is inconsistent." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{(device.current_custody_level == 'SCHOOL' && device.lifecycle_code != 'AVAILABLE') || (device.current_custody_level == 'STUDENT' && device.lifecycle_code != 'ASSIGNED')}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The device custody and lifecycle state are inconsistent. No changes were made." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{device.school_status != 'active'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "Tickets can only be created for devices at an active school." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{require_permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && !scope_context.districts.flatten('id').contains(device.district_id) && !scope_context.schools.flatten('id').contains(device.school_id)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "name": "duplicate_active_ticket", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": {
      "table": { "name": "tickets", "alias": "t" },
      "columns": [{ "table": "t", "column": "id" }, { "table": "t", "column": "ticket_number" }],
      "joins": [{ "table": "ticket_statuses", "alias": "ts", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ts", "column": "id", "operation": "=", "value": { "table": "t", "column": "current_status_id" } }] } }],
      "wheres": { "condition": "AND", "rules": [
        { "data": { "table": "t", "column": "device_id" }, "operation": "=", "value": "{{device.id}}" },
        { "data": { "table": "t", "column": "requester_type" }, "operation": "=", "value": "{{requester_type}}" },
        { "data": { "table": "t", "column": "requester_name" }, "operation": "=", "value": "{{requester_name}}" },
        { "data": { "table": "t", "column": "subject" }, "operation": "=", "value": "{{subject}}" },
        { "data": { "table": "t", "column": "description" }, "operation": "=", "value": "{{description}}" },
        { "data": { "table": "ts", "column": "is_terminal" }, "operation": "=", "value": 0 }
      ] }
    } } },
    { "module": "core", "action": "condition", "options": { "if": "{{duplicate_active_ticket.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "An identical active ticket has already been submitted for this device." } } }] } } },
    { "name": "submitted_status", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_statuses", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "SUBMITTED" }, { "data": { "column": "is_active" }, "operation": "=", "value": 1 }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!submitted_status.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Ticket intake is temporarily unavailable." } } }] } } },
    { "name": "ticket_uuid", "module": "core", "action": "randomUUID", "output": true, "options": {} },
    { "name": "save_ticket", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "custody_recheck", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "devices", "alias": "dv" }, "columns": [{ "table": "dv", "column": "id" }, { "table": "ls", "column": "code", "alias": "lifecycle_code" }, { "table": "cc", "column": "current_custody_level" }, { "table": "cc", "column": "district_id" }, { "table": "cc", "column": "school_id" }, { "table": "cc", "column": "student_id" }], "joins": [{ "table": "device_lifecycle_statuses", "alias": "ls", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ls", "column": "id", "operation": "=", "value": { "table": "dv", "column": "lifecycle_status_id" } }] } }, { "table": "v_device_current_custody", "alias": "cc", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "cc", "column": "device_id", "operation": "=", "value": { "table": "dv", "column": "id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "dv", "column": "id" }, "operation": "=", "value": "{{device.id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{custody_recheck.current_custody_level != device.current_custody_level || custody_recheck.district_id != device.district_id || custody_recheck.school_id != device.school_id || custody_recheck.student_id != device.student_id || custody_recheck.lifecycle_code != device.lifecycle_code}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "PHASE6B_DEVICE_CUSTODY_CHANGED" } }] } } },
      { "name": "create_ticket", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "tickets", "values": [{ "column": "ticket_number", "value": "{{'TMP-' + ticket_uuid}}" }, { "column": "device_id", "value": "{{device.id}}" }, { "column": "origin_district_id", "value": "{{device.district_id}}" }, { "column": "origin_school_id", "value": "{{device.school_id}}" }, { "column": "origin_student_id", "value": "{{device.current_custody_level == 'STUDENT' ? device.student_id : null}}" }, { "column": "requester_type", "value": "{{requester_type}}" }, { "column": "requester_name", "value": "{{requester_name}}" }, { "column": "requester_email", "value": "{{requester_email}}" }, { "column": "requester_phone", "value": "{{requester_phone}}" }, { "column": "subject", "value": "{{subject}}" }, { "column": "description", "value": "{{description}}" }, { "column": "current_status_id", "value": "{{submitted_status.id}}" }, { "column": "created_by_user_id", "value": "{{identity}}" }, { "column": "updated_by_user_id", "value": "{{identity}}" }, { "column": "submitted_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss')}}" }] } } },
      { "name": "finalize_ticket_number", "module": "dbupdater", "action": "update", "options": { "connection": "db", "sql": { "table": "tickets", "values": [{ "column": "ticket_number", "value": "{{'TKT' + create_ticket.identity.padNumber(8)}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{create_ticket.identity}}" }] } } } },
      { "name": "initial_status_history", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "ticket_status_history", "values": [{ "column": "ticket_id", "value": "{{create_ticket.identity}}" }, { "column": "from_status_id", "value": null }, { "column": "to_status_id", "value": "{{submitted_status.id}}" }, { "column": "changed_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss')}}" }, { "column": "changed_by_user_id", "value": "{{identity}}" }] } } },
      { "name": "ticket_created_audit", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "ticket_created" }, { "column": "module", "value": "tickets" }, { "column": "entity_type", "value": "ticket" }, { "column": "entity_id", "value": "{{create_ticket.identity}}" }, { "column": "description", "value": "{{'Created ticket TKT' + create_ticket.identity.padNumber(8) + ' for device ' + device.serial_number + ' at ' + device.school_name}}" }] } } }
    ] } } },
    { "name": "notify_ticket_submitted", "module": "core", "action": "exec", "options": { "exec": "notification_from_workflow", "params": { "event_type_code": "TICKET_SUBMITTED", "ticket_id": "{{create_ticket.identity}}", "source_id": "{{create_ticket.identity}}", "actor_user_id": "{{identity}}" } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "ticket_id": "{{create_ticket.identity}}", "ticket_number": "{{'TKT' + create_ticket.identity.padNumber(8)}}" } } }
  ], "catch": [
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'PHASE6B_DEVICE_CUSTODY_CHANGED'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The device custody changed while the ticket was being created. Please reload and try again." } } }] } } },
    { "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Ticket could not be created." } } }
  ]
  }
}
