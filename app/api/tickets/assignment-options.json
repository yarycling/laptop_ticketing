{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "meta": { "$_GET": [{ "name": "ticket_id", "type": "number" }] },
  "exec": { "steps": [
    { "name": "view_permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "tickets.view" } }, "output": true },
    { "name": "assign_permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "tickets.assign" } }, "output": true },
    { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_GET.ticket_id || $_GET.ticket_id < 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "A valid ticket ID is required." } } }] } } },
    { "name": "manager_roles", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "user_roles", "alias": "ur" }, "columns": [{ "table": "r", "column": "name" }], "joins": [{ "table": "roles", "alias": "r", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "r", "column": "id", "operation": "=", "value": { "table": "ur", "column": "role_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "ur", "column": "user_id" }, "operation": "=", "value": "{{identity}}" }] } } } },
    { "name": "ticket", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "tickets", "alias": "t" }, "columns": [{ "table": "t", "column": "id" }, { "table": "t", "column": "ticket_number" }, { "table": "t", "column": "origin_school_id" }, { "table": "t", "column": "origin_district_id" }, { "table": "ts", "column": "code", "alias": "status_code" }], "joins": [{ "table": "ticket_statuses", "alias": "ts", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ts", "column": "id", "operation": "=", "value": { "table": "t", "column": "current_status_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "t", "column": "id" }, "operation": "=", "value": "{{$_GET.ticket_id}}" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!ticket.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Ticket was not found." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{ticket.status_code != 'SUBMITTED' && ticket.status_code != 'NEEDS_CLARIFICATION' && ticket.status_code != 'APPROVED_FOR_PICKUP'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "Assignments are unavailable for this ticket status." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{view_permission.bypass != 'SUPER_ADMIN' && !((manager_roles.flatten('name').contains('SCHOOL_ADMINISTRATOR') && scope_context.schools.flatten('id').contains(ticket.origin_school_id)) || (manager_roles.flatten('name').contains('ICT_DISTRICT_COORDINATOR') && scope_context.districts.flatten('id').contains(ticket.origin_district_id)))}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "name": "active_assignment", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "ticket_assignments", "alias": "ta" }, "columns": [{ "table": "ta", "column": "assigned_to_user_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "ta", "column": "ticket_id" }, "operation": "=", "value": "{{ticket.id}}" }, { "data": { "table": "ta", "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "table": "ta", "column": "ended_at" }, "operator": "is_null" }] } } } },
    { "name": "technicians", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "users", "alias": "u" }, "distinct": true, "columns": [{ "table": "u", "column": "id", "alias": "user_id" }, { "table": "u", "column": "display_name" }, { "table": "u", "column": "username" }], "joins": [
      { "table": "user_roles", "alias": "ur", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ur", "column": "user_id", "operation": "=", "value": { "table": "u", "column": "id" } }] } },
      { "table": "roles", "alias": "r", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "r", "column": "id", "operation": "=", "value": { "table": "ur", "column": "role_id" } }] } },
      { "table": "user_school_scopes", "alias": "uss", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "uss", "column": "user_id", "operation": "=", "value": { "table": "u", "column": "id" } }] } },
      { "table": "user_district_scopes", "alias": "uds", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "uds", "column": "user_id", "operation": "=", "value": { "table": "u", "column": "id" } }] } },
      { "table": "user_national_scopes", "alias": "uns", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "uns", "column": "user_id", "operation": "=", "value": { "table": "u", "column": "id" } }] } }
    ], "wheres": { "condition": "AND", "rules": [
      { "data": { "table": "u", "column": "status" }, "operation": "=", "value": "active" },
      { "data": { "table": "r", "column": "name" }, "operation": "=", "value": "ICT_TECHNICAL_OFFICER" },
      { "condition": "OR", "rules": [
        { "condition": "AND", "rules": [{ "data": { "table": "uss", "column": "status" }, "operation": "=", "value": "active" }, { "data": { "table": "uss", "column": "school_id" }, "operation": "=", "value": "{{ticket.origin_school_id}}" }] },
        { "condition": "AND", "rules": [{ "data": { "table": "uds", "column": "status" }, "operation": "=", "value": "active" }, { "data": { "table": "uds", "column": "district_id" }, "operation": "=", "value": "{{ticket.origin_district_id}}" }] },
        { "data": { "table": "uns", "column": "status" }, "operation": "=", "value": "active" }
      ] },
      { "condition": "AND", "conditional": "{{active_assignment.assigned_to_user_id}}", "rules": [{ "data": { "table": "u", "column": "id" }, "operation": "!=", "value": "{{active_assignment.assigned_to_user_id}}" }] }
    ] }, "orders": [{ "table": "u", "column": "display_name", "direction": "asc" }] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "ticket_id": "{{ticket.id}}", "technicians": "{{technicians}}" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Assignment options could not be loaded." } } }] }
}
