{
  "settings": { "options": { "method": "post", "nocsrf": true } },
  "meta": { "$_POST": [{ "name": "ticket_id", "type": "number" }, { "name": "diagnosis_summary", "type": "text" }, { "name": "recommended_action", "type": "text" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "tickets.diagnose" } }, "output": true },
    { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "name": "summary", "module": "core", "action": "setvalue", "options": { "key": "summary", "value": "{{($_POST.diagnosis_summary || '').trim()}}" } },
    { "name": "recommended_action", "module": "core", "action": "setvalue", "options": { "key": "recommended_action", "value": "{{($_POST.recommended_action || '').trim() || null}}" } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.ticket_id || $_POST.ticket_id < 1 || !summary || summary.length() > 20000 || (recommended_action && recommended_action.length() > 500)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Enter a diagnosis summary and keep each field within its permitted length." } } }] } } },
    { "name": "ticket", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "tickets", "alias": "t" }, "columns": [{ "table": "t", "column": "id" }, { "table": "t", "column": "ticket_number" }, { "table": "t", "column": "origin_school_id" }, { "table": "t", "column": "origin_district_id" }, { "table": "ts", "column": "code", "alias": "status_code" }], "joins": [{ "table": "ticket_statuses", "alias": "ts", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ts", "column": "id", "operation": "=", "value": { "table": "t", "column": "current_status_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "t", "column": "id" }, "operation": "=", "value": "{{$_POST.ticket_id}}" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!ticket.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Ticket was not found." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.schools.flatten('id').contains(ticket.origin_school_id)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{ticket.status_code != 'SUBMITTED'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "Diagnosis can only be recorded for a submitted ticket." } } }] } } },
    { "name": "save_diagnosis", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "ticket_recheck", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "tickets", "alias": "t" }, "columns": [{ "table": "t", "column": "id" }, { "table": "t", "column": "ticket_number" }, { "table": "t", "column": "current_status_id" }, { "table": "ts", "column": "code", "alias": "status_code" }], "joins": [{ "table": "ticket_statuses", "alias": "ts", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ts", "column": "id", "operation": "=", "value": { "table": "t", "column": "current_status_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "t", "column": "id" }, "operation": "=", "value": "{{ticket.id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{ticket_recheck.status_code != 'SUBMITTED'}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P6C_DIAGNOSIS_STATUS_CHANGED" } }] } } },
      { "name": "insert_diagnosis", "module": "dbupdater", "action": "insert", "output": true, "options": { "connection": "db", "sql": { "table": "ticket_diagnoses", "values": [{ "column": "ticket_id", "value": "{{ticket_recheck.id}}" }, { "column": "diagnosis_summary", "value": "{{summary}}" }, { "column": "recommended_action", "value": "{{recommended_action}}" }, { "column": "diagnosed_by_user_id", "value": "{{identity}}" }] } } },
      { "name": "update_ticket_actor", "module": "dbupdater", "action": "update", "options": { "connection": "db", "sql": { "table": "tickets", "values": [{ "column": "updated_by_user_id", "value": "{{identity}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{ticket_recheck.id}}" }, { "data": { "column": "current_status_id" }, "operation": "=", "value": "{{ticket_recheck.current_status_id}}" }] } } } },
      { "name": "audit_diagnosis", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "ticket_diagnosed" }, { "column": "module", "value": "tickets" }, { "column": "entity_type", "value": "ticket_diagnosis" }, { "column": "entity_id", "value": "{{insert_diagnosis.identity}}" }, { "column": "description", "value": "{{'Recorded diagnosis for ' + ticket_recheck.ticket_number}}" }] } } }
    ] } } },
    { "name": "notify_district_approval_required", "module": "core", "action": "exec", "options": { "exec": "notification_from_workflow", "params": { "event_type_code": "DISTRICT_APPROVAL_REQUIRED", "ticket_id": "{{ticket.id}}", "source_id": "{{insert_diagnosis.identity}}", "actor_user_id": "{{identity}}" } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "diagnosis_id": "{{insert_diagnosis.identity}}", "ticket_id": "{{ticket.id}}" } } }
  ], "catch": [
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P6C_DIAGNOSIS_STATUS_CHANGED'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "Ticket status changed. Reload the ticket before recording diagnosis." } } }] } } },
    { "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Diagnosis could not be recorded." } } }
  ] }
}
