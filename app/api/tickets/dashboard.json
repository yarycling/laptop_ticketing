{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "meta": { "$_GET": [
    { "name": "submitted_from", "type": "text" }, { "name": "submitted_to", "type": "text" },
    { "name": "district_id", "type": "number" }, { "name": "school_id", "type": "number" },
    { "name": "status_code", "type": "text" }, { "name": "requester_type", "type": "text" }
  ] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "tickets.dashboard" } }, "output": true },
    { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "name": "date_validation", "module": "validator", "action": "validate", "options": { "noError": true, "data": [
      { "name": "submitted_from", "value": "{{$_GET.submitted_from}}", "rules": { "core:date": { "message": "Enter a valid start date." } } },
      { "name": "submitted_to", "value": "{{$_GET.submitted_to}}", "rules": { "core:date": { "message": "Enter a valid end date." } } }
    ] } },
    { "module": "core", "action": "condition", "options": { "if": "{{!date_validation || ($_GET.submitted_from && $_GET.submitted_to && $_GET.submitted_from > $_GET.submitted_to) || ($_GET.district_id && $_GET.district_id < 1) || ($_GET.school_id && $_GET.school_id < 1) || ($_GET.requester_type && $_GET.requester_type != 'STUDENT' && $_GET.requester_type != 'PARENT' && $_GET.requester_type != 'TEACHER' && $_GET.requester_type != 'STAFF')}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Check the dashboard date, location, and requester filters." } } }] } } },
    { "name": "metrics", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": {
