      "orders": [{ "table": "assignee", "column": "display_name", "direction": "asc" }]
    } } },
    { "name": "total_tickets", "module": "core", "action": "setvalue", "output": true, "options": { "key": "total_tickets", "value": "{{metrics.count()}}" } },
    { "name": "open_total", "module": "core", "action": "setvalue", "output": true, "options": { "key": "open_total", "value": "{{metrics.where('is_terminal','==',0).count()}}" } },
    { "name": "terminal_total", "module": "core", "action": "setvalue", "output": true, "options": { "key": "terminal_total", "value": "{{metrics.where('is_terminal','==',1).count()}}" } },
    { "name": "submitted", "module": "core", "action": "setvalue", "output": true, "options": { "key": "submitted", "value": "{{metrics.where('current_status_code','==','SUBMITTED').count()}}" } },
    { "name": "needs_clarification", "module": "core", "action": "setvalue", "output": true, "options": { "key": "needs_clarification", "value": "{{metrics.where('current_status_code','==','NEEDS_CLARIFICATION').count()}}" } },
    { "name": "approved_for_pickup", "module": "core", "action": "setvalue", "output": true, "options": { "key": "approved_for_pickup", "value": "{{metrics.where('current_status_code','==','APPROVED_FOR_PICKUP').count()}}" } },
    { "name": "assigned_open", "module": "core", "action": "setvalue", "output": true, "options": { "key": "assigned_open", "value": "{{metrics.where('is_terminal','==',0).where('assigned_to_user_id','!=',null).count()}}" } },
    { "name": "unassigned_open", "module": "core", "action": "setvalue", "output": true, "options": { "key": "unassigned_open", "value": "{{metrics.where('is_terminal','==',0).where('assigned_to_user_id','==',null).count()}}" } },
    { "name": "average_open_age_minutes", "module": "core", "action": "setvalue", "output": true, "options": { "key": "average_open_age_minutes", "value": "{{metrics.where('is_terminal','==',0).avg('ticket_age_minutes') == null ? null : floor(metrics.where('is_terminal','==',0).avg('ticket_age_minutes'))}}" } },
    { "name": "average_time_to_first_diagnosis_minutes", "module": "core", "action": "setvalue", "output": true, "options": { "key": "average_time_to_first_diagnosis_minutes", "value": "{{metrics.avg('time_to_first_diagnosis_minutes') == null ? null : floor(metrics.avg('time_to_first_diagnosis_minutes'))}}" } },
    { "name": "average_time_to_approval_minutes", "module": "core", "action": "setvalue", "output": true, "options": { "key": "average_time_to_approval_minutes", "value": "{{metrics.avg('time_to_approval_minutes') == null ? null : floor(metrics.avg('time_to_approval_minutes'))}}" } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "summary": { "total_tickets": "{{total_tickets}}", "open_total": "{{open_total}}", "terminal_total": "{{terminal_total}}", "submitted": "{{submitted}}", "needs_clarification": "{{needs_clarification}}", "approved_for_pickup": "{{approved_for_pickup}}", "assigned_open": "{{assigned_open}}", "unassigned_open": "{{unassigned_open}}", "average_open_age_minutes": "{{average_open_age_minutes}}", "average_time_to_first_diagnosis_minutes": "{{average_time_to_first_diagnosis_minutes}}", "average_time_to_approval_minutes": "{{average_time_to_approval_minutes}}" }, "metrics": "{{metrics}}", "status_breakdown": "{{status_breakdown}}", "district_breakdown": "{{district_breakdown}}", "school_breakdown": "{{school_breakdown}}", "requester_breakdown": "{{requester_breakdown}}", "workload": "{{workload}}" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Ticket dashboard could not be loaded." } } }] }
}
