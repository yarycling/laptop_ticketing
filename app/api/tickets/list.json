{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "meta": { "$_GET": [{ "name": "status_code", "type": "text" }, { "name": "district_id", "type": "number" }, { "name": "school_id", "type": "number" }, { "name": "requester_type", "type": "text" }, { "name": "search", "type": "text" }, { "name": "submitted_from", "type": "text" }, { "name": "submitted_to", "type": "text" }, { "name": "assignment_filter", "type": "text" }, { "name": "page", "type": "number" }, { "name": "page_size", "type": "number" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "tickets.view" } }, "output": true },
    { "name": "scope_context", "module": "core", "action": "exec", "options": { "exec": "security_get_scope_context", "params": {} }, "output": true },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "name": "assignment_filter", "module": "core", "action": "setvalue", "options": { "key": "assignment_filter", "value": "{{$_GET.assignment_filter || 'ALL'}}" } },
    { "module": "core", "action": "condition", "options": { "if": "{{!['ALL', 'UNASSIGNED', 'ASSIGNED', 'MINE'].contains(assignment_filter)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Choose a valid assignment filter." } } }] } } },
    { "name": "page", "module": "core", "action": "setvalue", "options": { "key": "page", "value": "{{$_GET.page && $_GET.page > 0 ? floor($_GET.page) : 1}}" } },
    { "name": "page_size", "module": "core", "action": "setvalue", "options": { "key": "page_size", "value": "{{!$_GET.page_size || $_GET.page_size < 1 ? 25 : ($_GET.page_size > 100 ? 100 : floor($_GET.page_size))}}" } },
    { "name": "tickets", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": {
      "table": { "name": "tickets", "alias": "t" },
      "columns": [{ "table": "t", "column": "id", "alias": "ticket_id" }, { "table": "t", "column": "ticket_number" }, { "table": "t", "column": "device_id" }, { "table": "dv", "column": "serial_number" }, { "table": "dv", "column": "asset_tag" }, { "table": "t", "column": "current_status_id" }, { "table": "ts", "column": "code", "alias": "current_status_code" }, { "table": "ts", "column": "name", "alias": "current_status_name" }, { "table": "t", "column": "origin_district_id" }, { "table": "d", "column": "name", "alias": "origin_district_name" }, { "table": "t", "column": "origin_school_id" }, { "table": "s", "column": "name", "alias": "origin_school_name" }, { "table": "t", "column": "origin_student_id" }, { "table": "st", "column": "student_reference" }, { "table": "st", "column": "first_name", "alias": "student_first_name" }, { "table": "st", "column": "last_name", "alias": "student_last_name" }, { "table": "t", "column": "requester_type" }, { "table": "t", "column": "requester_name" }, { "table": "t", "column": "subject" }, { "table": "t", "column": "submitted_at" }, { "table": "t", "column": "closed_at" }, { "table": "vta", "column": "active_assignment_id" }, { "table": "vta", "column": "assigned_to_user_id" }, { "table": "au", "column": "display_name", "alias": "assigned_to_display_name" }],
      "joins": [
        { "table": "devices", "alias": "dv", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "dv", "column": "id", "operation": "=", "value": { "table": "t", "column": "device_id" } }] } },
        { "table": "ticket_statuses", "alias": "ts", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ts", "column": "id", "operation": "=", "value": { "table": "t", "column": "current_status_id" } }] } },
        { "table": "districts", "alias": "d", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "d", "column": "id", "operation": "=", "value": { "table": "t", "column": "origin_district_id" } }] } },
        { "table": "schools", "alias": "s", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "s", "column": "id", "operation": "=", "value": { "table": "t", "column": "origin_school_id" } }] } },
        { "table": "students", "alias": "st", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "st", "column": "id", "operation": "=", "value": { "table": "t", "column": "origin_student_id" } }] } },
        { "table": "v_ticket_current_context", "alias": "vta", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "vta", "column": "ticket_id", "operation": "=", "value": { "table": "t", "column": "id" } }] } },
        { "table": "v_repair_current_context", "alias": "rctx", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "rctx", "column": "ticket_id", "operation": "=", "value": { "table": "t", "column": "id" } }] } },
        { "table": "users", "alias": "au", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "au", "column": "id", "operation": "=", "value": { "table": "vta", "column": "assigned_to_user_id" } }] } }
      ],
      "wheres": { "condition": "AND", "rules": [
        { "condition": "AND", "conditional": "{{$_GET.status_code}}", "rules": [{ "data": { "table": "ts", "column": "code" }, "operation": "=", "value": "{{$_GET.status_code}}" }] },
        { "condition": "AND", "conditional": "{{$_GET.district_id}}", "rules": [{ "data": { "table": "t", "column": "origin_district_id" }, "operation": "=", "value": "{{$_GET.district_id}}" }] },
        { "condition": "AND", "conditional": "{{$_GET.school_id}}", "rules": [{ "data": { "table": "t", "column": "origin_school_id" }, "operation": "=", "value": "{{$_GET.school_id}}" }] },
        { "condition": "AND", "conditional": "{{$_GET.requester_type}}", "rules": [{ "data": { "table": "t", "column": "requester_type" }, "operation": "=", "value": "{{$_GET.requester_type}}" }] },
        { "condition": "AND", "conditional": "{{assignment_filter == 'UNASSIGNED'}}", "rules": [{ "data": { "table": "vta", "column": "active_assignment_id" }, "operator": "is_null" }] },
        { "condition": "AND", "conditional": "{{assignment_filter == 'ASSIGNED'}}", "rules": [{ "data": { "table": "vta", "column": "active_assignment_id" }, "operator": "is_not_null" }] },
        { "condition": "AND", "conditional": "{{assignment_filter == 'MINE'}}", "rules": [{ "data": { "table": "vta", "column": "assigned_to_user_id" }, "operation": "=", "value": "{{identity}}" }] },
        { "condition": "AND", "conditional": "{{$_GET.submitted_from}}", "rules": [{ "data": { "table": "t", "column": "submitted_at" }, "operation": ">=", "value": "{{$_GET.submitted_from}}" }] },
        { "condition": "AND", "conditional": "{{$_GET.submitted_to}}", "rules": [{ "data": { "table": "t", "column": "submitted_at" }, "operation": "<=", "value": "{{$_GET.submitted_to + ' 23:59:59'}}" }] },
        { "condition": "OR", "conditional": "{{$_GET.search}}", "rules": [{ "data": { "table": "t", "column": "ticket_number" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "table": "dv", "column": "serial_number" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "table": "dv", "column": "asset_tag" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "table": "t", "column": "subject" }, "operator": "contains", "value": "{{$_GET.search}}" }, { "data": { "table": "t", "column": "requester_name" }, "operator": "contains", "value": "{{$_GET.search}}" }] },
        { "condition": "OR", "rules": [
          { "condition": "AND", "conditional": "{{permission.bypass == 'SUPER_ADMIN' || scope_context.has_national_scope}}", "rules": [{ "data": { "table": "t", "column": "id" }, "operation": ">", "value": 0 }] },
          { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length > 0}}", "rules": [{ "data": { "table": "t", "column": "origin_district_id" }, "operation": "in", "value": "{{scope_context.districts.flatten('id')}}" }] },
          { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length == 0 && scope_context.schools.length > 0}}", "rules": [{ "data": { "table": "t", "column": "origin_school_id" }, "operation": "in", "value": "{{scope_context.schools.flatten('id')}}" }] },
          { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && scope_context.service_locations.length > 0}}", "rules": [{ "data": { "table": "rctx", "column": "repair_centre_location_id" }, "operation": "in", "value": "{{scope_context.service_locations.flatten('id')}}" }] },
          { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length == 0 && scope_context.schools.length == 0 && scope_context.service_locations.length == 0}}", "rules": [{ "data": { "table": "t", "column": "id" }, "operation": "=", "value": -1 }] }
        ] }
      ] }, "orders": [{ "table": "t", "column": "submitted_at", "direction": "desc" }, { "table": "t", "column": "id", "direction": "desc" }], "limit": "{{page_size}}", "offset": "{{(page - 1) * page_size}}"
    } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "tickets": "{{tickets}}", "page": "{{page}}", "page_size": "{{page_size}}", "assignment_filter": "{{assignment_filter}}" } } }
  ], "catch": { "steps": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Tickets could not be loaded." } } }] } }
}
