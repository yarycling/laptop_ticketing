{
  "settings": { "options": { "method": "post" } },
  "meta": { "$_POST": [{ "name": "temporary_loan_case_id", "type": "number" }, { "name": "return_reason_code", "type": "text" }, { "name": "return_notes", "type": "text" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_require_permission", "params": { "permission": "temporary_loans.request_return" } } },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.temporary_loan_case_id || $_POST.temporary_loan_case_id < 1 || !$_POST.return_reason_code || ($_POST.return_notes && $_POST.return_notes.length > 1000)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "A valid temporary loan and return reason are required." } } }] } } },
    { "name": "reason", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "temporary_loan_return_reasons", "columns": [{ "column": "code" }, { "column": "name" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "{{$_POST.return_reason_code}}" }, { "data": { "column": "is_active" }, "operation": "=", "value": 1 }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!reason.code || ($_POST.return_reason_code == 'OTHER' && !($_POST.return_notes || '').trim())}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Select a valid return reason; notes are required for Other." } } }] } } },
    { "name": "return_request_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "loan", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_temporary_loan_queue", "columns": [{ "column": "temporary_loan_case_id" }, { "column": "loan_number" }, { "column": "ticket_id" }, { "column": "original_device_id" }, { "column": "repair_service_location_id" }, { "column": "current_status_code" }, { "column": "active_record_key" }, { "column": "selected_spare_device_id" }, { "column": "selected_spare_lifecycle_code" }, { "column": "conversion_status" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "temporary_loan_case_id" }, "operation": "=", "value": "{{$_POST.temporary_loan_case_id}}" }] } } } },
      { "name": "location_scope", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "user_service_location_scopes", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "column": "service_location_id" }, "operation": "=", "value": "{{loan.repair_service_location_id}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!loan.temporary_loan_case_id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_RETURN_NOT_FOUND" } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !location_scope.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_RETURN_SCOPE" } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{loan.current_status_code != 'ACTIVE_LOAN' || loan.active_record_key != 1 || !loan.selected_spare_device_id || loan.selected_spare_device_id == loan.original_device_id || loan.selected_spare_lifecycle_code != 'TEMPORARY_LOAN'}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_RETURN_STATE" } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{loan.conversion_status == 'CONVERSION_PENDING_HEAD_OFFICE' || loan.conversion_status == 'CONVERTED_PERMANENT'}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_RETURN_CONVERSION" } }] } } },
      { "name": "replacement_case", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "permanent_replacement_cases", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "replacement_device_id" }, "operation": "=", "value": "{{loan.selected_spare_device_id}}" }, { "data": { "column": "active_selection_key" }, "operator": "is_not_null" }] } } } },
      { "name": "completed_replacement", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "device_replacements", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "replacement_device_id" }, "operation": "=", "value": "{{loan.selected_spare_device_id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{replacement_case.id || completed_replacement.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_RETURN_CONVERSION" } }] } } },
      { "name": "case_update", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "temporary_loan_cases", "values": [{ "column": "current_status_code", "value": "RETURN_REQUIRED" }, { "column": "return_requested_by", "value": "{{identity}}" }, { "column": "return_requested_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss')}}" }, { "column": "return_reason_code", "value": "{{reason.code}}" }, { "column": "return_notes", "value": "{{($_POST.return_notes || '').trim() || null}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{loan.temporary_loan_case_id}}" }, { "data": { "column": "current_status_code" }, "operation": "=", "value": "ACTIVE_LOAN" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "selected_spare_device_id" }, "operation": "=", "value": "{{loan.selected_spare_device_id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{case_update.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_RETURN_STATE" } }] } } },
      { "name": "custody", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "temporary_loan_custody_history", "values": [{ "column": "temporary_loan_case_id", "value": "{{loan.temporary_loan_case_id}}" }, { "column": "device_id", "value": "{{loan.selected_spare_device_id}}" }, { "column": "from_custody_code", "value": "TEMPORARY_LOAN_ISSUED" }, { "column": "to_custody_code", "value": "TEMPORARY_LOAN_RETURN_REQUIRED" }, { "column": "actor_user_id", "value": "{{identity}}" }, { "column": "notes", "value": "Temporary spare return requested; physical receipt is not confirmed." }] } } },
      { "name": "history", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "temporary_loan_status_history", "values": [{ "column": "temporary_loan_case_id", "value": "{{loan.temporary_loan_case_id}}" }, { "column": "from_status_code", "value": "ACTIVE_LOAN" }, { "column": "to_status_code", "value": "RETURN_REQUIRED" }, { "column": "actor_user_id", "value": "{{identity}}" }, { "column": "notes", "value": "Temporary spare return requested for reason: {{reason.code}}." }] } } },
      { "name": "audit", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "temporary_loan_return_required" }, { "column": "module", "value": "temporary_loans" }, { "column": "entity_type", "value": "temporary_loan_case" }, { "column": "entity_id", "value": "{{loan.temporary_loan_case_id}}" }, { "column": "description", "value": "Temporary spare return requested; physical receipt is not confirmed." }] } } }
    ] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "temporary_loan_case_id": "{{$_POST.temporary_loan_case_id}}", "loan_number": "{{loan.loan_number}}", "status": "RETURN_REQUIRED", "device_id": "{{loan.selected_spare_device_id}}", "lifecycle": "TEMPORARY_LOAN", "stock_status": "NOT_IN_FREE_STOCK", "return_reason_code": "{{reason.code}}" } } }
  ], "catch": [
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'TL_RETURN_SCOPE'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'TL_RETURN_NOT_FOUND'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Temporary loan was not found." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'TL_RETURN_STATE' || $_EXCEPTION.message == 'TL_RETURN_CONVERSION' || $_EXCEPTION.code == 'ER_DUP_ENTRY'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "This temporary loan is no longer eligible for a return request." } } }] } } },
    { "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Temporary spare return could not be requested. No partial changes were committed." } } }
  ] }
}
