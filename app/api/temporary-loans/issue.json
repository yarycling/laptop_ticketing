{
  "settings": { "options": { "method": "post" } },
  "meta": { "$_POST": [{ "name": "temporary_loan_case_id", "type": "number" }, { "name": "notes", "type": "text" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_require_permission", "params": { "permission": "temporary_loans.issue" } } },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.temporary_loan_case_id || $_POST.temporary_loan_case_id < 1 || ($_POST.notes && $_POST.notes.length > 1000)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "A valid temporary loan and notes of at most 1000 characters are required." } } }] } } },
    { "name": "available_lifecycle", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "device_lifecycle_statuses", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "AVAILABLE" }] } } } },
    { "name": "temporary_lifecycle", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "device_lifecycle_statuses", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "TEMPORARY_LOAN" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!available_lifecycle.id || !temporary_lifecycle.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "Temporary loan lifecycle configuration is unavailable." } } }] } } },
    { "name": "issue_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "loan", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_temporary_loan_queue", "columns": [{ "column": "temporary_loan_case_id" }, { "column": "loan_number" }, { "column": "ticket_id" }, { "column": "original_device_id" }, { "column": "repair_service_location_id" }, { "column": "current_status_code" }, { "column": "active_record_key" }, { "column": "selected_spare_device_id" }, { "column": "origin_district_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "temporary_loan_case_id" }, "operation": "=", "value": "{{$_POST.temporary_loan_case_id}}" }] } } } },
      { "name": "location_scope", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "user_service_location_scopes", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "column": "service_location_id" }, "operation": "=", "value": "{{loan.repair_service_location_id}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!loan.temporary_loan_case_id || (permission.bypass != 'SUPER_ADMIN' && !location_scope.id)}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_ISSUE_SCOPE" } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{loan.current_status_code != 'SPARE_SELECTED' || loan.active_record_key != 1 || !loan.selected_spare_device_id || loan.selected_spare_device_id == loan.original_device_id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_ISSUE_STATE" } }] } } },
      { "name": "reservation", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "temporary_loan_spare_reservations", "columns": [{ "column": "id" }, { "column": "device_id" }, { "column": "reservation_status" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "temporary_loan_case_id" }, "operation": "=", "value": "{{loan.temporary_loan_case_id}}" }, { "data": { "column": "device_id" }, "operation": "=", "value": "{{loan.selected_spare_device_id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "reservation_status" }, "operation": "=", "value": "RESERVED" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!reservation.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_ISSUE_RESERVATION" } }] } } },
      { "name": "stock_candidate", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_device_stock_queue", "columns": [{ "column": "stock_location_id" }, { "column": "device_id" }, { "column": "service_location_id" }, { "column": "stock_status" }, { "column": "lifecycle_code" }, { "column": "allocation_level" }, { "column": "is_reserved_for_replacement" }, { "column": "has_active_logistics" }, { "column": "has_active_manufacturer_return" }, { "column": "has_active_repair" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "device_id" }, "operation": "=", "value": "{{loan.selected_spare_device_id}}" }, { "data": { "column": "service_location_id" }, "operation": "=", "value": "{{loan.repair_service_location_id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!stock_candidate.device_id || stock_candidate.stock_status != 'IN_STOCK' || stock_candidate.lifecycle_code != 'AVAILABLE' || stock_candidate.allocation_level != 'CENTRAL' || stock_candidate.is_reserved_for_replacement == 1 || stock_candidate.has_active_logistics == 1 || stock_candidate.has_active_manufacturer_return == 1 || stock_candidate.has_active_repair == 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_ISSUE_CANDIDATE" } }] } } },
      { "name": "student_assignment", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "device_student_assignments", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "device_id" }, "operation": "=", "value": "{{loan.selected_spare_device_id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "returned_at" }, "operator": "is_null" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{student_assignment.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_ISSUE_CANDIDATE" } }] } } },
      { "name": "device_lock", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "devices", "values": [{ "column": "lifecycle_status_id", "value": "{{available_lifecycle.id}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{loan.selected_spare_device_id}}" }, { "data": { "column": "lifecycle_status_id" }, "operation": "=", "value": "{{available_lifecycle.id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{device_lock.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_ISSUE_CANDIDATE" } }] } } },
      { "name": "stock_lock", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "device_stock_locations", "values": [{ "column": "stock_status", "value": "IN_STOCK" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{stock_candidate.stock_location_id}}" }, { "data": { "column": "device_id" }, "operation": "=", "value": "{{loan.selected_spare_device_id}}" }, { "data": { "column": "service_location_id" }, "operation": "=", "value": "{{loan.repair_service_location_id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "stock_status" }, "operation": "=", "value": "IN_STOCK" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{stock_lock.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_ISSUE_CANDIDATE" } }] } } },
      { "name": "reservation_consume", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "temporary_loan_spare_reservations", "values": [{ "column": "reservation_status", "value": "CONSUMED" }, { "column": "active_record_key", "value": null }, { "column": "consumed_by", "value": "{{identity}}" }, { "column": "consumed_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss')}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{reservation.id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "reservation_status" }, "operation": "=", "value": "RESERVED" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{reservation_consume.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_ISSUE_RESERVATION" } }] } } },
      { "name": "release_stock", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "device_stock_locations", "values": [{ "column": "stock_status", "value": "RELEASED" }, { "column": "active_record_key", "value": null }, { "column": "removed_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss')}}" }, { "column": "removed_by", "value": "{{identity}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{stock_candidate.stock_location_id}}" }, { "data": { "column": "device_id" }, "operation": "=", "value": "{{loan.selected_spare_device_id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "stock_status" }, "operation": "=", "value": "IN_STOCK" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{release_stock.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_ISSUE_CANDIDATE" } }] } } },
      { "name": "lifecycle_update", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "devices", "values": [{ "column": "lifecycle_status_id", "value": "{{temporary_lifecycle.id}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{loan.selected_spare_device_id}}" }, { "data": { "column": "lifecycle_status_id" }, "operation": "=", "value": "{{available_lifecycle.id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{lifecycle_update.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_ISSUE_CANDIDATE" } }] } } },
      { "name": "loan_update", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "temporary_loan_cases", "values": [{ "column": "current_status_code", "value": "ACTIVE_LOAN" }, { "column": "issued_by", "value": "{{identity}}" }, { "column": "issued_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss')}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{loan.temporary_loan_case_id}}" }, { "data": { "column": "current_status_code" }, "operation": "=", "value": "SPARE_SELECTED" }, { "data": { "column": "selected_spare_device_id" }, "operation": "=", "value": "{{loan.selected_spare_device_id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{loan_update.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_ISSUE_STATE" } }] } } },
      { "name": "custody", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "temporary_loan_custody_history", "values": [{ "column": "temporary_loan_case_id", "value": "{{loan.temporary_loan_case_id}}" }, { "column": "device_id", "value": "{{loan.selected_spare_device_id}}" }, { "column": "from_custody_code", "value": "REPAIR_CENTRE_STOCK" }, { "column": "to_custody_code", "value": "TEMPORARY_LOAN_ISSUED" }, { "column": "actor_user_id", "value": "{{identity}}" }, { "column": "notes", "value": "{{$_POST.notes || 'Temporary loan asset activated at Repair Centre; recipient handoff and receipt are not recorded.'}}" }] } } },
      { "name": "history", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "temporary_loan_status_history", "values": [{ "column": "temporary_loan_case_id", "value": "{{loan.temporary_loan_case_id}}" }, { "column": "from_status_code", "value": "SPARE_SELECTED" }, { "column": "to_status_code", "value": "ACTIVE_LOAN" }, { "column": "actor_user_id", "value": "{{identity}}" }, { "column": "notes", "value": "Temporary spare issued and activated." }] } } },
      { "name": "audit", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "temporary_loan_issued" }, { "column": "module", "value": "temporary_loans" }, { "column": "entity_type", "value": "temporary_loan_case" }, { "column": "entity_id", "value": "{{loan.temporary_loan_case_id}}" }, { "column": "description", "value": "Temporary spare issued and activated." }] } } }
    ] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "temporary_loan_case_id": "{{$_POST.temporary_loan_case_id}}", "device_id": "{{loan.selected_spare_device_id}}", "status": "ACTIVE_LOAN", "lifecycle": "TEMPORARY_LOAN", "stock_status": "RELEASED" } } }
  ], "catch": [
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'TL_ISSUE_SCOPE'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'TL_ISSUE_STATE' || $_EXCEPTION.message == 'TL_ISSUE_RESERVATION' || $_EXCEPTION.message == 'TL_ISSUE_CANDIDATE' || $_EXCEPTION.code == 'ER_DUP_ENTRY'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The selected spare or reservation is no longer eligible for issue." } } }] } } },
    { "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Temporary spare could not be issued. No partial changes were committed." } } }
  ] }
}
