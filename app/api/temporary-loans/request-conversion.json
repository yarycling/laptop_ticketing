{
  "settings": {
    "options": {
      "method": "post"
    }
  },
  "meta": {
    "$_POST": [
      {
        "name": "temporary_loan_case_id",
        "type": "number"
      },
      {
        "name": "reason_code",
        "type": "text"
      },
      {
        "name": "request_notes",
        "type": "text"
      }
    ]
  },
  "exec": {
    "steps": [
      {
        "name": "permission",
        "module": "core",
        "action": "exec",
        "output": true,
        "options": {
          "exec": "security_require_permission",
          "params": {
            "permission": "temporary_loans.request_conversion"
          }
        }
      },
      {
        "name": "identity",
        "module": "auth",
        "action": "identify",
        "options": {
          "provider": "portalSecurity"
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{!$_POST.temporary_loan_case_id || $_POST.temporary_loan_case_id < 1 || !$_POST.reason_code || ($_POST.request_notes && $_POST.request_notes.length > 1000)}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 400,
                  "data": {
                    "success": false,
                    "error": "A valid temporary loan and conversion reason are required."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "name": "reason",
        "module": "dbconnector",
        "action": "single",
        "output": true,
        "options": {
          "connection": "db",
          "sql": {
            "table": "temporary_loan_conversion_reasons",
            "columns": [
              {
                "column": "code"
              },
              {
                "column": "name"
              }
            ],
            "wheres": {
              "condition": "AND",
              "rules": [
                {
                  "data": {
                    "column": "code"
                  },
                  "operation": "=",
                  "value": "{{$_POST.reason_code}}"
                },
                {
                  "data": {
                    "column": "is_active"
                  },
                  "operation": "=",
                  "value": 1
                }
              ]
            }
          }
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{!reason.code || ($_POST.reason_code == 'OTHER' && !($_POST.request_notes || '').trim())}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 400,
                  "data": {
                    "success": false,
                    "error": "Select a valid conversion reason; notes are required for Other."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "name": "request_transaction",
        "module": "dbupdater",
        "action": "transaction",
        "options": {
          "connection": "db",
          "exec": {
            "steps": [
              {
                "name": "loan",
                "module": "dbconnector",
                "action": "single",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "v_temporary_loan_queue",
                    "columns": [
                      {
                        "column": "temporary_loan_case_id"
                      },
                      {
                        "column": "loan_number"
                      },
                      {
                        "column": "ticket_id"
                      },
                      {
                        "column": "original_device_id"
                      },
                      {
                        "column": "repair_service_location_id"
                      },
                      {
                        "column": "current_status_code"
                      },
                      {
                        "column": "active_record_key"
                      },
                      {
                        "column": "selected_spare_device_id"
                      },
                      {
                        "column": "selected_spare_lifecycle_code"
                      },
                      {
                        "column": "selected_spare_stock_status"
                      },
                      {
                        "column": "conversion_status"
                      },
                      {
                        "column": "conversion_request_status"
                      },
                      {
                        "column": "original_device_lifecycle_code"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "temporary_loan_case_id"
                          },
                          "operation": "=",
                          "value": "{{$_POST.temporary_loan_case_id}}"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "name": "location_scope",
                "module": "dbconnector",
                "action": "single",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "user_service_location_scopes",
                    "columns": [
                      {
                        "column": "id"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "user_id"
                          },
                          "operation": "=",
                          "value": "{{identity}}"
                        },
                        {
                          "data": {
                            "column": "service_location_id"
                          },
                          "operation": "=",
                          "value": "{{loan.repair_service_location_id}}"
                        },
                        {
                          "data": {
                            "column": "status"
                          },
                          "operation": "=",
                          "value": "active"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "module": "core",
                "action": "condition",
                "options": {
                  "if": "{{!loan.temporary_loan_case_id}}",
                  "then": {
                    "steps": [
                      {
                        "module": "core",
                        "action": "error",
                        "options": {
                          "message": "TL_CONVERSION_NOT_FOUND"
                        }
                      }
                    ]
                  }
                }
              },
              {
                "module": "core",
                "action": "condition",
                "options": {
                  "if": "{{permission.bypass != 'SUPER_ADMIN' && !location_scope.id}}",
                  "then": {
                    "steps": [
                      {
                        "module": "core",
                        "action": "error",
                        "options": {
                          "message": "TL_CONVERSION_SCOPE"
                        }
                      }
                    ]
                  }
                }
              },
              {
                "module": "core",
                "action": "condition",
                "options": {
                  "if": "{{loan.current_status_code != 'ACTIVE_LOAN' || loan.active_record_key != 1 || !loan.selected_spare_device_id || loan.selected_spare_device_id == loan.original_device_id || loan.selected_spare_lifecycle_code != 'TEMPORARY_LOAN' || loan.selected_spare_stock_status != 'NOT_IN_FREE_STOCK' || ['CONVERSION_PENDING_HEAD_OFFICE','CONVERTED_PERMANENT'].contains(loan.conversion_status) || loan.conversion_request_status == 'PENDING' || !['IN_REPAIR','MANUFACTURER_RETURN'].contains(loan.original_device_lifecycle_code)}}",
                  "then": {
                    "steps": [
                      {
                        "module": "core",
                        "action": "error",
                        "options": {
                          "message": "TL_CONVERSION_STATE"
                        }
                      }
                    ]
                  }
                }
              },
              {
                "name": "original_custody",
                "module": "dbconnector",
                "action": "single",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "v_device_current_custody",
                    "columns": [
                      {
                        "column": "device_id"
                      },
                      {
                        "column": "current_custody_level"
                      },
                      {
                        "column": "district_id"
                      },
                      {
                        "column": "school_id"
                      },
                      {
                        "column": "student_id"
                      },
                      {
                        "column": "district_allocation_id"
                      },
                      {
                        "column": "school_allocation_id"
                      },
                      {
                        "column": "student_assignment_id"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "device_id"
                          },
                          "operation": "=",
                          "value": "{{loan.original_device_id}}"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "name": "active_stock",
                "module": "dbconnector",
                "action": "single",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "device_stock_locations",
                    "columns": [
                      {
                        "column": "id"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "device_id"
                          },
                          "operation": "=",
                          "value": "{{loan.selected_spare_device_id}}"
                        },
                        {
                          "data": {
                            "column": "active_record_key"
                          },
                          "operation": "=",
                          "value": 1
                        }
                      ]
                    }
                  }
                }
              },
              {
                "name": "existing_relationship",
                "module": "dbconnector",
                "action": "single",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "device_replacements",
                    "columns": [
                      {
                        "column": "id"
                      }
                    ],
                    "wheres": {
                      "condition": "OR",
                      "rules": [
                        {
                          "data": {
                            "column": "original_device_id"
                          },
                          "operation": "=",
                          "value": "{{loan.original_device_id}}"
                        },
                        {
                          "data": {
                            "column": "replacement_device_id"
                          },
                          "operation": "=",
                          "value": "{{loan.selected_spare_device_id}}"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "name": "active_replacement",
                "module": "dbconnector",
                "action": "single",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "permanent_replacement_cases",
                    "columns": [
                      {
                        "column": "id"
                      },
                      {
                        "column": "replacement_number"
                      },
                      {
                        "column": "exception_case_id"
                      },
                      {
                        "column": "ticket_id"
                      },
                      {
                        "column": "current_status_code"
                      },
                      {
                        "column": "replacement_source_type"
                      },
                      {
                        "column": "active_selection_key"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "original_device_id"
                          },
                          "operation": "=",
                          "value": "{{loan.original_device_id}}"
                        },
                        {
                          "data": {
                            "column": "active_record_key"
                          },
                          "operation": "=",
                          "value": 1
                        }
                      ]
                    }
                  }
                }
              },
              {
                "name": "active_replacement_exception",
                "module": "dbconnector",
                "action": "single",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "repair_exception_cases",
                    "columns": [
                      {
                        "column": "id"
                      },
                      {
                        "column": "ticket_id"
                      },
                      {
                        "column": "device_id"
                      },
                      {
                        "column": "current_status_code"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "id"
                          },
                          "operation": "=",
                          "value": "{{active_replacement.exception_case_id || -1}}"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "module": "core",
                "action": "condition",
                "options": {
                  "if": "{{active_replacement.id && (active_replacement.ticket_id != loan.ticket_id || active_replacement.current_status_code != 'SELECTION_REQUIRED' || active_replacement.replacement_source_type || active_replacement.active_selection_key || !active_replacement.exception_case_id || active_replacement_exception.current_status_code != 'REPLACEMENT_APPROVED' || active_replacement_exception.ticket_id != loan.ticket_id || active_replacement_exception.device_id != loan.original_device_id)}}",
                  "then": {
                    "steps": [
                      {
                        "module": "core",
                        "action": "error",
                        "options": {
                          "message": "TL_CONVERSION_ACTIVE_REPLACEMENT"
                        }
                      }
                    ]
                  }
                }
              },
              {
                "name": "spare_replacement",
                "module": "dbconnector",
                "action": "single",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "permanent_replacement_cases",
                    "columns": [
                      {
                        "column": "id"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "replacement_device_id"
                          },
                          "operation": "=",
                          "value": "{{loan.selected_spare_device_id}}"
                        },
                        {
                          "data": {
                            "column": "active_selection_key"
                          },
                          "operator": "is_not_null"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "module": "core",
                "action": "condition",
                "options": {
                  "if": "{{!original_custody.device_id || !['STUDENT','SCHOOL','DISTRICT'].contains(original_custody.current_custody_level) || (original_custody.current_custody_level == 'STUDENT' && (!original_custody.student_assignment_id || !original_custody.school_allocation_id || !original_custody.district_allocation_id)) || (original_custody.current_custody_level == 'SCHOOL' && (!original_custody.school_allocation_id || !original_custody.district_allocation_id)) || (original_custody.current_custody_level == 'DISTRICT' && !original_custody.district_allocation_id) || active_stock.id || existing_relationship.id || spare_replacement.id}}",
                  "then": {
                    "steps": [
                      {
                        "module": "core",
                        "action": "error",
                        "options": {
                          "message": "TL_CONVERSION_CONFLICT"
                        }
                      }
                    ]
                  }
                }
              },
              {
                "name": "new_request",
                "module": "dbupdater",
                "action": "insert",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "temporary_loan_conversion_requests",
                    "values": [
                      {
                        "column": "temporary_loan_case_id",
                        "value": "{{loan.temporary_loan_case_id}}"
                      },
                      {
                        "column": "status_code",
                        "value": "PENDING"
                      },
                      {
                        "column": "reason_code",
                        "value": "{{reason.code}}"
                      },
                      {
                        "column": "request_notes",
                        "value": "{{($_POST.request_notes || '').trim() || null}}"
                      },
                      {
                        "column": "requested_by",
                        "value": "{{identity}}"
                      },
                      {
                        "column": "active_record_key",
                        "value": 1
                      },
                      {
                        "column": "original_custody_level",
                        "value": "{{original_custody.current_custody_level}}"
                      },
                      {
                        "column": "original_district_id",
                        "value": "{{original_custody.district_id || null}}"
                      },
                      {
                        "column": "original_school_id",
                        "value": "{{original_custody.school_id || null}}"
                      },
                      {
                        "column": "original_student_id",
                        "value": "{{original_custody.student_id || null}}"
                      },
                      {
                        "column": "original_district_allocation_id",
                        "value": "{{original_custody.district_allocation_id || null}}"
                      },
                      {
                        "column": "original_school_allocation_id",
                        "value": "{{original_custody.school_allocation_id || null}}"
                      },
                      {
                        "column": "original_student_assignment_id",
                        "value": "{{original_custody.student_assignment_id || null}}"
                      }
                    ]
                  }
                }
              },
              {
                "name": "request_number",
                "module": "dbupdater",
                "action": "update",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "temporary_loan_conversion_requests",
                    "values": [
                      {
                        "column": "conversion_request_number",
                        "value": "{{'TLC' + new_request.identity}}"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "id"
                          },
                          "operation": "=",
                          "value": "{{new_request.identity}}"
                        },
                        {
                          "data": {
                            "column": "conversion_request_number"
                          },
                          "operator": "is_null"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "name": "case_update",
                "module": "dbupdater",
                "action": "update",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "temporary_loan_cases",
                    "values": [
                      {
                        "column": "current_status_code",
                        "value": "CONVERSION_PENDING_HEAD_OFFICE"
                      },
                      {
                        "column": "conversion_status",
                        "value": "CONVERSION_PENDING_HEAD_OFFICE"
                      },
                      {
                        "column": "conversion_request_id",
                        "value": "{{new_request.identity}}"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "id"
                          },
                          "operation": "=",
                          "value": "{{loan.temporary_loan_case_id}}"
                        },
                        {
                          "data": {
                            "column": "current_status_code"
                          },
                          "operation": "=",
                          "value": "ACTIVE_LOAN"
                        },
                        {
                          "data": {
                            "column": "active_record_key"
                          },
                          "operation": "=",
                          "value": 1
                        },
                        {
                          "data": {
                            "column": "selected_spare_device_id"
                          },
                          "operation": "=",
                          "value": "{{loan.selected_spare_device_id}}"
                        },
                        {
                          "data": {
                            "column": "conversion_status"
                          },
                          "operator": "is_null"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "module": "core",
                "action": "condition",
                "options": {
                  "if": "{{request_number.affected != 1 || case_update.affected != 1}}",
                  "then": {
                    "steps": [
                      {
                        "module": "core",
                        "action": "error",
                        "options": {
                          "message": "TL_CONVERSION_STATE"
                        }
                      }
                    ]
                  }
                }
              },
              {
                "name": "history",
                "module": "dbupdater",
                "action": "insert",
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "temporary_loan_status_history",
                    "values": [
                      {
                        "column": "temporary_loan_case_id",
                        "value": "{{loan.temporary_loan_case_id}}"
                      },
                      {
                        "column": "from_status_code",
                        "value": "ACTIVE_LOAN"
                      },
                      {
                        "column": "to_status_code",
                        "value": "CONVERSION_PENDING_HEAD_OFFICE"
                      },
                      {
                        "column": "actor_user_id",
                        "value": "{{identity}}"
                      },
                      {
                        "column": "notes",
                        "value": "Permanent replacement conversion requested for reason: {{reason.code}}."
                      }
                    ]
                  }
                }
              },
              {
                "name": "audit",
                "module": "dbupdater",
                "action": "insert",
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "audit_logs",
                    "values": [
                      {
                        "column": "actor_user_id",
                        "value": "{{identity}}"
                      },
                      {
                        "column": "action",
                        "value": "temporary_loan_conversion_requested"
                      },
                      {
                        "column": "module",
                        "value": "temporary_loans"
                      },
                      {
                        "column": "entity_type",
                        "value": "temporary_loan_case"
                      },
                      {
                        "column": "entity_id",
                        "value": "{{loan.temporary_loan_case_id}}"
                      },
                      {
                        "column": "description",
                        "value": "Permanent replacement conversion requested for Head Office decision."
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      {
        "module": "core",
        "action": "response",
        "options": {
          "status": 200,
          "data": {
            "success": true,
            "temporary_loan_case_id": "{{loan.temporary_loan_case_id}}",
            "loan_number": "{{loan.loan_number}}",
            "conversion_request_id": "{{new_request.identity}}",
            "conversion_request_number": "{{'TLC' + new_request.identity}}",
            "status": "CONVERSION_PENDING_HEAD_OFFICE",
            "spare_lifecycle": "TEMPORARY_LOAN",
            "free_stock": false
          }
        }
      }
    ],
    "catch": [
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{$_EXCEPTION.message == 'TL_CONVERSION_SCOPE'}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 403,
                  "data": {
                    "success": false,
                    "error": "Forbidden."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{$_EXCEPTION.message == 'TL_CONVERSION_NOT_FOUND'}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 404,
                  "data": {
                    "success": false,
                    "error": "Temporary loan was not found."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{$_EXCEPTION.message == 'TL_CONVERSION_ACTIVE_REPLACEMENT'}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 409,
                  "data": {
                    "success": false,
                    "error": "Another permanent replacement case is active for this device and cannot use the issued temporary spare. Resolve that case before requesting a conversion."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{$_EXCEPTION.message == 'TL_CONVERSION_STATE' || $_EXCEPTION.message == 'TL_CONVERSION_CONFLICT' || $_EXCEPTION.code == 'ER_DUP_ENTRY' || $_EXCEPTION.code == 'ER_LOCK_DEADLOCK' || $_EXCEPTION.code == 'ER_LOCK_WAIT_TIMEOUT' || $_EXCEPTION.errno == 1062 || $_EXCEPTION.errno == 1213 || $_EXCEPTION.errno == 1205}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 409,
                  "data": {
                    "success": false,
                    "error": "This temporary loan is no longer eligible for conversion."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "module": "core",
        "action": "response",
        "options": {
          "status": 500,
          "data": {
            "success": false,
            "error": "Permanent conversion could not be requested. No partial changes were committed."
          }
        }
      }
    ]
  }
}
