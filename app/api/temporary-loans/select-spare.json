{
  "settings": { "options": { "method": "post" } },
  "meta": { "$_POST": [{ "name": "temporary_loan_case_id", "type": "number" }, { "name": "device_id", "type": "number" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_require_permission", "params": { "permission": "temporary_loans.select_spare" } } },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.temporary_loan_case_id || $_POST.temporary_loan_case_id < 1 || !$_POST.device_id || $_POST.device_id < 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Select a temporary loan and eligible spare device." } } }] } } },
    { "name": "select_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "loan", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_temporary_loan_queue", "columns": [{ "column": "temporary_loan_case_id" }, { "column": "loan_number" }, { "column": "repair_service_location_id" }, { "column": "current_status_code" }, { "column": "active_record_key" }, { "column": "selected_spare_device_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "temporary_loan_case_id" }, "operation": "=", "value": "{{$_POST.temporary_loan_case_id}}" }] } } } },
      { "name": "location_scope", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "user_service_location_scopes", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "column": "service_location_id" }, "operation": "=", "value": "{{loan.repair_service_location_id}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!loan.temporary_loan_case_id || (permission.bypass != 'SUPER_ADMIN' && !location_scope.id)}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_SELECT_SCOPE" } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{loan.current_status_code != 'AUTHORIZED' || loan.active_record_key != 1 || loan.selected_spare_device_id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_SELECT_STATE" } }] } } },
      { "name": "candidate", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_temporary_loan_spare_candidates", "columns": [{ "column": "device_id" }, { "column": "stock_location_id" }, { "column": "service_location_id" }, { "column": "lifecycle_status_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "temporary_loan_case_id" }, "operation": "=", "value": "{{loan.temporary_loan_case_id}}" }, { "data": { "column": "device_id" }, "operation": "=", "value": "{{$_POST.device_id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!candidate.device_id || candidate.service_location_id != loan.repair_service_location_id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_SELECT_CANDIDATE" } }] } } },
      { "name": "case_update", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "temporary_loan_cases", "values": [{ "column": "current_status_code", "value": "SPARE_SELECTED" }, { "column": "selected_spare_device_id", "value": "{{candidate.device_id}}" }, { "column": "selected_by", "value": "{{identity}}" }, { "column": "selected_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss')}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{loan.temporary_loan_case_id}}" }, { "data": { "column": "current_status_code" }, "operation": "=", "value": "AUTHORIZED" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "selected_spare_device_id" }, "operator": "is_null" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{case_update.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_SELECT_STATE" } }] } } },
      { "name": "reservation", "module": "dbupdater", "action": "insert", "output": true, "options": { "connection": "db", "sql": { "table": "temporary_loan_spare_reservations", "values": [{ "column": "temporary_loan_case_id", "value": "{{loan.temporary_loan_case_id}}" }, { "column": "device_id", "value": "{{candidate.device_id}}" }, { "column": "reservation_status", "value": "RESERVED" }, { "column": "active_record_key", "value": 1 }, { "column": "reserved_by", "value": "{{identity}}" }] } } },
      { "name": "history", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "temporary_loan_status_history", "values": [{ "column": "temporary_loan_case_id", "value": "{{loan.temporary_loan_case_id}}" }, { "column": "from_status_code", "value": "AUTHORIZED" }, { "column": "to_status_code", "value": "SPARE_SELECTED" }, { "column": "actor_user_id", "value": "{{identity}}" }, { "column": "notes", "value": "Temporary spare selected and reserved." }] } } },
      { "name": "audit", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "temporary_spare_selected" }, { "column": "module", "value": "temporary_loans" }, { "column": "entity_type", "value": "temporary_loan_case" }, { "column": "entity_id", "value": "{{loan.temporary_loan_case_id}}" }, { "column": "description", "value": "Temporary spare selected and reserved." }] } } }
    ] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "temporary_loan_case_id": "{{$_POST.temporary_loan_case_id}}", "device_id": "{{$_POST.device_id}}", "status": "SPARE_SELECTED" } } }
  ], "catch": [
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'TL_SELECT_SCOPE'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'TL_SELECT_STATE' || $_EXCEPTION.message == 'TL_SELECT_CANDIDATE' || $_EXCEPTION.code == 'ER_DUP_ENTRY'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The temporary loan or spare is no longer eligible for selection." } } }] } } },
    { "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Temporary spare could not be selected. No partial changes were committed." } } }
  ] }
}
