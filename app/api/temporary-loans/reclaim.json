{
  "settings": { "options": { "method": "post" } },
  "meta": { "$_POST": [{ "name": "temporary_loan_case_id", "type": "number" }, { "name": "return_condition_code", "type": "text" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_require_permission", "params": { "permission": "temporary_loans.reclaim" } } },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.temporary_loan_case_id || $_POST.temporary_loan_case_id < 1 || !$_POST.return_condition_code}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "A valid temporary loan and return condition are required." } } }] } } },
    { "name": "condition", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "temporary_loan_return_conditions", "columns": [{ "column": "code" }, { "column": "is_serviceable" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "{{$_POST.return_condition_code}}" }, { "data": { "column": "is_active" }, "operation": "=", "value": 1 }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!condition.code || condition.code != 'SERVICEABLE' || condition.is_serviceable != 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "Only a verified serviceable spare can be returned to free stock." } } }] } } },
    { "name": "temporary_lifecycle", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "device_lifecycle_statuses", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "TEMPORARY_LOAN" }] } } } },
    { "name": "available_lifecycle", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "device_lifecycle_statuses", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "code" }, "operation": "=", "value": "AVAILABLE" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!temporary_lifecycle.id || !available_lifecycle.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "Temporary-loan lifecycle configuration is unavailable." } } }] } } },
    { "name": "reclaim_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "loan", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_temporary_loan_queue", "columns": [{ "column": "temporary_loan_case_id" }, { "column": "loan_number" }, { "column": "ticket_id" }, { "column": "original_device_id" }, { "column": "repair_service_location_id" }, { "column": "current_status_code" }, { "column": "active_record_key" }, { "column": "selected_spare_device_id" }, { "column": "selected_spare_lifecycle_code" }, { "column": "conversion_status" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "temporary_loan_case_id" }, "operation": "=", "value": "{{$_POST.temporary_loan_case_id}}" }] } } } },
      { "name": "location_scope", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "user_service_location_scopes", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "column": "service_location_id" }, "operation": "=", "value": "{{loan.repair_service_location_id}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!loan.temporary_loan_case_id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_RECLAIM_NOT_FOUND" } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !location_scope.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_RECLAIM_SCOPE" } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{loan.current_status_code != 'RETURN_REQUIRED' || loan.active_record_key != 1 || !loan.selected_spare_device_id || loan.selected_spare_device_id == loan.original_device_id || loan.selected_spare_lifecycle_code != 'TEMPORARY_LOAN'}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_RECLAIM_STATE" } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{loan.conversion_status == 'CONVERSION_PENDING_HEAD_OFFICE' || loan.conversion_status == 'CONVERTED_PERMANENT'}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_RECLAIM_CONVERSION" } }] } } },
      { "name": "replacement_case", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "permanent_replacement_cases", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "replacement_device_id" }, "operation": "=", "value": "{{loan.selected_spare_device_id}}" }, { "data": { "column": "active_selection_key" }, "operator": "is_not_null" }] } } } },
      { "name": "completed_replacement", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "device_replacements", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "replacement_device_id" }, "operation": "=", "value": "{{loan.selected_spare_device_id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{replacement_case.id || completed_replacement.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_RECLAIM_CONVERSION" } }] } } },
      { "name": "device", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "devices", "columns": [{ "column": "id" }, { "column": "lifecycle_status_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{loan.selected_spare_device_id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!device.id || device.lifecycle_status_id != temporary_lifecycle.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_RECLAIM_LIFECYCLE" } }] } } },
      { "name": "active_stock", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "device_stock_locations", "columns": [{ "column": "id" }, { "column": "service_location_id" }, { "column": "stock_status" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "device_id" }, "operation": "=", "value": "{{loan.selected_spare_device_id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{active_stock.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_RECLAIM_STOCK" } }] } } },
      { "name": "other_active_loan", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "temporary_loan_cases", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "selected_spare_device_id" }, "operation": "=", "value": "{{loan.selected_spare_device_id}}" }, { "data": { "column": "id" }, "operation": "!=", "value": "{{loan.temporary_loan_case_id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "current_status_code" }, "operation": "=", "value": "ACTIVE_LOAN" }] } } } },
      { "name": "other_return_required", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "temporary_loan_cases", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "selected_spare_device_id" }, "operation": "=", "value": "{{loan.selected_spare_device_id}}" }, { "data": { "column": "id" }, "operation": "!=", "value": "{{loan.temporary_loan_case_id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "current_status_code" }, "operation": "=", "value": "RETURN_REQUIRED" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{other_active_loan.id || other_return_required.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_RECLAIM_CONFLICT" } }] } } },
      { "name": "active_assignment", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "device_student_assignments", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "device_id" }, "operation": "=", "value": "{{loan.selected_spare_device_id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "returned_at" }, "operator": "is_null" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{active_assignment.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_RECLAIM_CONFLICT" } }] } } },
      { "name": "device_lock", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "devices", "values": [{ "column": "lifecycle_status_id", "value": "{{available_lifecycle.id}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{loan.selected_spare_device_id}}" }, { "data": { "column": "lifecycle_status_id" }, "operation": "=", "value": "{{temporary_lifecycle.id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{device_lock.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_RECLAIM_LIFECYCLE" } }] } } },
      { "name": "stock_insert", "module": "dbupdater", "action": "insert", "output": true, "options": { "connection": "db", "sql": { "table": "device_stock_locations", "values": [{ "column": "device_id", "value": "{{loan.selected_spare_device_id}}" }, { "column": "service_location_id", "value": "{{loan.repair_service_location_id}}" }, { "column": "stock_status", "value": "IN_STOCK" }, { "column": "reason_code", "value": "TEMPORARY_LOAN_RETURNED" }, { "column": "active_record_key", "value": 1 }, { "column": "placed_by", "value": "{{identity}}" }] } } },
      { "name": "case_update", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "temporary_loan_cases", "values": [{ "column": "current_status_code", "value": "RETURNED" }, { "column": "return_condition_code", "value": "SERVICEABLE" }, { "column": "returned_by", "value": "{{identity}}" }, { "column": "returned_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss')}}" }, { "column": "closed_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss')}}" }, { "column": "active_record_key", "value": null }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{loan.temporary_loan_case_id}}" }, { "data": { "column": "current_status_code" }, "operation": "=", "value": "RETURN_REQUIRED" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "selected_spare_device_id" }, "operation": "=", "value": "{{loan.selected_spare_device_id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{case_update.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "TL_RECLAIM_STATE" } }] } } },
      { "name": "custody", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "temporary_loan_custody_history", "values": [{ "column": "temporary_loan_case_id", "value": "{{loan.temporary_loan_case_id}}" }, { "column": "device_id", "value": "{{loan.selected_spare_device_id}}" }, { "column": "from_custody_code", "value": "TEMPORARY_LOAN_RETURN_REQUIRED" }, { "column": "to_custody_code", "value": "REPAIR_CENTRE_STOCK" }, { "column": "actor_user_id", "value": "{{identity}}" }, { "column": "notes", "value": "Serviceable temporary spare physically received and returned to Repair Centre stock." }] } } },
      { "name": "history", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "temporary_loan_status_history", "values": [{ "column": "temporary_loan_case_id", "value": "{{loan.temporary_loan_case_id}}" }, { "column": "from_status_code", "value": "RETURN_REQUIRED" }, { "column": "to_status_code", "value": "RETURNED" }, { "column": "actor_user_id", "value": "{{identity}}" }, { "column": "notes", "value": "Serviceable spare reclaimed by the Repair Centre." }] } } },
      { "name": "audit", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "temporary_loan_returned" }, { "column": "module", "value": "temporary_loans" }, { "column": "entity_type", "value": "temporary_loan_case" }, { "column": "entity_id", "value": "{{loan.temporary_loan_case_id}}" }, { "column": "description", "value": "Serviceable temporary spare reclaimed into Repair Centre free stock." }] } } }
    ] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "temporary_loan_case_id": "{{$_POST.temporary_loan_case_id}}", "loan_number": "{{loan.loan_number}}", "status": "RETURNED", "device_id": "{{loan.selected_spare_device_id}}", "lifecycle": "AVAILABLE", "stock_status": "IN_STOCK", "service_location_id": "{{loan.repair_service_location_id}}", "physical_custody": "REPAIR_CENTRE_STOCK" } } }
  ], "catch": [
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'TL_RECLAIM_SCOPE'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'TL_RECLAIM_NOT_FOUND'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Temporary loan was not found." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'TL_RECLAIM_STATE' || $_EXCEPTION.message == 'TL_RECLAIM_CONVERSION' || $_EXCEPTION.message == 'TL_RECLAIM_LIFECYCLE' || $_EXCEPTION.message == 'TL_RECLAIM_STOCK' || $_EXCEPTION.message == 'TL_RECLAIM_CONFLICT' || $_EXCEPTION.code == 'ER_DUP_ENTRY'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The spare is no longer eligible to be reclaimed into free stock." } } }] } } },
    { "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Temporary spare could not be reclaimed. No partial changes were committed." } } }
  ] }
}
