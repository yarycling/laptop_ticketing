{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "meta": { "$_GET": [{ "name": "temporary_loan_case_id", "type": "number" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_require_permission", "params": { "permission": "temporary_loans.select_spare" } } },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "name": "scope_context", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_get_scope_context", "params": {} } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_GET.temporary_loan_case_id || $_GET.temporary_loan_case_id < 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "A valid temporary loan case is required." } } }] } } },
    { "name": "loan", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_temporary_loan_queue", "columns": [{ "column": "temporary_loan_case_id" }, { "column": "repair_service_location_id" }, { "column": "current_status_code" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "temporary_loan_case_id" }, "operation": "=", "value": "{{$_GET.temporary_loan_case_id}}" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!loan.temporary_loan_case_id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Temporary loan case was not found." } } }] } } },
    { "name": "location_scope", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "user_service_location_scopes", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "column": "service_location_id" }, "operation": "=", "value": "{{loan.repair_service_location_id}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !location_scope.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{loan.current_status_code != 'AUTHORIZED'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "A spare can only be selected for an authorized temporary loan." } } }] } } },
    { "name": "candidates", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": "v_temporary_loan_spare_candidates", "columns": [{ "column": "temporary_loan_case_id" }, { "column": "device_id" }, { "column": "serial_number" }, { "column": "asset_tag" }, { "column": "manufacturer_name" }, { "column": "model_name" }, { "column": "lifecycle_code" }, { "column": "stock_location_id" }, { "column": "stock_status" }, { "column": "service_location_id" }, { "column": "service_location_name" }, { "column": "allocation_level" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "temporary_loan_case_id" }, "operation": "=", "value": "{{loan.temporary_loan_case_id}}" }] }, "orders": [{ "column": "asset_tag", "direction": "asc" }, { "column": "serial_number", "direction": "asc" }], "limit": 100 } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "candidates": "{{candidates}}" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Temporary spare options could not be loaded." } } }] }
}
