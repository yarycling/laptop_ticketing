{
  "settings": { "options": { "method": "post" } },
  "meta": { "$_POST": [{ "name": "stock_location_id", "type": "number" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_require_permission", "params": { "permission": "device_stock.release" } } },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "name": "scope_context", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_get_scope_context", "params": {} } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.stock_location_id || $_POST.stock_location_id < 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "A valid stock record is required." } } }] } } },
    { "name": "release_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "release_lock", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "device_stock_locations", "values": [{ "column": "stock_status", "value": "IN_STOCK" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{$_POST.stock_location_id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }, { "data": { "column": "stock_status" }, "operation": "=", "value": "IN_STOCK" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{release_lock.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P8CB2_RELEASE_CONFLICT" } }] } } },
      { "name": "current", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_device_current_stock_location", "columns": [{ "column": "stock_location_id" }, { "column": "device_id" }, { "column": "service_location_id" }, { "column": "is_reserved_for_replacement" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "stock_location_id" }, "operation": "=", "value": "{{$_POST.stock_location_id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!current.stock_location_id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P8CB2_RELEASE_CONFLICT" } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.service_locations.flatten('id').contains(current.service_location_id)}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P8CB2_RELEASE_SCOPE" } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{current.is_reserved_for_replacement == 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P8CB2_RELEASE_CONFLICT" } }] } } },
      { "name": "close_stock", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "device_stock_locations", "values": [{ "column": "stock_status", "value": "RELEASED" }, { "column": "active_record_key", "value": null }, { "column": "removed_by", "value": "{{identity}}" }, { "column": "removed_at", "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss')}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{current.stock_location_id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{close_stock.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P8CB2_RELEASE_CONFLICT" } }] } } },
      { "name": "audit", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "device_stock_release" }, { "column": "module", "value": "device_stock" }, { "column": "entity_type", "value": "device" }, { "column": "entity_id", "value": "{{current.device_id}}" }, { "column": "description", "value": "Repair Centre stock released." }] } } }
    ] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "stock_location_id": "{{$_POST.stock_location_id}}", "stock_status": "RELEASED" } } }
  ], "catch": [
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P8CB2_RELEASE_SCOPE'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P8CB2_RELEASE_CONFLICT'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "This stock record is no longer active or is reserved for replacement." } } }] } } },
    { "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Stock release could not be recorded. No partial changes were committed." } } }
  ] }
}
