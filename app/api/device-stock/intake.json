{
  "settings": { "options": { "method": "post" } },
  "meta": { "$_POST": [{ "name": "device_id", "type": "number" }, { "name": "service_location_id", "type": "number" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_require_permission", "params": { "permission": "device_stock.intake" } } },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "name": "scope_context", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_get_scope_context", "params": {} } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.device_id || $_POST.device_id < 1 || !$_POST.service_location_id || $_POST.service_location_id < 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Select a device and Repair Centre." } } }] } } },
    { "name": "location", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "service_locations", "columns": [{ "column": "id" }, { "column": "location_type" }, { "column": "is_active" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{$_POST.service_location_id}}" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.service_locations.flatten('id').contains($_POST.service_location_id)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!location.id || location.location_type != 'REPAIR_CENTRE' || location.is_active != 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The selected Repair Centre is unavailable." } } }] } } },
    { "name": "intake_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "candidate", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_device_stock_intake_eligibility", "columns": [{ "column": "device_id" }, { "column": "lifecycle_code" }, { "column": "allocation_level" }, { "column": "has_active_stock" }, { "column": "has_active_logistics" }, { "column": "has_active_manufacturer_return" }, { "column": "has_active_repair" }, { "column": "has_replacement_reservation" }, { "column": "has_replacement_consumption" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "device_id" }, "operation": "=", "value": "{{$_POST.device_id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!candidate.device_id || candidate.lifecycle_code != 'AVAILABLE' || candidate.allocation_level == 'STUDENT' || candidate.has_active_stock == 1 || candidate.has_active_logistics == 1 || candidate.has_active_manufacturer_return == 1 || candidate.has_active_repair == 1 || candidate.has_replacement_reservation == 1 || candidate.has_replacement_consumption == 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P8CB2_INTAKE_CONFLICT" } }] } } },
      { "name": "insert_stock", "module": "dbupdater", "action": "insert", "output": true, "options": { "connection": "db", "sql": { "table": "device_stock_locations", "values": [{ "column": "device_id", "value": "{{candidate.device_id}}" }, { "column": "service_location_id", "value": "{{location.id}}" }, { "column": "stock_status", "value": "IN_STOCK" }, { "column": "reason_code", "value": "VERIFIED_INTAKE" }, { "column": "active_record_key", "value": 1 }, { "column": "placed_by", "value": "{{identity}}" }] } } },
      { "name": "audit", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "device_stock_intake" }, { "column": "module", "value": "device_stock" }, { "column": "entity_type", "value": "device" }, { "column": "entity_id", "value": "{{candidate.device_id}}" }, { "column": "description", "value": "Verified Repair Centre stock intake." }] } } }
    ] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "device_id": "{{$_POST.device_id}}", "service_location_id": "{{$_POST.service_location_id}}", "stock_status": "IN_STOCK" } } }
  ], "catch": [
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P8CB2_INTAKE_CONFLICT' || $_EXCEPTION.code == 'ER_DUP_ENTRY'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "This device is not eligible for Repair Centre stock intake." } } }] } } },
    { "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Stock intake could not be recorded. No partial changes were committed." } } }
  ] }
}
