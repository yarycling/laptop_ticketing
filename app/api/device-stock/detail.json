{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "meta": { "$_GET": [{ "name": "device_id", "type": "number" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_require_permission", "params": { "permission": "device_stock.view" } } },
    { "name": "scope_context", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_get_scope_context", "params": {} } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_GET.device_id || $_GET.device_id < 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "A valid device ID is required." } } }] } } },
    { "name": "device", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_device_stock_intake_eligibility", "columns": [{ "column": "device_id" }, { "column": "serial_number" }, { "column": "asset_tag" }, { "column": "manufacturer_name" }, { "column": "model_name" }, { "column": "lifecycle_code" }, { "column": "allocation_level" }, { "column": "district_id" }, { "column": "district_name" }, { "column": "school_id" }, { "column": "school_name" }, { "column": "has_active_logistics" }, { "column": "has_active_manufacturer_return" }, { "column": "has_active_repair" }, { "column": "has_replacement_reservation" }, { "column": "has_replacement_consumption" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "device_id" }, "operation": "=", "value": "{{$_GET.device_id}}" }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{!device.device_id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Device was not found." } } }] } } },
    { "name": "current_stock", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "v_device_stock_queue", "alias": "q" }, "columns": [{ "table": "q", "column": "stock_location_id" }, { "table": "q", "column": "device_id" }, { "table": "q", "column": "service_location_id" }, { "table": "q", "column": "service_location_name" }, { "table": "q", "column": "physical_custody_code" }, { "table": "q", "column": "physical_custody_name" }, { "table": "q", "column": "stock_status" }, { "table": "q", "column": "placed_at" }, { "table": "q", "column": "is_reserved_for_replacement" }, { "table": "q", "column": "replacement_case_id" }, { "table": "prc", "column": "replacement_number" }], "joins": [{ "table": "permanent_replacement_cases", "alias": "prc", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "prc", "column": "id", "operation": "=", "value": { "table": "q", "column": "replacement_case_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "q", "column": "device_id" }, "operation": "=", "value": "{{$_GET.device_id}}" }, { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope}}", "rules": [{ "data": { "table": "q", "column": "service_location_id" }, "operation": "in", "value": "{{scope_context.service_locations.flatten('id')}}" }] }] } } } },
    { "name": "history_scope", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "device_stock_locations", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "device_id" }, "operation": "=", "value": "{{$_GET.device_id}}" }, { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope}}", "rules": [{ "data": { "column": "service_location_id" }, "operation": "in", "value": "{{scope_context.service_locations.flatten('id')}}" }] }] } } } },
    { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && !history_scope.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "name": "history", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "device_stock_locations", "alias": "sl" }, "columns": [{ "table": "sl", "column": "id" }, { "table": "sl", "column": "service_location_id" }, { "table": "loc", "column": "name", "alias": "service_location_name" }, { "table": "sl", "column": "stock_status" }, { "table": "sl", "column": "reason_code" }, { "table": "sl", "column": "placed_at" }, { "table": "placer", "column": "display_name", "alias": "placed_by_name" }, { "table": "sl", "column": "removed_at" }, { "table": "remover", "column": "display_name", "alias": "removed_by_name" }], "joins": [
      { "table": "service_locations", "alias": "loc", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "loc", "column": "id", "operation": "=", "value": { "table": "sl", "column": "service_location_id" } }] } },
      { "table": "users", "alias": "placer", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "placer", "column": "id", "operation": "=", "value": { "table": "sl", "column": "placed_by" } }] } },
      { "table": "users", "alias": "remover", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "remover", "column": "id", "operation": "=", "value": { "table": "sl", "column": "removed_by" } }] } }
    ], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "sl", "column": "device_id" }, "operation": "=", "value": "{{$_GET.device_id}}" }, { "condition": "AND", "conditional": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope}}", "rules": [{ "data": { "table": "sl", "column": "service_location_id" }, "operation": "in", "value": "{{scope_context.service_locations.flatten('id')}}" }] }] }, "orders": [{ "table": "sl", "column": "placed_at", "direction": "desc" }, { "table": "sl", "column": "id", "direction": "desc" }] } } },
    { "name": "stock_placed_at_display", "module": "core", "action": "setvalue", "output": true, "options": { "key": "stock_placed_at_display", "value": "{{current_stock.stock_location_id ? current_stock.placed_at.formatDate('MMM d, yyyy, h:mm A') : 'Not in stock'}}" } },
    { "name": "display_history", "module": "core", "action": "repeat", "options": { "repeat": "{{history}}", "outputFilter": "exclude", "outputFields": [], "exec": { "steps": [
      { "name": "placed_at_display", "module": "core", "action": "setvalue", "output": true, "options": { "key": "placed_at_display", "value": "{{placed_at ? placed_at.formatDate('MMM d, yyyy, h:mm A') : 'Not recorded'}}" } },
      { "name": "removed_at_display", "module": "core", "action": "setvalue", "output": true, "options": { "key": "removed_at_display", "value": "{{removed_at ? removed_at.formatDate('MMM d, yyyy, h:mm A') : '-'}}" } }
    ] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "device": "{{device}}", "current": "{{current_stock}}", "placed_at_display": "{{stock_placed_at_display}}", "history": "{{display_history}}" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Stock detail could not be loaded." } } }] }
}
