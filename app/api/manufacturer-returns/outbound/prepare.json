{
  "settings": { "options": { "method": "post" } },
  "meta": { "$_POST": [ { "name": "manufacturer_return_case_id", "type": "number" }, { "name": "carrier_id", "type": "number" }, { "name": "tracking_reference", "type": "text" }, { "name": "shipment_reference", "type": "text" }, { "name": "rma_number", "type": "text" }, { "name": "manufacturer_case_reference", "type": "text" }, { "name": "warranty_reference", "type": "text" }, { "name": "expected_return_date", "type": "text" } ] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "manufacturer_returns.prepare_outbound" } } },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.manufacturer_return_case_id || !$_POST.carrier_id || ($_POST.tracking_reference && $_POST.tracking_reference.length > 180) || ($_POST.shipment_reference && $_POST.shipment_reference.length > 180) || ($_POST.rma_number && $_POST.rma_number.length > 180) || ($_POST.manufacturer_case_reference && $_POST.manufacturer_case_reference.length > 180) || ($_POST.warranty_reference && $_POST.warranty_reference.length > 180) || ($_POST.expected_return_date && !$_POST.expected_return_date.match(/^\\d{4}-\\d{2}-\\d{2}$/))}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Enter valid shipment and manufacturer reference details." } } }] } } },
    { "name": "scope_context", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_get_scope_context", "params": {} } },
    { "name": "prepare_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "current", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "manufacturer_return_cases", "columns": [{ "column": "id" }, { "column": "manufacturer_return_number" }, { "column": "current_status_code" }, { "column": "repair_centre_location_id" }, { "column": "exception_case_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{$_POST.manufacturer_return_case_id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }] } } } },
      { "name": "location_scope", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "user_service_location_scopes", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "column": "service_location_id" }, "operation": "=", "value": "{{current.repair_centre_location_id}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
      { "name": "carrier", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "carriers", "columns": [{ "column": "id" }, { "column": "name" }, { "column": "carrier_type" }, { "column": "status" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{$_POST.carrier_id}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!current.id || (permission.bypass != 'SUPER_ADMIN' && !location_scope.id)}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P8B_OUTBOUND_SCOPE" } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{current.current_status_code != 'PREPARATION_REQUIRED' || !carrier.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P8B_OUTBOUND_STATE" } }] } } },
      { "name": "shipment", "module": "dbupdater", "action": "insert", "output": true, "options": { "connection": "db", "sql": { "table": "manufacturer_return_shipments", "values": [{ "column": "manufacturer_return_case_id", "value": "{{current.id}}" }, { "column": "direction", "value": "OUTBOUND" }, { "column": "carrier_id", "value": "{{carrier.id}}" }, { "column": "tracking_reference", "value": "{{($_POST.tracking_reference || '').trim() || null}}" }, { "column": "shipment_reference", "value": "{{($_POST.shipment_reference || '').trim() || null}}" }, { "column": "prepared_by_user_id", "value": "{{identity}}" }] } } },
      { "name": "references", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "manufacturer_return_cases", "values": [{ "column": "rma_number", "value": "{{($_POST.rma_number || '').trim() || null}}" }, { "column": "manufacturer_case_reference", "value": "{{($_POST.manufacturer_case_reference || '').trim() || null}}" }, { "column": "warranty_reference", "value": "{{($_POST.warranty_reference || '').trim() || null}}" }, { "column": "expected_return_date", "value": "{{$_POST.expected_return_date || null}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{current.id}}" }, { "data": { "column": "current_status_code" }, "operation": "=", "value": "PREPARATION_REQUIRED" }] } } } },
      { "name": "update_status", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "manufacturer_return_cases", "values": [{ "column": "current_status_code", "value": "AWAITING_OUTBOUND_CARRIER_PICKUP" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{current.id}}" }, { "data": { "column": "current_status_code" }, "operation": "=", "value": "PREPARATION_REQUIRED" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{update_status.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P8B_OUTBOUND_STATE" } }] } } },
      { "name": "history", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "manufacturer_return_status_history", "values": [{ "column": "manufacturer_return_case_id", "value": "{{current.id}}" }, { "column": "from_status_code", "value": "PREPARATION_REQUIRED" }, { "column": "to_status_code", "value": "AWAITING_OUTBOUND_CARRIER_PICKUP" }, { "column": "actor_user_id", "value": "{{identity}}" }, { "column": "reason", "value": "Outbound manufacturer shipment prepared." }] } } },
      { "name": "audit", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "manufacturer_outbound_prepared" }, { "column": "module", "value": "manufacturer_returns" }, { "column": "entity_type", "value": "manufacturer_return_case" }, { "column": "entity_id", "value": "{{current.id}}" }, { "column": "description", "value": "Outbound manufacturer shipment prepared." }] } } }
    ] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "manufacturer_return_case_id": "{{$_POST.manufacturer_return_case_id}}", "status": "AWAITING_OUTBOUND_CARRIER_PICKUP" } } }
  ], "catch": [
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P8B_OUTBOUND_SCOPE'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P8B_OUTBOUND_STATE' || $_EXCEPTION.code == 'ER_DUP_ENTRY'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "The manufacturer return or selected carrier changed. Reload before trying again." } } }] } } },
    { "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Outbound shipment could not be prepared. No partial changes were committed." } } }
  ] }
}
