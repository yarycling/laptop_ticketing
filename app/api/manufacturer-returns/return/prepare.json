{
  "settings": { "options": { "method": "post" } },
  "meta": { "$_POST": [{ "name": "manufacturer_return_case_id", "type": "number" }, { "name": "carrier_id", "type": "number" }, { "name": "tracking_reference", "type": "text" }, { "name": "shipment_reference", "type": "text" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "manufacturer_returns.prepare_return" } } },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.manufacturer_return_case_id || !$_POST.carrier_id || ($_POST.tracking_reference && $_POST.tracking_reference.length > 180) || ($_POST.shipment_reference && $_POST.shipment_reference.length > 180)}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "Choose an active return carrier and valid shipment references." } } }] } } },
    { "name": "scope_context", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_get_scope_context", "params": {} } },
    { "name": "return_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "current", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "manufacturer_return_cases", "columns": [{ "column": "id" }, { "column": "current_status_code" }, { "column": "repair_centre_location_id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{$_POST.manufacturer_return_case_id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }] } } } },
      { "name": "scope", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "user_service_location_scopes", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "column": "service_location_id" }, "operation": "=", "value": "{{current.repair_centre_location_id}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
      { "name": "carrier", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "carriers", "columns": [{ "column": "id" }, { "column": "status" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{$_POST.carrier_id}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
      { "name": "outcome", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "manufacturer_return_outcomes", "columns": [{ "column": "id" }, { "column": "outcome_code" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "manufacturer_return_case_id" }, "operation": "=", "value": "{{current.id}}" }] }, "orders": [{ "column": "created_at", "direction": "desc" }, { "column": "id", "direction": "desc" }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!current.id || (permission.bypass != 'SUPER_ADMIN' && !scope.id)}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P8B_RETURN_SCOPE" } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{current.current_status_code != 'AT_MANUFACTURER' || !outcome.id || !carrier.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P8B_RETURN_STATE" } }] } } },
      { "name": "shipment", "module": "dbupdater", "action": "insert", "output": true, "options": { "connection": "db", "sql": { "table": "manufacturer_return_shipments", "values": [{ "column": "manufacturer_return_case_id", "value": "{{current.id}}" }, { "column": "direction", "value": "RETURN" }, { "column": "carrier_id", "value": "{{carrier.id}}" }, { "column": "tracking_reference", "value": "{{($_POST.tracking_reference || '').trim() || null}}" }, { "column": "shipment_reference", "value": "{{($_POST.shipment_reference || '').trim() || null}}" }, { "column": "prepared_by_user_id", "value": "{{identity}}" }] } } },
      { "name": "case_update", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "manufacturer_return_cases", "values": [{ "column": "current_status_code", "value": "AWAITING_RETURN_CARRIER_PICKUP" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{current.id}}" }, { "data": { "column": "current_status_code" }, "operation": "=", "value": "AT_MANUFACTURER" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{case_update.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P8B_RETURN_STATE" } }] } } },
      { "name": "history", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "manufacturer_return_status_history", "values": [{ "column": "manufacturer_return_case_id", "value": "{{current.id}}" }, { "column": "from_status_code", "value": "AT_MANUFACTURER" }, { "column": "to_status_code", "value": "AWAITING_RETURN_CARRIER_PICKUP" }, { "column": "actor_user_id", "value": "{{identity}}" }, { "column": "reason", "value": "Manufacturer return shipment prepared." }] } } },
      { "name": "audit", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "manufacturer_return_prepared" }, { "column": "module", "value": "manufacturer_returns" }, { "column": "entity_type", "value": "manufacturer_return_case" }, { "column": "entity_id", "value": "{{current.id}}" }, { "column": "description", "value": "Manufacturer return shipment prepared for Repair Centre receipt." }] } } }
    ] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "status": "AWAITING_RETURN_CARRIER_PICKUP" } } }
  ], "catch": [
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P8B_RETURN_SCOPE'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P8B_RETURN_STATE' || $_EXCEPTION.code == 'ER_DUP_ENTRY'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "A return shipment is already prepared or this manufacturer return is not ready." } } }] } } },
    { "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Return shipment could not be prepared." } } }
  ] }
}
