{
  "settings": {
    "options": {
      "method": "post"
    }
  },
  "meta": {
    "$_POST": [
      {
        "name": "manufacturer_return_case_id",
        "type": "number"
      }
    ]
  },
  "exec": {
    "steps": [
      {
        "name": "permission",
        "module": "core",
        "action": "exec",
        "options": {
          "exec": "security_require_permission",
          "params": {
            "permission": "manufacturer_returns.ttpost_return_pickup"
          }
        }
      },
      {
        "name": "identity",
        "module": "auth",
        "action": "identify",
        "options": {
          "provider": "portalSecurity"
        }
      },
      {
        "name": "pickup_transaction",
        "module": "dbupdater",
        "action": "transaction",
        "options": {
          "connection": "db",
          "exec": {
            "steps": [
              {
                "name": "current",
                "module": "dbconnector",
                "action": "single",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": {
                      "name": "manufacturer_return_cases",
                      "alias": "m"
                    },
                    "columns": [
                      {
                        "table": "m",
                        "column": "id"
                      },
                      {
                        "table": "m",
                        "column": "current_status_code"
                      },
                      {
                        "table": "s",
                        "column": "carrier_pickup_at"
                      },
                      {
                        "table": "c",
                        "column": "carrier_type"
                      }
                    ],
                    "joins": [
                      {
                        "table": "manufacturer_return_shipments",
                        "alias": "s",
                        "type": "inner",
                        "clauses": {
                          "condition": "AND",
                          "rules": [
                            {
                              "table": "s",
                              "column": "manufacturer_return_case_id",
                              "operation": "=",
                              "value": {
                                "table": "m",
                                "column": "id"
                              }
                            }
                          ]
                        }
                      },
                      {
                        "table": "carriers",
                        "alias": "c",
                        "type": "inner",
                        "clauses": {
                          "condition": "AND",
                          "rules": [
                            {
                              "table": "c",
                              "column": "id",
                              "operation": "=",
                              "value": {
                                "table": "s",
                                "column": "carrier_id"
                              }
                            }
                          ]
                        }
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "table": "m",
                            "column": "id"
                          },
                          "operation": "=",
                          "value": "{{$_POST.manufacturer_return_case_id}}"
                        },
                        {
                          "data": {
                            "table": "m",
                            "column": "active_record_key"
                          },
                          "operation": "=",
                          "value": 1
                        },
                        {
                          "data": {
                            "table": "s",
                            "column": "direction"
                          },
                          "operation": "=",
                          "value": "RETURN"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "module": "core",
                "action": "condition",
                "options": {
                  "if": "{{!current.id || current.current_status_code != 'AWAITING_RETURN_CARRIER_PICKUP' || current.carrier_type != 'TTPOST' || current.carrier_pickup_at}}",
                  "then": {
                    "steps": [
                      {
                        "module": "core",
                        "action": "error",
                        "options": {
                          "message": "P8B_RETURN_PICKUP_STATE"
                        }
                      }
                    ]
                  }
                }
              },
              {
                "name": "shipment_update",
                "module": "dbupdater",
                "action": "update",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "manufacturer_return_shipments",
                    "values": [
                      {
                        "column": "carrier_pickup_at",
                        "value": "{{'now'.formatDate('yyyy-MM-dd HH:mm:ss.v')}}"
                      },
                      {
                        "column": "carrier_pickup_by_user_id",
                        "value": "{{identity}}"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "manufacturer_return_case_id"
                          },
                          "operation": "=",
                          "value": "{{current.id}}"
                        },
                        {
                          "data": {
                            "column": "direction"
                          },
                          "operation": "=",
                          "value": "RETURN"
                        },
                        {
                          "data": {
                            "column": "carrier_pickup_at"
                          },
                          "operator": "is_null"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "name": "case_update",
                "module": "dbupdater",
                "action": "update",
                "output": true,
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "manufacturer_return_cases",
                    "values": [
                      {
                        "column": "current_status_code",
                        "value": "RETURN_IN_TRANSIT"
                      }
                    ],
                    "wheres": {
                      "condition": "AND",
                      "rules": [
                        {
                          "data": {
                            "column": "id"
                          },
                          "operation": "=",
                          "value": "{{current.id}}"
                        },
                        {
                          "data": {
                            "column": "current_status_code"
                          },
                          "operation": "=",
                          "value": "AWAITING_RETURN_CARRIER_PICKUP"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "module": "core",
                "action": "condition",
                "options": {
                  "if": "{{shipment_update.affected != 1 || case_update.affected != 1}}",
                  "then": {
                    "steps": [
                      {
                        "module": "core",
                        "action": "error",
                        "options": {
                          "message": "P8B_RETURN_PICKUP_STATE"
                        }
                      }
                    ]
                  }
                }
              },
              {
                "name": "history",
                "module": "dbupdater",
                "action": "insert",
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "manufacturer_return_status_history",
                    "values": [
                      {
                        "column": "manufacturer_return_case_id",
                        "value": "{{current.id}}"
                      },
                      {
                        "column": "from_status_code",
                        "value": "AWAITING_RETURN_CARRIER_PICKUP"
                      },
                      {
                        "column": "to_status_code",
                        "value": "RETURN_IN_TRANSIT"
                      },
                      {
                        "column": "actor_user_id",
                        "value": "{{identity}}"
                      },
                      {
                        "column": "reason",
                        "value": "TTPost return-carrier custody recorded."
                      }
                    ]
                  }
                }
              },
              {
                "name": "audit",
                "module": "dbupdater",
                "action": "insert",
                "options": {
                  "connection": "db",
                  "sql": {
                    "table": "audit_logs",
                    "values": [
                      {
                        "column": "actor_user_id",
                        "value": "{{identity}}"
                      },
                      {
                        "column": "action",
                        "value": "manufacturer_return_carrier_pickup"
                      },
                      {
                        "column": "module",
                        "value": "manufacturer_returns"
                      },
                      {
                        "column": "entity_type",
                        "value": "manufacturer_return_case"
                      },
                      {
                        "column": "entity_id",
                        "value": "{{current.id}}"
                      },
                      {
                        "column": "description",
                        "value": "TTPost custody recorded for manufacturer return shipment."
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      {
        "module": "core",
        "action": "response",
        "options": {
          "status": 200,
          "data": {
            "success": true,
            "status": "RETURN_IN_TRANSIT"
          }
        }
      }
    ],
    "catch": [
      {
        "module": "core",
        "action": "condition",
        "options": {
          "if": "{{$_EXCEPTION.message == 'P8B_RETURN_PICKUP_STATE' || $_EXCEPTION.code == 'ER_DUP_ENTRY'}}",
          "then": {
            "steps": [
              {
                "module": "core",
                "action": "response",
                "options": {
                  "status": 409,
                  "data": {
                    "success": false,
                    "error": "This TTPost return pickup is no longer eligible."
                  }
                }
              }
            ]
          }
        }
      },
      {
        "module": "core",
        "action": "response",
        "options": {
          "status": 500,
          "data": {
            "success": false,
            "error": "TTPost return pickup could not be recorded."
          }
        }
      }
    ]
  }
}
