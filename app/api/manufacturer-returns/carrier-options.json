{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "carriers.view" } } },
    { "name": "carriers", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": "carriers", "columns": [{ "column": "id" }, { "column": "carrier_code" }, { "column": "name" }, { "column": "carrier_type" }, { "column": "is_default" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "status" }, "operation": "=", "value": "active" }] }, "orders": [{ "column": "is_default", "direction": "desc" }, { "column": "sort_order", "direction": "asc" }, { "column": "name", "direction": "asc" }] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "carriers": "{{carriers}}" } } }
  ], "catch": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Carrier options could not be loaded." } } }] }
}
