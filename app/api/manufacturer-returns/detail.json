{
  "settings": { "options": { "method": "get", "nocsrf": true } },
  "meta": { "$_GET": [{ "name": "id", "type": "number" }] },
  "exec": {
    "steps": [
      { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "manufacturer_returns.view" } } },
      { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
      { "name": "scope_context", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_get_scope_context", "params": {} } },
      { "name": "ttpost_role", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "user_roles", "alias": "ur" }, "columns": [{ "table": "r", "column": "id" }], "joins": [{ "table": "roles", "alias": "r", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "r", "column": "id", "operation": "=", "value": { "table": "ur", "column": "role_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "ur", "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "table": "r", "column": "name" }, "operation": "=", "value": "TTPOST_LOGISTICS" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!$_GET.id || $_GET.id < 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "A valid manufacturer-return ID is required." } } }] } } },
      { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && !scope_context.has_national_scope && scope_context.districts.length == 0 && scope_context.service_locations.length == 0 && !ttpost_role.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
      { "name": "case", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "v_manufacturer_return_queue", "columns": [{ "column": "manufacturer_return_case_id" }, { "column": "manufacturer_return_number" }, { "column": "ticket_id" }, { "column": "ticket_number" }, { "column": "logistics_number" }, { "column": "logistics_status_code" }, { "column": "logistics_status_name" }, { "column": "phase7_physical_state_code" }, { "column": "original_device_id" }, { "column": "serial_number" }, { "column": "asset_tag" }, { "column": "manufacturer_name" }, { "column": "manufacturer_return_status_code" }, { "column": "manufacturer_return_status_name" }, { "column": "exception_status_code" }, { "column": "physical_custody_code" }, { "column": "origin_district_id" }, { "column": "repair_centre_location_id" }, { "column": "outbound_carrier_type" }, { "column": "return_carrier_type" }, { "column": "has_ttpost_participation" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "manufacturer_return_case_id" }, "operation": "=", "value": "{{$_GET.id}}" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!case.manufacturer_return_case_id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 404, "data": { "success": false, "error": "Manufacturer return was not found." } } }] }, "else": { "steps": [
        { "module": "core", "action": "condition", "options": { "if": "{{permission.bypass != 'SUPER_ADMIN' && ((ttpost_role.id && case.has_ttpost_participation != 1) || (!ttpost_role.id && !scope_context.has_national_scope && !scope_context.districts.flatten('id').contains(case.origin_district_id) && !scope_context.service_locations.flatten('id').contains(case.repair_centre_location_id)))}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] }, "else": { "steps": [
          { "module": "core", "action": "condition", "options": { "if": "{{ttpost_role.id}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "case": "{{case}}", "manufacturer": { "manufacturer_name": "{{case.manufacturer_name}}" }, "shipments": [], "outcome": null, "staged_unit": null, "history": [] } } }] }, "else": { "steps": [
            { "name": "manufacturer", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "manufacturer_return_cases", "alias": "c" }, "columns": [{ "table": "c", "column": "manufacturer_return_number" }, { "table": "c", "column": "rma_number" }, { "table": "c", "column": "manufacturer_case_reference" }, { "table": "c", "column": "warranty_reference" }, { "table": "c", "column": "expected_return_date" }, { "table": "m", "column": "name", "alias": "manufacturer_name" }], "joins": [{ "table": "manufacturers", "alias": "m", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "m", "column": "id", "operation": "=", "value": { "table": "c", "column": "manufacturer_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "c", "column": "id" }, "operation": "=", "value": "{{case.manufacturer_return_case_id}}" }] } } } },
            { "name": "shipments", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "manufacturer_return_shipments", "alias": "s" }, "columns": [{ "table": "s", "column": "direction" }, { "table": "cr", "column": "name", "alias": "carrier_name" }, { "table": "cr", "column": "carrier_type" }, { "table": "s", "column": "tracking_reference" }, { "table": "s", "column": "shipment_reference" }, { "table": "s", "column": "prepared_at" }, { "table": "s", "column": "carrier_pickup_at" }, { "table": "s", "column": "destination_received_at" }], "joins": [{ "table": "carriers", "alias": "cr", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "cr", "column": "id", "operation": "=", "value": { "table": "s", "column": "carrier_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "s", "column": "manufacturer_return_case_id" }, "operation": "=", "value": "{{case.manufacturer_return_case_id}}" }] }, "orders": [{ "table": "s", "column": "direction", "direction": "asc" }] } } },
            { "name": "outcome", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "manufacturer_return_outcomes", "columns": [{ "column": "outcome_code" }, { "column": "outcome_date" }, { "column": "manufacturer_resolution_reference" }, { "column": "reason" }, { "column": "notes" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "manufacturer_return_case_id" }, "operation": "=", "value": "{{case.manufacturer_return_case_id}}" }] }, "orders": [{ "column": "id", "direction": "desc" }] } } },
            { "name": "staged_unit", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "manufacturer_supplied_units", "columns": [{ "column": "serial_number" }, { "column": "manufacturer_model_reference" }, { "column": "resolved_model_id" }, { "column": "model_description" }, { "column": "manufacturer_warranty_reference" }, { "column": "warranty_start" }, { "column": "warranty_end" }, { "column": "received_at" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "manufacturer_return_case_id" }, "operation": "=", "value": "{{case.manufacturer_return_case_id}}" }] } } } },
            { "name": "history", "module": "dbconnector", "action": "select", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "manufacturer_return_status_history", "alias": "h" }, "columns": [{ "table": "h", "column": "from_status_code" }, { "table": "h", "column": "to_status_code" }, { "table": "h", "column": "reason" }, { "table": "h", "column": "created_at" }, { "table": "u", "column": "display_name", "alias": "actor_display_name" }], "joins": [{ "table": "users", "alias": "u", "type": "left", "clauses": { "condition": "AND", "rules": [{ "table": "u", "column": "id", "operation": "=", "value": { "table": "h", "column": "actor_user_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "h", "column": "manufacturer_return_case_id" }, "operation": "=", "value": "{{case.manufacturer_return_case_id}}" }] }, "orders": [{ "table": "h", "column": "created_at", "direction": "desc" }, { "table": "h", "column": "id", "direction": "desc" }] } } },
            { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "case": "{{case}}", "manufacturer": "{{manufacturer}}", "shipments": "{{shipments}}", "outcome": "{{outcome}}", "staged_unit": "{{staged_unit}}", "history": "{{history}}" } } }
          ] } } }
        ] } } }
      ] } } }
    ],
    "catch": [{ "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Manufacturer return detail could not be loaded." } } }]
  }
}
