{
  "settings": { "options": { "method": "post" } },
  "meta": { "$_POST": [{ "name": "exception_case_id", "type": "number" }] },
  "exec": { "steps": [
    { "name": "permission", "module": "core", "action": "exec", "options": { "exec": "security_require_permission", "params": { "permission": "manufacturer_returns.start" } } },
    { "name": "identity", "module": "auth", "action": "identify", "options": { "provider": "portalSecurity" } },
    { "name": "scope_context", "module": "core", "action": "exec", "output": true, "options": { "exec": "security_get_scope_context", "params": {} } },
    { "module": "core", "action": "condition", "options": { "if": "{{!$_POST.exception_case_id || $_POST.exception_case_id < 1}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 400, "data": { "success": false, "error": "A valid exception case is required." } } }] } } },
    { "name": "start_transaction", "module": "dbupdater", "action": "transaction", "options": { "connection": "db", "exec": { "steps": [
      { "name": "current", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": { "name": "repair_exception_cases", "alias": "ec" }, "columns": [{ "table": "ec", "column": "id" }, { "table": "ec", "column": "ticket_id" }, { "table": "ec", "column": "logistics_case_id" }, { "table": "ec", "column": "repair_job_id" }, { "table": "ec", "column": "device_id" }, { "table": "ec", "column": "current_status_code" }, { "table": "ec", "column": "recommended_disposition_code" }, { "table": "ctx", "column": "ticket_status_code" }, { "table": "ctx", "column": "logistics_status_code" }, { "table": "ctx", "column": "physical_state_code" }, { "table": "ctx", "column": "device_lifecycle_code" }, { "table": "ctx", "column": "repair_centre_location_id" }, { "table": "ctx", "column": "repair_job_id", "alias": "context_repair_job_id" }, { "table": "out", "column": "code", "alias": "repair_outcome_code" }, { "table": "job", "column": "completed_at" }, { "table": "dm", "column": "manufacturer_id" }], "joins": [{ "table": "v_repair_current_context", "alias": "ctx", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "ctx", "column": "logistics_case_id", "operation": "=", "value": { "table": "ec", "column": "logistics_case_id" } }] } }, { "table": "repair_jobs", "alias": "job", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "job", "column": "id", "operation": "=", "value": { "table": "ec", "column": "repair_job_id" } }] } }, { "table": "repair_outcomes", "alias": "out", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "out", "column": "id", "operation": "=", "value": { "table": "job", "column": "outcome_id" } }] } }, { "table": "devices", "alias": "d", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "d", "column": "id", "operation": "=", "value": { "table": "ec", "column": "device_id" } }] } }, { "table": "device_models", "alias": "dm", "type": "inner", "clauses": { "condition": "AND", "rules": [{ "table": "dm", "column": "id", "operation": "=", "value": { "table": "d", "column": "device_model_id" } }] } }], "wheres": { "condition": "AND", "rules": [{ "data": { "table": "ec", "column": "id" }, "operation": "=", "value": "{{$_POST.exception_case_id}}" }] } } } },
      { "name": "location_scope", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "user_service_location_scopes", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "user_id" }, "operation": "=", "value": "{{identity}}" }, { "data": { "column": "service_location_id" }, "operation": "=", "value": "{{current.repair_centre_location_id}}" }, { "data": { "column": "status" }, "operation": "=", "value": "active" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{!current.id || (permission.bypass != 'SUPER_ADMIN' && !location_scope.id)}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P8B_START_SCOPE" } }] } } },
      { "name": "active_case", "module": "dbconnector", "action": "single", "output": true, "options": { "connection": "db", "sql": { "table": "manufacturer_return_cases", "columns": [{ "column": "id" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "exception_case_id" }, "operation": "=", "value": "{{current.id}}" }, { "data": { "column": "active_record_key" }, "operation": "=", "value": 1 }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{current.current_status_code != 'MANUFACTURER_RETURN_APPROVED' || current.recommended_disposition_code != 'MANUFACTURER_RETURN' || current.ticket_status_code != 'UNDER_REPAIR' || current.logistics_status_code != 'AT_REPAIR_CENTRE' || current.physical_state_code != 'REPAIR_CENTRE_CUSTODY' || current.device_lifecycle_code != 'IN_REPAIR' || !current.completed_at || !['MANUFACTURER_RETURN_REQUIRED','UNABLE_TO_REPAIR'].contains(current.repair_outcome_code) || current.repair_job_id != current.context_repair_job_id || !current.manufacturer_id || active_case.id}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P8B_START_STATE" } }] } } },
      { "name": "new_case", "module": "dbupdater", "action": "insert", "output": true, "options": { "connection": "db", "sql": { "table": "manufacturer_return_cases", "values": [{ "column": "exception_case_id", "value": "{{current.id}}" }, { "column": "ticket_id", "value": "{{current.ticket_id}}" }, { "column": "logistics_case_id", "value": "{{current.logistics_case_id}}" }, { "column": "repair_job_id", "value": "{{current.repair_job_id}}" }, { "column": "original_device_id", "value": "{{current.device_id}}" }, { "column": "manufacturer_id", "value": "{{current.manufacturer_id}}" }, { "column": "repair_centre_location_id", "value": "{{current.repair_centre_location_id}}" }, { "column": "current_status_code", "value": "PREPARATION_REQUIRED" }, { "column": "started_by", "value": "{{identity}}" }, { "column": "active_record_key", "value": 1 }] } } },
      { "name": "number", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "manufacturer_return_cases", "values": [{ "column": "manufacturer_return_number", "value": "{{'MFR' + new_case.identity}}" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{new_case.identity}}" }, { "data": { "column": "manufacturer_return_number" }, "operator": "is_null" }] } } } },
      { "name": "exception_update", "module": "dbupdater", "action": "update", "output": true, "options": { "connection": "db", "sql": { "table": "repair_exception_cases", "values": [{ "column": "current_status_code", "value": "MANUFACTURER_RETURN_IN_PROGRESS" }], "wheres": { "condition": "AND", "rules": [{ "data": { "column": "id" }, "operation": "=", "value": "{{current.id}}" }, { "data": { "column": "current_status_code" }, "operation": "=", "value": "MANUFACTURER_RETURN_APPROVED" }] } } } },
      { "module": "core", "action": "condition", "options": { "if": "{{number.affected != 1 || exception_update.affected != 1}}", "then": { "steps": [{ "module": "core", "action": "error", "options": { "message": "P8B_START_STATE" } }] } } },
      { "name": "exception_history", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "exception_case_status_history", "values": [{ "column": "exception_case_id", "value": "{{current.id}}" }, { "column": "from_status_code", "value": "MANUFACTURER_RETURN_APPROVED" }, { "column": "to_status_code", "value": "MANUFACTURER_RETURN_IN_PROGRESS" }, { "column": "actor_user_id", "value": "{{identity}}" }, { "column": "reason", "value": "Manufacturer return processing started." }] } } },
      { "name": "mfr_history", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "manufacturer_return_status_history", "values": [{ "column": "manufacturer_return_case_id", "value": "{{new_case.identity}}" }, { "column": "from_status_code", "value": null }, { "column": "to_status_code", "value": "PREPARATION_REQUIRED" }, { "column": "actor_user_id", "value": "{{identity}}" }, { "column": "reason", "value": "Manufacturer return cycle created." }] } } },
      { "name": "audit", "module": "dbupdater", "action": "insert", "options": { "connection": "db", "sql": { "table": "audit_logs", "values": [{ "column": "actor_user_id", "value": "{{identity}}" }, { "column": "action", "value": "manufacturer_return_started" }, { "column": "module", "value": "manufacturer_returns" }, { "column": "entity_type", "value": "manufacturer_return_case" }, { "column": "entity_id", "value": "{{new_case.identity}}" }, { "column": "description", "value": "Manufacturer return processing started." }] } } }
    ] } } },
    { "module": "core", "action": "response", "options": { "status": 200, "data": { "success": true, "manufacturer_return_case_id": "{{new_case.identity}}", "manufacturer_return_number": "{{'MFR' + new_case.identity}}", "status": "PREPARATION_REQUIRED" } } }
  ], "catch": [
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P8B_START_SCOPE'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 403, "data": { "success": false, "error": "Forbidden." } } }] } } },
    { "module": "core", "action": "condition", "options": { "if": "{{$_EXCEPTION.message == 'P8B_START_STATE' || $_EXCEPTION.code == 'ER_DUP_ENTRY'}}", "then": { "steps": [{ "module": "core", "action": "response", "options": { "status": 409, "data": { "success": false, "error": "This exception is no longer eligible or a manufacturer-return cycle already exists." } } }] } } },
    { "module": "core", "action": "response", "options": { "status": 500, "data": { "success": false, "error": "Manufacturer return could not be started. No partial changes were committed." } } }
  ] }
}
