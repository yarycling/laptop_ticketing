{
  "settings": {
    "options": {
      "method": "post",
      "nocsrf": true
    }
  },
  "meta": {
    "$_POST": [
      {
        "type": "text",
        "name": "permission"
      }
    ],
    "$_GET": [
      {
        "type": "text",
        "name": "permission"
      }
    ]
  },
  "exec": {
    "steps": [
      {
        "name": "require_permission",
        "module": "core",
        "action": "exec",
        "options": {
          "exec": "security_require_permission",
          "params": {
            "permission": "{{$_POST.permission ? $_POST.permission : $_GET.permission}}"
          }
        },
        "output": true
      },
      {
        "module": "core",
        "action": "response",
        "options": {
          "status": 200,
          "data": {
            "success": true,
            "permission": "{{require_permission.permission}}",
            "bypass": "{{require_permission.bypass}}"
          }
        }
      }
    ]
  }
}
